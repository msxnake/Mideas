 3410	47FE					; COLLISION HELPER FUNCTIONS(Critical for Gameplay Parity)
 3411	47FE					        ; ==================================================================
 3412	47FE					
 3413	47FE					; ------------------------------------------------------------------
 3414	47FE					; coll_add_signed_offset_clamped
 3415	47FE					; Input:  A = base coordinate (0..255)
 3416	47FE					;         HL = pointer to signed offset byte (-128..127, two's complement)
 3417	47FE					; Output: A = clamped (base + offset), saturated to 0..255
 3418	47FE					; Clobbers: B
 3419	47FE					; ------------------------------------------------------------------
 3420	47FE					coll_add_signed_offset_clamped:
 3421	47FE	46				    ld b, (hl)                    ; B = signed offset byte
 3422	47FF	80				    add a, b                      ; A = base + offset (wrapped)
 3423	4800	CB	78			    bit 7, b
 3424	4802	28	04			    jr z, .casc_positive
 3425	4804					    ; Negative offset: carry=0 means underflow (wrapped below 0)
 3426	4804	38	06			    jr c, .casc_done
 3427	4806	AF				    xor a                         ; Clamp to 0
 3428	4807	C9				    ret
 3429	4808					.casc_positive:
 3430	4808					    ; Positive offset: carry=1 means overflow (wrapped above 255)
 3431	4808	30	02			    jr nc, .casc_done
 3432	480A	3E	FF			    ld a, 255                     ; Clamp to 255
 3433	480C					.casc_done:
 3434	480C	C9				    ret
 3435	480D					
 3436	480D					; ------------------------------------------------------------------
 3437	480D					; coll_flags_from_layer
 3438	480D					; Input:  A = collision layer bitmask of the other entity
 3439	480D					; Output: A = collision event flags (entity/enemy/item)
 3440	480D					; Clobbers: B, C
 3441	480D					; ------------------------------------------------------------------
 3442	480D					coll_flags_from_layer:
 3443	480D	47				    ld b, a
 3444	480E	0E	01			    ld c, COLLISION_EVENT_ENTITY
 3445	4810					
 3446	4810	78				    ld a, b
 3447	4811	E6	02			    and COLLISION_LAYER_ENEMY
 3448	4813	28	04			    jr z, .cffl_no_enemy
 3449	4815	79				    ld a, c
 3450	4816	F6	02			    or COLLISION_EVENT_ENEMY
 3451	4818	4F				    ld c, a
 3452	4819					.cffl_no_enemy:
 3453	4819	78				    ld a, b
 3454	481A	E6	10			    and COLLISION_LAYER_ITEM
 3455	481C	28	04			    jr z, .cffl_done
 3456	481E	79				    ld a, c
 3457	481F	F6	04			    or COLLISION_EVENT_ITEM
 3458	4821	4F				    ld c, a
 3459	4822					.cffl_done:
 3460	4822	79				    ld a, c
 3461	4823	C9				    ret
