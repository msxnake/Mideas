 6806	5682					; mark_used_entity_list_dirty
 6807	5682					; Invalidate compact entity list cache.
 6808	5682					; Call this after spawn/despawn or screen-id changes.
 6809	5682					; ------------------------------------------------------------------
 6810	5682					; Register Contract:
 6811	5682					;   Purpose: Mark compact active-entity cache as stale.
 6812	5682					;   Inputs:
 6813	5682					;     - None
 6814	5682					;   Outputs:
 6815	5682					;     - active_entity_list_dirty = 1
 6816	5682					;   Clobbers:
 6817	5682					;     - HL
 6818	5682					;   Preserved:
 6819	5682					;     - AF
 6820	5682					;     - BC
 6821	5682					;     - DE
 6822	5682					;   Register roles:
 6823	5682					;     - HL = points to dirty flag byte
 6824	5682					
 6825	5682					mark_used_entity_list_dirty:
 6826	5682	21	08	D1		    ld hl, active_entity_list_dirty
 6827	5685	36	01			    ld (hl), 1
 6828	5687	C9				    ret
