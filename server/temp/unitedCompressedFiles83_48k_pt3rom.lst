 1832	425E					; ==================================================================
 1833	425E					; ENABLE_TASK - Activate a task in the system
 1834	425E					; ==================================================================
 1835	425E					; Register Contract:
 1836	425E					;   Purpose: Store routine pointer into task_table slot.
 1837	425E					;   Inputs:
 1838	425E					;     - A = task slot (0-7)
 1839	425E					;     - HL = task routine address
 1840	425E					;   Outputs:
 1841	425E					;     - task_table[slot] = HL
 1842	425E					;   Clobbers:
 1843	425E					;     - AF
 1844	425E					;     - BC
 1845	425E					;     - DE
 1846	425E					;     - HL
 1847	425E					;   Preserved:
 1848	425E					;     - None
 1849	425E					;   Register roles:
 1850	425E					;     - A = slot validation and offset math
 1851	425E					;     - DE = holds routine address while HL is repurposed as slot pointer
 1852	425E					;     - BC = task_table base address
 1853	425E					;     - HL = slot address calculation / pointer write
 1854	425E					
 1855	425E					; Inputs:
 1856	425E					;   A = task slot (0-7)
 1857	425E					;   HL = address of task routine
 1858	425E					; Outputs: None
 1859	425E					; Modifies: AF, BC, DE, HL
 1860	425E					; ==================================================================
 1861	425E					enable_task:
 1862	425E					    ; Validate slot (0-7)
 1863	425E	FE	08			    cp 8
 1864	4260	D0				    ret nc                      ; Return if slot >= 8
 1865	4261					
 1866	4261					    ; Calculate offset in table: slot * 2
 1867	4261	87				    add a, a                    ; A = slot * 2
 1868	4262	5F				    ld e, a
 1869	4263	16	00			    ld d, 0
 1870	4265	01	2E	D1		    ld bc, task_table
 1871	4268	EB				    ex de, hl                   ; HL = offset, DE = task address
 1872	4269	09				    add hl, bc                  ; HL = task_table + offset
 1873	426A					
 1874	426A					    ; Write task address
 1875	426A	EB				    ex de, hl                   ; HL = task address, DE = slot location
 1876	426B	7D				    ld a, l
 1877	426C	12				    ld (de), a                  ; Write low byte
 1878	426D	13				    inc de
 1879	426E	7C				    ld a, h
 1880	426F	12				    ld (de), a                  ; Write high byte
 1881	4270					
 1882	4270	C9				    ret
 1883	4271					
