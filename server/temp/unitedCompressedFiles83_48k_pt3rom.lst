 12164	7354					
 12165	7354					; ------------------------------------------------------------------
 12166	7354					; music_update
 12167	7354					; Update PT3 playback. Called every frame from ISR.
 12168	7354					; Checks end-of-song flag, handles loop/stop, runs PT3_ROUT+PT3_PLAY.
 12169	7354					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 12170	7354					; ------------------------------------------------------------------
 12171	7354					music_update:
 12172	7354	3A	4D	D1		    ld a, (music_active)
 12173	7357	B7				    or a
 12174	7358	C8				    ret z
 12175	7359	3A	4E	D1		    ld a, (music_muted)
 12176	735C	B7				    or a
 12177	735D	C0				    ret nz
 12178	735E					    ; Check if song ended (CHECKLP sets bit7 of PT3_SETUP)
 12179	735E	3A	74	D1		    ld a, (PT3_SETUP)
 12180	7361	CB	7F			    bit 7, a
 12181	7363	28	27			    jr z, .pt3_upd_play
 12182	7365					    ; Song ended - loop or stop?
 12183	7365	3A	4F	D1		    ld a, (music_loop)
 12184	7368	B7				    or a
 12185	7369	28	1C			    jr z, .pt3_upd_stop
 12186	736B					    ; Loop: reinitialise from same track
 12187	736B	3A	50	D1		    ld a, (music_track_index)
 12188	736E	87				    add a, a
 12189	736F	5F				    ld e, a
 12190	7370	16	00			    ld d, 0
 12191	7372	21	CA	79		    ld hl, music_pt3_track_table
 12192	7375	19				    add hl, de
 12193	7376	5E				    ld e, (hl)
 12194	7377	23				    inc hl
 12195	7378	56				    ld d, (hl)
 12196	7379	62				    ld h, d
 12197	737A	6B				    ld l, e
 12198	737B	DD	E5			    push ix
 12199	737D	FD	E5			    push iy
 12200	737F	CD	B8	73		    call PT3_INIT
 12201	7382	FD	E1			    pop iy
 12202	7384	DD	E1			    pop ix
 12203	7386	C9				    ret
 12204	7387					.pt3_upd_stop:
 12205	7387	AF				    xor a
 12206	7388	32	4D	D1		    ld (music_active), a
 12207	738B	C9				    ret
 12208	738C					.pt3_upd_play:
 12209	738C	DD	E5			    push ix
 12210	738E	FD	E5			    push iy
 12211	7390	CD	1F	78		    call PT3_PLAY
 12212	7393	CD	1F	79		    call PT3_ROUT
 12213	7396	FD	E1			    pop iy
 12214	7398	DD	E1			    pop ix
 12215	739A	C9				    ret
