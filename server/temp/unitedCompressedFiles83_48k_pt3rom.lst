 267	40B3					CHPUT   EQU #00A2        ; Character output (A=char)
 268	40B3					CHGET   EQU #009F        ; Character input
 269	40B3					CHSNS   EQU #009C        ; Character sense (check key)
 270	40B3					BREAKX  EQU #00B7        ; Check CTRL+STOP
 271	40B3					ISCNTC  EQU #00BA        ; Check CTRL+C
