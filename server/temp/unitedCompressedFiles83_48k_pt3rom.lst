 8588	5FCA					; Helper function to set VDP background and border colors
 8589	5FCA					; Input: A = background color (0-15), B = border color (0-15)
 8590	5FCA					set_screen_colors:
 8591	5FCA	F5				    push af
 8592	5FCB	C5				    push bc
 8593	5FCC	E5				    push hl
 8594	5FCD					
 8595	5FCD					    ; Set VDP Register 7: [Background Color (4-7) | Border Color (0-3)]
 8596	5FCD					
 8597	5FCD					    ; OPTIMIZED: Use lookup table instead of 4?? RLCA
 8598	5FCD					    ; Process Background Color (in A) -> High Nibble
 8599	5FCD	E6	0F			    and #0F                    ; Ensure 0-15 range
 8600	5FCF	21	BA	5F		    ld hl, color_shift_table
 8601	5FD2	85				    add a, l                   ; Add offset to table base
 8602	5FD3	6F				    ld l, a
 8603	5FD4	8C				    adc a, h                   ; Handle carry
 8604	5FD5	95				    sub l
 8605	5FD6	67				    ld h, a
 8606	5FD7	7E				    ld a, (hl)                 ; A = background color << 4
 8607	5FD8	4F				    ld c, a                    ; Save shifted background in C
 8608	5FD9					
 8609	5FD9					    ; Process Border Color (in B) -> Low Nibble
 8610	5FD9	78				    ld a, b                    ; Get border color
 8611	5FDA	E6	0F			    and #0F                    ; Ensure 0-15 range
 8612	5FDC					
 8613	5FDC					    ; Combine
 8614	5FDC	B1				    or c                       ; Combine: background << 4 | border
 8615	5FDD					
 8616	5FDD	47				    ld b, a                    ; Value for VDP R#7
 8617	5FDE	0E	07			    ld c, 7                    ; VDP Register 7
 8618	5FE0	CD	F4	40		    call FAST_WRTVDP           ; BIOS call to write VDP register
