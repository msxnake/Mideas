 11385	70AC					.skip_bottom_edge:
 11386	70AC					    
 11387	70AC					    ; Bottom-Right Corner
 11388	70AC	3E	2B			    ld a, 43            ; '+'
 11389	70AE	CD	CE	40		    call FAST_WRTVRM
 11390	70B1					    
 11391	70B1	E1				    pop hl
 11392	70B2	D1				    pop de
