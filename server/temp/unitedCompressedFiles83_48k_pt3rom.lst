 11526	712E					
 11527	712E					; ==================================================================
 11528	712E					; PSG SOUND SYSTEM
 11529	712E					; File: sound.asm
 11530	712E					; Description: AY-3-8910 PSG control and sound effects
 11531	712E					; ==================================================================
 11532	712E					
 11533	712E					; ==================================================================
 11534	712E					; PSG REGISTER ADDRESSES
 11535	712E					; ==================================================================
 11536	712E					
 11537	712E					; Tone Generators (Channels A, B, C)
 11538	712E					PSG_TONE_A_LO       EQU 0        ; Channel A period low byte
 11539	712E					PSG_TONE_A_HI       EQU 1        ; Channel A period high byte (4 bits)
 11540	712E					PSG_TONE_B_LO       EQU 2        ; Channel B period low byte
 11541	712E					PSG_TONE_B_HI       EQU 3        ; Channel B period high byte (4 bits)
 11542	712E					PSG_TONE_C_LO       EQU 4        ; Channel C period low byte
 11543	712E					PSG_TONE_C_HI       EQU 5        ; Channel C period high byte (4 bits)
 11544	712E					
 11545	712E					; Noise Generator
 11546	712E					PSG_NOISE_PERIOD    EQU 6        ; Noise period (5 bits)
 11547	712E					
 11548	712E					; Mixer Control
 11549	712E					PSG_MIXER           EQU 7        ; Mixer/Enable register
 11550	712E					; Bit 0: Channel A tone enable (0=on, 1=off)
 11551	712E					; Bit 1: Channel B tone enable
 11552	712E					; Bit 2: Channel C tone enable
 11553	712E					; Bit 3: Channel A noise enable (0=on, 1=off)
 11554	712E					; Bit 4: Channel B noise enable
 11555	712E					; Bit 5: Channel C noise enable
 11556	712E					
 11557	712E					; Volume Control
 11558	712E					PSG_VOL_A           EQU 8        ; Channel A volume (4 bits) + envelope flag (bit 4)
 11559	712E					PSG_VOL_B           EQU 9        ; Channel B volume
 11560	712E					PSG_VOL_C           EQU 10       ; Channel C volume
 11561	712E					
 11562	712E					; Envelope Generator
 11563	712E					PSG_ENV_LO          EQU 11       ; Envelope period low byte
 11564	712E					PSG_ENV_HI          EQU 12       ; Envelope period high byte
 11565	712E					PSG_ENV_SHAPE       EQU 13       ; Envelope shape (4 bits)
 11566	712E					
 11567	712E					; ==================================================================
 11568	712E					; PSG TONE PERIODS (Musical notes, octave 4, 3.579545 MHz clock)
 11569	712E					; ==================================================================
 11570	712E					
 11571	712E					; Note frequencies for octave 4 (middle C = C4)
 11572	712E					NOTE_C4         EQU 477      ; C  - 261.63 Hz
 11573	712E					NOTE_CS4        EQU 450      ; C# - 277.18 Hz
 11574	712E					NOTE_D4         EQU 425      ; D  - 293.66 Hz
 11575	712E					NOTE_DS4        EQU 401      ; D# - 311.13 Hz
 11576	712E					NOTE_E4         EQU 379      ; E  - 329.63 Hz
 11577	712E					NOTE_F4         EQU 357      ; F  - 349.23 Hz
 11578	712E					NOTE_FS4        EQU 337      ; F# - 369.99 Hz
 11579	712E					NOTE_G4         EQU 318      ; G  - 392.00 Hz
 11580	712E					NOTE_GS4        EQU 300      ; G# - 415.30 Hz
 11581	712E					NOTE_A4         EQU 284      ; A  - 440.00 Hz
 11582	712E					NOTE_AS4        EQU 268      ; A# - 466.16 Hz
 11583	712E					NOTE_B4         EQU 253      ; B  - 493.88 Hz
 11584	712E					NOTE_C5         EQU 238      ; C5 - 523.25 Hz
 11585	712E					
 11586	712E					; Octave multipliers: Divide period by 2 for +1 octave, multiply by 2 for -1 octave
 11587	712E					
 11588	712E					; ==================================================================
 11589	712E					; SOUND EFFECT DURATIONS (in frames, 60Hz)
 11590	712E					; ==================================================================
 11591	712E					
 11592	712E					SFX_SHORT           EQU 5        ; ~83ms
 11593	712E					SFX_MEDIUM          EQU 15       ; ~250ms
 11594	712E					SFX_LONG            EQU 30       ; ~500ms
 11595	712E					
 11596	712E					; ==================================================================
 11597	712E					; SOUND SYSTEM INITIALIZATION
 11598	712E					; ==================================================================
 11599	712E					
 11600	712E					init_sound_system:
 11601	712E					    ; Initialize PSG via BIOS
 11602	712E	CD	90	00		    call GICINI
 11603	7131					
 11604	7131					    ; Clear runtime sound state so power-on RAM garbage cannot make
 11605	7131					    ; sfx_update / SM_UpdateSound drive the PSG for a few random frames.
 11606	7131	AF				    xor a
 11607	7132	32	B8	CD		    ld (sfx_active), a
 11608	7135	32	B9	CD		    ld (sfx_timer), a
 11609	7138	32	BA	CD		    ld (sfx_fadeout), a
 11610	713B	32	49	D1		    ld (sm_sound_active), a
 11611	713E	32	4A	D1		    ld (sm_sound_frames_left), a
 11612	7141	32	4B	D1		    ld (sm_sound_ptr_l), a
 11613	7144	32	4C	D1		    ld (sm_sound_ptr_h), a
 11614	7147	CD	AD	72		    call music_init_system
 11615	714A					
 11616	714A					    ; Silence all channels
 11617	714A	CD	91	71		    call sfx_silence_all
 11618	714D					
 11619	714D	C9				    ret
 11620	714E					
 11621	714E					; ==================================================================
 11622	714E					; PSG LOW-LEVEL CONTROL FUNCTIONS
 11623	714E					; ==================================================================
 11624	714E					
 11625	714E					; ------------------------------------------------------------------
 11626	714E					; psg_write
 11627	714E					; Write to PSG register via BIOS
 11628	714E					; Input:  A = Register number (0-13)
 11629	714E					;         E = Value to write
 11630	714E					; Destroys: AF, E
 11631	714E					; ------------------------------------------------------------------
 11632	714E					psg_write:
 11633	714E	CD	93	00		    call WRTPSG
 11634	7151	C9				    ret
 11635	7152					
 11636	7152					; ------------------------------------------------------------------
 11637	7152					; psg_set_tone
 11638	7152					; Set tone period for a channel
 11639	7152					; Input:  A = Channel (0=A, 1=B, 2=C)
 11640	7152					;         HL = Tone period (12-bit value)
 11641	7152					; Destroys: AF, BC, DE, HL
 11642	7152					; ------------------------------------------------------------------
 11643	7152					psg_set_tone:
 11644	7152					    ; Calculate register numbers (A*2 for low, A*2+1 for high)
 11645	7152	87				    add a, a                     ; A = channel * 2
 11646	7153	4F				    ld c, a                      ; C = low register number
 11647	7154	3C				    inc a
 11648	7155	47				    ld b, a                      ; B = high register number
 11649	7156					
 11650	7156					    ; Write low byte
 11651	7156	79				    ld a, c
 11652	7157	5D				    ld e, l
 11653	7158	CD	93	00		    call WRTPSG
 11654	715B					
 11655	715B					    ; Write high byte (only lower 4 bits)
 11656	715B	78				    ld a, b
 11657	715C	5C				    ld e, h
 11658	715D	7B				    ld a, e
 11659	715E	E6	0F			    and #0F
 11660	7160	5F				    ld e, a
 11661	7161	78				    ld a, b
 11662	7162	CD	93	00		    call WRTPSG
 11663	7165					
 11664	7165	C9				    ret
 11665	7166					
 11666	7166					; ------------------------------------------------------------------
 11667	7166					; psg_set_volume
 11668	7166					; Set volume for a channel
 11669	7166					; Input:  A = Channel (0=A, 1=B, 2=C)
 11670	7166					;         B = Volume (0-15) or #10 to enable PSG hardware envelope
 11671	7166					; Destroys: AF, E
 11672	7166					; ------------------------------------------------------------------
 11673	7166					psg_set_volume:
 11674	7166	C6	08			    add a, PSG_VOL_A             ; A = PSG_VOL_x register
 11675	7168	58				    ld e, b                      ; E = volume value
 11676	7169	CD	93	00		    call WRTPSG
 11677	716C	C9				    ret
 11678	716D					
 11679	716D					; ------------------------------------------------------------------
 11680	716D					; psg_set_noise
 11681	716D					; Set noise generator period
 11682	716D					; Input:  A = Noise period (0-31)
 11683	716D					; Destroys: AF, E
 11684	716D					; ------------------------------------------------------------------
 11685	716D					psg_set_noise:
 11686	716D	5F				    ld e, a
 11687	716E	3E	06			    ld a, PSG_NOISE_PERIOD
 11688	7170	CD	93	00		    call WRTPSG
 11689	7173	C9				    ret
 11690	7174					
 11691	7174					; ------------------------------------------------------------------
 11692	7174					; psg_set_mixer
 11693	7174					; Set mixer control (enable/disable tone and noise)
 11694	7174					; Input:  A = Mixer value
 11695	7174					;         Bits 0-2: Tone off (0=on, 1=off) for channels A,B,C
 11696	7174					;         Bits 3-5: Noise off (0=on, 1=off) for channels A,B,C
 11697	7174					; Destroys: AF, E
 11698	7174					; ------------------------------------------------------------------
 11699	7174					psg_set_mixer:
 11700	7174	5F				    ld e, a
 11701	7175	3E	07			    ld a, PSG_MIXER
 11702	7177	CD	93	00		    call WRTPSG
 11703	717A	C9				    ret
 11704	717B					
 11705	717B					; ------------------------------------------------------------------
 11706	717B					; psg_set_envelope
 11707	717B					; Program the global PSG hardware envelope generator
 11708	717B					; Input:  HL = Envelope period
 11709	717B					;         B = Envelope shape (0-15)
 11710	717B					; Destroys: AF, E
 11711	717B					; ------------------------------------------------------------------
 11712	717B					psg_set_envelope:
 11713	717B	3E	0B			    ld a, PSG_ENV_LO
 11714	717D	5D				    ld e, l
 11715	717E	CD	93	00		    call WRTPSG
 11716	7181	3E	0C			    ld a, PSG_ENV_HI
 11717	7183	5C				    ld e, h
 11718	7184	CD	93	00		    call WRTPSG
 11719	7187	78				    ld a, b
 11720	7188	E6	0F			    and #0F
 11721	718A	5F				    ld e, a
 11722	718B	3E	0D			    ld a, PSG_ENV_SHAPE
 11723	718D	CD	93	00		    call WRTPSG
 11724	7190	C9				    ret
 11725	7191					
 11726	7191					; ==================================================================
 11727	7191					; HIGH-LEVEL SOUND EFFECTS
 11728	7191					; ==================================================================
 11729	7191					
 11730	7191					; ------------------------------------------------------------------
 11731	7191					; sfx_silence_all
 11732	7191					; Silence all PSG channels
 11733	7191					; ------------------------------------------------------------------
 11734	7191					sfx_silence_all:
 11735	7191					    ; Set all volumes to 0
 11736	7191	AF				    xor a                        ; A = channel A
 11737	7192	06	00			    ld b, 0                      ; B = volume 0
 11738	7194	CD	66	71		    call psg_set_volume
 11739	7197					
 11740	7197	3E	01			    ld a, 1                      ; A = channel B
 11741	7199	06	00			    ld b, 0
 11742	719B	CD	66	71		    call psg_set_volume
 11743	719E					
 11744	719E	3E	02			    ld a, 2                      ; A = channel C
 11745	71A0	06	00			    ld b, 0
 11746	71A2	CD	66	71		    call psg_set_volume
 11747	71A5					
 11748	71A5					    ; Disable all tone and noise
 11749	71A5	3E	3F			    ld a, #3F                    ; All tone and noise off
 11750	71A7	CD	74	71		    call psg_set_mixer
 11751	71AA					
 11752	71AA	C9				    ret
 11753	71AB					
 11754	71AB					; ------------------------------------------------------------------
 11755	71AB					; sfx_beep
 11756	71AB					; Simple beep sound
 11757	71AB					; ------------------------------------------------------------------
 11758	71AB					sfx_beep:
 11759	71AB					    ; Channel A: 440Hz (A4)
 11760	71AB	AF				    xor a                        ; A = channel A
 11761	71AC	21	1C	01		    ld hl, NOTE_A4
 11762	71AF	CD	52	71		    call psg_set_tone
 11763	71B2					
 11764	71B2					    ; Volume 12
 11765	71B2	AF				    xor a
 11766	71B3	06	0C			    ld b, 12
 11767	71B5	CD	66	71		    call psg_set_volume
 11768	71B8					
 11769	71B8					    ; Enable tone A only
 11770	71B8	3E	3E			    ld a, #3E                    ; Tone A on, others off
 11771	71BA	CD	74	71		    call psg_set_mixer
 11772	71BD					
 11773	71BD	C9				    ret
 11774	71BE					
 11775	71BE					; ------------------------------------------------------------------
 11776	71BE					; sfx_jump
 11777	71BE					; Jump sound effect (rising pitch)
 11778	71BE					; ------------------------------------------------------------------
 11779	71BE					sfx_jump:
 11780	71BE					    ; Channel A: Start at C4, quick rise
 11781	71BE	AF				    xor a
 11782	71BF	21	DD	01		    ld hl, NOTE_C4
 11783	71C2	CD	52	71		    call psg_set_tone
 11784	71C5					
 11785	71C5					    ; Volume 10
 11786	71C5	AF				    xor a
 11787	71C6	06	0A			    ld b, 10
 11788	71C8	CD	66	71		    call psg_set_volume
 11789	71CB					
 11790	71CB					    ; Enable tone A
 11791	71CB	3E	3E			    ld a, #3E
 11792	71CD	CD	74	71		    call psg_set_mixer
 11793	71D0					
 11794	71D0					    ; TODO: Add pitch sweep for realistic jump sound
 11795	71D0	C9				    ret
 11796	71D1					
 11797	71D1					; ------------------------------------------------------------------
 11798	71D1					; sfx_shoot
 11799	71D1					; Shooting sound (noise + low tone)
 11800	71D1					; ------------------------------------------------------------------
 11801	71D1					sfx_shoot:
 11802	71D1					    ; Channel A: Low tone
 11803	71D1	AF				    xor a
 11804	71D2	21	64	00		    ld hl, 100                   ; Low period = high pitch
 11805	71D5	CD	52	71		    call psg_set_tone
 11806	71D8					
 11807	71D8					    ; Volume 8
 11808	71D8	AF				    xor a
 11809	71D9	06	08			    ld b, 8
 11810	71DB	CD	66	71		    call psg_set_volume
 11811	71DE					
 11812	71DE					    ; Noise generator at period 5
 11813	71DE	3E	05			    ld a, 5
 11814	71E0	CD	6D	71		    call psg_set_noise
 11815	71E3					
 11816	71E3					    ; Enable tone A + noise A
 11817	71E3	3E	36			    ld a, #36                    ; Tone A + Noise A on
 11818	71E5	CD	74	71		    call psg_set_mixer
 11819	71E8					
 11820	71E8	C9				    ret
 11821	71E9					
 11822	71E9					; ------------------------------------------------------------------
 11823	71E9					; sfx_explosion
 11824	71E9					; Explosion sound (noise-heavy)
 11825	71E9					; ------------------------------------------------------------------
 11826	71E9					sfx_explosion:
 11827	71E9					    ; Noise generator at period 10
 11828	71E9	3E	0A			    ld a, 10
 11829	71EB	CD	6D	71		    call psg_set_noise
 11830	71EE					
 11831	71EE					    ; Channel A: Volume 15 (max) with noise
 11832	71EE	AF				    xor a
 11833	71EF	06	0F			    ld b, 15
 11834	71F1	CD	66	71		    call psg_set_volume
 11835	71F4					
 11836	71F4					    ; Enable noise A only (no tone)
 11837	71F4	3E	39			    ld a, #39                    ; Noise A on, tone off
 11838	71F6	CD	74	71		    call psg_set_mixer
 11839	71F9					
 11840	71F9	C9				    ret
 11841	71FA					
 11842	71FA					; ------------------------------------------------------------------
 11843	71FA					; sfx_coin
 11844	71FA					; Coin/pickup sound (quick ascending notes)
 11845	71FA					; ------------------------------------------------------------------
 11846	71FA					sfx_coin:
 11847	71FA					    ; Channel B: E4 note
 11848	71FA	3E	01			    ld a, 1                      ; Channel B
 11849	71FC	21	7B	01		    ld hl, NOTE_E4
 11850	71FF	CD	52	71		    call psg_set_tone
 11851	7202					
 11852	7202					    ; Volume 10
 11853	7202	3E	01			    ld a, 1
 11854	7204	06	0A			    ld b, 10
 11855	7206	CD	66	71		    call psg_set_volume
 11856	7209					
 11857	7209					    ; Enable tone B
 11858	7209	3E	3D			    ld a, #3D                    ; Tone B on, others off
 11859	720B	CD	74	71		    call psg_set_mixer
 11860	720E					
 11861	720E					    ; TODO: Quick ascend to G4 for classic coin sound
 11862	720E	C9				    ret
 11863	720F					
 11864	720F					; ------------------------------------------------------------------
 11865	720F					; sfx_damage
 11866	720F					; Damage/hit sound (harsh noise)
 11867	720F					; ------------------------------------------------------------------
 11868	720F					sfx_damage:
 11869	720F					    ; Short noise burst
 11870	720F	3E	03			    ld a, 3                      ; Harsh noise period
 11871	7211	CD	6D	71		    call psg_set_noise
 11872	7214					
 11873	7214					    ; Channel C: Volume 12
 11874	7214	3E	02			    ld a, 2                      ; Channel C
 11875	7216	06	0C			    ld b, 12
 11876	7218	CD	66	71		    call psg_set_volume
 11877	721B					
 11878	721B					    ; Enable noise C only
 11879	721B	3E	1F			    ld a, #1F                    ; Noise C on
 11880	721D	CD	74	71		    call psg_set_mixer
 11881	7220					
 11882	7220	C9				    ret
 11883	7221					
 11884	7221					; ==================================================================
 11885	7221					; SOUND EFFECT PLAYBACK SYSTEM
 11886	7221					; ==================================================================
 11887	7221					; This section provides a simple sound effect manager that can
 11888	7221					; play effects with automatic duration and fadeout
 11889	7221					
 11890	7221					; Runtime state lives in variables.asm:
 11891	7221					;   sfx_active, sfx_timer, sfx_fadeout
 11892	7221					
 11893	7221					; ------------------------------------------------------------------
 11894	7221					; play_sound_effect
 11895	7221					; Play one of the built-in sound effects by ID
 11896	7221					; Input:  A = sound ID
 11897	7221					;         0=beep, 1=jump, 2=shoot, 3=explosion, 4=coin, 5=damage
 11898	7221					; Destroys: AF, BC, DE, HL
 11899	7221					; ------------------------------------------------------------------
 11900	7221					play_sound_effect:
 11901	7221	3A	4D	D1		    ld a, (music_active)
 11902	7224	B7				    or a
 11903	7225	C0				    ret nz
 11904	7226	FE	01			    cp 1
 11905	7228	CA	48	72		    jp z, play_sound_effect_jump
 11906	722B	FE	02			    cp 2
 11907	722D	CA	51	72		    jp z, play_sound_effect_shoot
 11908	7230	FE	03			    cp 3
 11909	7232	CA	5A	72		    jp z, play_sound_effect_explosion
 11910	7235	FE	04			    cp 4
 11911	7237	CA	63	72		    jp z, play_sound_effect_coin
 11912	723A	FE	05			    cp 5
 11913	723C	CA	6C	72		    jp z, play_sound_effect_damage
 11914	723F					
 11915	723F					play_sound_effect_beep:
 11916	723F	21	AB	71		    ld hl, sfx_beep
 11917	7242	06	05			    ld b, SFX_SHORT
 11918	7244	CD	75	72		    call sfx_play
 11919	7247	C9				    ret
 11920	7248					
 11921	7248					play_sound_effect_jump:
 11922	7248	21	BE	71		    ld hl, sfx_jump
 11923	724B	06	05			    ld b, SFX_SHORT
 11924	724D	CD	75	72		    call sfx_play
 11925	7250	C9				    ret
 11926	7251					
 11927	7251					play_sound_effect_shoot:
 11928	7251	21	D1	71		    ld hl, sfx_shoot
 11929	7254	06	05			    ld b, SFX_SHORT
 11930	7256	CD	75	72		    call sfx_play
 11931	7259	C9				    ret
 11932	725A					
 11933	725A					play_sound_effect_explosion:
 11934	725A	21	E9	71		    ld hl, sfx_explosion
 11935	725D	06	0F			    ld b, SFX_MEDIUM
 11936	725F	CD	75	72		    call sfx_play
 11937	7262	C9				    ret
 11938	7263					
 11939	7263					play_sound_effect_coin:
 11940	7263	21	FA	71		    ld hl, sfx_coin
 11941	7266	06	05			    ld b, SFX_SHORT
 11942	7268	CD	75	72		    call sfx_play
 11943	726B	C9				    ret
 11944	726C					
 11945	726C					play_sound_effect_damage:
 11946	726C	21	0F	72		    ld hl, sfx_damage
 11947	726F	06	05			    ld b, SFX_SHORT
 11948	7271	CD	75	72		    call sfx_play
 11949	7274	C9				    ret
 11950	7275					
 11951	7275					; ------------------------------------------------------------------
 11952	7275					; sfx_play
 11953	7275					; Play a sound effect with duration
 11954	7275					; Input:  HL = Sound effect function address
 11955	7275					;         B = Duration in frames
 11956	7275					; ------------------------------------------------------------------
 11957	7275					sfx_play:
 11958	7275	3A	4D	D1		    ld a, (music_active)
 11959	7278	B7				    or a
 11960	7279	C0				    ret nz
 11961	727A					    ; Call the sound effect function
 11962	727A	C5				    push bc
 11963	727B	E5				    push hl
 11964	727C	11	81	72		    ld de, .return_address
 11965	727F	D5				    push de
 11966	7280	E9				    jp (hl)                      ; Indirect call
 11967	7281					.return_address:
 11968	7281	E1				    pop hl
 11969	7282	C1				    pop bc
 11970	7283					
 11971	7283					    ; Set timer
 11972	7283	78				    ld a, b
 11973	7284	32	B9	CD		    ld (sfx_timer), a
 11974	7287					
 11975	7287					    ; Mark as active
 11976	7287	3E	01			    ld a, 1
 11977	7289	32	B8	CD		    ld (sfx_active), a
 11978	728C					
 11979	728C	C9				    ret
 11980	728D					
 11981	728D					; ------------------------------------------------------------------
 11982	728D					; sfx_update
 11983	728D					; Update sound effect system (call every frame)
 11984	728D					; Handles automatic fadeout and silence
 11985	728D					; ------------------------------------------------------------------
 11986	728D					sfx_update:
 11987	728D	3A	4D	D1		    ld a, (music_active)
 11988	7290	B7				    or a
 11989	7291	C0				    ret nz
 11990	7292					    ; Check if sound is active
 11991	7292	3A	B8	CD		    ld a, (sfx_active)
 11992	7295	B7				    or a
 11993	7296	C8				    ret z                        ; No active sound
 11994	7297					
 11995	7297					    ; Decrement timer
 11996	7297	3A	B9	CD		    ld a, (sfx_timer)
 11997	729A	B7				    or a
 11998	729B	28	08			    jr z, .silence_now
 11999	729D					
 12000	729D	3D				    dec a
 12001	729E	32	B9	CD		    ld (sfx_timer), a
 12002	72A1					
 12003	72A1					    ; Check if entering fadeout zone (last 5 frames)
 12004	72A1	FE	05			    cp 5
 12005	72A3	D0				    ret nc                       ; Still in main sound
 12006	72A4					
 12007	72A4					    ; TODO: Implement volume fadeout here
 12008	72A4	C9				    ret
 12009	72A5					
 12010	72A5					.silence_now:
 12011	72A5	CD	91	71		    call sfx_silence_all
 12012	72A8	AF				    xor a
 12013	72A9	32	B8	CD		    ld (sfx_active), a
 12014	72AC	C9				    ret
 12015	72AD					
 12016	72AD					; ==================================================================
 12017	72AD					; PT3 MUSIC BACKEND
 12018	72AD					; Uses the PT3 replayer for AY-3-8910 music playback.
 12019	72AD					; PT3_SETUP, ChanA, AYREGS, etc. are defined in variables.asm.
 12020	72AD					; ==================================================================
 12021	72AD					
 12022	72AD					; ------------------------------------------------------------------
 12023	72AD					; music_init_system
 12024	72AD					; Reset PT3 music state. Call once at startup.
 12025	72AD					; Destroys: AF
 12026	72AD					; ------------------------------------------------------------------
 12027	72AD					music_init_system:
 12028	72AD	AF				    xor a
 12029	72AE	32	4D	D1		    ld (music_active), a
 12030	72B1	32	4E	D1		    ld (music_muted), a
