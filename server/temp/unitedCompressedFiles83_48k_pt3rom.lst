 11096	6FB9	15				    dec d                       ; Frame X = Content X - 1
 11097	6FBA	1D				    dec e                       ; Frame Y = Content Y - 1
 11098	6FBB					    
 11099	6FBB					    ; Frame Width = Content Width + 2
 11100	6FBB	04				    inc b
