 19667	9735					; ------------------------------------------------------------------
 19668	9735					; EFFECT 5: SPIRAL - Pixel-row resolution via color table manipulation
 19669	9735					; Clears pixel rows from outside in (top+bottom simultaneously).
 19670	9735					; Works by setting color table bytes to 0x11 (black fg + black bg)
 19671	9735					; for all 256 tile patterns at the given pixel sub-row in each bank.
 19672	9735					; 96 rings: rows (0,191), (1,190), (2,189), ..., (95,96)
 19673	9735					; ------------------------------------------------------------------
 19674	9735					.trans_spiral:
 19675	9735	06	00			    ld b, 0                       ; B = top pixel row (0..95)
 19676	9737	0E	BF			    ld c, 191                     ; C = bottom pixel row (191..96)
 19677	9739					.tsp_loop:
 19678	9739	78				    ld a, b
 19679	973A	CD	87	97		    call trans_clear_pixel_row_colors   ; blacken pixel row B (top)
 19680	973D	79				    ld a, c
 19681	973E	CD	87	97		    call trans_clear_pixel_row_colors   ; blacken pixel row C (bottom)
 19682	9741	CD	BF	97		    call trans_wait_frames
 19683	9744	04				    inc b
 19684	9745	0D				    dec c
 19685	9746	78				    ld a, b
 19686	9747	B9				    cp c
 19687	9748	38	EF			    jr c, .tsp_loop               ; loop while top < bottom
 19688	974A	C9				    ret
