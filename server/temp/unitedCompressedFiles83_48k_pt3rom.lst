 13298	7D86					
 13299	7D86					; ==================================================================
 13300	7D86					; PARTICLE SYSTEM (VRAM Pattern Redefinition)
 13301	7D86					; File: particles.asm
 13302	7D86					; Description: Visual effects using dynamic tile pattern updates
 13303	7D86					; ==================================================================
 13304	7D86					
 13305	7D86					; ==================================================================
 13306	7D86					; PARTICLE SYSTEM CONSTANTS
 13307	7D86					; ==================================================================
 13308	7D86					
 13309	7D86					; Maximum active particles
 13310	7D86					MAX_PARTICLES           EQU 8       ; Support up to 8 simultaneous particles
 13311	7D86					
 13312	7D86					; Reserved tile IDs for particles (248-255)
 13313	7D86					PARTICLE_TILE_BASE      EQU 248     ; First tile ID for particles
 13314	7D86					
 13315	7D86					; Particle types
 13316	7D86					PARTICLE_NONE           EQU 0       ; Inactive particle slot
 13317	7D86					PARTICLE_EXPLOSION      EQU 1       ; Explosion (4 frames, expands outward)
 13318	7D86					PARTICLE_SMOKE          EQU 2       ; Smoke puff (4 frames, rises up)
 13319	7D86					PARTICLE_SPARK          EQU 3       ; Spark/flash (2 frames, quick)
 13320	7D86					PARTICLE_DUST           EQU 4       ; Dust cloud (3 frames, fades)
 13321	7D86					PARTICLE_IMPACT         EQU 5       ; Impact star (3 frames, shrinks)
 13322	7D86					PARTICLE_DEBRIS         EQU 6       ; Debris chunk (2 frames, falls)
 13323	7D86					PARTICLE_MUZZLE_FLASH   EQU 7       ; Muzzle flash (2 frames, instant)
 13324	7D86					PARTICLE_WATER_SPLASH   EQU 8       ; Water splash (4 frames, arcs)
 13325	7D86					
 13326	7D86					; Particle lifetimes (in frames)
 13327	7D86					LIFE_EXPLOSION          EQU 16      ; ~267ms
 13328	7D86					LIFE_SMOKE              EQU 24      ; ~400ms
 13329	7D86					LIFE_SPARK              EQU 8       ; ~133ms
 13330	7D86					LIFE_DUST               EQU 12      ; ~200ms
 13331	7D86					LIFE_IMPACT             EQU 10      ; ~167ms
 13332	7D86					LIFE_DEBRIS             EQU 20      ; ~333ms
 13333	7D86					LIFE_MUZZLE_FLASH       EQU 4       ; ~67ms (very quick)
 13334	7D86					LIFE_WATER_SPLASH       EQU 18      ; ~300ms
 13335	7D86					
 13336	7D86					; Particle pool structure (8 bytes per particle)
 13337	7D86					; Offset 0: Type (PARTICLE_*)
 13338	7D86					; Offset 1: Lifetime remaining (frames)
 13339	7D86					; Offset 2: X position (screen coords, 0-31 tiles)
 13340	7D86					; Offset 3: Y position (screen coords, 0-23 tiles)
 13341	7D86					; Offset 4: Animation frame (0-3)
 13342	7D86					; Offset 5: Tile ID assigned (248-255)
 13343	7D86					; Offset 6: Velocity X (signed, -128 to 127)
 13344	7D86					; Offset 7: Velocity Y (signed, -128 to 127)
 13345	7D86					
 13346	7D86					PARTICLE_STRUCT_SIZE    EQU 8
 13347	7D86					
 13348	7D86					; ==================================================================
 13349	7D86					; PARTICLE SYSTEM INITIALIZATION
 13350	7D86					; ==================================================================
 13351	7D86					
 13352	7D86					init_particle_system:
 13353	7D86					    ; Clear particle pool
 13354	7D86	21	40	C6		    ld hl, particle_pool
 13355	7D89	11	41	C6		    ld de, particle_pool + 1
 13356	7D8C	01	3F	00		    ld bc, MAX_PARTICLES * PARTICLE_STRUCT_SIZE - 1
 13357	7D8F	36	00			    ld (hl), PARTICLE_NONE
 13358	7D91	ED	B0			    ldir
 13359	7D93					
 13360	7D93					    ; Initialize tile ID assignments
 13361	7D93	3E	F8			    ld a, PARTICLE_TILE_BASE
 13362	7D95	06	08			    ld b, MAX_PARTICLES
 13363	7D97	21	45	C6		    ld hl, particle_pool + 5    ; Offset to tile_id field
 13364	7D9A					.part_init_tile_loop:
 13365	7D9A	77				    ld (hl), a
 13366	7D9B	3C				    inc a
 13367	7D9C	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 13368	7D9F	19				    add hl, de
 13369	7DA0	10	F8			    djnz .part_init_tile_loop
 13370	7DA2					
 13371	7DA2	C9				    ret
 13372	7DA3					
 13373	7DA3					; ==================================================================
 13374	7DA3					; PARTICLE SPAWNING FUNCTIONS
 13375	7DA3					; ==================================================================
 13376	7DA3					
 13377	7DA3					; ------------------------------------------------------------------
 13378	7DA3					; spawn_particle
 13379	7DA3					; Create a new particle at given position
 13380	7DA3					; Input:  A = Particle type (PARTICLE_*)
 13381	7DA3					;         B = X position (tile coords, 0-31)
 13382	7DA3					;         C = Y position (tile coords, 0-23)
 13383	7DA3					;         D = Velocity X (optional, signed)
 13384	7DA3					;         E = Velocity Y (optional, signed)
 13385	7DA3					; Output: A = 1 if spawned successfully, 0 if pool full
 13386	7DA3					; Destroys: AF, BC, DE, HL
 13387	7DA3					; ------------------------------------------------------------------
 13388	7DA3					spawn_particle:
 13389	7DA3	F5				    push af                     ; Save particle type
 13390	7DA4	C5				    push bc                     ; Save position
 13391	7DA5	D5				    push de                     ; Save velocity
 13392	7DA6					
 13393	7DA6					    ; Find free particle slot
 13394	7DA6	CD	D3	7D		    call find_free_particle
 13395	7DA9	28	23			    jr z, .part_spawn_failed    ; Z flag set = no free slots
 13396	7DAB					
 13397	7DAB					    ; HL points to free particle structure
 13398	7DAB	D1				    pop de                      ; Restore velocity
 13399	7DAC	C1				    pop bc                      ; Restore position
 13400	7DAD	F1				    pop af                      ; Restore type
 13401	7DAE					
 13402	7DAE					    ; Fill particle structure
 13403	7DAE	77				    ld (hl), a                  ; Offset 0: type
 13404	7DAF	23				    inc hl
 13405	7DB0					
 13406	7DB0					    ; Set lifetime based on type
 13407	7DB0	E5				    push hl
 13408	7DB1	CD	E6	7D		    call get_particle_lifetime  ; A = type -> A = lifetime
 13409	7DB4	E1				    pop hl
 13410	7DB5	77				    ld (hl), a                  ; Offset 1: lifetime
 13411	7DB6	23				    inc hl
 13412	7DB7					
 13413	7DB7	70				    ld (hl), b                  ; Offset 2: X position
 13414	7DB8	23				    inc hl
 13415	7DB9	71				    ld (hl), c                  ; Offset 3: Y position
 13416	7DBA	23				    inc hl
 13417	7DBB					
 13418	7DBB	AF				    xor a
 13419	7DBC	77				    ld (hl), a                  ; Offset 4: frame = 0
 13420	7DBD	23				    inc hl
 13421	7DBE	23				    inc hl                      ; Skip tile_id (already assigned)
 13422	7DBF					
 13423	7DBF	72				    ld (hl), d                  ; Offset 6: velocity X
 13424	7DC0	23				    inc hl
 13425	7DC1	73				    ld (hl), e                  ; Offset 7: velocity Y
 13426	7DC2					
 13427	7DC2					    ; Place particle tile on screen immediately
 13428	7DC2	2B				    dec hl
 13429	7DC3	2B				    dec hl
 13430	7DC4	2B				    dec hl
 13431	7DC5	2B				    dec hl
 13432	7DC6	2B				    dec hl
 13433	7DC7	2B				    dec hl                      ; Back to start of structure
 13434	7DC8	CD	62	7E		    call draw_particle_tile
 13435	7DCB					
 13436	7DCB	3E	01			    ld a, 1                     ; Success
 13437	7DCD	C9				    ret
 13438	7DCE					
 13439	7DCE					.part_spawn_failed:
 13440	7DCE	D1				    pop de
 13441	7DCF	C1				    pop bc
 13442	7DD0	F1				    pop af
 13443	7DD1	AF				    xor a                       ; Failed
 13444	7DD2	C9				    ret
 13445	7DD3					
 13446	7DD3					; ------------------------------------------------------------------
 13447	7DD3					; find_free_particle
 13448	7DD3					; Find first inactive particle slot
 13449	7DD3					; Output: HL = Address of free particle, Z flag clear
 13450	7DD3					;         Z flag set if no free slots
 13451	7DD3					; ------------------------------------------------------------------
 13452	7DD3					find_free_particle:
 13453	7DD3	21	40	C6		    ld hl, particle_pool
 13454	7DD6	06	08			    ld b, MAX_PARTICLES
 13455	7DD8					.part_find_loop:
 13456	7DD8	7E				    ld a, (hl)
 13457	7DD9	FE	00			    cp PARTICLE_NONE
 13458	7DDB	C8				    ret z                       ; Found free slot
 13459	7DDC					
 13460	7DDC	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 13461	7DDF	19				    add hl, de
 13462	7DE0	10	F6			    djnz .part_find_loop
 13463	7DE2					
 13464	7DE2					    ; No free slot found
 13465	7DE2	AF				    xor a
 13466	7DE3	F6	01			    or 1                        ; Clear Z flag
 13467	7DE5	C9				    ret
 13468	7DE6					
 13469	7DE6					; ------------------------------------------------------------------
 13470	7DE6					; get_particle_lifetime
 13471	7DE6					; Get default lifetime for particle type
 13472	7DE6					; Input:  A = Particle type
 13473	7DE6					; Output: A = Lifetime in frames
 13474	7DE6					; ------------------------------------------------------------------
 13475	7DE6					get_particle_lifetime:
 13476	7DE6	21	EF	7D		    ld hl, particle_lifetime_table
 13477	7DE9	5F				    ld e, a
 13478	7DEA	16	00			    ld d, 0
 13479	7DEC	19				    add hl, de
 13480	7DED	7E				    ld a, (hl)
 13481	7DEE	C9				    ret
 13482	7DEF					
 13483	7DEF					particle_lifetime_table:
 13484	7DEF	00				    db 0                        ; PARTICLE_NONE
 13485	7DF0	10				    db LIFE_EXPLOSION           ; PARTICLE_EXPLOSION
 13486	7DF1	18				    db LIFE_SMOKE               ; PARTICLE_SMOKE
 13487	7DF2	08				    db LIFE_SPARK               ; PARTICLE_SPARK
 13488	7DF3	0C				    db LIFE_DUST                ; PARTICLE_DUST
 13489	7DF4	0A				    db LIFE_IMPACT              ; PARTICLE_IMPACT
 13490	7DF5	14				    db LIFE_DEBRIS              ; PARTICLE_DEBRIS
 13491	7DF6	04				    db LIFE_MUZZLE_FLASH        ; PARTICLE_MUZZLE_FLASH
 13492	7DF7	12				    db LIFE_WATER_SPLASH        ; PARTICLE_WATER_SPLASH
