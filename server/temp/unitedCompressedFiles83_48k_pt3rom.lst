 21350	A3CE					; ==================================================================
 21351	A3CE					; ZX0 SPRITE COPY HELPER (AUTO-INJECTED)
 21352	A3CE					; - If HL points to a compressed sprite frame blob, decompress frame
 21353	A3CE					;   to ZX0_SPRITE_FRAME_BUFFER and then upload to VRAM.
 21354	A3CE					; - Otherwise copy raw frame data directly to VRAM.
 21355	A3CE					; Input: HL=source (ROM), DE=VRAM destination, BC=byte count
 21356	A3CE					; ==================================================================
 21357	A3CE					COPY_SPRITE_SRC_TO_VRAM:
 21358	A3CE	D5				    push de
 21359	A3CF					    ; source < ZX0_SPRITE_FRAME_DATA_START => raw copy
 21360	A3CF	E5				    push hl
 21361	A3D0	11	F3	9D		    ld de, ZX0_SPRITE_FRAME_DATA_START
 21362	A3D3	B7				    or a
 21363	A3D4	ED	52			    sbc hl, de
 21364	A3D6	E1				    pop hl
 21365	A3D7	38	1D			    jr c, COPY_SPRITE_SRC_TO_VRAM_RAW
 21366	A3D9					
 21367	A3D9					    ; source >= ZX0_SPRITE_FRAME_DATA_END_LABEL => raw copy
 21368	A3D9	E5				    push hl
 21369	A3DA	11	CD	A3		    ld de, ZX0_SPRITE_FRAME_DATA_END_LABEL
 21370	A3DD	B7				    or a
 21371	A3DE	ED	52			    sbc hl, de
 21372	A3E0	E1				    pop hl
 21373	A3E1	30	13			    jr nc, COPY_SPRITE_SRC_TO_VRAM_RAW
 21374	A3E3					
 21375	A3E3					    ; Compressed frame: decompress to shared RAM buffer, then upload
 21376	A3E3	D1				    pop de
 21377	A3E4	C5				    push bc
 21378	A3E5	D5				    push de
 21379	A3E6	E5				    push hl
 21380	A3E7	11	00	E0		    ld de, ZX0_SPRITE_FRAME_BUFFER
 21381	A3EA	CD	FA	A3		    call dzx0_standard
 21382	A3ED	E1				    pop hl
 21383	A3EE	D1				    pop de
 21384	A3EF	C1				    pop bc
 21385	A3F0	21	00	E0		    ld hl, ZX0_SPRITE_FRAME_BUFFER
 21386	A3F3	C3	B3	40		    jp FAST_LDIRVM
 21387	A3F6					
 21388	A3F6					COPY_SPRITE_SRC_TO_VRAM_RAW:
 21389	A3F6	D1				    pop de
 21390	A3F7	C3	B3	40		    jp FAST_LDIRVM
 21391	A3FA					
 21392	A3FA					; ==================================================================
 21393	A3FA					; ZX0 DECOMPRESSOR (AUTO-INJECTED)
 21394	A3FA					; ==================================================================
 21395	A3FA					; -----------------------------------------------------------------------------
 21396	A3FA					; ZX0 decoder by Einar Saukas & Urusergi
 21397	A3FA					; "Standard" version (68 bytes only)
 21398	A3FA					; -----------------------------------------------------------------------------
 21399	A3FA					; Parameters:
 21400	A3FA					;   HL: source address (compressed data)
 21401	A3FA					;   DE: destination address (decompressing)
 21402	A3FA					; -----------------------------------------------------------------------------
 21403	A3FA					
 21404	A3FA					dzx0_standard:
 21405	A3FA	01	FF	FF		        ld      bc, $ffff               ; preserve default offset 1
 21406	A3FD	C5				        push    bc
 21407	A3FE	03				        inc     bc
 21408	A3FF	3E	80			        ld      a, $80
 21409	A401					dzx0s_literals:
 21410	A401	CD	2F	A4		        call    dzx0s_elias             ; obtain length
 21411	A404	ED	B0			        ldir                            ; copy literals
 21412	A406	87				        add     a, a                    ; copy from last offset or new offset?
 21413	A407	38	0D			        jr      c, dzx0s_new_offset
 21414	A409	CD	2F	A4		        call    dzx0s_elias             ; obtain length
 21415	A40C					dzx0s_copy:
 21416	A40C	E3				        ex      (sp), hl                ; preserve source, restore offset
 21417	A40D	E5				        push    hl                      ; preserve offset
 21418	A40E	19				        add     hl, de                  ; calculate destination - offset
 21419	A40F	ED	B0			        ldir                            ; copy from offset
 21420	A411	E1				        pop     hl                      ; restore offset
 21421	A412	E3				        ex      (sp), hl                ; preserve offset, restore source
 21422	A413	87				        add     a, a                    ; copy from literals or new offset?
 21423	A414	30	EB			        jr      nc, dzx0s_literals
 21424	A416					dzx0s_new_offset:
 21425	A416	C1				        pop     bc                      ; discard last offset
 21426	A417	0E	FE			        ld      c, $fe                  ; prepare negative offset
 21427	A419	CD	30	A4		        call    dzx0s_elias_loop        ; obtain offset MSB
 21428	A41C	0C				        inc     c
 21429	A41D	C8				        ret     z                       ; check end marker
 21430	A41E	41				        ld      b, c
 21431	A41F	4E				        ld      c, (hl)                 ; obtain offset LSB
 21432	A420	23				        inc     hl
 21433	A421	CB	18			        rr      b                       ; last offset bit becomes first length bit
 21434	A423	CB	19			        rr      c
 21435	A425	C5				        push    bc                      ; preserve new offset
 21436	A426	01	01	00		        ld      bc, 1                   ; obtain length
 21437	A429	D4	37	A4		        call    nc, dzx0s_elias_backtrack
 21438	A42C	03				        inc     bc
 21439	A42D	18	DD			        jr      dzx0s_copy
 21440	A42F					dzx0s_elias:
 21441	A42F	0C				        inc     c                       ; interlaced Elias gamma coding
 21442	A430					dzx0s_elias_loop:
 21443	A430	87				        add     a, a
 21444	A431	20	03			        jr      nz, dzx0s_elias_skip
 21445	A433	7E				        ld      a, (hl)                 ; load another group of 8 bits
 21446	A434	23				        inc     hl
 21447	A435	17				        rla
 21448	A436					dzx0s_elias_skip:
 21449	A436	D8				        ret     c
 21450	A437					dzx0s_elias_backtrack:
 21451	A437	87				        add     a, a
 21452	A438	CB	11			        rl      c
 21453	A43A	CB	10			        rl      b
 21454	A43C	18	F2			        jr      dzx0s_elias_loop
 21455	A43E					; -----------------------------------------------------------------------------
 21456	A43E					
 21457	A43E					
 21458	A43E					
 21459	A43E					
 21460	A43E					
 21461	A43E					    end                 ; End of assembly
