 213	4098					; Returns 1 in a and clears z flag if vdp is 60Hz
 214	4098					CheckIf60Hz:
 215	4098	F3				    di
 216	4099	DB	99			    in      a, (#99)
 217	409B	00				    nop
 218	409C	00				    nop
 219	409D	00				    nop
