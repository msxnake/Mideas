 19596	96EB					; ------------------------------------------------------------------
 19597	96EB					; EFFECT 2: DISSOLVE_CHARS - Pixel-row interleaved dissolve (8 passes)
 19598	96EB					; Pass D clears pixel rows D, D+8, D+16, ..., D+184 (24 rows per pass)
 19599	96EB					; Uses color table manipulation for 1-pixel-row granularity (8x finer
 19600	96EB					; than tile-row approach).
 19601	96EB					; ------------------------------------------------------------------
 19602	96EB					.trans_dissolve_chars:
 19603	96EB	16	00			    ld d, 0                       ; D = pass counter (0-7)
 19604	96ED					.tdc_loop:
 19605	96ED	42				    ld b, d                       ; B = starting pixel row for this pass
 19606	96EE	1E	18			    ld e, 24                      ; E = 24 pixel rows per pass (192/8)
 19607	96F0					.tdc_inner:
 19608	96F0	78				    ld a, b
 19609	96F1	CD	87	97		    call trans_clear_pixel_row_colors   ; clear pixel row B (color table)
 19610	96F4					    ; trans_clear_pixel_row_colors preserves BC,DE,HL via push/pop
 19611	96F4	78				    ld a, b
 19612	96F5	C6	08			    add a, 8                      ; next pixel row in this pass (step +8)
 19613	96F7	47				    ld b, a
