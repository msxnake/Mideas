 11333	7074	D6	02			    sub 2               ; Height - 2 rows
 11334	7076	28	1E			    jr z, .bottom_row   ; Skip if height is small
 11335	7078	38	1C			    jr c, .bottom_row   ; Skip if height is < 2
 11336	707A	4F				    ld c, a             ; C = Middle Rows count
 11337	707B					    
 11338	707B					.middle_row_loop:
 11339	707B	E5				    push hl             ; Save Row Start
