 8625	5FE7					; Helper function to initialize character 0 (empty cell) with background color
 8626	5FE7					; Input: A = background color (0-15)
 8627	5FE7					; This ensures empty cells show the correct background color instead of BIOS default (blue)
 8628	5FE7					init_char0_color:
 8629	5FE7	F5				    push af
 8630	5FE8	C5				    push bc
 8631	5FE9	D5				    push de
 8632	5FEA	E5				    push hl
