 12155	7342	DD	E5			    push ix
 12156	7344	FD	E5			    push iy
 12157	7346	CD	B8	73		    call PT3_INIT
 12158	7349	FD	E1			    pop iy
 12159	734B	DD	E1			    pop ix
 12160	734D	3E	01			    ld a, 1
 12161	734F	32	4D	D1		    ld (music_active), a   ; Enable playback AFTER PT3 is fully initialised
 12162	7352	FB				    ei
