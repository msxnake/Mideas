 11131	6FCF					    ; row * 32
 11132	6FCF	6F				    ld l, a
 11133	6FD0	26	00			    ld h, 0
 11134	6FD2	29				    add hl, hl                  ; * 2
 11135	6FD3	29				    add hl, hl                  ; * 4
 11136	6FD4	29				    add hl, hl                  ; * 8
 11137	6FD5	29				    add hl, hl                  ; * 16
 11138	6FD6	29				    add hl, hl                  ; * 32
 11139	6FD7					
 11140	6FD7					    ; Add X/8
 11141	6FD7	7A				    ld a, d                     ; A = X
 11142	6FD8	CB	3F			    srl a
 11143	6FDA	CB	3F			    srl a
 11144	6FDC	CB	3F			    srl a                       ; A = X/8 (column)
 11145	6FDE	5F				    ld e, a
 11146	6FDF	16	00			    ld d, 0
 11147	6FE1	19				    add hl, de
 11148	6FE2					
 11149	6FE2					    ; Add Name Table base
 11150	6FE2	11	00	18		    ld de, #1800
