 19902	9812	5F				    ld e, a                       ; Save fill byte
 19903	9813	F3				    di                            ; Protect VDP address+data from ISR corruption
 19904	9814	7D				    ld a, l
 19905	9815	D3	99			    out (#99), a                  ; VRAM address low
 19906	9817	7C				    ld a, h
 19907	9818	F6	40			    or #40
 19908	981A	D3	99			    out (#99), a                  ; VRAM address high + write mode
 19909	981C					.tff_loop:
