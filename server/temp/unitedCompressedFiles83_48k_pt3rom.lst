 1808	424A					;   Register roles:
 1809	424A					;     - A = VDP status read and boolean conversion
 1810	424A					
 1811	424A					; Updates vblank_flag only if we're actually in VBlank
 1812	424A					; Called from interrupt_dispatcher
 1813	424A					; Inputs: None
 1814	424A					; Outputs: None
 1815	424A					; Modifies: AF
 1816	424A					; ==================================================================
 1817	424A					update_vblank_flag:
