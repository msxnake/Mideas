 13859	7FDD					    ; Frame 1: Droplets rising
 13860	7FDD	42	66	3C	18	18	3C	66	42	    db #42, #66, #3C, #18, #18, #3C, #66, #42
 13861	7FE5					    ; Frame 2: Arcing
