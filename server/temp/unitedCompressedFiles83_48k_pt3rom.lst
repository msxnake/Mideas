 18417	9232	5E				    ld e, (hl)
 18418	9233	23				    inc hl
 18419	9234	56				    ld d, (hl)      ; DE = data pointer
 18420	9235	23				    inc hl
 18421	9236	4E				    ld c, (hl)
 18422	9237	23				    inc hl
 18423	9238	46				    ld b, (hl)      ; BC = connection table pointer
