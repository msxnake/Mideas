 4775	4E02					    ; AUTO-DESTROY COMPONENT SYSTEM
 4776	4E02					    ; ==================================================================
 4777	4E02					    ; Entities with AUTO_DESTROY component have a lifetime counter
 4778	4E02					    ; When lifetime reaches 0, entity is automatically destroyed
 4779	4E02					    ; Useful for: projectiles, particles, temporary effects, etc.
 4780	4E02					
