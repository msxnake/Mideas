 2330	4387					
 2331	4387					; Core Components(always present)
 2332	4387					COMP_POSITION   EQU 0; Position component(x, y coordinates)
 2333	4387					COMP_SPRITE     EQU 1; Sprite rendering component
 2334	4387					COMP_MOVEMENT   EQU 2; Movement / velocity component
 2335	4387					COMP_COLLISION  EQU 3; Collision detection component
 2336	4387					COMP_INPUT      EQU 4; Input handling component
 2337	4387					COMP_BEHAVIOR   EQU 5; AI / Logic behavior component
 2338	4387					COMP_HEALTH     EQU 6; Health / damage component
 2339	4387					COMP_ANIMATION  EQU 7; Animation state component
 2340	4387					COMP_JUMP       EQU 8; Jump behavior component(platformer physics)
 2341	4387					COMP_GRAVITY    EQU 9; Gravity physics component
 2342	4387					
 2343	4387					    ; Component flags for entity filtering(16 - bit masks for 10 + components)
 2344	4387					COMP_MASK_POSITION   EQU #0001; Binary: 0000000000000001
 2345	4387					COMP_MASK_SPRITE     EQU #0002; Binary: 0000000000000010
 2346	4387					COMP_MASK_MOVEMENT   EQU #0004; Binary: 0000000000000100
 2347	4387					COMP_MASK_COLLISION  EQU #0008; Binary: 0000000000001000
 2348	4387					COMP_MASK_INPUT      EQU #0010; Binary: 0000000000010000
 2349	4387					COMP_MASK_BEHAVIOR   EQU #0020; Binary: 0000000000100000
 2350	4387					COMP_MASK_HEALTH     EQU #0040; Binary: 0000000001000000
 2351	4387					COMP_MASK_ANIMATION  EQU #0080; Binary: 0000000010000000
 2352	4387					COMP_MASK_JUMP       EQU #0100; Binary: 0000000100000000
 2353	4387					COMP_MASK_GRAVITY    EQU #0200; Binary: 0000001000000000
 2354	4387					COMP_MASK_AUTO_DESTROY EQU #0400; Binary: 0000010000000000
