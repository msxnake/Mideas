 8399	5CE6					; Hide specific sprite (A = hardware sprite index)
 8400	5CE6					hide_sprite:
 8401	5CE6	FE	20			    cp 32
 8402	5CE8	D0				    ret nc
 8403	5CE9	6F				    ld l, a
 8404	5CEA	26	00			    ld h, 0
 8405	5CEC	29				    add hl, hl
 8406	5CED	29				    add hl, hl
 8407	5CEE	11	42	CB		    ld de, sprite_attributes
 8408	5CF1	19				    add hl, de
 8409	5CF2	36	E0			    ld (hl), SPRITE_INVISIBLE
 8410	5CF4	3E	01			    ld a, 1
 8411	5CF6	32	E1	CA		    ld (sprites_dirty), a
 8412	5CF9	C9				    ret
 8413	5CFA					
 8414	5CFA					; Copy sprite attributes from RAM to VRAM
 8415	5CFA					update_sprites_to_vram:
 8416	5CFA	3A	E1	CA		    ld a, (sprites_dirty)
 8417	5CFD	B7				    or a
 8418	5CFE	C8				    ret z
 8419	5CFF	AF				    xor a
 8420	5D00	32	E1	CA		    ld (sprites_dirty), a
 8421	5D03	21	42	CB		    ld hl, sprite_attributes
 8422	5D06	11	00	1B		    ld de, SPRATR
 8423	5D09	01	20	00		    ld bc, 32  ; Upload active sprite range + SAT end marker
 8424	5D0C	CD	B3	40		    call FAST_LDIRVM
 8425	5D0F	C9				    ret
