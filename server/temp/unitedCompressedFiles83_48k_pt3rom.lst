 4677	4D9C	E6	02			            and #02; Check COMP_MASK_GRAVITY(#0200) => bit 1 in high byte
 4678	4D9E	28	5D			            jr z, gravity_next_entity; Skip if no gravity component
 4679	4DA0					
 4680	4DA0					    ; Skip entities that are not in the currently active screen
 4681	4DA0					    ; Preserve HL because it is the entity_comp_masks_hi loop pointer.
 4682	4DA0	E5				            push hl
 4683	4DA1	21	60	C7		            ld hl, entity_screen_id
 4684	4DA4	59				            ld e, c
 4685	4DA5	16	00			            ld d, 0
 4686	4DA7	19				            add hl, de
 4687	4DA8	7E				            ld a, (hl)
 4688	4DA9	21	C2	CB		            ld hl, current_screen_id
 4689	4DAC	BE				            cp (hl)
 4690	4DAD	E1				            pop hl
 4691	4DAE	C2	FD	4D		            jp nz, gravity_next_entity
 4692	4DB1					
 4693	4DB1					    ; Entity has gravity - apply acceleration
 4694	4DB1	C5				            push bc
 4695	4DB2	E5				            push hl
 4696	4DB3					
 4697	4DB3					    ; Check if entity is grounded
 4698	4DB3	21	78	CD		            ld hl, entity_on_ground
 4699	4DB6	59				            ld e, c
 4700	4DB7	16	00			            ld d, 0
 4701	4DB9	19				            add hl, de
 4702	4DBA	7E				            ld a, (hl)
 4703	4DBB	CB	47			            bit 0, a; Check ground flag
 4704	4DBD	20	2F			            jr nz, gravity_grounded; Skip gravity if on ground
 4705	4DBF					
