 13495	7DF8					; PARTICLE UPDATE FUNCTIONS
 13496	7DF8					; ==================================================================
 13497	7DF8					
 13498	7DF8					; ------------------------------------------------------------------
 13499	7DF8					; update_particles
 13500	7DF8					; Update all active particles (call every frame)
 13501	7DF8					; Decrements lifetime, advances animation, applies velocity
 13502	7DF8					; ------------------------------------------------------------------
 13503	7DF8					update_particles:
 13504	7DF8	21	40	C6		    ld hl, particle_pool
 13505	7DFB	06	08			    ld b, MAX_PARTICLES
 13506	7DFD					.part_update_loop:
 13507	7DFD	C5				    push bc
 13508	7DFE	E5				    push hl
 13509	7DFF					
 13510	7DFF					    ; Check if particle is active
 13511	7DFF	7E				    ld a, (hl)
 13512	7E00	FE	00			    cp PARTICLE_NONE
 13513	7E02	28	55			    jr z, .part_update_next     ; Skip inactive
 13514	7E04					
 13515	7E04					    ; Decrement lifetime
 13516	7E04	23				    inc hl                      ; Offset 1: lifetime
 13517	7E05	7E				    ld a, (hl)
 13518	7E06	3D				    dec a
 13519	7E07	77				    ld (hl), a
 13520	7E08	28	46			    jr z, .part_update_kill     ; Lifetime expired
 13521	7E0A					
 13522	7E0A					    ; Advance animation frame
 13523	7E0A	23				    inc hl
 13524	7E0B	23				    inc hl
 13525	7E0C	23				    inc hl                      ; Offset 4: frame
 13526	7E0D	7E				    ld a, (hl)
 13527	7E0E	3C				    inc a
 13528	7E0F	E6	03			    and #03                     ; Wrap at 4 frames
 13529	7E11	77				    ld (hl), a
 13530	7E12					
 13531	7E12					    ; Apply velocity (simple physics)
 13532	7E12	23				    inc hl
 13533	7E13	23				    inc hl                      ; Offset 6: velocity X
 13534	7E14	7E				    ld a, (hl)
 13535	7E15	B7				    or a
 13536	7E16	28	14			    jr z, .part_update_skip_vx
 13537	7E18					
 13538	7E18					    ; Update X position
 13539	7E18	2B				    dec hl
 13540	7E19	2B				    dec hl
 13541	7E1A	2B				    dec hl
 13542	7E1B	2B				    dec hl                      ; Offset 2: X position
 13543	7E1C	46				    ld b, (hl)
 13544	7E1D	23				    inc hl
 13545	7E1E	23				    inc hl
 13546	7E1F	23				    inc hl
 13547	7E20	23				    inc hl
 13548	7E21	7E				    ld a, (hl)
 13549	7E22	80				    add a, b
 13550	7E23	2B				    dec hl
 13551	7E24	2B				    dec hl
 13552	7E25	2B				    dec hl
 13553	7E26	2B				    dec hl
 13554	7E27	77				    ld (hl), a                  ; Store new X
 13555	7E28	23				    inc hl
 13556	7E29	23				    inc hl
 13557	7E2A	23				    inc hl
 13558	7E2B	23				    inc hl
 13559	7E2C					
 13560	7E2C					.part_update_skip_vx:
 13561	7E2C					    ; Apply velocity Y
 13562	7E2C	23				    inc hl                      ; Offset 7: velocity Y
 13563	7E2D	7E				    ld a, (hl)
 13564	7E2E	B7				    or a
 13565	7E2F	28	18			    jr z, .part_update_skip_vy
 13566	7E31					
 13567	7E31					    ; Update Y position
 13568	7E31	2B				    dec hl
 13569	7E32	2B				    dec hl
 13570	7E33	2B				    dec hl
 13571	7E34	2B				    dec hl
 13572	7E35	2B				    dec hl                      ; Offset 3: Y position
 13573	7E36	46				    ld b, (hl)
 13574	7E37	23				    inc hl
 13575	7E38	23				    inc hl
 13576	7E39	23				    inc hl
 13577	7E3A	23				    inc hl
 13578	7E3B	23				    inc hl
 13579	7E3C	7E				    ld a, (hl)
 13580	7E3D	80				    add a, b
 13581	7E3E	2B				    dec hl
 13582	7E3F	2B				    dec hl
 13583	7E40	2B				    dec hl
 13584	7E41	2B				    dec hl
 13585	7E42	2B				    dec hl
 13586	7E43	77				    ld (hl), a                  ; Store new Y
 13587	7E44	23				    inc hl
 13588	7E45	23				    inc hl
 13589	7E46	23				    inc hl
 13590	7E47	23				    inc hl
 13591	7E48	23				    inc hl
