 6830	5688					; ------------------------------------------------------------------
 6831	5688					; ensure_used_entity_list_current
 6832	5688					; Rebuild compact list only when marked dirty.
 6833	5688					; ------------------------------------------------------------------
 6834	5688					; Register Contract:
 6835	5688					;   Purpose: Conditionally rebuild compact active list only when dirty.
 6836	5688					;   Inputs:
 6837	5688					;     - active_entity_list_dirty flag
 6838	5688					;   Outputs:
 6839	5688					;     - active_entity_list rebuilt if needed
 6840	5688					;   Clobbers:
 6841	5688					;     - AF
 6842	5688					;   Preserved:
 6843	5688					;     - BC
 6844	5688					;     - DE
 6845	5688					;     - HL (except nested call clobbers when rebuild happens)
 6846	5688					;   Register roles:
 6847	5688					;     - A = dirty flag test and branch
 6848	5688					;   Notes:
 6849	5688					;     - If dirty, downstream rebuild_used_entity_list can clobber many registers.
 6850	5688					
 6851	5688					ensure_used_entity_list_current:
 6852	5688	3A	08	D1		    ld a, (active_entity_list_dirty)
 6853	568B	B7				    or a
 6854	568C	C8				    ret z
 6855	568D	CD	91	56		    call rebuild_used_entity_list
 6856	5690	C9				    ret
 6857	5691					
 6858	5691					; ------------------------------------------------------------------
 6859	5691					; rebuild_used_entity_list
 6860	5691					; Build compact list of ACTIVE entity slots that are in use
 6861	5691					; for the CURRENT SCREEN only:
 6862	5691					; (entity_active != 0 and mask_l|mask_h != 0 and entity_screen_id == current_screen_id)
 6863	5691					; Output:
 6864	5691					;   active_entity_list[]   = entity indices with components
 6865	5691					;   active_entity_count    = number of entries
 6866	5691					; ------------------------------------------------------------------
 6867	5691					; Register Contract:
 6868	5691					;   Purpose: Recompute compact list of entities active on current screen.
 6869	5691					;   Inputs:
 6870	5691					;     - entity_active, entity_comp_masks(_hi), entity_screen_id, current_screen_id
 6871	5691					;   Outputs:
 6872	5691					;     - active_entity_list[]
 6873	5691					;     - active_entity_count
 6874	5691					;     - active_entity_list_dirty=0
 6875	5691					;   Clobbers:
 6876	5691					;     - AF
 6877	5691					;     - BC
 6878	5691					;     - DE
 6879	5691					;     - HL
 6880	5691					;   Preserved:
 6881	5691					;     - None
 6882	5691					;   Register roles:
 6883	5691					;     - B = slots remaining (MAX_ENTITIES..1)
 6884	5691					;     - C = entity slot iterator (0..MAX_ENTITIES-1)
 6885	5691					;     - DE = index offset (entity id / active list position)
 6886	5691					;     - HL = pointer math over component and state arrays
 6887	5691					;     - A = predicate checks and counters
 6888	5691					
 6889	5691					rebuild_used_entity_list:
 6890	5691	AF				    xor a
 6891	5692	32	07	D1		    ld (active_entity_count), a
 6892	5695	06	20			    ld b, MAX_ENTITIES
 6893	5697	0E	00			    ld c, 0
