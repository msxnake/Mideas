 7357	5852					
 7358	5852					; ------------------------------------------------------------------
 7359	5852					; check_collision_at_point
 7360	5852					; Check if there's a solid tile at given pixel coordinates
 7361	5852					; Input:  D = X position, E = Y position
 7362	5852					; Output: Z flag set if passable, cleared if solid
 7363	5852					;         A = Behavior flags of tile at that position
 7364	5852					; Destroys: BC, HL
 7365	5852					; ------------------------------------------------------------------
 7366	5852					check_collision_at_point:
 7367	5852	CD	05	57		    call get_tile_at_position
 7368	5855	C8				    ret z                         ; Out of bounds = passable
 7369	5856	CD	43	57		    call get_tile_behavior
 7370	5859	E6	03			    and TILE_SOLID | TILE_PLATFORM
 7371	585B	C9				    ret                           ; Z if passable, NZ if solid
 7372	585C					
 7373	585C					; ------------------------------------------------------------------
 7374	585C					; check_collision_box
 7375	585C					; Check collision for entity bounding box (16x16)
 7376	585C					; Input:  D = X position (top-left), E = Y position (top-left)
 7377	585C					; Output: Z flag set if no collision, cleared if collision detected
 7378	585C					;         A = Behavior flags of colliding tile
 7379	585C					; Destroys: BC, HL
 7380	585C					; ------------------------------------------------------------------
 7381	585C					check_collision_box:
 7382	585C					    ; Check 4 corners of 16x16 box:
 7383	585C					    ; Top-left (X, Y)
 7384	585C	D5				    push de
 7385	585D	CD	52	58		    call check_collision_at_point
 7386	5860	20	28			    jr nz, .collision_found
 7387	5862					
 7388	5862					    ; Top-right (X+15, Y)
 7389	5862	D1				    pop de
 7390	5863	D5				    push de
 7391	5864	7A				    ld a, d
 7392	5865	C6	0F			    add a, 15
 7393	5867	57				    ld d, a
 7394	5868	CD	52	58		    call check_collision_at_point
 7395	586B	20	1D			    jr nz, .collision_found
 7396	586D					
 7397	586D					    ; Bottom-left (X, Y+15)
 7398	586D	D1				    pop de
 7399	586E	D5				    push de
 7400	586F	7B				    ld a, e
 7401	5870	C6	0F			    add a, 15
 7402	5872	5F				    ld e, a
 7403	5873	CD	52	58		    call check_collision_at_point
 7404	5876	20	12			    jr nz, .collision_found
 7405	5878					
 7406	5878					    ; Bottom-right (X+15, Y+15)
 7407	5878	D1				    pop de
 7408	5879	D5				    push de
 7409	587A	7A				    ld a, d
 7410	587B	C6	0F			    add a, 15
 7411	587D	57				    ld d, a
 7412	587E	7B				    ld a, e
 7413	587F	C6	0F			    add a, 15
 7414	5881	5F				    ld e, a
 7415	5882	CD	52	58		    call check_collision_at_point
 7416	5885	20	03			    jr nz, .collision_found
 7417	5887					
 7418	5887					    ; No collision
 7419	5887	D1				    pop de
 7420	5888	AF				    xor a                         ; Z flag set
 7421	5889	C9				    ret
 7422	588A					
 7423	588A					.collision_found:
 7424	588A	D1				    pop de
 7425	588B	B7				    or a                          ; Clear Z flag
 7426	588C	C9				    ret
 7427	588D					
 7428	588D					; ------------------------------------------------------------------
 7429	588D					; div_a_by_c
 7430	588D					; Divide A by C (unsigned 8-bit division)
 7431	588D					; Input:  A = dividend, C = divisor
 7432	588D					; Output: A = quotient
 7433	588D					; Destroys: B
 7434	588D					; ------------------------------------------------------------------
 7435	588D					div_a_by_c:
 7436	588D	06	00			    ld b, 0                       ; B = quotient
 7437	588F					.tile_div_loop:
 7438	588F	91				    sub c
 7439	5890	38	03			    jr c, .tile_div_done
 7440	5892	04				    inc b
 7441	5893	18	FA			    jr .tile_div_loop
 7442	5895					.tile_div_done:
 7443	5895	78				    ld a, b
 7444	5896	C9				    ret
