 1960	4285					; TASK_UPDATE_INPUT - Joystick/Cursor polling at 60Hz
 1961	4285					; ==================================================================
 1962	4285					; This task guarantees responsive input (no missed button presses)
 1963	4285					; Compatible with update_input_component existing function
 1964	4285					; ==================================================================
 1965	4285					; Register Contract:
 1966	4285					;   Purpose: Poll joystick + keyboard fallback and update input state buffers.
 1967	4285					;   Inputs:
 1968	4285					;     - Reads hardware via FAST_GTSTCK / FAST_GTTRIG / FAST_SNSMAT
 1969	4285					;   Outputs:
 1970	4285					;     - input_state, prev_input_state, input_btn_curr, input_btn_prev, input_fire
 1971	4285					;   Clobbers:
 1972	4285					;     - AF
 1973	4285					;     - BC
 1974	4285					;     - DE
 1975	4285					;   Preserved:
 1976	4285					;     - AF
 1977	4285					;     - BC
 1978	4285					;     - DE (by push/pop wrapper)
 1979	4285					;     - HL
