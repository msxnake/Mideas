 6498	5553	19				    add hl, de                     ; HL = &collected_world[index]
 6499	5554	3A	C5	CB		    ld a, (current_world_id)       ; A = world currently loaded
 6500	5557	BE				    cp (hl)                        ; Compare with stored world ID
 6501	5558	20	2A			    jr nz, .apply_ct_skip          ; Different world - skip
 6502	555A					
 6503	555A					    ; Check if this entry belongs to current screen
 6504	555A	21	11	CC		    ld hl, collected_screen
 6505	555D	19				    add hl, de                     ; HL = &collected_screen[index]
 6506	555E	3A	C2	CB		    ld a, (current_screen_id)      ; A = screen currently loaded
 6507	5561	BE				    cp (hl)                        ; Compare with stored screen ID
 6508	5562	20	20			    jr nz, .apply_ct_skip          ; Different screen - skip
 6509	5564					
 6510	5564					    ; Entry matches current screen: re-clear this tile
 6511	5564	C5				    push bc                        ; Save B=count, C=index across FAST_WRTVRM
 6512	5565					
 6513	5565					    ; Build tile index: D = idx_h, E = idx_l
