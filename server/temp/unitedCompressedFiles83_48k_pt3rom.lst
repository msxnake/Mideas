 3696	48F8					    ; ------------------------------------------------------------------
 3697	48F8					    ; get_behavior_tile
 3698	48F8					    ; ------------------------------------------------------------------
 3699	48F8					; Register Contract:
 3700	48F8					;   Purpose: Read behavior byte for tile at (B=row, C=column) from the runtime behavior map.
 3701	48F8					;   Inputs:
 3702	48F8					;     - B = tile row    (0..23, out-of-range ??? A=0, passable)
 3703	48F8					;     - C = tile column (0..31, out-of-range ??? A=0, passable)
 3704	48F8					;     - current_behavior_map = 16-bit pointer to active screen behavior map
 3705	48F8					;     - current_behavior_map_bank = memory bank number (mapper context)
 3706	48F8					;   Outputs:
 3707	48F8					;     - A = behavior byte:
 3708	48F8					;     -   bits 7-4 (A & #F0): family / solidity class (0x00 = NoSolid, 0x10+ = Solid)
 3709	48F8					;     -   bits 3-0 (A & #0F): flag bits (e.g. 0x08 = Interactable)
 3710	48F8					;   Clobbers:
 3711	48F8					;     - AF
 3712	48F8					;   Preserved:
 3713	48F8					;     - BC
 3714	48F8					;     - DE
 3715	48F8					;     - HL
 3716	48F8					;   Notes:
 3717	48F8					;     - Maintains a single-row cache (behavior_cache_row / behavior_cache_row_base)
 3718	48F8					;     - so consecutive calls for the same row skip the row*32 multiply.
 3719	48F8					;     - Mapper push/pop protects P2 bank around the map read (no-op in simple32k mode).
 3720	48F8					;     - MUST be called with DE = entity index already set (DE is preserved, not used).
 3721	48F8					
 3722	48F8					get_behavior_tile:
 3723	48F8					    ; Bounds check: row must be 0-23, column must be 0-31
 3724	48F8					    ; NOTE: jp nc (not jr nc) to gbt_oob ??? gbt_oob is a global label defined after
 3725	48F8					    ; get_behavior_tile_nb. Using jr would create a local-label scoping conflict in
 3726	48F8					    ; glass.jar (get_behavior_tile_nb: starts a new scope, so .bt_out_of_bounds would
 3727	48F8					    ; belong to that scope, not get_behavior_tile's scope).
 3728	48F8	78				    ld a, b
 3729	48F9	FE	18			    cp 24
 3730	48FB	D2	46	49		    jp nc, gbt_oob                ; Row >= 24: treat as passable
 3731	48FE	79				    ld a, c
 3732	48FF	FE	20			    cp 32
 3733	4901	D2	46	49		    jp nc, gbt_oob                ; Column >= 32: treat as passable
 3734	4904					get_behavior_tile_nb:
 3735	4904					    ; Entry point for callers that guarantee B ??? 0..23 and C ??? 0..31.
 3736	4904					    ; Saves 36 cycles (4+7+7+4+7+7) by skipping bounds validation.
 3737	4904					    ; DO NOT call this unless the probe coordinates are provably in-bounds.
 3738	4904	E5				    push hl
 3739	4905	D5				    push de
 3740	4906					
 3741	4906					    ; Load cached behavior map pointer (fallback to current_behavior_map)
 3742	4906	21	25	C0		    ld hl, behavior_cache_map_l
 3743	4909	5E				    ld e, (hl)
 3744	490A	23				    inc hl
 3745	490B	56				    ld d, (hl)
 3746	490C	7A				    ld a, d
 3747	490D	B3				    or e
 3748	490E	20	11			    jr nz, .map_ptr_ready
 3749	4910					
 3750	4910	ED	5B	21	C0	    ld de, (current_behavior_map)
 3751	4914	7B				    ld a, e
 3752	4915	32	25	C0		    ld (behavior_cache_map_l), a
 3753	4918	7A				    ld a, d
 3754	4919	32	26	C0		    ld (behavior_cache_map_h), a
 3755	491C	3E	FF			    ld a, #FF
 3756	491E	32	24	C0		    ld (behavior_cache_row), a
 3757	4921					
 3758	4921					.map_ptr_ready:
 3759	4921					    ; Reuse previous row base when checking multiple points on same row
 3760	4921	78				    ld a, b
 3761	4922	21	24	C0		    ld hl, behavior_cache_row
 3762	4925	BE				    cp (hl)
 3763	4926	28	13			    jr z, .use_cached_row_base
 3764	4928					
 3765	4928					    ; Cache miss: row base = behavior_map + row*32
 3766	4928	78				    ld a, b
 3767	4929	6F				    ld l, a
 3768	492A	26	00			    ld h, 0
 3769	492C	29				    add hl, hl                    ; HL = row * 2
 3770	492D	29				    add hl, hl                    ; HL = row * 4
 3771	492E	29				    add hl, hl                    ; HL = row * 8
 3772	492F	29				    add hl, hl                    ; HL = row * 16
 3773	4930	29				    add hl, hl                    ; HL = row * 32
 3774	4931	19				    add hl, de                    ; HL = row base address
 3775	4932					
 3776	4932	78				    ld a, b
 3777	4933	32	24	C0		    ld (behavior_cache_row), a
 3778	4936	22	27	C0		    ld (behavior_cache_row_base), hl
 3779	4939	18	03			    jr .row_base_ready
 3780	493B					
 3781	493B					.use_cached_row_base:
 3782	493B	2A	27	C0		    ld hl, (behavior_cache_row_base)
 3783	493E					
 3784	493E					.row_base_ready:
 3785	493E	59				    ld e, c
 3786	493F	16	00			    ld d, 0
 3787	4941	19				    add hl, de                    ; HL = row base + column
 3788	4942					
 3789	4942					    ; simple32k: behavior map is always resident in RAM (no bank switching needed).
 3790	4942					    ; Skip mapper push/pop/set ??? saves ~169 cycles per call (41% overhead eliminated).
 3791	4942	7E				    ld a, (hl)                    ; A = behavior value (direct RAM read)
 3792	4943	D1				    pop de
 3793	4944	E1				    pop hl
 3794	4945	C9				    ret
 3795	4946					gbt_oob:
 3796	4946	AF				    xor a                         ; A = 0 (passable)
 3797	4947	C9				    ret
