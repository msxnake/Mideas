 11309	7059	D6	02			    sub 2               ; Width - 2 corners
 11310	705B	28	0B			    jr z, .skip_top_edge ; Skip if exactly 2 wide (no edge)
 11311	705D	38	09			    jr c, .skip_top_edge ; Skip if < 2 wide
 11312	705F	47				    ld b, a
 11313	7060					.top_edge_loop:
 11314	7060	3E	2D			    ld a, 45            ; '-'
 11315	7062	CD	CE	40		    call FAST_WRTVRM
 11316	7065	23				    inc hl
 11317	7066	10	F8			    djnz .top_edge_loop
 11318	7068					.skip_top_edge:
 11319	7068					    
 11320	7068					    ; Top-Right Corner
 11321	7068	3E	2B			    ld a, 43            ; '+'
 11322	706A	CD	CE	40		    call FAST_WRTVRM
 11323	706D					    
 11324	706D	C1				    pop bc              ; Restore Dimensions
 11325	706E	E1				    pop hl              ; Restore Start Address
