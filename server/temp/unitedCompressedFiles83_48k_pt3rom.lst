 11270	703C					; ------------------------------------------------------------------
 11271	703C					; hud_draw_frame
 11272	703C					; Draw a rectangular frame using font characters
 11273	703C					; Input: D = Tile X, E = Tile Y, B = Width (tiles), C = Height (tiles)
 11274	703C					; Uses characters: 43 (+), 45 (-), 124 (|)
 11275	703C					; ------------------------------------------------------------------
 11276	703C					hud_draw_frame:
 11277	703C	F5				    push af
 11278	703D	C5				    push bc
 11279	703E	D5				    push de
 11280	703F	E5				    push hl
 11281	7040					    
 11282	7040					    ; Calculate VRAM Start Address
 11283	7040					    ; Addr = #1800 + (E * 32) + D
 11284	7040	6B				    ld l, e
 11285	7041	26	00			    ld h, 0
 11286	7043	29				    add hl, hl          ; * 2
 11287	7044	29				    add hl, hl          ; * 4
 11288	7045	29				    add hl, hl          ; * 8
 11289	7046	29				    add hl, hl          ; * 16
 11290	7047	29				    add hl, hl          ; * 32
 11291	7048					    
 11292	7048	5A				    ld e, d
 11293	7049	16	00			    ld d, 0
 11294	704B	19				    add hl, de
 11295	704C	11	00	18		    ld de, #1800
 11296	704F	19				    add hl, de          ; HL = Top-Left Corner VRAM Address
 11297	7050					    
 11298	7050					    ; Draw Top Row
 11299	7050	E5				    push hl             ; Save Start Address
 11300	7051	C5				    push bc             ; Save Dimensions
 11301	7052					    
 11302	7052					    ; Top-Left Corner
 11303	7052	3E	2B			    ld a, 43            ; '+'
 11304	7054	CD	CE	40		    call FAST_WRTVRM
 11305	7057	23				    inc hl
 11306	7058					    
 11307	7058					    ; Top Edge
