 2410	4387					entity_collision_offset_x EQU temp_byte_21 ; Entity collision hitbox X offset (32 bytes)
 2411	4387					entity_collision_offset_y EQU temp_byte_22 ; Entity collision hitbox Y offset (32 bytes)
 2412	4387					entity_entity_collision_flags EQU temp_byte_23 ; bit0 entity(any), bit1 enemy, bit2 item (32 bytes)
 2413	4387					entity_last_collision_entity EQU temp_byte_24 ; Last collided entity index (255=none) (32 bytes)
 2414	4387					
 2415	4387					    ; Input Disable Flag
