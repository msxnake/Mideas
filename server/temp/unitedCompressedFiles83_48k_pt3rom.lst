 8634	5FEB					    ; Calculate color byte: (bg_color << 4) | bg_color
 8635	5FEB					    ; This makes both foreground and background the same color
 8636	5FEB	E6	0F			    and #0F                    ; Ensure 0-15 range
 8637	5FED	47				    ld b, a                    ; Save in B
