 5060	4EE9					    ; ==================================================================
 5061	4EE9					    ; WALL COLLISION COMPONENT SYSTEM
 5062	4EE9					    ; ==================================================================
 5063	4EE9					    ; Prevents entities from moving through walls
 5064	4EE9					    ; Uses per-entity hitbox (offset + width/height)
 5065	4EE9					    ; Snaps entity position to wall edge AND zeros velocity
 5066	4EE9					
 5067	4EE9					init_wallcollision_system:
 5068	4EE9	C9				    ret
 5069	4EEA					
 5070	4EEA					; ------------------------------------------------------------------
 5071	4EEA					; update_wallcollision_component
 5072	4EEA					; ------------------------------------------------------------------
 5073	4EEA					; Check wall collisions and prevent movement through solid tiles.
 5074	4EEA					; Uses behavior map (current_behavior_map) for collision detection.
 5075	4EEA					; Entity position is cached in wall_temp_x/y and converted to hitbox bounds.
 5076	4EEA					; ------------------------------------------------------------------
 5077	4EEA					; Register Contract:
 5078	4EEA					;   Purpose: Iterate all entity slots; for each active entity with
 5079	4EEA					;            WallCollision eligibility, probe solid tiles in movement
 5080	4EEA					;            direction(s) and snap position + zero velocity on hit.
 5081	4EEA					;   Inputs:
 5082	4EEA					;     - entity_active[]         : 1 = entity exists
 5083	4EEA					;     - entity_comp_masks[]     : low byte component bitmask
 5084	4EEA					;     - entity_comp_masks_hi[]  : high byte (COMP_MASK_GRAVITY at bit 1)
 5085	4EEA					;     - entity_collides_with[]  : must include COLLISION_LAYER_PLATFORM (#08)
 5086	4EEA					;     - entity_screen_id[]      : entity must be on current_screen_id
 5087	4EEA					;     - entity_x_pos/y_pos[]    : world position
 5088	4EEA					;     - entity_vel_x/vel_y[]    : signed 8-bit velocity (negative = left/up)
 5089	4EEA					;     - entity_gravity_vel[]    : 16-bit signed gravity accumulator (word)
 5090	4EEA					;     - entity_collision_offset_x/y[]: signed offset from origin to hitbox corner
 5091	4EEA					;     - entity_collision_hitbox_w/h[]: hitbox size (minimum 1 if zero)
 5092	4EEA					;     - current_behavior_map    : pointer to active screen behavior map
 5093	4EEA					;     - current_screen_id       : ID of the visible screen
 5094	4EEA					;   Outputs:
 5095	4EEA					;     - entity_x_pos/y_pos[]    : snapped on collision
 5096	4EEA					;     - entity_vel_x/vel_y[]    : zeroed on collision axis
 5097	4EEA					;     - entity_gravity_vel[]    : zeroed on vertical collision
 5098	4EEA					;     - entity_on_ground[]      : bit 0 set=floor, cleared at loop start
 5099	4EEA					;     - entity_wall_collision_flags[]: bits 0=UP,1=DOWN,2=LEFT,3=RIGHT
 5100	4EEA					;   Clobbers: AF, BC, DE, HL
 5101	4EEA					;   Preserved: (none ??? uses scratch RAM wall_temp_x/y, wall_hit_*, wall_probe_*)
 5102	4EEA					;   Notes:
 5103	4EEA					;     - Opt-B: loop uses active_entity_list (entities guaranteed active + on screen).
 5104	4EEA					;       Eliminates ~29 wasted iterations vs 0..MAX_ENTITIES scan (3 entities active).
 5105	4EEA					;     - Opt-C: wall_build_hitbox_cache is skipped on DOWN snap when new Y == current Y
