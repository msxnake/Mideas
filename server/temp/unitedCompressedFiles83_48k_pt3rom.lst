 913	4145					; Joystick Directions
 914	4145					STICK_UP    EQU 1
 915	4145					STICK_UPRIGHT EQU 2
 916	4145					STICK_RIGHT EQU 3
 917	4145					STICK_DOWNRIGHT EQU 4
 918	4145					STICK_DOWN  EQU 5
 919	4145					STICK_DOWNLEFT EQU 6
 920	4145					STICK_LEFT  EQU 7
 921	4145					STICK_UPLEFT EQU 8
 922	4145					STICK_CENTER EQU 0
 923	4145					
 924	4145					; Trigger Constants
 925	4145					TRIG_A      EQU #10      ; Trigger A (Fire)
 926	4145					TRIG_B      EQU #20      ; Trigger B (MSX2+)
 927	4145					
 928	4145					; Input Button Bitmask
 929	4145					INPUT_BTN_FIRE EQU #01   ; Fire/Space button bit in input_btn_curr/input_btn_prev
 930	4145					
 931	4145					; Direction flags shared by input/state machine helpers
 932	4145					DIR_ALLOW_UP     EQU #01 ; Bit 0: Allow UP movement
 933	4145					DIR_ALLOW_DOWN   EQU #02 ; Bit 1: Allow DOWN movement
 934	4145					DIR_ALLOW_LEFT   EQU #04 ; Bit 2: Allow LEFT movement
 935	4145					DIR_ALLOW_RIGHT  EQU #08 ; Bit 3: Allow RIGHT movement
 936	4145					
 937	4145					; ==================================================================
 938	4145					; TILE BEHAVIOR CONSTANTS (for collision detection)
 939	4145					; ==================================================================
 940	4145					
 941	4145					; Tile Behavior Types (bitmask)
 942	4145					TILE_PASSABLE       EQU #00    ; No collision (air, background)
 943	4145					TILE_SOLID          EQU #01    ; Solid wall/floor (blocks all movement)
 944	4145					TILE_PLATFORM       EQU #02    ; One-way platform (solid from above only)
 945	4145					TILE_LADDER         EQU #04    ; Climbable (allows vertical movement)
 946	4145					TILE_DEADLY         EQU #08    ; Damages/kills on contact (spikes, lava)
 947	4145					TILE_WATER          EQU #10    ; Water (slows movement, swim logic)
 948	4145					TILE_ICE            EQU #20    ; Slippery surface (reduced friction)
 949	4145					TILE_BREAKABLE      EQU #40    ; Can be destroyed by player
 950	4145					TILE_TRIGGER        EQU #80    ; Activates events on contact
 951	4145					
 952	4145					; Collision Directions (for platform logic)
 953	4145					COLL_FROM_ABOVE     EQU #01    ; Entity approaching from above
 954	4145					COLL_FROM_BELOW     EQU #02    ; Entity approaching from below
 955	4145					COLL_FROM_LEFT      EQU #04    ; Entity approaching from left
 956	4145					COLL_FROM_RIGHT     EQU #08    ; Entity approaching from right
 957	4145					
 958	4145					; Entity Collision Layer Presets (entity_collision_layer / entity_collides_with)
 959	4145					COLLISION_LAYER_PLAYER      EQU #01
 960	4145					COLLISION_LAYER_ENEMY       EQU #02
 961	4145					COLLISION_LAYER_PROJECTILE  EQU #04
 962	4145					COLLISION_LAYER_PLATFORM    EQU #08
 963	4145					COLLISION_LAYER_ITEM        EQU #10
 964	4145					
 965	4145					; Entity-Entity Collision Event Flags (entity_entity_collision_flags)
 966	4145					COLLISION_EVENT_ENTITY      EQU #01
 967	4145					COLLISION_EVENT_ENEMY       EQU #02
 968	4145					COLLISION_EVENT_ITEM        EQU #04
