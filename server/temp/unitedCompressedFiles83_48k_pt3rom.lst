 11162	6FEF					    ; Move to next element
 11163	6FEF	01	09	00		    ld bc, 9                    ; Size of each element entry
 11164	6FF2	DD	09			    add ix, bc                  ; IX points to next element
 11165	6FF4					
 11166	6FF4	C1				    pop bc                      ; Restore counter
 11167	6FF5	10	96			    djnz .render_loop
