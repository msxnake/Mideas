 12097	72FE					; ------------------------------------------------------------------
 12098	72FE					; music_execute_command
 12099	72FE					; Dispatch a music command from Game Flow nodes.
 12100	72FE					; Input:  DE -> [command, trackIndex, loopFlag]
 12101	72FE					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 12102	72FE					; Destroys: AF, BC (play path), DE (play path), HL
 12103	72FE					; ------------------------------------------------------------------
 12104	72FE					music_execute_command:
 12105	72FE	1A				    ld a, (de)
 12106	72FF	FE	FF			    cp #FF
 12107	7301	C8				    ret z
 12108	7302	B7				    or a
 12109	7303	CA	D9	72		    jp z, music_stop
 12110	7306	FE	01			    cp 1
 12111	7308	CA	16	73		    jp z, .pt3_exec_play
 12112	730B	FE	02			    cp 2
 12113	730D	CA	E6	72		    jp z, music_mute
 12114	7310	FE	03			    cp 3
 12115	7312	CA	F4	72		    jp z, music_resume
 12116	7315	C9				    ret
