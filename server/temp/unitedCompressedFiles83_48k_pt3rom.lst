 20315	9A57	F5				    push af
 20316	9A58	C5				    push bc
 20317	9A59					
 20318	9A59					    ; Silence channel A
 20319	9A59	3E	08			    ld a, #08    ; Volume register channel A
 20320	9A5B	D3	A0			    out (#A0), a
 20321	9A5D	3E	00			    ld a, 0      ; Volume = 0
 20322	9A5F	D3	A1			    out (#A1), a
