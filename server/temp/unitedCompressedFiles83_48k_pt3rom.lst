 1427	4145					; ==================================================================
 1428	4145					; MAPPER RUNTIME API
 1429	4145					; File: mapper.asm
 1430	4145					; Description: Minimal compatibility stubs for simple32k builds
 1431	4145					; Target mapper: konami
 1432	4145					; ROM mode: simple32k (autoMegaROM=false)
 1433	4145					; ==================================================================
 1434	4145					;
 1435	4145					; This build runs in simple32k mode, so bank switching is not active.
 1436	4145					; Keep mapper API labels as no-op stubs so generated gameplay code can
 1437	4145					; call the same routines without conditional assembly branches.
 1438	4145					
 1439	4145					; ------------------------------------------------------------------
 1440	4145					; mapper_runtime_init
 1441	4145					; Initializes runtime mirrors only (no hardware mapper writes).
 1442	4145					; ------------------------------------------------------------------
 1443	4145					mapper_runtime_init:
 1444	4145	AF				    xor a
 1445	4146	32	14	C0		    ld (mapper_bank_p1_current), a
 1446	4149	3E	01			    ld a, 1
 1447	414B	32	15	C0		    ld (mapper_bank_p2_current), a
 1448	414E	3E	02			    ld a, 2
 1449	4150	32	16	C0		    ld (mapper_bank_p3_current), a
 1450	4153	3E	03			    ld a, 3
 1451	4155	32	17	C0		    ld (mapper_bank_p4_current), a
 1452	4158	C9				    ret
 1453	4159					
 1454	4159					; ------------------------------------------------------------------
 1455	4159					; API: mapper_set_bank_pX
 1456	4159					; Input: A = bank number (stored only for compatibility)
 1457	4159					; ------------------------------------------------------------------
 1458	4159					mapper_set_bank_p1:
 1459	4159	32	14	C0		    ld (mapper_bank_p1_current), a
 1460	415C	C9				    ret
 1461	415D					
 1462	415D					mapper_set_bank_p2:
 1463	415D	32	15	C0		    ld (mapper_bank_p2_current), a
 1464	4160	C9				    ret
 1465	4161					
 1466	4161					mapper_set_bank_p3:
 1467	4161	32	16	C0		    ld (mapper_bank_p3_current), a
 1468	4164	C9				    ret
 1469	4165					
 1470	4165					mapper_set_bank_p4:
 1471	4165	32	17	C0		    ld (mapper_bank_p4_current), a
 1472	4168	C9				    ret
 1473	4169					
 1474	4169					; ------------------------------------------------------------------
 1475	4169					; Save/restore helpers (compatibility only).
 1476	4169					; ------------------------------------------------------------------
 1477	4169					mapper_push_p1:
 1478	4169	3A	14	C0		    ld a, (mapper_bank_p1_current)
 1479	416C	32	19	C0		    ld (mapper_saved_bank_p1), a
 1480	416F	C9				    ret
 1481	4170					
 1482	4170					mapper_pop_p1:
 1483	4170	3A	19	C0		    ld a, (mapper_saved_bank_p1)
 1484	4173	C3	59	41		    jp mapper_set_bank_p1
 1485	4176					
 1486	4176					mapper_push_p2:
 1487	4176	3A	15	C0		    ld a, (mapper_bank_p2_current)
 1488	4179	32	18	C0		    ld (mapper_saved_bank), a
 1489	417C	C9				    ret
 1490	417D					
 1491	417D					mapper_pop_p2:
 1492	417D	3A	18	C0		    ld a, (mapper_saved_bank)
 1493	4180	C3	5D	41		    jp mapper_set_bank_p2
 1494	4183					
 1495	4183					mapper_push_p3:
 1496	4183	3A	16	C0		    ld a, (mapper_bank_p3_current)
 1497	4186	32	1A	C0		    ld (mapper_saved_bank_p3), a
 1498	4189	C9				    ret
 1499	418A					
 1500	418A					mapper_pop_p3:
 1501	418A	3A	1A	C0		    ld a, (mapper_saved_bank_p3)
 1502	418D	C3	61	41		    jp mapper_set_bank_p3
 1503	4190					
 1504	4190					mapper_push_p4:
 1505	4190	3A	17	C0		    ld a, (mapper_bank_p4_current)
 1506	4193	32	1B	C0		    ld (mapper_saved_bank_p4), a
 1507	4196	C9				    ret
 1508	4197					
 1509	4197					mapper_pop_p4:
 1510	4197	3A	1B	C0		    ld a, (mapper_saved_bank_p4)
 1511	419A	C3	65	41		    jp mapper_set_bank_p4
 1512	419D					
