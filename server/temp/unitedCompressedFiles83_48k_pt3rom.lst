 19894	9812					; trans_fast_filvrm
 19895	9812					; Fill VRAM with a constant byte using direct port access
 19896	9812					; Input:  HL = VRAM destination address
 19897	9812					;         BC = byte count
 19898	9812					;         A  = fill value
 19899	9812					; Destroys: A, BC, E
