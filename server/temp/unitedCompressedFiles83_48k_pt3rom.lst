 13772	7ED5					; ==================================================================
 13773	7ED5					; PARTICLE PATTERN DATA
 13774	7ED5					; ==================================================================
 13775	7ED5					; Each particle type has 4 frames, 8 bytes each = 32 bytes total
 13776	7ED5					; Frame progression creates animation effect
 13777	7ED5					
 13778	7ED5					particle_patterns:
 13779	7ED5					
 13780	7ED5					; ---- PARTICLE_NONE (type 0) - Empty ----
 13781	7ED5	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13782	7EDD	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13783	7EE5	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13784	7EED	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13785	7EF5					
 13786	7EF5					; ---- PARTICLE_EXPLOSION (type 1) - Expands outward ----
 13787	7EF5					    ; Frame 0: Small dot
 13788	7EF5	00	00	00	18	18	00	00	00	    db #00, #00, #00, #18, #18, #00, #00, #00
 13789	7EFD					    ; Frame 1: Expanding
 13790	7EFD	00	18	3C	7E	7E	3C	18	00	    db #00, #18, #3C, #7E, #7E, #3C, #18, #00
 13791	7F05					    ; Frame 2: Large explosion
 13792	7F05	18	7E	FF	FF	FF	FF	7E	18	    db #18, #7E, #FF, #FF, #FF, #FF, #7E, #18
 13793	7F0D					    ; Frame 3: Fading fragments
 13794	7F0D	81	42	24	18	18	24	42	81	    db #81, #42, #24, #18, #18, #24, #42, #81
 13795	7F15					
 13796	7F15					; ---- PARTICLE_SMOKE (type 2) - Puff rising ----
 13797	7F15					    ; Frame 0: Small puff
 13798	7F15	00	00	3C	66	66	3C	00	00	    db #00, #00, #3C, #66, #66, #3C, #00, #00
 13799	7F1D					    ; Frame 1: Expanding
 13800	7F1D	00	7E	FF	C3	C3	FF	7E	00	    db #00, #7E, #FF, #C3, #C3, #FF, #7E, #00
 13801	7F25					    ; Frame 2: Large cloud
 13802	7F25	7E	FF	E7	C3	C3	E7	FF	7E	    db #7E, #FF, #E7, #C3, #C3, #E7, #FF, #7E
 13803	7F2D					    ; Frame 3: Dispersing
 13804	7F2D	66	E7	C3	81	81	C3	E7	66	    db #66, #E7, #C3, #81, #81, #C3, #E7, #66
 13805	7F35					
 13806	7F35					; ---- PARTICLE_SPARK (type 3) - Quick flash ----
 13807	7F35					    ; Frame 0: Bright cross
 13808	7F35	10	38	7C	FE	FE	7C	38	10	    db #10, #38, #7C, #FE, #FE, #7C, #38, #10
 13809	7F3D					    ; Frame 1: Fading
 13810	7F3D	00	10	38	7C	7C	38	10	00	    db #00, #10, #38, #7C, #7C, #38, #10, #00
 13811	7F45					    ; Frame 2: Dimmer
 13812	7F45	00	00	10	38	38	10	00	00	    db #00, #00, #10, #38, #38, #10, #00, #00
 13813	7F4D					    ; Frame 3: Gone
 13814	7F4D	00	00	00	18	18	00	00	00	    db #00, #00, #00, #18, #18, #00, #00, #00
 13815	7F55					
 13816	7F55					; ---- PARTICLE_DUST (type 4) - Dust cloud ----
 13817	7F55					    ; Frame 0: Small dots
 13818	7F55	00	42	00	24	00	42	00	24	    db #00, #42, #00, #24, #00, #42, #00, #24
 13819	7F5D					    ; Frame 1: Expanding dots
 13820	7F5D	24	00	66	00	24	00	66	00	    db #24, #00, #66, #00, #24, #00, #66, #00
 13821	7F65					    ; Frame 2: Dispersed
 13822	7F65	00	81	00	42	00	81	00	42	    db #00, #81, #00, #42, #00, #81, #00, #42
 13823	7F6D					    ; Frame 3: Fading
 13824	7F6D	42	00	24	00	42	00	24	00	    db #42, #00, #24, #00, #42, #00, #24, #00
 13825	7F75					
 13826	7F75					; ---- PARTICLE_IMPACT (type 5) - Impact star ----
 13827	7F75					    ; Frame 0: Large star
 13828	7F75	18	5A	7E	FF	FF	7E	5A	18	    db #18, #5A, #7E, #FF, #FF, #7E, #5A, #18
 13829	7F7D					    ; Frame 1: Shrinking
 13830	7F7D	00	18	3C	7E	7E	3C	18	00	    db #00, #18, #3C, #7E, #7E, #3C, #18, #00
 13831	7F85					    ; Frame 2: Small star
 13832	7F85	00	00	18	3C	3C	18	00	00	    db #00, #00, #18, #3C, #3C, #18, #00, #00
 13833	7F8D					    ; Frame 3: Fading
 13834	7F8D	00	00	00	18	18	00	00	00	    db #00, #00, #00, #18, #18, #00, #00, #00
 13835	7F95					
 13836	7F95					; ---- PARTICLE_DEBRIS (type 6) - Falling chunk ----
 13837	7F95					    ; Frame 0: Solid chunk
 13838	7F95	00	3C	7E	7E	7E	7E	3C	00	    db #00, #3C, #7E, #7E, #7E, #7E, #3C, #00
 13839	7F9D					    ; Frame 1: Tumbling
 13840	7F9D	00	1E	3F	7F	7F	3F	1E	00	    db #00, #1E, #3F, #7F, #7F, #3F, #1E, #00
 13841	7FA5					    ; Frame 2: Rotating
 13842	7FA5	00	78	FC	FE	FE	FC	78	00	    db #00, #78, #FC, #FE, #FE, #FC, #78, #00
 13843	7FAD					    ; Frame 3: Tumbling again
 13844	7FAD	00	3C	7E	7E	7E	7E	3C	00	    db #00, #3C, #7E, #7E, #7E, #7E, #3C, #00
 13845	7FB5					
 13846	7FB5					; ---- PARTICLE_MUZZLE_FLASH (type 7) - Gun flash ----
 13847	7FB5					    ; Frame 0: Bright burst
 13848	7FB5	7E	FF	FF	FF	FF	FF	FF	7E	    db #7E, #FF, #FF, #FF, #FF, #FF, #FF, #7E
 13849	7FBD					    ; Frame 1: Fading
 13850	7FBD	3C	7E	FF	FF	FF	FF	7E	3C	    db #3C, #7E, #FF, #FF, #FF, #FF, #7E, #3C
 13851	7FC5					    ; Frame 2: Dimmer
 13852	7FC5	18	3C	7E	7E	7E	7E	3C	18	    db #18, #3C, #7E, #7E, #7E, #7E, #3C, #18
 13853	7FCD					    ; Frame 3: Gone
