 13945	8039					
 13946	8039					
 13947	8039					    ; ------------------------------------------------------------------
 13948	8039					    ; SM_Update
 13949	8039					    ; Main State Machine Update Routine
 13950	8039					    ; Input: A = Entity Index
 13951	8039					    ; ------------------------------------------------------------------
 13952	8039					SM_Update:
 13953	8039	F5				    push af
 13954	803A	C5				    push bc
 13955	803B	D5				    push de
 13956	803C	E5				    push hl
 13957	803D					    
 13958	803D	4F				    ld c, a             ; C = Entity Index
 13959	803E	06	00			    ld b, 0             ; BC = Entity Index
 13960	8040					    
 13961	8040					    ; 0. Check Wait Timer
 13962	8040	21	20	C9		    ld hl, entity_sm_wait_timer
 13963	8043	09				    add hl, bc
 13964	8044	7E				    ld a, (hl)
 13965	8045	B7				    or a
 13966	8046	28	05			    jr z, .sm_update_continue
 13967	8048					
 13968	8048					    ; Timer Active, Decrement
 13969	8048	3D				    dec a
 13970	8049	77				    ld (hl), a
 13971	804A	C3	77	80		    jp sm_update_done   ; Skip update
 13972	804D					
 13973	804D					.sm_update_continue:
 13974	804D					    ; BC is still Entity Index.
 13975	804D					    
 13976	804D					    ; 1. Increment Timer
 13977	804D	21	E0	C8		    ld hl, entity_sm_timer_l
 13978	8050	09				    add hl, bc
 13979	8051	34				    inc (hl)
 13980	8052	20	05			    jr nz, sm_timer_no_overflow
 13981	8054					    
 13982	8054	21	00	C9		    ld hl, entity_sm_timer_h
 13983	8057	09				    add hl, bc
 13984	8058	34				    inc (hl)
 13985	8059					sm_timer_no_overflow:
 13986	8059					
 13987	8059					    ; 2. Get Current State Pointer
 13988	8059	21	A0	C8		    ld hl, entity_sm_ptr_l
 13989	805C	09				    add hl, bc
 13990	805D	5E				    ld e, (hl)          ; E = Ptr Low
 13991	805E					    
 13992	805E	21	C0	C8		    ld hl, entity_sm_ptr_h
 13993	8061	09				    add hl, bc
 13994	8062	56				    ld d, (hl)          ; D = Ptr High
 13995	8063					
 13996	8063					    ; Check if pointer is null(0)
 13997	8063	7A				    ld a, d
 13998	8064	B3				    or e
 13999	8065	CA	77	80		    jp z, sm_update_done
 14000	8068					
 14001	8068					    ; DE points to State Data:
 14002	8068					    ; [0] = ID(Debug / Unused)
 14003	8068					    ; [1-2] = OnEnter Actions Ptr
 14004	8068					    ; [3-4] = OnExit Actions Ptr
 14005	8068					    ; [5-6] = Transitions List Ptr
 14006	8068					    
 14007	8068	EB				    ex de, hl           ; HL = State Data Ptr
 14008	8069					
 14009	8069					    ; 3. Check Transitions
 14010	8069	11	05	00		    ld de, 5
 14011	806C	19				    add hl, de
 14012	806D	5E				    ld e, (hl)
 14013	806E	23				    inc hl
 14014	806F	56				    ld d, (hl)
 14015	8070					    ; DE = Transitions List Ptr
 14016	8070	79				    ld a, c             ; A = Entity Index (kept in C)
 14017	8071					    
 14018	8071	CD	7C	80		    call SM_CheckTransitions
 14019	8074					
 14020	8074					    ; If Carry set, transition happened, stop update
 14021	8074	DA	77	80		    jp c, sm_update_done
 14022	8077					
 14023	8077					    ; 4. Execute OnUpdate Actions (Optional)
 14024	8077					
 14025	8077					sm_update_done:
 14026	8077	E1				    pop hl
 14027	8078	D1				    pop de
 14028	8079	C1				    pop bc
 14029	807A	F1				    pop af
 14030	807B	C9				    ret
 14031	807C					
 14032	807C					    ; ------------------------------------------------------------------
 14033	807C					; SM_CheckTransitions
 14034	807C					    ; Checks all transitions for the current state
