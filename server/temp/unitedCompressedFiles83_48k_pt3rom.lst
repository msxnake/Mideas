 18049	9039	FE	03			    cp 3                    ; < operator
 18050	903B	28	1F			    jr z, .op_less
 18051	903D	FE	04			    cp 4                    ; >= operator
 18052	903F	28	21			    jr z, .op_greater_equal
 18053	9041	FE	05			    cp 5                    ; <= operator
 18054	9043	28	23			    jr z, .op_less_equal
