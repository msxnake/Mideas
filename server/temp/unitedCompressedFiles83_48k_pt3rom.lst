 4799	4E19	4E				        ld c, (hl)                    ; C = entity index
 4800	4E1A	23				        inc hl                        ; Advance list pointer
 4801	4E1B	E5				        push hl                       ; Save list pointer
 4802	4E1C	59				        ld e, c
 4803	4E1D	16	00			        ld d, 0
