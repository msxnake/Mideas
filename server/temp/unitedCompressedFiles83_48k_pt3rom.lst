 14045	8080					    
 14046	8080	EB				    ex de, hl; HL = Transitions List
 14047	8081					
 14048	8081					    ; Read Count
 14049	8081	4E				    ld c, (hl); C = Count
 14050	8082	23				    inc hl
 14051	8083					
 14052	8083					    ; If count is 0, return
 14053	8083	79				    ld a, c
