 256	40B3					CLS     EQU #00C3        ; Clear screen
 257	40B3					POSIT   EQU #00C6        ; Position cursor (H=X, L=Y)
 258	40B3					ERAFNK  EQU #00CC        ; Erase function keys
 259	40B3					DSPFNK  EQU #00CF        ; Display function keys
 260	40B3					DISSCR  EQU #0041        ; Disable screen (prevent flicker)
 261	40B3					ENASCR  EQU #0044        ; Enable screen
 262	40B3					INITXT  EQU #006C        ; Initialize text mode
 263	40B3					INIT32  EQU #006F        ; Initialize screen mode
 264	40B3					INIGRP  EQU #0072        ; Initialize graphics routines
 265	40B3					
