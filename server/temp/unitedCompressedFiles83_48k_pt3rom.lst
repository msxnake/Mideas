 19571	96C9					; ------------------------------------------------------------------
 19572	96C9					; EFFECT 1: DISSOLVE_PIXELS - Column-interleaved dissolve (8 passes)
 19573	96C9					; Each pass clears cols D, D+8, D+16, D+24 with 1 HALT delay
 19574	96C9					; ------------------------------------------------------------------
 19575	96C9					.trans_dissolve_pixels:
 19576	96C9	16	00			    ld d, 0                       ; D = pass counter (0-7)
 19577	96CB					.tdp_loop:
 19578	96CB	7A				    ld a, d
