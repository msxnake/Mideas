 894	4145					MEDIUM_GREEN EQU 2
 895	4145					LIGHT_GREEN EQU 3
 896	4145					DARK_BLUE   EQU 4
 897	4145					LIGHT_BLUE  EQU 5
 898	4145					DARK_RED    EQU 6
 899	4145					CYAN        EQU 7
 900	4145					MEDIUM_RED  EQU 8
 901	4145					LIGHT_RED   EQU 9
 902	4145					DARK_YELLOW EQU 10
 903	4145					LIGHT_YELLOW EQU 11
 904	4145					DARK_GREEN  EQU 12
 905	4145					MAGENTA     EQU 13
 906	4145					GRAY        EQU 14
 907	4145					WHITE       EQU 15
