 1375	4145					PT3_Env_Del     EQU #D192   ; Envelope delay
 1376	4145					PT3_ESldAdd     EQU #D193   ; Envelope slide add (2 bytes)
 1377	4145					PT3_NTL3        EQU #D195   ; Note table link 3
