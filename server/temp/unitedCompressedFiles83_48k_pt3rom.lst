 11188	700F					; ------------------------------------------------------------------
 11189	700F					; force_render_hud
 11190	700F					; Force a HUD redraw on this frame, preserving caller-visible registers
 11191	700F					; Input:
 11192	700F					;   None
 11193	700F					; Output:
 11194	700F					;   None
 11195	700F					; Clobbers:
 11196	700F					;   None visible to caller
 11197	700F					; Preserves:
 11198	700F					;   AF, BC, DE, HL, IX
 11199	700F					; Notes:
 11200	700F					;   - Sets hud_dirty_flag = 1 and then calls render_hud
 11201	700F					; ------------------------------------------------------------------
 11202	700F					force_render_hud:
 11203	700F	F5				    push af
 11204	7010	3E	01			    ld a, 1
 11205	7012	32	32	C6		    ld (hud_dirty_flag), a
 11206	7015	CD	78	6F		    call render_hud
 11207	7018	F1				    pop af
 11208	7019	C9				    ret
