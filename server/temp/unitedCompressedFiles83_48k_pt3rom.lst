 827	4145					; MSX SYSTEM CONSTANTS
 828	4145					; File: constants.asm
 829	4145					; Description: MSX hardware constants and project-specific definitions
 830	4145					; ==================================================================
 831	4145					
 832	4145					; ==================================================================
 833	4145					; VRAM LAYOUT - SCREEN 2 MODE
 834	4145					; ==================================================================
 835	4145					
 836	4145					; Pattern Generator Table (PGT) - 3 Banks
 837	4145					CHRTBL  EQU #0000        ; Pattern table base address (alias)
 838	4145					CHRTBL2 EQU #0000        ; Pattern table base address (Bank 0)
 839	4145					; Bank 1: CHRTBL2 + #800   (#0800)
 840	4145					; Bank 2: CHRTBL2 + #1000  (#1000)
 841	4145					
 842	4145					; Color Attribute Table (CAT) - 3 Banks
 843	4145					CLRTBL  EQU #2000        ; Color table base address (alias)
 844	4145					CLRTBL2 EQU #2000        ; Color table base address (Bank 0)
 845	4145					; Bank 1: CLRTBL2 + #800   (#2800)
 846	4145					; Bank 2: CLRTBL2 + #1000  (#3000)
 847	4145					
 848	4145					; Other VRAM Areas
 849	4145					NAMETBL EQU #1800        ; Name table base address
 850	4145					SPRATR  EQU #1B00        ; Sprite attribute table
 851	4145					SPRPAT  EQU #3800        ; Sprite pattern table
 852	4145					
 853	4145					; ==================================================================
 854	4145					; SCREEN MODES
 855	4145					; ==================================================================
 856	4145					SCREEN0     EQU 0        ; 40x24 text
 857	4145					SCREEN1     EQU 1        ; 32x24 text/graphics
 858	4145					SCREEN2     EQU 2        ; 256x192 graphics
 859	4145					SCREEN3     EQU 3        ; 64x48 multicolor
 860	4145					
 861	4145					; ==================================================================
 862	4145					; SCREEN DIMENSIONS (DYNAMIC BASED ON PROJECT TILES)
 863	4145					; ==================================================================
 864	4145					
 865	4145					; Project-specific tile dimensions detected:
 866	4145					; Tile 0: rajol1 = 16x16px (2x2 MSX chars)
 867	4145					; Tile 1: senefa1 = 8x8px (1x1 MSX chars)
 868	4145					; Tile 2: corda = 8x8px (1x1 MSX chars)
 869	4145					; Tile 3: gema = 8x8px (1x1 MSX chars)
 870	4145					; Tile 4: gema_f0 = 8x8px (1x1 MSX chars)
 871	4145					; Tile 5: rajola = 8x8px (1x1 MSX chars)
 872	4145					; Tile 6: rajol_terra5 = 16x16px (2x2 MSX chars)
 873	4145					; Tile 7: gem_extra_jump = 8x8px (1x1 MSX chars)
 874	4145					; Tile 8: rajol_vermell = 8x8px (1x1 MSX chars)
 875	4145					; Tile 9: gem_extra_jump_f0 = 8x8px (1x1 MSX chars)
 876	4145					; Tile 10: elevador1 = 8x8px (1x1 MSX chars)
 877	4145					; Tile 11: elevador2 = 8x8px (1x1 MSX chars)
 878	4145					
 879	4145					; Using primary tile size: 16x16px
 880	4145					TILE_WIDTH      EQU 16    ; Primary tile width in pixels
 881	4145					TILE_HEIGHT     EQU 16   ; Primary tile height in pixels
 882	4145					SCREEN_TILES_X  EQU 16    ; Horizontal tiles (256px ?? 16px)
 883	4145					SCREEN_TILES_Y  EQU 12   ; Vertical tiles (192px ?? 16px)
 884	4145					MSX_CHARS_PER_TILE_X EQU 2  ; MSX characters wide per tile
 885	4145					MSX_CHARS_PER_TILE_Y EQU 2 ; MSX characters high per tile
