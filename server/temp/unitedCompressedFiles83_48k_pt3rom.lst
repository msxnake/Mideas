 13875	7FF5	21	40	C6		    ld hl, particle_pool
 13876	7FF8	06	08			    ld b, MAX_PARTICLES
 13877	7FFA					.part_clear_loop:
 13878	7FFA	C5				    push bc
 13879	7FFB	E5				    push hl
 13880	7FFC					
 13881	7FFC	7E				    ld a, (hl)
 13882	7FFD	FE	00			    cp PARTICLE_NONE
 13883	7FFF	28	07			    jr z, .part_clear_next
 13884	8001					
 13885	8001	CD	85	7E		    call clear_particle_tile
 13886	8004					
 13887	8004	E1				    pop hl
 13888	8005	E5				    push hl
 13889	8006	36	00			    ld (hl), PARTICLE_NONE
 13890	8008					
 13891	8008					.part_clear_next:
