 6486	5549	C8				    ret z                          ; Nothing collected yet - return early
 6487	554A					
 6488	554A	47				    ld b, a                        ; B = djnz counter (total collected entries)
 6489	554B	0E	00			    ld c, 0                        ; C = loop index
 6490	554D					.apply_ct_loop:
 6491	554D					    ; DE = (0, index) used for all three table lookups.
 6492	554D					    ; add hl, de does NOT modify DE, so we can reuse it for all 3 tables.
 6493	554D	16	00			    ld d, 0
 6494	554F	59				    ld e, c                        ; DE = (0, current index)
 6495	5550					
 6496	5550					    ; Check if this entry belongs to current world
