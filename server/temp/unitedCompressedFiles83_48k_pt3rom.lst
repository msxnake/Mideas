 14096	8099					
 14097	8099					    ; HL points to Target State Ptr
 14098	8099	5E				    ld e, (hl)
 14099	809A	23				    inc hl
 14100	809B	56				    ld d, (hl)
 14101	809C					    ; DE = Target State Address
 14102	809C	23				    inc hl
 14103	809D	7E				    ld a, (hl)
 14104	809E	23				    inc hl
 14105	809F	66				    ld h, (hl)
 14106	80A0	6F				    ld l, a
