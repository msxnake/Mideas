 11122	6FC8					    ; Calculate VRAM address from X,Y pixel coordinates
 11123	6FC8					    ; Screen 2 Name Table = #1800 + (Y/8)*32 + (X/8)
 11124	6FC8					    
 11125	6FC8					    ; Y/8 = row
 11126	6FC8	7B				    ld a, e                     ; A = Y
 11127	6FC9	CB	3F			    srl a
 11128	6FCB	CB	3F			    srl a
 11129	6FCD	CB	3F			    srl a                       ; A = Y/8 (row)
