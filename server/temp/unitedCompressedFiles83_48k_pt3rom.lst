 171	4069					; Helper: Get expanded slot value for ENASLT/CALSLT usage
 172	4069					; Input:  A = slot number (0-3) in lower bits
 173	4069					; Output: A = expanded slot value if needed
 174	4069					GETSLOT:
 175	4069	E6	03			    and #03             ; Proteccion, nos aseguramos de que el valor esta en 0-3
 176	406B	4F				    ld  c,a             ; c = slot de la pagina
 177	406C	06	00			    ld  b,0             ; bc = slot de la pagina
 178	406E	21	C1	FC		    ld  hl,#fcc1        ; Tabla de slots expandidos
 179	4071	09				    add hl,bc           ; hl -> variable que indica si este slot esta expandido
 180	4072	7E				    ld  a,(hl)          ; Tomamos el valor
 181	4073	E6	80			    and #80             ; Si el bit mas alto es cero...
 182	4075	28	09			    jr  z,GETSLOT_EXIT  ; ...nos vamos a @@EXIT
 183	4077					    ; --- El slot esta expandido ---
 184	4077	B1				    or  c               ; Slot basico en el lugar adecuado
 185	4078	4F				    ld  c,a             ; Guardamos el valor en c
 186	4079	23				    inc hl              ; Incrementamos hl una...
 187	407A	23				    inc hl              ; ...dos...
 188	407B	23				    inc hl              ; ...tres...
 189	407C	23				    inc hl              ; ...cuatro veces
 190	407D	7E				    ld  a,(hl)          ; a = valor del registro de subslot del slot donde estamos
 191	407E	E6	0C			    and #0C             ; Nos quedamos con el valor donde esta nuestro cartucho
 192	4080					GETSLOT_EXIT:
 193	4080	B1				    or  c
 194	4081	C9				    ret
