 12036	72BE					; ------------------------------------------------------------------
 12037	72BE					; music_silence_channels
 12038	72BE					; Silence all AY channels via BIOS WRTPSG.
 12039	72BE					; Destroys: AF, E
 12040	72BE					; ------------------------------------------------------------------
 12041	72BE					music_silence_channels:
 12042	72BE	AF				    xor a
