 6996	5705					; ==================================================================
 6997	5705					; TILE COLLISION SYSTEM
 6998	5705					; ==================================================================
 6999	5705					; Provides functions for checking collision with background tiles
 7000	5705					; Uses behavior maps generated from screen collision layers
 7001	5705					; ==================================================================
 7002	5705					
 7003	5705					; ------------------------------------------------------------------
 7004	5705					; get_tile_at_position
 7005	5705					; Convert pixel coordinates to tile coordinates and get tile ID
 7006	5705					; Input:  D = X position (pixels), E = Y position (pixels)
 7007	5705					; Output: A = Tile ID at that position, Z flag set if out of bounds
 7008	5705					; Destroys: BC, HL
 7009	5705					; ------------------------------------------------------------------
 7010	5705					get_tile_at_position:
 7011	5705					    ; Convert X pixel to tile column (divide by 8 - MSX Screen 2 character cell)
 7012	5705					    ; Screen layout is ALWAYS 32x24 grid of 8x8 cells regardless of project tile size
 7013	5705	7A				    ld a, d
 7014	5706	CB	3F			    srl a
 7015	5708	CB	3F			    srl a
 7016	570A	CB	3F			    srl a                         ; A = X / 8 = tile column
 7017	570C	47				    ld b, a                       ; B = tile column
 7018	570D					
 7019	570D					    ; Convert Y pixel to tile row (divide by 8 - MSX Screen 2 character cell)
 7020	570D	7B				    ld a, e
 7021	570E	CB	3F			    srl a
 7022	5710	CB	3F			    srl a
 7023	5712	CB	3F			    srl a                         ; A = Y / 8 = tile row
 7024	5714	4F				    ld c, a                       ; C = tile row
 7025	5715					
 7026	5715					    ; Check bounds (assume 32x24 tile screen for now)
 7027	5715	78				    ld a, b
 7028	5716	FE	20			    cp 32
 7029	5718	30	27			    jr nc, .out_of_bounds
 7030	571A	79				    ld a, c
 7031	571B	FE	18			    cp 24
 7032	571D	30	22			    jr nc, .out_of_bounds
 7033	571F					
 7034	571F					    ; Calculate tile index: index = row * 32 + column (16-bit to avoid overflow)
 7035	571F	69				    ld l, c
 7036	5720	26	00			    ld h, 0                       ; HL = row (16-bit)
 7037	5722	29				    add hl, hl                    ; HL = row * 2
 7038	5723	29				    add hl, hl                    ; HL = row * 4
 7039	5724	29				    add hl, hl                    ; HL = row * 8
 7040	5725	29				    add hl, hl                    ; HL = row * 16
 7041	5726	29				    add hl, hl                    ; HL = row * 32
 7042	5727	58				    ld e, b
 7043	5728	16	00			    ld d, 0
 7044	572A	19				    add hl, de                    ; HL = row * 32 + column
 7045	572B					
 7046	572B					    ; Read actual tile from current screen layout
 7047	572B	ED	5B	1E	C0	    ld de, (current_screen_layout) ; DE = pointer to screen layout data
 7048	572F	19				    add hl, de                    ; HL = pointer to tile at position
 7049	5730	CD	76	41		    call mapper_push_p2
 7050	5733	3A	20	C0		    ld a, (current_screen_layout_bank)
 7051	5736	CD	5D	41		    call mapper_set_bank_p2
 7052	5739	7E				    ld a, (hl)                    ; A = tile ID from screen map
 7053	573A	F5				    push af
 7054	573B	CD	7D	41		    call mapper_pop_p2
 7055	573E	F1				    pop af
 7056	573F					
 7057	573F	B7				    or a                          ; Set flags based on tile ID
 7058	5740	C9				    ret                           ; Z flag set if tile == 0 (empty)
 7059	5741					
 7060	5741					.out_of_bounds:
 7061	5741	AF				    xor a                         ; A = 0
 7062	5742	C9				    ret                           ; Z flag set (out of bounds)
 7063	5743					
 7064	5743					; ------------------------------------------------------------------
 7065	5743					; get_tile_behavior
 7066	5743					; Get behavior/collision type of a tile
 7067	5743					; Input:  A = Tile ID (character code from screen map)
 7068	5743					; Output: A = Behavior flags (TILE_SOLID, TILE_PLATFORM, etc.)
 7069	5743					; Destroys: HL
