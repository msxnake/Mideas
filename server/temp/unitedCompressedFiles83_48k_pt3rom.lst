 14063	8087					
 14064	8087					    ; Structure of Transition Entry:
 14065	8087					;[0] = Condition Type
 14066	8087					    ;[1...] = Params(Variable length)
 14067	8087					    ;[Next] = Target State Ptr(Low)
 14068	8087					    ;[Next + 1] = Target State Ptr(High)
 14069	8087					    ;[Next + 2] = Actions Ptr(Low)
 14070	8087					    ;[Next + 3] = Actions Ptr(High)
 14071	8087					    
 14072	8087	78				    ld a, b; A = Entity Index
 14073	8088	CD	16	81		    call SM_EvaluateCondition
