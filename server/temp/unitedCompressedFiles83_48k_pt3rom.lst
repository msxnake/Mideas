 11499	7121					; ------------------------------------------------------------------
 11500	7121					; update_hud_lives
 11501	7121					; Update lives HUD element
 11502	7121					; Input: A = Number of lives (0-9)
 11503	7121					; Output:
 11504	7121					;   None
 11505	7121					; Clobbers:
 11506	7121					;   None visible to caller
 11507	7121					; Preserves:
 11508	7121					;   AF, HL
 11509	7121					; Notes:
 11510	7121					;   - Writes only the numeric digit in VRAM; the static label is not touched
 11511	7121					; ------------------------------------------------------------------
 11512	7121					update_hud_lives:
 11513	7121	F5				    push af
 11514	7122	E5				    push hl
 11515	7123					
 11516	7123					    ; Direct VRAM update of the Lives numeric field.
 11517	7123	C6	30			    add a, '0'                  ; Convert to ASCII
 11518	7125	21	36	18		    ld hl, #1836
 11519	7128	CD	CE	40		    call FAST_WRTVRM
 11520	712B					
 11521	712B	E1				    pop hl
 11522	712C	F1				    pop af
 11523	712D	C9				    ret
