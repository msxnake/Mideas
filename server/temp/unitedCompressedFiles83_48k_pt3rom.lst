 4782	4E02					    ; Initialize all lifetimes to 0 (infinite by default)
 4783	4E02	21	40	C9		    ld hl, entity_lifetime
 4784	4E05	11	41	C9		    ld de, entity_lifetime+1
 4785	4E08	01	1F	00		    ld bc, 31
