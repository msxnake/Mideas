 19643	971A					; ------------------------------------------------------------------
 19644	971A					.trans_horizontal_lines:
 19645	971A					    ; Pixel-row resolution: 24 tile-rows x 8 sub-rows = 192 pixel rows
 19646	971A					    ; Each step: clear all 8 pixel sub-rows of one tile-row, then wait
 19647	971A	0E	00			    ld c, 0                       ; C = tile row (0-23)
 19648	971C					.thl_loop:
 19649	971C	79				    ld a, c
 19650	971D	87				    add a, a
 19651	971E	87				    add a, a
 19652	971F	87				    add a, a                      ; A = tile_row * 8 = first pixel row of tile
 19653	9720	5F				    ld e, a                       ; E = first pixel row
 19654	9721	06	08			    ld b, 8                       ; 8 pixel sub-rows per tile row
 19655	9723					.thl_inner:
 19656	9723	7B				    ld a, e
 19657	9724	CD	87	97		    call trans_clear_pixel_row_colors
 19658	9727	1C				    inc e
