 17229	8CDB					    ; OR compound condition
 17230	8CDB					    ; Data format: DB subcondition_count, then N subconditions inline
 17231	8CDB					    ; Evaluates all subconditions; returns true if ANY is true
 17232	8CDB					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17233	8CDB					    ; Output: A = 1 (any true) or 0 (all false), HL = past all subcondition data
 17234	8CDB	4E				    ld c, (hl)              ; C = subcondition count
 17235	8CDC	23				    inc hl
 17236	8CDD	16	00			    ld d, 0                 ; D = result accumulator (0 = all false so far)
