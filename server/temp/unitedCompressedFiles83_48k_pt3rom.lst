 8336	5CAE					; SPRITE MANAGEMENT FUNCTIONS
 8337	5CAE					; ==================================================================
 8338	5CAE					
 8339	5CAE					; A = hardware sprite index, B = X, C = Y, D = pattern, E = color
 8340	5CAE					show_sprite:
 8341	5CAE					    ; Safety check: Ensure sprite index < 32
 8342	5CAE	FE	20			    cp 32
 8343	5CB0	D0				    ret nc
 8344	5CB1					
 8345	5CB1					    ; Safety check: Never write Y >= 208 (208 is SAT end marker on MSX)
 8346	5CB1	F5				    push af
 8347	5CB2	79				    ld a, c
 8348	5CB3	FE	D0			    cp 208
 8349	5CB5	38	02			    jr c, .y_ok
 8350	5CB7	0E	E0			    ld c, SPRITE_INVISIBLE
 8351	5CB9					.y_ok:
 8352	5CB9	F1				    pop af
 8353	5CBA					
 8354	5CBA					    ; Save pattern (D) and color (E) before calculating address
 8355	5CBA	D5				    push de
 8356	5CBB					
 8357	5CBB					    ; Calculate base address for sprite: index * 4
 8358	5CBB	6F				    ld l, a
 8359	5CBC	26	00			    ld h, 0
 8360	5CBE	29				    add hl, hl      ; index * 2
 8361	5CBF	29				    add hl, hl      ; index * 4
 8362	5CC0					    ; Add base of the attribute table
 8363	5CC0	11	42	CB		    ld de, sprite_attributes
 8364	5CC3	19				    add hl, de      ; HL = &sprite_attributes[index * 4]
 8365	5CC4					
 8366	5CC4					    ; Restore pattern and color
 8367	5CC4	D1				    pop de
 8368	5CC5					
 8369	5CC5					    ; Write attributes
 8370	5CC5	71				    ld (hl), c      ; Y
 8371	5CC6	23				    inc hl
 8372	5CC7	70				    ld (hl), b      ; X
 8373	5CC8	23				    inc hl
 8374	5CC9	72				    ld (hl), d      ; Pattern
 8375	5CCA	23				    inc hl
 8376	5CCB	73				    ld (hl), e      ; Color
 8377	5CCC					
 8378	5CCC	3E	01			    ld a, 1
 8379	5CCE	32	E1	CA		    ld (sprites_dirty), a
 8380	5CD1	C9				    ret
 8381	5CD2					
 8382	5CD2					; Clear all sprites (set Y = SPRITE_INVISIBLE)
 8383	5CD2					; OPTIMIZED: Uses faster increment method instead of ADD HL,DE
 8384	5CD2					clear_all_sprites:
 8385	5CD2	21	42	CB		    ld hl, sprite_attributes
 8386	5CD5	06	20			    ld b, 32
 8387	5CD7	3E	E0			    ld a, SPRITE_INVISIBLE
 8388	5CD9					.sprite_clear_loop:
 8389	5CD9	77				    ld (hl), a      ; Set Y = SPRITE_INVISIBLE
 8390	5CDA	23				    inc hl          ; Skip to X
 8391	5CDB	23				    inc hl          ; Skip to Pattern
 8392	5CDC	23				    inc hl          ; Skip to Color
 8393	5CDD	23				    inc hl          ; Next sprite (4?? INC HL = 24 cycles vs ADD HL,DE = 35 cycles)
 8394	5CDE	10	F9			    djnz .sprite_clear_loop
 8395	5CE0	3E	01			    ld a, 1
 8396	5CE2	32	E1	CA		    ld (sprites_dirty), a
 8397	5CE5	C9				    ret
