 12121	7319	13				    inc de
 12122	731A	1A				    ld a, (de)
 12123	731B	47				    ld b, a
 12124	731C	79				    ld a, c
 12125	731D	CD	21	73		    call music_play_track
 12126	7320	C9				    ret
