 6476	5545					; apply_collected_tiles
 6477	5545					; Re-clears tiles that were previously collected on the current world/screen.
 6478	5545					; Called after every screen load so collected tiles do not respawn.
 6479	5545					; Input:  current_world_id and current_screen_id must already be set.
 6480	5545					; Output: None
