 19911	981D	D3	98			    out (#98), a                  ; Write byte to VRAM
 19912	981F	0B				    dec bc
 19913	9820	78				    ld a, b
 19914	9821	B1				    or c
 19915	9822	20	F8			    jr nz, .tff_loop
 19916	9824	FB				    ei
