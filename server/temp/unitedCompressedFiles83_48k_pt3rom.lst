 1885	4271					; DISABLE_TASK - Deactivate a task
 1886	4271					; ==================================================================
 1887	4271					; Register Contract:
 1888	4271					;   Purpose: Clear routine pointer in selected task slot.
 1889	4271					;   Inputs:
 1890	4271					;     - A = task slot (0-7)
 1891	4271					;   Outputs:
 1892	4271					;     - task_table[slot] = 0
 1893	4271					;   Clobbers:
 1894	4271					;     - AF
 1895	4271					;     - DE
 1896	4271					;     - HL
 1897	4271					;   Preserved:
 1898	4271					;     - BC
 1899	4271					;   Register roles:
 1900	4271					;     - A = slot validation and zero value for clearing
 1901	4271					;     - HL = destination slot pointer
 1902	4271					;     - DE = computed slot offset
 1903	4271					
 1904	4271					; Inputs:
 1905	4271					;   A = task slot (0-7)
 1906	4271					; Outputs: None
 1907	4271					; Modifies: AF, DE, HL
 1908	4271					; ==================================================================
 1909	4271					disable_task:
 1910	4271					    ; Validate slot
 1911	4271	FE	08			    cp 8
 1912	4273	D0				    ret nc
 1913	4274					
 1914	4274					    ; Calculate offset
 1915	4274	87				    add a, a                    ; A = slot * 2
 1916	4275	5F				    ld e, a
 1917	4276	16	00			    ld d, 0
 1918	4278	21	2E	D1		    ld hl, task_table
 1919	427B	19				    add hl, de                  ; HL = task_table + offset
 1920	427C					
 1921	427C					    ; Write 0 (disable)
 1922	427C	AF				    xor a
 1923	427D	77				    ld (hl), a                  ; Low byte = 0
 1924	427E	23				    inc hl
 1925	427F	77				    ld (hl), a                  ; High byte = 0
 1926	4280					
 1927	4280	C9				    ret
