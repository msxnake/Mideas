 11253	7036					; hud_ascii_to_tile
 11254	7036					; Convert ASCII character to tile index for font rendering
 11255	7036					; Input: A = ASCII character
 11256	7036					; Output: A = Tile index (ASCII code for direct mapping)
 11257	7036					; ------------------------------------------------------------------
 11258	7036					hud_ascii_to_tile:
 11259	7036					    ; SIMPLIFIED: Just return the ASCII code directly
 11260	7036					    ; Font patterns are loaded at their ASCII positions
 11261	7036					    
 11262	7036					    ; Validate range (printable ASCII 32-126)
 11263	7036	FE	20			    cp 32
 11264	7038	D0				    ret nc              ; If >= 32, it's valid - return as-is
 11265	7039					    
 11266	7039					    ; Below 32 (control characters) - default to space
 11267	7039	3E	20			    ld a, 32            ; Space character
 11268	703B	C9				    ret
