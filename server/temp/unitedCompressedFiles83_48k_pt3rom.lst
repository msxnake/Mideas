 19505	9682					gameflow_handle_transition:
 19506	9682					    ; Transition node - visual screen wipe/fade effect
 19507	9682					    ; DE = transition data pointer (db effect_id)
 19508	9682					    ; BC = connection table
 19509	9682	C5				    push bc
 19510	9683	CD	96	96		    call execute_transition_effect
 19511	9686					    ; Restore VRAM after transition:
 19512	9686					    ; 1. Tile colors (chars 128+) ??? corrupted by color-table effects (#11 = black)
 19513	9686	CD	29	5A		    call load_colors_to_vram
 19514	9689					    ; 2. Font patterns + colors (chars 0-127) ??? also zeroed by color-table effects.
 19515	9689					    ;    init_font_system reloads both pattern bytes and color attributes for all
 19516	9689					    ;    font characters.  If no font is used in the project this is a no-op (ret).
 19517	9689	CD	D3	6E		    call init_font_system
 19518	968C	C1				    pop bc                        ; Restore connection table AFTER VRAM restore
 19519	968D	CD	34	98		    call gameflow_get_default_connection
 19520	9690	7C				    ld a, h
 19521	9691	B5				    or l
 19522	9692	C8				    ret z
 19523	9693	C3	30	92		    jp gameflow_execute_node
 19524	9696					
 19525	9696					; ==================================================================
 19526	9696					; execute_transition_effect
 19527	9696					; Execute visual screen transition by clearing the Name Table
 19528	9696					; in different patterns. All effects write tile 0 (blank/black)
 19529	9696					; to Name Table (#1800-#1AFF, 768 bytes = 32x24 tiles).
 19530	9696					;
 19531	9696					; Input:  DE = Transition data pointer
 19532	9696					;         (DE) = effect id: 0=cls, 1=dissolve_pixels, 2=dissolve_chars,
 19533	9696					;                           3=vertical_lines, 4=horizontal_lines,
 19534	9696					;                           5=spiral, 6=fill_white_squares
 19535	9696					; Destroys: AF, BC, DE, HL
 19536	9696					; ==================================================================
 19537	9696					execute_transition_effect:
 19538	9696	1A				    ld a, (de)                    ; A = effect id (0-6)
 19539	9697	13				    inc de
 19540	9698	F5				    push af                       ; Save effect id
 19541	9699	1A				    ld a, (de)                    ; A = frames per step (from node data)
 19542	969A	32	0F	C0		    ld (transition_delay_var), a  ; Store for trans_wait_frames
 19543	969D	F1				    pop af                        ; Restore effect id
 19544	969E	B7				    or a
 19545	969F	CA	BB	96		    jp z, .trans_cls
 19546	96A2	3D				    dec a
 19547	96A3	CA	C9	96		    jp z, .trans_dissolve_pixels
 19548	96A6	3D				    dec a
 19549	96A7	CA	EB	96		    jp z, .trans_dissolve_chars
 19550	96AA	3D				    dec a
 19551	96AB	CA	05	97		    jp z, .trans_vertical_lines
 19552	96AE	3D				    dec a
 19553	96AF	CA	1A	97		    jp z, .trans_horizontal_lines
 19554	96B2	3D				    dec a
 19555	96B3	CA	35	97		    jp z, .trans_spiral
 19556	96B6	3D				    dec a
 19557	96B7	CA	4B	97		    jp z, .trans_fill_white_squares
 19558	96BA	C9				    ret                           ; Unknown id - do nothing
 19559	96BB					
 19560	96BB					; ------------------------------------------------------------------
 19561	96BB					; EFFECT 0: CLS - Instant clear + hold black for configured duration
 19562	96BB					; ------------------------------------------------------------------
 19563	96BB					.trans_cls:
 19564	96BB	21	00	18		    ld hl, #1800
 19565	96BE	01	00	03		    ld bc, 768
