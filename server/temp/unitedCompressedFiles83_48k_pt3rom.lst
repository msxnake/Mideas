 1821	424F	28	07			    jr z, .not_in_vblank
 1822	4251	3E	01			    ld a, 1
 1823	4253	32	48	D1		    ld (vblank_flag), a
 1824	4256	18	04			    jr .uvf_done
 1825	4258					.not_in_vblank:
 1826	4258	AF				    xor a
 1827	4259	32	48	D1		    ld (vblank_flag), a
 1828	425C					.uvf_done:
 1829	425C	F1				    pop af
 1830	425D	C9				    ret
