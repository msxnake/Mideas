 4807	4E24	E1				        pop hl                        ; Restore list pointer
 4808	4E25	E6	04			        and #04                       ; AUTO_DESTROY bit (COMP_MASK_AUTO_DESTROY=#0400 -> high byte bit2)
 4809	4E27	28	34			        jr z, auto_destroy_next
 4810	4E29					
 4811	4E29					        ; Entity has auto-destroy component
 4812	4E29	C5				        push bc
 4813	4E2A	E5				        push hl
 4814	4E2B					
 4815	4E2B					        ; Get lifetime for this entity
