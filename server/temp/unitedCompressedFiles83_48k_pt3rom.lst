 10861	6EBE	B7				    or a                           ; Check for null terminator
 10862	6EBF	28	10			    jr z, print_string_end         ; End if null
 10863	6EC1					
 10864	6EC1					    ; Write character to VRAM Name Table
 10865	6EC1					    ; FAST_WRTVRM signature: A = data, HL = VRAM address
 10866	6EC1					    ; A already has character, HL already has VRAM address
 10867	6EC1	E5				    push hl                        ; Save string pointer
 10868	6EC2	D5				    push de                        ; Save VRAM position
 10869	6EC3	EB				    ex de, hl                      ; Swap: DE = string ptr, HL = VRAM address for FAST_WRTVRM
 10870	6EC4	CD	CE	40		    call FAST_WRTVRM               ; Write character to VRAM (fast)
 10871	6EC7	D1				    pop de                         ; Restore VRAM position
 10872	6EC8	E1				    pop hl                         ; Restore string pointer
 10873	6EC9					
 10874	6EC9					    ; Move to next character
 10875	6EC9	23				    inc hl                         ; Next character in string
 10876	6ECA	13				    inc de                         ; Next position in VRAM
 10877	6ECB	04				    inc b                          ; Count characters
 10878	6ECC	78				    ld a, b
 10879	6ECD	FE	20			    cp 32                          ; Limit to screen width
 10880	6ECF	20	EC			    jr nz, print_string_loop       ; Continue if not at edge
