 19727	9787					
 19728	9787					; ==================================================================
 19729	9787					; trans_clear_pixel_row_colors
 19730	9787					; Blackens a single pixel row (1px tall) by setting the color table
 19731	9787					; entry for all 256 tile patterns in the appropriate bank to 0x11
 19732	9787					; (fg=black, bg=black).  Works at 1-pixel-row granularity unlike
 19733	9787					; trans_clear_row_direct which works at 8-pixel (tile-row) granularity.
 19734	9787					;
 19735	9787					; Screen 2 color table layout:
 19736	9787					;   Bank 0 (#2000): tiles used in name-table rows 0-7   (pixel rows 0-63)
 19737	9787					;   Bank 1 (#2800): tiles used in name-table rows 8-15  (pixel rows 64-127)
 19738	9787					;   Bank 2 (#3000): tiles used in name-table rows 16-23 (pixel rows 128-191)
 19739	9787					; Each tile has 8 color bytes; byte J covers pixel sub-row J of that tile.
 19740	9787					; Tile T color byte for sub-row J:  bank_base + T*8 + J
 19741	9787					;
 19742	9787					; Input:  A = pixel row (0-191)
 19743	9787					;         bank    = A >> 6   (0-2)
 19744	9787					;         sub_row = A & 7    (0-7)
 19745	9787					;         color_base = #2000 + bank * #0800
 19746	9787					; Preserves: BC, DE, HL
 19747	9787					; ==================================================================
 19748	9787					trans_clear_pixel_row_colors:
 19749	9787	C5				    push bc
 19750	9788	D5				    push de
 19751	9789	E5				    push hl
 19752	978A					    ; --- Compute sub_row = A & 7 ---
 19753	978A	6F				    ld l, a                       ; L = pixel row (save)
 19754	978B	E6	07			    and 7
 19755	978D	5F				    ld e, a                       ; E = sub_row (0-7)
 19756	978E					    ; --- Compute bank = A >> 6 (0-2) ---
 19757	978E	7D				    ld a, l
 19758	978F	CB	3F			    srl a
 19759	9791	CB	3F			    srl a
 19760	9793	CB	3F			    srl a
 19761	9795	CB	3F			    srl a
 19762	9797	CB	3F			    srl a
 19763	9799	CB	3F			    srl a                         ; A = bank (0, 1 or 2)
 19764	979B					    ; --- Compute H = #20 + bank*8 (color table high byte) ---
 19765	979B					    ; bank=0 -> H=#20, bank=1 -> H=#28, bank=2 -> H=#30
 19766	979B	87				    add a, a                      ; bank * 2
 19767	979C	87				    add a, a                      ; bank * 4
 19768	979D	87				    add a, a                      ; bank * 8
 19769	979E	C6	20			    add a, #20
 19770	97A0	67				    ld h, a                       ; H = color table high byte for this bank
 19771	97A1	6B				    ld l, e                       ; L = sub_row  (offset within tile 0 entry)
 19772	97A2					    ; HL now = address of tile-0 color byte for this pixel sub-row
 19773	97A2					    ; --- Write 0x11 (black/black) for all 256 tiles ---
 19774	97A2					    ; Tile addresses: HL, HL+8, HL+16, ... HL+255*8
 19775	97A2					    ; (consecutive tiles are 8 bytes apart in the color table)
 19776	97A2	06	00			    ld b, 0                       ; B=0 ??? djnz executes 256 times
 19777	97A4					.tpcr_loop:
 19778	97A4					    ; DI only around the 3 critical VDP port writes.
 19779	97A4					    ; Keeping DI for the whole loop would leave interrupts disabled for ~6ms
 19780	97A4					    ; and can cause DI+HALT if trans_wait_frames is reached before EI fires.
 19781	97A4	F3				    di
 19782	97A5	7D				    ld a, l
 19783	97A6	D3	99			    out (#99), a                  ; VRAM address low
 19784	97A8	7C				    ld a, h
 19785	97A9	F6	40			    or #40
 19786	97AB	D3	99			    out (#99), a                  ; VRAM address high + write mode
 19787	97AD	3E	11			    ld a, #11                     ; fg=1 (black), bg=1 (black)
 19788	97AF	D3	98			    out (#98), a                  ; Write to VRAM color table
 19789	97B1	FB				    ei                            ; Re-enable: interrupt fires after next instr
 19790	97B2	7D				    ld a, l                       ; (EI delay instruction) Advance HL += 8
 19791	97B3	C6	08			    add a, 8
 19792	97B5	6F				    ld l, a
 19793	97B6	30	01			    jr nc, .tpcr_nc
 19794	97B8	24				    inc h
 19795	97B9					.tpcr_nc:
 19796	97B9	10	E9			    djnz .tpcr_loop
 19797	97BB	E1				    pop hl
 19798	97BC	D1				    pop de
 19799	97BD	C1				    pop bc
 19800	97BE	C9				    ret
 19801	97BF					
 19802	97BF					; ==================================================================
 19803	97BF					; trans_wait_frames
 19804	97BF					; Wait N V-blank frames where N = transition_delay_var
 19805	97BF					; Provides timed delay between animation steps
 19806	97BF					; Preserves: BC, DE, HL
 19807	97BF					; ==================================================================
 19808	97BF					trans_wait_frames:
 19809	97BF	C5				    push bc
 19810	97C0	3A	0F	C0		    ld a, (transition_delay_var)
 19811	97C3	B7				    or a
 19812	97C4	28	04			    jr z, .twf_done               ; 0 = no wait (safety)
 19813	97C6	47				    ld b, a
 19814	97C7					.twf_loop:
 19815	97C7	76				    halt                          ; Wait for V-blank (~20ms at 50Hz)
 19816	97C8	10	FD			    djnz .twf_loop
 19817	97CA					.twf_done:
 19818	97CA	C1				    pop bc
 19819	97CB	C9				    ret
 19820	97CC					
 19821	97CC					; ==================================================================
 19822	97CC					; trans_clear_column
 19823	97CC					; Write tile 0 to all 24 rows of a single column in the Name Table
 19824	97CC					; Input:  A = column (0-31)
 19825	97CC					; Preserves: BC, DE, HL
 19826	97CC					; ==================================================================
 19827	97CC					trans_clear_column:
 19828	97CC	C5				    push bc
 19829	97CD	D5				    push de
 19830	97CE	E5				    push hl
 19831	97CF	6F				    ld l, a
 19832	97D0	26	18			    ld h, #18                     ; HL = #1800 + column (row 0)
 19833	97D2	06	18			    ld b, 24                      ; 24 rows
 19834	97D4	F3				    di                            ; Protect VDP address setup from ISR corruption
 19835	97D5					.tcc_row:
 19836	97D5	7D				    ld a, l
 19837	97D6	D3	99			    out (#99), a                  ; VRAM address low byte
 19838	97D8	7C				    ld a, h
 19839	97D9	F6	40			    or #40
 19840	97DB	D3	99			    out (#99), a                  ; VRAM address high + write mode
 19841	97DD	AF				    xor a
 19842	97DE	D3	98			    out (#98), a                  ; Write tile 0
 19843	97E0	7D				    ld a, l                       ; HL += 32 (advance to next row)
 19844	97E1	C6	20			    add a, 32
 19845	97E3	6F				    ld l, a
 19846	97E4	30	01			    jr nc, .tcc_no_carry
 19847	97E6	24				    inc h
 19848	97E7					.tcc_no_carry:
 19849	97E7	10	EC			    djnz .tcc_row
 19850	97E9	FB				    ei
 19851	97EA	E1				    pop hl
 19852	97EB	D1				    pop de
 19853	97EC	C1				    pop bc
 19854	97ED	C9				    ret
 19855	97EE					
 19856	97EE					; ==================================================================
 19857	97EE					; trans_clear_row_direct
 19858	97EE					; Write tile 0 to all 32 columns of a single row in the Name Table
 19859	97EE					; Input:  A = row (0-23)
 19860	97EE					; Preserves: BC, DE, HL
 19861	97EE					; ==================================================================
 19862	97EE					trans_clear_row_direct:
 19863	97EE	C5				    push bc
 19864	97EF	D5				    push de
 19865	97F0	E5				    push hl
 19866	97F1					    ; HL = #1800 + row * 32
 19867	97F1	6F				    ld l, a
 19868	97F2	26	00			    ld h, 0
 19869	97F4	29				    add hl, hl                    ; *2
 19870	97F5	29				    add hl, hl                    ; *4
 19871	97F6	29				    add hl, hl                    ; *8
 19872	97F7	29				    add hl, hl                    ; *16
 19873	97F8	29				    add hl, hl                    ; *32
 19874	97F9	11	00	18		    ld de, #1800
 19875	97FC	19				    add hl, de                    ; HL = name table row start
 19876	97FD	F3				    di                            ; Protect VDP address+data from ISR corruption
 19877	97FE	7D				    ld a, l
 19878	97FF	D3	99			    out (#99), a                  ; VRAM address low
 19879	9801	7C				    ld a, h
 19880	9802	F6	40			    or #40
 19881	9804	D3	99			    out (#99), a                  ; VRAM address high + write mode
 19882	9806	06	20			    ld b, 32
 19883	9808	AF				    xor a                         ; Tile 0
 19884	9809					.tcrd_loop:
 19885	9809	D3	98			    out (#98), a
 19886	980B	10	FC			    djnz .tcrd_loop
 19887	980D	FB				    ei
 19888	980E	E1				    pop hl
 19889	980F	D1				    pop de
 19890	9810	C1				    pop bc
 19891	9811	C9				    ret
