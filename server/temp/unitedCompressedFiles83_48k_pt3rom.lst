 4819	4E31	19				        add hl, de
 4820	4E32	7E				        ld a, (hl)                    ; A = lifetime
 4821	4E33					
 4822	4E33					        ; Check if lifetime is 0 (infinite) or > 0
 4823	4E33	B7				        or a
 4824	4E34	28	25			        jr z, auto_destroy_done       ; 0 = infinite lifetime, skip
 4825	4E36					
 4826	4E36					        ; Decrement lifetime
