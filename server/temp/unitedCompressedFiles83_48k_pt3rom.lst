 12045	72C3	3E	01			    ld a, 1
 12046	72C5	06	00			    ld b, 0
 12047	72C7	CD	66	71		    call psg_set_volume     ; Channel B vol=0
 12048	72CA	3E	02			    ld a, 2
 12049	72CC	06	00			    ld b, 0
 12050	72CE	CD	66	71		    call psg_set_volume     ; Channel C vol=0
 12051	72D1	3E	07			    ld a, PSG_MIXER
 12052	72D3	1E	3F			    ld e, #3F
 12053	72D5	CD	93	00		    call WRTPSG             ; All tones+noise off
 12054	72D8	C9				    ret
