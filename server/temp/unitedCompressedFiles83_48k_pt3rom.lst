 196	4082					; From: http://www.z80st.es/downloads/code/
 197	4082					; SETPAGES32K:  BIOS-ROM-YY-ZZ   -> BIOS-ROM-ROM-ZZ (SITUA PAGINA 2)
 198	4082					SETPAGES32K:    ; --- Posiciona las paginas de un megarom o un 32K ---
 199	4082	3E	C9			    ld  a, #C9              ; Codigo de RET
 200	4084	32	87	40		    ld  (SETPAGES32K_NOPRET), a   ; Modificamos la siguiente instruccion si estamos en RAM
 201	4087					SETPAGES32K_NOPRET:
 202	4087	00				    nop                     ; No hacemos nada si no estamos en RAM
 203	4088					    ; --- Si llegamos aqui no estamos en RAM, hay que posicionar la pagina ---
 204	4088	CD	38	01		    call RSLREG             ; Leemos el contenido del registro de seleccion de slots
 205	408B	0F				    rrca                    ; Rotamos a la derecha...
 206	408C	0F				    rrca                    ; ...dos veces
 207	408D	CD	69	40		    call GETSLOT            ; Obtenemos el slot de la pagina 1 ($4000-$BFFF)
 208	4090	32	13	C0		    ld (ROM_slot), a        ; Save slot for later use
 209	4093	26	80			    ld  h, #80              ; Seleccionamos pagina 2 ($8000-$BFFF)
 210	4095	C3	24	00		    jp  ENASLT              ; Posicionamos la pagina 2 y volvemos
