 11397	70B6					; ------------------------------------------------------------------
 11398	70B6					; update_hud_score
 11399	70B6					; Update score HUD element with current score value
 11400	70B6					; Input: HL = Score value (16-bit binary, 0-65535)
 11401	70B6					; Writes score digits directly into the HUD numeric field in VRAM
 11402	70B6					; Output:
 11403	70B6					;   None
 11404	70B6					; Clobbers:
 11405	70B6					;   None visible to caller
 11406	70B6					; Preserves:
 11407	70B6					;   AF, BC, DE, HL
 11408	70B6					; Notes:
 11409	70B6					;   - Uses BC internally for decimal divisors
 11410	70B6					;   - Uses DE internally as VRAM cursor for the numeric field
 11411	70B6					;   - Writes only the numeric digits; the static "SCORE: " label is not touched
 11412	70B6					; ------------------------------------------------------------------
 11413	70B6					update_hud_score:
 11414	70B6	F5				    push af
 11415	70B7	C5				    push bc
 11416	70B8	D5				    push de
 11417	70B9	E5				    push hl
 11418	70BA					
 11419	70BA					    ; Direct VRAM update of the numeric HUD field.
 11420	70BA					    ; Static label ("SCORE: ") stays in ROM; only digits are rewritten.
 11421	70BA	11	28	18		    ld de, #1828
 11422	70BD					
 11423	70BD					    ; Leading digit 0: forced zero (Score is 16-bit max 65535)
 11424	70BD	3E	30			    ld a, '0'
 11425	70BF	E5				    push hl
 11426	70C0	62				    ld h, d
 11427	70C1	6B				    ld l, e
 11428	70C2	CD	CE	40		    call FAST_WRTVRM
 11429	70C5	E1				    pop hl
 11430	70C6	13				    inc de
 11431	70C7					    ; Runtime digit 0: / 10000
 11432	70C7	01	10	27		    ld bc, 10000
 11433	70CA	CD	16	71		    call .div16
 11434	70CD	C6	30			    add a, '0'
 11435	70CF	E5				    push hl
 11436	70D0	62				    ld h, d
 11437	70D1	6B				    ld l, e
 11438	70D2	CD	CE	40		    call FAST_WRTVRM
 11439	70D5	E1				    pop hl
 11440	70D6	13				    inc de
 11441	70D7					    ; Runtime digit 1: / 1000
 11442	70D7	01	E8	03		    ld bc, 1000
 11443	70DA	CD	16	71		    call .div16
 11444	70DD	C6	30			    add a, '0'
 11445	70DF	E5				    push hl
 11446	70E0	62				    ld h, d
 11447	70E1	6B				    ld l, e
 11448	70E2	CD	CE	40		    call FAST_WRTVRM
 11449	70E5	E1				    pop hl
 11450	70E6	13				    inc de
 11451	70E7					    ; Runtime digit 2: / 100
 11452	70E7	01	64	00		    ld bc, 100
 11453	70EA	CD	16	71		    call .div16
 11454	70ED	C6	30			    add a, '0'
 11455	70EF	E5				    push hl
 11456	70F0	62				    ld h, d
 11457	70F1	6B				    ld l, e
 11458	70F2	CD	CE	40		    call FAST_WRTVRM
 11459	70F5	E1				    pop hl
 11460	70F6	13				    inc de
 11461	70F7					    ; Runtime digit 3: / 10
 11462	70F7	01	0A	00		    ld bc, 10
 11463	70FA	CD	16	71		    call .div16
 11464	70FD	C6	30			    add a, '0'
 11465	70FF	E5				    push hl
 11466	7100	62				    ld h, d
 11467	7101	6B				    ld l, e
 11468	7102	CD	CE	40		    call FAST_WRTVRM
 11469	7105	E1				    pop hl
 11470	7106	13				    inc de
 11471	7107					    ; Final digit: ones (remainder)
 11472	7107	7D				    ld a, l
 11473	7108	C6	30			    add a, '0'
 11474	710A	E5				    push hl
 11475	710B	62				    ld h, d
 11476	710C	6B				    ld l, e
 11477	710D	CD	CE	40		    call FAST_WRTVRM
 11478	7110	E1				    pop hl
 11479	7111					
 11480	7111	E1				    pop hl
 11481	7112	D1				    pop de
 11482	7113	C1				    pop bc
 11483	7114	F1				    pop af
 11484	7115	C9				    ret
 11485	7116					
 11486	7116					; Helper: HL = HL / BC, A = quotient, HL = remainder
 11487	7116					.div16:
 11488	7116	AF				    xor a                       ; Quotient = 0
 11489	7117					.div16_loop:
 11490	7117	B7				    or a                        ; Clear carry
 11491	7118	ED	42			    sbc hl, bc                  ; HL -= BC
 11492	711A	38	03			    jr c, .div16_done           ; If underflow, done
 11493	711C	3C				    inc a                       ; Quotient++
 11494	711D	18	F8			    jr .div16_loop
 11495	711F					.div16_done:
 11496	711F	09				    add hl, bc                  ; Restore remainder
 11497	7120	C9				    ret
