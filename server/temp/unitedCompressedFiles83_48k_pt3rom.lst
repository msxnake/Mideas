 13621	7E62					; ==================================================================
 13622	7E62					; PARTICLE RENDERING FUNCTIONS
 13623	7E62					; ==================================================================
 13624	7E62					
 13625	7E62					; ------------------------------------------------------------------
 13626	7E62					; draw_particle_tile
 13627	7E62					; Draw particle at its position using its tile ID
 13628	7E62					; Input:  HL = Address of particle structure
 13629	7E62					; Destroys: AF, BC, DE, HL
 13630	7E62					; ------------------------------------------------------------------
 13631	7E62					draw_particle_tile:
 13632	7E62	E5				    push hl
 13633	7E63					
 13634	7E63					    ; Get position (offsets 2, 3)
 13635	7E63	23				    inc hl
 13636	7E64	23				    inc hl
 13637	7E65	46				    ld b, (hl)                  ; B = X tile
 13638	7E66	23				    inc hl
 13639	7E67	4E				    ld c, (hl)                  ; C = Y tile
 13640	7E68					
 13641	7E68					    ; Get tile ID (offset 5)
 13642	7E68	23				    inc hl
 13643	7E69	23				    inc hl
 13644	7E6A	7E				    ld a, (hl)                  ; A = tile ID
 13645	7E6B					
 13646	7E6B					    ; Calculate name table address
 13647	7E6B					    ; NAMETBL + (Y * 32) + X
 13648	7E6B	F5				    push af                     ; Save tile ID
 13649	7E6C	79				    ld a, c
 13650	7E6D	87				    add a, a
 13651	7E6E	87				    add a, a
 13652	7E6F	87				    add a, a
 13653	7E70	87				    add a, a
 13654	7E71	87				    add a, a                    ; Y * 32
 13655	7E72	80				    add a, b                    ; + X
 13656	7E73	5F				    ld e, a
 13657	7E74	16	00			    ld d, 0
 13658	7E76	21	00	18		    ld hl, NAMETBL
 13659	7E79	19				    add hl, de                  ; HL = VRAM address
 13660	7E7A					
 13661	7E7A					    ; Write tile ID to name table
 13662	7E7A	F1				    pop af                      ; Restore tile ID
 13663	7E7B	CD	4D	00		    call WRTVRM
 13664	7E7E					
 13665	7E7E					    ; Now update pattern in VRAM
 13666	7E7E	E1				    pop hl
 13667	7E7F	E5				    push hl
 13668	7E80	CD	9F	7E		    call update_particle_pattern
 13669	7E83					
 13670	7E83	E1				    pop hl
 13671	7E84	C9				    ret
 13672	7E85					
 13673	7E85					; ------------------------------------------------------------------
 13674	7E85					; clear_particle_tile
 13675	7E85					; Clear particle from screen (set tile to 0)
 13676	7E85					; Input:  HL = Address of particle structure
 13677	7E85					; ------------------------------------------------------------------
 13678	7E85					clear_particle_tile:
 13679	7E85	E5				    push hl
 13680	7E86					
 13681	7E86					    ; Get position
 13682	7E86	23				    inc hl
 13683	7E87	23				    inc hl
 13684	7E88	46				    ld b, (hl)                  ; B = X
 13685	7E89	23				    inc hl
 13686	7E8A	4E				    ld c, (hl)                  ; C = Y
 13687	7E8B					
 13688	7E8B					    ; Calculate name table address
 13689	7E8B	79				    ld a, c
 13690	7E8C	87				    add a, a
 13691	7E8D	87				    add a, a
 13692	7E8E	87				    add a, a
 13693	7E8F	87				    add a, a
 13694	7E90	87				    add a, a                    ; Y * 32
 13695	7E91	80				    add a, b
 13696	7E92	5F				    ld e, a
 13697	7E93	16	00			    ld d, 0
 13698	7E95	21	00	18		    ld hl, NAMETBL
 13699	7E98	19				    add hl, de
 13700	7E99					
 13701	7E99					    ; Write 0 (blank tile)
 13702	7E99	AF				    xor a
 13703	7E9A	CD	4D	00		    call WRTVRM
 13704	7E9D					
 13705	7E9D	E1				    pop hl
 13706	7E9E	C9				    ret
 13707	7E9F					
 13708	7E9F					; ------------------------------------------------------------------
 13709	7E9F					; update_particle_pattern
 13710	7E9F					; Redefine particle's pattern in VRAM based on type and frame
 13711	7E9F					; Input:  HL = Address of particle structure
 13712	7E9F					; Destroys: AF, BC, DE, HL
 13713	7E9F					; ------------------------------------------------------------------
 13714	7E9F					update_particle_pattern:
 13715	7E9F					    ; Get type and frame
 13716	7E9F	7E				    ld a, (hl)                  ; Offset 0: type
 13717	7EA0	47				    ld b, a                     ; B = type
 13718	7EA1	23				    inc hl
 13719	7EA2	23				    inc hl
 13720	7EA3	23				    inc hl
 13721	7EA4	23				    inc hl
 13722	7EA5	7E				    ld a, (hl)                  ; Offset 4: frame
 13723	7EA6	4F				    ld c, a                     ; C = frame
 13724	7EA7	2B				    dec hl
 13725	7EA8	2B				    dec hl
 13726	7EA9	23				    inc hl
 13727	7EAA	7E				    ld a, (hl)                  ; Offset 5: tile ID
 13728	7EAB	57				    ld d, a                     ; D = tile ID
 13729	7EAC					
 13730	7EAC					    ; Calculate pattern source address
 13731	7EAC					    ; particle_patterns + (type * 32) + (frame * 8)
 13732	7EAC	78				    ld a, b                     ; A = type
 13733	7EAD	87				    add a, a
 13734	7EAE	87				    add a, a
 13735	7EAF	87				    add a, a
 13736	7EB0	87				    add a, a
 13737	7EB1	87				    add a, a                    ; * 32 (4 frames * 8 bytes)
 13738	7EB2	6F				    ld l, a
 13739	7EB3	26	00			    ld h, 0
 13740	7EB5					
 13741	7EB5	79				    ld a, c                     ; A = frame
 13742	7EB6	87				    add a, a
 13743	7EB7	87				    add a, a
 13744	7EB8	87				    add a, a                    ; * 8
 13745	7EB9	5F				    ld e, a
 13746	7EBA	16	00			    ld d, 0
 13747	7EBC	19				    add hl, de
 13748	7EBD					
 13749	7EBD	11	D5	7E		    ld de, particle_patterns
 13750	7EC0	19				    add hl, de                  ; HL = source pattern address
 13751	7EC1					
 13752	7EC1					    ; Calculate VRAM destination
 13753	7EC1					    ; CHRTBL + (tile_id * 8)
 13754	7EC1	7A				    ld a, d                     ; A = tile ID
 13755	7EC2	5F				    ld e, a
 13756	7EC3	16	00			    ld d, 0
 13757	7EC5	EB				    ex de, hl                   ; DE = source, HL = tile_id
 13758	7EC6	29				    add hl, hl
 13759	7EC7	29				    add hl, hl
 13760	7EC8	29				    add hl, hl                  ; * 8
 13761	7EC9	01	00	00		    ld bc, CHRTBL
 13762	7ECC	09				    add hl, bc                  ; HL = VRAM address
 13763	7ECD					
 13764	7ECD	EB				    ex de, hl                   ; DE = VRAM, HL = source
 13765	7ECE					
 13766	7ECE					    ; Copy 8 bytes to VRAM
 13767	7ECE	01	08	00		    ld bc, 8
 13768	7ED1	CD	5C	00		    call LDIRVM
 13769	7ED4					
 13770	7ED4	C9				    ret
