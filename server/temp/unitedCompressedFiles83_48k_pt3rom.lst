 17193	8CC3	C9				    ret
 17194	8CC4					
 17195	8CC4					Condition_And:
 17196	8CC4					    ; AND compound condition
 17197	8CC4					    ; Data format: DB subcondition_count, then N subconditions inline
 17198	8CC4					    ; Evaluates all subconditions; returns true only if ALL are true
 17199	8CC4					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17200	8CC4					    ; Output: A = 1 (all true) or 0 (any false), HL = past all subcondition data
 17201	8CC4	4E				    ld c, (hl)              ; C = subcondition count
 17202	8CC5	23				    inc hl
 17203	8CC6	16	01			    ld d, 1                 ; D = result accumulator (1 = all true so far)
 17204	8CC8					
 17205	8CC8					.and_loop:
 17206	8CC8	79				    ld a, c
 17207	8CC9	B7				    or a
 17208	8CCA	28	0D			    jr z, .and_done         ; No more subconditions
 17209	8CCC					
 17210	8CCC	C5				    push bc                 ; Save count (C) and entity index (implicitly)
 17211	8CCD	D5				    push de                 ; Save result accumulator (D)
 17212	8CCE					
 17213	8CCE	78				    ld a, b                 ; A = Entity Index
 17214	8CCF	CD	16	81		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17215	8CD2					
 17216	8CD2	D1				    pop de                  ; Restore result accumulator
