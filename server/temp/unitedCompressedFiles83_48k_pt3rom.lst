 14075	808B					; Result in A(1 = True, 0 = False)
 14076	808B					    
 14077	808B	B7				    or a
 14078	808C	20	0A			    jr nz, SM_TransitionTriggered
 14079	808E					
 14080	808E					    ; Condition False: Skip Transition Tail and continue to next transition
 14081	808E					    ; Transition tail layout after condition payload:
 14082	808E					    ;   [0-1] Target State Ptr
 14083	808E					    ;   [2-3] Actions Ptr
