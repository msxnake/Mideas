 4707	4DBF	21	5B	D0		            ld hl, entity_gravity_vel
 4708	4DC2	59				            ld e, c
 4709	4DC3	16	00			            ld d, 0
 4710	4DC5	19				            add hl, de
 4711	4DC6	19				            add hl, de; HL points to gravity velocity(word)
 4712	4DC7					
 4713	4DC7	5E				            ld e, (hl); Load current gravity velocity
 4714	4DC8	23				            inc hl
 4715	4DC9	56				            ld d, (hl)
 4716	4DCA					
 4717	4DCA					    ; Add gravity strength(64 in fixed - point = ~0.25 pixels / frame acceleration)
 4718	4DCA	7B				            ld a, e
 4719	4DCB	C6	40			            add a, #40; Add 64 to low byte
 4720	4DCD	5F				            ld e, a
 4721	4DCE	7A				            ld a, d
 4722	4DCF	CE	00			            adc a, #00; Add carry to high byte
 4723	4DD1	57				            ld d, a
 4724	4DD2					
 4725	4DD2					    ; Check terminal velocity(1024 = max fall speed)
 4726	4DD2					    ; Skip cap if velocity is negative (entity is moving UP / jumping)
 4727	4DD2	7A				            ld a, d
 4728	4DD3	CB	7F			            bit 7, a; Check sign bit - negative means going up
 4729	4DD5	20	07			            jr nz, gravity_store_vel; Skip cap for upward velocity
 4730	4DD7	FE	04			            cp #04; Check if >= 1024 (unsigned, only for positive/downward)
 4731	4DD9	38	03			            jr c, gravity_store_vel; If < 1024, continue
 4732	4DDB	11	00	04		            ld de, #0400; Cap at terminal velocity
