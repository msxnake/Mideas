 1411	4145					; RAM Layout:
 1412	4145					;   #C000-#D3B4: Project variables (5044 bytes)
 1413	4145					;   #D3B4-#F37F: Free RAM (~8140 bytes available)
 1414	4145					;   #F380-#FFFF: MSX System variables (DO NOT TOUCH)
 1415	4145					;
 1416	4145					; NOTE: Variables are defined using EQU (address labels only).
 1417	4145					;       RAM space is used at runtime, NOT reserved in ROM.
