 10964	6F36					.marco_loop:
 10965	6F36	C5				    push bc                     ; Save counter
 10966	6F37					
 10967	6F37					    ; Check visible flag first (offset 8)
 10968	6F37	DD	7E	08		    ld a, (ix+8)                ; A = Visible
 10969	6F3A	B7				    or a
 10970	6F3B	28	2C			    jr z, .skip_marco           ; Skip if not visible
 10971	6F3D					
 10972	6F3D					    ; Read element fields
 10973	6F3D	DD	56	01		    ld d, (ix+1)                ; D = X position (pixels)
 10974	6F40	DD	5E	02		    ld e, (ix+2)                ; E = Y position (pixels)
 10975	6F43	DD	46	03		    ld b, (ix+3)                ; B = Width (tiles)
 10976	6F46	DD	4E	04		    ld c, (ix+4)                ; C = Height (tiles)
 10977	6F49	DD	7E	05		    ld a, (ix+5)                ; A = Flags
