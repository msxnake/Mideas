 14085	8091	19				    add hl, de
 14086	8092					    
 14087	8092	C1				    pop bc; Restore counters
 14088	8093	0D				    dec c; Decrement loop counter
 14089	8094	20	F0			    jr nz, SM_CheckTransitions_Loop
 14090	8096					    
 14091	8096	B7				    or a            ; Clear carry(no transition)
 14092	8097	C9				    ret
 14093	8098					
