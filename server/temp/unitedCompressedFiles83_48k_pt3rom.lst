 348	40B3					; ==================================================================
 349	40B3					; DIRECT HARDWARE ACCESS ROUTINES
 350	40B3					; ==================================================================
 351	40B3					; Mode: HYBRID
 352	40B3					; Optimize Level: safe
 353	40B3					; Debug: DISABLED
 354	40B3					;
 355	40B3					; These routines provide direct hardware access for maximum performance.
 356	40B3					; They replace BIOS calls in performance-critical sections.
 357	40B3					;
 358	40B3					; Performance Gains vs BIOS:
 359	40B3					;   FAST_LDIRVM:  ~40% faster (12,288 vs 20,480 cycles for 256 bytes)
 360	40B3					;   FAST_WRTVRM:  ~43% faster (40 vs 70 cycles)
 361	40B3					;   FAST_WRTVDP:  ~55% faster (25 vs 55 cycles)
 362	40B3					;   FAST_GTSTCK:  ~58% faster (50 vs 120 cycles)
 363	40B3					;   FAST_GTTRIG:  direct trigger read (joystick button)
 364	40B3					;   FAST_SNSMAT:  direct keyboard matrix row read
 365	40B3					;
 366	40B3					; Compatibility: MSX1, MSX2, MSX2+
 367	40B3					; ==================================================================
 368	40B3					
 369	40B3					
 370	40B3					; ==================================================================
 371	40B3					; FAST_LDIRVM - Fast Block Transfer to VRAM
 372	40B3					; ==================================================================
 373	40B3					; Register Contract:
 374	40B3					;   Purpose: Block copy from RAM to VRAM using VDP data port auto-increment.
 375	40B3					;   Inputs:
 376	40B3					;     - HL = source address (RAM)
 377	40B3					;     - DE = destination address (VRAM)
 378	40B3					;     - BC = byte count
 379	40B3					;   Outputs:
 380	40B3					;     - None
 381	40B3					;   Clobbers:
 382	40B3					;     - AF
 383	40B3					;     - BC
 384	40B3					;     - HL
 385	40B3					;   Preserved:
 386	40B3					;     - DE
 387	40B3					;   Register roles:
 388	40B3					;     - A = VDP address bytes and data byte being transferred
 389	40B3					;     - HL = RAM read pointer (increments each byte)
 390	40B3					;     - DE = only used to program initial VRAM address
 391	40B3					;     - BC = countdown loop counter
 392	40B3					;   Notes:
 393	40B3					;     - Caller must preserve AF/BC/HL if needed after call.
 394	40B3					
 395	40B3					; Replaces BIOS LDIRVM with direct hardware access
 396	40B3					;
 397	40B3					; Input:
 398	40B3					;   HL = Source address (RAM)
 399	40B3					;   DE = Destination address (VRAM)
 400	40B3					;   BC = Byte count
 401	40B3					;
 402	40B3					; Output:
 403	40B3					;   None
 404	40B3					;
 405	40B3					; Destroys:
 406	40B3					;   AF, BC, HL
 407	40B3					;
 408	40B3					; Performance:
 409	40B3					;   ~48 cycles/byte vs BIOS ~80+ cycles/byte
 410	40B3					;   For 256 bytes: 12,288 cycles vs 20,480+ (40% faster)
 411	40B3					;
 412	40B3					; Notes:
 413	40B3					;   - Auto-increments VRAM address (VDP feature)
 414	40B3					;   - Keeps IRQs masked for the whole transfer to avoid VDP port races
 415	40B3					;   - Restores previous IRQ enable state on return
 416	40B3					;   - Works on all MSX models (TMS9918, V9938, V9958)
 417	40B3					; ==================================================================
 418	40B3					FAST_LDIRVM:
 419	40B3					    ; Preserve previous IRQ state (LD A,I copies IFF2 into P/V)
 420	40B3	ED	57			    ld a, i
 421	40B5	F5				    push af
 422	40B6	F3				    di
 423	40B7					
 424	40B7					    ; Set VRAM write address
 425	40B7	7B				    ld a, e
 426	40B8	D3	99			    out (#99), a           ; Write address low byte to VDP
 427	40BA	00				    nop                    ; Real VDPs need a short settle time between control writes
 428	40BB	7A				    ld a, d
 429	40BC	F6	40			    or #40                 ; Set bit 6 for write mode
 430	40BE	D3	99			    out (#99), a           ; Write address high byte + write command
 431	40C0	00				    nop                    ; Let the VDP latch the address before the first data write
 432	40C1					
 433	40C1					    ; Copy loop
 434	40C1					.ldirvm_loop:
 435	40C1	7E				    ld a, (hl)             ; Read byte from RAM (7 cycles)
 436	40C2	D3	98			    out (#98), a           ; Write to VRAM data port (11 cycles)
 437	40C4	23				    inc hl                 ; Next source address (6 cycles)
 438	40C5	0B				    dec bc                 ; Decrement counter (6 cycles)
 439	40C6	78				    ld a, b                ; Check if BC = 0 (4 cycles)
 440	40C7	B1				    or c                   ; (4 cycles)
 441	40C8	20	F7			    jr nz, .ldirvm_loop    ; Loop if not zero (12/7 cycles)
 442	40CA					
 443	40CA					    ; Restore previous IRQ state
 444	40CA	F1				    pop af
 445	40CB	E0				    ret po                 ; P/V=0 => IRQs were disabled on entry
 446	40CC	FB				    ei
 447	40CD	C9				    ret
 448	40CE					
 449	40CE					
 450	40CE					; ==================================================================
 451	40CE					; FAST_WRTVRM - Write Single Byte to VRAM
 452	40CE					; ==================================================================
 453	40CE					; Register Contract:
 454	40CE					;   Purpose: Write one byte into VRAM while preserving caller-visible state.
 455	40CE					;   Inputs:
 456	40CE					;     - A = byte to write
 457	40CE					;     - HL = VRAM destination address
 458	40CE					;   Outputs:
 459	40CE					;     - None
 460	40CE					;   Clobbers:
 461	40CE					;     - None (all registers preserved)
 462	40CE					;   Preserved:
 463	40CE					;     - AF
 464	40CE					;     - BC
 465	40CE					;     - DE
 466	40CE					;     - HL
 467	40CE					;   Register roles:
 468	40CE					;     - A = temporarily saved/restored around VDP address programming
 469	40CE					;     - HL = VRAM address source (not modified)
 470	40CE					;   Notes:
 471	40CE					;     - Safe helper when the caller cannot tolerate register changes.
 472	40CE					
 473	40CE					; Replaces BIOS WRTVRM
 474	40CE					;
 475	40CE					; Input:
 476	40CE					;   A = Data byte to write
 477	40CE					;   HL = VRAM destination address
 478	40CE					;
 479	40CE					; Output:
 480	40CE					;   None
 481	40CE					;
 482	40CE					; Destroys:
 483	40CE					;   None (all registers preserved)
 484	40CE					;
 485	40CE					; Performance:
 486	40CE					;   ~40 cycles vs BIOS ~70 cycles (43% faster)
 487	40CE					;
 488	40CE					; Notes:
 489	40CE					;   - Preserves all registers including AF
 490	40CE					;   - VDP write sequence is atomic against ISR VRAM writes
 491	40CE					; ==================================================================
 492	40CE					FAST_WRTVRM:
 493	40CE					    ; Preserve caller-visible state and previous IRQ status.
 494	40CE	C5				    push bc
 495	40CF	4F				    ld c, a                ; C = input data byte
 496	40D0	F5				    push af                ; Save caller AF
 497	40D1	ED	57			    ld a, i
 498	40D3	F5				    push af                ; Save previous IFF2 in P/V
 499	40D4	F3				    di
 500	40D5	7D				    ld a, l
 501	40D6	D3	99			    out (#99), a           ; Address low (11 cycles)
 502	40D8	7C				    ld a, h
 503	40D9	F6	40			    or #40                 ; Write mode (7 cycles)
 504	40DB	D3	99			    out (#99), a           ; Address high + command (11 cycles)
 505	40DD	79				    ld a, c
 506	40DE	D3	98			    out (#98), a           ; Write to VRAM (11 cycles)
 507	40E0					
 508	40E0					    ; Restore previous IRQ state.
 509	40E0	F1				    pop af
 510	40E1	E2	E5	40		    jp po, .fwv_no_ei      ; P/V=0 => IRQs were disabled on entry
 511	40E4	FB				    ei
 512	40E5					.fwv_no_ei:
 513	40E5	F1				    pop af                 ; Restore caller AF
 514	40E6	C1				    pop bc
 515	40E7	C9				    ret
 516	40E8					
 517	40E8					
 518	40E8					; ==================================================================
 519	40E8					; FAST_RDVRM - Read Single Byte from VRAM
 520	40E8					; ==================================================================
 521	40E8					; Register Contract:
 522	40E8					;   Purpose: Read one byte from VRAM data port.
 523	40E8					;   Inputs:
 524	40E8					;     - HL = VRAM source address
 525	40E8					;   Outputs:
 526	40E8					;     - A = byte read from VRAM
 527	40E8					;   Clobbers:
 528	40E8					;     - AF
 529	40E8					;   Preserved:
 530	40E8					;     - BC
 531	40E8					;     - DE
 532	40E8					;     - HL
 533	40E8					;   Register roles:
 534	40E8					;     - A = VDP addressing command then read result
 535	40E8					;     - HL = address source only (unchanged)
 536	40E8					;   Notes:
 537	40E8					;     - Callers relying on flags must account for AF clobber.
 538	40E8					
 539	40E8					; Replaces BIOS RDVRM
 540	40E8					;
 541	40E8					; Input:
 542	40E8					;   HL = VRAM source address
 543	40E8					;
 544	40E8					; Output:
 545	40E8					;   A = Byte read from VRAM
 546	40E8					;
 547	40E8					; Destroys:
 548	40E8					;   AF
 549	40E8					;
 550	40E8					; Performance:
 551	40E8					;   ~35 cycles vs BIOS ~65 cycles (46% faster)
 552	40E8					;
 553	40E8					; Notes:
 554	40E8					;   - Useful for collision detection, tile reading
 555	40E8					;   - VDP requires small delay after address set before read
 556	40E8					; ==================================================================
 557	40E8					FAST_RDVRM:
 558	40E8	7D				    ld a, l
 559	40E9	D3	99			    out (#99), a           ; Address low
 560	40EB	7C				    ld a, h
 561	40EC	E6	3F			    and #3F                ; Clear bit 6 for read mode (bit 7 must be 0)
 562	40EE	D3	99			    out (#99), a           ; Address high + read command
 563	40F0	00				    nop                    ; VDP needs time to process address before read
 564	40F1	DB	98			    in a, (#98)            ; Read from VRAM data port
 565	40F3	C9				    ret
 566	40F4					
 567	40F4					
 568	40F4					; ==================================================================
 569	40F4					; FAST_WRTVDP - Write VDP Register
 570	40F4					; ==================================================================
 571	40F4					; Register Contract:
 572	40F4					;   Purpose: Write one VDP register value (value first, then register index).
 573	40F4					;   Inputs:
 574	40F4					;     - B = register value
 575	40F4					;     - C = register number
 576	40F4					;   Outputs:
 577	40F4					;     - None
 578	40F4					;   Clobbers:
 579	40F4					;     - AF
 580	40F4					;   Preserved:
 581	40F4					;     - BC
 582	40F4					;     - DE
 583	40F4					;     - HL
 584	40F4					;   Register roles:
 585	40F4					;     - A = output staging register for both OUT operations
 586	40F4					;     - B/C = preserved input pair for value and register id
 587	40F4					;   Notes:
 588	40F4					;     - Order of writes is mandatory for VDP register writes.
 589	40F4					
 590	40F4					; Replaces BIOS WRTVDP
 591	40F4					;
 592	40F4					; Input:
 593	40F4					;   B = Register value
 594	40F4					;   C = Register number (0-7 for MSX1, 0-23 for MSX2, 0-46 for MSX2+)
 595	40F4					;
 596	40F4					; Output:
 597	40F4					;   None
 598	40F4					;
 599	40F4					; Destroys:
 600	40F4					;   AF
 601	40F4					;
 602	40F4					; Performance:
 603	40F4					;   ~25 cycles vs BIOS ~55 cycles (55% faster)
 604	40F4					;
 605	40F4					; Notes:
 606	40F4					;   - Used for mode changes, colors, scroll, etc.
 607	40F4					;   - Register write order matters: value first, then register number
 608	40F4					; ==================================================================
 609	40F4					FAST_WRTVDP:
 610	40F4	78				    ld a, b                ; Get register value (4 cycles)
 611	40F5	D3	99			    out (#99), a           ; Write value first (11 cycles)
 612	40F7	79				    ld a, c                ; Get register number (4 cycles)
 613	40F8	F6	80			    or #80                 ; Set bit 7 for register write (7 cycles)
 614	40FA	D3	99			    out (#99), a           ; Write register select (11 cycles)
 615	40FC	C9				    ret                    ; (10 cycles)
 616	40FD					                           ; Total: ~25 cycles
 617	40FD					
 618	40FD					
 619	40FD					; ==================================================================
 620	40FD					; FAST_GTSTCK - Read Joystick Direction
 621	40FD					; ==================================================================
 622	40FD					; Register Contract:
 623	40FD					;   Purpose: Read joystick direction and map PSG bits to MSX GTSTCK direction code.
 624	40FD					;   Inputs:
 625	40FD					;     - A = joystick port (0 or 1)
 626	40FD					;   Outputs:
 627	40FD					;     - A = direction code (0-8)
 628	40FD					;   Clobbers:
 629	40FD					;     - AF
 630	40FD					;     - HL
 631	40FD					;   Preserved:
 632	40FD					;     - BC
 633	40FD					;     - DE
 634	40FD					;   Register roles:
 635	40FD					;     - A = PSG register selection, raw read, and final direction code
 636	40FD					;     - HL = lookup table pointer into joystick_direction_table
 637	40FD					;   Notes:
 638	40FD					;     - Bits are active-low; routine inverts and masks input nibble.
 639	40FD					
 640	40FD					; Replaces BIOS GTSTCK (which is notoriously slow)
 641	40FD					;
 642	40FD					; Input:
 643	40FD					;   A = Joystick port (0 = port 1, 1 = port 2)
 644	40FD					;
 645	40FD					; Output:
 646	40FD					;   A = Direction code (0-8)
 647	40FD					;       0 = Center (no direction)
 648	40FD					;       1 = Up
 649	40FD					;       2 = Up + Right
 650	40FD					;       3 = Right
 651	40FD					;       4 = Down + Right
 652	40FD					;       5 = Down
 653	40FD					;       6 = Down + Left
 654	40FD					;       7 = Left
 655	40FD					;       8 = Up + Left
 656	40FD					;
 657	40FD					; Destroys:
 658	40FD					;   AF, HL
 659	40FD					;
 660	40FD					; Performance:
 661	40FD					;   ~50 cycles vs BIOS ~120+ cycles (58% faster)
 662	40FD					;
 663	40FD					; Notes:
 664	40FD					;   - Reads from PSG register 14 (port 1) or 15 (port 2)
 665	40FD					;   - Joystick bits are active-low (inverted)
 666	40FD					;   - Uses lookup table for direction decoding
 667	40FD					; ==================================================================
 668	40FD					FAST_GTSTCK:
 669	40FD					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 670	40FD	0F				    rrca                   ; A = A / 2 (joystick port becomes 0 or 8)
 671	40FE	E6	0F			    and #0F                ; Mask to valid range
 672	4100	F6	0E			    or #0E                 ; Add 14 (base register for joystick)
 673	4102					
 674	4102					    ; Make PSG select+read atomic so VBlank music writes cannot
 675	4102					    ; corrupt the selected register mid-access.
 676	4102	F3				    di
 677	4103	D3	A0			    out (#A0), a           ; Write register number to PSG address port
 678	4105	DB	A2			    in a, (#A2)            ; Read value from PSG data port
 679	4107	FB				    ei
 680	4108					
 681	4108					    ; Process joystick data
 682	4108	2F				    cpl                    ; Invert bits (joystick is active-low)
 683	4109	E6	0F			    and #0F                ; Mask to 4 direction bits (Up, Down, Left, Right)
 684	410B					
 685	410B					    ; Lookup direction code from table
 686	410B	21	15	41		    ld hl, joystick_direction_table
 687	410E	85				    add a, l               ; Add offset to table base
 688	410F	6F				    ld l, a
 689	4110	8C				    adc a, h               ; Handle carry if table crosses page boundary
 690	4111	95				    sub l
 691	4112	67				    ld h, a
 692	4113	7E				    ld a, (hl)             ; Get direction code (0-8)
 693	4114	C9				    ret
 694	4115					
 695	4115					; Direction lookup table (16 entries for all 4-bit combinations)
 696	4115					; MSX PSG register 14 joystick bit order:
 697	4115					;   Bit 0 = Up    (0001)
 698	4115					;   Bit 1 = Down  (0010)
 699	4115					;   Bit 2 = Left  (0100)
 700	4115					;   Bit 3 = Right (1000)
 701	4115					; Value: GTSTCK-compatible direction code (0-8)
 702	4115					joystick_direction_table:
 703	4115	00				    db 0  ; 0000 = Center
 704	4116	01				    db 1  ; 0001 = Up
 705	4117	05				    db 5  ; 0010 = Down
 706	4118	00				    db 0  ; 0011 = Up+Down (invalid)
 707	4119	07				    db 7  ; 0100 = Left
 708	411A	08				    db 8  ; 0101 = Up+Left
 709	411B	06				    db 6  ; 0110 = Down+Left
 710	411C	00				    db 0  ; 0111 = Invalid
 711	411D	03				    db 3  ; 1000 = Right
 712	411E	02				    db 2  ; 1001 = Up+Right
 713	411F	04				    db 4  ; 1010 = Down+Right
 714	4120	00				    db 0  ; 1011 = Invalid
 715	4121	00				    db 0  ; 1100 = Left+Right (invalid)
 716	4122	00				    db 0  ; 1101 = Invalid
 717	4123	00				    db 0  ; 1110 = Invalid
 718	4124	00				    db 0  ; 1111 = All directions (invalid)
 719	4125					
 720	4125					
 721	4125					; ==================================================================
 722	4125					; FAST_GTTRIG - Read Joystick Trigger
 723	4125					; ==================================================================
 724	4125					; Register Contract:
 725	4125					;   Purpose: Read joystick trigger bit directly from PSG register.
 726	4125					;   Inputs:
 727	4125					;     - A = joystick port (0 or 1)
 728	4125					;   Outputs:
 729	4125					;     - A = #FF if pressed, #00 if released
 730	4125					;   Clobbers:
 731	4125					;     - AF
 732	4125					;   Preserved:
 733	4125					;     - BC
 734	4125					;     - DE
 735	4125					;     - HL
 736	4125					;   Register roles:
 737	4125					;     - A = register select, raw PSG read, and normalized return value
 738	4125					;   Notes:
 739	4125					;     - Trigger is active-low in PSG bit 4.
 740	4125					
 741	4125					; Direct hardware replacement for BIOS GTTRIG
 742	4125					;
 743	4125					; Input:
 744	4125					;   A = Joystick port (0 = port 1, 1 = port 2)
 745	4125					;
 746	4125					; Output:
 747	4125					;   A = #FF if pressed, 0 if released
 748	4125					;
 749	4125					; Destroys:
 750	4125					;   AF
 751	4125					;
 752	4125					; Notes:
 753	4125					;   - Reads PSG register 14/15 directly
 754	4125					;   - Trigger bit is active-low
 755	4125					; ==================================================================
 756	4125					FAST_GTTRIG:
 757	4125					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 758	4125	0F				    rrca
 759	4126	E6	0F			    and #0F
 760	4128	F6	0E			    or #0E
 761	412A					
 762	412A					    ; Make PSG select+read atomic so VBlank music writes cannot
 763	412A					    ; corrupt the selected register mid-access.
 764	412A	F3				    di
 765	412B	D3	A0			    out (#A0), a
 766	412D	DB	A2			    in a, (#A2)
 767	412F	FB				    ei
 768	4130					
 769	4130					    ; Trigger bit (bit 4): 0 when pressed, 1 when released
 770	4130	E6	10			    and #10
 771	4132	3E	00			    ld a, #00
 772	4134	C0				    ret nz
 773	4135	3E	FF			    ld a, #FF
 774	4137	C9				    ret
 775	4138					
 776	4138					
 777	4138					; ==================================================================
 778	4138					; FAST_SNSMAT - Sense Keyboard Matrix Row
 779	4138					; ==================================================================
 780	4138					; Register Contract:
 781	4138					;   Purpose: Select keyboard matrix row via PPI and return row state.
 782	4138					;   Inputs:
 783	4138					;     - A = matrix row (0-11)
 784	4138					;   Outputs:
 785	4138					;     - A = row bits (active-low)
 786	4138					;   Clobbers:
 787	4138					;     - AF
 788	4138					;     - C
 789	4138					;   Preserved:
 790	4138					;     - B
 791	4138					;     - DE
 792	4138					;     - HL
 793	4138					;   Register roles:
 794	4138					;     - A = row selector composition and final row read
 795	4138					;     - C = cached low nibble used to build PPI port C output
 796	4138					;   Notes:
 797	4138					;     - Upper nibble of current PPI port C is preserved.
 798	4138					
 799	4138					; Direct hardware replacement for BIOS SNSMAT
 800	4138					;
 801	4138					; Input:
 802	4138					;   A = row (0-11)
 803	4138					;
 804	4138					; Output:
 805	4138					;   A = row bits (active-low, 0=pressed)
 806	4138					;
 807	4138					; Destroys:
 808	4138					;   AF, C
 809	4138					; ==================================================================
 810	4138					FAST_SNSMAT:
 811	4138	E6	0F			    and #0F                 ; Keep valid row bits
 812	413A	4F				    ld c, a
 813	413B	DB	AA			    in a, (#AA)             ; Read current PPI port C
 814	413D	E6	F0			    and #F0                 ; Preserve upper nibble
 815	413F	B1				    or c                    ; Set keyboard row in lower nibble
 816	4140	D3	AA			    out (#AA), a            ; Select row
 817	4142	DB	A9			    in a, (#A9)             ; Read keyboard matrix row
 818	4144	C9				    ret
 819	4145					
 820	4145					
 821	4145					; ==================================================================
 822	4145					; END OF DIRECT HARDWARE ROUTINES
