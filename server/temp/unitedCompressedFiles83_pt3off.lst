 2392	4377					entity_wall_collision_flags EQU temp_byte_18 ; Directional wall collision bits (32 bytes)
 2393	4377					entity_collision_hitbox_w EQU temp_byte_19 ; Entity collision hitbox width (32 bytes)
 2394	4377					entity_collision_hitbox_h EQU temp_byte_20 ; Entity collision hitbox height (32 bytes)
 2395	4377					entity_collision_offset_x EQU temp_byte_21 ; Entity collision hitbox X offset (32 bytes)
 2396	4377					entity_collision_offset_y EQU temp_byte_22 ; Entity collision hitbox Y offset (32 bytes)
 2397	4377					entity_entity_collision_flags EQU temp_byte_23 ; bit0 entity(any), bit1 enemy, bit2 item (32 bytes)
 2398	4377					entity_last_collision_entity EQU temp_byte_24 ; Last collided entity index (255=none) (32 bytes)
 2399	4377					
