 14023	8818	19				    add hl, de
 14024	8819					    
 14025	8819	C1				    pop bc; Restore counters
 14026	881A	0D				    dec c; Decrement loop counter
 14027	881B	20	F0			    jr nz, SM_CheckTransitions_Loop
 14028	881D					    
 14029	881D	B7				    or a            ; Clear carry(no transition)
 14030	881E	C9				    ret
 14031	881F					
 14032	881F					SM_TransitionTriggered:
 14033	881F	C1				    pop bc; Restore counters(B = Entity Index)
 14034	8820					
 14035	8820					    ; HL points to Target State Ptr
 14036	8820	5E				    ld e, (hl)
 14037	8821	23				    inc hl
 14038	8822	56				    ld d, (hl)
 14039	8823					    ; DE = Target State Address
 14040	8823	23				    inc hl
 14041	8824	7E				    ld a, (hl)
 14042	8825	23				    inc hl
 14043	8826	66				    ld h, (hl)
 14044	8827	6F				    ld l, a
 14045	8828					    ; HL = Actions Ptr (0 if none)
 14046	8828					
 14047	8828					    ; Execute transition actions if present
 14048	8828	7C				    ld a, h
 14049	8829	B5				    or l
 14050	882A	28	08			    jr z, .skip_transition_actions
 14051	882C	D5				    push de            ; Save target state
