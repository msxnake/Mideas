 12184	8153					; SCROLL SYSTEM CONSTANTS
 12185	8153					; ==================================================================
 12186	8153					
 12187	8153					SCREEN_WIDTH_TILES      EQU 32      ; MSX Screen 2 width in tiles
 12188	8153					SCREEN_HEIGHT_TILES     EQU 24      ; MSX Screen 2 height in tiles
 12189	8153					SCREEN_WIDTH_PIXELS     EQU 256     ; MSX Screen 2 width in pixels
 12190	8153					SCREEN_HEIGHT_PIXELS    EQU 192     ; MSX Screen 2 height in pixels
