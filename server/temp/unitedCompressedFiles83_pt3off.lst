 13628	8613	87				    add a, a
 13629	8614	87				    add a, a
 13630	8615	87				    add a, a
 13631	8616	87				    add a, a
 13632	8617	87				    add a, a                    ; Y * 32
 13633	8618	80				    add a, b
 13634	8619	5F				    ld e, a
 13635	861A	16	00			    ld d, 0
 13636	861C	21	00	18		    ld hl, NAMETBL
 13637	861F	19				    add hl, de
