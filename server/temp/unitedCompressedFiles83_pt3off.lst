 1849	4250	D0				    ret nc                      ; Return if slot >= 8
 1850	4251					
 1851	4251					    ; Calculate offset in table: slot * 2
 1852	4251	87				    add a, a                    ; A = slot * 2
 1853	4252	5F				    ld e, a
 1854	4253	16	00			    ld d, 0
 1855	4255	01	2E	D1		    ld bc, task_table
 1856	4258	EB				    ex de, hl                   ; HL = offset, DE = task address
 1857	4259	09				    add hl, bc                  ; HL = task_table + offset
 1858	425A					
 1859	425A					    ; Write task address
 1860	425A	EB				    ex de, hl                   ; HL = task address, DE = slot location
 1861	425B	7D				    ld a, l
 1862	425C	12				    ld (de), a                  ; Write low byte
 1863	425D	13				    inc de
 1864	425E	7C				    ld a, h
 1865	425F	12				    ld (de), a                  ; Write high byte
 1866	4260					
 1867	4260	C9				    ret
