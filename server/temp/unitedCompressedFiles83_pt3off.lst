 18471	9A2B					
 18472	9A2B					    ; Enter game loop
 18473	9A2B	CD	E8	9F		    call gameflow_world_game_loop
 18474	9A2E					
 18475	9A2E					    ; Exited loop - continue to next node
 18476	9A2E	C1				    pop bc          ; Restore connection table
 18477	9A2F	CD	BB	9F		    call gameflow_get_default_connection
 18478	9A32	7C				    ld a, h
