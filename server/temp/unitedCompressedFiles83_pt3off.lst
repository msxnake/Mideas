 8289	5C58	21	A6	A7		    ld hl, SPRITE_7_PATTERN
 8290	5C5B	11	00	38		    ld de, SPRPAT + (0 * 32)
 8291	5C5E	01	40	00		    ld bc, 64 ; Load 2 layers (32 bytes each)
 8292	5C61	CD	55	AB		    call COPY_SPRITE_SRC_TO_VRAM
