 11195	700A					; ------------------------------------------------------------------
 11196	700A					; hud_print_string
 11197	700A					; Print a null-terminated string to Screen 2 Name Table
 11198	700A					; Input: HL = VRAM address, DE = String pointer (RAM)
 11199	700A					; ------------------------------------------------------------------
 11200	700A					hud_print_string:
 11201	700A	F5				    push af
 11202	700B	C5				    push bc
 11203	700C	D5				    push de
 11204	700D	E5				    push hl
 11205	700E					
 11206	700E					.print_loop:
 11207	700E	1A				    ld a, (de)                  ; Get character from string
 11208	700F	B7				    or a                        ; Check for null terminator
 11209	7010	28	0F			    jr z, .print_done
 11210	7012					
 11211	7012					    ; OPTIMIZED: Inline ASCII validation (saves CALL/RET overhead = 27 cycles)
 11212	7012	FE	20			    cp 32                       ; Check if >= 32 (printable ASCII)
 11213	7014	30	02			    jr nc, .valid_char          ; If valid, skip to write
 11214	7016	3E	20			    ld a, 32                    ; Replace control chars with space
 11215	7018					.valid_char:
 11216	7018					
 11217	7018					    ; Write tile to VRAM Name Table
 11218	7018					    ; WRTVRM signature: A = data, HL = VRAM address
 11219	7018					    ; A already has character, HL already has VRAM address
 11220	7018	D5				    push de                     ; Save string pointer
 11221	7019	CD	CE	40		    call FAST_WRTVRM            ; Write A to VRAM at HL
 11222	701C	D1				    pop de                      ; Restore string pointer
 11223	701D					
 11224	701D					    ; Move to next character
 11225	701D	13				    inc de                      ; Next char in string
 11226	701E	23				    inc hl                      ; Next VRAM position
 11227	701F					
 11228	701F	18	ED			    jr .print_loop
 11229	7021					
 11230	7021					.print_done:
 11231	7021	E1				    pop hl
 11232	7022	D1				    pop de
 11233	7023	C1				    pop bc
 11234	7024	F1				    pop af
 11235	7025	C9				    ret
