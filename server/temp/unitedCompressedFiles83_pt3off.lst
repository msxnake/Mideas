 11237	7026					; ------------------------------------------------------------------
 11238	7026					; hud_ascii_to_tile
 11239	7026					; Convert ASCII character to tile index for font rendering
 11240	7026					; Input: A = ASCII character
 11241	7026					; Output: A = Tile index (ASCII code for direct mapping)
 11242	7026					; ------------------------------------------------------------------
 11243	7026					hud_ascii_to_tile:
 11244	7026					    ; SIMPLIFIED: Just return the ASCII code directly
 11245	7026					    ; Font patterns are loaded at their ASCII positions
 11246	7026					    
 11247	7026					    ; Validate range (printable ASCII 32-126)
 11248	7026	FE	20			    cp 32
 11249	7028	D0				    ret nc              ; If >= 32, it's valid - return as-is
 11250	7029					    
 11251	7029					    ; Below 32 (control characters) - default to space
 11252	7029	3E	20			    ld a, 32            ; Space character
 11253	702B	C9				    ret
 11254	702C					
 11255	702C					; ------------------------------------------------------------------
 11256	702C					; hud_draw_frame
 11257	702C					; Draw a rectangular frame using font characters
 11258	702C					; Input: D = Tile X, E = Tile Y, B = Width (tiles), C = Height (tiles)
 11259	702C					; Uses characters: 43 (+), 45 (-), 124 (|)
 11260	702C					; ------------------------------------------------------------------
 11261	702C					hud_draw_frame:
 11262	702C	F5				    push af
 11263	702D	C5				    push bc
 11264	702E	D5				    push de
 11265	702F	E5				    push hl
 11266	7030					    
 11267	7030					    ; Calculate VRAM Start Address
 11268	7030					    ; Addr = #1800 + (E * 32) + D
 11269	7030	6B				    ld l, e
 11270	7031	26	00			    ld h, 0
 11271	7033	29				    add hl, hl          ; * 2
 11272	7034	29				    add hl, hl          ; * 4
 11273	7035	29				    add hl, hl          ; * 8
 11274	7036	29				    add hl, hl          ; * 16
 11275	7037	29				    add hl, hl          ; * 32
 11276	7038					    
 11277	7038	5A				    ld e, d
 11278	7039	16	00			    ld d, 0
 11279	703B	19				    add hl, de
 11280	703C	11	00	18		    ld de, #1800
 11281	703F	19				    add hl, de          ; HL = Top-Left Corner VRAM Address
 11282	7040					    
 11283	7040					    ; Draw Top Row
 11284	7040	E5				    push hl             ; Save Start Address
 11285	7041	C5				    push bc             ; Save Dimensions
 11286	7042					    
 11287	7042					    ; Top-Left Corner
 11288	7042	3E	2B			    ld a, 43            ; '+'
 11289	7044	CD	CE	40		    call FAST_WRTVRM
 11290	7047	23				    inc hl
 11291	7048					    
 11292	7048					    ; Top Edge
 11293	7048	78				    ld a, b
 11294	7049	D6	02			    sub 2               ; Width - 2 corners
 11295	704B	28	0B			    jr z, .skip_top_edge ; Skip if exactly 2 wide (no edge)
 11296	704D	38	09			    jr c, .skip_top_edge ; Skip if < 2 wide
 11297	704F	47				    ld b, a
 11298	7050					.top_edge_loop:
 11299	7050	3E	2D			    ld a, 45            ; '-'
 11300	7052	CD	CE	40		    call FAST_WRTVRM
 11301	7055	23				    inc hl
 11302	7056	10	F8			    djnz .top_edge_loop
 11303	7058					.skip_top_edge:
 11304	7058					    
 11305	7058					    ; Top-Right Corner
 11306	7058	3E	2B			    ld a, 43            ; '+'
 11307	705A	CD	CE	40		    call FAST_WRTVRM
 11308	705D					    
 11309	705D	C1				    pop bc              ; Restore Dimensions
 11310	705E	E1				    pop hl              ; Restore Start Address
 11311	705F					    
 11312	705F					    ; Move to next row
 11313	705F	11	20	00		    ld de, 32
 11314	7062	19				    add hl, de
 11315	7063					    
 11316	7063					    ; Draw Middle Rows (Vertical Edges)
 11317	7063	79				    ld a, c
 11318	7064	D6	02			    sub 2               ; Height - 2 rows
 11319	7066	28	1E			    jr z, .bottom_row   ; Skip if height is small
 11320	7068	38	1C			    jr c, .bottom_row   ; Skip if height is < 2
 11321	706A	4F				    ld c, a             ; C = Middle Rows count
 11322	706B					    
 11323	706B					.middle_row_loop:
 11324	706B	E5				    push hl             ; Save Row Start
 11325	706C	C5				    push bc             ; Save Counters
 11326	706D					    
 11327	706D					    ; Left Edge
 11328	706D	3E	7C			    ld a, 124           ; '|'
 11329	706F	CD	CE	40		    call FAST_WRTVRM
 11330	7072					    
 11331	7072					    ; Skip Middle (Content Area)
 11332	7072	78				    ld a, b
 11333	7073	3D				    dec a               ; Width - 1
 11334	7074					    ; Ensure we don't add negative offset if width is 0 (unlikely here but safe)
 11335	7074					    ; Actually Width must be at least 2 to have corners, so Width-1 >= 1.
 11336	7074	5F				    ld e, a
 11337	7075	16	00			    ld d, 0
 11338	7077	19				    add hl, de
 11339	7078					    
 11340	7078					    ; Right Edge
 11341	7078	3E	7C			    ld a, 124           ; '|'
 11342	707A	CD	CE	40		    call FAST_WRTVRM
 11343	707D					    
 11344	707D	C1				    pop bc              ; Restore Counters
 11345	707E	E1				    pop hl              ; Restore Row Start
 11346	707F					    
 11347	707F	11	20	00		    ld de, 32
 11348	7082	19				    add hl, de          ; Next Row
 11349	7083	0D				    dec c
 11350	7084	20	E5			    jr nz, .middle_row_loop
 11351	7086					    
 11352	7086					.bottom_row:
 11353	7086					    ; Draw Bottom Row
 11354	7086					    ; Bottom-Left Corner
 11355	7086	3E	2B			    ld a, 43            ; '+'
 11356	7088	CD	CE	40		    call FAST_WRTVRM
 11357	708B	23				    inc hl
 11358	708C					    
 11359	708C					    ; Bottom Edge
 11360	708C	78				    ld a, b
 11361	708D	D6	02			    sub 2               ; Width - 2 corners
 11362	708F	28	0B			    jr z, .skip_bottom_edge
 11363	7091	38	09			    jr c, .skip_bottom_edge
 11364	7093	47				    ld b, a
 11365	7094					.bottom_edge_loop:
 11366	7094	3E	2D			    ld a, 45            ; '-'
 11367	7096	CD	CE	40		    call FAST_WRTVRM
 11368	7099	23				    inc hl
 11369	709A	10	F8			    djnz .bottom_edge_loop
 11370	709C					.skip_bottom_edge:
 11371	709C					    
 11372	709C					    ; Bottom-Right Corner
 11373	709C	3E	2B			    ld a, 43            ; '+'
 11374	709E	CD	CE	40		    call FAST_WRTVRM
 11375	70A1					    
 11376	70A1	E1				    pop hl
 11377	70A2	D1				    pop de
 11378	70A3	C1				    pop bc
 11379	70A4	F1				    pop af
