 12198	8153					init_scroll_system:
 12199	8153					    ; Initialize camera to (0, 0)
 12200	8153	AF				    xor a
 12201	8154	32	29	C6		    ld (camera_x), a
 12202	8157	32	2A	C6		    ld (camera_x + 1), a
