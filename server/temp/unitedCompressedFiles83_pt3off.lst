 18481	9A35	C3	B7	99		    jp gameflow_execute_node
 18482	9A38					
 18483	9A38					gameflow_handle_end:
 18484	9A38					    ; End node - stop execution and show end screen
 18485	9A38					    ; DE = end screen data pointer (screen type, message pointer)
 18486	9A38					    ; BC = connection table (unused, end stops execution)
 18487	9A38					
 18488	9A38	D5				    push de
 18489	9A39					
 18490	9A39					    ; Get end screen type from data
 18491	9A39	1A				    ld a, (de)                    ; A = screen type (0=victory, 1=defeat, 2=credits, etc.)
 18492	9A3A	F5				    push af                       ; Save screen type
