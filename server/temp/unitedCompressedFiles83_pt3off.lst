 12224	8175					; ------------------------------------------------------------------
 12225	8175					; set_camera_position
 12226	8175					; Set camera position in pixels (with bounds checking)
 12227	8175					; Input:  HL = X position (pixels), DE = Y position (pixels)
 12228	8175					; Destroys: AF, BC
 12229	8175					; ------------------------------------------------------------------
 12230	8175					set_camera_position:
 12231	8175					    ; Bounds check X
 12232	8175	E5				    push hl
 12233	8176	D5				    push de
 12234	8177					
 12235	8177					    ; Calculate max X = (world_width_tiles - SCREEN_WIDTH_TILES) * TILE_WIDTH
 12236	8177	3A	2F	C6		    ld a, (world_width_tiles)
 12237	817A	D6	20			    sub SCREEN_WIDTH_TILES
 12238	817C	38	1A			    jr c, .scroll_x_in_bounds   ; World smaller than screen
 12239	817E					
 12240	817E					    ; A = tiles to scroll, multiply by tile width
 12241	817E	47				    ld b, a
 12242	817F	3E	10			    ld a, 16
 12243	8181	CD	5D	82		    call multiply_a_by_b        ; HL = max X
 12244	8184					
 12245	8184					    ; Compare camera X with max X
 12246	8184	D1				    pop de
 12247	8185	C1				    pop bc                      ; BC = requested X
 12248	8186	C5				    push bc
 12249	8187	D5				    push de
 12250	8188					
 12251	8188					    ; If requested X > max X, clamp to max X
 12252	8188	78				    ld a, b
 12253	8189	BC				    cp h
 12254	818A	38	08			    jr c, .scroll_x_clamped
 12255	818C	20	0A			    jr nz, .scroll_x_in_bounds
 12256	818E	79				    ld a, c
 12257	818F	BD				    cp l
 12258	8190	38	02			    jr c, .scroll_x_clamped
 12259	8192	18	04			    jr .scroll_x_in_bounds
 12260	8194					
 12261	8194					.scroll_x_clamped:
 12262	8194	44				    ld b, h
 12263	8195	4D				    ld c, l
 12264	8196	18	04			    jr .scroll_x_done
 12265	8198					
 12266	8198					.scroll_x_in_bounds:
 12267	8198	D1				    pop de
 12268	8199	C1				    pop bc
 12269	819A	C5				    push bc
 12270	819B	D5				    push de
 12271	819C					
 12272	819C					.scroll_x_done:
