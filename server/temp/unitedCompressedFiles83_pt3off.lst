 19451	9E0D	CD	19	5A		    call load_colors_to_vram
 19452	9E10					    ; 2. Font patterns + colors (chars 0-127) ??? also zeroed by color-table effects.
 19453	9E10					    ;    init_font_system reloads both pattern bytes and color attributes for all
 19454	9E10					    ;    font characters.  If no font is used in the project this is a no-op (ret).
 19455	9E10	CD	C3	6E		    call init_font_system
 19456	9E13	C1				    pop bc                        ; Restore connection table AFTER VRAM restore
