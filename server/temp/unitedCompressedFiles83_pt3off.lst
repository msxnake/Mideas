 18461	9A18					    ; Bootstrap HUD only on screens that actually use HUD
 18462	9A18	3A	C2	CB		    ld a, (current_screen_id)
 18463	9A1B	FE	00			    cp 0
 18464	9A1D	CA	23	9A		    jp z, .gf_worldlink_hud_do
 18465	9A20	C3	2B	9A		    jp .gf_worldlink_hud_skip
 18466	9A23					.gf_worldlink_hud_do:
 18467	9A23	3E	01			    ld a, 1
 18468	9A25	32	32	C6		    ld (hud_dirty_flag), a
