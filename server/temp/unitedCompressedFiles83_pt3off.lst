 6981	56F5					; ==================================================================
 6982	56F5					; TILE COLLISION SYSTEM
 6983	56F5					; ==================================================================
 6984	56F5					; Provides functions for checking collision with background tiles
 6985	56F5					; Uses behavior maps generated from screen collision layers
 6986	56F5					; ==================================================================
 6987	56F5					
 6988	56F5					; ------------------------------------------------------------------
 6989	56F5					; get_tile_at_position
 6990	56F5					; Convert pixel coordinates to tile coordinates and get tile ID
 6991	56F5					; Input:  D = X position (pixels), E = Y position (pixels)
 6992	56F5					; Output: A = Tile ID at that position, Z flag set if out of bounds
 6993	56F5					; Destroys: BC, HL
 6994	56F5					; ------------------------------------------------------------------
 6995	56F5					get_tile_at_position:
 6996	56F5					    ; Convert X pixel to tile column (divide by 8 - MSX Screen 2 character cell)
 6997	56F5					    ; Screen layout is ALWAYS 32x24 grid of 8x8 cells regardless of project tile size
 6998	56F5	7A				    ld a, d
 6999	56F6	CB	3F			    srl a
 7000	56F8	CB	3F			    srl a
 7001	56FA	CB	3F			    srl a                         ; A = X / 8 = tile column
 7002	56FC	47				    ld b, a                       ; B = tile column
 7003	56FD					
 7004	56FD					    ; Convert Y pixel to tile row (divide by 8 - MSX Screen 2 character cell)
 7005	56FD	7B				    ld a, e
 7006	56FE	CB	3F			    srl a
 7007	5700	CB	3F			    srl a
 7008	5702	CB	3F			    srl a                         ; A = Y / 8 = tile row
 7009	5704	4F				    ld c, a                       ; C = tile row
 7010	5705					
 7011	5705					    ; Check bounds (assume 32x24 tile screen for now)
 7012	5705	78				    ld a, b
 7013	5706	FE	20			    cp 32
 7014	5708	30	27			    jr nc, .out_of_bounds
 7015	570A	79				    ld a, c
 7016	570B	FE	18			    cp 24
 7017	570D	30	22			    jr nc, .out_of_bounds
 7018	570F					
 7019	570F					    ; Calculate tile index: index = row * 32 + column (16-bit to avoid overflow)
 7020	570F	69				    ld l, c
 7021	5710	26	00			    ld h, 0                       ; HL = row (16-bit)
 7022	5712	29				    add hl, hl                    ; HL = row * 2
 7023	5713	29				    add hl, hl                    ; HL = row * 4
 7024	5714	29				    add hl, hl                    ; HL = row * 8
 7025	5715	29				    add hl, hl                    ; HL = row * 16
 7026	5716	29				    add hl, hl                    ; HL = row * 32
 7027	5717	58				    ld e, b
 7028	5718	16	00			    ld d, 0
 7029	571A	19				    add hl, de                    ; HL = row * 32 + column
 7030	571B					
 7031	571B					    ; Read actual tile from current screen layout
 7032	571B	ED	5B	1E	C0	    ld de, (current_screen_layout) ; DE = pointer to screen layout data
 7033	571F	19				    add hl, de                    ; HL = pointer to tile at position
 7034	5720	CD	76	41		    call mapper_push_p2
 7035	5723	3A	20	C0		    ld a, (current_screen_layout_bank)
 7036	5726	CD	5D	41		    call mapper_set_bank_p2
 7037	5729	7E				    ld a, (hl)                    ; A = tile ID from screen map
 7038	572A	F5				    push af
 7039	572B	CD	7D	41		    call mapper_pop_p2
 7040	572E	F1				    pop af
 7041	572F					
 7042	572F	B7				    or a                          ; Set flags based on tile ID
 7043	5730	C9				    ret                           ; Z flag set if tile == 0 (empty)
