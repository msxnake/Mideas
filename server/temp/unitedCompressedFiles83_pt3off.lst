 6460	5535					; ------------------------------------------------------------------
 6461	5535					; apply_collected_tiles
 6462	5535					; Re-clears tiles that were previously collected on the current world/screen.
 6463	5535					; Called after every screen load so collected tiles do not respawn.
 6464	5535					; Input:  current_world_id and current_screen_id must already be set.
 6465	5535					; Output: None
 6466	5535					; Destroys: AF, BC, DE, HL
 6467	5535					; ------------------------------------------------------------------
 6468	5535					apply_collected_tiles:
 6469	5535	3A	D0	CB		    ld a, (collected_count)
 6470	5538	B7				    or a
 6471	5539	C8				    ret z                          ; Nothing collected yet - return early
 6472	553A					
 6473	553A	47				    ld b, a                        ; B = djnz counter (total collected entries)
 6474	553B	0E	00			    ld c, 0                        ; C = loop index
 6475	553D					.apply_ct_loop:
 6476	553D					    ; DE = (0, index) used for all three table lookups.
 6477	553D					    ; add hl, de does NOT modify DE, so we can reuse it for all 3 tables.
 6478	553D	16	00			    ld d, 0
 6479	553F	59				    ld e, c                        ; DE = (0, current index)
 6480	5540					
 6481	5540					    ; Check if this entry belongs to current world
 6482	5540	21	D1	CB		    ld hl, collected_world
 6483	5543	19				    add hl, de                     ; HL = &collected_world[index]
 6484	5544	3A	C5	CB		    ld a, (current_world_id)       ; A = world currently loaded
 6485	5547	BE				    cp (hl)                        ; Compare with stored world ID
 6486	5548	20	2A			    jr nz, .apply_ct_skip          ; Different world - skip
 6487	554A					
 6488	554A					    ; Check if this entry belongs to current screen
 6489	554A	21	11	CC		    ld hl, collected_screen
 6490	554D	19				    add hl, de                     ; HL = &collected_screen[index]
 6491	554E	3A	C2	CB		    ld a, (current_screen_id)      ; A = screen currently loaded
 6492	5551	BE				    cp (hl)                        ; Compare with stored screen ID
 6493	5552	20	20			    jr nz, .apply_ct_skip          ; Different screen - skip
 6494	5554					
 6495	5554					    ; Entry matches current screen: re-clear this tile
 6496	5554	C5				    push bc                        ; Save B=count, C=index across FAST_WRTVRM
 6497	5555					
 6498	5555					    ; Build tile index: D = idx_h, E = idx_l
 6499	5555					    ; (DE is still (0, index) because add hl, de never modifies DE)
 6500	5555	21	51	CC		    ld hl, collected_idx_l
 6501	5558	19				    add hl, de                     ; HL = &collected_idx_l[index]
 6502	5559	7E				    ld a, (hl)
 6503	555A	F5				    push af                        ; Save idx_l on stack
 6504	555B					
 6505	555B	21	91	CC		    ld hl, collected_idx_h
 6506	555E	19				    add hl, de                     ; HL = &collected_idx_h[index], DE still (0, index)
 6507	555F	7E				    ld a, (hl)
 6508	5560	57				    ld d, a                        ; D = idx_h
 6509	5561					
 6510	5561	F1				    pop af                         ; A = idx_l
 6511	5562	5F				    ld e, a                        ; E = idx_l
 6512	5563					    ; DE = tile index (D=high, E=low)
 6513	5563					
 6514	5563					    ; Re-clear runtime_behavior_map[idx]
 6515	5563	D5				    push de                        ; Save idx
 6516	5564	21	29	C3		    ld hl, runtime_behavior_map
