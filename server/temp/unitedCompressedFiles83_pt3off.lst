 6823	5678					;   Outputs:
 6824	5678					;     - active_entity_list rebuilt if needed
 6825	5678					;   Clobbers:
 6826	5678					;     - AF
 6827	5678					;   Preserved:
 6828	5678					;     - BC
 6829	5678					;     - DE
 6830	5678					;     - HL (except nested call clobbers when rebuild happens)
 6831	5678					;   Register roles:
 6832	5678					;     - A = dirty flag test and branch
 6833	5678					;   Notes:
 6834	5678					;     - If dirty, downstream rebuild_used_entity_list can clobber many registers.
 6835	5678					
 6836	5678					ensure_used_entity_list_current:
 6837	5678	3A	08	D1		    ld a, (active_entity_list_dirty)
 6838	567B	B7				    or a
