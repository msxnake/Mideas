 12834	8378					; TRANSFORM MODE ROUTINES (Z80 runtime bit/row transforms)
 12835	8378					; ==================================================================
 12836	8378					
 12837	8378					; ------------------------------------------------------------------
 12838	8378					; Routine: update_animated_transform_tiles_vram
 12839	8378					; Purpose:
 12840	8378					;   Applies Z80 transform operations directly on tile bytes in VRAM.
 12841	8378					; Input:
 12842	8378					;   None
 12843	8378					; Output:
 12844	8378					;   None
 12845	8378					; Modifies:
 12846	8378					;   AF, BC, DE, HL
 12847	8378					; Preserves:
 12848	8378					;   IX, IY, SP
 12849	8378					; Flags:
 12850	8378					;   Not preserved
 12851	8378					; Stack:
 12852	8378					;   Uses PUSH/POP HL, BC and DE internally
 12853	8378					; ------------------------------------------------------------------
 12854	8378					update_animated_transform_tiles_vram:
 12855	8378	21	9D	84		    ld hl, anim_transform_table
 12856	837B					
 12857	837B					.anim_transform_loop:
 12858	837B	7E				    ld a, (hl)                      ; A = target char code
 12859	837C	FE	FF			    cp 255
 12860	837E	C8				    ret z
 12861	837F					
 12862	837F	4F				    ld c, a                         ; C = first char code
 12863	8380	23				    inc hl
 12864	8381	46				    ld b, (hl)                      ; B = chars per tile
 12865	8382	23				    inc hl
 12866	8383	56				    ld d, (hl)                      ; D = operation code
 12867	8384	23				    inc hl
 12868	8385	7E				    ld a, (hl)                      ; A = flags
 12869	8386	32	36	C6		    ld (anim_tile_transform_flags), a
 12870	8389	23				    inc hl                          ; HL = next table entry
 12871	838A	E5				    push hl
 12872	838B					
 12873	838B					.anim_transform_char_loop:
 12874	838B	78				    ld a, b
 12875	838C	B7				    or a
 12876	838D	28	0C			    jr z, .anim_transform_next
 12877	838F					
 12878	838F	C5				    push bc
 12879	8390	D5				    push de
 12880	8391	79				    ld a, c
 12881	8392	CD	9E	83		    call anim_transform_char_frame
 12882	8395	D1				    pop de
 12883	8396	C1				    pop bc
 12884	8397					
 12885	8397	0C				    inc c
 12886	8398	05				    dec b
 12887	8399	18	F0			    jr .anim_transform_char_loop
 12888	839B					
 12889	839B					.anim_transform_next:
 12890	839B	E1				    pop hl
 12891	839C	18	DD			    jr .anim_transform_loop
 12892	839E					
 12893	839E					; ------------------------------------------------------------------
 12894	839E					; Routine: anim_transform_char_frame
 12895	839E					; Purpose:
 12896	839E					;   Transform one character pattern in all SCREEN 2 banks.
 12897	839E					; Input:
 12898	839E					;   A = character code
 12899	839E					;   D = transform operation code
 12900	839E					;   (anim_tile_transform_flags).bit0 = transform color rows too
 12901	839E					; Output:
 12902	839E					;   None
 12903	839E					; Modifies:
 12904	839E					;   AF, BC, DE, HL
 12905	839E					; Preserves:
 12906	839E					;   IX, IY, SP
 12907	839E					; Flags:
 12908	839E					;   Not preserved
 12909	839E					; Stack:
 12910	839E					;   Pushes/pops BC, DE and HL
 12911	839E					; ------------------------------------------------------------------
 12912	839E					anim_transform_char_frame:
 12913	839E	C5				    push bc
 12914	839F	D5				    push de
 12915	83A0	E5				    push hl
 12916	83A1					
 12917	83A1					    ; BC = charCode * 8 (row offset in pattern/color tables)
 12918	83A1	6F				    ld l, a
 12919	83A2	26	00			    ld h, 0
 12920	83A4	29				    add hl, hl
 12921	83A5	29				    add hl, hl
 12922	83A6	29				    add hl, hl
 12923	83A7	44				    ld b, h
 12924	83A8	4D				    ld c, l
 12925	83A9					
 12926	83A9					    ; Pattern bank 0
 12927	83A9	C5				    push bc
 12928	83AA	D5				    push de
 12929	83AB	21	00	00		    ld hl, CHRTBL2
 12930	83AE	09				    add hl, bc
 12931	83AF	CD	FB	83		    call anim_transform_vram_block
 12932	83B2	D1				    pop de
 12933	83B3	C1				    pop bc
 12934	83B4					
 12935	83B4					    ; Pattern bank 1
 12936	83B4	C5				    push bc
 12937	83B5	D5				    push de
 12938	83B6	21	00	08		    ld hl, CHRTBL2 + #800
 12939	83B9	09				    add hl, bc
 12940	83BA	CD	FB	83		    call anim_transform_vram_block
 12941	83BD	D1				    pop de
 12942	83BE	C1				    pop bc
 12943	83BF					
 12944	83BF					    ; Pattern bank 2
 12945	83BF	C5				    push bc
 12946	83C0	D5				    push de
 12947	83C1	21	00	10		    ld hl, CHRTBL2 + #1000
 12948	83C4	09				    add hl, bc
 12949	83C5	CD	FB	83		    call anim_transform_vram_block
 12950	83C8	D1				    pop de
 12951	83C9	C1				    pop bc
 12952	83CA					
 12953	83CA					    ; Color transforms only for vertical row operations (5..7) and if enabled
 12954	83CA	7A				    ld a, d
 12955	83CB	FE	05			    cp 5
 12956	83CD	38	28			    jr c, .anim_transform_char_done
 12957	83CF					
 12958	83CF	3A	36	C6		    ld a, (anim_tile_transform_flags)
 12959	83D2	E6	01			    and 1
 12960	83D4	28	21			    jr z, .anim_transform_char_done
 12961	83D6					
 12962	83D6					    ; Color bank 0
 12963	83D6	C5				    push bc
 12964	83D7	D5				    push de
 12965	83D8	21	00	20		    ld hl, CLRTBL2
 12966	83DB	09				    add hl, bc
 12967	83DC	CD	FB	83		    call anim_transform_vram_block
 12968	83DF	D1				    pop de
 12969	83E0	C1				    pop bc
 12970	83E1					
 12971	83E1					    ; Color bank 1
 12972	83E1	C5				    push bc
 12973	83E2	D5				    push de
 12974	83E3	21	00	28		    ld hl, CLRTBL2 + #800
 12975	83E6	09				    add hl, bc
 12976	83E7	CD	FB	83		    call anim_transform_vram_block
 12977	83EA	D1				    pop de
 12978	83EB	C1				    pop bc
 12979	83EC					
 12980	83EC					    ; Color bank 2
 12981	83EC	C5				    push bc
 12982	83ED	D5				    push de
 12983	83EE	21	00	30		    ld hl, CLRTBL2 + #1000
 12984	83F1	09				    add hl, bc
 12985	83F2	CD	FB	83		    call anim_transform_vram_block
 12986	83F5	D1				    pop de
 12987	83F6	C1				    pop bc
 12988	83F7					
 12989	83F7					.anim_transform_char_done:
 12990	83F7	E1				    pop hl
 12991	83F8	D1				    pop de
 12992	83F9	C1				    pop bc
 12993	83FA	C9				    ret
 12994	83FB					
 12995	83FB					; ------------------------------------------------------------------
 12996	83FB					; Routine: anim_transform_vram_block
 12997	83FB					; Purpose:
 12998	83FB					;   Apply transform to one 8-byte VRAM block (one char rows table).
 12999	83FB					; Input:
 13000	83FB					;   HL = VRAM base address for row 0 (8 consecutive bytes)
 13001	83FB					;   D  = operation code:
 13002	83FB					;        1 rotate_left  (RLCA)
 13003	83FB					;        2 rotate_right (RRCA)
 13004	83FB					;        3 shift_left   (SLA)
 13005	83FB					;        4 shift_right  (SRL)
 13006	83FB					;        5 shift_up rows
 13007	83FB					;        6 shift_down rows
 13008	83FB					;        7 swap top/bottom row
 13009	83FB					; Output:
 13010	83FB					;   None
 13011	83FB					; Modifies:
 13012	83FB					;   AF, BC, DE, HL
 13013	83FB					; Preserves:
 13014	83FB					;   IX, IY, SP
 13015	83FB					; Flags:
 13016	83FB					;   Not preserved
 13017	83FB					; Stack:
 13018	83FB					;   Uses stack while reading row bytes
 13019	83FB					; ------------------------------------------------------------------
 13020	83FB					anim_transform_vram_block:
 13021	83FB	7A				    ld a, d
 13022	83FC	FE	05			    cp 5
 13023	83FE	30	2C			    jr nc, .anim_transform_vertical
 13024	8400					
 13025	8400					    ; Horizontal bit transforms (operate row by row)
 13026	8400	06	08			    ld b, 8
 13027	8402					.anim_transform_horizontal_loop:
 13028	8402	E5				    push hl
 13029	8403	CD	E8	40		    call FAST_RDVRM                 ; A = row byte from VRAM[HL]
 13030	8406	E1				    pop hl
 13031	8407					
 13032	8407	5F				    ld e, a
 13033	8408	7A				    ld a, d
 13034	8409	FE	01			    cp 1
 13035	840B	20	04			    jr nz, .anim_not_rl
 13036	840D	7B				    ld a, e
 13037	840E	07				    rlca
 13038	840F	18	14			    jr .anim_write_row
 13039	8411					.anim_not_rl:
 13040	8411	FE	02			    cp 2
 13041	8413	20	04			    jr nz, .anim_not_rr
 13042	8415	7B				    ld a, e
 13043	8416	0F				    rrca
 13044	8417	18	0C			    jr .anim_write_row
 13045	8419					.anim_not_rr:
 13046	8419	FE	03			    cp 3
 13047	841B	20	05			    jr nz, .anim_not_sla
 13048	841D	7B				    ld a, e
 13049	841E	CB	27			    sla a
 13050	8420	18	03			    jr .anim_write_row
 13051	8422					.anim_not_sla:
 13052	8422	7B				    ld a, e
 13053	8423	CB	3F			    srl a
 13054	8425					
 13055	8425					.anim_write_row:
 13056	8425	CD	CE	40		    call FAST_WRTVRM
 13057	8428	23				    inc hl
 13058	8429	10	D7			    djnz .anim_transform_horizontal_loop
 13059	842B	C9				    ret
 13060	842C					
 13061	842C					.anim_transform_vertical:
 13062	842C	D5				    push de                        ; Preserve D=operation code (DE reused as pointers)
 13063	842D					    ; Read current 8 row bytes into temporary RAM buffer
 13064	842D	11	38	C6		    ld de, anim_tile_row_buffer
 13065	8430	06	08			    ld b, 8
 13066	8432					.anim_read_rows_loop:
 13067	8432	E5				    push hl
 13068	8433	CD	E8	40		    call FAST_RDVRM                 ; A = row byte
 13069	8436	E1				    pop hl
 13070	8437	12				    ld (de), a
 13071	8438	13				    inc de
 13072	8439	23				    inc hl
 13073	843A	10	F6			    djnz .anim_read_rows_loop
 13074	843C					
 13075	843C					    ; Restore HL to start of block (HL -= 8)
 13076	843C	11	F8	FF		    ld de, #FFF8
 13077	843F	19				    add hl, de
 13078	8440	D1				    pop de                         ; Restore original operation code in D
 13079	8441					
 13080	8441	7A				    ld a, d
 13081	8442	FE	05			    cp 5
 13082	8444	20	14			    jr nz, .anim_not_shift_up
 13083	8446					
 13084	8446					    ; shift_up: row0<-row1 ... row6<-row7 row7<-row0
 13085	8446	11	39	C6		    ld de, anim_tile_row_buffer + 1
 13086	8449	06	07			    ld b, 7
 13087	844B					.anim_write_up_loop:
 13088	844B	1A				    ld a, (de)
 13089	844C	CD	CE	40		    call FAST_WRTVRM
 13090	844F	13				    inc de
 13091	8450	23				    inc hl
 13092	8451	10	F8			    djnz .anim_write_up_loop
 13093	8453	3A	38	C6		    ld a, (anim_tile_row_buffer)
 13094	8456	CD	CE	40		    call FAST_WRTVRM
 13095	8459	C9				    ret
 13096	845A					
 13097	845A					.anim_not_shift_up:
 13098	845A	FE	06			    cp 6
 13099	845C	20	15			    jr nz, .anim_not_shift_down
 13100	845E					
 13101	845E					    ; shift_down: row0<-row7 row1<-row0 ... row7<-row6
 13102	845E	3A	3F	C6		    ld a, (anim_tile_row_buffer + 7)
 13103	8461	CD	CE	40		    call FAST_WRTVRM
 13104	8464	23				    inc hl
 13105	8465	11	38	C6		    ld de, anim_tile_row_buffer
 13106	8468	06	07			    ld b, 7
 13107	846A					.anim_write_down_loop:
 13108	846A	1A				    ld a, (de)
 13109	846B	CD	CE	40		    call FAST_WRTVRM
 13110	846E	13				    inc de
 13111	846F	23				    inc hl
 13112	8470	10	F8			    djnz .anim_write_down_loop
 13113	8472	C9				    ret
 13114	8473					
 13115	8473					.anim_not_shift_down:
 13116	8473					    ; swap_top_bottom: row0<->row7, middle rows unchanged
 13117	8473	3A	3F	C6		    ld a, (anim_tile_row_buffer + 7)
 13118	8476	CD	CE	40		    call FAST_WRTVRM
 13119	8479	23				    inc hl
 13120	847A	11	39	C6		    ld de, anim_tile_row_buffer + 1
 13121	847D	06	06			    ld b, 6
 13122	847F					.anim_write_middle_loop:
 13123	847F	1A				    ld a, (de)
 13124	8480	CD	CE	40		    call FAST_WRTVRM
 13125	8483	13				    inc de
 13126	8484	23				    inc hl
 13127	8485	10	F8			    djnz .anim_write_middle_loop
 13128	8487	3A	38	C6		    ld a, (anim_tile_row_buffer)
 13129	848A	CD	CE	40		    call FAST_WRTVRM
 13130	848D	C9				    ret
