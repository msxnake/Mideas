 21288	AB55					; ==================================================================
 21289	AB55					; ZX0 SPRITE COPY HELPER (AUTO-INJECTED)
 21290	AB55					; - If HL points to a compressed sprite frame blob, decompress frame
 21291	AB55					;   to ZX0_SPRITE_FRAME_BUFFER and then upload to VRAM.
 21292	AB55					; - Otherwise copy raw frame data directly to VRAM.
 21293	AB55					; Input: HL=source (ROM), DE=VRAM destination, BC=byte count
 21294	AB55					; ==================================================================
 21295	AB55					COPY_SPRITE_SRC_TO_VRAM:
 21296	AB55	D5				    push de
 21297	AB56					    ; source < ZX0_SPRITE_FRAME_DATA_START => raw copy
 21298	AB56	E5				    push hl
 21299	AB57	11	7A	A5		    ld de, ZX0_SPRITE_FRAME_DATA_START
 21300	AB5A	B7				    or a
 21301	AB5B	ED	52			    sbc hl, de
 21302	AB5D	E1				    pop hl
 21303	AB5E	38	1D			    jr c, COPY_SPRITE_SRC_TO_VRAM_RAW
 21304	AB60					
 21305	AB60					    ; source >= ZX0_SPRITE_FRAME_DATA_END_LABEL => raw copy
 21306	AB60	E5				    push hl
 21307	AB61	11	54	AB		    ld de, ZX0_SPRITE_FRAME_DATA_END_LABEL
 21308	AB64	B7				    or a
 21309	AB65	ED	52			    sbc hl, de
 21310	AB67	E1				    pop hl
 21311	AB68	30	13			    jr nc, COPY_SPRITE_SRC_TO_VRAM_RAW
 21312	AB6A					
 21313	AB6A					    ; Compressed frame: decompress to shared RAM buffer, then upload
 21314	AB6A	D1				    pop de
 21315	AB6B	C5				    push bc
 21316	AB6C	D5				    push de
 21317	AB6D	E5				    push hl
 21318	AB6E	11	00	E0		    ld de, ZX0_SPRITE_FRAME_BUFFER
