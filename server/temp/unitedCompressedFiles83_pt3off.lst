 13198	84EC					; Destroys: BC, DE, HL
 13199	84EC					; ------------------------------------------------------------------
 13200	84EC					get_tile_animation_frame:
 13201	84EC	4F				    ld c, a                         ; C = char code to search
 13202	84ED	21	8E	84		    ld hl, anim_tile_table
 13203	84F0					
 13204	84F0					.anim_search_loop:
 13205	84F0	7E				    ld a, (hl)
 13206	84F1	FE	FF			    cp 255
 13207	84F3	28	16			    jr z, .anim_not_found
 13208	84F5	B9				    cp c
 13209	84F6	28	06			    jr z, .anim_found_tile
 13210	84F8					
 13211	84F8	11	07	00		    ld de, ANIM_TILE_ENTRY_SIZE
 13212	84FB	19				    add hl, de
 13213	84FC	18	F2			    jr .anim_search_loop
 13214	84FE					
 13215	84FE					.anim_found_tile:
 13216	84FE	23				    inc hl
 13217	84FF	23				    inc hl
 13218	8500	46				    ld b, (hl)                      ; B = numFrames
 13219	8501	3A	34	C6		    ld a, (anim_tile_frame)
