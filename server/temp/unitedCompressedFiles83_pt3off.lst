 13326	852A					spawn_particle:
 13327	852A	F5				    push af                     ; Save particle type
 13328	852B	C5				    push bc                     ; Save position
 13329	852C	D5				    push de                     ; Save velocity
 13330	852D					
 13331	852D					    ; Find free particle slot
 13332	852D	CD	5A	85		    call find_free_particle
 13333	8530	28	23			    jr z, .part_spawn_failed    ; Z flag set = no free slots
 13334	8532					
 13335	8532					    ; HL points to free particle structure
 13336	8532	D1				    pop de                      ; Restore velocity
 13337	8533	C1				    pop bc                      ; Restore position
 13338	8534	F1				    pop af                      ; Restore type
 13339	8535					
 13340	8535					    ; Fill particle structure
 13341	8535	77				    ld (hl), a                  ; Offset 0: type
 13342	8536	23				    inc hl
 13343	8537					
 13344	8537					    ; Set lifetime based on type
 13345	8537	E5				    push hl
 13346	8538	CD	6D	85		    call get_particle_lifetime  ; A = type -> A = lifetime
 13347	853B	E1				    pop hl
 13348	853C	77				    ld (hl), a                  ; Offset 1: lifetime
 13349	853D	23				    inc hl
 13350	853E					
 13351	853E	70				    ld (hl), b                  ; Offset 2: X position
 13352	853F	23				    inc hl
