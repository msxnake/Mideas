 2382	4377					entity_shoot_sprite_id  EQU temp_byte_12 ; Projectile sprite ID (32 bytes)
 2383	4377					entity_shoot_speed      EQU temp_byte_13 ; Projectile velocity (32 bytes)
 2384	4377					
 2385	4377					    ; Collision Layer Data (for projectile and advanced collision)
 2386	4377					entity_collision_layer  EQU temp_byte_14 ; Which layer this entity is on (32 bytes)
