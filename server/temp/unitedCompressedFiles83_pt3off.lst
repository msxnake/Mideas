 1817	424E					; ==================================================================
 1818	424E					; ENABLE_TASK - Activate a task in the system
 1819	424E					; ==================================================================
 1820	424E					; Register Contract:
 1821	424E					;   Purpose: Store routine pointer into task_table slot.
 1822	424E					;   Inputs:
 1823	424E					;     - A = task slot (0-7)
 1824	424E					;     - HL = task routine address
 1825	424E					;   Outputs:
 1826	424E					;     - task_table[slot] = HL
 1827	424E					;   Clobbers:
 1828	424E					;     - AF
 1829	424E					;     - BC
 1830	424E					;     - DE
 1831	424E					;     - HL
 1832	424E					;   Preserved:
 1833	424E					;     - None
 1834	424E					;   Register roles:
 1835	424E					;     - A = slot validation and offset math
 1836	424E					;     - DE = holds routine address while HL is repurposed as slot pointer
 1837	424E					;     - BC = task_table base address
 1838	424E					;     - HL = slot address calculation / pointer write
 1839	424E					
 1840	424E					; Inputs:
 1841	424E					;   A = task slot (0-7)
 1842	424E					;   HL = address of task routine
 1843	424E					; Outputs: None
 1844	424E					; Modifies: AF, BC, DE, HL
 1845	424E					; ==================================================================
 1846	424E					enable_task:
 1847	424E					    ; Validate slot (0-7)
