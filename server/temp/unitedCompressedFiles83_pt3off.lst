 19665	9F0E					
 19666	9F0E					; ==================================================================
 19667	9F0E					; trans_clear_pixel_row_colors
 19668	9F0E					; Blackens a single pixel row (1px tall) by setting the color table
 19669	9F0E					; entry for all 256 tile patterns in the appropriate bank to 0x11
 19670	9F0E					; (fg=black, bg=black).  Works at 1-pixel-row granularity unlike
 19671	9F0E					; trans_clear_row_direct which works at 8-pixel (tile-row) granularity.
 19672	9F0E					;
 19673	9F0E					; Screen 2 color table layout:
 19674	9F0E					;   Bank 0 (#2000): tiles used in name-table rows 0-7   (pixel rows 0-63)
 19675	9F0E					;   Bank 1 (#2800): tiles used in name-table rows 8-15  (pixel rows 64-127)
 19676	9F0E					;   Bank 2 (#3000): tiles used in name-table rows 16-23 (pixel rows 128-191)
 19677	9F0E					; Each tile has 8 color bytes; byte J covers pixel sub-row J of that tile.
 19678	9F0E					; Tile T color byte for sub-row J:  bank_base + T*8 + J
 19679	9F0E					;
 19680	9F0E					; Input:  A = pixel row (0-191)
 19681	9F0E					;         bank    = A >> 6   (0-2)
 19682	9F0E					;         sub_row = A & 7    (0-7)
 19683	9F0E					;         color_base = #2000 + bank * #0800
 19684	9F0E					; Preserves: BC, DE, HL
 19685	9F0E					; ==================================================================
 19686	9F0E					trans_clear_pixel_row_colors:
 19687	9F0E	C5				    push bc
 19688	9F0F	D5				    push de
 19689	9F10	E5				    push hl
 19690	9F11					    ; --- Compute sub_row = A & 7 ---
 19691	9F11	6F				    ld l, a                       ; L = pixel row (save)
 19692	9F12	E6	07			    and 7
 19693	9F14	5F				    ld e, a                       ; E = sub_row (0-7)
 19694	9F15					    ; --- Compute bank = A >> 6 (0-2) ---
 19695	9F15	7D				    ld a, l
 19696	9F16	CB	3F			    srl a
 19697	9F18	CB	3F			    srl a
 19698	9F1A	CB	3F			    srl a
 19699	9F1C	CB	3F			    srl a
 19700	9F1E	CB	3F			    srl a
 19701	9F20	CB	3F			    srl a                         ; A = bank (0, 1 or 2)
 19702	9F22					    ; --- Compute H = #20 + bank*8 (color table high byte) ---
 19703	9F22					    ; bank=0 -> H=#20, bank=1 -> H=#28, bank=2 -> H=#30
 19704	9F22	87				    add a, a                      ; bank * 2
 19705	9F23	87				    add a, a                      ; bank * 4
 19706	9F24	87				    add a, a                      ; bank * 8
 19707	9F25	C6	20			    add a, #20
 19708	9F27	67				    ld h, a                       ; H = color table high byte for this bank
 19709	9F28	6B				    ld l, e                       ; L = sub_row  (offset within tile 0 entry)
 19710	9F29					    ; HL now = address of tile-0 color byte for this pixel sub-row
 19711	9F29					    ; --- Write 0x11 (black/black) for all 256 tiles ---
 19712	9F29					    ; Tile addresses: HL, HL+8, HL+16, ... HL+255*8
 19713	9F29					    ; (consecutive tiles are 8 bytes apart in the color table)
 19714	9F29	06	00			    ld b, 0                       ; B=0 ??? djnz executes 256 times
 19715	9F2B					.tpcr_loop:
 19716	9F2B					    ; DI only around the 3 critical VDP port writes.
 19717	9F2B					    ; Keeping DI for the whole loop would leave interrupts disabled for ~6ms
 19718	9F2B					    ; and can cause DI+HALT if trans_wait_frames is reached before EI fires.
 19719	9F2B	F3				    di
 19720	9F2C	7D				    ld a, l
 19721	9F2D	D3	99			    out (#99), a                  ; VRAM address low
 19722	9F2F	7C				    ld a, h
 19723	9F30	F6	40			    or #40
 19724	9F32	D3	99			    out (#99), a                  ; VRAM address high + write mode
