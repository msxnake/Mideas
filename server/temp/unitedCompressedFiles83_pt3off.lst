 13562	85E9					
 13563	85E9					; ------------------------------------------------------------------
 13564	85E9					; draw_particle_tile
 13565	85E9					; Draw particle at its position using its tile ID
 13566	85E9					; Input:  HL = Address of particle structure
 13567	85E9					; Destroys: AF, BC, DE, HL
 13568	85E9					; ------------------------------------------------------------------
 13569	85E9					draw_particle_tile:
 13570	85E9	E5				    push hl
 13571	85EA					
 13572	85EA					    ; Get position (offsets 2, 3)
 13573	85EA	23				    inc hl
 13574	85EB	23				    inc hl
 13575	85EC	46				    ld b, (hl)                  ; B = X tile
 13576	85ED	23				    inc hl
 13577	85EE	4E				    ld c, (hl)                  ; C = Y tile
 13578	85EF					
 13579	85EF					    ; Get tile ID (offset 5)
 13580	85EF	23				    inc hl
 13581	85F0	23				    inc hl
 13582	85F1	7E				    ld a, (hl)                  ; A = tile ID
 13583	85F2					
 13584	85F2					    ; Calculate name table address
 13585	85F2					    ; NAMETBL + (Y * 32) + X
 13586	85F2	F5				    push af                     ; Save tile ID
 13587	85F3	79				    ld a, c
 13588	85F4	87				    add a, a
 13589	85F5	87				    add a, a
 13590	85F6	87				    add a, a
 13591	85F7	87				    add a, a
 13592	85F8	87				    add a, a                    ; Y * 32
 13593	85F9	80				    add a, b                    ; + X
 13594	85FA	5F				    ld e, a
 13595	85FB	16	00			    ld d, 0
 13596	85FD	21	00	18		    ld hl, NAMETBL
 13597	8600	19				    add hl, de                  ; HL = VRAM address
 13598	8601					
 13599	8601					    ; Write tile ID to name table
 13600	8601	F1				    pop af                      ; Restore tile ID
 13601	8602	CD	4D	00		    call WRTVRM
 13602	8605					
 13603	8605					    ; Now update pattern in VRAM
 13604	8605	E1				    pop hl
 13605	8606	E5				    push hl
 13606	8607	CD	26	86		    call update_particle_pattern
 13607	860A					
 13608	860A	E1				    pop hl
 13609	860B	C9				    ret
