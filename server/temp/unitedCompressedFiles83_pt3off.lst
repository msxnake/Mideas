 17871	974B					Condition_VariableCompare:
 17872	974B					    ; Params: VarID (1 byte), Operator (1 byte), Value (1 byte)
 17873	974B					    ; Input: B = Entity Index, HL = Params Ptr
 17874	974B					    ; Output: A = 1 (true) or 0 (false), HL = Updated Ptr
 17875	974B					    ; Supports entity variables (ID 0-5) and global variables (ID 6+)
 17876	974B					
 17877	974B	7E				    ld a, (hl)              ; A = Variable ID
 17878	974C	23				    inc hl
 17879	974D	4E				    ld c, (hl)              ; C = Operator ID
 17880	974E	23				    inc hl
 17881	974F	56				    ld d, (hl)              ; D = Compare Value
 17882	9750	23				    inc hl
 17883	9751					
 17884	9751	E5				    push hl                 ; Save updated params ptr
 17885	9752	C5				    push bc                 ; Save Operator and Entity Index
 17886	9753	D5				    push de                 ; Save Compare Value
 17887	9754					
 17888	9754					    ; Check if VarID < 6 (entity variable) or >= 6 (global variable)
 17889	9754	FE	06			    cp 6
 17890	9756	30	1E			    jr nc, .get_global_var
 17891	9758					
 17892	9758					    ; Entity variables (ID 0-5)
 17893	9758	48				    ld c, b                 ; C = Entity Index
 17894	9759	06	00			    ld b, 0                 ; BC = Entity Index
 17895	975B					
 17896	975B	FE	00			    cp 0                    ; Check if x
 17897	975D	28	2A			    jr z, .get_x
 17898	975F	FE	01			    cp 1                    ; Check if y
 17899	9761	28	2D			    jr z, .get_y
 17900	9763	FE	02			    cp 2                    ; Check if vx
 17901	9765	28	30			    jr z, .get_vx
 17902	9767	FE	03			    cp 3                    ; Check if vy
 17903	9769	28	33			    jr z, .get_vy
 17904	976B	FE	04			    cp 4                    ; Check if isOnGround
 17905	976D	28	36			    jr z, .get_on_ground
 17906	976F					    ; cp 5: health (fall through)
 17907	976F					
