 13710	865C					; ==================================================================
 13711	865C					; PARTICLE PATTERN DATA
 13712	865C					; ==================================================================
 13713	865C					; Each particle type has 4 frames, 8 bytes each = 32 bytes total
 13714	865C					; Frame progression creates animation effect
 13715	865C					
 13716	865C					particle_patterns:
 13717	865C					
 13718	865C					; ---- PARTICLE_NONE (type 0) - Empty ----
 13719	865C	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13720	8664	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13721	866C	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13722	8674	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13723	867C					
 13724	867C					; ---- PARTICLE_EXPLOSION (type 1) - Expands outward ----
 13725	867C					    ; Frame 0: Small dot
 13726	867C	00	00	00	18	18	00	00	00	    db #00, #00, #00, #18, #18, #00, #00, #00
 13727	8684					    ; Frame 1: Expanding
 13728	8684	00	18	3C	7E	7E	3C	18	00	    db #00, #18, #3C, #7E, #7E, #3C, #18, #00
 13729	868C					    ; Frame 2: Large explosion
 13730	868C	18	7E	FF	FF	FF	FF	7E	18	    db #18, #7E, #FF, #FF, #FF, #FF, #7E, #18
 13731	8694					    ; Frame 3: Fading fragments
 13732	8694	81	42	24	18	18	24	42	81	    db #81, #42, #24, #18, #18, #24, #42, #81
 13733	869C					
 13734	869C					; ---- PARTICLE_SMOKE (type 2) - Puff rising ----
 13735	869C					    ; Frame 0: Small puff
 13736	869C	00	00	3C	66	66	3C	00	00	    db #00, #00, #3C, #66, #66, #3C, #00, #00
 13737	86A4					    ; Frame 1: Expanding
 13738	86A4	00	7E	FF	C3	C3	FF	7E	00	    db #00, #7E, #FF, #C3, #C3, #FF, #7E, #00
 13739	86AC					    ; Frame 2: Large cloud
 13740	86AC	7E	FF	E7	C3	C3	E7	FF	7E	    db #7E, #FF, #E7, #C3, #C3, #E7, #FF, #7E
 13741	86B4					    ; Frame 3: Dispersing
 13742	86B4	66	E7	C3	81	81	C3	E7	66	    db #66, #E7, #C3, #81, #81, #C3, #E7, #66
 13743	86BC					
