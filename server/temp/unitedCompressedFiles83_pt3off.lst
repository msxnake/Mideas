 11869	7211					; ==================================================================
 11870	7211					; SOUND EFFECT PLAYBACK SYSTEM
 11871	7211					; ==================================================================
 11872	7211					; This section provides a simple sound effect manager that can
 11873	7211					; play effects with automatic duration and fadeout
 11874	7211					
 11875	7211					; Runtime state lives in variables.asm:
 11876	7211					;   sfx_active, sfx_timer, sfx_fadeout
 11877	7211					
 11878	7211					; ------------------------------------------------------------------
 11879	7211					; play_sound_effect
 11880	7211					; Play one of the built-in sound effects by ID
 11881	7211					; Input:  A = sound ID
 11882	7211					;         0=beep, 1=jump, 2=shoot, 3=explosion, 4=coin, 5=damage
 11883	7211					; Destroys: AF, BC, DE, HL
 11884	7211					; ------------------------------------------------------------------
 11885	7211					play_sound_effect:
 11886	7211	3A	4D	D1		    ld a, (music_active)
 11887	7214	B7				    or a
 11888	7215	C0				    ret nz
 11889	7216	FE	01			    cp 1
 11890	7218	CA	38	72		    jp z, play_sound_effect_jump
 11891	721B	FE	02			    cp 2
 11892	721D	CA	41	72		    jp z, play_sound_effect_shoot
 11893	7220	FE	03			    cp 3
 11894	7222	CA	4A	72		    jp z, play_sound_effect_explosion
 11895	7225	FE	04			    cp 4
 11896	7227	CA	53	72		    jp z, play_sound_effect_coin
 11897	722A	FE	05			    cp 5
 11898	722C	CA	5C	72		    jp z, play_sound_effect_damage
 11899	722F					
 11900	722F					play_sound_effect_beep:
 11901	722F	21	9B	71		    ld hl, sfx_beep
 11902	7232	06	05			    ld b, SFX_SHORT
 11903	7234	CD	65	72		    call sfx_play
 11904	7237	C9				    ret
 11905	7238					
 11906	7238					play_sound_effect_jump:
 11907	7238	21	AE	71		    ld hl, sfx_jump
 11908	723B	06	05			    ld b, SFX_SHORT
 11909	723D	CD	65	72		    call sfx_play
 11910	7240	C9				    ret
 11911	7241					
 11912	7241					play_sound_effect_shoot:
 11913	7241	21	C1	71		    ld hl, sfx_shoot
 11914	7244	06	05			    ld b, SFX_SHORT
 11915	7246	CD	65	72		    call sfx_play
 11916	7249	C9				    ret
 11917	724A					
 11918	724A					play_sound_effect_explosion:
 11919	724A	21	D9	71		    ld hl, sfx_explosion
 11920	724D	06	0F			    ld b, SFX_MEDIUM
 11921	724F	CD	65	72		    call sfx_play
 11922	7252	C9				    ret
 11923	7253					
 11924	7253					play_sound_effect_coin:
 11925	7253	21	EA	71		    ld hl, sfx_coin
 11926	7256	06	05			    ld b, SFX_SHORT
 11927	7258	CD	65	72		    call sfx_play
 11928	725B	C9				    ret
 11929	725C					
 11930	725C					play_sound_effect_damage:
 11931	725C	21	FF	71		    ld hl, sfx_damage
 11932	725F	06	05			    ld b, SFX_SHORT
 11933	7261	CD	65	72		    call sfx_play
 11934	7264	C9				    ret
 11935	7265					
 11936	7265					; ------------------------------------------------------------------
 11937	7265					; sfx_play
 11938	7265					; Play a sound effect with duration
 11939	7265					; Input:  HL = Sound effect function address
 11940	7265					;         B = Duration in frames
 11941	7265					; ------------------------------------------------------------------
 11942	7265					sfx_play:
 11943	7265	3A	4D	D1		    ld a, (music_active)
 11944	7268	B7				    or a
 11945	7269	C0				    ret nz
 11946	726A					    ; Call the sound effect function
 11947	726A	C5				    push bc
 11948	726B	E5				    push hl
 11949	726C	11	71	72		    ld de, .return_address
 11950	726F	D5				    push de
 11951	7270	E9				    jp (hl)                      ; Indirect call
 11952	7271					.return_address:
 11953	7271	E1				    pop hl
 11954	7272	C1				    pop bc
 11955	7273					
 11956	7273					    ; Set timer
 11957	7273	78				    ld a, b
 11958	7274	32	B9	CD		    ld (sfx_timer), a
 11959	7277					
 11960	7277					    ; Mark as active
 11961	7277	3E	01			    ld a, 1
 11962	7279	32	B8	CD		    ld (sfx_active), a
 11963	727C					
 11964	727C	C9				    ret
 11965	727D					
 11966	727D					; ------------------------------------------------------------------
 11967	727D					; sfx_update
 11968	727D					; Update sound effect system (call every frame)
 11969	727D					; Handles automatic fadeout and silence
 11970	727D					; ------------------------------------------------------------------
 11971	727D					sfx_update:
 11972	727D	3A	4D	D1		    ld a, (music_active)
 11973	7280	B7				    or a
 11974	7281	C0				    ret nz
 11975	7282					    ; Check if sound is active
 11976	7282	3A	B8	CD		    ld a, (sfx_active)
 11977	7285	B7				    or a
 11978	7286	C8				    ret z                        ; No active sound
 11979	7287					
 11980	7287					    ; Decrement timer
 11981	7287	3A	B9	CD		    ld a, (sfx_timer)
 11982	728A	B7				    or a
 11983	728B	28	08			    jr z, .silence_now
 11984	728D					
 11985	728D	3D				    dec a
 11986	728E	32	B9	CD		    ld (sfx_timer), a
 11987	7291					
 11988	7291					    ; Check if entering fadeout zone (last 5 frames)
 11989	7291	FE	05			    cp 5
 11990	7293	D0				    ret nc                       ; Still in main sound
 11991	7294					
 11992	7294					    ; TODO: Implement volume fadeout here
 11993	7294	C9				    ret
 11994	7295					
 11995	7295					.silence_now:
 11996	7295	CD	81	71		    call sfx_silence_all
 11997	7298	AF				    xor a
 11998	7299	32	B8	CD		    ld (sfx_active), a
 11999	729C	C9				    ret
 12000	729D					
 12001	729D					; ==================================================================
 12002	729D					; PT3 MUSIC BACKEND
 12003	729D					; Uses the PT3 replayer for AY-3-8910 music playback.
 12004	729D					; PT3_SETUP, ChanA, AYREGS, etc. are defined in variables.asm.
 12005	729D					; ==================================================================
 12006	729D					
 12007	729D					; ------------------------------------------------------------------
 12008	729D					; music_init_system
 12009	729D					; Reset PT3 music state. Call once at startup.
 12010	729D					; Destroys: AF
 12011	729D					; ------------------------------------------------------------------
 12012	729D					music_init_system:
 12013	729D	AF				    xor a
 12014	729E	32	4D	D1		    ld (music_active), a
 12015	72A1	32	4E	D1		    ld (music_muted), a
 12016	72A4	32	4F	D1		    ld (music_loop), a
 12017	72A7	32	50	D1		    ld (music_track_index), a
 12018	72AA	32	74	D1		    ld (PT3_SETUP), a
 12019	72AD	C9				    ret
 12020	72AE					
 12021	72AE					; ------------------------------------------------------------------
 12022	72AE					; music_silence_channels
 12023	72AE					; Silence all AY channels via BIOS WRTPSG.
 12024	72AE					; Destroys: AF, E
 12025	72AE					; ------------------------------------------------------------------
 12026	72AE					music_silence_channels:
 12027	72AE	AF				    xor a
