 21377	ABB4	18	DD			        jr      dzx0s_copy
 21378	ABB6					dzx0s_elias:
 21379	ABB6	0C				        inc     c                       ; interlaced Elias gamma coding
 21380	ABB7					dzx0s_elias_loop:
