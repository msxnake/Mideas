 12069	72E4					; ------------------------------------------------------------------
 12070	72E4					; music_resume
 12071	72E4					; Resume muted music.
 12072	72E4					; Destroys: AF
 12073	72E4					; ------------------------------------------------------------------
 12074	72E4					music_resume:
 12075	72E4	3A	4D	D1		    ld a, (music_active)
