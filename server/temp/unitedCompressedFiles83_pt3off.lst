 14053	882E	EB				    ex de, hl          ; DE = Actions Ptr
 14054	882F	CD	85	88		    call SM_ExecuteActions
 14055	8832	EB				    ex de, hl          ; HL = Actions Ptr (unused)
 14056	8833	D1				    pop de             ; Restore target state
