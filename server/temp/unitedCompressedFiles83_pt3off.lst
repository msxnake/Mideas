 12081	72EE					
 12082	72EE					; ------------------------------------------------------------------
 12083	72EE					; music_execute_command
 12084	72EE					; Dispatch a music command from Game Flow nodes.
 12085	72EE					; Input:  DE -> [command, trackIndex, loopFlag]
 12086	72EE					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 12087	72EE					; Destroys: AF, BC (play path), DE (play path), HL
 12088	72EE					; ------------------------------------------------------------------
 12089	72EE					music_execute_command:
 12090	72EE	1A				    ld a, (de)
 12091	72EF	FE	FF			    cp #FF
 12092	72F1	C8				    ret z
 12093	72F2	B7				    or a
 12094	72F3	CA	C9	72		    jp z, music_stop
 12095	72F6	FE	01			    cp 1
 12096	72F8	CA	06	73		    jp z, .pt3_exec_play
 12097	72FB	FE	02			    cp 2
 12098	72FD	CA	D6	72		    jp z, music_mute
 12099	7300	FE	03			    cp 3
 12100	7302	CA	E4	72		    jp z, music_resume
 12101	7305	C9				    ret
 12102	7306					.pt3_exec_play:
 12103	7306	13				    inc de
 12104	7307	1A				    ld a, (de)
 12105	7308	4F				    ld c, a
 12106	7309	13				    inc de
 12107	730A	1A				    ld a, (de)
 12108	730B	47				    ld b, a
 12109	730C	79				    ld a, c
 12110	730D	CD	11	73		    call music_play_track
 12111	7310	C9				    ret
 12112	7311					
 12113	7311					; ------------------------------------------------------------------
 12114	7311					; music_play_track
 12115	7311					; Start playing a PT3 track.
 12116	7311					; Input:  A = track index (0-based)
 12117	7311					;         B = loop flag (0=no loop, 1=loop)
 12118	7311					; Destroys: AF, BC, DE, HL, IX, IY
 12119	7311					; ------------------------------------------------------------------
 12120	7311					music_play_track:
 12121	7311					    ; PT3 disabled on this build to avoid RAM overlap with ZX0 buffers.
 12122	7311					    ; Keep the public entry point but never unpack/init the tracker module.
 12123	7311	AF				    xor a
 12124	7312	32	4D	D1		    ld (music_active), a
 12125	7315	32	4E	D1		    ld (music_muted), a
 12126	7318	32	4F	D1		    ld (music_loop), a
 12127	731B	32	50	D1		    ld (music_track_index), a
 12128	731E	32	74	D1		    ld (PT3_SETUP), a
 12129	7321	CD	AE	72		    call music_silence_channels
 12130	7324	FB				    ei
 12131	7325	C9				    ret
 12132	7326					
 12133	7326					music_unpack_pt3_track:
 12134	7326	3A	50	D1		    ld a, (music_track_index)
 12135	7329	B7				    or a
 12136	732A	C0				    ret nz
 12137	732B	21	67	79		    ld hl, pt3_track_0_zx0_data
 12138	732E	11	00	D4		    ld de, PT3_TRACK_BUFFER
 12139	7331	CD	81	AB		    call dzx0_standard
 12140	7334	C9				    ret
 12141	7335					
 12142	7335					; ------------------------------------------------------------------
 12143	7335					; music_update
 12144	7335					; Update PT3 playback. Called every frame from ISR.
 12145	7335					; Checks end-of-song flag, handles loop/stop, runs PT3_ROUT+PT3_PLAY.
 12146	7335					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 12147	7335					; ------------------------------------------------------------------
 12148	7335					music_update:
 12149	7335					    ; PT3 disabled: never touch tracker state from IRQ.
 12150	7335	C9				    ret
