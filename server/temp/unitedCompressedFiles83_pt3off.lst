 13645	8626					
 13646	8626					; ------------------------------------------------------------------
 13647	8626					; update_particle_pattern
 13648	8626					; Redefine particle's pattern in VRAM based on type and frame
 13649	8626					; Input:  HL = Address of particle structure
 13650	8626					; Destroys: AF, BC, DE, HL
 13651	8626					; ------------------------------------------------------------------
 13652	8626					update_particle_pattern:
 13653	8626					    ; Get type and frame
 13654	8626	7E				    ld a, (hl)                  ; Offset 0: type
 13655	8627	47				    ld b, a                     ; B = type
 13656	8628	23				    inc hl
 13657	8629	23				    inc hl
 13658	862A	23				    inc hl
 13659	862B	23				    inc hl
 13660	862C	7E				    ld a, (hl)                  ; Offset 4: frame
 13661	862D	4F				    ld c, a                     ; C = frame
 13662	862E	2B				    dec hl
 13663	862F	2B				    dec hl
 13664	8630	23				    inc hl
 13665	8631	7E				    ld a, (hl)                  ; Offset 5: tile ID
 13666	8632	57				    ld d, a                     ; D = tile ID
 13667	8633					
 13668	8633					    ; Calculate pattern source address
 13669	8633					    ; particle_patterns + (type * 32) + (frame * 8)
 13670	8633	78				    ld a, b                     ; A = type
 13671	8634	87				    add a, a
 13672	8635	87				    add a, a
 13673	8636	87				    add a, a
 13674	8637	87				    add a, a
 13675	8638	87				    add a, a                    ; * 32 (4 frames * 8 bytes)
 13676	8639	6F				    ld l, a
 13677	863A	26	00			    ld h, 0
 13678	863C					
 13679	863C	79				    ld a, c                     ; A = frame
 13680	863D	87				    add a, a
 13681	863E	87				    add a, a
 13682	863F	87				    add a, a                    ; * 8
 13683	8640	5F				    ld e, a
 13684	8641	16	00			    ld d, 0
 13685	8643	19				    add hl, de
 13686	8644					
 13687	8644	11	5C	86		    ld de, particle_patterns
 13688	8647	19				    add hl, de                  ; HL = source pattern address
 13689	8648					
 13690	8648					    ; Calculate VRAM destination
 13691	8648					    ; CHRTBL + (tile_id * 8)
 13692	8648	7A				    ld a, d                     ; A = tile ID
 13693	8649	5F				    ld e, a
 13694	864A	16	00			    ld d, 0
 13695	864C	EB				    ex de, hl                   ; DE = source, HL = tile_id
 13696	864D	29				    add hl, hl
 13697	864E	29				    add hl, hl
 13698	864F	29				    add hl, hl                  ; * 8
 13699	8650	01	00	00		    ld bc, CHRTBL
