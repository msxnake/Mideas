 12209	8166	3E	20			    ld a, SCREEN_WIDTH_TILES
 12210	8168	32	2F	C6		    ld (world_width_tiles), a
 12211	816B	3E	18			    ld a, SCREEN_HEIGHT_TILES
 12212	816D	32	30	C6		    ld (world_height_tiles), a
