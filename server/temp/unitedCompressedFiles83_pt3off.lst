 13314	852A					
 13315	852A					; ------------------------------------------------------------------
 13316	852A					; spawn_particle
 13317	852A					; Create a new particle at given position
 13318	852A					; Input:  A = Particle type (PARTICLE_*)
 13319	852A					;         B = X position (tile coords, 0-31)
 13320	852A					;         C = Y position (tile coords, 0-23)
 13321	852A					;         D = Velocity X (optional, signed)
 13322	852A					;         E = Velocity Y (optional, signed)
 13323	852A					; Output: A = 1 if spawned successfully, 0 if pool full
 13324	852A					; Destroys: AF, BC, DE, HL
