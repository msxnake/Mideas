 1901	4265	5F				    ld e, a
 1902	4266	16	00			    ld d, 0
 1903	4268	21	2E	D1		    ld hl, task_table
 1904	426B	19				    add hl, de                  ; HL = task_table + offset
 1905	426C					
 1906	426C					    ; Write 0 (disable)
