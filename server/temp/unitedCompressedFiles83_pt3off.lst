 21333	AB81					; -----------------------------------------------------------------------------
 21334	AB81					; ZX0 decoder by Einar Saukas & Urusergi
 21335	AB81					; "Standard" version (68 bytes only)
 21336	AB81					; -----------------------------------------------------------------------------
 21337	AB81					; Parameters:
 21338	AB81					;   HL: source address (compressed data)
 21339	AB81					;   DE: destination address (decompressing)
 21340	AB81					; -----------------------------------------------------------------------------
 21341	AB81					
 21342	AB81					dzx0_standard:
 21343	AB81	01	FF	FF		        ld      bc, $ffff               ; preserve default offset 1
 21344	AB84	C5				        push    bc
 21345	AB85	03				        inc     bc
 21346	AB86	3E	80			        ld      a, $80
 21347	AB88					dzx0s_literals:
 21348	AB88	CD	B6	AB		        call    dzx0s_elias             ; obtain length
 21349	AB8B	ED	B0			        ldir                            ; copy literals
 21350	AB8D	87				        add     a, a                    ; copy from last offset or new offset?
 21351	AB8E	38	0D			        jr      c, dzx0s_new_offset
 21352	AB90	CD	B6	AB		        call    dzx0s_elias             ; obtain length
 21353	AB93					dzx0s_copy:
 21354	AB93	E3				        ex      (sp), hl                ; preserve source, restore offset
 21355	AB94	E5				        push    hl                      ; preserve offset
 21356	AB95	19				        add     hl, de                  ; calculate destination - offset
 21357	AB96	ED	B0			        ldir                            ; copy from offset
 21358	AB98	E1				        pop     hl                      ; restore offset
 21359	AB99	E3				        ex      (sp), hl                ; preserve offset, restore source
 21360	AB9A	87				        add     a, a                    ; copy from literals or new offset?
 21361	AB9B	30	EB			        jr      nc, dzx0s_literals
 21362	AB9D					dzx0s_new_offset:
 21363	AB9D	C1				        pop     bc                      ; discard last offset
 21364	AB9E	0E	FE			        ld      c, $fe                  ; prepare negative offset
 21365	ABA0	CD	B7	AB		        call    dzx0s_elias_loop        ; obtain offset MSB
 21366	ABA3	0C				        inc     c
 21367	ABA4	C8				        ret     z                       ; check end marker
 21368	ABA5	41				        ld      b, c
 21369	ABA6	4E				        ld      c, (hl)                 ; obtain offset LSB
 21370	ABA7	23				        inc     hl
 21371	ABA8	CB	18			        rr      b                       ; last offset bit becomes first length bit
 21372	ABAA	CB	19			        rr      c
 21373	ABAC	C5				        push    bc                      ; preserve new offset
 21374	ABAD	01	01	00		        ld      bc, 1                   ; obtain length
 21375	ABB0	D4	BE	AB		        call    nc, dzx0s_elias_backtrack
