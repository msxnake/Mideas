 1954	4275					;   Outputs:
 1955	4275					;     - input_state, prev_input_state, input_btn_curr, input_btn_prev, input_fire
 1956	4275					;   Clobbers:
 1957	4275					;     - AF
 1958	4275					;     - BC
 1959	4275					;     - DE
 1960	4275					;   Preserved:
 1961	4275					;     - AF
 1962	4275					;     - BC
 1963	4275					;     - DE (by push/pop wrapper)
 1964	4275					;     - HL
