 13481	85A3	46				    ld b, (hl)
 13482	85A4	23				    inc hl
 13483	85A5	23				    inc hl
 13484	85A6	23				    inc hl
 13485	85A7	23				    inc hl
 13486	85A8	7E				    ld a, (hl)
 13487	85A9	80				    add a, b
