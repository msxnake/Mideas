 14498	896B	7E				    ld a, (hl)              ; A = Sprite Asset ID pedido por la SM
 14499	896C	23				    inc hl                  ; HL apunta al byte siguiente al par??metro
 14500	896D	E5				    push hl                 ; [stack] guarda puntero de par??metros para el ret final
 14501	896E					
 14502	896E	F5				    push af                 ; [stack] guarda Sprite Asset ID (se necesita tras setup)
