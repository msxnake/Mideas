 19463	9E1D					; ==================================================================
 19464	9E1D					; execute_transition_effect
 19465	9E1D					; Execute visual screen transition by clearing the Name Table
 19466	9E1D					; in different patterns. All effects write tile 0 (blank/black)
 19467	9E1D					; to Name Table (#1800-#1AFF, 768 bytes = 32x24 tiles).
 19468	9E1D					;
 19469	9E1D					; Input:  DE = Transition data pointer
 19470	9E1D					;         (DE) = effect id: 0=cls, 1=dissolve_pixels, 2=dissolve_chars,
 19471	9E1D					;                           3=vertical_lines, 4=horizontal_lines,
 19472	9E1D					;                           5=spiral, 6=fill_white_squares
 19473	9E1D					; Destroys: AF, BC, DE, HL
 19474	9E1D					; ==================================================================
 19475	9E1D					execute_transition_effect:
 19476	9E1D	1A				    ld a, (de)                    ; A = effect id (0-6)
 19477	9E1E	13				    inc de
 19478	9E1F	F5				    push af                       ; Save effect id
 19479	9E20	1A				    ld a, (de)                    ; A = frames per step (from node data)
 19480	9E21	32	0F	C0		    ld (transition_delay_var), a  ; Store for trans_wait_frames
 19481	9E24	F1				    pop af                        ; Restore effect id
 19482	9E25	B7				    or a
 19483	9E26	CA	42	9E		    jp z, .trans_cls
 19484	9E29	3D				    dec a
 19485	9E2A	CA	50	9E		    jp z, .trans_dissolve_pixels
 19486	9E2D	3D				    dec a
 19487	9E2E	CA	72	9E		    jp z, .trans_dissolve_chars
 19488	9E31	3D				    dec a
 19489	9E32	CA	8C	9E		    jp z, .trans_vertical_lines
 19490	9E35	3D				    dec a
 19491	9E36	CA	A1	9E		    jp z, .trans_horizontal_lines
 19492	9E39	3D				    dec a
 19493	9E3A	CA	BC	9E		    jp z, .trans_spiral
 19494	9E3D	3D				    dec a
 19495	9E3E	CA	D2	9E		    jp z, .trans_fill_white_squares
 19496	9E41	C9				    ret                           ; Unknown id - do nothing
