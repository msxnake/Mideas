 17921	977C					
 17922	977C	D5				    push de                 ; Save Compare Value
 17923	977D	11	FD	97		    ld de, SM_GlobalVarTable
 17924	9780	19				    add hl, de              ; HL = &SM_GlobalVarTable[VarID - 6]
 17925	9781					
 17926	9781					    ; Read address from table
 17927	9781	5E				    ld e, (hl)
