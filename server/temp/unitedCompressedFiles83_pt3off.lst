 6744	5644					; ==================================================================
 6745	5644					; UPDATE ALL ENTITIES - Called by GameFlow (OPTIMIZED)
 6746	5644					; ==================================================================
 6747	5644					; Only calls component systems that are actually used in this project
 6748	5644					; Unused systems are NOT called (saves Z80 cycles)
 6749	5644					; Register Contract:
 6750	5644					;   Purpose: Main ECS tick entrypoint for one frame.
 6751	5644					;   Inputs:
 6752	5644					;     - Entity/component tables in RAM
 6753	5644					;   Outputs:
 6754	5644					;     - Components updated in fixed order
 6755	5644					;   Clobbers:
 6756	5644					;     - AF
 6757	5644					;     - BC
 6758	5644					;     - DE
 6759	5644					;     - HL
 6760	5644					;   Preserved:
 6761	5644					;     - None (callers should save what they need)
 6762	5644					;   Register roles:
 6763	5644					;     - Registers are scratch across component CALL chain
 6764	5644					;     - Contract intentionally conservative to prevent hidden coupling
 6765	5644					;   Notes:
 6766	5644					;     - Do not assume any register survives this routine.
 6767	5644					
 6768	5644					update_all_entities:
 6769	5644					    ; Rebuild entity list every frame so job scheduler cadence
 6770	5644					    ; (entity_job_period/entity_job_entry) is evaluated against interrupt_counter.
 6771	5644	CD	81	56		    call rebuild_used_entity_list
 6772	5647	CD	70	49		    call update_input_component         ; 1. Input (player control)
 6773	564A	CD	AD	68		    call update_entities                ; 3b. Patrol/per-entity update
 6774	564D	CD	9C	4C		    call update_jump_component          ; 4. Jump impulse
 6775	5650	CD	53	4E		    call update_cursors_component       ; 5b. Cursors movement
 6776	5653	CD	77	4D		    call update_gravity_component       ; 6. Gravity
 6777	5656	CD	12	52		    call update_slash_component         ; 6b. Additive slash velocity
 6778	5659	CD	0E	44		    call update_position_component      ; 7. Apply velocity
 6779	565C	CD	A2	4E		    call prepare_platform_detection     ; 8a. Clear platform refs
 6780	565F	CD	B4	45		    call update_collision_component     ; 8b. Collision detection
 6781	5662	CD	BE	4E		    call update_platform_riding         ; 8c. Platform riding
 6782	5665	CD	DA	4E		    call update_wallcollision_component ; 8d. Wall collision
 6783	5668	CD	37	53		    call check_tile_interaction         ; 8e. Tile interaction (gems/collectibles)
 6784	566B	CD	5C	4B		    call update_animation_component     ; 11. Animation
 6785	566E	CD	85	44		    call update_sprite_component        ; 13. Sprite rendering
 6786	5671	C9				    ret
