 1806	423F	28	07			    jr z, .not_in_vblank
 1807	4241	3E	01			    ld a, 1
 1808	4243	32	48	D1		    ld (vblank_flag), a
 1809	4246	18	04			    jr .uvf_done
 1810	4248					.not_in_vblank:
