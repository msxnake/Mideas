 17968	97AF					
 17969	97AF					.do_compare:
 17970	97AF					    ; E = Variable Value
 17971	97AF					    ; Stack: Compare Value (D), Operator (C in saved BC), Entity Index
 17972	97AF	E1				    pop hl                  ; HL = Compare Value (D in H)
 17973	97B0	54				    ld d, h                 ; D = Compare Value
 17974	97B1	C1				    pop bc                  ; C = Operator ID, B = Entity Index (restore)
 17975	97B2	E1				    pop hl                  ; HL = Updated Params Ptr
 17976	97B3					    
 17977	97B3					    ; Now: E = Variable Value, D = Compare Value, C = Operator
 17978	97B3					    ; Perform comparison based on operator
 17979	97B3	79				    ld a, c                 ; A = Operator ID
 17980	97B4					    
 17981	97B4	FE	00			    cp 0                    ; == operator
 17982	97B6	28	17			    jr z, .op_equals
 17983	97B8	FE	01			    cp 1                    ; != operator
 17984	97BA	28	19			    jr z, .op_not_equals
 17985	97BC	FE	02			    cp 2                    ; > operator
 17986	97BE	28	1B			    jr z, .op_greater
 17987	97C0	FE	03			    cp 3                    ; < operator
 17988	97C2	28	1F			    jr z, .op_less
 17989	97C4	FE	04			    cp 4                    ; >= operator
 17990	97C6	28	21			    jr z, .op_greater_equal
 17991	97C8	FE	05			    cp 5                    ; <= operator
 17992	97CA	28	23			    jr z, .op_less_equal
 17993	97CC					    
 17994	97CC					    ; Invalid operator, return false
 17995	97CC	3E	00			    ld a, 0
 17996	97CE	C9				    ret
 17997	97CF					
 17998	97CF					.op_equals:
 17999	97CF	7B				    ld a, e                 ; A = Variable Value
 18000	97D0	BA				    cp d                    ; Compare with D
 18001	97D1	28	24			    jr z, .return_true
 18002	97D3	18	25			    jr .return_false
 18003	97D5					
 18004	97D5					.op_not_equals:
 18005	97D5	7B				    ld a, e
 18006	97D6	BA				    cp d
 18007	97D7	20	1E			    jr nz, .return_true
 18008	97D9	18	1F			    jr .return_false
 18009	97DB					
 18010	97DB					.op_greater:
 18011	97DB	7B				    ld a, e
 18012	97DC	BA				    cp d
 18013	97DD	28	1B			    jr z, .return_false     ; If equal, not greater
 18014	97DF	30	16			    jr nc, .return_true     ; If no carry, E >= D, so E > D (since not equal)
 18015	97E1	18	17			    jr .return_false
 18016	97E3					
 18017	97E3					.op_less:
 18018	97E3	7B				    ld a, e
 18019	97E4	BA				    cp d
 18020	97E5	38	10			    jr c, .return_true      ; If carry, E < D
 18021	97E7	18	11			    jr .return_false
 18022	97E9					
 18023	97E9					.op_greater_equal:
 18024	97E9	7B				    ld a, e
 18025	97EA	BA				    cp d
 18026	97EB	30	0A			    jr nc, .return_true     ; If no carry, E >= D
 18027	97ED	18	0B			    jr .return_false
 18028	97EF					
 18029	97EF					.op_less_equal:
 18030	97EF	7B				    ld a, e
 18031	97F0	BA				    cp d
 18032	97F1	28	04			    jr z, .return_true      ; If equal
 18033	97F3	38	02			    jr c, .return_true      ; If carry, E < D
 18034	97F5	18	03			    jr .return_false
 18035	97F7					
 18036	97F7					.return_true:
 18037	97F7	3E	01			    ld a, 1
 18038	97F9	C9				    ret
 18039	97FA					
 18040	97FA					.return_false:
 18041	97FA	3E	00			    ld a, 0
 18042	97FC	C9				    ret
