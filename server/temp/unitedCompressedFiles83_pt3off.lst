 6621	55CC					    ; ------------------------------------------------------------------
 6622	55CC					    ; entity_job_should_run_c
 6623	55CC					    ; Evaluate per-entity cadence gate for current frame.
 6624	55CC					    ; Input:  C = entity index (0..31)
