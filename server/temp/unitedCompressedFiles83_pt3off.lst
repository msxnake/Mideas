 13354	8541	23				    inc hl
 13355	8542					
 13356	8542	AF				    xor a
 13357	8543	77				    ld (hl), a                  ; Offset 4: frame = 0
 13358	8544	23				    inc hl
 13359	8545	23				    inc hl                      ; Skip tile_id (already assigned)
 13360	8546					
 13361	8546	72				    ld (hl), d                  ; Offset 6: velocity X
 13362	8547	23				    inc hl
 13363	8548	73				    ld (hl), e                  ; Offset 7: velocity Y
