 6843	5681					; ------------------------------------------------------------------
 6844	5681					; rebuild_used_entity_list
 6845	5681					; Build compact list of ACTIVE entity slots that are in use
 6846	5681					; for the CURRENT SCREEN only:
 6847	5681					; (entity_active != 0 and mask_l|mask_h != 0 and entity_screen_id == current_screen_id)
 6848	5681					; Output:
 6849	5681					;   active_entity_list[]   = entity indices with components
 6850	5681					;   active_entity_count    = number of entries
 6851	5681					; ------------------------------------------------------------------
 6852	5681					; Register Contract:
 6853	5681					;   Purpose: Recompute compact list of entities active on current screen.
 6854	5681					;   Inputs:
 6855	5681					;     - entity_active, entity_comp_masks(_hi), entity_screen_id, current_screen_id
 6856	5681					;   Outputs:
 6857	5681					;     - active_entity_list[]
 6858	5681					;     - active_entity_count
 6859	5681					;     - active_entity_list_dirty=0
 6860	5681					;   Clobbers:
 6861	5681					;     - AF
 6862	5681					;     - BC
 6863	5681					;     - DE
 6864	5681					;     - HL
 6865	5681					;   Preserved:
 6866	5681					;     - None
 6867	5681					;   Register roles:
 6868	5681					;     - B = slots remaining (MAX_ENTITIES..1)
 6869	5681					;     - C = entity slot iterator (0..MAX_ENTITIES-1)
 6870	5681					;     - DE = index offset (entity id / active list position)
 6871	5681					;     - HL = pointer math over component and state arrays
 6872	5681					;     - A = predicate checks and counters
