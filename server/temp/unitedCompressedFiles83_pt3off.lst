 11086	6FAC	04				    inc b                       ; Width += 2
 11087	6FAD					    
 11088	6FAD	0C				    inc c
 11089	6FAE	0C				    inc c                       ; Height += 2
 11090	6FAF					    
 11091	6FAF	CD	2C	70		    call hud_draw_frame
 11092	6FB2					    
 11093	6FB2					    ; Restore original X, Y, Width, Height for text rendering
 11094	6FB2	D1				    pop de                      ; DE = X, Y (pixels)
 11095	6FB3	C1				    pop bc                      ; BC = Width, Height (tiles)
 11096	6FB4					    ; Re-push in same order as original (BC bottom, DE top)
 11097	6FB4	C5				    push bc                     ; Save Width, Height (bottom)
 11098	6FB5	D5				    push de                     ; Save X, Y (top)
 11099	6FB6					
 11100	6FB6					.no_border:
 11101	6FB6					    ; ---------------------------------------------------------
 11102	6FB6					    ; 2. Draw Text
 11103	6FB6					    ; ---------------------------------------------------------
 11104	6FB6	D1				    pop de                      ; DE = X, Y (pixels)
 11105	6FB7	C1				    pop bc                      ; BC = Width, Height (discard, not needed)
 11106	6FB8					
 11107	6FB8					    ; Calculate VRAM address from X,Y pixel coordinates
 11108	6FB8					    ; Screen 2 Name Table = #1800 + (Y/8)*32 + (X/8)
 11109	6FB8					    
 11110	6FB8					    ; Y/8 = row
 11111	6FB8	7B				    ld a, e                     ; A = Y
 11112	6FB9	CB	3F			    srl a
 11113	6FBB	CB	3F			    srl a
 11114	6FBD	CB	3F			    srl a                       ; A = Y/8 (row)
 11115	6FBF					
 11116	6FBF					    ; row * 32
 11117	6FBF	6F				    ld l, a
 11118	6FC0	26	00			    ld h, 0
 11119	6FC2	29				    add hl, hl                  ; * 2
 11120	6FC3	29				    add hl, hl                  ; * 4
 11121	6FC4	29				    add hl, hl                  ; * 8
 11122	6FC5	29				    add hl, hl                  ; * 16
 11123	6FC6	29				    add hl, hl                  ; * 32
 11124	6FC7					
 11125	6FC7					    ; Add X/8
 11126	6FC7	7A				    ld a, d                     ; A = X
 11127	6FC8	CB	3F			    srl a
 11128	6FCA	CB	3F			    srl a
 11129	6FCC	CB	3F			    srl a                       ; A = X/8 (column)
 11130	6FCE	5F				    ld e, a
 11131	6FCF	16	00			    ld d, 0
 11132	6FD1	19				    add hl, de
 11133	6FD2					
 11134	6FD2					    ; Add Name Table base
 11135	6FD2	11	00	18		    ld de, #1800
 11136	6FD5	19				    add hl, de                  ; HL = VRAM address
 11137	6FD6					
 11138	6FD6					    ; Get Text Pointer
 11139	6FD6	DD	5E	06		    ld e, (ix+6)                ; TextPtr Low
 11140	6FD9	DD	56	07		    ld d, (ix+7)                ; TextPtr High
 11141	6FDC					    ; DE = Text Pointer
 11142	6FDC					
 11143	6FDC					    ; Render text string at HL (VRAM) from DE (string)
 11144	6FDC	CD	0A	70		    call hud_print_string
 11145	6FDF					
 11146	6FDF					.skip_element:
 11147	6FDF					    ; Move to next element
 11148	6FDF	01	09	00		    ld bc, 9                    ; Size of each element entry
 11149	6FE2	DD	09			    add ix, bc                  ; IX points to next element
 11150	6FE4					
 11151	6FE4	C1				    pop bc                      ; Restore counter
 11152	6FE5	10	96			    djnz .render_loop
 11153	6FE7					
 11154	6FE7					    ; Re-apply dynamic Score digits after redrawing static HUD text.
 11155	6FE7	3A	10	C0		    ld a, (global_var_score)
 11156	6FEA	6F				    ld l, a
 11157	6FEB	3A	11	C0		    ld a, (global_var_score+1)
 11158	6FEE	67				    ld h, a
 11159	6FEF	CD	A6	70		    call update_hud_score
 11160	6FF2					
 11161	6FF2					    ; Re-apply dynamic Lives digit after redrawing static HUD text.
 11162	6FF2	3A	12	C0		    ld a, (global_var_lives)
 11163	6FF5	CD	11	71		    call update_hud_lives
 11164	6FF8					
 11165	6FF8					
 11166	6FF8	DD	E1			    pop ix
 11167	6FFA	E1				    pop hl
 11168	6FFB	D1				    pop de
 11169	6FFC	C1				    pop bc
 11170	6FFD	F1				    pop af
 11171	6FFE	C9				    ret
