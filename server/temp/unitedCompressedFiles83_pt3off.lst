 7506	594F	3A	00	00		    ld a, PATTERN_DATA_BANK
 7507	5952	CD	5D	41		    call mapper_set_bank_p2
 7508	5955					    ; Decompress ZX0 tile pattern data into RAM buffer
 7509	5955	F3				    di
