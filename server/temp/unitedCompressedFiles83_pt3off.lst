 17133	944B					Condition_And:
 17134	944B					    ; AND compound condition
 17135	944B					    ; Data format: DB subcondition_count, then N subconditions inline
 17136	944B					    ; Evaluates all subconditions; returns true only if ALL are true
 17137	944B					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17138	944B					    ; Output: A = 1 (all true) or 0 (any false), HL = past all subcondition data
 17139	944B	4E				    ld c, (hl)              ; C = subcondition count
 17140	944C	23				    inc hl
 17141	944D	16	01			    ld d, 1                 ; D = result accumulator (1 = all true so far)
 17142	944F					
 17143	944F					.and_loop:
 17144	944F	79				    ld a, c
 17145	9450	B7				    or a
 17146	9451	28	0D			    jr z, .and_done         ; No more subconditions
 17147	9453					
 17148	9453	C5				    push bc                 ; Save count (C) and entity index (implicitly)
 17149	9454	D5				    push de                 ; Save result accumulator (D)
 17150	9455					
 17151	9455	78				    ld a, b                 ; A = Entity Index
 17152	9456	CD	9D	88		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17153	9459					
 17154	9459	D1				    pop de                  ; Restore result accumulator
