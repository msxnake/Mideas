 18300	99A9					; ==================================================================
 18301	99A9					; GAMEFLOW EXECUTION ENGINE
 18302	99A9					; File: gameflow.asm
 18303	99A9					; Description: GameFlow-based game orchestration system
 18304	99A9					; ==================================================================
 18305	99A9					;
 18306	99A9					; GameFlow: Main
 18307	99A9					; Total Nodes: 10
 18308	99A9					; Total Connections: 11
 18309	99A9					; Start Node: gf_start_1770754183471
 18310	99A9					;
 18311	99A9					; ARCHITECTURE:
 18312	99A9					; - GameFlow is the SOLE execution orchestrator
 18313	99A9					; - Each node generates its own execution code
 18314	99A9					; - Connections between nodes define the complete flow
 18315	99A9					; - No hardcoded main_loop outside GameFlow
 18316	99A9					; ==================================================================
 18317	99A9					
 18318	99A9					; ==================================================================
 18319	99A9					; GAMEFLOW INITIALIZATION
 18320	99A9					; ==================================================================
 18321	99A9					
 18322	99A9					gameflow_init:
 18323	99A9					    ; Initialize GameFlow system
 18324	99A9					    ; Reset state
 18325	99A9	AF				    xor a
 18326	99AA	32	07	C0		    ld (gameflow_exit_requested), a
 18327	99AD	32	05	C0		    ld (current_flow_state), a
 18328	99B0	C9				    ret
 18329	99B1					
 18330	99B1					; Main entry point - called from init_rom
 18331	99B1					; This is where the game STARTS
 18332	99B1					gameflow_start:
 18333	99B1					    ; Load the Start node
 18334	99B1	21	14	A0		    ld hl, gameflow_node_gf_start_1770754183471
 18335	99B4	C3	B7	99		    jp gameflow_execute_node
 18336	99B7					
 18337	99B7					; ==================================================================
 18338	99B7					; CORE EXECUTION ENGINE
 18339	99B7					; ==================================================================
 18340	99B7					
 18341	99B7					; Execute a GameFlow node
 18342	99B7					; Input: HL = address of node structure
 18343	99B7					; 
 18344	99B7					; Node Structure:
 18345	99B7					;   +0: Node type (byte)
 18346	99B7					;   +1-2: Data pointer (word) - node-specific data
 18347	99B7					;   +3-4: Connection table pointer (word)
 18348	99B7					;
 18349	99B7					gameflow_execute_node:
 18350	99B7					    ; Read node type
 18351	99B7	7E				    ld a, (hl)
 18352	99B8	23				    inc hl
 18353	99B9					    
 18354	99B9					    ; Save data pointer and connection table pointer for handlers
 18355	99B9	5E				    ld e, (hl)
 18356	99BA	23				    inc hl
 18357	99BB	56				    ld d, (hl)      ; DE = data pointer
 18358	99BC	23				    inc hl
 18359	99BD	4E				    ld c, (hl)
 18360	99BE	23				    inc hl
 18361	99BF	46				    ld b, (hl)      ; BC = connection table pointer
 18362	99C0					    
 18363	99C0					    ; DE = node data, BC = connection table
 18364	99C0					    ; Dispatch based on node type
 18365	99C0	FE	00			    cp NODE_TYPE_START
 18366	99C2	CA	E4	99		    jp z, gameflow_handle_start
 18367	99C5	FE	01			    cp NODE_TYPE_WORLD_LINK
 18368	99C7	CA	FF	99		    jp z, gameflow_handle_worldlink
 18369	99CA	FE	07			    cp NODE_TYPE_END
 18370	99CC	CA	38	9A		    jp z, gameflow_handle_end
 18371	99CF	FE	04			    cp NODE_TYPE_TEXT
 18372	99D1	CA	C5	9A		    jp z, gameflow_handle_text
 18373	99D4	FE	03			    cp NODE_TYPE_SUB_MENU
 18374	99D6	CA	61	9B		    jp z, gameflow_handle_submenu
 18375	99D9	FE	05			    cp NODE_TYPE_TRANSITION
 18376	99DB	CA	09	9E		    jp z, gameflow_handle_transition
 18377	99DE	FE	0C			    cp NODE_TYPE_MUSIC
 18378	99E0	CA	AD	9F		    jp z, gameflow_handle_music
 18379	99E3					    
 18380	99E3					    ; Unknown node type - error
 18381	99E3	C9				    ret
 18382	99E4					
 18383	99E4					; ==================================================================
 18384	99E4					; NODE TYPE HANDLERS
 18385	99E4					; Each handler receives:
 18386	99E4					;   DE = node data pointer
 18387	99E4					;   BC = connection table pointer
 18388	99E4					; ==================================================================
 18389	99E4					
 18390	99E4					gameflow_handle_start:
 18391	99E4					    ; Start node - Initialize game state and systems
 18392	99E4					    ; DE = node data pointer:
 18393	99E4					    ;   [init_routine_ptr DW][init_routine_bank DB]
 18394	99E4					    ; BC = connection table
 18395	99E4					
 18396	99E4	C5				    push bc         ; Save connection table
 18397	99E5					
 18398	99E5					    ; Execute initialization routine
 18399	99E5					    ; DE points to start_init_data structure
 18400	99E5	EB				    ex de, hl
 18401	99E6	5E				    ld e, (hl)
 18402	99E7	23				    inc hl
 18403	99E8	56				    ld d, (hl)      ; DE = initialization routine address
 18404	99E9	23				    inc hl
 18405	99EA	46				    ld b, (hl)      ; B = initialization routine bank
 18406	99EB	62				    ld h, d
 18407	99EC	6B				    ld l, e         ; HL = initialization routine address
 18408	99ED					
 18409	99ED					    ; Call initialization routine (if not null)
 18410	99ED	7C				    ld a, h
 18411	99EE	B5				    or l
 18412	99EF	28	04			    jr z, .skip_init
 18413	99F1					
 18414	99F1					    ; Mapper-safe far call (auto window from HL address)
 18415	99F1	78				    ld a, b
 18416	99F2	CD	AC	41		    call mapper_call_hl_auto
 18417	99F5					
 18418	99F5					.skip_init:
 18419	99F5					    ; Continue to next node
 18420	99F5	C1				    pop bc
 18421	99F6	CD	BB	9F		    call gameflow_get_default_connection
 18422	99F9	7C				    ld a, h
 18423	99FA	B5				    or l
 18424	99FB	C8				    ret z           ; No connection
 18425	99FC	C3	B7	99		    jp gameflow_execute_node
 18426	99FF					
 18427	99FF					gameflow_handle_worldlink:
 18428	99FF					    ; WorldLink node - load world and enter game loop
 18429	99FF					    ; DE = world data pointer:
 18430	99FF					    ;   [load_world_ptr DW][load_world_bank DB]
 18431	99FF					    ; BC = connection table (for exit)
 18432	99FF					
 18433	99FF	C5				    push bc         ; Save connection table
 18434	9A00					
 18435	9A00					    ; Load the world
 18436	9A00					    ; DE points to: dw load_world_X, db load_world_bank
 18437	9A00	EB				    ex de, hl
 18438	9A01	5E				    ld e, (hl)
 18439	9A02	23				    inc hl
 18440	9A03	56				    ld d, (hl)
 18441	9A04	23				    inc hl
 18442	9A05	46				    ld b, (hl)      ; B = load_world_X bank
 18443	9A06	62				    ld h, d
 18444	9A07	6B				    ld l, e         ; HL = load_world_X address
 18445	9A08					
 18446	9A08					    ; Mapper-safe far call to world load routine
 18447	9A08	7C				    ld a, h
 18448	9A09	B5				    or l
 18449	9A0A	28	04			    jr z, .after_load
 18450	9A0C	78				    ld a, b
 18451	9A0D	CD	AC	41		    call mapper_call_hl_auto
 18452	9A10					
 18453	9A10					.after_load:
 18454	9A10					    ; Set game state
 18455	9A10	3E	01			    ld a, FLOW_STATE_GAME
 18456	9A12	32	05	C0		    ld (current_flow_state), a
 18457	9A15					
 18458	9A15					    ; Update sprites
 18459	9A15	CD	EA	5C		    call update_sprites_to_vram
