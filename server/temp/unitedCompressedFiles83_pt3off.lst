 13158	84A1	90	01	05	01	    db 144, 1, 5, 1    ; elevador1 -> tile tile_1772736409923
 13159	84A5	91	01	05	01	    db 145, 1, 5, 1    ; elevador2 -> tile tile_1772737039713
