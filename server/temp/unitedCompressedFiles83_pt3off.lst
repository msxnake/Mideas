 13235	850D					
 13236	850D					
 13237	850D					; ==================================================================
 13238	850D					; PARTICLE SYSTEM (VRAM Pattern Redefinition)
 13239	850D					; File: particles.asm
 13240	850D					; Description: Visual effects using dynamic tile pattern updates
 13241	850D					; ==================================================================
 13242	850D					
 13243	850D					; ==================================================================
 13244	850D					; PARTICLE SYSTEM CONSTANTS
 13245	850D					; ==================================================================
 13246	850D					
 13247	850D					; Maximum active particles
 13248	850D					MAX_PARTICLES           EQU 8       ; Support up to 8 simultaneous particles
 13249	850D					
 13250	850D					; Reserved tile IDs for particles (248-255)
 13251	850D					PARTICLE_TILE_BASE      EQU 248     ; First tile ID for particles
 13252	850D					
 13253	850D					; Particle types
 13254	850D					PARTICLE_NONE           EQU 0       ; Inactive particle slot
 13255	850D					PARTICLE_EXPLOSION      EQU 1       ; Explosion (4 frames, expands outward)
 13256	850D					PARTICLE_SMOKE          EQU 2       ; Smoke puff (4 frames, rises up)
 13257	850D					PARTICLE_SPARK          EQU 3       ; Spark/flash (2 frames, quick)
 13258	850D					PARTICLE_DUST           EQU 4       ; Dust cloud (3 frames, fades)
 13259	850D					PARTICLE_IMPACT         EQU 5       ; Impact star (3 frames, shrinks)
 13260	850D					PARTICLE_DEBRIS         EQU 6       ; Debris chunk (2 frames, falls)
 13261	850D					PARTICLE_MUZZLE_FLASH   EQU 7       ; Muzzle flash (2 frames, instant)
 13262	850D					PARTICLE_WATER_SPLASH   EQU 8       ; Water splash (4 frames, arcs)
 13263	850D					
 13264	850D					; Particle lifetimes (in frames)
 13265	850D					LIFE_EXPLOSION          EQU 16      ; ~267ms
 13266	850D					LIFE_SMOKE              EQU 24      ; ~400ms
 13267	850D					LIFE_SPARK              EQU 8       ; ~133ms
 13268	850D					LIFE_DUST               EQU 12      ; ~200ms
 13269	850D					LIFE_IMPACT             EQU 10      ; ~167ms
 13270	850D					LIFE_DEBRIS             EQU 20      ; ~333ms
 13271	850D					LIFE_MUZZLE_FLASH       EQU 4       ; ~67ms (very quick)
 13272	850D					LIFE_WATER_SPLASH       EQU 18      ; ~300ms
 13273	850D					
 13274	850D					; Particle pool structure (8 bytes per particle)
 13275	850D					; Offset 0: Type (PARTICLE_*)
 13276	850D					; Offset 1: Lifetime remaining (frames)
 13277	850D					; Offset 2: X position (screen coords, 0-31 tiles)
 13278	850D					; Offset 3: Y position (screen coords, 0-23 tiles)
