 14441	896B					; ==================================================================
 14442	896B					; Action_ChangeSprite
 14443	896B					; ------------------------------------------------------------------
 14444	896B					; Cambia el sprite activo de una entidad. Realiza 5 operaciones:
 14445	896B					;   1. Redirect direccional: si entity_facing_dir != 0, sustituye el
 14446	896B					;      sprite pedido por su variante direccional (left/right/up/down)
 14447	896B					;      usando SM_FacingDirTablePtrs.
 14448	896B					;   2. Commit: escribe el sprite final en entity_sprite_asset_index.
 14449	896B					;   3. Reset de animaci??n: pone entity_anim_frame y entity_anim_tick a 0.
 14450	896B					;   4. Flags de animaci??n: activa PLAYING, aplica el flag de LOOP del
 14451	896B					;      sprite, y para sprites one-shot borra ONLY_WHEN_MOVING para que
 14452	896B					;      la animaci??n avance aunque la entidad est?? quieta.
 14453	896B					;   5. Upload inmediato: copia el frame 0 del nuevo sprite a VRAM en
 14454	896B					;      el mismo frame para que el cambio sea visible sin esperar al
 14455	896B					;      siguiente ciclo de update_animation_component.
 14456	896B					;   6. Colores de capas: actualiza sprite_layer_colors (tabla RAM) con
 14457	896B					;      los colores del nuevo sprite desde SM_SpriteLayerColorTable.
 14458	896B					;
 14459	896B					; Input:
 14460	896B					;   HL  = puntero al par??metro (sprite asset ID, 1 byte)
 14461	896B					;   B   = entity index (convenci??n SM_ExecuteActions)
 14462	896B					;
 14463	896B					; Output:
 14464	896B					;   HL  = puntero al byte siguiente a los par??metros (para el caller)
 14465	896B					;
 14466	896B					; Destruye: AF, BC, DE, HL (todos restaurados al salir salvo HL=next param)
 14467	896B					;
 14468	896B					; Stack al entrar (top ??? bottom):
 14469	896B					;   [llamada desde SM_ExecuteActions]
 14470	896B					; Stack al salir: igual que al entrar.
 14471	896B					;
 14472	896B					; Tablas ROM usadas:
 14473	896B					;   SM_FacingDirTablePtrs      ??? punteros a las 4 tablas de redirect
 14474	896B					;   sprite_loop_flags          ??? 1 byte/sprite: 0x02=loop, 0x00=one-shot
 14475	896B					;   SM_SpritePatternPtrTable   ??? puntero al frame 0 de cada sprite
 14476	896B					;   SM_SpriteLayerColorTable   ??? colores por sprite (SPRITE_MAX_ENTITY_LAYERS bytes/sprite)
 14477	896B					;
 14478	896B					; Variables RAM usadas:
 14479	896B					;   entity_facing_dir          ??? direcci??n actual de la entidad (0-4)
 14480	896B					;   entity_sprite_asset_index  ??? ??ndice del sprite activo de la entidad
 14481	896B					;   entity_anim_frame          ??? frame actual de la animaci??n
 14482	896B					;   entity_anim_tick           ??? contador de ticks entre frames
 14483	896B					;   entity_anim_flags          ??? flags de animaci??n (ver bits m??s abajo)
 14484	896B					;   entity_sprite_config       ??? base HW sprite + layer count (2 bytes/entidad)
 14485	896B					;   sprite_layer_colors        ??? colores actuales por slot HW sprite (RAM)
 14486	896B					;
 14487	896B					; Bits de entity_anim_flags:
 14488	896B					;   bit 0 = ANIM_FLAG_PLAYING       (1 = animando)
 14489	896B					;   bit 1 = ANIM_FLAG_LOOP          (1 = bucle infinito, 0 = one-shot)
 14490	896B					;   bit 2 = ANIM_FLAG_ONLY_WHEN_MOVING (1 = solo anima si vel != 0)
 14491	896B					;   bit 3 = ANIM_FLAG_COMPLETED     (1 = one-shot lleg?? al ??ltimo frame)
 14492	896B					;
 14493	896B					; NOTA: el bloque de redirect direccional usa B como registro temporal
 14494	896B					; para guardar el sprite ID. Al salir del bloque, B queda corrupto.
 14495	896B					; Se restaura expl??citamente con "ld b, 0" antes de los add hl, bc.
 14496	896B					; ==================================================================
