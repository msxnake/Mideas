 12536	8268					ANIM_SPEED_SLOW         EQU 15      ; ~250ms (water)
 12537	8268					ANIM_SPEED_MEDIUM       EQU 8       ; ~133ms (lava)
 12538	8268					ANIM_SPEED_FAST         EQU 4       ; ~66ms (fire)
 12539	8268					
