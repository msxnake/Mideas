 3681	48E8					    ; ------------------------------------------------------------------
 3682	48E8					    ; get_behavior_tile
 3683	48E8					    ; ------------------------------------------------------------------
 3684	48E8					; Register Contract:
 3685	48E8					;   Purpose: Read behavior byte for tile at (B=row, C=column) from the runtime behavior map.
 3686	48E8					;   Inputs:
 3687	48E8					;     - B = tile row    (0..23, out-of-range ??? A=0, passable)
 3688	48E8					;     - C = tile column (0..31, out-of-range ??? A=0, passable)
 3689	48E8					;     - current_behavior_map = 16-bit pointer to active screen behavior map
 3690	48E8					;     - current_behavior_map_bank = memory bank number (mapper context)
 3691	48E8					;   Outputs:
 3692	48E8					;     - A = behavior byte:
 3693	48E8					;     -   bits 7-4 (A & #F0): family / solidity class (0x00 = NoSolid, 0x10+ = Solid)
 3694	48E8					;     -   bits 3-0 (A & #0F): flag bits (e.g. 0x08 = Interactable)
 3695	48E8					;   Clobbers:
 3696	48E8					;     - AF
 3697	48E8					;   Preserved:
 3698	48E8					;     - BC
 3699	48E8					;     - DE
 3700	48E8					;     - HL
 3701	48E8					;   Notes:
 3702	48E8					;     - Maintains a single-row cache (behavior_cache_row / behavior_cache_row_base)
 3703	48E8					;     - so consecutive calls for the same row skip the row*32 multiply.
 3704	48E8					;     - Mapper push/pop protects P2 bank around the map read (no-op in simple32k mode).
 3705	48E8					;     - MUST be called with DE = entity index already set (DE is preserved, not used).
 3706	48E8					
 3707	48E8					get_behavior_tile:
 3708	48E8					    ; Bounds check: row must be 0-23, column must be 0-31
 3709	48E8					    ; NOTE: jp nc (not jr nc) to gbt_oob ??? gbt_oob is a global label defined after
 3710	48E8					    ; get_behavior_tile_nb. Using jr would create a local-label scoping conflict in
 3711	48E8					    ; glass.jar (get_behavior_tile_nb: starts a new scope, so .bt_out_of_bounds would
 3712	48E8					    ; belong to that scope, not get_behavior_tile's scope).
 3713	48E8	78				    ld a, b
 3714	48E9	FE	18			    cp 24
 3715	48EB	D2	36	49		    jp nc, gbt_oob                ; Row >= 24: treat as passable
 3716	48EE	79				    ld a, c
 3717	48EF	FE	20			    cp 32
 3718	48F1	D2	36	49		    jp nc, gbt_oob                ; Column >= 32: treat as passable
 3719	48F4					get_behavior_tile_nb:
 3720	48F4					    ; Entry point for callers that guarantee B ??? 0..23 and C ??? 0..31.
 3721	48F4					    ; Saves 36 cycles (4+7+7+4+7+7) by skipping bounds validation.
 3722	48F4					    ; DO NOT call this unless the probe coordinates are provably in-bounds.
 3723	48F4	E5				    push hl
 3724	48F5	D5				    push de
 3725	48F6					
 3726	48F6					    ; Load cached behavior map pointer (fallback to current_behavior_map)
 3727	48F6	21	25	C0		    ld hl, behavior_cache_map_l
 3728	48F9	5E				    ld e, (hl)
 3729	48FA	23				    inc hl
 3730	48FB	56				    ld d, (hl)
 3731	48FC	7A				    ld a, d
 3732	48FD	B3				    or e
 3733	48FE	20	11			    jr nz, .map_ptr_ready
 3734	4900					
 3735	4900	ED	5B	21	C0	    ld de, (current_behavior_map)
 3736	4904	7B				    ld a, e
 3737	4905	32	25	C0		    ld (behavior_cache_map_l), a
 3738	4908	7A				    ld a, d
 3739	4909	32	26	C0		    ld (behavior_cache_map_h), a
 3740	490C	3E	FF			    ld a, #FF
 3741	490E	32	24	C0		    ld (behavior_cache_row), a
 3742	4911					
 3743	4911					.map_ptr_ready:
 3744	4911					    ; Reuse previous row base when checking multiple points on same row
 3745	4911	78				    ld a, b
 3746	4912	21	24	C0		    ld hl, behavior_cache_row
 3747	4915	BE				    cp (hl)
 3748	4916	28	13			    jr z, .use_cached_row_base
 3749	4918					
 3750	4918					    ; Cache miss: row base = behavior_map + row*32
 3751	4918	78				    ld a, b
 3752	4919	6F				    ld l, a
 3753	491A	26	00			    ld h, 0
 3754	491C	29				    add hl, hl                    ; HL = row * 2
 3755	491D	29				    add hl, hl                    ; HL = row * 4
 3756	491E	29				    add hl, hl                    ; HL = row * 8
 3757	491F	29				    add hl, hl                    ; HL = row * 16
 3758	4920	29				    add hl, hl                    ; HL = row * 32
 3759	4921	19				    add hl, de                    ; HL = row base address
 3760	4922					
 3761	4922	78				    ld a, b
 3762	4923	32	24	C0		    ld (behavior_cache_row), a
 3763	4926	22	27	C0		    ld (behavior_cache_row_base), hl
 3764	4929	18	03			    jr .row_base_ready
 3765	492B					
 3766	492B					.use_cached_row_base:
 3767	492B	2A	27	C0		    ld hl, (behavior_cache_row_base)
 3768	492E					
 3769	492E					.row_base_ready:
