 12274	819C	79				    ld a, c
 12275	819D	32	29	C6		    ld (camera_x), a
 12276	81A0	78				    ld a, b
 12277	81A1	32	2A	C6		    ld (camera_x + 1), a
 12278	81A4					
 12279	81A4					    ; Calculate camera_tile_x = camera_x / TILE_WIDTH
 12280	81A4					    
 12281	81A4					    ; Tile width is 16, shift right 4 times
 12282	81A4	79				    ld a, c
 12283	81A5	CB	38			    srl b
 12284	81A7	1F				    rra
 12285	81A8	CB	38			    srl b
