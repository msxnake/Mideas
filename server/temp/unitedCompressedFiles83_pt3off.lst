 11173	6FFF					; ------------------------------------------------------------------
 11174	6FFF					; force_render_hud
 11175	6FFF					; Force a HUD redraw on this frame, preserving caller-visible registers
 11176	6FFF					; Input:
 11177	6FFF					;   None
 11178	6FFF					; Output:
 11179	6FFF					;   None
 11180	6FFF					; Clobbers:
 11181	6FFF					;   None visible to caller
 11182	6FFF					; Preserves:
 11183	6FFF					;   AF, BC, DE, HL, IX
 11184	6FFF					; Notes:
 11185	6FFF					;   - Sets hud_dirty_flag = 1 and then calls render_hud
 11186	6FFF					; ------------------------------------------------------------------
 11187	6FFF					force_render_hud:
 11188	6FFF	F5				    push af
 11189	7000	3E	01			    ld a, 1
 11190	7002	32	32	C6		    ld (hud_dirty_flag), a
 11191	7005	CD	68	6F		    call render_hud
 11192	7008	F1				    pop af
 11193	7009	C9				    ret
