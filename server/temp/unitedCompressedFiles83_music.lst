 14501	89D2					; ==================================================================
 14502	89D2					; Action_ChangeSprite
 14503	89D2					; ------------------------------------------------------------------
 14504	89D2					; Cambia el sprite activo de una entidad. Realiza 5 operaciones:
 14505	89D2					;   1. Redirect direccional: si entity_facing_dir != 0, sustituye el
 14506	89D2					;      sprite pedido por su variante direccional (left/right/up/down)
 14507	89D2					;      usando SM_FacingDirTablePtrs.
 14508	89D2					;   2. Commit: escribe el sprite final en entity_sprite_asset_index.
 14509	89D2					;   3. Reset de animaci??n: pone entity_anim_frame y entity_anim_tick a 0.
 14510	89D2					;   4. Flags de animaci??n: activa PLAYING, aplica el flag de LOOP del
 14511	89D2					;      sprite, y para sprites one-shot borra ONLY_WHEN_MOVING para que
 14512	89D2					;      la animaci??n avance aunque la entidad est?? quieta.
 14513	89D2					;   5. Upload inmediato: copia el frame 0 del nuevo sprite a VRAM en
 14514	89D2					;      el mismo frame para que el cambio sea visible sin esperar al
 14515	89D2					;      siguiente ciclo de update_animation_component.
 14516	89D2					;   6. Colores de capas: actualiza sprite_layer_colors (tabla RAM) con
 14517	89D2					;      los colores del nuevo sprite desde SM_SpriteLayerColorTable.
 14518	89D2					;
 14519	89D2					; Input:
 14520	89D2					;   HL  = puntero al par??metro (sprite asset ID, 1 byte)
 14521	89D2					;   B   = entity index (convenci??n SM_ExecuteActions)
 14522	89D2					;
 14523	89D2					; Output:
 14524	89D2					;   HL  = puntero al byte siguiente a los par??metros (para el caller)
 14525	89D2					;
 14526	89D2					; Destruye: AF, BC, DE, HL (todos restaurados al salir salvo HL=next param)
 14527	89D2					;
 14528	89D2					; Stack al entrar (top ??? bottom):
 14529	89D2					;   [llamada desde SM_ExecuteActions]
 14530	89D2					; Stack al salir: igual que al entrar.
 14531	89D2					;
 14532	89D2					; Tablas ROM usadas:
 14533	89D2					;   SM_FacingDirTablePtrs      ??? punteros a las 4 tablas de redirect
 14534	89D2					;   sprite_loop_flags          ??? 1 byte/sprite: 0x02=loop, 0x00=one-shot
 14535	89D2					;   SM_SpritePatternPtrTable   ??? puntero al frame 0 de cada sprite
 14536	89D2					;   SM_SpriteLayerColorTable   ??? colores por sprite (SPRITE_MAX_ENTITY_LAYERS bytes/sprite)
 14537	89D2					;
 14538	89D2					; Variables RAM usadas:
 14539	89D2					;   entity_facing_dir          ??? direcci??n actual de la entidad (0-4)
 14540	89D2					;   entity_sprite_asset_index  ??? ??ndice del sprite activo de la entidad
 14541	89D2					;   entity_anim_frame          ??? frame actual de la animaci??n
 14542	89D2					;   entity_anim_tick           ??? contador de ticks entre frames
 14543	89D2					;   entity_anim_flags          ??? flags de animaci??n (ver bits m??s abajo)
 14544	89D2					;   entity_sprite_config       ??? base HW sprite + layer count (2 bytes/entidad)
 14545	89D2					;   sprite_layer_colors        ??? colores actuales por slot HW sprite (RAM)
 14546	89D2					;
 14547	89D2					; Bits de entity_anim_flags:
 14548	89D2					;   bit 0 = ANIM_FLAG_PLAYING       (1 = animando)
 14549	89D2					;   bit 1 = ANIM_FLAG_LOOP          (1 = bucle infinito, 0 = one-shot)
 14550	89D2					;   bit 2 = ANIM_FLAG_ONLY_WHEN_MOVING (1 = solo anima si vel != 0)
 14551	89D2					;   bit 3 = ANIM_FLAG_COMPLETED     (1 = one-shot lleg?? al ??ltimo frame)
 14552	89D2					;
 14553	89D2					; NOTA: el bloque de redirect direccional usa B como registro temporal
 14554	89D2					; para guardar el sprite ID. Al salir del bloque, B queda corrupto.
 14555	89D2					; Se restaura expl??citamente con "ld b, 0" antes de los add hl, bc.
 14556	89D2					; ==================================================================
 14557	89D2					Action_ChangeSprite:
 14558	89D2	7E				    ld a, (hl)              ; A = Sprite Asset ID pedido por la SM
 14559	89D3	23				    inc hl                  ; HL apunta al byte siguiente al par??metro
 14560	89D4	E5				    push hl                 ; [stack] guarda puntero de par??metros para el ret final
 14561	89D5					
 14562	89D5	F5				    push af                 ; [stack] guarda Sprite Asset ID (se necesita tras setup)
 14563	89D6					
 14564	89D6					    ; ------------------------------------------------------------------
 14565	89D6					    ; Setup: convertir B (entity index) a BC = (0, entity_index)
 14566	89D6					    ; Convenci??n de SM_ExecuteActions: B = entity index al entrar.
 14567	89D6					    ; ------------------------------------------------------------------
 14568	89D6	48				    ld c, b                 ; C = entity index
