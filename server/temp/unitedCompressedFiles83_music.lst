 5514	50F6					    ; ---------------------------------------------------------------
 5515	50F6					    ; Snap formula (DOWN / floor):
 5516	50F6					    ;   B = tile row that blocked us (from (bottom+1)/8 probe)
 5517	50F6					    ;   floor_top_pixel  = B * 8          ??? top pixel of the floor tile
 5518	50F6					    ;   new_hitbox_top   = B*8 - hitbox_h ??? push entity up so bottom edge
 5519	50F6					    ;                                       just sits on the floor surface
 5520	50F6					    ;   If underflow (hitbox_h > B*8): clamp new_hitbox_top to 0.
 5521	50F6					    ;   entity_y = new_hitbox_top - collision_offset_y
 5522	50F6					    ; After snap: vel_y = 0, gravity_vel = 0, entity_on_ground bit 0 set,
 5523	50F6					    ;             entity_wall_collision_flags bit 1 (DOWN) set.
 5524	50F6					    ; Note: jp .wall_next skips .check_wall_y_gravity intentionally ???
 5525	50F6					    ;       floor already detected; no redundant gravity probe needed.
