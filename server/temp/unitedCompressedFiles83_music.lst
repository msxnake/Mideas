 3398	47EE					; ------------------------------------------------------------------
 3399	47EE					; coll_add_signed_offset_clamped
 3400	47EE					; Input:  A = base coordinate (0..255)
 3401	47EE					;         HL = pointer to signed offset byte (-128..127, two's complement)
