 7050	5733					; get_tile_behavior
 7051	5733					; Get behavior/collision type of a tile
 7052	5733					; Input:  A = Tile ID (character code from screen map)
 7053	5733					; Output: A = Behavior flags (TILE_SOLID, TILE_PLATFORM, etc.)
 7054	5733					; Destroys: HL
