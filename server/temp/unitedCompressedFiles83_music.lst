 1656	41F6					; ==================================================================
 1657	41F6					; INTERRUPT_DISPATCHER - Main ISR (60Hz/50Hz)
 1658	41F6					; ==================================================================
 1659	41F6					; Register Contract:
 1660	41F6					;   Purpose: Dispatch enabled interrupt tasks each VBlank and chain BIOS hook.
 1661	41F6					;   Inputs:
 1662	41F6					;     - Triggered by H.TIMI hook
 1663	41F6					;   Outputs:
 1664	41F6					;     - interrupt_counter incremented
 1665	41F6					;     - vblank_flag refreshed
 1666	41F6					;   Clobbers:
 1667	41F6					;     - AF
 1668	41F6					;     - BC
 1669	41F6					;     - DE
 1670	41F6					;     - HL
 1671	41F6					;     - IX
 1672	41F6					;     - IY (all restored before exit)
 1673	41F6					;   Preserved:
 1674	41F6					;     - DE
 1675	41F6					;     - IX
 1676	41F6					;     - IY
 1677	41F6					;   Register roles:
 1678	41F6					;     - HL = walks task_table and holds task pointer
 1679	41F6					;     - B = task slot loop counter
 1680	41F6					;     - C = temporary low byte for pointer reconstruction
 1681	41F6					;     - A = enabled checks and pointer validation
 1682	41F6					;   Notes:
 1683	41F6					;     - Dispatcher saves/restores DE/IX/IY defensively, reducing coupling with task internals.
 1684	41F6					
 1685	41F6					; This routine executes on each V-Blank
 1686	41F6					; CRITICAL: Minimal CPU cycles, maximum efficiency
 1687	41F6					; Overhead: ~80 cycles base + ~40 cycles per active task
 1688	41F6					; ==================================================================
 1689	41F6					interrupt_dispatcher:
 1690	41F6					    ; --- STEP 1: Save caller-visible registers used by BIOS/user code ---
 1691	41F6	F5				    push af                     ; 11 cycles
 1692	41F7	E5				    push hl                     ; 11 cycles
 1693	41F8	C5				    push bc                     ; 11 cycles
 1694	41F9	D5				    push de                     ; 11 cycles
 1695	41FA	DD	E5			    push ix                     ; 15 cycles
 1696	41FC	FD	E5			    push iy                     ; 15 cycles
 1697	41FE					    ; Total: 74 cycles fixed prologue overhead
 1698	41FE					
 1699	41FE					    ; --- STEP 2: Check if system is enabled ---
 1700	41FE	3A	3E	D1		    ld a, (interrupt_system_enabled)
 1701	4201	B7				    or a
 1702	4202	28	2A			    jr z, .exit                 ; If disabled, exit quickly
 1703	4204					
 1704	4204					    ; --- STEP 3: Increment frame counter ---
 1705	4204	2A	44	D1		    ld hl, (interrupt_counter)
 1706	4207	23				    inc hl
 1707	4208	22	44	D1		    ld (interrupt_counter), hl
 1708	420B					
 1709	420B					    ; --- STEP 3.5: Update VBlank flag (reads VDP status) ---
 1710	420B	CD	3A	42		    call update_vblank_flag
 1711	420E					
 1712	420E					    ; --- STEP 4: Walk through task table ---
 1713	420E	21	2E	D1		    ld hl, task_table           ; HL = pointer to task table
 1714	4211	06	08			    ld b, 8                     ; 8 slots
 1715	4213					
 1716	4213					.task_loop:
 1717	4213					    ; Read task pointer (16-bit address)
 1718	4213	7E				    ld a, (hl)                  ; Low byte
 1719	4214	23				    inc hl
 1720	4215	4F				    ld c, a
 1721	4216	7E				    ld a, (hl)                  ; High byte
 1722	4217	23				    inc hl
 1723	4218	B1				    or c                        ; Check if pointer == 0
 1724	4219	28	11			    jr z, .next_task            ; Skip if disabled (pointer == 0)
 1725	421B					
 1726	421B					    ; Valid pointer: execute task
 1727	421B	2B				    dec hl
 1728	421C	2B				    dec hl                      ; Back to low byte
 1729	421D	C5				    push bc                     ; Save loop counter
 1730	421E	E5				    push hl                     ; Save table position
 1731	421F					
 1732	421F					    ; Load task address into HL
 1733	421F	4E				    ld c, (hl)                  ; Low byte
 1734	4220	23				    inc hl
 1735	4221	66				    ld h, (hl)                  ; High byte
 1736	4222	69				    ld l, c                     ; HL = task address
 1737	4223					
 1738	4223					    ; Call task using JP (HL) pattern (faster than indirect CALL)
 1739	4223	CD	39	42		    call .call_task             ; Call the task
 1740	4226					
 1741	4226	E1				    pop hl                      ; Restore table position
 1742	4227	C1				    pop bc                      ; Restore loop counter
 1743	4228	23				    inc hl
 1744	4229	23				    inc hl                      ; Advance to next slot
 1745	422A	18	00			    jr .continue_loop
 1746	422C					
 1747	422C					.next_task:
 1748	422C					    ; Nothing to do, HL already points to next slot
 1749	422C					
 1750	422C					.continue_loop:
 1751	422C	10	E5			    djnz .task_loop             ; Loop 8 times
 1752	422E					
 1753	422E					.exit:
 1754	422E					    ; --- STEP 5: Restore registers ---
 1755	422E	FD	E1			    pop iy                      ; 14 cycles
 1756	4230	DD	E1			    pop ix                      ; 14 cycles
 1757	4232	D1				    pop de                      ; 10 cycles
 1758	4233	C1				    pop bc                      ; 10 cycles
 1759	4234	E1				    pop hl                      ; 10 cycles
 1760	4235	F1				    pop af                      ; 10 cycles
 1761	4236					
 1762	4236					    ; --- STEP 6: Return from interrupt ---
 1763	4236					    ; For H.TIMI we should chain to the original hook (best compatibility)
 1764	4236					    ; and let the BIOS interrupt handler manage EI/RETI.
 1765	4236	C3	3F	D1		    jp old_htimi_hook
 1766	4239					
 1767	4239					; Helper for indirect call
 1768	4239					.call_task:
 1769	4239	E9				    jp (hl)                     ; Jump to task (task will RET back here)
