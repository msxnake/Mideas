 349	40B3					; ==================================================================
 350	40B3					; DIRECT HARDWARE ACCESS ROUTINES
 351	40B3					; ==================================================================
 352	40B3					; Mode: HYBRID
 353	40B3					; Optimize Level: safe
 354	40B3					; Debug: DISABLED
 355	40B3					;
 356	40B3					; These routines provide direct hardware access for maximum performance.
 357	40B3					; They replace BIOS calls in performance-critical sections.
 358	40B3					;
 359	40B3					; Performance Gains vs BIOS:
 360	40B3					;   FAST_LDIRVM:  ~40% faster (12,288 vs 20,480 cycles for 256 bytes)
 361	40B3					;   FAST_WRTVRM:  ~43% faster (40 vs 70 cycles)
 362	40B3					;   FAST_WRTVDP:  ~55% faster (25 vs 55 cycles)
 363	40B3					;   FAST_GTSTCK:  ~58% faster (50 vs 120 cycles)
 364	40B3					;   FAST_GTTRIG:  direct trigger read (joystick button)
 365	40B3					;   FAST_SNSMAT:  direct keyboard matrix row read
 366	40B3					;
 367	40B3					; Compatibility: MSX1, MSX2, MSX2+
 368	40B3					; ==================================================================
 369	40B3					
 370	40B3					
 371	40B3					; ==================================================================
 372	40B3					; FAST_LDIRVM - Fast Block Transfer to VRAM
 373	40B3					; ==================================================================
 374	40B3					; Register Contract:
 375	40B3					;   Purpose: Block copy from RAM to VRAM using VDP data port auto-increment.
 376	40B3					;   Inputs:
 377	40B3					;     - HL = source address (RAM)
 378	40B3					;     - DE = destination address (VRAM)
 379	40B3					;     - BC = byte count
 380	40B3					;   Outputs:
 381	40B3					;     - None
 382	40B3					;   Clobbers:
 383	40B3					;     - AF
 384	40B3					;     - BC
 385	40B3					;     - HL
 386	40B3					;   Preserved:
 387	40B3					;     - DE
 388	40B3					;   Register roles:
 389	40B3					;     - A = VDP address bytes and data byte being transferred
 390	40B3					;     - HL = RAM read pointer (increments each byte)
 391	40B3					;     - DE = only used to program initial VRAM address
 392	40B3					;     - BC = countdown loop counter
 393	40B3					;   Notes:
 394	40B3					;     - Caller must preserve AF/BC/HL if needed after call.
 395	40B3					
 396	40B3					; Replaces BIOS LDIRVM with direct hardware access
 397	40B3					;
 398	40B3					; Input:
 399	40B3					;   HL = Source address (RAM)
 400	40B3					;   DE = Destination address (VRAM)
 401	40B3					;   BC = Byte count
 402	40B3					;
 403	40B3					; Output:
 404	40B3					;   None
 405	40B3					;
 406	40B3					; Destroys:
 407	40B3					;   AF, BC, HL
 408	40B3					;
 409	40B3					; Performance:
 410	40B3					;   ~48 cycles/byte vs BIOS ~80+ cycles/byte
 411	40B3					;   For 256 bytes: 12,288 cycles vs 20,480+ (40% faster)
 412	40B3					;
 413	40B3					; Notes:
 414	40B3					;   - Auto-increments VRAM address (VDP feature)
 415	40B3					;   - Keeps IRQs masked for the whole transfer to avoid VDP port races
 416	40B3					;   - Restores previous IRQ enable state on return
 417	40B3					;   - Works on all MSX models (TMS9918, V9938, V9958)
 418	40B3					; ==================================================================
 419	40B3					FAST_LDIRVM:
 420	40B3					    ; Preserve previous IRQ state (LD A,I copies IFF2 into P/V)
 421	40B3	ED	57			    ld a, i
 422	40B5	F5				    push af
 423	40B6	F3				    di
 424	40B7					
 425	40B7					    ; Set VRAM write address
 426	40B7	7B				    ld a, e
 427	40B8	D3	99			    out (#99), a           ; Write address low byte to VDP
 428	40BA	00				    nop                    ; Real VDPs need a short settle time between control writes
 429	40BB	7A				    ld a, d
 430	40BC	F6	40			    or #40                 ; Set bit 6 for write mode
 431	40BE	D3	99			    out (#99), a           ; Write address high byte + write command
 432	40C0	00				    nop                    ; Let the VDP latch the address before the first data write
 433	40C1					
 434	40C1					    ; Copy loop
 435	40C1					.ldirvm_loop:
 436	40C1	7E				    ld a, (hl)             ; Read byte from RAM (7 cycles)
 437	40C2	D3	98			    out (#98), a           ; Write to VRAM data port (11 cycles)
 438	40C4	23				    inc hl                 ; Next source address (6 cycles)
 439	40C5	0B				    dec bc                 ; Decrement counter (6 cycles)
 440	40C6	78				    ld a, b                ; Check if BC = 0 (4 cycles)
 441	40C7	B1				    or c                   ; (4 cycles)
 442	40C8	20	F7			    jr nz, .ldirvm_loop    ; Loop if not zero (12/7 cycles)
 443	40CA					
 444	40CA					    ; Restore previous IRQ state
 445	40CA	F1				    pop af
 446	40CB	E0				    ret po                 ; P/V=0 => IRQs were disabled on entry
 447	40CC	FB				    ei
 448	40CD	C9				    ret
 449	40CE					
 450	40CE					
 451	40CE					; ==================================================================
 452	40CE					; FAST_WRTVRM - Write Single Byte to VRAM
 453	40CE					; ==================================================================
 454	40CE					; Register Contract:
 455	40CE					;   Purpose: Write one byte into VRAM while preserving caller-visible state.
 456	40CE					;   Inputs:
 457	40CE					;     - A = byte to write
 458	40CE					;     - HL = VRAM destination address
 459	40CE					;   Outputs:
 460	40CE					;     - None
 461	40CE					;   Clobbers:
 462	40CE					;     - None (all registers preserved)
 463	40CE					;   Preserved:
 464	40CE					;     - AF
 465	40CE					;     - BC
 466	40CE					;     - DE
 467	40CE					;     - HL
 468	40CE					;   Register roles:
 469	40CE					;     - A = temporarily saved/restored around VDP address programming
 470	40CE					;     - HL = VRAM address source (not modified)
 471	40CE					;   Notes:
 472	40CE					;     - Safe helper when the caller cannot tolerate register changes.
 473	40CE					
 474	40CE					; Replaces BIOS WRTVRM
 475	40CE					;
 476	40CE					; Input:
 477	40CE					;   A = Data byte to write
 478	40CE					;   HL = VRAM destination address
 479	40CE					;
 480	40CE					; Output:
 481	40CE					;   None
 482	40CE					;
 483	40CE					; Destroys:
 484	40CE					;   None (all registers preserved)
 485	40CE					;
 486	40CE					; Performance:
 487	40CE					;   ~40 cycles vs BIOS ~70 cycles (43% faster)
 488	40CE					;
 489	40CE					; Notes:
 490	40CE					;   - Preserves all registers including AF
 491	40CE					;   - VDP write sequence is atomic against ISR VRAM writes
 492	40CE					; ==================================================================
 493	40CE					FAST_WRTVRM:
 494	40CE					    ; Preserve caller-visible state and previous IRQ status.
 495	40CE	C5				    push bc
 496	40CF	4F				    ld c, a                ; C = input data byte
 497	40D0	F5				    push af                ; Save caller AF
 498	40D1	ED	57			    ld a, i
 499	40D3	F5				    push af                ; Save previous IFF2 in P/V
 500	40D4	F3				    di
 501	40D5	7D				    ld a, l
 502	40D6	D3	99			    out (#99), a           ; Address low (11 cycles)
 503	40D8	7C				    ld a, h
 504	40D9	F6	40			    or #40                 ; Write mode (7 cycles)
 505	40DB	D3	99			    out (#99), a           ; Address high + command (11 cycles)
 506	40DD	79				    ld a, c
 507	40DE	D3	98			    out (#98), a           ; Write to VRAM (11 cycles)
 508	40E0					
 509	40E0					    ; Restore previous IRQ state.
 510	40E0	F1				    pop af
 511	40E1	E2	E5	40		    jp po, .fwv_no_ei      ; P/V=0 => IRQs were disabled on entry
 512	40E4	FB				    ei
 513	40E5					.fwv_no_ei:
 514	40E5	F1				    pop af                 ; Restore caller AF
 515	40E6	C1				    pop bc
 516	40E7	C9				    ret
 517	40E8					
 518	40E8					
 519	40E8					; ==================================================================
 520	40E8					; FAST_RDVRM - Read Single Byte from VRAM
 521	40E8					; ==================================================================
 522	40E8					; Register Contract:
 523	40E8					;   Purpose: Read one byte from VRAM data port.
 524	40E8					;   Inputs:
 525	40E8					;     - HL = VRAM source address
 526	40E8					;   Outputs:
 527	40E8					;     - A = byte read from VRAM
 528	40E8					;   Clobbers:
 529	40E8					;     - AF
 530	40E8					;   Preserved:
 531	40E8					;     - BC
 532	40E8					;     - DE
 533	40E8					;     - HL
 534	40E8					;   Register roles:
 535	40E8					;     - A = VDP addressing command then read result
 536	40E8					;     - HL = address source only (unchanged)
 537	40E8					;   Notes:
 538	40E8					;     - Callers relying on flags must account for AF clobber.
 539	40E8					
 540	40E8					; Replaces BIOS RDVRM
 541	40E8					;
 542	40E8					; Input:
 543	40E8					;   HL = VRAM source address
 544	40E8					;
 545	40E8					; Output:
 546	40E8					;   A = Byte read from VRAM
 547	40E8					;
 548	40E8					; Destroys:
 549	40E8					;   AF
 550	40E8					;
 551	40E8					; Performance:
 552	40E8					;   ~35 cycles vs BIOS ~65 cycles (46% faster)
 553	40E8					;
 554	40E8					; Notes:
 555	40E8					;   - Useful for collision detection, tile reading
 556	40E8					;   - VDP requires small delay after address set before read
 557	40E8					; ==================================================================
 558	40E8					FAST_RDVRM:
 559	40E8	7D				    ld a, l
 560	40E9	D3	99			    out (#99), a           ; Address low
 561	40EB	7C				    ld a, h
 562	40EC	E6	3F			    and #3F                ; Clear bit 6 for read mode (bit 7 must be 0)
 563	40EE	D3	99			    out (#99), a           ; Address high + read command
 564	40F0	00				    nop                    ; VDP needs time to process address before read
 565	40F1	DB	98			    in a, (#98)            ; Read from VRAM data port
 566	40F3	C9				    ret
 567	40F4					
 568	40F4					
 569	40F4					; ==================================================================
 570	40F4					; FAST_WRTVDP - Write VDP Register
 571	40F4					; ==================================================================
 572	40F4					; Register Contract:
 573	40F4					;   Purpose: Write one VDP register value (value first, then register index).
 574	40F4					;   Inputs:
 575	40F4					;     - B = register value
 576	40F4					;     - C = register number
 577	40F4					;   Outputs:
 578	40F4					;     - None
 579	40F4					;   Clobbers:
 580	40F4					;     - AF
 581	40F4					;   Preserved:
 582	40F4					;     - BC
 583	40F4					;     - DE
 584	40F4					;     - HL
 585	40F4					;   Register roles:
 586	40F4					;     - A = output staging register for both OUT operations
 587	40F4					;     - B/C = preserved input pair for value and register id
 588	40F4					;   Notes:
 589	40F4					;     - Order of writes is mandatory for VDP register writes.
 590	40F4					
 591	40F4					; Replaces BIOS WRTVDP
 592	40F4					;
 593	40F4					; Input:
 594	40F4					;   B = Register value
 595	40F4					;   C = Register number (0-7 for MSX1, 0-23 for MSX2, 0-46 for MSX2+)
 596	40F4					;
 597	40F4					; Output:
 598	40F4					;   None
 599	40F4					;
 600	40F4					; Destroys:
 601	40F4					;   AF
 602	40F4					;
 603	40F4					; Performance:
 604	40F4					;   ~25 cycles vs BIOS ~55 cycles (55% faster)
 605	40F4					;
 606	40F4					; Notes:
 607	40F4					;   - Used for mode changes, colors, scroll, etc.
 608	40F4					;   - Register write order matters: value first, then register number
 609	40F4					; ==================================================================
 610	40F4					FAST_WRTVDP:
 611	40F4	78				    ld a, b                ; Get register value (4 cycles)
 612	40F5	D3	99			    out (#99), a           ; Write value first (11 cycles)
 613	40F7	79				    ld a, c                ; Get register number (4 cycles)
 614	40F8	F6	80			    or #80                 ; Set bit 7 for register write (7 cycles)
 615	40FA	D3	99			    out (#99), a           ; Write register select (11 cycles)
 616	40FC	C9				    ret                    ; (10 cycles)
 617	40FD					                           ; Total: ~25 cycles
 618	40FD					
 619	40FD					
 620	40FD					; ==================================================================
 621	40FD					; FAST_GTSTCK - Read Joystick Direction
 622	40FD					; ==================================================================
 623	40FD					; Register Contract:
 624	40FD					;   Purpose: Read joystick direction and map PSG bits to MSX GTSTCK direction code.
 625	40FD					;   Inputs:
 626	40FD					;     - A = joystick port (0 or 1)
 627	40FD					;   Outputs:
 628	40FD					;     - A = direction code (0-8)
 629	40FD					;   Clobbers:
 630	40FD					;     - AF
 631	40FD					;     - HL
 632	40FD					;   Preserved:
 633	40FD					;     - BC
 634	40FD					;     - DE
 635	40FD					;   Register roles:
 636	40FD					;     - A = PSG register selection, raw read, and final direction code
 637	40FD					;     - HL = lookup table pointer into joystick_direction_table
 638	40FD					;   Notes:
 639	40FD					;     - Bits are active-low; routine inverts and masks input nibble.
 640	40FD					
 641	40FD					; Replaces BIOS GTSTCK (which is notoriously slow)
 642	40FD					;
 643	40FD					; Input:
 644	40FD					;   A = Joystick port (0 = port 1, 1 = port 2)
 645	40FD					;
 646	40FD					; Output:
 647	40FD					;   A = Direction code (0-8)
 648	40FD					;       0 = Center (no direction)
 649	40FD					;       1 = Up
 650	40FD					;       2 = Up + Right
 651	40FD					;       3 = Right
 652	40FD					;       4 = Down + Right
 653	40FD					;       5 = Down
 654	40FD					;       6 = Down + Left
 655	40FD					;       7 = Left
 656	40FD					;       8 = Up + Left
 657	40FD					;
 658	40FD					; Destroys:
 659	40FD					;   AF, HL
 660	40FD					;
 661	40FD					; Performance:
 662	40FD					;   ~50 cycles vs BIOS ~120+ cycles (58% faster)
 663	40FD					;
 664	40FD					; Notes:
 665	40FD					;   - Reads from PSG register 14 (port 1) or 15 (port 2)
 666	40FD					;   - Joystick bits are active-low (inverted)
 667	40FD					;   - Uses lookup table for direction decoding
 668	40FD					; ==================================================================
 669	40FD					FAST_GTSTCK:
 670	40FD					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 671	40FD	0F				    rrca                   ; A = A / 2 (joystick port becomes 0 or 8)
 672	40FE	E6	0F			    and #0F                ; Mask to valid range
 673	4100	F6	0E			    or #0E                 ; Add 14 (base register for joystick)
 674	4102					
 675	4102					    ; Make PSG select+read atomic so VBlank music writes cannot
 676	4102					    ; corrupt the selected register mid-access.
 677	4102	F3				    di
 678	4103	D3	A0			    out (#A0), a           ; Write register number to PSG address port
 679	4105	DB	A2			    in a, (#A2)            ; Read value from PSG data port
 680	4107	FB				    ei
 681	4108					
 682	4108					    ; Process joystick data
 683	4108	2F				    cpl                    ; Invert bits (joystick is active-low)
 684	4109	E6	0F			    and #0F                ; Mask to 4 direction bits (Up, Down, Left, Right)
 685	410B					
 686	410B					    ; Lookup direction code from table
 687	410B	21	15	41		    ld hl, joystick_direction_table
 688	410E	85				    add a, l               ; Add offset to table base
 689	410F	6F				    ld l, a
 690	4110	8C				    adc a, h               ; Handle carry if table crosses page boundary
 691	4111	95				    sub l
 692	4112	67				    ld h, a
 693	4113	7E				    ld a, (hl)             ; Get direction code (0-8)
 694	4114	C9				    ret
 695	4115					
 696	4115					; Direction lookup table (16 entries for all 4-bit combinations)
 697	4115					; MSX PSG register 14 joystick bit order:
 698	4115					;   Bit 0 = Up    (0001)
 699	4115					;   Bit 1 = Down  (0010)
 700	4115					;   Bit 2 = Left  (0100)
 701	4115					;   Bit 3 = Right (1000)
 702	4115					; Value: GTSTCK-compatible direction code (0-8)
 703	4115					joystick_direction_table:
 704	4115	00				    db 0  ; 0000 = Center
 705	4116	01				    db 1  ; 0001 = Up
 706	4117	05				    db 5  ; 0010 = Down
 707	4118	00				    db 0  ; 0011 = Up+Down (invalid)
 708	4119	07				    db 7  ; 0100 = Left
 709	411A	08				    db 8  ; 0101 = Up+Left
 710	411B	06				    db 6  ; 0110 = Down+Left
 711	411C	00				    db 0  ; 0111 = Invalid
 712	411D	03				    db 3  ; 1000 = Right
 713	411E	02				    db 2  ; 1001 = Up+Right
 714	411F	04				    db 4  ; 1010 = Down+Right
 715	4120	00				    db 0  ; 1011 = Invalid
 716	4121	00				    db 0  ; 1100 = Left+Right (invalid)
 717	4122	00				    db 0  ; 1101 = Invalid
 718	4123	00				    db 0  ; 1110 = Invalid
 719	4124	00				    db 0  ; 1111 = All directions (invalid)
 720	4125					
 721	4125					
 722	4125					; ==================================================================
 723	4125					; FAST_GTTRIG - Read Joystick Trigger
 724	4125					; ==================================================================
 725	4125					; Register Contract:
 726	4125					;   Purpose: Read joystick trigger bit directly from PSG register.
 727	4125					;   Inputs:
 728	4125					;     - A = joystick port (0 or 1)
 729	4125					;   Outputs:
 730	4125					;     - A = #FF if pressed, #00 if released
 731	4125					;   Clobbers:
 732	4125					;     - AF
 733	4125					;   Preserved:
 734	4125					;     - BC
 735	4125					;     - DE
 736	4125					;     - HL
 737	4125					;   Register roles:
 738	4125					;     - A = register select, raw PSG read, and normalized return value
 739	4125					;   Notes:
 740	4125					;     - Trigger is active-low in PSG bit 4.
 741	4125					
 742	4125					; Direct hardware replacement for BIOS GTTRIG
 743	4125					;
 744	4125					; Input:
 745	4125					;   A = Joystick port (0 = port 1, 1 = port 2)
 746	4125					;
 747	4125					; Output:
 748	4125					;   A = #FF if pressed, 0 if released
 749	4125					;
 750	4125					; Destroys:
 751	4125					;   AF
 752	4125					;
 753	4125					; Notes:
 754	4125					;   - Reads PSG register 14/15 directly
 755	4125					;   - Trigger bit is active-low
 756	4125					; ==================================================================
 757	4125					FAST_GTTRIG:
 758	4125					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 759	4125	0F				    rrca
 760	4126	E6	0F			    and #0F
 761	4128	F6	0E			    or #0E
 762	412A					
 763	412A					    ; Make PSG select+read atomic so VBlank music writes cannot
 764	412A					    ; corrupt the selected register mid-access.
 765	412A	F3				    di
 766	412B	D3	A0			    out (#A0), a
 767	412D	DB	A2			    in a, (#A2)
 768	412F	FB				    ei
 769	4130					
 770	4130					    ; Trigger bit (bit 4): 0 when pressed, 1 when released
 771	4130	E6	10			    and #10
 772	4132	3E	00			    ld a, #00
 773	4134	C0				    ret nz
 774	4135	3E	FF			    ld a, #FF
 775	4137	C9				    ret
 776	4138					
 777	4138					
 778	4138					; ==================================================================
 779	4138					; FAST_SNSMAT - Sense Keyboard Matrix Row
 780	4138					; ==================================================================
 781	4138					; Register Contract:
 782	4138					;   Purpose: Select keyboard matrix row via PPI and return row state.
 783	4138					;   Inputs:
 784	4138					;     - A = matrix row (0-11)
 785	4138					;   Outputs:
 786	4138					;     - A = row bits (active-low)
 787	4138					;   Clobbers:
 788	4138					;     - AF
 789	4138					;     - C
 790	4138					;   Preserved:
 791	4138					;     - B
 792	4138					;     - DE
 793	4138					;     - HL
 794	4138					;   Register roles:
 795	4138					;     - A = row selector composition and final row read
 796	4138					;     - C = cached low nibble used to build PPI port C output
 797	4138					;   Notes:
 798	4138					;     - Upper nibble of current PPI port C is preserved.
 799	4138					
 800	4138					; Direct hardware replacement for BIOS SNSMAT
 801	4138					;
 802	4138					; Input:
 803	4138					;   A = row (0-11)
 804	4138					;
 805	4138					; Output:
 806	4138					;   A = row bits (active-low, 0=pressed)
 807	4138					;
 808	4138					; Destroys:
 809	4138					;   AF, C
 810	4138					; ==================================================================
 811	4138					FAST_SNSMAT:
 812	4138	E6	0F			    and #0F                 ; Keep valid row bits
 813	413A	4F				    ld c, a
 814	413B	DB	AA			    in a, (#AA)             ; Read current PPI port C
 815	413D	E6	F0			    and #F0                 ; Preserve upper nibble
 816	413F	B1				    or c                    ; Set keyboard row in lower nibble
 817	4140	D3	AA			    out (#AA), a            ; Select row
 818	4142	DB	A9			    in a, (#A9)             ; Read keyboard matrix row
 819	4144	C9				    ret
 820	4145					
 821	4145					
 822	4145					; ==================================================================
 823	4145					; END OF DIRECT HARDWARE ROUTINES
