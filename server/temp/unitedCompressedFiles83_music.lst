 18360	9A10					; ==================================================================
 18361	9A10					; GAMEFLOW EXECUTION ENGINE
 18362	9A10					; File: gameflow.asm
 18363	9A10					; Description: GameFlow-based game orchestration system
 18364	9A10					; ==================================================================
 18365	9A10					;
 18366	9A10					; GameFlow: Main
 18367	9A10					; Total Nodes: 10
 18368	9A10					; Total Connections: 11
 18369	9A10					; Start Node: gf_start_1770754183471
 18370	9A10					;
 18371	9A10					; ARCHITECTURE:
 18372	9A10					; - GameFlow is the SOLE execution orchestrator
 18373	9A10					; - Each node generates its own execution code
 18374	9A10					; - Connections between nodes define the complete flow
 18375	9A10					; - No hardcoded main_loop outside GameFlow
 18376	9A10					; ==================================================================
 18377	9A10					
 18378	9A10					; ==================================================================
 18379	9A10					; GAMEFLOW INITIALIZATION
 18380	9A10					; ==================================================================
 18381	9A10					
 18382	9A10					gameflow_init:
 18383	9A10					    ; Initialize GameFlow system
 18384	9A10					    ; Reset state
 18385	9A10	AF				    xor a
 18386	9A11	32	07	C0		    ld (gameflow_exit_requested), a
 18387	9A14	32	05	C0		    ld (current_flow_state), a
 18388	9A17	C9				    ret
 18389	9A18					
 18390	9A18					; Main entry point - called from init_rom
 18391	9A18					; This is where the game STARTS
 18392	9A18					gameflow_start:
 18393	9A18					    ; Load the Start node
 18394	9A18	21	7B	A0		    ld hl, gameflow_node_gf_start_1770754183471
 18395	9A1B	C3	1E	9A		    jp gameflow_execute_node
 18396	9A1E					
 18397	9A1E					; ==================================================================
 18398	9A1E					; CORE EXECUTION ENGINE
 18399	9A1E					; ==================================================================
 18400	9A1E					
 18401	9A1E					; Execute a GameFlow node
 18402	9A1E					; Input: HL = address of node structure
 18403	9A1E					; 
 18404	9A1E					; Node Structure:
 18405	9A1E					;   +0: Node type (byte)
 18406	9A1E					;   +1-2: Data pointer (word) - node-specific data
 18407	9A1E					;   +3-4: Connection table pointer (word)
 18408	9A1E					;
 18409	9A1E					gameflow_execute_node:
 18410	9A1E					    ; Read node type
 18411	9A1E	7E				    ld a, (hl)
 18412	9A1F	23				    inc hl
 18413	9A20					    
 18414	9A20					    ; Save data pointer and connection table pointer for handlers
 18415	9A20	5E				    ld e, (hl)
 18416	9A21	23				    inc hl
 18417	9A22	56				    ld d, (hl)      ; DE = data pointer
 18418	9A23	23				    inc hl
 18419	9A24	4E				    ld c, (hl)
 18420	9A25	23				    inc hl
 18421	9A26	46				    ld b, (hl)      ; BC = connection table pointer
 18422	9A27					    
 18423	9A27					    ; DE = node data, BC = connection table
 18424	9A27					    ; Dispatch based on node type
 18425	9A27	FE	00			    cp NODE_TYPE_START
 18426	9A29	CA	4B	9A		    jp z, gameflow_handle_start
 18427	9A2C	FE	01			    cp NODE_TYPE_WORLD_LINK
 18428	9A2E	CA	66	9A		    jp z, gameflow_handle_worldlink
 18429	9A31	FE	07			    cp NODE_TYPE_END
 18430	9A33	CA	9F	9A		    jp z, gameflow_handle_end
 18431	9A36	FE	04			    cp NODE_TYPE_TEXT
 18432	9A38	CA	2C	9B		    jp z, gameflow_handle_text
 18433	9A3B	FE	03			    cp NODE_TYPE_SUB_MENU
 18434	9A3D	CA	C8	9B		    jp z, gameflow_handle_submenu
 18435	9A40	FE	05			    cp NODE_TYPE_TRANSITION
 18436	9A42	CA	70	9E		    jp z, gameflow_handle_transition
 18437	9A45	FE	0C			    cp NODE_TYPE_MUSIC
 18438	9A47	CA	14	A0		    jp z, gameflow_handle_music
 18439	9A4A					    
 18440	9A4A					    ; Unknown node type - error
 18441	9A4A	C9				    ret
 18442	9A4B					
 18443	9A4B					; ==================================================================
 18444	9A4B					; NODE TYPE HANDLERS
 18445	9A4B					; Each handler receives:
 18446	9A4B					;   DE = node data pointer
 18447	9A4B					;   BC = connection table pointer
 18448	9A4B					; ==================================================================
 18449	9A4B					
 18450	9A4B					gameflow_handle_start:
 18451	9A4B					    ; Start node - Initialize game state and systems
 18452	9A4B					    ; DE = node data pointer:
 18453	9A4B					    ;   [init_routine_ptr DW][init_routine_bank DB]
 18454	9A4B					    ; BC = connection table
 18455	9A4B					
 18456	9A4B	C5				    push bc         ; Save connection table
 18457	9A4C					
 18458	9A4C					    ; Execute initialization routine
 18459	9A4C					    ; DE points to start_init_data structure
 18460	9A4C	EB				    ex de, hl
 18461	9A4D	5E				    ld e, (hl)
 18462	9A4E	23				    inc hl
 18463	9A4F	56				    ld d, (hl)      ; DE = initialization routine address
 18464	9A50	23				    inc hl
 18465	9A51	46				    ld b, (hl)      ; B = initialization routine bank
 18466	9A52	62				    ld h, d
 18467	9A53	6B				    ld l, e         ; HL = initialization routine address
 18468	9A54					
 18469	9A54					    ; Call initialization routine (if not null)
 18470	9A54	7C				    ld a, h
 18471	9A55	B5				    or l
 18472	9A56	28	04			    jr z, .skip_init
 18473	9A58					
 18474	9A58					    ; Mapper-safe far call (auto window from HL address)
 18475	9A58	78				    ld a, b
 18476	9A59	CD	AC	41		    call mapper_call_hl_auto
 18477	9A5C					
 18478	9A5C					.skip_init:
 18479	9A5C					    ; Continue to next node
 18480	9A5C	C1				    pop bc
 18481	9A5D	CD	22	A0		    call gameflow_get_default_connection
 18482	9A60	7C				    ld a, h
 18483	9A61	B5				    or l
 18484	9A62	C8				    ret z           ; No connection
 18485	9A63	C3	1E	9A		    jp gameflow_execute_node
 18486	9A66					
 18487	9A66					gameflow_handle_worldlink:
 18488	9A66					    ; WorldLink node - load world and enter game loop
 18489	9A66					    ; DE = world data pointer:
 18490	9A66					    ;   [load_world_ptr DW][load_world_bank DB]
 18491	9A66					    ; BC = connection table (for exit)
 18492	9A66					
 18493	9A66	C5				    push bc         ; Save connection table
 18494	9A67					
 18495	9A67					    ; Load the world
 18496	9A67					    ; DE points to: dw load_world_X, db load_world_bank
 18497	9A67	EB				    ex de, hl
 18498	9A68	5E				    ld e, (hl)
 18499	9A69	23				    inc hl
 18500	9A6A	56				    ld d, (hl)
 18501	9A6B	23				    inc hl
 18502	9A6C	46				    ld b, (hl)      ; B = load_world_X bank
 18503	9A6D	62				    ld h, d
 18504	9A6E	6B				    ld l, e         ; HL = load_world_X address
 18505	9A6F					
 18506	9A6F					    ; Mapper-safe far call to world load routine
 18507	9A6F	7C				    ld a, h
 18508	9A70	B5				    or l
 18509	9A71	28	04			    jr z, .after_load
 18510	9A73	78				    ld a, b
 18511	9A74	CD	AC	41		    call mapper_call_hl_auto
 18512	9A77					
 18513	9A77					.after_load:
 18514	9A77					    ; Set game state
 18515	9A77	3E	01			    ld a, FLOW_STATE_GAME
 18516	9A79	32	05	C0		    ld (current_flow_state), a
 18517	9A7C					
 18518	9A7C					    ; Update sprites
