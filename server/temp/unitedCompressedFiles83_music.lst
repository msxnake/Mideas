 12160	7356					; ------------------------------------------------------------------
 12161	7356					; music_update
 12162	7356					; Update PT3 playback. Called every frame from ISR.
 12163	7356					; Checks end-of-song flag, handles loop/stop, runs PT3_ROUT+PT3_PLAY.
 12164	7356					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 12165	7356					; ------------------------------------------------------------------
 12166	7356					music_update:
 12167	7356	3A	4D	D1		    ld a, (music_active)
 12168	7359	B7				    or a
 12169	735A	C8				    ret z
 12170	735B	3A	4E	D1		    ld a, (music_muted)
 12171	735E	B7				    or a
 12172	735F	C0				    ret nz
 12173	7360					    ; Check if song ended (CHECKLP sets bit7 of PT3_SETUP)
 12174	7360	3A	74	D1		    ld a, (PT3_SETUP)
 12175	7363	CB	7F			    bit 7, a
 12176	7365	28	27			    jr z, .pt3_upd_play
 12177	7367					    ; Song ended - loop or stop?
 12178	7367	3A	4F	D1		    ld a, (music_loop)
 12179	736A	B7				    or a
 12180	736B	28	1C			    jr z, .pt3_upd_stop
 12181	736D					    ; Loop: reinitialise from same track
 12182	736D	3A	50	D1		    ld a, (music_track_index)
 12183	7370	87				    add a, a
 12184	7371	5F				    ld e, a
 12185	7372	16	00			    ld d, 0
 12186	7374	21	CC	79		    ld hl, music_pt3_track_table
 12187	7377	19				    add hl, de
 12188	7378	5E				    ld e, (hl)
 12189	7379	23				    inc hl
 12190	737A	56				    ld d, (hl)
 12191	737B	62				    ld h, d
 12192	737C	6B				    ld l, e
 12193	737D	DD	E5			    push ix
 12194	737F	FD	E5			    push iy
 12195	7381	CD	BA	73		    call PT3_INIT
 12196	7384	FD	E1			    pop iy
 12197	7386	DD	E1			    pop ix
 12198	7388	C9				    ret
 12199	7389					.pt3_upd_stop:
 12200	7389	AF				    xor a
