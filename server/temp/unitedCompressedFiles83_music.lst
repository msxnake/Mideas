 4767	4DF2					    ; Initialize all lifetimes to 0 (infinite by default)
 4768	4DF2	21	40	C9		    ld hl, entity_lifetime
 4769	4DF5	11	41	C9		    ld de, entity_lifetime+1
 4770	4DF8	01	1F	00		    ld bc, 31
