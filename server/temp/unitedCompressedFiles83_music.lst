 8573	5FBA					; Helper function to set VDP background and border colors
 8574	5FBA					; Input: A = background color (0-15), B = border color (0-15)
 8575	5FBA					set_screen_colors:
 8576	5FBA	F5				    push af
 8577	5FBB	C5				    push bc
 8578	5FBC	E5				    push hl
 8579	5FBD					
 8580	5FBD					    ; Set VDP Register 7: [Background Color (4-7) | Border Color (0-3)]
 8581	5FBD					
 8582	5FBD					    ; OPTIMIZED: Use lookup table instead of 4?? RLCA
 8583	5FBD					    ; Process Background Color (in A) -> High Nibble
 8584	5FBD	E6	0F			    and #0F                    ; Ensure 0-15 range
 8585	5FBF	21	AA	5F		    ld hl, color_shift_table
 8586	5FC2	85				    add a, l                   ; Add offset to table base
 8587	5FC3	6F				    ld l, a
 8588	5FC4	8C				    adc a, h                   ; Handle carry
 8589	5FC5	95				    sub l
 8590	5FC6	67				    ld h, a
 8591	5FC7	7E				    ld a, (hl)                 ; A = background color << 4
 8592	5FC8	4F				    ld c, a                    ; Save shifted background in C
 8593	5FC9					
 8594	5FC9					    ; Process Border Color (in B) -> Low Nibble
 8595	5FC9	78				    ld a, b                    ; Get border color
 8596	5FCA	E6	0F			    and #0F                    ; Ensure 0-15 range
 8597	5FCC					
 8598	5FCC					    ; Combine
 8599	5FCC	B1				    or c                       ; Combine: background << 4 | border
 8600	5FCD					
 8601	5FCD	47				    ld b, a                    ; Value for VDP R#7
 8602	5FCE	0E	07			    ld c, 7                    ; VDP Register 7
 8603	5FD0	CD	F4	40		    call FAST_WRTVDP           ; BIOS call to write VDP register
 8604	5FD3					
 8605	5FD3	E1				    pop hl
 8606	5FD4	C1				    pop bc
 8607	5FD5	F1				    pop af
 8608	5FD6	C9				    ret
