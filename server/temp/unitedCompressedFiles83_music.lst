 13622	8650					
 13623	8650					; ------------------------------------------------------------------
 13624	8650					; draw_particle_tile
 13625	8650					; Draw particle at its position using its tile ID
 13626	8650					; Input:  HL = Address of particle structure
 13627	8650					; Destroys: AF, BC, DE, HL
 13628	8650					; ------------------------------------------------------------------
 13629	8650					draw_particle_tile:
 13630	8650	E5				    push hl
 13631	8651					
 13632	8651					    ; Get position (offsets 2, 3)
 13633	8651	23				    inc hl
 13634	8652	23				    inc hl
 13635	8653	46				    ld b, (hl)                  ; B = X tile
 13636	8654	23				    inc hl
 13637	8655	4E				    ld c, (hl)                  ; C = Y tile
 13638	8656					
 13639	8656					    ; Get tile ID (offset 5)
 13640	8656	23				    inc hl
 13641	8657	23				    inc hl
 13642	8658	7E				    ld a, (hl)                  ; A = tile ID
 13643	8659					
 13644	8659					    ; Calculate name table address
 13645	8659					    ; NAMETBL + (Y * 32) + X
 13646	8659	F5				    push af                     ; Save tile ID
 13647	865A	79				    ld a, c
 13648	865B	87				    add a, a
 13649	865C	87				    add a, a
 13650	865D	87				    add a, a
 13651	865E	87				    add a, a
 13652	865F	87				    add a, a                    ; Y * 32
 13653	8660	80				    add a, b                    ; + X
 13654	8661	5F				    ld e, a
 13655	8662	16	00			    ld d, 0
 13656	8664	21	00	18		    ld hl, NAMETBL
 13657	8667	19				    add hl, de                  ; HL = VRAM address
 13658	8668					
 13659	8668					    ; Write tile ID to name table
 13660	8668	F1				    pop af                      ; Restore tile ID
 13661	8669	CD	4D	00		    call WRTVRM
 13662	866C					
 13663	866C					    ; Now update pattern in VRAM
 13664	866C	E1				    pop hl
 13665	866D	E5				    push hl
 13666	866E	CD	8D	86		    call update_particle_pattern
 13667	8671					
 13668	8671	E1				    pop hl
 13669	8672	C9				    ret
