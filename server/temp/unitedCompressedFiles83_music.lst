 7342	5842					
 7343	5842					; ------------------------------------------------------------------
 7344	5842					; check_collision_at_point
 7345	5842					; Check if there's a solid tile at given pixel coordinates
 7346	5842					; Input:  D = X position, E = Y position
 7347	5842					; Output: Z flag set if passable, cleared if solid
 7348	5842					;         A = Behavior flags of tile at that position
 7349	5842					; Destroys: BC, HL
 7350	5842					; ------------------------------------------------------------------
 7351	5842					check_collision_at_point:
 7352	5842	CD	F5	56		    call get_tile_at_position
 7353	5845	C8				    ret z                         ; Out of bounds = passable
 7354	5846	CD	33	57		    call get_tile_behavior
 7355	5849	E6	03			    and TILE_SOLID | TILE_PLATFORM
 7356	584B	C9				    ret                           ; Z if passable, NZ if solid
 7357	584C					
 7358	584C					; ------------------------------------------------------------------
 7359	584C					; check_collision_box
 7360	584C					; Check collision for entity bounding box (16x16)
 7361	584C					; Input:  D = X position (top-left), E = Y position (top-left)
 7362	584C					; Output: Z flag set if no collision, cleared if collision detected
 7363	584C					;         A = Behavior flags of colliding tile
 7364	584C					; Destroys: BC, HL
 7365	584C					; ------------------------------------------------------------------
 7366	584C					check_collision_box:
 7367	584C					    ; Check 4 corners of 16x16 box:
 7368	584C					    ; Top-left (X, Y)
 7369	584C	D5				    push de
 7370	584D	CD	42	58		    call check_collision_at_point
 7371	5850	20	28			    jr nz, .collision_found
 7372	5852					
 7373	5852					    ; Top-right (X+15, Y)
 7374	5852	D1				    pop de
 7375	5853	D5				    push de
 7376	5854	7A				    ld a, d
 7377	5855	C6	0F			    add a, 15
 7378	5857	57				    ld d, a
 7379	5858	CD	42	58		    call check_collision_at_point
 7380	585B	20	1D			    jr nz, .collision_found
 7381	585D					
 7382	585D					    ; Bottom-left (X, Y+15)
 7383	585D	D1				    pop de
 7384	585E	D5				    push de
 7385	585F	7B				    ld a, e
 7386	5860	C6	0F			    add a, 15
 7387	5862	5F				    ld e, a
 7388	5863	CD	42	58		    call check_collision_at_point
 7389	5866	20	12			    jr nz, .collision_found
 7390	5868					
 7391	5868					    ; Bottom-right (X+15, Y+15)
 7392	5868	D1				    pop de
 7393	5869	D5				    push de
 7394	586A	7A				    ld a, d
 7395	586B	C6	0F			    add a, 15
 7396	586D	57				    ld d, a
 7397	586E	7B				    ld a, e
 7398	586F	C6	0F			    add a, 15
 7399	5871	5F				    ld e, a
 7400	5872	CD	42	58		    call check_collision_at_point
 7401	5875	20	03			    jr nz, .collision_found
 7402	5877					
 7403	5877					    ; No collision
 7404	5877	D1				    pop de
 7405	5878	AF				    xor a                         ; Z flag set
 7406	5879	C9				    ret
 7407	587A					
 7408	587A					.collision_found:
 7409	587A	D1				    pop de
 7410	587B	B7				    or a                          ; Clear Z flag
 7411	587C	C9				    ret
 7412	587D					
 7413	587D					; ------------------------------------------------------------------
 7414	587D					; div_a_by_c
 7415	587D					; Divide A by C (unsigned 8-bit division)
 7416	587D					; Input:  A = dividend, C = divisor
 7417	587D					; Output: A = quotient
 7418	587D					; Destroys: B
 7419	587D					; ------------------------------------------------------------------
 7420	587D					div_a_by_c:
 7421	587D	06	00			    ld b, 0                       ; B = quotient
 7422	587F					.tile_div_loop:
 7423	587F	91				    sub c
 7424	5880	38	03			    jr c, .tile_div_done
 7425	5882	04				    inc b
 7426	5883	18	FA			    jr .tile_div_loop
 7427	5885					.tile_div_done:
 7428	5885	78				    ld a, b
 7429	5886	C9				    ret
