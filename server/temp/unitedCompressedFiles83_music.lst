 7453	5887					; ==================================================================
 7454	5887					tile_pattern_bank0:
 7455	5887					    ; ZX0 compressed tile_pattern (144 -> 125 bytes)
 7456	5887	29	00	7F	68	00	E0	EC	00	74	00	EF	A0	00	11	22	00	    DB #29,#00,#7F,#68,#00,#E0,#EC,#00,#74,#00,#EF,#A0,#00,#11,#22,#00
 7457	5897	22	71	00	F0	F1	00	70	04	A6	41	00	11	02	00	05	20	    DB #22,#71,#00,#F0,#F1,#00,#70,#04,#A6,#41,#00,#11,#02,#00,#05,#20
 7458	58A7	C2	00	7E	FF	00	F7	08	FF	7E	18	30	19	18	0C	86	98	    DB #C2,#00,#7E,#FF,#00,#F7,#08,#FF,#7E,#18,#30,#19,#18,#0C,#86,#98
 7459	58B7	80	18	3C	7E	9B	34	18	01	98	F0	1F	80	FE	FF	FF	DF	    DB #80,#18,#3C,#7E,#9B,#34,#18,#01,#98,#F0,#1F,#80,#FE,#FF,#FF,#DF
 7460	58C7	AF	DF	FF	7F	70	8A	80	20	82	42	28	09	80	A2	42	08	    DB #AF,#DF,#FF,#7F,#70,#8A,#80,#20,#82,#42,#28,#09,#80,#A2,#42,#08
 7461	58D7	02	10	BA	00	F7	09	20	BA	40	00	04	01	FF	38	3E	F7	    DB #02,#10,#BA,#00,#F7,#09,#20,#BA,#40,#00,#04,#01,#FF,#38,#3E,#F7
 7462	58E7	FD	2A	FF	A9	A5	EA	E2	10	98	7C	38	10	82	D0	D0	C0	    DB #FD,#2A,#FF,#A9,#A5,#EA,#E2,#10,#98,#7C,#38,#10,#82,#D0,#D0,#C0
 7463	58F7	C0	E4	FB	BD	D0	0B	0B	03	03	FF	FF	55	56	    DB #C0,#E4,#FB,#BD,#D0,#0B,#0B,#03,#03,#FF,#FF,#55,#56
 7464	5904					load_pattern_bank0:
 7465	5904					    ; Load pattern bank 0 to VRAM (base patterns)
 7466	5904					    ; Fast direct port access (no BIOS overhead)
 7467	5904	CD	76	41		    call mapper_push_p2
 7468	5907	3A	00	00		    ld a, PATTERN_DATA_BANK
 7469	590A	CD	5D	41		    call mapper_set_bank_p2
 7470	590D					    ; Decompress ZX0 tile pattern data into RAM buffer
 7471	590D	F3				    di
 7472	590E	21	87	58		    ld hl, tile_pattern_bank0
 7473	5911	11	00	DA		    ld de, ZX0_TILE_PATTERN_BUFFER
 7474	5914	CD	E8	AB		    call dzx0_standard
 7475	5917	FB				    ei
 7476	5918	21	00	DA		    ld hl, ZX0_TILE_PATTERN_BUFFER
 7477	591B	11	00	04		    ld de, CHRTBL2 + (128 * 8)    ; VRAM pattern table bank 0 (start at char 128)
 7478	591E	01	90	00		    ld bc, 144    ; Total bytes for all tile characters (16x16 tiles = 4 chars each)
 7479	5921	CD	B3	40		    call FAST_LDIRVM              ; Fast VRAM write (direct port access)
 7480	5924	CD	7D	41		    call mapper_pop_p2
 7481	5927	C9				    ret
 7482	5928					
 7483	5928					load_pattern_bank1:
 7484	5928					    ; Load pattern bank 1: same patterns as bank 0 (MSX Screen 2 standard)
 7485	5928					    ; Fast direct port access (no BIOS overhead)
 7486	5928	CD	76	41		    call mapper_push_p2
 7487	592B	3A	00	00		    ld a, PATTERN_DATA_BANK
 7488	592E	CD	5D	41		    call mapper_set_bank_p2
 7489	5931					    ; Decompress ZX0 tile pattern data into RAM buffer
 7490	5931	F3				    di
 7491	5932	21	87	58		    ld hl, tile_pattern_bank0
 7492	5935	11	00	DA		    ld de, ZX0_TILE_PATTERN_BUFFER
 7493	5938	CD	E8	AB		    call dzx0_standard
 7494	593B	FB				    ei
 7495	593C	21	00	DA		    ld hl, ZX0_TILE_PATTERN_BUFFER
 7496	593F	11	00	0C		    ld de, CHRTBL2 + #800 + (128 * 8) ; VRAM pattern table bank 1 (+#800 offset + char 128)
 7497	5942	01	90	00		    ld bc, 144    ; Total bytes for all tile characters
 7498	5945	CD	B3	40		    call FAST_LDIRVM              ; Fast VRAM write (direct port access)
 7499	5948	CD	7D	41		    call mapper_pop_p2
 7500	594B	C9				    ret
