 17973	97DD					
 17974	97DD					.get_global_var:
 17975	97DD					    ; VarID >= 6: Global variable
 17976	97DD					    ; Get address from SM_GlobalVarTable
 17977	97DD	D6	06			    sub 6                   ; A = VarID - 6
 17978	97DF	6F				    ld l, a
 17979	97E0	26	00			    ld h, 0
