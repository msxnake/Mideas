 6816	5678					; ensure_used_entity_list_current
 6817	5678					; Rebuild compact list only when marked dirty.
 6818	5678					; ------------------------------------------------------------------
 6819	5678					; Register Contract:
 6820	5678					;   Purpose: Conditionally rebuild compact active list only when dirty.
 6821	5678					;   Inputs:
