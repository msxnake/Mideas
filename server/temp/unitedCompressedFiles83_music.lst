 19503	9E70					gameflow_handle_transition:
 19504	9E70					    ; Transition node - visual screen wipe/fade effect
 19505	9E70					    ; DE = transition data pointer (db effect_id)
 19506	9E70					    ; BC = connection table
 19507	9E70	C5				    push bc
 19508	9E71	CD	84	9E		    call execute_transition_effect
 19509	9E74					    ; Restore VRAM after transition:
 19510	9E74					    ; 1. Tile colors (chars 128+) ??? corrupted by color-table effects (#11 = black)
 19511	9E74	CD	19	5A		    call load_colors_to_vram
 19512	9E77					    ; 2. Font patterns + colors (chars 0-127) ??? also zeroed by color-table effects.
 19513	9E77					    ;    init_font_system reloads both pattern bytes and color attributes for all
 19514	9E77					    ;    font characters.  If no font is used in the project this is a no-op (ret).
 19515	9E77	CD	C3	6E		    call init_font_system
 19516	9E7A	C1				    pop bc                        ; Restore connection table AFTER VRAM restore
 19517	9E7B	CD	22	A0		    call gameflow_get_default_connection
 19518	9E7E	7C				    ld a, h
 19519	9E7F	B5				    or l
 19520	9E80	C8				    ret z
 19521	9E81	C3	1E	9A		    jp gameflow_execute_node
 19522	9E84					
 19523	9E84					; ==================================================================
 19524	9E84					; execute_transition_effect
 19525	9E84					; Execute visual screen transition by clearing the Name Table
 19526	9E84					; in different patterns. All effects write tile 0 (blank/black)
 19527	9E84					; to Name Table (#1800-#1AFF, 768 bytes = 32x24 tiles).
 19528	9E84					;
 19529	9E84					; Input:  DE = Transition data pointer
 19530	9E84					;         (DE) = effect id: 0=cls, 1=dissolve_pixels, 2=dissolve_chars,
 19531	9E84					;                           3=vertical_lines, 4=horizontal_lines,
 19532	9E84					;                           5=spiral, 6=fill_white_squares
 19533	9E84					; Destroys: AF, BC, DE, HL
 19534	9E84					; ==================================================================
 19535	9E84					execute_transition_effect:
 19536	9E84	1A				    ld a, (de)                    ; A = effect id (0-6)
 19537	9E85	13				    inc de
 19538	9E86	F5				    push af                       ; Save effect id
 19539	9E87	1A				    ld a, (de)                    ; A = frames per step (from node data)
 19540	9E88	32	0F	C0		    ld (transition_delay_var), a  ; Store for trans_wait_frames
 19541	9E8B	F1				    pop af                        ; Restore effect id
 19542	9E8C	B7				    or a
 19543	9E8D	CA	A9	9E		    jp z, .trans_cls
 19544	9E90	3D				    dec a
 19545	9E91	CA	B7	9E		    jp z, .trans_dissolve_pixels
 19546	9E94	3D				    dec a
 19547	9E95	CA	D9	9E		    jp z, .trans_dissolve_chars
 19548	9E98	3D				    dec a
 19549	9E99	CA	F3	9E		    jp z, .trans_vertical_lines
 19550	9E9C	3D				    dec a
 19551	9E9D	CA	08	9F		    jp z, .trans_horizontal_lines
 19552	9EA0	3D				    dec a
 19553	9EA1	CA	23	9F		    jp z, .trans_spiral
 19554	9EA4	3D				    dec a
 19555	9EA5	CA	39	9F		    jp z, .trans_fill_white_squares
 19556	9EA8	C9				    ret                           ; Unknown id - do nothing
