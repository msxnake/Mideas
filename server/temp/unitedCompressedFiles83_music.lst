 11381	70A6					
 11382	70A6					; ------------------------------------------------------------------
 11383	70A6					; update_hud_score
 11384	70A6					; Update score HUD element with current score value
 11385	70A6					; Input: HL = Score value (16-bit binary, 0-65535)
 11386	70A6					; Writes score digits directly into the HUD numeric field in VRAM
 11387	70A6					; Output:
 11388	70A6					;   None
 11389	70A6					; Clobbers:
 11390	70A6					;   None visible to caller
 11391	70A6					; Preserves:
 11392	70A6					;   AF, BC, DE, HL
 11393	70A6					; Notes:
 11394	70A6					;   - Uses BC internally for decimal divisors
 11395	70A6					;   - Uses DE internally as VRAM cursor for the numeric field
 11396	70A6					;   - Writes only the numeric digits; the static "SCORE: " label is not touched
 11397	70A6					; ------------------------------------------------------------------
 11398	70A6					update_hud_score:
 11399	70A6	F5				    push af
 11400	70A7	C5				    push bc
 11401	70A8	D5				    push de
 11402	70A9	E5				    push hl
 11403	70AA					
 11404	70AA					    ; Direct VRAM update of the numeric HUD field.
 11405	70AA					    ; Static label ("SCORE: ") stays in ROM; only digits are rewritten.
 11406	70AA	11	28	18		    ld de, #1828
 11407	70AD					
 11408	70AD					    ; Leading digit 0: forced zero (Score is 16-bit max 65535)
 11409	70AD	3E	30			    ld a, '0'
 11410	70AF	E5				    push hl
 11411	70B0	62				    ld h, d
 11412	70B1	6B				    ld l, e
 11413	70B2	CD	CE	40		    call FAST_WRTVRM
 11414	70B5	E1				    pop hl
 11415	70B6	13				    inc de
 11416	70B7					    ; Runtime digit 0: / 10000
 11417	70B7	01	10	27		    ld bc, 10000
 11418	70BA	CD	06	71		    call .div16
 11419	70BD	C6	30			    add a, '0'
 11420	70BF	E5				    push hl
 11421	70C0	62				    ld h, d
 11422	70C1	6B				    ld l, e
 11423	70C2	CD	CE	40		    call FAST_WRTVRM
 11424	70C5	E1				    pop hl
 11425	70C6	13				    inc de
 11426	70C7					    ; Runtime digit 1: / 1000
 11427	70C7	01	E8	03		    ld bc, 1000
 11428	70CA	CD	06	71		    call .div16
 11429	70CD	C6	30			    add a, '0'
 11430	70CF	E5				    push hl
 11431	70D0	62				    ld h, d
 11432	70D1	6B				    ld l, e
 11433	70D2	CD	CE	40		    call FAST_WRTVRM
 11434	70D5	E1				    pop hl
 11435	70D6	13				    inc de
 11436	70D7					    ; Runtime digit 2: / 100
 11437	70D7	01	64	00		    ld bc, 100
 11438	70DA	CD	06	71		    call .div16
 11439	70DD	C6	30			    add a, '0'
 11440	70DF	E5				    push hl
 11441	70E0	62				    ld h, d
 11442	70E1	6B				    ld l, e
 11443	70E2	CD	CE	40		    call FAST_WRTVRM
 11444	70E5	E1				    pop hl
 11445	70E6	13				    inc de
 11446	70E7					    ; Runtime digit 3: / 10
 11447	70E7	01	0A	00		    ld bc, 10
 11448	70EA	CD	06	71		    call .div16
 11449	70ED	C6	30			    add a, '0'
 11450	70EF	E5				    push hl
 11451	70F0	62				    ld h, d
 11452	70F1	6B				    ld l, e
 11453	70F2	CD	CE	40		    call FAST_WRTVRM
 11454	70F5	E1				    pop hl
 11455	70F6	13				    inc de
 11456	70F7					    ; Final digit: ones (remainder)
 11457	70F7	7D				    ld a, l
 11458	70F8	C6	30			    add a, '0'
 11459	70FA	E5				    push hl
 11460	70FB	62				    ld h, d
 11461	70FC	6B				    ld l, e
 11462	70FD	CD	CE	40		    call FAST_WRTVRM
 11463	7100	E1				    pop hl
 11464	7101					
 11465	7101	E1				    pop hl
 11466	7102	D1				    pop de
 11467	7103	C1				    pop bc
 11468	7104	F1				    pop af
 11469	7105	C9				    ret
 11470	7106					
 11471	7106					; Helper: HL = HL / BC, A = quotient, HL = remainder
 11472	7106					.div16:
 11473	7106	AF				    xor a                       ; Quotient = 0
 11474	7107					.div16_loop:
 11475	7107	B7				    or a                        ; Clear carry
 11476	7108	ED	42			    sbc hl, bc                  ; HL -= BC
 11477	710A	38	03			    jr c, .div16_done           ; If underflow, done
 11478	710C	3C				    inc a                       ; Quotient++
 11479	710D	18	F8			    jr .div16_loop
 11480	710F					.div16_done:
 11481	710F	09				    add hl, bc                  ; Restore remainder
 11482	7110	C9				    ret
 11483	7111					
 11484	7111					; ------------------------------------------------------------------
 11485	7111					; update_hud_lives
 11486	7111					; Update lives HUD element
 11487	7111					; Input: A = Number of lives (0-9)
 11488	7111					; Output:
 11489	7111					;   None
 11490	7111					; Clobbers:
 11491	7111					;   None visible to caller
 11492	7111					; Preserves:
 11493	7111					;   AF, HL
 11494	7111					; Notes:
 11495	7111					;   - Writes only the numeric digit in VRAM; the static label is not touched
 11496	7111					; ------------------------------------------------------------------
 11497	7111					update_hud_lives:
 11498	7111	F5				    push af
 11499	7112	E5				    push hl
 11500	7113					
 11501	7113					    ; Direct VRAM update of the Lives numeric field.
 11502	7113	C6	30			    add a, '0'                  ; Convert to ASCII
 11503	7115	21	36	18		    ld hl, #1836
 11504	7118	CD	CE	40		    call FAST_WRTVRM
 11505	711B					
 11506	711B	E1				    pop hl
 11507	711C	F1				    pop af
 11508	711D	C9				    ret
 11509	711E					
 11510	711E					
 11511	711E					
 11512	711E					; ==================================================================
 11513	711E					; PSG SOUND SYSTEM
 11514	711E					; File: sound.asm
 11515	711E					; Description: AY-3-8910 PSG control and sound effects
 11516	711E					; ==================================================================
 11517	711E					
 11518	711E					; ==================================================================
 11519	711E					; PSG REGISTER ADDRESSES
 11520	711E					; ==================================================================
 11521	711E					
 11522	711E					; Tone Generators (Channels A, B, C)
 11523	711E					PSG_TONE_A_LO       EQU 0        ; Channel A period low byte
 11524	711E					PSG_TONE_A_HI       EQU 1        ; Channel A period high byte (4 bits)
 11525	711E					PSG_TONE_B_LO       EQU 2        ; Channel B period low byte
 11526	711E					PSG_TONE_B_HI       EQU 3        ; Channel B period high byte (4 bits)
 11527	711E					PSG_TONE_C_LO       EQU 4        ; Channel C period low byte
 11528	711E					PSG_TONE_C_HI       EQU 5        ; Channel C period high byte (4 bits)
 11529	711E					
 11530	711E					; Noise Generator
 11531	711E					PSG_NOISE_PERIOD    EQU 6        ; Noise period (5 bits)
 11532	711E					
 11533	711E					; Mixer Control
 11534	711E					PSG_MIXER           EQU 7        ; Mixer/Enable register
 11535	711E					; Bit 0: Channel A tone enable (0=on, 1=off)
 11536	711E					; Bit 1: Channel B tone enable
 11537	711E					; Bit 2: Channel C tone enable
 11538	711E					; Bit 3: Channel A noise enable (0=on, 1=off)
 11539	711E					; Bit 4: Channel B noise enable
 11540	711E					; Bit 5: Channel C noise enable
 11541	711E					
 11542	711E					; Volume Control
 11543	711E					PSG_VOL_A           EQU 8        ; Channel A volume (4 bits) + envelope flag (bit 4)
 11544	711E					PSG_VOL_B           EQU 9        ; Channel B volume
 11545	711E					PSG_VOL_C           EQU 10       ; Channel C volume
 11546	711E					
 11547	711E					; Envelope Generator
 11548	711E					PSG_ENV_LO          EQU 11       ; Envelope period low byte
 11549	711E					PSG_ENV_HI          EQU 12       ; Envelope period high byte
 11550	711E					PSG_ENV_SHAPE       EQU 13       ; Envelope shape (4 bits)
 11551	711E					
 11552	711E					; ==================================================================
 11553	711E					; PSG TONE PERIODS (Musical notes, octave 4, 3.579545 MHz clock)
 11554	711E					; ==================================================================
 11555	711E					
 11556	711E					; Note frequencies for octave 4 (middle C = C4)
 11557	711E					NOTE_C4         EQU 477      ; C  - 261.63 Hz
 11558	711E					NOTE_CS4        EQU 450      ; C# - 277.18 Hz
 11559	711E					NOTE_D4         EQU 425      ; D  - 293.66 Hz
 11560	711E					NOTE_DS4        EQU 401      ; D# - 311.13 Hz
 11561	711E					NOTE_E4         EQU 379      ; E  - 329.63 Hz
 11562	711E					NOTE_F4         EQU 357      ; F  - 349.23 Hz
 11563	711E					NOTE_FS4        EQU 337      ; F# - 369.99 Hz
 11564	711E					NOTE_G4         EQU 318      ; G  - 392.00 Hz
 11565	711E					NOTE_GS4        EQU 300      ; G# - 415.30 Hz
 11566	711E					NOTE_A4         EQU 284      ; A  - 440.00 Hz
 11567	711E					NOTE_AS4        EQU 268      ; A# - 466.16 Hz
 11568	711E					NOTE_B4         EQU 253      ; B  - 493.88 Hz
 11569	711E					NOTE_C5         EQU 238      ; C5 - 523.25 Hz
 11570	711E					
 11571	711E					; Octave multipliers: Divide period by 2 for +1 octave, multiply by 2 for -1 octave
 11572	711E					
 11573	711E					; ==================================================================
 11574	711E					; SOUND EFFECT DURATIONS (in frames, 60Hz)
 11575	711E					; ==================================================================
 11576	711E					
 11577	711E					SFX_SHORT           EQU 5        ; ~83ms
 11578	711E					SFX_MEDIUM          EQU 15       ; ~250ms
 11579	711E					SFX_LONG            EQU 30       ; ~500ms
 11580	711E					
 11581	711E					; ==================================================================
 11582	711E					; SOUND SYSTEM INITIALIZATION
 11583	711E					; ==================================================================
 11584	711E					
 11585	711E					init_sound_system:
 11586	711E					    ; Initialize PSG via BIOS
 11587	711E	CD	90	00		    call GICINI
 11588	7121					
 11589	7121					    ; Clear runtime sound state so power-on RAM garbage cannot make
 11590	7121					    ; sfx_update / SM_UpdateSound drive the PSG for a few random frames.
 11591	7121	AF				    xor a
 11592	7122	32	B8	CD		    ld (sfx_active), a
 11593	7125	32	B9	CD		    ld (sfx_timer), a
 11594	7128	32	BA	CD		    ld (sfx_fadeout), a
 11595	712B	32	49	D1		    ld (sm_sound_active), a
 11596	712E	32	4A	D1		    ld (sm_sound_frames_left), a
 11597	7131	32	4B	D1		    ld (sm_sound_ptr_l), a
 11598	7134	32	4C	D1		    ld (sm_sound_ptr_h), a
 11599	7137	CD	9D	72		    call music_init_system
 11600	713A					
 11601	713A					    ; Silence all channels
 11602	713A	CD	81	71		    call sfx_silence_all
 11603	713D					
 11604	713D	C9				    ret
 11605	713E					
 11606	713E					; ==================================================================
 11607	713E					; PSG LOW-LEVEL CONTROL FUNCTIONS
 11608	713E					; ==================================================================
 11609	713E					
 11610	713E					; ------------------------------------------------------------------
 11611	713E					; psg_write
 11612	713E					; Write to PSG register via BIOS
 11613	713E					; Input:  A = Register number (0-13)
 11614	713E					;         E = Value to write
 11615	713E					; Destroys: AF, E
 11616	713E					; ------------------------------------------------------------------
 11617	713E					psg_write:
 11618	713E	CD	93	00		    call WRTPSG
 11619	7141	C9				    ret
 11620	7142					
 11621	7142					; ------------------------------------------------------------------
 11622	7142					; psg_set_tone
 11623	7142					; Set tone period for a channel
 11624	7142					; Input:  A = Channel (0=A, 1=B, 2=C)
 11625	7142					;         HL = Tone period (12-bit value)
 11626	7142					; Destroys: AF, BC, DE, HL
 11627	7142					; ------------------------------------------------------------------
 11628	7142					psg_set_tone:
 11629	7142					    ; Calculate register numbers (A*2 for low, A*2+1 for high)
 11630	7142	87				    add a, a                     ; A = channel * 2
 11631	7143	4F				    ld c, a                      ; C = low register number
 11632	7144	3C				    inc a
 11633	7145	47				    ld b, a                      ; B = high register number
 11634	7146					
 11635	7146					    ; Write low byte
 11636	7146	79				    ld a, c
 11637	7147	5D				    ld e, l
 11638	7148	CD	93	00		    call WRTPSG
 11639	714B					
 11640	714B					    ; Write high byte (only lower 4 bits)
 11641	714B	78				    ld a, b
 11642	714C	5C				    ld e, h
 11643	714D	7B				    ld a, e
 11644	714E	E6	0F			    and #0F
 11645	7150	5F				    ld e, a
 11646	7151	78				    ld a, b
 11647	7152	CD	93	00		    call WRTPSG
 11648	7155					
 11649	7155	C9				    ret
 11650	7156					
 11651	7156					; ------------------------------------------------------------------
 11652	7156					; psg_set_volume
 11653	7156					; Set volume for a channel
 11654	7156					; Input:  A = Channel (0=A, 1=B, 2=C)
 11655	7156					;         B = Volume (0-15) or #10 to enable PSG hardware envelope
 11656	7156					; Destroys: AF, E
 11657	7156					; ------------------------------------------------------------------
 11658	7156					psg_set_volume:
 11659	7156	C6	08			    add a, PSG_VOL_A             ; A = PSG_VOL_x register
 11660	7158	58				    ld e, b                      ; E = volume value
 11661	7159	CD	93	00		    call WRTPSG
 11662	715C	C9				    ret
 11663	715D					
 11664	715D					; ------------------------------------------------------------------
 11665	715D					; psg_set_noise
 11666	715D					; Set noise generator period
 11667	715D					; Input:  A = Noise period (0-31)
 11668	715D					; Destroys: AF, E
 11669	715D					; ------------------------------------------------------------------
 11670	715D					psg_set_noise:
 11671	715D	5F				    ld e, a
 11672	715E	3E	06			    ld a, PSG_NOISE_PERIOD
 11673	7160	CD	93	00		    call WRTPSG
 11674	7163	C9				    ret
 11675	7164					
 11676	7164					; ------------------------------------------------------------------
 11677	7164					; psg_set_mixer
 11678	7164					; Set mixer control (enable/disable tone and noise)
 11679	7164					; Input:  A = Mixer value
 11680	7164					;         Bits 0-2: Tone off (0=on, 1=off) for channels A,B,C
 11681	7164					;         Bits 3-5: Noise off (0=on, 1=off) for channels A,B,C
 11682	7164					; Destroys: AF, E
 11683	7164					; ------------------------------------------------------------------
 11684	7164					psg_set_mixer:
 11685	7164	5F				    ld e, a
 11686	7165	3E	07			    ld a, PSG_MIXER
 11687	7167	CD	93	00		    call WRTPSG
 11688	716A	C9				    ret
 11689	716B					
 11690	716B					; ------------------------------------------------------------------
 11691	716B					; psg_set_envelope
 11692	716B					; Program the global PSG hardware envelope generator
 11693	716B					; Input:  HL = Envelope period
 11694	716B					;         B = Envelope shape (0-15)
 11695	716B					; Destroys: AF, E
 11696	716B					; ------------------------------------------------------------------
 11697	716B					psg_set_envelope:
 11698	716B	3E	0B			    ld a, PSG_ENV_LO
 11699	716D	5D				    ld e, l
 11700	716E	CD	93	00		    call WRTPSG
 11701	7171	3E	0C			    ld a, PSG_ENV_HI
 11702	7173	5C				    ld e, h
 11703	7174	CD	93	00		    call WRTPSG
 11704	7177	78				    ld a, b
 11705	7178	E6	0F			    and #0F
 11706	717A	5F				    ld e, a
 11707	717B	3E	0D			    ld a, PSG_ENV_SHAPE
 11708	717D	CD	93	00		    call WRTPSG
 11709	7180	C9				    ret
 11710	7181					
 11711	7181					; ==================================================================
 11712	7181					; HIGH-LEVEL SOUND EFFECTS
 11713	7181					; ==================================================================
 11714	7181					
 11715	7181					; ------------------------------------------------------------------
 11716	7181					; sfx_silence_all
 11717	7181					; Silence all PSG channels
 11718	7181					; ------------------------------------------------------------------
 11719	7181					sfx_silence_all:
 11720	7181					    ; Set all volumes to 0
 11721	7181	AF				    xor a                        ; A = channel A
 11722	7182	06	00			    ld b, 0                      ; B = volume 0
 11723	7184	CD	56	71		    call psg_set_volume
 11724	7187					
 11725	7187	3E	01			    ld a, 1                      ; A = channel B
 11726	7189	06	00			    ld b, 0
 11727	718B	CD	56	71		    call psg_set_volume
 11728	718E					
 11729	718E	3E	02			    ld a, 2                      ; A = channel C
 11730	7190	06	00			    ld b, 0
 11731	7192	CD	56	71		    call psg_set_volume
 11732	7195					
 11733	7195					    ; Disable all tone and noise
 11734	7195	3E	3F			    ld a, #3F                    ; All tone and noise off
 11735	7197	CD	64	71		    call psg_set_mixer
 11736	719A					
 11737	719A	C9				    ret
 11738	719B					
 11739	719B					; ------------------------------------------------------------------
 11740	719B					; sfx_beep
 11741	719B					; Simple beep sound
 11742	719B					; ------------------------------------------------------------------
 11743	719B					sfx_beep:
 11744	719B					    ; Channel A: 440Hz (A4)
 11745	719B	AF				    xor a                        ; A = channel A
 11746	719C	21	1C	01		    ld hl, NOTE_A4
 11747	719F	CD	42	71		    call psg_set_tone
 11748	71A2					
 11749	71A2					    ; Volume 12
 11750	71A2	AF				    xor a
 11751	71A3	06	0C			    ld b, 12
 11752	71A5	CD	56	71		    call psg_set_volume
 11753	71A8					
 11754	71A8					    ; Enable tone A only
 11755	71A8	3E	3E			    ld a, #3E                    ; Tone A on, others off
 11756	71AA	CD	64	71		    call psg_set_mixer
 11757	71AD					
 11758	71AD	C9				    ret
 11759	71AE					
 11760	71AE					; ------------------------------------------------------------------
 11761	71AE					; sfx_jump
 11762	71AE					; Jump sound effect (rising pitch)
 11763	71AE					; ------------------------------------------------------------------
 11764	71AE					sfx_jump:
 11765	71AE					    ; Channel A: Start at C4, quick rise
 11766	71AE	AF				    xor a
 11767	71AF	21	DD	01		    ld hl, NOTE_C4
 11768	71B2	CD	42	71		    call psg_set_tone
 11769	71B5					
 11770	71B5					    ; Volume 10
 11771	71B5	AF				    xor a
 11772	71B6	06	0A			    ld b, 10
 11773	71B8	CD	56	71		    call psg_set_volume
 11774	71BB					
 11775	71BB					    ; Enable tone A
 11776	71BB	3E	3E			    ld a, #3E
 11777	71BD	CD	64	71		    call psg_set_mixer
 11778	71C0					
 11779	71C0					    ; TODO: Add pitch sweep for realistic jump sound
 11780	71C0	C9				    ret
 11781	71C1					
 11782	71C1					; ------------------------------------------------------------------
 11783	71C1					; sfx_shoot
 11784	71C1					; Shooting sound (noise + low tone)
 11785	71C1					; ------------------------------------------------------------------
 11786	71C1					sfx_shoot:
 11787	71C1					    ; Channel A: Low tone
 11788	71C1	AF				    xor a
 11789	71C2	21	64	00		    ld hl, 100                   ; Low period = high pitch
 11790	71C5	CD	42	71		    call psg_set_tone
 11791	71C8					
 11792	71C8					    ; Volume 8
 11793	71C8	AF				    xor a
 11794	71C9	06	08			    ld b, 8
 11795	71CB	CD	56	71		    call psg_set_volume
 11796	71CE					
 11797	71CE					    ; Noise generator at period 5
 11798	71CE	3E	05			    ld a, 5
 11799	71D0	CD	5D	71		    call psg_set_noise
 11800	71D3					
 11801	71D3					    ; Enable tone A + noise A
 11802	71D3	3E	36			    ld a, #36                    ; Tone A + Noise A on
 11803	71D5	CD	64	71		    call psg_set_mixer
 11804	71D8					
 11805	71D8	C9				    ret
 11806	71D9					
 11807	71D9					; ------------------------------------------------------------------
 11808	71D9					; sfx_explosion
 11809	71D9					; Explosion sound (noise-heavy)
 11810	71D9					; ------------------------------------------------------------------
 11811	71D9					sfx_explosion:
 11812	71D9					    ; Noise generator at period 10
 11813	71D9	3E	0A			    ld a, 10
 11814	71DB	CD	5D	71		    call psg_set_noise
 11815	71DE					
 11816	71DE					    ; Channel A: Volume 15 (max) with noise
 11817	71DE	AF				    xor a
 11818	71DF	06	0F			    ld b, 15
 11819	71E1	CD	56	71		    call psg_set_volume
 11820	71E4					
 11821	71E4					    ; Enable noise A only (no tone)
 11822	71E4	3E	39			    ld a, #39                    ; Noise A on, tone off
 11823	71E6	CD	64	71		    call psg_set_mixer
 11824	71E9					
 11825	71E9	C9				    ret
 11826	71EA					
 11827	71EA					; ------------------------------------------------------------------
 11828	71EA					; sfx_coin
 11829	71EA					; Coin/pickup sound (quick ascending notes)
 11830	71EA					; ------------------------------------------------------------------
 11831	71EA					sfx_coin:
 11832	71EA					    ; Channel B: E4 note
 11833	71EA	3E	01			    ld a, 1                      ; Channel B
 11834	71EC	21	7B	01		    ld hl, NOTE_E4
 11835	71EF	CD	42	71		    call psg_set_tone
 11836	71F2					
 11837	71F2					    ; Volume 10
 11838	71F2	3E	01			    ld a, 1
 11839	71F4	06	0A			    ld b, 10
 11840	71F6	CD	56	71		    call psg_set_volume
 11841	71F9					
 11842	71F9					    ; Enable tone B
 11843	71F9	3E	3D			    ld a, #3D                    ; Tone B on, others off
 11844	71FB	CD	64	71		    call psg_set_mixer
 11845	71FE					
 11846	71FE					    ; TODO: Quick ascend to G4 for classic coin sound
 11847	71FE	C9				    ret
 11848	71FF					
 11849	71FF					; ------------------------------------------------------------------
 11850	71FF					; sfx_damage
 11851	71FF					; Damage/hit sound (harsh noise)
 11852	71FF					; ------------------------------------------------------------------
 11853	71FF					sfx_damage:
 11854	71FF					    ; Short noise burst
 11855	71FF	3E	03			    ld a, 3                      ; Harsh noise period
 11856	7201	CD	5D	71		    call psg_set_noise
 11857	7204					
 11858	7204					    ; Channel C: Volume 12
 11859	7204	3E	02			    ld a, 2                      ; Channel C
 11860	7206	06	0C			    ld b, 12
 11861	7208	CD	56	71		    call psg_set_volume
 11862	720B					
 11863	720B					    ; Enable noise C only
 11864	720B	3E	1F			    ld a, #1F                    ; Noise C on
 11865	720D	CD	64	71		    call psg_set_mixer
 11866	7210					
 11867	7210	C9				    ret
