 2313	4377					; COMPONENT TYPE CONSTANTS(Based on ComponentDefinition analysis)
 2314	4377					    ; ==================================================================
 2315	4377					
 2316	4377					; Core Components(always present)
 2317	4377					COMP_POSITION   EQU 0; Position component(x, y coordinates)
 2318	4377					COMP_SPRITE     EQU 1; Sprite rendering component
 2319	4377					COMP_MOVEMENT   EQU 2; Movement / velocity component
 2320	4377					COMP_COLLISION  EQU 3; Collision detection component
 2321	4377					COMP_INPUT      EQU 4; Input handling component
 2322	4377					COMP_BEHAVIOR   EQU 5; AI / Logic behavior component
 2323	4377					COMP_HEALTH     EQU 6; Health / damage component
 2324	4377					COMP_ANIMATION  EQU 7; Animation state component
 2325	4377					COMP_JUMP       EQU 8; Jump behavior component(platformer physics)
 2326	4377					COMP_GRAVITY    EQU 9; Gravity physics component
 2327	4377					
 2328	4377					    ; Component flags for entity filtering(16 - bit masks for 10 + components)
 2329	4377					COMP_MASK_POSITION   EQU #0001; Binary: 0000000000000001
 2330	4377					COMP_MASK_SPRITE     EQU #0002; Binary: 0000000000000010
 2331	4377					COMP_MASK_MOVEMENT   EQU #0004; Binary: 0000000000000100
 2332	4377					COMP_MASK_COLLISION  EQU #0008; Binary: 0000000000001000
 2333	4377					COMP_MASK_INPUT      EQU #0010; Binary: 0000000000010000
 2334	4377					COMP_MASK_BEHAVIOR   EQU #0020; Binary: 0000000000100000
 2335	4377					COMP_MASK_HEALTH     EQU #0040; Binary: 0000000001000000
 2336	4377					COMP_MASK_ANIMATION  EQU #0080; Binary: 0000000010000000
 2337	4377					COMP_MASK_JUMP       EQU #0100; Binary: 0000000100000000
 2338	4377					COMP_MASK_GRAVITY    EQU #0200; Binary: 0000001000000000
 2339	4377					COMP_MASK_AUTO_DESTROY EQU #0400; Binary: 0000010000000000
 2340	4377					
