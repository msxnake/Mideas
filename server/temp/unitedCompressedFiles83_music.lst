 13770	86C3					; ==================================================================
 13771	86C3					; PARTICLE PATTERN DATA
 13772	86C3					; ==================================================================
 13773	86C3					; Each particle type has 4 frames, 8 bytes each = 32 bytes total
 13774	86C3					; Frame progression creates animation effect
 13775	86C3					
 13776	86C3					particle_patterns:
 13777	86C3					
 13778	86C3					; ---- PARTICLE_NONE (type 0) - Empty ----
 13779	86C3	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13780	86CB	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13781	86D3	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13782	86DB	00	00	00	00	00	00	00	00	    db #00, #00, #00, #00, #00, #00, #00, #00
 13783	86E3					
 13784	86E3					; ---- PARTICLE_EXPLOSION (type 1) - Expands outward ----
 13785	86E3					    ; Frame 0: Small dot
 13786	86E3	00	00	00	18	18	00	00	00	    db #00, #00, #00, #18, #18, #00, #00, #00
 13787	86EB					    ; Frame 1: Expanding
 13788	86EB	00	18	3C	7E	7E	3C	18	00	    db #00, #18, #3C, #7E, #7E, #3C, #18, #00
 13789	86F3					    ; Frame 2: Large explosion
 13790	86F3	18	7E	FF	FF	FF	FF	7E	18	    db #18, #7E, #FF, #FF, #FF, #FF, #7E, #18
 13791	86FB					    ; Frame 3: Fading fragments
 13792	86FB	81	42	24	18	18	24	42	81	    db #81, #42, #24, #18, #18, #24, #42, #81
 13793	8703					
 13794	8703					; ---- PARTICLE_SMOKE (type 2) - Puff rising ----
 13795	8703					    ; Frame 0: Small puff
 13796	8703	00	00	3C	66	66	3C	00	00	    db #00, #00, #3C, #66, #66, #3C, #00, #00
 13797	870B					    ; Frame 1: Expanding
 13798	870B	00	7E	FF	C3	C3	FF	7E	00	    db #00, #7E, #FF, #C3, #C3, #FF, #7E, #00
 13799	8713					    ; Frame 2: Large cloud
 13800	8713	7E	FF	E7	C3	C3	E7	FF	7E	    db #7E, #FF, #E7, #C3, #C3, #E7, #FF, #7E
 13801	871B					    ; Frame 3: Dispersing
 13802	871B	66	E7	C3	81	81	C3	E7	66	    db #66, #E7, #C3, #81, #81, #C3, #E7, #66
