 17193	94B2					Condition_And:
 17194	94B2					    ; AND compound condition
 17195	94B2					    ; Data format: DB subcondition_count, then N subconditions inline
 17196	94B2					    ; Evaluates all subconditions; returns true only if ALL are true
 17197	94B2					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17198	94B2					    ; Output: A = 1 (all true) or 0 (any false), HL = past all subcondition data
 17199	94B2	4E				    ld c, (hl)              ; C = subcondition count
 17200	94B3	23				    inc hl
 17201	94B4	16	01			    ld d, 1                 ; D = result accumulator (1 = all true so far)
 17202	94B6					
 17203	94B6					.and_loop:
 17204	94B6	79				    ld a, c
 17205	94B7	B7				    or a
 17206	94B8	28	0D			    jr z, .and_done         ; No more subconditions
 17207	94BA					
 17208	94BA	C5				    push bc                 ; Save count (C) and entity index (implicitly)
 17209	94BB	D5				    push de                 ; Save result accumulator (D)
 17210	94BC					
 17211	94BC	78				    ld a, b                 ; A = Entity Index
 17212	94BD	CD	04	89		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17213	94C0					
 17214	94C0	D1				    pop de                  ; Restore result accumulator
 17215	94C1	A2				    and d                   ; Combine: D = D AND result
 17216	94C2	57				    ld d, a
 17217	94C3					
 17218	94C3	C1				    pop bc                  ; Restore count and entity index
 17219	94C4	0D				    dec c
 17220	94C5	18	EF			    jr .and_loop
 17221	94C7					
 17222	94C7					.and_done:
 17223	94C7	7A				    ld a, d                 ; A = AND result
 17224	94C8	C9				    ret
 17225	94C9					
 17226	94C9					Condition_Or:
 17227	94C9					    ; OR compound condition
 17228	94C9					    ; Data format: DB subcondition_count, then N subconditions inline
 17229	94C9					    ; Evaluates all subconditions; returns true if ANY is true
 17230	94C9					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17231	94C9					    ; Output: A = 1 (any true) or 0 (all false), HL = past all subcondition data
 17232	94C9	4E				    ld c, (hl)              ; C = subcondition count
 17233	94CA	23				    inc hl
 17234	94CB	16	00			    ld d, 0                 ; D = result accumulator (0 = all false so far)
 17235	94CD					
