 1535	41AF					
 1536	41AF					
 1537	41AF					; ==================================================================
 1538	41AF					; INTERRUPT TASK SYSTEM - File: interrupt.asm
 1539	41AF					; Konami-style technique: Hook H.TIMI for 50/60Hz task execution
 1540	41AF					; ==================================================================
 1541	41AF					
 1542	41AF					; ==================================================================
 1543	41AF					; INTERRUPT SYSTEM MEMORY LAYOUT
 1544	41AF					; Variables are defined in variables.asm (dynamically allocated)
 1545	41AF					; This avoids RAM overlap with entity system arrays
 1546	41AF					; ==================================================================
 1547	41AF					; Slots: task_table (8 slots x 2 bytes), task_0_ptr..task_7_ptr
 1548	41AF					; State: interrupt_system_enabled, old_htimi_hook, interrupt_counter,
 1549	41AF					;        task_exec_time, vblank_flag
 1550	41AF					; ==================================================================
 1551	41AF					
 1552	41AF					; ==================================================================
 1553	41AF					; INIT_INTERRUPT_SYSTEM - Install H.TIMI hook
 1554	41AF					; ==================================================================
 1555	41AF					; Register Contract:
 1556	41AF					;   Purpose: Install JP hook on H.TIMI and initialize interrupt task state.
 1557	41AF					;   Inputs:
 1558	41AF					;     - None
 1559	41AF					;   Outputs:
 1560	41AF					;     - None
 1561	41AF					;   Clobbers:
 1562	41AF					;     - AF
 1563	41AF					;     - BC
 1564	41AF					;     - DE
 1565	41AF					;     - HL
 1566	41AF					;   Preserved:
 1567	41AF					;     - None
 1568	41AF					;   Register roles:
 1569	41AF					;     - HL/DE/BC = block copy parameters for hook backup and task table clear
 1570	41AF					;     - A = enable flag and zeroing value
 1571	41AF					;   Notes:
 1572	41AF					;     - Runs with DI/EI, so caller must not assume interrupt state is unchanged.
 1573	41AF					
 1574	41AF					; Inputs: None
 1575	41AF					; Outputs: None
 1576	41AF					; Modifies: AF, BC, DE, HL
 1577	41AF					; ==================================================================
 1578	41AF					init_interrupt_system:
 1579	41AF	F3				    di                          ; Disable interrupts during hook install
 1580	41B0					
 1581	41B0					    ; --- STEP 1: Save original hook ---
 1582	41B0	21	9F	FD		    ld hl, #FD9F                ; H.TIMI address
 1583	41B3	11	3F	D1		    ld de, old_htimi_hook       ; Our backup location
 1584	41B6	01	05	00		    ld bc, 5                    ; Save 5 bytes (JP nnnn + padding)
 1585	41B9	ED	B0			    ldir                        ; Copy original hook to RAM
 1586	41BB					
 1587	41BB					    ; --- STEP 2: Install our hook ---
 1588	41BB					    ; Write "JP interrupt_dispatcher" at FD9F
 1589	41BB	3E	C3			    ld a, #C3                   ; Opcode for JP
 1590	41BD	32	9F	FD		    ld (#FD9F), a               ; Write JP opcode
 1591	41C0	21	F6	41		    ld hl, interrupt_dispatcher ; Address of our ISR
 1592	41C3	22	A0	FD		    ld (#FDA0), hl              ; Write address (little-endian)
 1593	41C6					
 1594	41C6					    ; --- STEP 3: Initialize task table to 0 (all disabled) ---
 1595	41C6	21	2E	D1		    ld hl, task_table
 1596	41C9	11	2F	D1		    ld de, task_table+1
 1597	41CC	01	0F	00		    ld bc, 15                   ; 8 slots ??- 2 bytes = 16 bytes - 1
 1598	41CF	36	00			    ld (hl), 0
 1599	41D1	ED	B0			    ldir                        ; Clear all task pointers
 1600	41D3					
 1601	41D3					    ; --- STEP 4: Initialize counters ---
 1602	41D3	AF				    xor a
 1603	41D4	32	44	D1		    ld (interrupt_counter), a
 1604	41D7	32	45	D1		    ld (interrupt_counter+1), a
 1605	41DA	32	48	D1		    ld (vblank_flag), a
 1606	41DD					
 1607	41DD					    ; --- STEP 5: Mark system as enabled ---
 1608	41DD	3E	01			    ld a, 1
 1609	41DF	32	3E	D1		    ld (interrupt_system_enabled), a
 1610	41E2					
 1611	41E2	FB				    ei                          ; Re-enable interrupts
 1612	41E3	C9				    ret
 1613	41E4					
 1614	41E4					; ==================================================================
 1615	41E4					; STOP_INTERRUPT_SYSTEM - Restore original H.TIMI hook
 1616	41E4					; ==================================================================
 1617	41E4					; Register Contract:
 1618	41E4					;   Purpose: Restore original H.TIMI bytes and mark system disabled.
 1619	41E4					;   Inputs:
 1620	41E4					;     - None
 1621	41E4					;   Outputs:
 1622	41E4					;     - None
 1623	41E4					;   Clobbers:
 1624	41E4					;     - AF
 1625	41E4					;     - BC
 1626	41E4					;     - DE
 1627	41E4					;     - HL
 1628	41E4					;   Preserved:
 1629	41E4					;     - None
 1630	41E4					;   Register roles:
 1631	41E4					;     - HL/DE/BC = LDIR source/destination/count for hook restore
 1632	41E4					;     - A = zero flag write to interrupt_system_enabled
 1633	41E4					;   Notes:
 1634	41E4					;     - Runs with DI/EI for atomic hook restoration.
 1635	41E4					
 1636	41E4					; Inputs: None
 1637	41E4					; Outputs: None
 1638	41E4					; Modifies: AF, BC, DE, HL
 1639	41E4					; ==================================================================
 1640	41E4					stop_interrupt_system:
 1641	41E4	F3				    di                          ; Disable interrupts
 1642	41E5					
 1643	41E5					    ; Restore original hook
 1644	41E5	21	3F	D1		    ld hl, old_htimi_hook       ; Our backup
 1645	41E8	11	9F	FD		    ld de, #FD9F                ; H.TIMI location
 1646	41EB	01	05	00		    ld bc, 5                    ; Restore 5 bytes
 1647	41EE	ED	B0			    ldir
 1648	41F0					
 1649	41F0					    ; Mark system as disabled
 1650	41F0	AF				    xor a
 1651	41F1	32	3E	D1		    ld (interrupt_system_enabled), a
 1652	41F4					
 1653	41F4	FB				    ei                          ; Re-enable interrupts
 1654	41F5	C9				    ret
