 17242	94D2	D5				    push de                 ; Save result accumulator (D)
 17243	94D3					
 17244	94D3	78				    ld a, b                 ; A = Entity Index
 17245	94D4	CD	04	89		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17246	94D7					
