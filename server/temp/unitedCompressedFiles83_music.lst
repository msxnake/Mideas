 12238	81BA					; SCROLL SYSTEM
 12239	81BA					; File: scroll.asm
 12240	81BA					; Description: Viewport management and screen scrolling for large worlds
 12241	81BA					; ==================================================================
 12242	81BA					
 12243	81BA					; ==================================================================
 12244	81BA					; SCROLL SYSTEM CONSTANTS
 12245	81BA					; ==================================================================
 12246	81BA					
 12247	81BA					SCREEN_WIDTH_TILES      EQU 32      ; MSX Screen 2 width in tiles
 12248	81BA					SCREEN_HEIGHT_TILES     EQU 24      ; MSX Screen 2 height in tiles
 12249	81BA					SCREEN_WIDTH_PIXELS     EQU 256     ; MSX Screen 2 width in pixels
 12250	81BA					SCREEN_HEIGHT_PIXELS    EQU 192     ; MSX Screen 2 height in pixels
 12251	81BA					
 12252	81BA					; Note: NAMETBL (#1800) is already defined in constants.asm
 12253	81BA					
 12254	81BA					; ==================================================================
 12255	81BA					; SCROLL SYSTEM INITIALIZATION
 12256	81BA					; ==================================================================
 12257	81BA					
 12258	81BA					init_scroll_system:
 12259	81BA					    ; Initialize camera to (0, 0)
 12260	81BA	AF				    xor a
 12261	81BB	32	29	C6		    ld (camera_x), a
 12262	81BE	32	2A	C6		    ld (camera_x + 1), a
 12263	81C1	32	2B	C6		    ld (camera_y), a
 12264	81C4	32	2C	C6		    ld (camera_y + 1), a
 12265	81C7	32	2D	C6		    ld (camera_tile_x), a
 12266	81CA	32	2E	C6		    ld (camera_tile_y), a
 12267	81CD					
 12268	81CD					    ; Set world dimensions (will be updated by level loader)
 12269	81CD	3E	20			    ld a, SCREEN_WIDTH_TILES
 12270	81CF	32	2F	C6		    ld (world_width_tiles), a
 12271	81D2	3E	18			    ld a, SCREEN_HEIGHT_TILES
 12272	81D4	32	30	C6		    ld (world_height_tiles), a
 12273	81D7					
 12274	81D7					    ; Clear dirty flag
 12275	81D7	AF				    xor a
 12276	81D8	32	31	C6		    ld (scroll_dirty_flag), a
 12277	81DB					
 12278	81DB	C9				    ret
 12279	81DC					
 12280	81DC					; ==================================================================
 12281	81DC					; CAMERA CONTROL FUNCTIONS
 12282	81DC					; ==================================================================
 12283	81DC					
 12284	81DC					; ------------------------------------------------------------------
 12285	81DC					; set_camera_position
 12286	81DC					; Set camera position in pixels (with bounds checking)
 12287	81DC					; Input:  HL = X position (pixels), DE = Y position (pixels)
 12288	81DC					; Destroys: AF, BC
 12289	81DC					; ------------------------------------------------------------------
 12290	81DC					set_camera_position:
 12291	81DC					    ; Bounds check X
 12292	81DC	E5				    push hl
 12293	81DD	D5				    push de
 12294	81DE					
 12295	81DE					    ; Calculate max X = (world_width_tiles - SCREEN_WIDTH_TILES) * TILE_WIDTH
 12296	81DE	3A	2F	C6		    ld a, (world_width_tiles)
 12297	81E1	D6	20			    sub SCREEN_WIDTH_TILES
 12298	81E3	38	1A			    jr c, .scroll_x_in_bounds   ; World smaller than screen
 12299	81E5					
 12300	81E5					    ; A = tiles to scroll, multiply by tile width
 12301	81E5	47				    ld b, a
 12302	81E6	3E	10			    ld a, 16
 12303	81E8	CD	C4	82		    call multiply_a_by_b        ; HL = max X
 12304	81EB					
 12305	81EB					    ; Compare camera X with max X
 12306	81EB	D1				    pop de
 12307	81EC	C1				    pop bc                      ; BC = requested X
 12308	81ED	C5				    push bc
 12309	81EE	D5				    push de
 12310	81EF					
 12311	81EF					    ; If requested X > max X, clamp to max X
 12312	81EF	78				    ld a, b
 12313	81F0	BC				    cp h
 12314	81F1	38	08			    jr c, .scroll_x_clamped
 12315	81F3	20	0A			    jr nz, .scroll_x_in_bounds
 12316	81F5	79				    ld a, c
 12317	81F6	BD				    cp l
 12318	81F7	38	02			    jr c, .scroll_x_clamped
 12319	81F9	18	04			    jr .scroll_x_in_bounds
 12320	81FB					
 12321	81FB					.scroll_x_clamped:
 12322	81FB	44				    ld b, h
 12323	81FC	4D				    ld c, l
 12324	81FD	18	04			    jr .scroll_x_done
 12325	81FF					
 12326	81FF					.scroll_x_in_bounds:
 12327	81FF	D1				    pop de
 12328	8200	C1				    pop bc
 12329	8201	C5				    push bc
 12330	8202	D5				    push de
 12331	8203					
 12332	8203					.scroll_x_done:
 12333	8203					    ; Store camera X
 12334	8203	79				    ld a, c
 12335	8204	32	29	C6		    ld (camera_x), a
 12336	8207	78				    ld a, b
 12337	8208	32	2A	C6		    ld (camera_x + 1), a
 12338	820B					
 12339	820B					    ; Calculate camera_tile_x = camera_x / TILE_WIDTH
 12340	820B					    
 12341	820B					    ; Tile width is 16, shift right 4 times
 12342	820B	79				    ld a, c
 12343	820C	CB	38			    srl b
 12344	820E	1F				    rra
 12345	820F	CB	38			    srl b
 12346	8211	1F				    rra
 12347	8212	CB	38			    srl b
 12348	8214	1F				    rra
 12349	8215	CB	38			    srl b
 12350	8217	1F				    rra
 12351	8218	32	2D	C6		    ld (camera_tile_x), a
 12352	821B					
 12353	821B					    ; Bounds check Y
 12354	821B	D1				    pop de                      ; DE = requested Y
 12355	821C	C1				    pop bc
 12356	821D					
 12357	821D					    ; Calculate max Y = (world_height_tiles - SCREEN_HEIGHT_TILES) * TILE_HEIGHT
 12358	821D	3A	30	C6		    ld a, (world_height_tiles)
 12359	8220	D6	18			    sub SCREEN_HEIGHT_TILES
 12360	8222	38	14			    jr c, .scroll_y_in_bounds   ; World smaller than screen
 12361	8224					
 12362	8224	47				    ld b, a
 12363	8225	3E	10			    ld a, 16
 12364	8227	CD	C4	82		    call multiply_a_by_b        ; HL = max Y
 12365	822A					
 12366	822A					    ; If requested Y > max Y, clamp to max Y
 12367	822A	7A				    ld a, d
 12368	822B	BC				    cp h
 12369	822C	38	08			    jr c, .scroll_y_clamped
 12370	822E	20	08			    jr nz, .scroll_y_in_bounds
 12371	8230	7B				    ld a, e
 12372	8231	BD				    cp l
 12373	8232	38	02			    jr c, .scroll_y_clamped
 12374	8234	18	02			    jr .scroll_y_in_bounds
 12375	8236					
 12376	8236					.scroll_y_clamped:
 12377	8236	54				    ld d, h
 12378	8237	5D				    ld e, l
 12379	8238					
 12380	8238					.scroll_y_in_bounds:
 12381	8238					    ; Store camera Y
 12382	8238	7B				    ld a, e
 12383	8239	32	2B	C6		    ld (camera_y), a
 12384	823C	7A				    ld a, d
 12385	823D	32	2C	C6		    ld (camera_y + 1), a
 12386	8240					
 12387	8240					    ; Calculate camera_tile_y = camera_y / TILE_HEIGHT
 12388	8240					    
 12389	8240					    ; Tile height is 16, shift right 4 times
 12390	8240	7B				    ld a, e
 12391	8241	CB	3A			    srl d
 12392	8243	1F				    rra
 12393	8244	CB	3A			    srl d
 12394	8246	1F				    rra
 12395	8247	CB	3A			    srl d
 12396	8249	1F				    rra
 12397	824A	CB	3A			    srl d
 12398	824C	1F				    rra
 12399	824D	32	2E	C6		    ld (camera_tile_y), a
 12400	8250					
 12401	8250					    ; Mark viewport as dirty (needs redraw)
 12402	8250	3E	01			    ld a, 1
 12403	8252	32	31	C6		    ld (scroll_dirty_flag), a
 12404	8255					
 12405	8255	C9				    ret
