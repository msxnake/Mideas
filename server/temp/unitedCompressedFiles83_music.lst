 7515	5963	11	00	14		    ld de, CHRTBL2 + #1000 + (128 * 8) ; VRAM pattern table bank 2 (+#1000 offset + char 128)
 7516	5966	01	90	00		    ld bc, 144    ; Total bytes for all tile characters
