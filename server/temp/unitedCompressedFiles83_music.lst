 18028	9816					
 18029	9816					.do_compare:
 18030	9816					    ; E = Variable Value
 18031	9816					    ; Stack: Compare Value (D), Operator (C in saved BC), Entity Index
 18032	9816	E1				    pop hl                  ; HL = Compare Value (D in H)
 18033	9817	54				    ld d, h                 ; D = Compare Value
 18034	9818	C1				    pop bc                  ; C = Operator ID, B = Entity Index (restore)
 18035	9819	E1				    pop hl                  ; HL = Updated Params Ptr
 18036	981A					    
 18037	981A					    ; Now: E = Variable Value, D = Compare Value, C = Operator
 18038	981A					    ; Perform comparison based on operator
 18039	981A	79				    ld a, c                 ; A = Operator ID
 18040	981B					    
 18041	981B	FE	00			    cp 0                    ; == operator
 18042	981D	28	17			    jr z, .op_equals
 18043	981F	FE	01			    cp 1                    ; != operator
 18044	9821	28	19			    jr z, .op_not_equals
 18045	9823	FE	02			    cp 2                    ; > operator
 18046	9825	28	1B			    jr z, .op_greater
 18047	9827	FE	03			    cp 3                    ; < operator
 18048	9829	28	1F			    jr z, .op_less
 18049	982B	FE	04			    cp 4                    ; >= operator
 18050	982D	28	21			    jr z, .op_greater_equal
 18051	982F	FE	05			    cp 5                    ; <= operator
 18052	9831	28	23			    jr z, .op_less_equal
 18053	9833					    
 18054	9833					    ; Invalid operator, return false
 18055	9833	3E	00			    ld a, 0
 18056	9835	C9				    ret
 18057	9836					
 18058	9836					.op_equals:
 18059	9836	7B				    ld a, e                 ; A = Variable Value
 18060	9837	BA				    cp d                    ; Compare with D
 18061	9838	28	24			    jr z, .return_true
 18062	983A	18	25			    jr .return_false
 18063	983C					
 18064	983C					.op_not_equals:
 18065	983C	7B				    ld a, e
 18066	983D	BA				    cp d
 18067	983E	20	1E			    jr nz, .return_true
 18068	9840	18	1F			    jr .return_false
 18069	9842					
 18070	9842					.op_greater:
 18071	9842	7B				    ld a, e
 18072	9843	BA				    cp d
 18073	9844	28	1B			    jr z, .return_false     ; If equal, not greater
 18074	9846	30	16			    jr nc, .return_true     ; If no carry, E >= D, so E > D (since not equal)
 18075	9848	18	17			    jr .return_false
 18076	984A					
 18077	984A					.op_less:
 18078	984A	7B				    ld a, e
 18079	984B	BA				    cp d
 18080	984C	38	10			    jr c, .return_true      ; If carry, E < D
 18081	984E	18	11			    jr .return_false
 18082	9850					
 18083	9850					.op_greater_equal:
 18084	9850	7B				    ld a, e
 18085	9851	BA				    cp d
 18086	9852	30	0A			    jr nc, .return_true     ; If no carry, E >= D
 18087	9854	18	0B			    jr .return_false
 18088	9856					
 18089	9856					.op_less_equal:
 18090	9856	7B				    ld a, e
 18091	9857	BA				    cp d
 18092	9858	28	04			    jr z, .return_true      ; If equal
 18093	985A	38	02			    jr c, .return_true      ; If carry, E < D
 18094	985C	18	03			    jr .return_false
 18095	985E					
 18096	985E					.return_true:
 18097	985E	3E	01			    ld a, 1
