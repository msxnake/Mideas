 21348	ABBC					; ==================================================================
 21349	ABBC					; ZX0 SPRITE COPY HELPER (AUTO-INJECTED)
 21350	ABBC					; - If HL points to a compressed sprite frame blob, decompress frame
 21351	ABBC					;   to ZX0_SPRITE_FRAME_BUFFER and then upload to VRAM.
 21352	ABBC					; - Otherwise copy raw frame data directly to VRAM.
 21353	ABBC					; Input: HL=source (ROM), DE=VRAM destination, BC=byte count
 21354	ABBC					; ==================================================================
 21355	ABBC					COPY_SPRITE_SRC_TO_VRAM:
 21356	ABBC	D5				    push de
 21357	ABBD					    ; source < ZX0_SPRITE_FRAME_DATA_START => raw copy
 21358	ABBD	E5				    push hl
 21359	ABBE	11	E1	A5		    ld de, ZX0_SPRITE_FRAME_DATA_START
 21360	ABC1	B7				    or a
 21361	ABC2	ED	52			    sbc hl, de
 21362	ABC4	E1				    pop hl
 21363	ABC5	38	1D			    jr c, COPY_SPRITE_SRC_TO_VRAM_RAW
 21364	ABC7					
