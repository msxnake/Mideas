 4783	4E09					    auto_destroy_loop:
 4784	4E09	4E				        ld c, (hl)                    ; C = entity index
 4785	4E0A	23				        inc hl                        ; Advance list pointer
 4786	4E0B	E5				        push hl                       ; Save list pointer
 4787	4E0C	59				        ld e, c
 4788	4E0D	16	00			        ld d, 0
 4789	4E0F	21	40	C7		        ld hl, entity_comp_masks_hi
 4790	4E12	19				        add hl, de
 4791	4E13	7E				        ld a, (hl)
 4792	4E14	E1				        pop hl                        ; Restore list pointer
 4793	4E15	E6	04			        and #04                       ; AUTO_DESTROY bit (COMP_MASK_AUTO_DESTROY=#0400 -> high byte bit2)
 4794	4E17	28	34			        jr z, auto_destroy_next
