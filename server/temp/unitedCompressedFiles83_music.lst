 4953	4E87					    ; ==================================================================
 4954	4E87					    ; PLATFORM RIDING SYSTEM
 4955	4E87					    ; ==================================================================
 4956	4E87					    ; Detects when entities are standing on platforms and transfers velocity
 4957	4E87					    ;
 4958	4E87					    ; Platform detection: Entity A is on platform B if:
 4959	4E87					    ; - A's bottom edge is at or near B's top edge
 4960	4E87					    ; - A has horizontal overlap with B
 4961	4E87					    ; - B has collision_layer bit 3 set (platform layer = 8)
 4962	4E87					    ;
 4963	4E87					    ; Grace frames: 6 frames tolerance when leaving platform
 4964	4E87					
 4965	4E87					init_platform_riding_system:
 4966	4E87					    ; Initialize platform IDs to 255 (no platform)
 4967	4E87	21	DB	CE		    ld hl, entity_platform_id
 4968	4E8A	11	DC	CE		    ld de, entity_platform_id + 1
 4969	4E8D	01	1F	00		    ld bc, 31
 4970	4E90	36	FF			    ld (hl), 255
 4971	4E92	ED	B0			    ldir
 4972	4E94					
 4973	4E94					    ; Initialize grace frames to 0
 4974	4E94	21	FB	CE		    ld hl, entity_platform_grace
 4975	4E97	11	FC	CE		    ld de, entity_platform_grace + 1
 4976	4E9A	01	1F	00		    ld bc, 31
 4977	4E9D	36	00			    ld (hl), 0
 4978	4E9F	ED	B0			    ldir
 4979	4EA1	C9				    ret
 4980	4EA2					
 4981	4EA2					prepare_platform_detection:
 4982	4EA2					    ; PHASE 1 - Called BEFORE collision detection
 4983	4EA2					    ; Clear platform references from previous frame
 4984	4EA2					    ; Entities that were on platforms get grace frames
 4985	4EA2					    ; Collision detection will reset platform_id if still in contact
 4986	4EA2					
 4987	4EA2	06	20			    ld b, 32
 4988	4EA4	21	DB	CE		    ld hl, entity_platform_id
 4989	4EA7	11	FB	CE		    ld de, entity_platform_grace
 4990	4EAA	0E	00			    ld c, 0
 4991	4EAC					
 4992	4EAC					.platform_clear_loop:
 4993	4EAC	7E				    ld a, (hl)              ; A = platform_id
 4994	4EAD	FE	FF			    cp 255                  ; Check if on a platform
 4995	4EAF	28	07			    jr z, .platform_skip_clear ; Already no platform, skip
 4996	4EB1					
 4997	4EB1					    ; Entity was on a platform last frame
 4998	4EB1					    ; Set grace frames to 6 (coyote time for leaving platform)
 4999	4EB1	E5				    push hl
 5000	4EB2	3E	06			    ld a, 6
 5001	4EB4	12				    ld (de), a              ; Set grace frames
 5002	4EB5	E1				    pop hl
 5003	4EB6					
 5004	4EB6					    ; Clear platform reference (collision will reset if still touching)
 5005	4EB6	36	FF			    ld (hl), 255
 5006	4EB8					
 5007	4EB8					.platform_skip_clear:
 5008	4EB8	23				    inc hl                  ; Next platform_id
 5009	4EB9	13				    inc de                  ; Next grace counter
 5010	4EBA	0C				    inc c
 5011	4EBB	10	EF			    djnz .platform_clear_loop
 5012	4EBD	C9				    ret
 5013	4EBE					
 5014	4EBE					update_platform_riding:
 5015	4EBE					    ; PHASE 2 - Called AFTER collision detection
 5016	4EBE					    ; Decrement grace frames for entities not on platforms
 5017	4EBE					    ; (Entities on platforms have grace=0, set by handle_entity_collision)
 5018	4EBE					
 5019	4EBE	06	20			    ld b, 32
 5020	4EC0	21	FB	CE		    ld hl, entity_platform_grace
 5021	4EC3	11	DB	CE		    ld de, entity_platform_id
 5022	4EC6	0E	00			    ld c, 0
 5023	4EC8					
 5024	4EC8					.grace_loop:
 5025	4EC8					    ; Check if entity has platform reference
 5026	4EC8	1A				    ld a, (de)              ; A = platform_id
 5027	4EC9	FE	FF			    cp 255
 5028	4ECB	20	06			    jr nz, .grace_next      ; Has platform, skip grace decrement
 5029	4ECD					
 5030	4ECD					    ; No platform - decrement grace frames if > 0
 5031	4ECD	7E				    ld a, (hl)              ; A = grace frames
 5032	4ECE	B7				    or a
 5033	4ECF	28	02			    jr z, .grace_next       ; Already 0, skip
 5034	4ED1					
 5035	4ED1	3D				    dec a                   ; Decrement grace
 5036	4ED2	77				    ld (hl), a
 5037	4ED3					
 5038	4ED3					.grace_next:
 5039	4ED3	23				    inc hl                  ; Next grace counter
 5040	4ED4	13				    inc de                  ; Next platform_id
 5041	4ED5	0C				    inc c
 5042	4ED6	10	F0			    djnz .grace_loop
 5043	4ED8	C9				    ret
