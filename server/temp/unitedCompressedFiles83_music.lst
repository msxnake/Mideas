 2525	4422	57				    ld d, a                    ; OPTIMIZED: Save mask in D to avoid redundant memory read
 2526	4423	E1				    pop hl                     ; Restore list pointer
 2527	4424	E6	01			    and COMP_MASK_POSITION     ; Check if has position component
 2528	4426	28	49			    jr z, position_next_entity ; Skip if no position component
