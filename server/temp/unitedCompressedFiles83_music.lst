 5606	514F					; ------------------------------------------------------------------
 5607	514F					; wall_build_hitbox_cache
 5608	514F					; ------------------------------------------------------------------
 5609	514F					; Register Contract:
 5610	514F					;   Purpose: Compute and cache hitbox AABB and adaptive probe coordinates
 5611	514F					;            from entity position (wall_temp_x/y) plus collision offsets/sizes.
 5612	514F					;   Inputs:
 5613	514F					;     - DE                        = entity index (used to index per-entity arrays)
 5614	514F					;     - wall_temp_x               = cached entity X origin (set before calling)
 5615	514F					;     - wall_temp_y               = cached entity Y origin (set before calling)
 5616	514F					;     - entity_collision_hitbox_w[DE]: hitbox width  (0 treated as 1)
 5617	514F					;     - entity_collision_hitbox_h[DE]: hitbox height (0 treated as 1)
 5618	514F					;     - entity_collision_offset_x[DE]: signed X offset from entity origin to hitbox left
 5619	514F					;     - entity_collision_offset_y[DE]: signed Y offset from entity origin to hitbox top
 5620	514F					;   Outputs:
 5621	514F					;     - wall_hit_left   = hitbox left  pixel (entity_x + offset_x, clamped 0..255)
 5622	514F					;     - wall_hit_top    = hitbox top   pixel (entity_y + offset_y, clamped 0..255)
 5623	514F					;     - wall_hit_right  = left + (w-1), clamped 0..255
 5624	514F					;     - wall_hit_bottom = top  + (h-1), clamped 0..255
 5625	514F					;     - wall_hit_w      = effective width  (>= 1)
 5626	514F					;     - wall_hit_h      = effective height (>= 1)
 5627	514F					;     - wall_probe_left / wall_probe_right : X probes (inset up to 2px from sides)
 5628	514F					;     - wall_probe_top  / wall_probe_bottom: Y probes (inset up to 2px from top/bottom)
 5629	514F					;   Clobbers: AF, BC, HL
 5630	514F					;   Preserved: DE (entity index is never modified)
 5631	514F					;   Notes:
 5632	514F					;     - Adaptive inset: min(2, floor((right-left)/2)) and min(2, floor((bottom-top)/2)).
 5633	514F					;       Prevents corner-only probes for entities smaller than 4 pixels on an axis.
 5634	514F					;     - Call wall_add_signed_offset_clamped for offset application.
 5635	514F					;     - Called once at entity loop entry; called again after every position snap.
 5636	514F					; ------------------------------------------------------------------
 5637	514F					wall_build_hitbox_cache:
 5638	514F					    ; Width (minimum 1)
 5639	514F	21	3B	CF		    ld hl, entity_collision_hitbox_w
 5640	5152	19				    add hl, de
 5641	5153	7E				    ld a, (hl)
 5642	5154	B7				    or a
 5643	5155	20	02			    jr nz, .wbhc_w_ok
 5644	5157	3E	01			    ld a, 1
 5645	5159					.wbhc_w_ok:
 5646	5159	32	E1	D0		    ld (wall_hit_w), a
 5647	515C					
 5648	515C					    ; Height (minimum 1)
 5649	515C	21	5B	CF		    ld hl, entity_collision_hitbox_h
 5650	515F	19				    add hl, de
 5651	5160	7E				    ld a, (hl)
 5652	5161	B7				    or a
 5653	5162	20	02			    jr nz, .wbhc_h_ok
 5654	5164	3E	01			    ld a, 1
 5655	5166					.wbhc_h_ok:
 5656	5166	32	E2	D0		    ld (wall_hit_h), a
 5657	5169					
 5658	5169					    ; left = entity_x + offset_x (signed, clamped)
 5659	5169	3A	DB	D0		    ld a, (wall_temp_x)
 5660	516C	21	7B	CF		    ld hl, entity_collision_offset_x
 5661	516F	19				    add hl, de
 5662	5170	CD	DE	51		    call wall_add_signed_offset_clamped
 5663	5173	32	DD	D0		    ld (wall_hit_left), a
 5664	5176					
 5665	5176					    ; top = entity_y + offset_y (signed, clamped)
 5666	5176	3A	DC	D0		    ld a, (wall_temp_y)
 5667	5179	21	9B	CF		    ld hl, entity_collision_offset_y
 5668	517C	19				    add hl, de
 5669	517D	CD	DE	51		    call wall_add_signed_offset_clamped
 5670	5180	32	DE	D0		    ld (wall_hit_top), a
 5671	5183					
 5672	5183					    ; right = left + (w-1), clamped
 5673	5183	3A	E1	D0		    ld a, (wall_hit_w)
 5674	5186	3D				    dec a
 5675	5187	47				    ld b, a
 5676	5188	3A	DD	D0		    ld a, (wall_hit_left)
 5677	518B	80				    add a, b
 5678	518C	30	02			    jr nc, .wbhc_right_ok
 5679	518E	3E	FF			    ld a, 255
 5680	5190					.wbhc_right_ok:
 5681	5190	32	DF	D0		    ld (wall_hit_right), a
 5682	5193					
 5683	5193					    ; bottom = top + (h-1), clamped
 5684	5193	3A	E2	D0		    ld a, (wall_hit_h)
 5685	5196	3D				    dec a
 5686	5197	47				    ld b, a
 5687	5198	3A	DE	D0		    ld a, (wall_hit_top)
 5688	519B	80				    add a, b
 5689	519C	30	02			    jr nc, .wbhc_bottom_ok
 5690	519E	3E	FF			    ld a, 255
 5691	51A0					.wbhc_bottom_ok:
 5692	51A0	32	E0	D0		    ld (wall_hit_bottom), a
 5693	51A3					
 5694	51A3					    ; ---- Adaptive X probes: inset = min(2, floor((right-left)/2)) ----
 5695	51A3					    ; Purpose: avoid probing the exact corner pixels for small sprites.
 5696	51A3					    ; For a 16px-wide entity: inset = min(2, 8) = 2.
 5697	51A3					    ;   probe_left  = left  + 2  (2px inside left edge)
 5698	51A3					    ;   probe_right = right - 2  (2px inside right edge)
 5699	51A3					    ; For a 4px-wide entity: inset = min(2, 2) = 2 (probes overlap at center).
 5700	51A3					    ; For a 2px-wide entity: inset = min(2, 1) = 1.
 5701	51A3	3A	DD	D0		    ld a, (wall_hit_left)
 5702	51A6	4F				    ld c, a                       ; C = left pixel
 5703	51A7	3A	DF	D0		    ld a, (wall_hit_right)
 5704	51AA	91				    sub c                         ; A = width span (right - left)
 5705	51AB	CB	3F			    srl a                         ; A = span / 2
 5706	51AD	FE	03			    cp 3                          ; is span/2 < 3 (i.e. inset < 2)?
 5707	51AF	38	02			    jr c, .wbhc_inset_x_ready    ; yes: use as-is
 5708	51B1	3E	02			    ld a, 2                       ; no: cap inset at 2
 5709	51B3					.wbhc_inset_x_ready:
 5710	51B3	47				    ld b, a                       ; B = inset value
 5711	51B4	79				    ld a, c
 5712	51B5	80				    add a, b
 5713	51B6	32	E3	D0		    ld (wall_probe_left), a       ; probe_left  = left  + inset
 5714	51B9	3A	DF	D0		    ld a, (wall_hit_right)
 5715	51BC	90				    sub b
 5716	51BD	32	E4	D0		    ld (wall_probe_right), a      ; probe_right = right - inset
 5717	51C0					
 5718	51C0					    ; ---- Adaptive Y probes: inset = min(2, floor((bottom-top)/2)) ----
 5719	51C0					    ; Same logic on Y axis.
 5720	51C0					    ;   probe_top    = top    + inset
 5721	51C0					    ;   probe_bottom = bottom - inset
 5722	51C0	3A	DE	D0		    ld a, (wall_hit_top)
 5723	51C3	4F				    ld c, a                       ; C = top pixel
 5724	51C4	3A	E0	D0		    ld a, (wall_hit_bottom)
 5725	51C7	91				    sub c                         ; A = height span (bottom - top)
 5726	51C8	CB	3F			    srl a                         ; A = span / 2
 5727	51CA	FE	03			    cp 3
 5728	51CC	38	02			    jr c, .wbhc_inset_y_ready
 5729	51CE	3E	02			    ld a, 2
 5730	51D0					.wbhc_inset_y_ready:
 5731	51D0	47				    ld b, a                       ; B = inset value
 5732	51D1	79				    ld a, c
 5733	51D2	80				    add a, b
 5734	51D3	32	E5	D0		    ld (wall_probe_top), a        ; probe_top    = top    + inset
 5735	51D6	3A	E0	D0		    ld a, (wall_hit_bottom)
 5736	51D9	90				    sub b
 5737	51DA	32	E6	D0		    ld (wall_probe_bottom), a     ; probe_bottom = bottom - inset
 5738	51DD	C9				    ret
 5739	51DE					
 5740	51DE					; ------------------------------------------------------------------
 5741	51DE					; wall_add_signed_offset_clamped
 5742	51DE					; ------------------------------------------------------------------
 5743	51DE					; Register Contract:
 5744	51DE					;   Purpose: Add a signed 8-bit offset to a pixel coordinate, clamping result to 0..255.
 5745	51DE					;            Used to apply entity_collision_offset_x/y to entity origin (entity???hitbox).
 5746	51DE					;   Inputs:
 5747	51DE					;     - A  = base pixel coordinate (unsigned, 0..255)
 5748	51DE					;     - HL = pointer to signed offset byte (-128..127)
 5749	51DE					;   Outputs:
 5750	51DE					;     - A  = clamp(base + offset, 0, 255)
 5751	51DE					;   Clobbers: AF, B
 5752	51DE					;   Preserved: C, DE, HL
 5753	51DE					;   Notes:
 5754	51DE					;     - Negative offset: carry=0 after add ??? underflow ??? A clamped to 0.
 5755	51DE					;     - Positive offset: carry=1 after add ??? overflow ??? A clamped to 255.
 5756	51DE					;     - B is used to hold the offset byte; caller must save B if needed.
 5757	51DE					; ------------------------------------------------------------------
 5758	51DE					wall_add_signed_offset_clamped:
 5759	51DE	46				    ld b, (hl)                    ; B = signed offset
 5760	51DF	80				    add a, b
 5761	51E0	CB	78			    bit 7, b
 5762	51E2	28	04			    jr z, .wasc_positive
 5763	51E4					    ; Negative offset: carry=0 means underflow
 5764	51E4	38	06			    jr c, .wasc_done
 5765	51E6	AF				    xor a
 5766	51E7	C9				    ret
 5767	51E8					.wasc_positive:
 5768	51E8					    ; Positive offset: carry=1 means overflow
 5769	51E8	30	02			    jr nc, .wasc_done
 5770	51EA	3E	FF			    ld a, 255
 5771	51EC					.wasc_done:
 5772	51EC	C9				    ret
 5773	51ED					
 5774	51ED					; ------------------------------------------------------------------
 5775	51ED					; wall_sub_signed_offset_clamped
 5776	51ED					; ------------------------------------------------------------------
 5777	51ED					; Register Contract:
 5778	51ED					;   Purpose: Subtract a signed 8-bit offset from a hitbox coordinate, clamping to 0..255.
 5779	51ED					;            Used to convert hitbox left/top back to entity origin after a snap.
 5780	51ED					;            Inverse of wall_add_signed_offset_clamped.
 5781	51ED					;   Inputs:
 5782	51ED					;     - A  = hitbox pixel coordinate (left or top, unsigned 0..255)
 5783	51ED					;     - HL = pointer to signed collision offset byte (-128..127)
 5784	51ED					;            (same pointer passed to wall_add_signed_offset_clamped when building)
 5785	51ED					;   Outputs:
 5786	51ED					;     - A  = clamp(hitbox - offset, 0, 255)
 5787	51ED					;            i.e. the entity origin coordinate that produces the snapped hitbox edge
 5788	51ED					;   Clobbers: AF, B, C
 5789	51ED					;   Preserved: DE, HL
 5790	51ED					;   Notes:
 5791	51ED					;     - If offset is negative: hitbox - offset = hitbox + abs(offset).
 5792	51ED					;       Overflow (carry clear after add) ??? A clamped to 255.
 5793	51ED					;     - If offset is positive: hitbox - offset computed directly.
 5794	51ED					;       Underflow (carry clear after sub) ??? A clamped to 0.
 5795	51ED					;     - B holds the raw offset byte; C holds the original hitbox coordinate.
 5796	51ED					; ------------------------------------------------------------------
 5797	51ED					wall_sub_signed_offset_clamped:
 5798	51ED	4F				    ld c, a
 5799	51EE	46				    ld b, (hl)                    ; B = signed offset
 5800	51EF	CB	78			    bit 7, b
 5801	51F1	28	09			    jr z, .wssc_positive
 5802	51F3					    ; offset < 0 -> hitbox - offset = hitbox + abs(offset)
 5803	51F3	78				    ld a, b
 5804	51F4	ED	44			    neg
 5805	51F6	81				    add a, c
 5806	51F7	30	08			    jr nc, .wssc_done
 5807	51F9	3E	FF			    ld a, 255
 5808	51FB	C9				    ret
 5809	51FC					.wssc_positive:
 5810	51FC	79				    ld a, c
 5811	51FD	90				    sub b
 5812	51FE	30	01			    jr nc, .wssc_done
 5813	5200	AF				    xor a
 5814	5201					.wssc_done:
 5815	5201	C9				    ret
