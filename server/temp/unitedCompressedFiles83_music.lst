 6794	5672					; ------------------------------------------------------------------
 6795	5672					; Register Contract:
 6796	5672					;   Purpose: Mark compact active-entity cache as stale.
 6797	5672					;   Inputs:
 6798	5672					;     - None
 6799	5672					;   Outputs:
 6800	5672					;     - active_entity_list_dirty = 1
 6801	5672					;   Clobbers:
 6802	5672					;     - HL
 6803	5672					;   Preserved:
 6804	5672					;     - AF
 6805	5672					;     - BC
 6806	5672					;     - DE
 6807	5672					;   Register roles:
 6808	5672					;     - HL = points to dirty flag byte
