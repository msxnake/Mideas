 18714	9B3D					; (the load_screen function sets VDP colors and name table from screen asset)
 18715	9B3D					; If screen_load_ptr == 0: sets bgColor, clears screen, renders text on solid bg
 18716	9B3D					; ------------------------------------------------------------------
