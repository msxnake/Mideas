 17981	97E3					
 17982	97E3	D5				    push de                 ; Save Compare Value
 17983	97E4	11	64	98		    ld de, SM_GlobalVarTable
 17984	97E7	19				    add hl, de              ; HL = &SM_GlobalVarTable[VarID - 6]
 17985	97E8					
 17986	97E8					    ; Read address from table
 17987	97E8	5E				    ld e, (hl)
 17988	97E9	23				    inc hl
 17989	97EA	56				    ld d, (hl)              ; DE = address of global variable
 17990	97EB					
 17991	97EB					    ; Read value
 17992	97EB	1A				    ld a, (de)              ; A = global variable value
 17993	97EC	5F				    ld e, a                 ; E = variable value
 17994	97ED	D1				    pop de                  ; Restore Compare Value to D
 17995	97EE	18	26			    jr .do_compare
