 14578	89DE					    ; ------------------------------------------------------------------
 14579	89DE					    ; BLOQUE 1: Redirect direccional
 14580	89DE					    ; Si entity_facing_dir[entity] != 0, reemplaza el sprite pedido por
 14581	89DE					    ; su variante para la direcci??n actual.
 14582	89DE					    ;   facing 0 = sin direcci??n ??? usar sprite tal cual
 14583	89DE					    ;   facing 1 = izquierda  ??? SM_FacingDirTablePtrs[0] ??? sprite_dir_left_table
 14584	89DE					    ;   facing 2 = derecha     ??? SM_FacingDirTablePtrs[1] ??? sprite_dir_right_table
 14585	89DE					    ;   facing 3 = arriba      ??? SM_FacingDirTablePtrs[2] ??? sprite_dir_up_table
 14586	89DE					    ;   facing 4 = abajo       ??? SM_FacingDirTablePtrs[3] ??? sprite_dir_down_table
 14587	89DE					    ;
 14588	89DE					    ; Las tablas de direcci??n son arrays de 1 byte por sprite asset:
 14589	89DE					    ;   dir_table[originalSprite] = spriteVariante
 14590	89DE					    ; Si no existe variante, la tabla devuelve el mismo ID original.
 14591	89DE					    ;
 14592	89DE					    ; IMPORTANTE: este bloque usa B como temporal para guardar el sprite ID.
 14593	89DE					    ; Al salir, B queda con el sprite ID (no con 0). Se corrige despu??s.
 14594	89DE					    ; ------------------------------------------------------------------
 14595	89DE	E5				    push hl                 ; [stack] guarda &entity_sprite_asset_index[entity]
 14596	89DF					
 14597	89DF	26	00			    ld h, 0
 14598	89E1	69				    ld l, c                 ; HL = entity index
 14599	89E2	11	A0	C9		    ld de, entity_facing_dir
 14600	89E5	19				    add hl, de              ; HL = &entity_facing_dir[entity]
 14601	89E6	5E				    ld e, (hl)              ; E = facing dir (0=none, 1=left, 2=right, 3=up, 4=down)
 14602	89E7					
 14603	89E7	47				    ld b, a                 ; B = sprite ID original  [B QUEDA CORRUPTO hasta ld b,0 abajo]
 14604	89E8	7B				    ld a, e                 ; A = facing dir
 14605	89E9	B7				    or a
 14606	89EA	28	11			    jr z, .acs_dir_done     ; facing = 0 ??? no hay redirect, usar sprite original
 14607	89EC					
 14608	89EC					    ; Convertir facing (1-4) a ??ndice de tabla (0-3): dec a
 14609	89EC	3D				    dec a                   ; A = ??ndice en SM_FacingDirTablePtrs (0=left, 1=right, 2=up, 3=down)
 14610	89ED	21	CA	89		    ld hl, SM_FacingDirTablePtrs
 14611	89F0	16	00			    ld d, 0
 14612	89F2	5F				    ld e, a
 14613	89F3	19				    add hl, de
 14614	89F4	19				    add hl, de              ; HL = &SM_FacingDirTablePtrs[facing_index * 2]  (tabla de punteros, DW)
 14615	89F5	5E				    ld e, (hl)
 14616	89F6	23				    inc hl
