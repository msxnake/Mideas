 8610	5FD7					; Helper function to initialize character 0 (empty cell) with background color
 8611	5FD7					; Input: A = background color (0-15)
 8612	5FD7					; This ensures empty cells show the correct background color instead of BIOS default (blue)
 8613	5FD7					init_char0_color:
 8614	5FD7	F5				    push af
 8615	5FD8	C5				    push bc
 8616	5FD9	D5				    push de
 8617	5FDA	E5				    push hl
 8618	5FDB					    
 8619	5FDB					    ; Calculate color byte: (bg_color << 4) | bg_color
 8620	5FDB					    ; This makes both foreground and background the same color
 8621	5FDB	E6	0F			    and #0F                    ; Ensure 0-15 range
 8622	5FDD	47				    ld b, a                    ; Save in B
