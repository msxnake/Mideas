 18708	9B3D					; show_text_screen
 18709	9B3D					; Display full text screen with optional background screen asset
 18710	9B3D					; Input: DE = text data pointer
 18711	9B3D					;   Format: DB bgColor, DW screen_load_ptr (0=none), DB screen_load_bank, DB numLines
 18712	9B3D					;           Per line: DB row, DB col, DW string_ptr
