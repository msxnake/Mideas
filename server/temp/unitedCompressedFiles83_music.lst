 13705	868D					
 13706	868D					; ------------------------------------------------------------------
 13707	868D					; update_particle_pattern
 13708	868D					; Redefine particle's pattern in VRAM based on type and frame
 13709	868D					; Input:  HL = Address of particle structure
 13710	868D					; Destroys: AF, BC, DE, HL
 13711	868D					; ------------------------------------------------------------------
 13712	868D					update_particle_pattern:
 13713	868D					    ; Get type and frame
 13714	868D	7E				    ld a, (hl)                  ; Offset 0: type
 13715	868E	47				    ld b, a                     ; B = type
 13716	868F	23				    inc hl
 13717	8690	23				    inc hl
 13718	8691	23				    inc hl
 13719	8692	23				    inc hl
 13720	8693	7E				    ld a, (hl)                  ; Offset 4: frame
 13721	8694	4F				    ld c, a                     ; C = frame
 13722	8695	2B				    dec hl
 13723	8696	2B				    dec hl
 13724	8697	23				    inc hl
 13725	8698	7E				    ld a, (hl)                  ; Offset 5: tile ID
 13726	8699	57				    ld d, a                     ; D = tile ID
 13727	869A					
 13728	869A					    ; Calculate pattern source address
 13729	869A					    ; particle_patterns + (type * 32) + (frame * 8)
 13730	869A	78				    ld a, b                     ; A = type
 13731	869B	87				    add a, a
 13732	869C	87				    add a, a
 13733	869D	87				    add a, a
 13734	869E	87				    add a, a
 13735	869F	87				    add a, a                    ; * 32 (4 frames * 8 bytes)
 13736	86A0	6F				    ld l, a
 13737	86A1	26	00			    ld h, 0
 13738	86A3					
 13739	86A3	79				    ld a, c                     ; A = frame
 13740	86A4	87				    add a, a
 13741	86A5	87				    add a, a
 13742	86A6	87				    add a, a                    ; * 8
 13743	86A7	5F				    ld e, a
 13744	86A8	16	00			    ld d, 0
 13745	86AA	19				    add hl, de
 13746	86AB					
 13747	86AB	11	C3	86		    ld de, particle_patterns
 13748	86AE	19				    add hl, de                  ; HL = source pattern address
 13749	86AF					
 13750	86AF					    ; Calculate VRAM destination
 13751	86AF					    ; CHRTBL + (tile_id * 8)
 13752	86AF	7A				    ld a, d                     ; A = tile ID
 13753	86B0	5F				    ld e, a
 13754	86B1	16	00			    ld d, 0
 13755	86B3	EB				    ex de, hl                   ; DE = source, HL = tile_id
 13756	86B4	29				    add hl, hl
 13757	86B5	29				    add hl, hl
 13758	86B6	29				    add hl, hl                  ; * 8
 13759	86B7	01	00	00		    ld bc, CHRTBL
 13760	86BA	09				    add hl, bc                  ; HL = VRAM address
 13761	86BB					
 13762	86BB	EB				    ex de, hl                   ; DE = VRAM, HL = source
 13763	86BC					
 13764	86BC					    ; Copy 8 bytes to VRAM
 13765	86BC	01	08	00		    ld bc, 8
 13766	86BF	CD	5C	00		    call LDIRVM
 13767	86C2					
 13768	86C2	C9				    ret
