 17951	97BF					
 17952	97BF					    ; Entity variables (ID 0-5)
 17953	97BF	48				    ld c, b                 ; C = Entity Index
 17954	97C0	06	00			    ld b, 0                 ; BC = Entity Index
 17955	97C2					
 17956	97C2	FE	00			    cp 0                    ; Check if x
 17957	97C4	28	2A			    jr z, .get_x
 17958	97C6	FE	01			    cp 1                    ; Check if y
 17959	97C8	28	2D			    jr z, .get_y
 17960	97CA	FE	02			    cp 2                    ; Check if vx
 17961	97CC	28	30			    jr z, .get_vx
 17962	97CE	FE	03			    cp 3                    ; Check if vy
 17963	97D0	28	33			    jr z, .get_vy
 17964	97D2	FE	04			    cp 4                    ; Check if isOnGround
 17965	97D4	28	36			    jr z, .get_on_ground
