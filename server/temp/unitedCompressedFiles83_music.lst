 4678	4DA1					    ; Entity has gravity - apply acceleration
 4679	4DA1	C5				            push bc
 4680	4DA2	E5				            push hl
 4681	4DA3					
 4682	4DA3					    ; Check if entity is grounded
 4683	4DA3	21	78	CD		            ld hl, entity_on_ground
 4684	4DA6	59				            ld e, c
 4685	4DA7	16	00			            ld d, 0
 4686	4DA9	19				            add hl, de
 4687	4DAA	7E				            ld a, (hl)
 4688	4DAB	CB	47			            bit 0, a; Check ground flag
 4689	4DAD	20	2F			            jr nz, gravity_grounded; Skip gravity if on ground
 4690	4DAF					
 4691	4DAF					    ; Apply gravity acceleration
 4692	4DAF	21	5B	D0		            ld hl, entity_gravity_vel
 4693	4DB2	59				            ld e, c
 4694	4DB3	16	00			            ld d, 0
 4695	4DB5	19				            add hl, de
 4696	4DB6	19				            add hl, de; HL points to gravity velocity(word)
 4697	4DB7					
 4698	4DB7	5E				            ld e, (hl); Load current gravity velocity
 4699	4DB8	23				            inc hl
 4700	4DB9	56				            ld d, (hl)
 4701	4DBA					
 4702	4DBA					    ; Add gravity strength(64 in fixed - point = ~0.25 pixels / frame acceleration)
 4703	4DBA	7B				            ld a, e
 4704	4DBB	C6	40			            add a, #40; Add 64 to low byte
 4705	4DBD	5F				            ld e, a
 4706	4DBE	7A				            ld a, d
 4707	4DBF	CE	00			            adc a, #00; Add carry to high byte
 4708	4DC1	57				            ld d, a
 4709	4DC2					
 4710	4DC2					    ; Check terminal velocity(1024 = max fall speed)
 4711	4DC2					    ; Skip cap if velocity is negative (entity is moving UP / jumping)
 4712	4DC2	7A				            ld a, d
 4713	4DC3	CB	7F			            bit 7, a; Check sign bit - negative means going up
 4714	4DC5	20	07			            jr nz, gravity_store_vel; Skip cap for upward velocity
 4715	4DC7	FE	04			            cp #04; Check if >= 1024 (unsigned, only for positive/downward)
 4716	4DC9	38	03			            jr c, gravity_store_vel; If < 1024, continue
 4717	4DCB	11	00	04		            ld de, #0400; Cap at terminal velocity
