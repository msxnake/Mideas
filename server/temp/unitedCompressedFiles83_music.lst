 17931	97B2					Condition_VariableCompare:
 17932	97B2					    ; Params: VarID (1 byte), Operator (1 byte), Value (1 byte)
 17933	97B2					    ; Input: B = Entity Index, HL = Params Ptr
 17934	97B2					    ; Output: A = 1 (true) or 0 (false), HL = Updated Ptr
 17935	97B2					    ; Supports entity variables (ID 0-5) and global variables (ID 6+)
 17936	97B2					
 17937	97B2	7E				    ld a, (hl)              ; A = Variable ID
 17938	97B3	23				    inc hl
 17939	97B4	4E				    ld c, (hl)              ; C = Operator ID
 17940	97B5	23				    inc hl
 17941	97B6	56				    ld d, (hl)              ; D = Compare Value
 17942	97B7	23				    inc hl
 17943	97B8					
 17944	97B8	E5				    push hl                 ; Save updated params ptr
 17945	97B9	C5				    push bc                 ; Save Operator and Entity Index
 17946	97BA	D5				    push de                 ; Save Compare Value
 17947	97BB					
 17948	97BB					    ; Check if VarID < 6 (entity variable) or >= 6 (global variable)
 17949	97BB	FE	06			    cp 6
