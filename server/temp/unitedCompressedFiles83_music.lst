 13541	860A	46				    ld b, (hl)
 13542	860B	23				    inc hl
 13543	860C	23				    inc hl
 13544	860D	23				    inc hl
 13545	860E	23				    inc hl
 13546	860F	7E				    ld a, (hl)
 13547	8610	80				    add a, b
 13548	8611	2B				    dec hl
 13549	8612	2B				    dec hl
 13550	8613	2B				    dec hl
 13551	8614	2B				    dec hl
