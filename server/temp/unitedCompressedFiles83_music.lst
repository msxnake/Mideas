 2361	4377					entity_jump_count   EQU temp_byte_4; Current jump count(0 = grounded, 1 = first jump, etc.)(32 bytes)
 2362	4377					entity_jump_max     EQU temp_byte_25; Configured max jumps for this entity (32 bytes)
 2363	4377					entity_jump_bonus   EQU temp_byte_27; Temporary extra jumps granted by bonus tiles (32 bytes)
 2364	4377					entity_on_ground    EQU temp_byte_5; Ground contact flag(bit 0 = on ground)(32 bytes)
 2365	4377					
 2366	4377					    ; Gravity Component Data
 2367	4377					entity_gravity_vel  EQU temp_word_4; Accumulated gravity velocity(signed word, 64 bytes)
 2368	4377					
 2369	4377					    ; Health Component Data
 2370	4377					entity_health_current EQU temp_byte_6 ; Current health/lives (32 bytes)
 2371	4377					entity_health_max     EQU temp_byte_7 ; Maximum health/lives (32 bytes)
 2372	4377					
 2373	4377					    ; Deadly Tile Collision Data
 2374	4377					entity_deadly_collision EQU temp_byte_8 ; Flag: bit 0 = touching deadly tile (32 bytes)
 2375	4377					
 2376	4377					    ; Damage Component Data
 2377	4377					entity_invincibility_frames EQU temp_byte_9  ; Countdown timer for invulnerability (32 bytes)
