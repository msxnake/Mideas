 12083	72EE					; music_execute_command
 12084	72EE					; Dispatch a music command from Game Flow nodes.
 12085	72EE					; Input:  DE -> [command, trackIndex, loopFlag]
 12086	72EE					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 12087	72EE					; Destroys: AF, BC (play path), DE (play path), HL
