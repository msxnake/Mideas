 8321	5C9E					; SPRITE MANAGEMENT FUNCTIONS
 8322	5C9E					; ==================================================================
 8323	5C9E					
 8324	5C9E					; A = hardware sprite index, B = X, C = Y, D = pattern, E = color
 8325	5C9E					show_sprite:
 8326	5C9E					    ; Safety check: Ensure sprite index < 32
 8327	5C9E	FE	20			    cp 32
 8328	5CA0	D0				    ret nc
 8329	5CA1					
 8330	5CA1					    ; Safety check: Never write Y >= 208 (208 is SAT end marker on MSX)
 8331	5CA1	F5				    push af
 8332	5CA2	79				    ld a, c
 8333	5CA3	FE	D0			    cp 208
 8334	5CA5	38	02			    jr c, .y_ok
 8335	5CA7	0E	E0			    ld c, SPRITE_INVISIBLE
 8336	5CA9					.y_ok:
 8337	5CA9	F1				    pop af
 8338	5CAA					
 8339	5CAA					    ; Save pattern (D) and color (E) before calculating address
 8340	5CAA	D5				    push de
 8341	5CAB					
 8342	5CAB					    ; Calculate base address for sprite: index * 4
 8343	5CAB	6F				    ld l, a
 8344	5CAC	26	00			    ld h, 0
 8345	5CAE	29				    add hl, hl      ; index * 2
 8346	5CAF	29				    add hl, hl      ; index * 4
 8347	5CB0					    ; Add base of the attribute table
 8348	5CB0	11	42	CB		    ld de, sprite_attributes
 8349	5CB3	19				    add hl, de      ; HL = &sprite_attributes[index * 4]
 8350	5CB4					
 8351	5CB4					    ; Restore pattern and color
 8352	5CB4	D1				    pop de
 8353	5CB5					
 8354	5CB5					    ; Write attributes
 8355	5CB5	71				    ld (hl), c      ; Y
 8356	5CB6	23				    inc hl
 8357	5CB7	70				    ld (hl), b      ; X
 8358	5CB8	23				    inc hl
 8359	5CB9	72				    ld (hl), d      ; Pattern
 8360	5CBA	23				    inc hl
 8361	5CBB	73				    ld (hl), e      ; Color
 8362	5CBC					
 8363	5CBC	3E	01			    ld a, 1
 8364	5CBE	32	E1	CA		    ld (sprites_dirty), a
 8365	5CC1	C9				    ret
 8366	5CC2					
 8367	5CC2					; Clear all sprites (set Y = SPRITE_INVISIBLE)
 8368	5CC2					; OPTIMIZED: Uses faster increment method instead of ADD HL,DE
 8369	5CC2					clear_all_sprites:
 8370	5CC2	21	42	CB		    ld hl, sprite_attributes
 8371	5CC5	06	20			    ld b, 32
 8372	5CC7	3E	E0			    ld a, SPRITE_INVISIBLE
 8373	5CC9					.sprite_clear_loop:
 8374	5CC9	77				    ld (hl), a      ; Set Y = SPRITE_INVISIBLE
 8375	5CCA	23				    inc hl          ; Skip to X
 8376	5CCB	23				    inc hl          ; Skip to Pattern
 8377	5CCC	23				    inc hl          ; Skip to Color
 8378	5CCD	23				    inc hl          ; Next sprite (4?? INC HL = 24 cycles vs ADD HL,DE = 35 cycles)
 8379	5CCE	10	F9			    djnz .sprite_clear_loop
 8380	5CD0	3E	01			    ld a, 1
 8381	5CD2	32	E1	CA		    ld (sprites_dirty), a
 8382	5CD5	C9				    ret
 8383	5CD6					
 8384	5CD6					; Hide specific sprite (A = hardware sprite index)
 8385	5CD6					hide_sprite:
 8386	5CD6	FE	20			    cp 32
 8387	5CD8	D0				    ret nc
 8388	5CD9	6F				    ld l, a
 8389	5CDA	26	00			    ld h, 0
 8390	5CDC	29				    add hl, hl
 8391	5CDD	29				    add hl, hl
 8392	5CDE	11	42	CB		    ld de, sprite_attributes
 8393	5CE1	19				    add hl, de
 8394	5CE2	36	E0			    ld (hl), SPRITE_INVISIBLE
 8395	5CE4	3E	01			    ld a, 1
 8396	5CE6	32	E1	CA		    ld (sprites_dirty), a
 8397	5CE9	C9				    ret
 8398	5CEA					
 8399	5CEA					; Copy sprite attributes from RAM to VRAM
 8400	5CEA					update_sprites_to_vram:
 8401	5CEA	3A	E1	CA		    ld a, (sprites_dirty)
 8402	5CED	B7				    or a
 8403	5CEE	C8				    ret z
 8404	5CEF	AF				    xor a
 8405	5CF0	32	E1	CA		    ld (sprites_dirty), a
 8406	5CF3	21	42	CB		    ld hl, sprite_attributes
 8407	5CF6	11	00	1B		    ld de, SPRATR
 8408	5CF9	01	20	00		    ld bc, 32  ; Upload active sprite range + SAT end marker
 8409	5CFC	CD	B3	40		    call FAST_LDIRVM
 8410	5CFF	C9				    ret
