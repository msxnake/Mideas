 19725	9F75					
 19726	9F75					; ==================================================================
 19727	9F75					; trans_clear_pixel_row_colors
 19728	9F75					; Blackens a single pixel row (1px tall) by setting the color table
 19729	9F75					; entry for all 256 tile patterns in the appropriate bank to 0x11
 19730	9F75					; (fg=black, bg=black).  Works at 1-pixel-row granularity unlike
 19731	9F75					; trans_clear_row_direct which works at 8-pixel (tile-row) granularity.
 19732	9F75					;
 19733	9F75					; Screen 2 color table layout:
 19734	9F75					;   Bank 0 (#2000): tiles used in name-table rows 0-7   (pixel rows 0-63)
 19735	9F75					;   Bank 1 (#2800): tiles used in name-table rows 8-15  (pixel rows 64-127)
 19736	9F75					;   Bank 2 (#3000): tiles used in name-table rows 16-23 (pixel rows 128-191)
 19737	9F75					; Each tile has 8 color bytes; byte J covers pixel sub-row J of that tile.
 19738	9F75					; Tile T color byte for sub-row J:  bank_base + T*8 + J
 19739	9F75					;
 19740	9F75					; Input:  A = pixel row (0-191)
 19741	9F75					;         bank    = A >> 6   (0-2)
 19742	9F75					;         sub_row = A & 7    (0-7)
 19743	9F75					;         color_base = #2000 + bank * #0800
 19744	9F75					; Preserves: BC, DE, HL
 19745	9F75					; ==================================================================
 19746	9F75					trans_clear_pixel_row_colors:
 19747	9F75	C5				    push bc
 19748	9F76	D5				    push de
 19749	9F77	E5				    push hl
 19750	9F78					    ; --- Compute sub_row = A & 7 ---
 19751	9F78	6F				    ld l, a                       ; L = pixel row (save)
 19752	9F79	E6	07			    and 7
 19753	9F7B	5F				    ld e, a                       ; E = sub_row (0-7)
 19754	9F7C					    ; --- Compute bank = A >> 6 (0-2) ---
 19755	9F7C	7D				    ld a, l
 19756	9F7D	CB	3F			    srl a
 19757	9F7F	CB	3F			    srl a
 19758	9F81	CB	3F			    srl a
 19759	9F83	CB	3F			    srl a
 19760	9F85	CB	3F			    srl a
 19761	9F87	CB	3F			    srl a                         ; A = bank (0, 1 or 2)
 19762	9F89					    ; --- Compute H = #20 + bank*8 (color table high byte) ---
 19763	9F89					    ; bank=0 -> H=#20, bank=1 -> H=#28, bank=2 -> H=#30
 19764	9F89	87				    add a, a                      ; bank * 2
 19765	9F8A	87				    add a, a                      ; bank * 4
 19766	9F8B	87				    add a, a                      ; bank * 8
 19767	9F8C	C6	20			    add a, #20
 19768	9F8E	67				    ld h, a                       ; H = color table high byte for this bank
 19769	9F8F	6B				    ld l, e                       ; L = sub_row  (offset within tile 0 entry)
 19770	9F90					    ; HL now = address of tile-0 color byte for this pixel sub-row
 19771	9F90					    ; --- Write 0x11 (black/black) for all 256 tiles ---
 19772	9F90					    ; Tile addresses: HL, HL+8, HL+16, ... HL+255*8
 19773	9F90					    ; (consecutive tiles are 8 bytes apart in the color table)
 19774	9F90	06	00			    ld b, 0                       ; B=0 ??? djnz executes 256 times
