 12893	83DF					; ==================================================================
 12894	83DF					; TRANSFORM MODE ROUTINES (Z80 runtime bit/row transforms)
 12895	83DF					; ==================================================================
 12896	83DF					
 12897	83DF					; ------------------------------------------------------------------
 12898	83DF					; Routine: update_animated_transform_tiles_vram
 12899	83DF					; Purpose:
 12900	83DF					;   Applies Z80 transform operations directly on tile bytes in VRAM.
 12901	83DF					; Input:
 12902	83DF					;   None
 12903	83DF					; Output:
 12904	83DF					;   None
 12905	83DF					; Modifies:
 12906	83DF					;   AF, BC, DE, HL
 12907	83DF					; Preserves:
 12908	83DF					;   IX, IY, SP
 12909	83DF					; Flags:
 12910	83DF					;   Not preserved
 12911	83DF					; Stack:
 12912	83DF					;   Uses PUSH/POP HL, BC and DE internally
 12913	83DF					; ------------------------------------------------------------------
 12914	83DF					update_animated_transform_tiles_vram:
 12915	83DF	21	04	85		    ld hl, anim_transform_table
 12916	83E2					
 12917	83E2					.anim_transform_loop:
 12918	83E2	7E				    ld a, (hl)                      ; A = target char code
 12919	83E3	FE	FF			    cp 255
 12920	83E5	C8				    ret z
 12921	83E6					
 12922	83E6	4F				    ld c, a                         ; C = first char code
 12923	83E7	23				    inc hl
 12924	83E8	46				    ld b, (hl)                      ; B = chars per tile
 12925	83E9	23				    inc hl
 12926	83EA	56				    ld d, (hl)                      ; D = operation code
 12927	83EB	23				    inc hl
 12928	83EC	7E				    ld a, (hl)                      ; A = flags
 12929	83ED	32	36	C6		    ld (anim_tile_transform_flags), a
 12930	83F0	23				    inc hl                          ; HL = next table entry
 12931	83F1	E5				    push hl
 12932	83F2					
 12933	83F2					.anim_transform_char_loop:
 12934	83F2	78				    ld a, b
 12935	83F3	B7				    or a
 12936	83F4	28	0C			    jr z, .anim_transform_next
 12937	83F6					
 12938	83F6	C5				    push bc
 12939	83F7	D5				    push de
 12940	83F8	79				    ld a, c
 12941	83F9	CD	05	84		    call anim_transform_char_frame
 12942	83FC	D1				    pop de
 12943	83FD	C1				    pop bc
 12944	83FE					
 12945	83FE	0C				    inc c
 12946	83FF	05				    dec b
 12947	8400	18	F0			    jr .anim_transform_char_loop
 12948	8402					
 12949	8402					.anim_transform_next:
 12950	8402	E1				    pop hl
 12951	8403	18	DD			    jr .anim_transform_loop
 12952	8405					
 12953	8405					; ------------------------------------------------------------------
 12954	8405					; Routine: anim_transform_char_frame
 12955	8405					; Purpose:
 12956	8405					;   Transform one character pattern in all SCREEN 2 banks.
 12957	8405					; Input:
 12958	8405					;   A = character code
 12959	8405					;   D = transform operation code
 12960	8405					;   (anim_tile_transform_flags).bit0 = transform color rows too
 12961	8405					; Output:
 12962	8405					;   None
 12963	8405					; Modifies:
 12964	8405					;   AF, BC, DE, HL
 12965	8405					; Preserves:
 12966	8405					;   IX, IY, SP
 12967	8405					; Flags:
 12968	8405					;   Not preserved
 12969	8405					; Stack:
 12970	8405					;   Pushes/pops BC, DE and HL
 12971	8405					; ------------------------------------------------------------------
 12972	8405					anim_transform_char_frame:
 12973	8405	C5				    push bc
 12974	8406	D5				    push de
 12975	8407	E5				    push hl
 12976	8408					
 12977	8408					    ; BC = charCode * 8 (row offset in pattern/color tables)
 12978	8408	6F				    ld l, a
 12979	8409	26	00			    ld h, 0
 12980	840B	29				    add hl, hl
 12981	840C	29				    add hl, hl
 12982	840D	29				    add hl, hl
 12983	840E	44				    ld b, h
 12984	840F	4D				    ld c, l
 12985	8410					
 12986	8410					    ; Pattern bank 0
 12987	8410	C5				    push bc
 12988	8411	D5				    push de
 12989	8412	21	00	00		    ld hl, CHRTBL2
 12990	8415	09				    add hl, bc
 12991	8416	CD	62	84		    call anim_transform_vram_block
 12992	8419	D1				    pop de
 12993	841A	C1				    pop bc
 12994	841B					
 12995	841B					    ; Pattern bank 1
 12996	841B	C5				    push bc
 12997	841C	D5				    push de
 12998	841D	21	00	08		    ld hl, CHRTBL2 + #800
 12999	8420	09				    add hl, bc
 13000	8421	CD	62	84		    call anim_transform_vram_block
 13001	8424	D1				    pop de
 13002	8425	C1				    pop bc
 13003	8426					
 13004	8426					    ; Pattern bank 2
 13005	8426	C5				    push bc
 13006	8427	D5				    push de
 13007	8428	21	00	10		    ld hl, CHRTBL2 + #1000
 13008	842B	09				    add hl, bc
 13009	842C	CD	62	84		    call anim_transform_vram_block
 13010	842F	D1				    pop de
 13011	8430	C1				    pop bc
 13012	8431					
 13013	8431					    ; Color transforms only for vertical row operations (5..7) and if enabled
 13014	8431	7A				    ld a, d
 13015	8432	FE	05			    cp 5
 13016	8434	38	28			    jr c, .anim_transform_char_done
 13017	8436					
 13018	8436	3A	36	C6		    ld a, (anim_tile_transform_flags)
 13019	8439	E6	01			    and 1
 13020	843B	28	21			    jr z, .anim_transform_char_done
 13021	843D					
 13022	843D					    ; Color bank 0
 13023	843D	C5				    push bc
 13024	843E	D5				    push de
 13025	843F	21	00	20		    ld hl, CLRTBL2
 13026	8442	09				    add hl, bc
 13027	8443	CD	62	84		    call anim_transform_vram_block
 13028	8446	D1				    pop de
 13029	8447	C1				    pop bc
 13030	8448					
 13031	8448					    ; Color bank 1
 13032	8448	C5				    push bc
 13033	8449	D5				    push de
 13034	844A	21	00	28		    ld hl, CLRTBL2 + #800
 13035	844D	09				    add hl, bc
 13036	844E	CD	62	84		    call anim_transform_vram_block
 13037	8451	D1				    pop de
 13038	8452	C1				    pop bc
 13039	8453					
 13040	8453					    ; Color bank 2
 13041	8453	C5				    push bc
 13042	8454	D5				    push de
 13043	8455	21	00	30		    ld hl, CLRTBL2 + #1000
 13044	8458	09				    add hl, bc
 13045	8459	CD	62	84		    call anim_transform_vram_block
 13046	845C	D1				    pop de
