 5045	4ED9					    ; ==================================================================
 5046	4ED9					    ; WALL COLLISION COMPONENT SYSTEM
 5047	4ED9					    ; ==================================================================
 5048	4ED9					    ; Prevents entities from moving through walls
 5049	4ED9					    ; Uses per-entity hitbox (offset + width/height)
 5050	4ED9					    ; Snaps entity position to wall edge AND zeros velocity
 5051	4ED9					
 5052	4ED9					init_wallcollision_system:
 5053	4ED9	C9				    ret
 5054	4EDA					
 5055	4EDA					; ------------------------------------------------------------------
 5056	4EDA					; update_wallcollision_component
 5057	4EDA					; ------------------------------------------------------------------
 5058	4EDA					; Check wall collisions and prevent movement through solid tiles.
 5059	4EDA					; Uses behavior map (current_behavior_map) for collision detection.
 5060	4EDA					; Entity position is cached in wall_temp_x/y and converted to hitbox bounds.
 5061	4EDA					; ------------------------------------------------------------------
 5062	4EDA					; Register Contract:
 5063	4EDA					;   Purpose: Iterate all entity slots; for each active entity with
 5064	4EDA					;            WallCollision eligibility, probe solid tiles in movement
 5065	4EDA					;            direction(s) and snap position + zero velocity on hit.
 5066	4EDA					;   Inputs:
 5067	4EDA					;     - entity_active[]         : 1 = entity exists
 5068	4EDA					;     - entity_comp_masks[]     : low byte component bitmask
 5069	4EDA					;     - entity_comp_masks_hi[]  : high byte (COMP_MASK_GRAVITY at bit 1)
 5070	4EDA					;     - entity_collides_with[]  : must include COLLISION_LAYER_PLATFORM (#08)
 5071	4EDA					;     - entity_screen_id[]      : entity must be on current_screen_id
 5072	4EDA					;     - entity_x_pos/y_pos[]    : world position
 5073	4EDA					;     - entity_vel_x/vel_y[]    : signed 8-bit velocity (negative = left/up)
 5074	4EDA					;     - entity_gravity_vel[]    : 16-bit signed gravity accumulator (word)
 5075	4EDA					;     - entity_collision_offset_x/y[]: signed offset from origin to hitbox corner
 5076	4EDA					;     - entity_collision_hitbox_w/h[]: hitbox size (minimum 1 if zero)
 5077	4EDA					;     - current_behavior_map    : pointer to active screen behavior map
 5078	4EDA					;     - current_screen_id       : ID of the visible screen
 5079	4EDA					;   Outputs:
 5080	4EDA					;     - entity_x_pos/y_pos[]    : snapped on collision
 5081	4EDA					;     - entity_vel_x/vel_y[]    : zeroed on collision axis
 5082	4EDA					;     - entity_gravity_vel[]    : zeroed on vertical collision
 5083	4EDA					;     - entity_on_ground[]      : bit 0 set=floor, cleared at loop start
 5084	4EDA					;     - entity_wall_collision_flags[]: bits 0=UP,1=DOWN,2=LEFT,3=RIGHT
 5085	4EDA					;   Clobbers: AF, BC, DE, HL
 5086	4EDA					;   Preserved: (none ??? uses scratch RAM wall_temp_x/y, wall_hit_*, wall_probe_*)
 5087	4EDA					;   Notes:
 5088	4EDA					;     - Opt-B: loop uses active_entity_list (entities guaranteed active + on screen).
 5089	4EDA					;       Eliminates ~29 wasted iterations vs 0..MAX_ENTITIES scan (3 entities active).
 5090	4EDA					;     - Opt-C: wall_build_hitbox_cache is skipped on DOWN snap when new Y == current Y
 5091	4EDA					;       (entity already on floor). Saves ~200 cycles/entity/frame when standing still.
 5092	4EDA					;     - wall_build_hitbox_cache is called once at entity entry, and after each snap
 5093	4EDA					;       where the position actually changes.
 5094	4EDA					;     - Gravity floor check (.check_wall_y_gravity) runs even when vel_y=0
 5095	4EDA					;       so entity_on_ground stays accurate when entity is standing still.
 5096	4EDA					; ------------------------------------------------------------------
 5097	4EDA					update_wallcollision_component:
