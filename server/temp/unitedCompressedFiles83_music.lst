 2515	4417					
 2516	4417					position_update_loop:
 2517	4417	4E				    ld c, (hl)                 ; C = entity index
 2518	4418	23				    inc hl                     ; Advance list pointer
 2519	4419	E5				    push hl                    ; Save list pointer
 2520	441A	59				    ld e, c
 2521	441B	16	00			    ld d, 0
 2522	441D	21	20	C7		    ld hl, entity_comp_masks
 2523	4420	19				    add hl, de
