 1003	4145					NODE_TYPE_RESTART       EQU 6    ; Restart node (restart game/level)
 1004	4145					NODE_TYPE_END           EQU 7    ; End node (game over, victory, credits)
 1005	4145					NODE_TYPE_IF_THEN_ELSE  EQU 8    ; IfThenElse node (conditional branch)
 1006	4145					NODE_TYPE_GLOBALS       EQU 9    ; Globals node (global variable ops)
 1007	4145					NODE_TYPE_WAYPOINT      EQU 10   ; Waypoint node (routing marker)
 1008	4145					NODE_TYPE_GROUP         EQU 11   ; Group node (nested flow)
 1009	4145					NODE_TYPE_MUSIC         EQU 12   ; Music node (audio command)
 1010	4145					NODE_TYPE_UNKNOWN       EQU 255  ; Unknown/unsupported node type
