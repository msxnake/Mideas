 13295	8574					
 13296	8574					
 13297	8574					; ==================================================================
 13298	8574					; PARTICLE SYSTEM (VRAM Pattern Redefinition)
 13299	8574					; File: particles.asm
 13300	8574					; Description: Visual effects using dynamic tile pattern updates
 13301	8574					; ==================================================================
 13302	8574					
 13303	8574					; ==================================================================
 13304	8574					; PARTICLE SYSTEM CONSTANTS
 13305	8574					; ==================================================================
 13306	8574					
 13307	8574					; Maximum active particles
 13308	8574					MAX_PARTICLES           EQU 8       ; Support up to 8 simultaneous particles
 13309	8574					
 13310	8574					; Reserved tile IDs for particles (248-255)
 13311	8574					PARTICLE_TILE_BASE      EQU 248     ; First tile ID for particles
 13312	8574					
 13313	8574					; Particle types
 13314	8574					PARTICLE_NONE           EQU 0       ; Inactive particle slot
 13315	8574					PARTICLE_EXPLOSION      EQU 1       ; Explosion (4 frames, expands outward)
 13316	8574					PARTICLE_SMOKE          EQU 2       ; Smoke puff (4 frames, rises up)
 13317	8574					PARTICLE_SPARK          EQU 3       ; Spark/flash (2 frames, quick)
 13318	8574					PARTICLE_DUST           EQU 4       ; Dust cloud (3 frames, fades)
 13319	8574					PARTICLE_IMPACT         EQU 5       ; Impact star (3 frames, shrinks)
 13320	8574					PARTICLE_DEBRIS         EQU 6       ; Debris chunk (2 frames, falls)
 13321	8574					PARTICLE_MUZZLE_FLASH   EQU 7       ; Muzzle flash (2 frames, instant)
 13322	8574					PARTICLE_WATER_SPLASH   EQU 8       ; Water splash (4 frames, arcs)
 13323	8574					
 13324	8574					; Particle lifetimes (in frames)
 13325	8574					LIFE_EXPLOSION          EQU 16      ; ~267ms
 13326	8574					LIFE_SMOKE              EQU 24      ; ~400ms
 13327	8574					LIFE_SPARK              EQU 8       ; ~133ms
 13328	8574					LIFE_DUST               EQU 12      ; ~200ms
 13329	8574					LIFE_IMPACT             EQU 10      ; ~167ms
 13330	8574					LIFE_DEBRIS             EQU 20      ; ~333ms
 13331	8574					LIFE_MUZZLE_FLASH       EQU 4       ; ~67ms (very quick)
 13332	8574					LIFE_WATER_SPLASH       EQU 18      ; ~300ms
 13333	8574					
 13334	8574					; Particle pool structure (8 bytes per particle)
 13335	8574					; Offset 0: Type (PARTICLE_*)
 13336	8574					; Offset 1: Lifetime remaining (frames)
 13337	8574					; Offset 2: X position (screen coords, 0-31 tiles)
