 21390	ABE8					; ==================================================================
 21391	ABE8					; ZX0 DECOMPRESSOR (AUTO-INJECTED)
 21392	ABE8					; ==================================================================
 21393	ABE8					; -----------------------------------------------------------------------------
 21394	ABE8					; ZX0 decoder by Einar Saukas & Urusergi
 21395	ABE8					; "Standard" version (68 bytes only)
 21396	ABE8					; -----------------------------------------------------------------------------
 21397	ABE8					; Parameters:
 21398	ABE8					;   HL: source address (compressed data)
 21399	ABE8					;   DE: destination address (decompressing)
 21400	ABE8					; -----------------------------------------------------------------------------
 21401	ABE8					
 21402	ABE8					dzx0_standard:
 21403	ABE8	01	FF	FF		        ld      bc, $ffff               ; preserve default offset 1
 21404	ABEB	C5				        push    bc
 21405	ABEC	03				        inc     bc
 21406	ABED	3E	80			        ld      a, $80
 21407	ABEF					dzx0s_literals:
 21408	ABEF	CD	1D	AC		        call    dzx0s_elias             ; obtain length
 21409	ABF2	ED	B0			        ldir                            ; copy literals
 21410	ABF4	87				        add     a, a                    ; copy from last offset or new offset?
 21411	ABF5	38	0D			        jr      c, dzx0s_new_offset
 21412	ABF7	CD	1D	AC		        call    dzx0s_elias             ; obtain length
 21413	ABFA					dzx0s_copy:
 21414	ABFA	E3				        ex      (sp), hl                ; preserve source, restore offset
 21415	ABFB	E5				        push    hl                      ; preserve offset
 21416	ABFC	19				        add     hl, de                  ; calculate destination - offset
 21417	ABFD	ED	B0			        ldir                            ; copy from offset
 21418	ABFF	E1				        pop     hl                      ; restore offset
 21419	AC00	E3				        ex      (sp), hl                ; preserve offset, restore source
 21420	AC01	87				        add     a, a                    ; copy from literals or new offset?
 21421	AC02	30	EB			        jr      nc, dzx0s_literals
 21422	AC04					dzx0s_new_offset:
 21423	AC04	C1				        pop     bc                      ; discard last offset
 21424	AC05	0E	FE			        ld      c, $fe                  ; prepare negative offset
 21425	AC07	CD	1E	AC		        call    dzx0s_elias_loop        ; obtain offset MSB
 21426	AC0A	0C				        inc     c
 21427	AC0B	C8				        ret     z                       ; check end marker
 21428	AC0C	41				        ld      b, c
 21429	AC0D	4E				        ld      c, (hl)                 ; obtain offset LSB
 21430	AC0E	23				        inc     hl
 21431	AC0F	CB	18			        rr      b                       ; last offset bit becomes first length bit
 21432	AC11	CB	19			        rr      c
 21433	AC13	C5				        push    bc                      ; preserve new offset
 21434	AC14	01	01	00		        ld      bc, 1                   ; obtain length
 21435	AC17	D4	25	AC		        call    nc, dzx0s_elias_backtrack
 21436	AC1A	03				        inc     bc
 21437	AC1B	18	DD			        jr      dzx0s_copy
 21438	AC1D					dzx0s_elias:
 21439	AC1D	0C				        inc     c                       ; interlaced Elias gamma coding
 21440	AC1E					dzx0s_elias_loop:
 21441	AC1E	87				        add     a, a
 21442	AC1F	20	03			        jr      nz, dzx0s_elias_skip
 21443	AC21	7E				        ld      a, (hl)                 ; load another group of 8 bits
 21444	AC22	23				        inc     hl
 21445	AC23	17				        rla
 21446	AC24					dzx0s_elias_skip:
 21447	AC24	D8				        ret     c
 21448	AC25					dzx0s_elias_backtrack:
 21449	AC25	87				        add     a, a
 21450	AC26	CB	11			        rl      c
 21451	AC28	CB	10			        rl      b
 21452	AC2A	18	F2			        jr      dzx0s_elias_loop
