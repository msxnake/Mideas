 13054	8462					
 13055	8462					; ------------------------------------------------------------------
 13056	8462					; Routine: anim_transform_vram_block
 13057	8462					; Purpose:
 13058	8462					;   Apply transform to one 8-byte VRAM block (one char rows table).
 13059	8462					; Input:
 13060	8462					;   HL = VRAM base address for row 0 (8 consecutive bytes)
 13061	8462					;   D  = operation code:
 13062	8462					;        1 rotate_left  (RLCA)
 13063	8462					;        2 rotate_right (RRCA)
 13064	8462					;        3 shift_left   (SLA)
 13065	8462					;        4 shift_right  (SRL)
 13066	8462					;        5 shift_up rows
 13067	8462					;        6 shift_down rows
 13068	8462					;        7 swap top/bottom row
 13069	8462					; Output:
 13070	8462					;   None
 13071	8462					; Modifies:
 13072	8462					;   AF, BC, DE, HL
 13073	8462					; Preserves:
 13074	8462					;   IX, IY, SP
 13075	8462					; Flags:
 13076	8462					;   Not preserved
 13077	8462					; Stack:
 13078	8462					;   Uses stack while reading row bytes
 13079	8462					; ------------------------------------------------------------------
 13080	8462					anim_transform_vram_block:
 13081	8462	7A				    ld a, d
 13082	8463	FE	05			    cp 5
 13083	8465	30	2C			    jr nc, .anim_transform_vertical
 13084	8467					
 13085	8467					    ; Horizontal bit transforms (operate row by row)
 13086	8467	06	08			    ld b, 8
 13087	8469					.anim_transform_horizontal_loop:
 13088	8469	E5				    push hl
 13089	846A	CD	E8	40		    call FAST_RDVRM                 ; A = row byte from VRAM[HL]
 13090	846D	E1				    pop hl
 13091	846E					
 13092	846E	5F				    ld e, a
 13093	846F	7A				    ld a, d
 13094	8470	FE	01			    cp 1
 13095	8472	20	04			    jr nz, .anim_not_rl
 13096	8474	7B				    ld a, e
 13097	8475	07				    rlca
 13098	8476	18	14			    jr .anim_write_row
 13099	8478					.anim_not_rl:
 13100	8478	FE	02			    cp 2
 13101	847A	20	04			    jr nz, .anim_not_rr
 13102	847C	7B				    ld a, e
 13103	847D	0F				    rrca
 13104	847E	18	0C			    jr .anim_write_row
 13105	8480					.anim_not_rr:
 13106	8480	FE	03			    cp 3
 13107	8482	20	05			    jr nz, .anim_not_sla
 13108	8484	7B				    ld a, e
 13109	8485	CB	27			    sla a
 13110	8487	18	03			    jr .anim_write_row
 13111	8489					.anim_not_sla:
 13112	8489	7B				    ld a, e
 13113	848A	CB	3F			    srl a
 13114	848C					
 13115	848C					.anim_write_row:
 13116	848C	CD	CE	40		    call FAST_WRTVRM
 13117	848F	23				    inc hl
 13118	8490	10	D7			    djnz .anim_transform_horizontal_loop
 13119	8492	C9				    ret
 13120	8493					
 13121	8493					.anim_transform_vertical:
 13122	8493	D5				    push de                        ; Preserve D=operation code (DE reused as pointers)
 13123	8494					    ; Read current 8 row bytes into temporary RAM buffer
 13124	8494	11	38	C6		    ld de, anim_tile_row_buffer
 13125	8497	06	08			    ld b, 8
 13126	8499					.anim_read_rows_loop:
 13127	8499	E5				    push hl
 13128	849A	CD	E8	40		    call FAST_RDVRM                 ; A = row byte
 13129	849D	E1				    pop hl
 13130	849E	12				    ld (de), a
 13131	849F	13				    inc de
 13132	84A0	23				    inc hl
 13133	84A1	10	F6			    djnz .anim_read_rows_loop
 13134	84A3					
 13135	84A3					    ; Restore HL to start of block (HL -= 8)
 13136	84A3	11	F8	FF		    ld de, #FFF8
 13137	84A6	19				    add hl, de
 13138	84A7	D1				    pop de                         ; Restore original operation code in D
 13139	84A8					
 13140	84A8	7A				    ld a, d
 13141	84A9	FE	05			    cp 5
 13142	84AB	20	14			    jr nz, .anim_not_shift_up
 13143	84AD					
 13144	84AD					    ; shift_up: row0<-row1 ... row6<-row7 row7<-row0
 13145	84AD	11	39	C6		    ld de, anim_tile_row_buffer + 1
 13146	84B0	06	07			    ld b, 7
 13147	84B2					.anim_write_up_loop:
 13148	84B2	1A				    ld a, (de)
 13149	84B3	CD	CE	40		    call FAST_WRTVRM
 13150	84B6	13				    inc de
 13151	84B7	23				    inc hl
 13152	84B8	10	F8			    djnz .anim_write_up_loop
 13153	84BA	3A	38	C6		    ld a, (anim_tile_row_buffer)
 13154	84BD	CD	CE	40		    call FAST_WRTVRM
 13155	84C0	C9				    ret
 13156	84C1					
 13157	84C1					.anim_not_shift_up:
 13158	84C1	FE	06			    cp 6
 13159	84C3	20	15			    jr nz, .anim_not_shift_down
 13160	84C5					
 13161	84C5					    ; shift_down: row0<-row7 row1<-row0 ... row7<-row6
 13162	84C5	3A	3F	C6		    ld a, (anim_tile_row_buffer + 7)
 13163	84C8	CD	CE	40		    call FAST_WRTVRM
 13164	84CB	23				    inc hl
 13165	84CC	11	38	C6		    ld de, anim_tile_row_buffer
 13166	84CF	06	07			    ld b, 7
 13167	84D1					.anim_write_down_loop:
 13168	84D1	1A				    ld a, (de)
 13169	84D2	CD	CE	40		    call FAST_WRTVRM
 13170	84D5	13				    inc de
 13171	84D6	23				    inc hl
 13172	84D7	10	F8			    djnz .anim_write_down_loop
 13173	84D9	C9				    ret
 13174	84DA					
 13175	84DA					.anim_not_shift_down:
 13176	84DA					    ; swap_top_bottom: row0<->row7, middle rows unchanged
 13177	84DA	3A	3F	C6		    ld a, (anim_tile_row_buffer + 7)
 13178	84DD	CD	CE	40		    call FAST_WRTVRM
 13179	84E0	23				    inc hl
 13180	84E1	11	39	C6		    ld de, anim_tile_row_buffer + 1
 13181	84E4	06	06			    ld b, 6
 13182	84E6					.anim_write_middle_loop:
 13183	84E6	1A				    ld a, (de)
 13184	84E7	CD	CE	40		    call FAST_WRTVRM
 13185	84EA	13				    inc de
 13186	84EB	23				    inc hl
 13187	84EC	10	F8			    djnz .anim_write_middle_loop
 13188	84EE	3A	38	C6		    ld a, (anim_tile_row_buffer)
 13189	84F1	CD	CE	40		    call FAST_WRTVRM
 13190	84F4	C9				    ret
