 13374	8591					
 13375	8591					; ------------------------------------------------------------------
 13376	8591					; spawn_particle
 13377	8591					; Create a new particle at given position
 13378	8591					; Input:  A = Particle type (PARTICLE_*)
 13379	8591					;         B = X position (tile coords, 0-31)
 13380	8591					;         C = Y position (tile coords, 0-23)
 13381	8591					;         D = Velocity X (optional, signed)
 13382	8591					;         E = Velocity Y (optional, signed)
 13383	8591					; Output: A = 1 if spawned successfully, 0 if pool full
 13384	8591					; Destroys: AF, BC, DE, HL
 13385	8591					; ------------------------------------------------------------------
 13386	8591					spawn_particle:
 13387	8591	F5				    push af                     ; Save particle type
 13388	8592	C5				    push bc                     ; Save position
 13389	8593	D5				    push de                     ; Save velocity
 13390	8594					
 13391	8594					    ; Find free particle slot
 13392	8594	CD	C1	85		    call find_free_particle
 13393	8597	28	23			    jr z, .part_spawn_failed    ; Z flag set = no free slots
 13394	8599					
 13395	8599					    ; HL points to free particle structure
 13396	8599	D1				    pop de                      ; Restore velocity
 13397	859A	C1				    pop bc                      ; Restore position
 13398	859B	F1				    pop af                      ; Restore type
 13399	859C					
 13400	859C					    ; Fill particle structure
 13401	859C	77				    ld (hl), a                  ; Offset 0: type
 13402	859D	23				    inc hl
 13403	859E					
 13404	859E					    ; Set lifetime based on type
 13405	859E	E5				    push hl
 13406	859F	CD	D4	85		    call get_particle_lifetime  ; A = type -> A = lifetime
 13407	85A2	E1				    pop hl
 13408	85A3	77				    ld (hl), a                  ; Offset 1: lifetime
 13409	85A4	23				    inc hl
 13410	85A5					
 13411	85A5	70				    ld (hl), b                  ; Offset 2: X position
 13412	85A6	23				    inc hl
 13413	85A7	71				    ld (hl), c                  ; Offset 3: Y position
 13414	85A8	23				    inc hl
 13415	85A9					
 13416	85A9	AF				    xor a
 13417	85AA	77				    ld (hl), a                  ; Offset 4: frame = 0
 13418	85AB	23				    inc hl
 13419	85AC	23				    inc hl                      ; Skip tile_id (already assigned)
 13420	85AD					
 13421	85AD	72				    ld (hl), d                  ; Offset 6: velocity X
 13422	85AE	23				    inc hl
 13423	85AF	73				    ld (hl), e                  ; Offset 7: velocity Y
 13424	85B0					
 13425	85B0					    ; Place particle tile on screen immediately
 13426	85B0	2B				    dec hl
