 13688	867A	87				    add a, a
 13689	867B	87				    add a, a
 13690	867C	87				    add a, a
 13691	867D	87				    add a, a
 13692	867E	87				    add a, a                    ; Y * 32
 13693	867F	80				    add a, b
 13694	8680	5F				    ld e, a
 13695	8681	16	00			    ld d, 0
 13696	8683	21	00	18		    ld hl, NAMETBL
 13697	8686	19				    add hl, de
 13698	8687					
 13699	8687					    ; Write 0 (blank tile)
 13700	8687	AF				    xor a
 13701	8688	CD	4D	00		    call WRTVRM
 13702	868B					
 13703	868B	E1				    pop hl
