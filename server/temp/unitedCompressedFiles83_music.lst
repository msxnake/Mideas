 8298	5C6D	11	40	38		    ld de, SPRPAT + (2 * 32)
 8299	5C70	01	40	00		    ld bc, 64 ; Load 2 layers (32 bytes each)
 8300	5C73	CD	BC	AB		    call COPY_SPRITE_SRC_TO_VRAM
