 3409	47FE					; ------------------------------------------------------------------
 3410	47FE					; coll_add_signed_offset_clamped
 3411	47FE					; Input:  A = base coordinate (0..255)
 3412	47FE					;         HL = pointer to signed offset byte (-128..127, two's complement)
 3413	47FE					; Output: A = clamped (base + offset), saturated to 0..255
 3414	47FE					; Clobbers: B
