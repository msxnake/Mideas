  60	0000					; MSX CARTRIDGE ROM HEADER
  61	0000					; File: header.asm
  62	0000					; Description: Standard MSX cartridge initialization
  63	0000					; GameFlow Integration: Using "Main" as execution orchestrator
  64	0000					; Flow: Start ? Music (gfn_1772744358305)
  65	0000					; ==================================================================
  66	0000					
  67	0000					    org #4000           ; MSX cartridge start address
  68	4000					
  69	4000					; ==================================================================
  70	4000					; CARTRIDGE HEADER
  71	4000					; ==================================================================
  72	4000	41	42			    db "AB"             ; MSX cartridge signature
  73	4002	10	40			    dw init_rom         ; Initialization address
  74	4004	00	00			    dw 0                ; Statement handler (not used)
  75	4006	00	00			    dw 0                ; Device handler (not used)
  76	4008	00	00			    dw 0                ; Text handler (not used)
  77	400A	00	00			    dw 0                ; Reserved
  78	400C	00	00			    dw 0                ; Reserved
  79	400E	00	00			    dw 0                ; Reserved
