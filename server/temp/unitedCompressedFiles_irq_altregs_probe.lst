 13059	9A2C					; ------------------------------------------------------------------
 13060	9A2C					; multiply_a_by_b
 13061	9A2C					; Multiply A by B (unsigned 8-bit)
 13062	9A2C					; Input:  A = multiplicand, B = multiplier
 13063	9A2C					; Output: HL = result (16-bit)
 13064	9A2C					; Destroys: AF, BC
 13065	9A2C					; ------------------------------------------------------------------
 13066	9A2C					multiply_a_by_b:
 13067	9A2C	21	00	00		    ld hl, 0
 13068	9A2F	4F				    ld c, a
 13069	9A30					.scroll_mul_loop:
 13070	9A30	78				    ld a, b
 13071	9A31	B7				    or a
 13072	9A32	C8				    ret z
 13073	9A33	09				    add hl, bc
 13074	9A34	05				    dec b
 13075	9A35	18	F9			    jr .scroll_mul_loop
