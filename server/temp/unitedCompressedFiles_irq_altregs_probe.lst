 1958	4285					; This task guarantees responsive input (no missed button presses)
 1959	4285					; Compatible with update_input_component existing function
 1960	4285					; ==================================================================
 1961	4285					; Register Contract:
 1962	4285					;   Purpose: Poll joystick + keyboard fallback and update input state buffers.
 1963	4285					;   Inputs:
 1964	4285					;     - Reads hardware via FAST_GTSTCK / FAST_GTTRIG / FAST_SNSMAT
 1965	4285					;   Outputs:
 1966	4285					;     - input_state, prev_input_state, input_btn_curr, input_btn_prev, input_fire
 1967	4285					;   Clobbers:
 1968	4285					;     - AF
 1969	4285					;     - BC
 1970	4285					;     - DE
 1971	4285					;   Preserved:
 1972	4285					;     - AF
 1973	4285					;     - BC
 1974	4285					;     - DE (by push/pop wrapper)
 1975	4285					;     - HL
