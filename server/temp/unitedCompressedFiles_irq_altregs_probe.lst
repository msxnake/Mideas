 20012	B5DC	CD	29	5A		    call load_colors_to_vram
 20013	B5DF					    ; 2. Font patterns + colors (chars 0-127) — also zeroed by color-table effects.
 20014	B5DF					    ;    init_font_system reloads both pattern bytes and color attributes for all
 20015	B5DF					    ;    font characters.  If no font is used in the project this is a no-op (ret).
 20016	B5DF	CD	D3	6E		    call init_font_system
 20017	B5E2	C1				    pop bc                        ; Restore connection table AFTER VRAM restore
 20018	B5E3	CD	8A	B7		    call gameflow_get_default_connection
 20019	B5E6	7C				    ld a, h
 20020	B5E7	B5				    or l
 20021	B5E8	C8				    ret z
 20022	B5E9	C3	86	B1		    jp gameflow_execute_node
 20023	B5EC					
 20024	B5EC					; ==================================================================
 20025	B5EC					; execute_transition_effect
 20026	B5EC					; Execute visual screen transition by clearing the Name Table
 20027	B5EC					; in different patterns. All effects write tile 0 (blank/black)
 20028	B5EC					; to Name Table (#1800-#1AFF, 768 bytes = 32x24 tiles).
 20029	B5EC					;
 20030	B5EC					; Input:  DE = Transition data pointer
 20031	B5EC					;         (DE) = effect id: 0=cls, 1=dissolve_pixels, 2=dissolve_chars,
 20032	B5EC					;                           3=vertical_lines, 4=horizontal_lines,
 20033	B5EC					;                           5=spiral, 6=fill_white_squares
 20034	B5EC					; Destroys: AF, BC, DE, HL
 20035	B5EC					; ==================================================================
 20036	B5EC					execute_transition_effect:
 20037	B5EC	1A				    ld a, (de)                    ; A = effect id (0-6)
 20038	B5ED	13				    inc de
 20039	B5EE	F5				    push af                       ; Save effect id
 20040	B5EF	1A				    ld a, (de)                    ; A = frames per step (from node data)
 20041	B5F0	32	0F	C0		    ld (transition_delay_var), a  ; Store for trans_wait_frames
 20042	B5F3	F1				    pop af                        ; Restore effect id
 20043	B5F4	B7				    or a
 20044	B5F5	CA	11	B6		    jp z, .trans_cls
 20045	B5F8	3D				    dec a
 20046	B5F9	CA	1F	B6		    jp z, .trans_dissolve_pixels
 20047	B5FC	3D				    dec a
 20048	B5FD	CA	41	B6		    jp z, .trans_dissolve_chars
 20049	B600	3D				    dec a
 20050	B601	CA	5B	B6		    jp z, .trans_vertical_lines
 20051	B604	3D				    dec a
 20052	B605	CA	70	B6		    jp z, .trans_horizontal_lines
 20053	B608	3D				    dec a
 20054	B609	CA	8B	B6		    jp z, .trans_spiral
 20055	B60C	3D				    dec a
 20056	B60D	CA	A1	B6		    jp z, .trans_fill_white_squares
 20057	B610	C9				    ret                           ; Unknown id - do nothing
