 17686	AC17					    ; ------------------------------------------------------------------
 17687	AC17					    ; CONDITION HANDLERS IMPLEMENTATION
 17688	AC17					    ; ------------------------------------------------------------------
 17689	AC17					
 17690	AC17					Condition_Nop:
 17691	AC17	3E	01			    ld a, 1                 ; Always true
 17692	AC19	C9				    ret
 17693	AC1A					
 17694	AC1A					Condition_And:
 17695	AC1A					    ; AND compound condition
 17696	AC1A					    ; Data format: DB subcondition_count, then N subconditions inline
 17697	AC1A					    ; Evaluates all subconditions; returns true only if ALL are true
 17698	AC1A					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17699	AC1A					    ; Output: A = 1 (all true) or 0 (any false), HL = past all subcondition data
 17700	AC1A	4E				    ld c, (hl)              ; C = subcondition count
 17701	AC1B	23				    inc hl
 17702	AC1C	16	01			    ld d, 1                 ; D = result accumulator (1 = all true so far)
 17703	AC1E					
 17704	AC1E					.and_loop:
 17705	AC1E	79				    ld a, c
 17706	AC1F	B7				    or a
 17707	AC20	28	0D			    jr z, .and_done         ; No more subconditions
 17708	AC22					
 17709	AC22	C5				    push bc                 ; Save count (C) and entity index (implicitly)
 17710	AC23	D5				    push de                 ; Save result accumulator (D)
 17711	AC24					
 17712	AC24	78				    ld a, b                 ; A = Entity Index
 17713	AC25	CD	6C	A0		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17714	AC28					
 17715	AC28	D1				    pop de                  ; Restore result accumulator
 17716	AC29	A2				    and d                   ; Combine: D = D AND result
 17717	AC2A	57				    ld d, a
 17718	AC2B					
 17719	AC2B	C1				    pop bc                  ; Restore count and entity index
 17720	AC2C	0D				    dec c
 17721	AC2D	18	EF			    jr .and_loop
 17722	AC2F					
 17723	AC2F					.and_done:
 17724	AC2F	7A				    ld a, d                 ; A = AND result
 17725	AC30	C9				    ret
 17726	AC31					
 17727	AC31					Condition_Or:
 17728	AC31					    ; OR compound condition
 17729	AC31					    ; Data format: DB subcondition_count, then N subconditions inline
 17730	AC31					    ; Evaluates all subconditions; returns true if ANY is true
 17731	AC31					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17732	AC31					    ; Output: A = 1 (any true) or 0 (all false), HL = past all subcondition data
 17733	AC31	4E				    ld c, (hl)              ; C = subcondition count
 17734	AC32	23				    inc hl
 17735	AC33	16	00			    ld d, 0                 ; D = result accumulator (0 = all false so far)
 17736	AC35					
 17737	AC35					.or_loop:
 17738	AC35	79				    ld a, c
 17739	AC36	B7				    or a
 17740	AC37	28	0D			    jr z, .or_done          ; No more subconditions
 17741	AC39					
 17742	AC39	C5				    push bc                 ; Save count (C) and entity index
 17743	AC3A	D5				    push de                 ; Save result accumulator (D)
 17744	AC3B					
 17745	AC3B	78				    ld a, b                 ; A = Entity Index
 17746	AC3C	CD	6C	A0		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17747	AC3F					
 17748	AC3F	D1				    pop de                  ; Restore result accumulator
 17749	AC40	B2				    or d                    ; Combine: D = D OR result
 17750	AC41	57				    ld d, a
 17751	AC42					
 17752	AC42	C1				    pop bc                  ; Restore count and entity index
 17753	AC43	0D				    dec c
 17754	AC44	18	EF			    jr .or_loop
 17755	AC46					
 17756	AC46					.or_done:
 17757	AC46	7A				    ld a, d                 ; A = OR result
 17758	AC47	C9				    ret
 17759	AC48					
 17760	AC48					Condition_Xor:
 17761	AC48					    ; XOR compound condition
 17762	AC48					    ; Data format: DB subcondition_count, then N subconditions inline
 17763	AC48					    ; Returns true if an odd number of subconditions are true.
 17764	AC48					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17765	AC48					    ; Output: A = 1 (odd true count) or 0 (even true count), HL advanced
 17766	AC48	4E				    ld c, (hl)              ; C = subcondition count
 17767	AC49	23				    inc hl
 17768	AC4A	AF				    xor a
 17769	AC4B	57				    ld d, a                 ; D = XOR accumulator (0 = even)
 17770	AC4C					
 17771	AC4C					.xor_loop:
 17772	AC4C	79				    ld a, c
 17773	AC4D	B7				    or a
 17774	AC4E	28	11			    jr z, .xor_done
 17775	AC50					
 17776	AC50	C5				    push bc                 ; Save count/entity index
 17777	AC51	D5				    push de                 ; Save accumulator
 17778	AC52					
 17779	AC52	78				    ld a, b                 ; A = Entity Index
 17780	AC53	CD	6C	A0		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
