 10960	6F36					.marco_loop:
 10961	6F36	C5				    push bc                     ; Save counter
 10962	6F37					
 10963	6F37					    ; Check visible flag first (offset 8)
 10964	6F37	DD	7E	08		    ld a, (ix+8)                ; A = Visible
 10965	6F3A	B7				    or a
