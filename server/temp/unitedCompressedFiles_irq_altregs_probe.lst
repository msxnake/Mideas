 7465	5897					tile_pattern_bank0:
 7466	5897					    ; ZX0 compressed tile_pattern (144 -> 125 bytes)
 7467	5897	29	00	7F	68	00	E0	EC	00	74	00	EF	A0	00	11	22	00	    DB #29,#00,#7F,#68,#00,#E0,#EC,#00,#74,#00,#EF,#A0,#00,#11,#22,#00
 7468	58A7	22	71	00	F0	F1	00	70	04	A6	41	00	11	02	00	05	20	    DB #22,#71,#00,#F0,#F1,#00,#70,#04,#A6,#41,#00,#11,#02,#00,#05,#20
 7469	58B7	C2	00	7E	FF	00	F7	08	FF	7E	18	30	19	18	0C	86	98	    DB #C2,#00,#7E,#FF,#00,#F7,#08,#FF,#7E,#18,#30,#19,#18,#0C,#86,#98
 7470	58C7	80	18	3C	7E	9B	34	18	01	98	F0	1F	80	FE	FF	FF	DF	    DB #80,#18,#3C,#7E,#9B,#34,#18,#01,#98,#F0,#1F,#80,#FE,#FF,#FF,#DF
 7471	58D7	AF	DF	FF	7F	70	8A	80	20	82	42	28	09	80	A2	42	08	    DB #AF,#DF,#FF,#7F,#70,#8A,#80,#20,#82,#42,#28,#09,#80,#A2,#42,#08
 7472	58E7	02	10	BA	00	F7	09	20	BA	40	00	04	01	FF	38	3E	F7	    DB #02,#10,#BA,#00,#F7,#09,#20,#BA,#40,#00,#04,#01,#FF,#38,#3E,#F7
 7473	58F7	FD	2A	FF	A9	A5	EA	E2	10	98	7C	38	10	82	D0	D0	C0	    DB #FD,#2A,#FF,#A9,#A5,#EA,#E2,#10,#98,#7C,#38,#10,#82,#D0,#D0,#C0
 7474	5907	C0	E4	FB	BD	D0	0B	0B	03	03	FF	FF	55	56	    DB #C0,#E4,#FB,#BD,#D0,#0B,#0B,#03,#03,#FF,#FF,#55,#56
 7475	5914					load_pattern_bank0:
 7476	5914					    ; Load pattern bank 0 to VRAM (base patterns)
 7477	5914					    ; Fast direct port access (no BIOS overhead)
 7478	5914	CD	76	41		    call mapper_push_p2
 7479	5917	3A	00	00		    ld a, PATTERN_DATA_BANK
 7480	591A	CD	5D	41		    call mapper_set_bank_p2
 7481	591D					    ; Decompress ZX0 tile pattern data into RAM buffer
 7482	591D	F3				    di
 7483	591E	21	97	58		    ld hl, tile_pattern_bank0
 7484	5921	11	00	DA		    ld de, ZX0_TILE_PATTERN_BUFFER
 7485	5924	CD	50	C3		    call dzx0_standard
 7486	5927	FB				    ei
 7487	5928	21	00	DA		    ld hl, ZX0_TILE_PATTERN_BUFFER
 7488	592B	11	00	04		    ld de, CHRTBL2 + (128 * 8)    ; VRAM pattern table bank 0 (start at char 128)
 7489	592E	01	90	00		    ld bc, 144    ; Total bytes for all tile characters (16x16 tiles = 4 chars each)
 7490	5931	CD	B3	40		    call FAST_LDIRVM              ; Fast VRAM write (direct port access)
 7491	5934	CD	7D	41		    call mapper_pop_p2
 7492	5937	C9				    ret
 7493	5938					
 7494	5938					load_pattern_bank1:
 7495	5938					    ; Load pattern bank 1: same patterns as bank 0 (MSX Screen 2 standard)
 7496	5938					    ; Fast direct port access (no BIOS overhead)
 7497	5938	CD	76	41		    call mapper_push_p2
 7498	593B	3A	00	00		    ld a, PATTERN_DATA_BANK
 7499	593E	CD	5D	41		    call mapper_set_bank_p2
 7500	5941					    ; Decompress ZX0 tile pattern data into RAM buffer
 7501	5941	F3				    di
 7502	5942	21	97	58		    ld hl, tile_pattern_bank0
 7503	5945	11	00	DA		    ld de, ZX0_TILE_PATTERN_BUFFER
 7504	5948	CD	50	C3		    call dzx0_standard
 7505	594B	FB				    ei
 7506	594C	21	00	DA		    ld hl, ZX0_TILE_PATTERN_BUFFER
 7507	594F	11	00	0C		    ld de, CHRTBL2 + #800 + (128 * 8) ; VRAM pattern table bank 1 (+#800 offset + char 128)
 7508	5952	01	90	00		    ld bc, 144    ; Total bytes for all tile characters
 7509	5955	CD	B3	40		    call FAST_LDIRVM              ; Fast VRAM write (direct port access)
 7510	5958	CD	7D	41		    call mapper_pop_p2
 7511	595B	C9				    ret
