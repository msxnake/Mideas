 1860	4260	D0				    ret nc                      ; Return if slot >= 8
 1861	4261					
 1862	4261					    ; Calculate offset in table: slot * 2
 1863	4261	87				    add a, a                    ; A = slot * 2
 1864	4262	5F				    ld e, a
 1865	4263	16	00			    ld d, 0
 1866	4265	01	2E	D1		    ld bc, task_table
 1867	4268	EB				    ex de, hl                   ; HL = offset, DE = task address
 1868	4269	09				    add hl, bc                  ; HL = task_table + offset
 1869	426A					
 1870	426A					    ; Write task address
 1871	426A	EB				    ex de, hl                   ; HL = task address, DE = slot location
 1872	426B	7D				    ld a, l
 1873	426C	12				    ld (de), a                  ; Write low byte
 1874	426D	13				    inc de
 1875	426E	7C				    ld a, h
 1876	426F	12				    ld (de), a                  ; Write high byte
 1877	4270					
 1878	4270	C9				    ret
 1879	4271					
