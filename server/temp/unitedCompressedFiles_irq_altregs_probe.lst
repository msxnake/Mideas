 11184	700F					; ------------------------------------------------------------------
 11185	700F					; force_render_hud
 11186	700F					; Force a HUD redraw on this frame, preserving caller-visible registers
 11187	700F					; Input:
 11188	700F					;   None
 11189	700F					; Output:
 11190	700F					;   None
 11191	700F					; Clobbers:
 11192	700F					;   None visible to caller
 11193	700F					; Preserves:
 11194	700F					;   AF, BC, DE, HL, IX
 11195	700F					; Notes:
 11196	700F					;   - Sets hud_dirty_flag = 1 and then calls render_hud
 11197	700F					; ------------------------------------------------------------------
 11198	700F					force_render_hud:
 11199	700F	F5				    push af
 11200	7010	3E	01			    ld a, 1
 11201	7012	32	32	C6		    ld (hud_dirty_flag), a
 11202	7015	CD	78	6F		    call render_hud
 11203	7018	F1				    pop af
 11204	7019	C9				    ret
