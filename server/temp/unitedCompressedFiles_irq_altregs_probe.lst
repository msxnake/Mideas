 4677	4DA0					    ; Preserve HL because it is the entity_comp_masks_hi loop pointer.
 4678	4DA0	E5				            push hl
 4679	4DA1	21	60	C7		            ld hl, entity_screen_id
 4680	4DA4	59				            ld e, c
 4681	4DA5	16	00			            ld d, 0
 4682	4DA7	19				            add hl, de
 4683	4DA8	7E				            ld a, (hl)
 4684	4DA9	21	C2	CB		            ld hl, current_screen_id
 4685	4DAC	BE				            cp (hl)
 4686	4DAD	E1				            pop hl
 4687	4DAE	C2	FD	4D		            jp nz, gravity_next_entity
 4688	4DB1					
 4689	4DB1					    ; Entity has gravity - apply acceleration
 4690	4DB1	C5				            push bc
 4691	4DB2	E5				            push hl
 4692	4DB3					
 4693	4DB3					    ; Check if entity is grounded
 4694	4DB3	21	78	CD		            ld hl, entity_on_ground
 4695	4DB6	59				            ld e, c
 4696	4DB7	16	00			            ld d, 0
 4697	4DB9	19				            add hl, de
 4698	4DBA	7E				            ld a, (hl)
 4699	4DBB	CB	47			            bit 0, a; Check ground flag
 4700	4DBD	20	2F			            jr nz, gravity_grounded; Skip gravity if on ground
 4701	4DBF					
 4702	4DBF					    ; Apply gravity acceleration
 4703	4DBF	21	5B	D0		            ld hl, entity_gravity_vel
 4704	4DC2	59				            ld e, c
 4705	4DC3	16	00			            ld d, 0
 4706	4DC5	19				            add hl, de
 4707	4DC6	19				            add hl, de; HL points to gravity velocity(word)
 4708	4DC7					
 4709	4DC7	5E				            ld e, (hl); Load current gravity velocity
 4710	4DC8	23				            inc hl
 4711	4DC9	56				            ld d, (hl)
 4712	4DCA					
 4713	4DCA					    ; Add gravity strength(64 in fixed - point = ~0.25 pixels / frame acceleration)
 4714	4DCA	7B				            ld a, e
 4715	4DCB	C6	40			            add a, #40; Add 64 to low byte
 4716	4DCD	5F				            ld e, a
 4717	4DCE	7A				            ld a, d
 4718	4DCF	CE	00			            adc a, #00; Add carry to high byte
 4719	4DD1	57				            ld d, a
 4720	4DD2					
 4721	4DD2					    ; Check terminal velocity(1024 = max fall speed)
 4722	4DD2					    ; Skip cap if velocity is negative (entity is moving UP / jumping)
 4723	4DD2	7A				            ld a, d
 4724	4DD3	CB	7F			            bit 7, a; Check sign bit - negative means going up
 4725	4DD5	20	07			            jr nz, gravity_store_vel; Skip cap for upward velocity
 4726	4DD7	FE	04			            cp #04; Check if >= 1024 (unsigned, only for positive/downward)
 4727	4DD9	38	03			            jr c, gravity_store_vel; If < 1024, continue
 4728	4DDB	11	00	04		            ld de, #0400; Cap at terminal velocity
 4729	4DDE					
 4730	4DDE					gravity_store_vel:
 4731	4DDE					; Store updated gravity velocity
 4732	4DDE	2B				            dec hl
 4733	4DDF	73				            ld (hl), e
 4734	4DE0	23				            inc hl
 4735	4DE1	72				            ld (hl), d
