 1530	41AF					
 1531	41AF					
 1532	41AF					; ==================================================================
 1533	41AF					; INTERRUPT TASK SYSTEM - File: interrupt.asm
 1534	41AF					; Konami-style technique: Hook H.TIMI for 50/60Hz task execution
 1535	41AF					; ==================================================================
 1536	41AF					
 1537	41AF					; ==================================================================
 1538	41AF					; INTERRUPT SYSTEM MEMORY LAYOUT
 1539	41AF					; Variables are defined in variables.asm (dynamically allocated)
 1540	41AF					; This avoids RAM overlap with entity system arrays
 1541	41AF					; ==================================================================
 1542	41AF					; Slots: task_table (8 slots x 2 bytes), task_0_ptr..task_7_ptr
 1543	41AF					; State: interrupt_system_enabled, old_htimi_hook, interrupt_counter,
 1544	41AF					;        task_exec_time, vblank_flag
 1545	41AF					; ==================================================================
 1546	41AF					
 1547	41AF					; ==================================================================
 1548	41AF					; INIT_INTERRUPT_SYSTEM - Install H.TIMI hook
 1549	41AF					; ==================================================================
 1550	41AF					; Register Contract:
 1551	41AF					;   Purpose: Install JP hook on H.TIMI and initialize interrupt task state.
 1552	41AF					;   Inputs:
 1553	41AF					;     - None
 1554	41AF					;   Outputs:
 1555	41AF					;     - None
 1556	41AF					;   Clobbers:
 1557	41AF					;     - AF
 1558	41AF					;     - BC
 1559	41AF					;     - DE
 1560	41AF					;     - HL
 1561	41AF					;   Preserved:
 1562	41AF					;     - None
 1563	41AF					;   Register roles:
 1564	41AF					;     - HL/DE/BC = block copy parameters for hook backup and task table clear
 1565	41AF					;     - A = enable flag and zeroing value
 1566	41AF					;   Notes:
 1567	41AF					;     - Runs with DI/EI, so caller must not assume interrupt state is unchanged.
 1568	41AF					
 1569	41AF					; Inputs: None
 1570	41AF					; Outputs: None
 1571	41AF					; Modifies: AF, BC, DE, HL
 1572	41AF					; ==================================================================
 1573	41AF					init_interrupt_system:
 1574	41AF	F3				    di                          ; Disable interrupts during hook install
 1575	41B0					
 1576	41B0					    ; --- STEP 1: Save original hook ---
 1577	41B0	21	9F	FD		    ld hl, #FD9F                ; H.TIMI address
 1578	41B3	11	3F	D1		    ld de, old_htimi_hook       ; Our backup location
 1579	41B6	01	05	00		    ld bc, 5                    ; Save 5 bytes (JP nnnn + padding)
 1580	41B9	ED	B0			    ldir                        ; Copy original hook to RAM
 1581	41BB					
 1582	41BB					    ; --- STEP 2: Install our hook ---
 1583	41BB					    ; Write "JP interrupt_dispatcher" at FD9F
 1584	41BB	3E	C3			    ld a, #C3                   ; Opcode for JP
 1585	41BD	32	9F	FD		    ld (#FD9F), a               ; Write JP opcode
 1586	41C0	21	F6	41		    ld hl, interrupt_dispatcher ; Address of our ISR
 1587	41C3	22	A0	FD		    ld (#FDA0), hl              ; Write address (little-endian)
 1588	41C6					
 1589	41C6					    ; --- STEP 3: Initialize task table to 0 (all disabled) ---
 1590	41C6	21	2E	D1		    ld hl, task_table
 1591	41C9	11	2F	D1		    ld de, task_table+1
 1592	41CC	01	0F	00		    ld bc, 15                   ; 8 slots Ç- 2 bytes = 16 bytes - 1
 1593	41CF	36	00			    ld (hl), 0
 1594	41D1	ED	B0			    ldir                        ; Clear all task pointers
 1595	41D3					
 1596	41D3					    ; --- STEP 4: Initialize counters ---
 1597	41D3	AF				    xor a
 1598	41D4	32	44	D1		    ld (interrupt_counter), a
 1599	41D7	32	45	D1		    ld (interrupt_counter+1), a
 1600	41DA	32	48	D1		    ld (vblank_flag), a
 1601	41DD					
 1602	41DD					    ; --- STEP 5: Mark system as enabled ---
 1603	41DD	3E	01			    ld a, 1
 1604	41DF	32	3E	D1		    ld (interrupt_system_enabled), a
 1605	41E2					
 1606	41E2	FB				    ei                          ; Re-enable interrupts
 1607	41E3	C9				    ret
 1608	41E4					
 1609	41E4					; ==================================================================
 1610	41E4					; STOP_INTERRUPT_SYSTEM - Restore original H.TIMI hook
 1611	41E4					; ==================================================================
 1612	41E4					; Register Contract:
 1613	41E4					;   Purpose: Restore original H.TIMI bytes and mark system disabled.
 1614	41E4					;   Inputs:
 1615	41E4					;     - None
 1616	41E4					;   Outputs:
 1617	41E4					;     - None
 1618	41E4					;   Clobbers:
 1619	41E4					;     - AF
 1620	41E4					;     - BC
 1621	41E4					;     - DE
 1622	41E4					;     - HL
 1623	41E4					;   Preserved:
 1624	41E4					;     - None
 1625	41E4					;   Register roles:
 1626	41E4					;     - HL/DE/BC = LDIR source/destination/count for hook restore
 1627	41E4					;     - A = zero flag write to interrupt_system_enabled
 1628	41E4					;   Notes:
 1629	41E4					;     - Runs with DI/EI for atomic hook restoration.
 1630	41E4					
 1631	41E4					; Inputs: None
 1632	41E4					; Outputs: None
 1633	41E4					; Modifies: AF, BC, DE, HL
 1634	41E4					; ==================================================================
 1635	41E4					stop_interrupt_system:
 1636	41E4	F3				    di                          ; Disable interrupts
 1637	41E5					
 1638	41E5					    ; Restore original hook
 1639	41E5	21	3F	D1		    ld hl, old_htimi_hook       ; Our backup
 1640	41E8	11	9F	FD		    ld de, #FD9F                ; H.TIMI location
 1641	41EB	01	05	00		    ld bc, 5                    ; Restore 5 bytes
 1642	41EE	ED	B0			    ldir
 1643	41F0					
 1644	41F0					    ; Mark system as disabled
 1645	41F0	AF				    xor a
 1646	41F1	32	3E	D1		    ld (interrupt_system_enabled), a
 1647	41F4					
 1648	41F4	FB				    ei                          ; Re-enable interrupts
 1649	41F5	C9				    ret
 1650	41F6					
 1651	41F6					; ==================================================================
 1652	41F6					; INTERRUPT_DISPATCHER - Main ISR (60Hz/50Hz)
 1653	41F6					; ==================================================================
 1654	41F6					; Register Contract:
 1655	41F6					;   Purpose: Dispatch enabled interrupt tasks each VBlank and chain BIOS hook.
 1656	41F6					;   Inputs:
 1657	41F6					;     - Triggered by H.TIMI hook
 1658	41F6					;   Outputs:
 1659	41F6					;     - interrupt_counter incremented
 1660	41F6					;     - vblank_flag refreshed
 1661	41F6					;   Clobbers:
 1662	41F6					;     - AF
 1663	41F6					;     - BC
 1664	41F6					;     - DE
 1665	41F6					;     - HL
 1666	41F6					;     - IX
 1667	41F6					;     - IY (all restored before exit)
 1668	41F6					;   Preserved:
 1669	41F6					;     - DE
 1670	41F6					;     - IX
 1671	41F6					;     - IY
 1672	41F6					;   Register roles:
 1673	41F6					;     - HL = walks task_table and holds task pointer
 1674	41F6					;     - B = task slot loop counter
 1675	41F6					;     - C = temporary low byte for pointer reconstruction
 1676	41F6					;     - A = enabled checks and pointer validation
 1677	41F6					;   Notes:
 1678	41F6					;     - Dispatcher saves/restores DE/IX/IY defensively, reducing coupling with task internals.
 1679	41F6					
 1680	41F6					; This routine executes on each V-Blank
 1681	41F6					; CRITICAL: Minimal CPU cycles, maximum efficiency
 1682	41F6					; Overhead: ~80 cycles base + ~40 cycles per active task
 1683	41F6					; ==================================================================
 1684	41F6					interrupt_dispatcher:
 1685	41F6					    ; --- STEP 1: Save caller-visible registers used by BIOS/user code ---
 1686	41F6	F5				    push af                     ; 11 cycles
 1687	41F7	E5				    push hl                     ; 11 cycles
 1688	41F8	C5				    push bc                     ; 11 cycles
 1689	41F9	D5				    push de                     ; 11 cycles
 1690	41FA	DD	E5			    push ix                     ; 15 cycles
 1691	41FC	FD	E5			    push iy                     ; 15 cycles
 1692	41FE	08				    ex af, af'
 1693	41FF	F5				    push af
 1694	4200	D9				    exx
 1695	4201	E5				    push hl
 1696	4202	C5				    push bc
 1697	4203	D5				    push de
 1698	4204	D9				    exx
 1699	4205	08				    ex af, af'
 1700	4206					    ; Total: 74 cycles fixed prologue overhead
 1701	4206					
 1702	4206					    ; --- STEP 2: Check if system is enabled ---
 1703	4206	3A	3E	D1		    ld a, (interrupt_system_enabled)
 1704	4209	B7				    or a
 1705	420A	28	2A			    jr z, .exit                 ; If disabled, exit quickly
 1706	420C					
 1707	420C					    ; --- STEP 3: Increment frame counter ---
 1708	420C	2A	44	D1		    ld hl, (interrupt_counter)
 1709	420F	23				    inc hl
 1710	4210	22	44	D1		    ld (interrupt_counter), hl
 1711	4213					
 1712	4213					    ; --- STEP 3.5: Update VBlank flag (reads VDP status) ---
 1713	4213	CD	4A	42		    call update_vblank_flag
 1714	4216					
 1715	4216					    ; --- STEP 4: Walk through task table ---
 1716	4216	21	2E	D1		    ld hl, task_table           ; HL = pointer to task table
 1717	4219	06	08			    ld b, 8                     ; 8 slots
 1718	421B					
 1719	421B					.task_loop:
 1720	421B					    ; Read task pointer (16-bit address)
 1721	421B	7E				    ld a, (hl)                  ; Low byte
 1722	421C	23				    inc hl
 1723	421D	4F				    ld c, a
 1724	421E	7E				    ld a, (hl)                  ; High byte
 1725	421F	23				    inc hl
 1726	4220	B1				    or c                        ; Check if pointer == 0
 1727	4221	28	11			    jr z, .next_task            ; Skip if disabled (pointer == 0)
 1728	4223					
 1729	4223					    ; Valid pointer: execute task
 1730	4223	2B				    dec hl
 1731	4224	2B				    dec hl                      ; Back to low byte
 1732	4225	C5				    push bc                     ; Save loop counter
 1733	4226	E5				    push hl                     ; Save table position
 1734	4227					
 1735	4227					    ; Load task address into HL
 1736	4227	4E				    ld c, (hl)                  ; Low byte
 1737	4228	23				    inc hl
 1738	4229	66				    ld h, (hl)                  ; High byte
 1739	422A	69				    ld l, c                     ; HL = task address
 1740	422B					
 1741	422B					    ; Call task using JP (HL) pattern (faster than indirect CALL)
 1742	422B	CD	49	42		    call .call_task             ; Call the task
 1743	422E					
 1744	422E	E1				    pop hl                      ; Restore table position
 1745	422F	C1				    pop bc                      ; Restore loop counter
 1746	4230	23				    inc hl
 1747	4231	23				    inc hl                      ; Advance to next slot
 1748	4232	18	00			    jr .continue_loop
 1749	4234					
 1750	4234					.next_task:
 1751	4234					    ; Nothing to do, HL already points to next slot
 1752	4234					
 1753	4234					.continue_loop:
 1754	4234	10	E5			    djnz .task_loop             ; Loop 8 times
 1755	4236					
 1756	4236					.exit:
 1757	4236					    ; --- STEP 5: Restore registers ---
 1758	4236	08				    ex af, af'
 1759	4237	D9				    exx
 1760	4238	D1				    pop de
 1761	4239	C1				    pop bc
 1762	423A	E1				    pop hl
 1763	423B	D9				    exx
 1764	423C	F1				    pop af
 1765	423D	08				    ex af, af'
 1766	423E	FD	E1			    pop iy                      ; 14 cycles
 1767	4240	DD	E1			    pop ix                      ; 14 cycles
 1768	4242	D1				    pop de                      ; 10 cycles
 1769	4243	C1				    pop bc                      ; 10 cycles
 1770	4244	E1				    pop hl                      ; 10 cycles
 1771	4245	F1				    pop af                      ; 10 cycles
 1772	4246					
 1773	4246					    ; --- STEP 6: Return from interrupt ---
 1774	4246					    ; For H.TIMI we should chain to the original hook (best compatibility)
 1775	4246					    ; and let the BIOS interrupt handler manage EI/RETI.
 1776	4246	C3	3F	D1		    jp old_htimi_hook
 1777	4249					
 1778	4249					; Helper for indirect call
 1779	4249					.call_task:
 1780	4249	E9				    jp (hl)                     ; Jump to task (task will RET back here)
