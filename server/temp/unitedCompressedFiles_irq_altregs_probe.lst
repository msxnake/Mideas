 5553	5119	F1				    pop af
 5554	511A	CD	FD	51		    call wall_sub_signed_offset_clamped ; A = entity_y = new_top - offset_y
 5555	511D	32	DC	D0		    ld (wall_temp_y), a           ; update position cache
 5556	5120	F5				    push af
 5557	5121	21	C0	C6		    ld hl, entity_y_pos
