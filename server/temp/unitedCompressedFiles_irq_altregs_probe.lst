 4964	4E97					    ; ==================================================================
 4965	4E97					    ; PLATFORM RIDING SYSTEM
 4966	4E97					    ; ==================================================================
 4967	4E97					    ; Detects when entities are standing on platforms and transfers velocity
 4968	4E97					    ;
 4969	4E97					    ; Platform detection: Entity A is on platform B if:
 4970	4E97					    ; - A's bottom edge is at or near B's top edge
 4971	4E97					    ; - A has horizontal overlap with B
 4972	4E97					    ; - B has collision_layer bit 3 set (platform layer = 8)
 4973	4E97					    ;
 4974	4E97					    ; Grace frames: 6 frames tolerance when leaving platform
 4975	4E97					
 4976	4E97					init_platform_riding_system:
 4977	4E97					    ; Initialize platform IDs to 255 (no platform)
 4978	4E97	21	DB	CE		    ld hl, entity_platform_id
 4979	4E9A	11	DC	CE		    ld de, entity_platform_id + 1
 4980	4E9D	01	1F	00		    ld bc, 31
 4981	4EA0	36	FF			    ld (hl), 255
 4982	4EA2	ED	B0			    ldir
 4983	4EA4					
 4984	4EA4					    ; Initialize grace frames to 0
 4985	4EA4	21	FB	CE		    ld hl, entity_platform_grace
 4986	4EA7	11	FC	CE		    ld de, entity_platform_grace + 1
 4987	4EAA	01	1F	00		    ld bc, 31
 4988	4EAD	36	00			    ld (hl), 0
 4989	4EAF	ED	B0			    ldir
 4990	4EB1	C9				    ret
 4991	4EB2					
 4992	4EB2					prepare_platform_detection:
 4993	4EB2					    ; PHASE 1 - Called BEFORE collision detection
 4994	4EB2					    ; Clear platform references from previous frame
 4995	4EB2					    ; Entities that were on platforms get grace frames
 4996	4EB2					    ; Collision detection will reset platform_id if still in contact
 4997	4EB2					
 4998	4EB2	06	20			    ld b, 32
 4999	4EB4	21	DB	CE		    ld hl, entity_platform_id
 5000	4EB7	11	FB	CE		    ld de, entity_platform_grace
 5001	4EBA	0E	00			    ld c, 0
 5002	4EBC					
 5003	4EBC					.platform_clear_loop:
 5004	4EBC	7E				    ld a, (hl)              ; A = platform_id
 5005	4EBD	FE	FF			    cp 255                  ; Check if on a platform
 5006	4EBF	28	07			    jr z, .platform_skip_clear ; Already no platform, skip
 5007	4EC1					
 5008	4EC1					    ; Entity was on a platform last frame
 5009	4EC1					    ; Set grace frames to 6 (coyote time for leaving platform)
 5010	4EC1	E5				    push hl
 5011	4EC2	3E	06			    ld a, 6
 5012	4EC4	12				    ld (de), a              ; Set grace frames
 5013	4EC5	E1				    pop hl
 5014	4EC6					
 5015	4EC6					    ; Clear platform reference (collision will reset if still touching)
 5016	4EC6	36	FF			    ld (hl), 255
 5017	4EC8					
 5018	4EC8					.platform_skip_clear:
 5019	4EC8	23				    inc hl                  ; Next platform_id
 5020	4EC9	13				    inc de                  ; Next grace counter
 5021	4ECA	0C				    inc c
 5022	4ECB	10	EF			    djnz .platform_clear_loop
 5023	4ECD	C9				    ret
 5024	4ECE					
 5025	4ECE					update_platform_riding:
 5026	4ECE					    ; PHASE 2 - Called AFTER collision detection
 5027	4ECE					    ; Decrement grace frames for entities not on platforms
 5028	4ECE					    ; (Entities on platforms have grace=0, set by handle_entity_collision)
 5029	4ECE					
 5030	4ECE	06	20			    ld b, 32
 5031	4ED0	21	FB	CE		    ld hl, entity_platform_grace
 5032	4ED3	11	DB	CE		    ld de, entity_platform_id
 5033	4ED6	0E	00			    ld c, 0
 5034	4ED8					
 5035	4ED8					.grace_loop:
 5036	4ED8					    ; Check if entity has platform reference
 5037	4ED8	1A				    ld a, (de)              ; A = platform_id
 5038	4ED9	FE	FF			    cp 255
 5039	4EDB	20	06			    jr nz, .grace_next      ; Has platform, skip grace decrement
 5040	4EDD					
 5041	4EDD					    ; No platform - decrement grace frames if > 0
 5042	4EDD	7E				    ld a, (hl)              ; A = grace frames
 5043	4EDE	B7				    or a
 5044	4EDF	28	02			    jr z, .grace_next       ; Already 0, skip
 5045	4EE1					
 5046	4EE1	3D				    dec a                   ; Decrement grace
 5047	4EE2	77				    ld (hl), a
 5048	4EE3					
 5049	4EE3					.grace_next:
 5050	4EE3	23				    inc hl                  ; Next grace counter
 5051	4EE4	13				    inc de                  ; Next platform_id
 5052	4EE5	0C				    inc c
 5053	4EE6	10	F0			    djnz .grace_loop
 5054	4EE8	C9				    ret
