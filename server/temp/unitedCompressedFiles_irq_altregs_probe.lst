 6826	5688					; ------------------------------------------------------------------
 6827	5688					; ensure_used_entity_list_current
 6828	5688					; Rebuild compact list only when marked dirty.
 6829	5688					; ------------------------------------------------------------------
 6830	5688					; Register Contract:
 6831	5688					;   Purpose: Conditionally rebuild compact active list only when dirty.
 6832	5688					;   Inputs:
 6833	5688					;     - active_entity_list_dirty flag
 6834	5688					;   Outputs:
 6835	5688					;     - active_entity_list rebuilt if needed
 6836	5688					;   Clobbers:
 6837	5688					;     - AF
 6838	5688					;   Preserved:
 6839	5688					;     - BC
 6840	5688					;     - DE
 6841	5688					;     - HL (except nested call clobbers when rebuild happens)
 6842	5688					;   Register roles:
 6843	5688					;     - A = dirty flag test and branch
 6844	5688					;   Notes:
 6845	5688					;     - If dirty, downstream rebuild_used_entity_list can clobber many registers.
 6846	5688					
 6847	5688					ensure_used_entity_list_current:
 6848	5688	3A	08	D1		    ld a, (active_entity_list_dirty)
 6849	568B	B7				    or a
 6850	568C	C8				    ret z
 6851	568D	CD	91	56		    call rebuild_used_entity_list
 6852	5690	C9				    ret
