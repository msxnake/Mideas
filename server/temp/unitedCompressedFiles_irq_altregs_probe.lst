 3419	4800	CB	78			    bit 7, b
 3420	4802	28	04			    jr z, .casc_positive
 3421	4804					    ; Negative offset: carry=0 means underflow (wrapped below 0)
 3422	4804	38	06			    jr c, .casc_done
 3423	4806	AF				    xor a                         ; Clamp to 0
 3424	4807	C9				    ret
 3425	4808					.casc_positive:
 3426	4808					    ; Positive offset: carry=1 means overflow (wrapped above 255)
 3427	4808	30	02			    jr nc, .casc_done
 3428	480A	3E	FF			    ld a, 255                     ; Clamp to 255
 3429	480C					.casc_done:
 3430	480C	C9				    ret
