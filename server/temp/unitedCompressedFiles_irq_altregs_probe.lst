 6063	5347					; ------------------------------------------------------------------
 6064	5347					; check_tile_interaction
 6065	5347					; Purpose:
 6066	5347					;   Scan active input-driven entities against the interactable tile map,
 6067	5347					;   collect matching tiles, update counters, optional target variable, sound,
 6068	5347					;   and persistent collected-tile state.
 6069	5347					; Input:
 6070	5347					;   None (reads active_entity_list / active_entity_count and runtime maps)
 6071	5347					; Output:
 6072	5347					;   None
 6073	5347					; Clobbers:
 6074	5347					;   AF, BC, DE, HL
 6075	5347					; Preserves:
 6076	5347					;   IX, IY, SP
 6077	5347					; Stack:
 6078	5347					;   Uses balanced push/pop pairs for list pointer, loop counter/entity index,
 6079	5347					;   and temporary tile index saves on all exit paths.
 6080	5347					; Notes:
 6081	5347					;   - Returns immediately if active_entity_count = 0
 6082	5347					;   - Relies on FAST_WRTVRM preserving all registers
 6083	5347					;   - DE must survive the optional HUD/sound hooks until persistence logic runs
 6084	5347					; ------------------------------------------------------------------
 6085	5347					check_tile_interaction:
