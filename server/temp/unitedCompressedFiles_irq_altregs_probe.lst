 13027	9A1E	3A	31	C6		    ld a, (scroll_dirty_flag)
 13028	9A21	B7				    or a
 13029	9A22	C8				    ret z                       ; Not dirty, nothing to do
 13030	9A23					
 13031	9A23					    ; TODO: Implement efficient partial screen redraw
 13032	9A23					    ; For now: redraw entire visible area (simple but slow)
 13033	9A23	CD	2B	9A		    call redraw_viewport
 13034	9A26					
 13035	9A26					    ; Clear dirty flag
 13036	9A26	AF				    xor a
 13037	9A27	32	31	C6		    ld (scroll_dirty_flag), a
