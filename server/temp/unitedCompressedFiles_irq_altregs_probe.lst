 12785	9944					; ------------------------------------------------------------------
 12786	9944					; set_camera_position
 12787	9944					; Set camera position in pixels (with bounds checking)
 12788	9944					; Input:  HL = X position (pixels), DE = Y position (pixels)
 12789	9944					; Destroys: AF, BC
 12790	9944					; ------------------------------------------------------------------
 12791	9944					set_camera_position:
 12792	9944					    ; Bounds check X
 12793	9944	E5				    push hl
 12794	9945	D5				    push de
 12795	9946					
 12796	9946					    ; Calculate max X = (world_width_tiles - SCREEN_WIDTH_TILES) * TILE_WIDTH
 12797	9946	3A	2F	C6		    ld a, (world_width_tiles)
 12798	9949	D6	20			    sub SCREEN_WIDTH_TILES
 12799	994B	38	1A			    jr c, .scroll_x_in_bounds   ; World smaller than screen
 12800	994D					
 12801	994D					    ; A = tiles to scroll, multiply by tile width
 12802	994D	47				    ld b, a
 12803	994E	3E	10			    ld a, 16
 12804	9950	CD	2C	9A		    call multiply_a_by_b        ; HL = max X
 12805	9953					
 12806	9953					    ; Compare camera X with max X
 12807	9953	D1				    pop de
 12808	9954	C1				    pop bc                      ; BC = requested X
 12809	9955	C5				    push bc
 12810	9956	D5				    push de
 12811	9957					
 12812	9957					    ; If requested X > max X, clamp to max X
 12813	9957	78				    ld a, b
 12814	9958	BC				    cp h
 12815	9959	38	08			    jr c, .scroll_x_clamped
 12816	995B	20	0A			    jr nz, .scroll_x_in_bounds
 12817	995D	79				    ld a, c
 12818	995E	BD				    cp l
 12819	995F	38	02			    jr c, .scroll_x_clamped
 12820	9961	18	04			    jr .scroll_x_in_bounds
 12821	9963					
 12822	9963					.scroll_x_clamped:
 12823	9963	44				    ld b, h
 12824	9964	4D				    ld c, l
 12825	9965	18	04			    jr .scroll_x_done
 12826	9967					
 12827	9967					.scroll_x_in_bounds:
 12828	9967	D1				    pop de
 12829	9968	C1				    pop bc
 12830	9969	C5				    push bc
 12831	996A	D5				    push de
 12832	996B					
 12833	996B					.scroll_x_done:
 12834	996B					    ; Store camera X
 12835	996B	79				    ld a, c
 12836	996C	32	29	C6		    ld (camera_x), a
 12837	996F	78				    ld a, b
 12838	9970	32	2A	C6		    ld (camera_x + 1), a
 12839	9973					
 12840	9973					    ; Calculate camera_tile_x = camera_x / TILE_WIDTH
 12841	9973					    
 12842	9973					    ; Tile width is 16, shift right 4 times
 12843	9973	79				    ld a, c
 12844	9974	CB	38			    srl b
 12845	9976	1F				    rra
 12846	9977	CB	38			    srl b
 12847	9979	1F				    rra
 12848	997A	CB	38			    srl b
 12849	997C	1F				    rra
 12850	997D	CB	38			    srl b
 12851	997F	1F				    rra
 12852	9980	32	2D	C6		    ld (camera_tile_x), a
 12853	9983					
 12854	9983					    ; Bounds check Y
 12855	9983	D1				    pop de                      ; DE = requested Y
 12856	9984	C1				    pop bc
 12857	9985					
 12858	9985					    ; Calculate max Y = (world_height_tiles - SCREEN_HEIGHT_TILES) * TILE_HEIGHT
 12859	9985	3A	30	C6		    ld a, (world_height_tiles)
 12860	9988	D6	18			    sub SCREEN_HEIGHT_TILES
 12861	998A	38	14			    jr c, .scroll_y_in_bounds   ; World smaller than screen
 12862	998C					
 12863	998C	47				    ld b, a
 12864	998D	3E	10			    ld a, 16
 12865	998F	CD	2C	9A		    call multiply_a_by_b        ; HL = max Y
 12866	9992					
 12867	9992					    ; If requested Y > max Y, clamp to max Y
 12868	9992	7A				    ld a, d
 12869	9993	BC				    cp h
 12870	9994	38	08			    jr c, .scroll_y_clamped
 12871	9996	20	08			    jr nz, .scroll_y_in_bounds
 12872	9998	7B				    ld a, e
 12873	9999	BD				    cp l
 12874	999A	38	02			    jr c, .scroll_y_clamped
 12875	999C	18	02			    jr .scroll_y_in_bounds
 12876	999E					
 12877	999E					.scroll_y_clamped:
 12878	999E	54				    ld d, h
 12879	999F	5D				    ld e, l
 12880	99A0					
 12881	99A0					.scroll_y_in_bounds:
 12882	99A0					    ; Store camera Y
 12883	99A0	7B				    ld a, e
 12884	99A1	32	2B	C6		    ld (camera_y), a
 12885	99A4	7A				    ld a, d
 12886	99A5	32	2C	C6		    ld (camera_y + 1), a
 12887	99A8					
 12888	99A8					    ; Calculate camera_tile_y = camera_y / TILE_HEIGHT
 12889	99A8					    
 12890	99A8					    ; Tile height is 16, shift right 4 times
 12891	99A8	7B				    ld a, e
 12892	99A9	CB	3A			    srl d
 12893	99AB	1F				    rra
 12894	99AC	CB	3A			    srl d
 12895	99AE	1F				    rra
 12896	99AF	CB	3A			    srl d
 12897	99B1	1F				    rra
 12898	99B2	CB	3A			    srl d
 12899	99B4	1F				    rra
 12900	99B5	32	2E	C6		    ld (camera_tile_y), a
 12901	99B8					
 12902	99B8					    ; Mark viewport as dirty (needs redraw)
 12903	99B8	3E	01			    ld a, 1
 12904	99BA	32	31	C6		    ld (scroll_dirty_flag), a
 12905	99BD					
 12906	99BD	C9				    ret
 12907	99BE					
 12908	99BE					; ------------------------------------------------------------------
 12909	99BE					; move_camera
 12910	99BE					; Move camera by delta (relative movement)
 12911	99BE					; Input:  B = delta X (signed), C = delta Y (signed)
 12912	99BE					; Destroys: AF, BC, DE, HL
 12913	99BE					; ------------------------------------------------------------------
 12914	99BE					move_camera:
 12915	99BE					    ; Get current camera position
 12916	99BE	3A	29	C6		    ld a, (camera_x)
 12917	99C1	6F				    ld l, a
 12918	99C2	3A	2A	C6		    ld a, (camera_x + 1)
 12919	99C5	67				    ld h, a                     ; HL = camera X
 12920	99C6					
 12921	99C6	3A	2B	C6		    ld a, (camera_y)
 12922	99C9	5F				    ld e, a
 12923	99CA	3A	2C	C6		    ld a, (camera_y + 1)
 12924	99CD	57				    ld d, a                     ; DE = camera Y
 12925	99CE					
 12926	99CE					    ; Add delta X (signed 8-bit)
 12927	99CE	78				    ld a, b
 12928	99CF	B7				    or a
 12929	99D0	F2	DF	99		    jp p, .move_positive_x      ; Positive delta
 12930	99D3					
 12931	99D3					    ; Negative delta
 12932	99D3	2F				    cpl
 12933	99D4	3C				    inc a                       ; A = abs(delta)
 12934	99D5	47				    ld b, a
 12935	99D6	7D				    ld a, l
 12936	99D7	90				    sub b
 12937	99D8	6F				    ld l, a
 12938	99D9	7C				    ld a, h
 12939	99DA	DE	00			    sbc a, 0
 12940	99DC	67				    ld h, a
 12941	99DD	18	07			    jr .move_x_done
 12942	99DF					
 12943	99DF					.move_positive_x:
 12944	99DF	7D				    ld a, l
 12945	99E0	80				    add a, b
 12946	99E1	6F				    ld l, a
 12947	99E2	7C				    ld a, h
 12948	99E3	CE	00			    adc a, 0
 12949	99E5	67				    ld h, a
 12950	99E6					
 12951	99E6					.move_x_done:
 12952	99E6					    ; Add delta Y (signed 8-bit)
 12953	99E6	79				    ld a, c
 12954	99E7	B7				    or a
 12955	99E8	F2	F7	99		    jp p, .move_positive_y
 12956	99EB					
 12957	99EB					    ; Negative delta
 12958	99EB	2F				    cpl
 12959	99EC	3C				    inc a
 12960	99ED	4F				    ld c, a
 12961	99EE	7B				    ld a, e
 12962	99EF	91				    sub c
 12963	99F0	5F				    ld e, a
 12964	99F1	7A				    ld a, d
 12965	99F2	DE	00			    sbc a, 0
 12966	99F4	57				    ld d, a
 12967	99F5	18	07			    jr .move_y_done
 12968	99F7					
 12969	99F7					.move_positive_y:
 12970	99F7	7B				    ld a, e
 12971	99F8	81				    add a, c
 12972	99F9	5F				    ld e, a
 12973	99FA	7A				    ld a, d
 12974	99FB	CE	00			    adc a, 0
 12975	99FD	57				    ld d, a
 12976	99FE					
 12977	99FE					.move_y_done:
 12978	99FE					    ; Set new camera position (with bounds checking)
 12979	99FE	CD	44	99		    call set_camera_position
 12980	9A01	C9				    ret
 12981	9A02					
 12982	9A02					; ------------------------------------------------------------------
 12983	9A02					; center_camera_on_entity
 12984	9A02					; Center viewport on an entity (e.g. player)
 12985	9A02					; Input:  A = Entity index
 12986	9A02					; Destroys: AF, BC, DE, HL
 12987	9A02					; ------------------------------------------------------------------
 12988	9A02					center_camera_on_entity:
 12989	9A02					    ; Get entity position
 12990	9A02	4F				    ld c, a
 12991	9A03	06	00			    ld b, 0
 12992	9A05	21	A0	C6		    ld hl, entity_x_pos
 12993	9A08	09				    add hl, bc
 12994	9A09	7E				    ld a, (hl)                  ; A = entity X
 12995	9A0A					
 12996	9A0A	21	C0	C6		    ld hl, entity_y_pos
 12997	9A0D	09				    add hl, bc
 12998	9A0E	5E				    ld e, (hl)                  ; E = entity Y
 12999	9A0F					
 13000	9A0F					    ; Calculate camera position to center entity
 13001	9A0F					    ; camera_x = entity_x - (SCREEN_WIDTH / 2)
 13002	9A0F	D6	80			    sub 128                     ; Center horizontally
 13003	9A11	6F				    ld l, a
 13004	9A12	26	00			    ld h, 0                     ; HL = camera X
 13005	9A14					
 13006	9A14					    ; camera_y = entity_y - (SCREEN_HEIGHT / 2)
 13007	9A14	7B				    ld a, e
 13008	9A15	D6	60			    sub 96                      ; Center vertically
 13009	9A17	5F				    ld e, a
 13010	9A18	16	00			    ld d, 0                     ; DE = camera Y
 13011	9A1A					
 13012	9A1A					    ; Set camera position
 13013	9A1A	CD	44	99		    call set_camera_position
 13014	9A1D	C9				    ret
 13015	9A1E					
 13016	9A1E					; ==================================================================
 13017	9A1E					; VIEWPORT RENDERING
 13018	9A1E					; ==================================================================
 13019	9A1E					
 13020	9A1E					; ------------------------------------------------------------------
 13021	9A1E					; update_scroll
 13022	9A1E					; Update viewport if dirty flag is set
 13023	9A1E					; Redraws visible tiles based on camera position
 13024	9A1E					; ------------------------------------------------------------------
 13025	9A1E					update_scroll:
