 1829	425E					; ENABLE_TASK - Activate a task in the system
 1830	425E					; ==================================================================
 1831	425E					; Register Contract:
 1832	425E					;   Purpose: Store routine pointer into task_table slot.
 1833	425E					;   Inputs:
 1834	425E					;     - A = task slot (0-7)
 1835	425E					;     - HL = task routine address
 1836	425E					;   Outputs:
 1837	425E					;     - task_table[slot] = HL
 1838	425E					;   Clobbers:
 1839	425E					;     - AF
 1840	425E					;     - BC
 1841	425E					;     - DE
 1842	425E					;     - HL
 1843	425E					;   Preserved:
 1844	425E					;     - None
 1845	425E					;   Register roles:
 1846	425E					;     - A = slot validation and offset math
 1847	425E					;     - DE = holds routine address while HL is repurposed as slot pointer
 1848	425E					;     - BC = task_table base address
 1849	425E					;     - HL = slot address calculation / pointer write
 1850	425E					
 1851	425E					; Inputs:
 1852	425E					;   A = task slot (0-7)
 1853	425E					;   HL = address of task routine
 1854	425E					; Outputs: None
 1855	425E					; Modifies: AF, BC, DE, HL
