 11206	701A					; ------------------------------------------------------------------
 11207	701A					; hud_print_string
 11208	701A					; Print a null-terminated string to Screen 2 Name Table
 11209	701A					; Input: HL = VRAM address, DE = String pointer (RAM)
 11210	701A					; ------------------------------------------------------------------
 11211	701A					hud_print_string:
 11212	701A	F5				    push af
 11213	701B	C5				    push bc
 11214	701C	D5				    push de
 11215	701D	E5				    push hl
 11216	701E					
 11217	701E					.print_loop:
 11218	701E	1A				    ld a, (de)                  ; Get character from string
 11219	701F	B7				    or a                        ; Check for null terminator
 11220	7020	28	0F			    jr z, .print_done
 11221	7022					
 11222	7022					    ; OPTIMIZED: Inline ASCII validation (saves CALL/RET overhead = 27 cycles)
 11223	7022	FE	20			    cp 32                       ; Check if >= 32 (printable ASCII)
 11224	7024	30	02			    jr nc, .valid_char          ; If valid, skip to write
 11225	7026	3E	20			    ld a, 32                    ; Replace control chars with space
 11226	7028					.valid_char:
 11227	7028					
 11228	7028					    ; Write tile to VRAM Name Table
 11229	7028					    ; WRTVRM signature: A = data, HL = VRAM address
 11230	7028					    ; A already has character, HL already has VRAM address
 11231	7028	D5				    push de                     ; Save string pointer
 11232	7029	CD	CE	40		    call FAST_WRTVRM            ; Write A to VRAM at HL
 11233	702C	D1				    pop de                      ; Restore string pointer
 11234	702D					
 11235	702D					    ; Move to next character
 11236	702D	13				    inc de                      ; Next char in string
 11237	702E	23				    inc hl                      ; Next VRAM position
 11238	702F					
 11239	702F	18	ED			    jr .print_loop
 11240	7031					
 11241	7031					.print_done:
 11242	7031	E1				    pop hl
 11243	7032	D1				    pop de
 11244	7033	C1				    pop bc
 11245	7034	F1				    pop af
 11246	7035	C9				    ret
