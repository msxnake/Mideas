 6755	5654					; ==================================================================
 6756	5654					; UPDATE ALL ENTITIES - Called by GameFlow (OPTIMIZED)
 6757	5654					; ==================================================================
 6758	5654					; Only calls component systems that are actually used in this project
 6759	5654					; Unused systems are NOT called (saves Z80 cycles)
 6760	5654					; Register Contract:
 6761	5654					;   Purpose: Main ECS tick entrypoint for one frame.
 6762	5654					;   Inputs:
 6763	5654					;     - Entity/component tables in RAM
 6764	5654					;   Outputs:
 6765	5654					;     - Components updated in fixed order
 6766	5654					;   Clobbers:
 6767	5654					;     - AF
 6768	5654					;     - BC
 6769	5654					;     - DE
 6770	5654					;     - HL
 6771	5654					;   Preserved:
 6772	5654					;     - None (callers should save what they need)
 6773	5654					;   Register roles:
 6774	5654					;     - Registers are scratch across component CALL chain
 6775	5654					;     - Contract intentionally conservative to prevent hidden coupling
 6776	5654					;   Notes:
 6777	5654					;     - Do not assume any register survives this routine.
 6778	5654					
 6779	5654					update_all_entities:
 6780	5654					    ; Rebuild entity list every frame so job scheduler cadence
 6781	5654					    ; (entity_job_period/entity_job_entry) is evaluated against interrupt_counter.
 6782	5654	CD	91	56		    call rebuild_used_entity_list
 6783	5657	CD	80	49		    call update_input_component         ; 1. Input (player control)
 6784	565A	CD	BD	68		    call update_entities                ; 3b. Patrol/per-entity update
 6785	565D	CD	AC	4C		    call update_jump_component          ; 4. Jump impulse
 6786	5660	CD	63	4E		    call update_cursors_component       ; 5b. Cursors movement
 6787	5663	CD	87	4D		    call update_gravity_component       ; 6. Gravity
 6788	5666	CD	22	52		    call update_slash_component         ; 6b. Additive slash velocity
 6789	5669	CD	1E	44		    call update_position_component      ; 7. Apply velocity
 6790	566C	CD	B2	4E		    call prepare_platform_detection     ; 8a. Clear platform refs
 6791	566F	CD	C4	45		    call update_collision_component     ; 8b. Collision detection
 6792	5672	CD	CE	4E		    call update_platform_riding         ; 8c. Platform riding
 6793	5675	CD	EA	4E		    call update_wallcollision_component ; 8d. Wall collision
 6794	5678	CD	47	53		    call check_tile_interaction         ; 8e. Tile interaction (gems/collectibles)
 6795	567B	CD	6C	4B		    call update_animation_component     ; 11. Animation
 6796	567E	CD	95	44		    call update_sprite_component        ; 13. Sprite rendering
 6797	5681	C9				    ret
