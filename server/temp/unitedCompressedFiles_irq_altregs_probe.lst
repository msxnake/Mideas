 2525	4424	21	E7	D0		    ld hl, active_entity_list
 2526	4427					
 2527	4427					position_update_loop:
 2528	4427	4E				    ld c, (hl)                 ; C = entity index
 2529	4428	23				    inc hl                     ; Advance list pointer
 2530	4429	E5				    push hl                    ; Save list pointer
 2531	442A	59				    ld e, c
 2532	442B	16	00			    ld d, 0
 2533	442D	21	20	C7		    ld hl, entity_comp_masks
 2534	4430	19				    add hl, de
 2535	4431	7E				    ld a, (hl)                 ; Get entity component mask
 2536	4432	57				    ld d, a                    ; OPTIMIZED: Save mask in D to avoid redundant memory read
 2537	4433	E1				    pop hl                     ; Restore list pointer
