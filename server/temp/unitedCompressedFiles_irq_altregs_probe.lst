 6854	5691					; ------------------------------------------------------------------
 6855	5691					; rebuild_used_entity_list
 6856	5691					; Build compact list of ACTIVE entity slots that are in use
 6857	5691					; for the CURRENT SCREEN only:
 6858	5691					; (entity_active != 0 and mask_l|mask_h != 0 and entity_screen_id == current_screen_id)
 6859	5691					; Output:
 6860	5691					;   active_entity_list[]   = entity indices with components
 6861	5691					;   active_entity_count    = number of entries
 6862	5691					; ------------------------------------------------------------------
 6863	5691					; Register Contract:
 6864	5691					;   Purpose: Recompute compact list of entities active on current screen.
 6865	5691					;   Inputs:
 6866	5691					;     - entity_active, entity_comp_masks(_hi), entity_screen_id, current_screen_id
 6867	5691					;   Outputs:
 6868	5691					;     - active_entity_list[]
 6869	5691					;     - active_entity_count
 6870	5691					;     - active_entity_list_dirty=0
 6871	5691					;   Clobbers:
 6872	5691					;     - AF
 6873	5691					;     - BC
 6874	5691					;     - DE
 6875	5691					;     - HL
 6876	5691					;   Preserved:
 6877	5691					;     - None
 6878	5691					;   Register roles:
 6879	5691					;     - B = slots remaining (MAX_ENTITIES..1)
 6880	5691					;     - C = entity slot iterator (0..MAX_ENTITIES-1)
 6881	5691					;     - DE = index offset (entity id / active list position)
 6882	5691					;     - HL = pointer math over component and state arrays
 6883	5691					;     - A = predicate checks and counters
 6884	5691					
