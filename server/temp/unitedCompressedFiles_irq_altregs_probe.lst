 17816	AC70					; ------------------------------------------------------------------
 17817	AC70					; HELPER: Match directional key against one input direction value
 17818	AC70					; Input: D = Desired key (1/3/5/7), A = direction (0-8), B = entity index
 17819	AC70					; Output: A = 1 if active, 0 if inactive
 17820	AC70					; Note: diagonal inputs only match a cardinal if entity_dir_mask[B] permits
 17821	AC70					;       that direction. Entities without Input default to #0F (all allowed).
 17822	AC70					; ------------------------------------------------------------------
 17823	AC70					SM_MatchDirection:
 17824	AC70	5F				    ld e, a
 17825	AC71	BA				    cp d
 17826	AC72	CA	01	AD		    jp z, .smd_match_yes    ; exact match always passes
 17827	AC75					
