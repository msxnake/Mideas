 12140	7331	21	CA	79		    ld hl, music_pt3_track_table
 12141	7334	19				    add hl, de
 12142	7335	5E				    ld e, (hl)
 12143	7336	23				    inc hl
 12144	7337	56				    ld d, (hl)
 12145	7338	62				    ld h, d
