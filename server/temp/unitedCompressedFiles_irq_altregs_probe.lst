 171	4069					
 172	4069					; Helper: Get expanded slot value for ENASLT/CALSLT usage
 173	4069					; Input:  A = slot number (0-3) in lower bits
 174	4069					; Output: A = expanded slot value if needed
 175	4069					GETSLOT:
 176	4069	E6	03			    and #03             ; Proteccion, nos aseguramos de que el valor esta en 0-3
 177	406B	4F				    ld  c,a             ; c = slot de la pagina
 178	406C	06	00			    ld  b,0             ; bc = slot de la pagina
 179	406E	21	C1	FC		    ld  hl,#fcc1        ; Tabla de slots expandidos
 180	4071	09				    add hl,bc           ; hl -> variable que indica si este slot esta expandido
 181	4072	7E				    ld  a,(hl)          ; Tomamos el valor
 182	4073	E6	80			    and #80             ; Si el bit mas alto es cero...
 183	4075	28	09			    jr  z,GETSLOT_EXIT  ; ...nos vamos a @@EXIT
 184	4077					    ; --- El slot esta expandido ---
 185	4077	B1				    or  c               ; Slot basico en el lugar adecuado
 186	4078	4F				    ld  c,a             ; Guardamos el valor en c
 187	4079	23				    inc hl              ; Incrementamos hl una...
 188	407A	23				    inc hl              ; ...dos...
 189	407B	23				    inc hl              ; ...tres...
 190	407C	23				    inc hl              ; ...cuatro veces
 191	407D	7E				    ld  a,(hl)          ; a = valor del registro de subslot del slot donde estamos
 192	407E	E6	0C			    and #0C             ; Nos quedamos con el valor donde esta nuestro cartucho
 193	4080					GETSLOT_EXIT:
 194	4080	B1				    or  c
 195	4081	C9				    ret
 196	4082					
 197	4082					; From: http://www.z80st.es/downloads/code/
 198	4082					; SETPAGES32K:  BIOS-ROM-YY-ZZ   -> BIOS-ROM-ROM-ZZ (SITUA PAGINA 2)
 199	4082					SETPAGES32K:    ; --- Posiciona las paginas de un megarom o un 32K ---
 200	4082	3E	C9			    ld  a, #C9              ; Codigo de RET
 201	4084	32	87	40		    ld  (SETPAGES32K_NOPRET), a   ; Modificamos la siguiente instruccion si estamos en RAM
 202	4087					SETPAGES32K_NOPRET:
 203	4087	00				    nop                     ; No hacemos nada si no estamos en RAM
 204	4088					    ; --- Si llegamos aqui no estamos en RAM, hay que posicionar la pagina ---
 205	4088	CD	38	01		    call RSLREG             ; Leemos el contenido del registro de seleccion de slots
 206	408B	0F				    rrca                    ; Rotamos a la derecha...
 207	408C	0F				    rrca                    ; ...dos veces
 208	408D	CD	69	40		    call GETSLOT            ; Obtenemos el slot de la pagina 1 ($4000-$BFFF)
 209	4090	32	13	C0		    ld (ROM_slot), a        ; Save slot for later use
 210	4093	26	80			    ld  h, #80              ; Seleccionamos pagina 2 ($8000-$BFFF)
 211	4095	C3	24	00		    jp  ENASLT              ; Posicionamos la pagina 2 y volvemos
 212	4098					
 213	4098					; Source: https://www.msx.org/forum/development/msx-development/how-0?page=0
 214	4098					; Returns 1 in a and clears z flag if vdp is 60Hz
 215	4098					CheckIf60Hz:
 216	4098	F3				    di
 217	4099	DB	99			    in      a, (#99)
 218	409B	00				    nop
 219	409C	00				    nop
 220	409D	00				    nop
 221	409E					vdpSync:
 222	409E	DB	99			    in      a, (#99)
 223	40A0	E6	80			    and     #80
 224	40A2	28	FA			    jr      z, vdpSync
 225	40A4					
 226	40A4	21	00	09		    ld      hl, #900
 227	40A7					vdpLoop:
 228	40A7	2B				    dec     hl
 229	40A8	7C				    ld      a, h
 230	40A9	B5				    or      l
 231	40AA	20	FB			    jr      nz, vdpLoop
 232	40AC					
 233	40AC	DB	99			    in      a, (#99)
 234	40AE	07				    rlca
 235	40AF	E6	01			    and     1
 236	40B1	FB				    ei
 237	40B2	C9				    ret
