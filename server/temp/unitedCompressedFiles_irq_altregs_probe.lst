 6805	5682					; ------------------------------------------------------------------
 6806	5682					; Register Contract:
 6807	5682					;   Purpose: Mark compact active-entity cache as stale.
 6808	5682					;   Inputs:
 6809	5682					;     - None
 6810	5682					;   Outputs:
 6811	5682					;     - active_entity_list_dirty = 1
 6812	5682					;   Clobbers:
 6813	5682					;     - HL
 6814	5682					;   Preserved:
 6815	5682					;     - AF
 6816	5682					;     - BC
 6817	5682					;     - DE
 6818	5682					;   Register roles:
 6819	5682					;     - HL = points to dirty flag byte
