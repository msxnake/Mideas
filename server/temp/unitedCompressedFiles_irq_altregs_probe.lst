 8584	5FCA					; Helper function to set VDP background and border colors
 8585	5FCA					; Input: A = background color (0-15), B = border color (0-15)
 8586	5FCA					set_screen_colors:
 8587	5FCA	F5				    push af
 8588	5FCB	C5				    push bc
 8589	5FCC	E5				    push hl
 8590	5FCD					
 8591	5FCD					    ; Set VDP Register 7: [Background Color (4-7) | Border Color (0-3)]
 8592	5FCD					
 8593	5FCD					    ; OPTIMIZED: Use lookup table instead of 4× RLCA
 8594	5FCD					    ; Process Background Color (in A) -> High Nibble
 8595	5FCD	E6	0F			    and #0F                    ; Ensure 0-15 range
 8596	5FCF	21	BA	5F		    ld hl, color_shift_table
 8597	5FD2	85				    add a, l                   ; Add offset to table base
 8598	5FD3	6F				    ld l, a
 8599	5FD4	8C				    adc a, h                   ; Handle carry
 8600	5FD5	95				    sub l
 8601	5FD6	67				    ld h, a
 8602	5FD7	7E				    ld a, (hl)                 ; A = background color << 4
 8603	5FD8	4F				    ld c, a                    ; Save shifted background in C
 8604	5FD9					
 8605	5FD9					    ; Process Border Color (in B) -> Low Nibble
 8606	5FD9	78				    ld a, b                    ; Get border color
 8607	5FDA	E6	0F			    and #0F                    ; Ensure 0-15 range
 8608	5FDC					
 8609	5FDC					    ; Combine
 8610	5FDC	B1				    or c                       ; Combine: background << 4 | border
 8611	5FDD					
 8612	5FDD	47				    ld b, a                    ; Value for VDP R#7
 8613	5FDE	0E	07			    ld c, 7                    ; VDP Register 7
 8614	5FE0	CD	F4	40		    call FAST_WRTVDP           ; BIOS call to write VDP register
