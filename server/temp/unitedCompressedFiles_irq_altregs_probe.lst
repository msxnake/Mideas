 12147	733A	AF				    xor a
 12148	733B	32	4E	D1		    ld (music_muted), a
 12149	733E	32	74	D1		    ld (PT3_SETUP), a      ; Clear end-of-song flag
 12150	7341	F3				    di                     ; Disable interrupts while initialising PT3
 12151	7342	DD	E5			    push ix
 12152	7344	FD	E5			    push iy
 12153	7346	CD	B8	73		    call PT3_INIT
 12154	7349	FD	E1			    pop iy
 12155	734B	DD	E1			    pop ix
 12156	734D	3E	01			    ld a, 1
 12157	734F	32	4D	D1		    ld (music_active), a   ; Enable playback AFTER PT3 is fully initialised
 12158	7352	FB				    ei
