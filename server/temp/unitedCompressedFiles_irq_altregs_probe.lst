 13769	9CC4	B9				    cp c
 13770	9CC5	28	06			    jr z, .anim_found_tile
 13771	9CC7					
 13772	9CC7	11	07	00		    ld de, ANIM_TILE_ENTRY_SIZE
 13773	9CCA	19				    add hl, de
 13774	9CCB	18	F2			    jr .anim_search_loop
 13775	9CCD					
