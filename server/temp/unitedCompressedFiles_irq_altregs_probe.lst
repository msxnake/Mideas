 20226	B6DD					
 20227	B6DD					; ==================================================================
 20228	B6DD					; trans_clear_pixel_row_colors
 20229	B6DD					; Blackens a single pixel row (1px tall) by setting the color table
 20230	B6DD					; entry for all 256 tile patterns in the appropriate bank to 0x11
 20231	B6DD					; (fg=black, bg=black).  Works at 1-pixel-row granularity unlike
 20232	B6DD					; trans_clear_row_direct which works at 8-pixel (tile-row) granularity.
 20233	B6DD					;
 20234	B6DD					; Screen 2 color table layout:
 20235	B6DD					;   Bank 0 (#2000): tiles used in name-table rows 0-7   (pixel rows 0-63)
 20236	B6DD					;   Bank 1 (#2800): tiles used in name-table rows 8-15  (pixel rows 64-127)
 20237	B6DD					;   Bank 2 (#3000): tiles used in name-table rows 16-23 (pixel rows 128-191)
 20238	B6DD					; Each tile has 8 color bytes; byte J covers pixel sub-row J of that tile.
 20239	B6DD					; Tile T color byte for sub-row J:  bank_base + T*8 + J
 20240	B6DD					;
 20241	B6DD					; Input:  A = pixel row (0-191)
 20242	B6DD					;         bank    = A >> 6   (0-2)
 20243	B6DD					;         sub_row = A & 7    (0-7)
 20244	B6DD					;         color_base = #2000 + bank * #0800
 20245	B6DD					; Preserves: BC, DE, HL
 20246	B6DD					; ==================================================================
 20247	B6DD					trans_clear_pixel_row_colors:
 20248	B6DD	C5				    push bc
 20249	B6DE	D5				    push de
 20250	B6DF	E5				    push hl
 20251	B6E0					    ; --- Compute sub_row = A & 7 ---
 20252	B6E0	6F				    ld l, a                       ; L = pixel row (save)
 20253	B6E1	E6	07			    and 7
 20254	B6E3	5F				    ld e, a                       ; E = sub_row (0-7)
 20255	B6E4					    ; --- Compute bank = A >> 6 (0-2) ---
 20256	B6E4	7D				    ld a, l
 20257	B6E5	CB	3F			    srl a
 20258	B6E7	CB	3F			    srl a
 20259	B6E9	CB	3F			    srl a
 20260	B6EB	CB	3F			    srl a
 20261	B6ED	CB	3F			    srl a
 20262	B6EF	CB	3F			    srl a                         ; A = bank (0, 1 or 2)
 20263	B6F1					    ; --- Compute H = #20 + bank*8 (color table high byte) ---
 20264	B6F1					    ; bank=0 -> H=#20, bank=1 -> H=#28, bank=2 -> H=#30
 20265	B6F1	87				    add a, a                      ; bank * 2
 20266	B6F2	87				    add a, a                      ; bank * 4
 20267	B6F3	87				    add a, a                      ; bank * 8
 20268	B6F4	C6	20			    add a, #20
 20269	B6F6	67				    ld h, a                       ; H = color table high byte for this bank
 20270	B6F7	6B				    ld l, e                       ; L = sub_row  (offset within tile 0 entry)
 20271	B6F8					    ; HL now = address of tile-0 color byte for this pixel sub-row
 20272	B6F8					    ; --- Write 0x11 (black/black) for all 256 tiles ---
 20273	B6F8					    ; Tile addresses: HL, HL+8, HL+16, ... HL+255*8
 20274	B6F8					    ; (consecutive tiles are 8 bytes apart in the color table)
 20275	B6F8	06	00			    ld b, 0                       ; B=0 ? djnz executes 256 times
 20276	B6FA					.tpcr_loop:
 20277	B6FA					    ; DI only around the 3 critical VDP port writes.
 20278	B6FA					    ; Keeping DI for the whole loop would leave interrupts disabled for ~6ms
 20279	B6FA					    ; and can cause DI+HALT if trans_wait_frames is reached before EI fires.
 20280	B6FA	F3				    di
 20281	B6FB	7D				    ld a, l
 20282	B6FC	D3	99			    out (#99), a                  ; VRAM address low
 20283	B6FE	7C				    ld a, h
 20284	B6FF	F6	40			    or #40
 20285	B701	D3	99			    out (#99), a                  ; VRAM address high + write mode
 20286	B703	3E	11			    ld a, #11                     ; fg=1 (black), bg=1 (black)
 20287	B705	D3	98			    out (#98), a                  ; Write to VRAM color table
 20288	B707	FB				    ei                            ; Re-enable: interrupt fires after next instr
 20289	B708	7D				    ld a, l                       ; (EI delay instruction) Advance HL += 8
 20290	B709	C6	08			    add a, 8
 20291	B70B	6F				    ld l, a
 20292	B70C	30	01			    jr nc, .tpcr_nc
 20293	B70E	24				    inc h
 20294	B70F					.tpcr_nc:
 20295	B70F	10	E9			    djnz .tpcr_loop
 20296	B711	E1				    pop hl
 20297	B712	D1				    pop de
 20298	B713	C1				    pop bc
 20299	B714	C9				    ret
 20300	B715					
 20301	B715					; ==================================================================
 20302	B715					; trans_wait_frames
 20303	B715					; Wait N V-blank frames where N = transition_delay_var
 20304	B715					; Provides timed delay between animation steps
 20305	B715					; Preserves: BC, DE, HL
 20306	B715					; ==================================================================
 20307	B715					trans_wait_frames:
 20308	B715	C5				    push bc
 20309	B716	3A	0F	C0		    ld a, (transition_delay_var)
 20310	B719	B7				    or a
 20311	B71A	28	04			    jr z, .twf_done               ; 0 = no wait (safety)
 20312	B71C	47				    ld b, a
 20313	B71D					.twf_loop:
 20314	B71D	76				    halt                          ; Wait for V-blank (~20ms at 50Hz)
 20315	B71E	10	FD			    djnz .twf_loop
 20316	B720					.twf_done:
 20317	B720	C1				    pop bc
 20318	B721	C9				    ret
 20319	B722					
 20320	B722					; ==================================================================
 20321	B722					; trans_clear_column
 20322	B722					; Write tile 0 to all 24 rows of a single column in the Name Table
 20323	B722					; Input:  A = column (0-31)
 20324	B722					; Preserves: BC, DE, HL
 20325	B722					; ==================================================================
 20326	B722					trans_clear_column:
 20327	B722	C5				    push bc
 20328	B723	D5				    push de
 20329	B724	E5				    push hl
 20330	B725	6F				    ld l, a
 20331	B726	26	18			    ld h, #18                     ; HL = #1800 + column (row 0)
 20332	B728	06	18			    ld b, 24                      ; 24 rows
 20333	B72A	F3				    di                            ; Protect VDP address setup from ISR corruption
 20334	B72B					.tcc_row:
 20335	B72B	7D				    ld a, l
 20336	B72C	D3	99			    out (#99), a                  ; VRAM address low byte
 20337	B72E	7C				    ld a, h
 20338	B72F	F6	40			    or #40
 20339	B731	D3	99			    out (#99), a                  ; VRAM address high + write mode
 20340	B733	AF				    xor a
 20341	B734	D3	98			    out (#98), a                  ; Write tile 0
 20342	B736	7D				    ld a, l                       ; HL += 32 (advance to next row)
 20343	B737	C6	20			    add a, 32
 20344	B739	6F				    ld l, a
 20345	B73A	30	01			    jr nc, .tcc_no_carry
 20346	B73C	24				    inc h
 20347	B73D					.tcc_no_carry:
 20348	B73D	10	EC			    djnz .tcc_row
 20349	B73F	FB				    ei
 20350	B740	E1				    pop hl
 20351	B741	D1				    pop de
 20352	B742	C1				    pop bc
 20353	B743	C9				    ret
 20354	B744					
 20355	B744					; ==================================================================
 20356	B744					; trans_clear_row_direct
 20357	B744					; Write tile 0 to all 32 columns of a single row in the Name Table
 20358	B744					; Input:  A = row (0-23)
 20359	B744					; Preserves: BC, DE, HL
 20360	B744					; ==================================================================
 20361	B744					trans_clear_row_direct:
 20362	B744	C5				    push bc
 20363	B745	D5				    push de
 20364	B746	E5				    push hl
 20365	B747					    ; HL = #1800 + row * 32
 20366	B747	6F				    ld l, a
 20367	B748	26	00			    ld h, 0
 20368	B74A	29				    add hl, hl                    ; *2
 20369	B74B	29				    add hl, hl                    ; *4
 20370	B74C	29				    add hl, hl                    ; *8
 20371	B74D	29				    add hl, hl                    ; *16
 20372	B74E	29				    add hl, hl                    ; *32
 20373	B74F	11	00	18		    ld de, #1800
 20374	B752	19				    add hl, de                    ; HL = name table row start
 20375	B753	F3				    di                            ; Protect VDP address+data from ISR corruption
 20376	B754	7D				    ld a, l
 20377	B755	D3	99			    out (#99), a                  ; VRAM address low
 20378	B757	7C				    ld a, h
 20379	B758	F6	40			    or #40
 20380	B75A	D3	99			    out (#99), a                  ; VRAM address high + write mode
 20381	B75C	06	20			    ld b, 32
 20382	B75E	AF				    xor a                         ; Tile 0
 20383	B75F					.tcrd_loop:
 20384	B75F	D3	98			    out (#98), a
 20385	B761	10	FC			    djnz .tcrd_loop
 20386	B763	FB				    ei
 20387	B764	E1				    pop hl
 20388	B765	D1				    pop de
 20389	B766	C1				    pop bc
 20390	B767	C9				    ret
 20391	B768					
 20392	B768					; ==================================================================
 20393	B768					; trans_fast_filvrm
 20394	B768					; Fill VRAM with a constant byte using direct port access
 20395	B768					; Input:  HL = VRAM destination address
 20396	B768					;         BC = byte count
 20397	B768					;         A  = fill value
 20398	B768					; Destroys: A, BC, E
 20399	B768					; ==================================================================
 20400	B768					trans_fast_filvrm:
 20401	B768	5F				    ld e, a                       ; Save fill byte
 20402	B769	F3				    di                            ; Protect VDP address+data from ISR corruption
 20403	B76A	7D				    ld a, l
 20404	B76B	D3	99			    out (#99), a                  ; VRAM address low
 20405	B76D	7C				    ld a, h
 20406	B76E	F6	40			    or #40
 20407	B770	D3	99			    out (#99), a                  ; VRAM address high + write mode
 20408	B772					.tff_loop:
 20409	B772	7B				    ld a, e
 20410	B773	D3	98			    out (#98), a                  ; Write byte to VRAM
 20411	B775	0B				    dec bc
 20412	B776	78				    ld a, b
 20413	B777	B1				    or c
