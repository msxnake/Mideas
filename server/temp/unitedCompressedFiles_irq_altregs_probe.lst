 5617	515F					; ------------------------------------------------------------------
 5618	515F					; wall_build_hitbox_cache
 5619	515F					; ------------------------------------------------------------------
 5620	515F					; Register Contract:
 5621	515F					;   Purpose: Compute and cache hitbox AABB and adaptive probe coordinates
 5622	515F					;            from entity position (wall_temp_x/y) plus collision offsets/sizes.
 5623	515F					;   Inputs:
 5624	515F					;     - DE                        = entity index (used to index per-entity arrays)
 5625	515F					;     - wall_temp_x               = cached entity X origin (set before calling)
 5626	515F					;     - wall_temp_y               = cached entity Y origin (set before calling)
 5627	515F					;     - entity_collision_hitbox_w[DE]: hitbox width  (0 treated as 1)
 5628	515F					;     - entity_collision_hitbox_h[DE]: hitbox height (0 treated as 1)
 5629	515F					;     - entity_collision_offset_x[DE]: signed X offset from entity origin to hitbox left
 5630	515F					;     - entity_collision_offset_y[DE]: signed Y offset from entity origin to hitbox top
 5631	515F					;   Outputs:
 5632	515F					;     - wall_hit_left   = hitbox left  pixel (entity_x + offset_x, clamped 0..255)
 5633	515F					;     - wall_hit_top    = hitbox top   pixel (entity_y + offset_y, clamped 0..255)
 5634	515F					;     - wall_hit_right  = left + (w-1), clamped 0..255
 5635	515F					;     - wall_hit_bottom = top  + (h-1), clamped 0..255
 5636	515F					;     - wall_hit_w      = effective width  (>= 1)
 5637	515F					;     - wall_hit_h      = effective height (>= 1)
 5638	515F					;     - wall_probe_left / wall_probe_right : X probes (inset up to 2px from sides)
 5639	515F					;     - wall_probe_top  / wall_probe_bottom: Y probes (inset up to 2px from top/bottom)
 5640	515F					;   Clobbers: AF, BC, HL
 5641	515F					;   Preserved: DE (entity index is never modified)
 5642	515F					;   Notes:
 5643	515F					;     - Adaptive inset: min(2, floor((right-left)/2)) and min(2, floor((bottom-top)/2)).
 5644	515F					;       Prevents corner-only probes for entities smaller than 4 pixels on an axis.
 5645	515F					;     - Call wall_add_signed_offset_clamped for offset application.
 5646	515F					;     - Called once at entity loop entry; called again after every position snap.
 5647	515F					; ------------------------------------------------------------------
 5648	515F					wall_build_hitbox_cache:
 5649	515F					    ; Width (minimum 1)
 5650	515F	21	3B	CF		    ld hl, entity_collision_hitbox_w
 5651	5162	19				    add hl, de
 5652	5163	7E				    ld a, (hl)
 5653	5164	B7				    or a
 5654	5165	20	02			    jr nz, .wbhc_w_ok
 5655	5167	3E	01			    ld a, 1
 5656	5169					.wbhc_w_ok:
 5657	5169	32	E1	D0		    ld (wall_hit_w), a
 5658	516C					
 5659	516C					    ; Height (minimum 1)
 5660	516C	21	5B	CF		    ld hl, entity_collision_hitbox_h
 5661	516F	19				    add hl, de
 5662	5170	7E				    ld a, (hl)
 5663	5171	B7				    or a
 5664	5172	20	02			    jr nz, .wbhc_h_ok
 5665	5174	3E	01			    ld a, 1
 5666	5176					.wbhc_h_ok:
 5667	5176	32	E2	D0		    ld (wall_hit_h), a
 5668	5179					
 5669	5179					    ; left = entity_x + offset_x (signed, clamped)
 5670	5179	3A	DB	D0		    ld a, (wall_temp_x)
 5671	517C	21	7B	CF		    ld hl, entity_collision_offset_x
 5672	517F	19				    add hl, de
 5673	5180	CD	EE	51		    call wall_add_signed_offset_clamped
 5674	5183	32	DD	D0		    ld (wall_hit_left), a
 5675	5186					
 5676	5186					    ; top = entity_y + offset_y (signed, clamped)
 5677	5186	3A	DC	D0		    ld a, (wall_temp_y)
 5678	5189	21	9B	CF		    ld hl, entity_collision_offset_y
 5679	518C	19				    add hl, de
 5680	518D	CD	EE	51		    call wall_add_signed_offset_clamped
 5681	5190	32	DE	D0		    ld (wall_hit_top), a
 5682	5193					
 5683	5193					    ; right = left + (w-1), clamped
 5684	5193	3A	E1	D0		    ld a, (wall_hit_w)
 5685	5196	3D				    dec a
 5686	5197	47				    ld b, a
 5687	5198	3A	DD	D0		    ld a, (wall_hit_left)
 5688	519B	80				    add a, b
 5689	519C	30	02			    jr nc, .wbhc_right_ok
 5690	519E	3E	FF			    ld a, 255
 5691	51A0					.wbhc_right_ok:
 5692	51A0	32	DF	D0		    ld (wall_hit_right), a
 5693	51A3					
 5694	51A3					    ; bottom = top + (h-1), clamped
 5695	51A3	3A	E2	D0		    ld a, (wall_hit_h)
 5696	51A6	3D				    dec a
 5697	51A7	47				    ld b, a
 5698	51A8	3A	DE	D0		    ld a, (wall_hit_top)
 5699	51AB	80				    add a, b
 5700	51AC	30	02			    jr nc, .wbhc_bottom_ok
 5701	51AE	3E	FF			    ld a, 255
 5702	51B0					.wbhc_bottom_ok:
 5703	51B0	32	E0	D0		    ld (wall_hit_bottom), a
 5704	51B3					
 5705	51B3					    ; ---- Adaptive X probes: inset = min(2, floor((right-left)/2)) ----
 5706	51B3					    ; Purpose: avoid probing the exact corner pixels for small sprites.
 5707	51B3					    ; For a 16px-wide entity: inset = min(2, 8) = 2.
 5708	51B3					    ;   probe_left  = left  + 2  (2px inside left edge)
 5709	51B3					    ;   probe_right = right - 2  (2px inside right edge)
 5710	51B3					    ; For a 4px-wide entity: inset = min(2, 2) = 2 (probes overlap at center).
 5711	51B3					    ; For a 2px-wide entity: inset = min(2, 1) = 1.
 5712	51B3	3A	DD	D0		    ld a, (wall_hit_left)
 5713	51B6	4F				    ld c, a                       ; C = left pixel
 5714	51B7	3A	DF	D0		    ld a, (wall_hit_right)
 5715	51BA	91				    sub c                         ; A = width span (right - left)
 5716	51BB	CB	3F			    srl a                         ; A = span / 2
 5717	51BD	FE	03			    cp 3                          ; is span/2 < 3 (i.e. inset < 2)?
 5718	51BF	38	02			    jr c, .wbhc_inset_x_ready    ; yes: use as-is
 5719	51C1	3E	02			    ld a, 2                       ; no: cap inset at 2
 5720	51C3					.wbhc_inset_x_ready:
 5721	51C3	47				    ld b, a                       ; B = inset value
 5722	51C4	79				    ld a, c
 5723	51C5	80				    add a, b
 5724	51C6	32	E3	D0		    ld (wall_probe_left), a       ; probe_left  = left  + inset
 5725	51C9	3A	DF	D0		    ld a, (wall_hit_right)
 5726	51CC	90				    sub b
 5727	51CD	32	E4	D0		    ld (wall_probe_right), a      ; probe_right = right - inset
 5728	51D0					
 5729	51D0					    ; ---- Adaptive Y probes: inset = min(2, floor((bottom-top)/2)) ----
 5730	51D0					    ; Same logic on Y axis.
 5731	51D0					    ;   probe_top    = top    + inset
 5732	51D0					    ;   probe_bottom = bottom - inset
 5733	51D0	3A	DE	D0		    ld a, (wall_hit_top)
 5734	51D3	4F				    ld c, a                       ; C = top pixel
 5735	51D4	3A	E0	D0		    ld a, (wall_hit_bottom)
 5736	51D7	91				    sub c                         ; A = height span (bottom - top)
 5737	51D8	CB	3F			    srl a                         ; A = span / 2
 5738	51DA	FE	03			    cp 3
 5739	51DC	38	02			    jr c, .wbhc_inset_y_ready
 5740	51DE	3E	02			    ld a, 2
 5741	51E0					.wbhc_inset_y_ready:
 5742	51E0	47				    ld b, a                       ; B = inset value
 5743	51E1	79				    ld a, c
 5744	51E2	80				    add a, b
 5745	51E3	32	E5	D0		    ld (wall_probe_top), a        ; probe_top    = top    + inset
 5746	51E6	3A	E0	D0		    ld a, (wall_hit_bottom)
 5747	51E9	90				    sub b
 5748	51EA	32	E6	D0		    ld (wall_probe_bottom), a     ; probe_bottom = bottom - inset
 5749	51ED	C9				    ret
 5750	51EE					
 5751	51EE					; ------------------------------------------------------------------
 5752	51EE					; wall_add_signed_offset_clamped
 5753	51EE					; ------------------------------------------------------------------
 5754	51EE					; Register Contract:
 5755	51EE					;   Purpose: Add a signed 8-bit offset to a pixel coordinate, clamping result to 0..255.
 5756	51EE					;            Used to apply entity_collision_offset_x/y to entity origin (entity?hitbox).
 5757	51EE					;   Inputs:
 5758	51EE					;     - A  = base pixel coordinate (unsigned, 0..255)
 5759	51EE					;     - HL = pointer to signed offset byte (-128..127)
 5760	51EE					;   Outputs:
 5761	51EE					;     - A  = clamp(base + offset, 0, 255)
 5762	51EE					;   Clobbers: AF, B
 5763	51EE					;   Preserved: C, DE, HL
 5764	51EE					;   Notes:
 5765	51EE					;     - Negative offset: carry=0 after add ? underflow ? A clamped to 0.
 5766	51EE					;     - Positive offset: carry=1 after add ? overflow ? A clamped to 255.
 5767	51EE					;     - B is used to hold the offset byte; caller must save B if needed.
 5768	51EE					; ------------------------------------------------------------------
 5769	51EE					wall_add_signed_offset_clamped:
 5770	51EE	46				    ld b, (hl)                    ; B = signed offset
 5771	51EF	80				    add a, b
 5772	51F0	CB	78			    bit 7, b
 5773	51F2	28	04			    jr z, .wasc_positive
 5774	51F4					    ; Negative offset: carry=0 means underflow
 5775	51F4	38	06			    jr c, .wasc_done
 5776	51F6	AF				    xor a
 5777	51F7	C9				    ret
 5778	51F8					.wasc_positive:
 5779	51F8					    ; Positive offset: carry=1 means overflow
 5780	51F8	30	02			    jr nc, .wasc_done
 5781	51FA	3E	FF			    ld a, 255
 5782	51FC					.wasc_done:
 5783	51FC	C9				    ret
 5784	51FD					
 5785	51FD					; ------------------------------------------------------------------
 5786	51FD					; wall_sub_signed_offset_clamped
 5787	51FD					; ------------------------------------------------------------------
 5788	51FD					; Register Contract:
 5789	51FD					;   Purpose: Subtract a signed 8-bit offset from a hitbox coordinate, clamping to 0..255.
 5790	51FD					;            Used to convert hitbox left/top back to entity origin after a snap.
 5791	51FD					;            Inverse of wall_add_signed_offset_clamped.
 5792	51FD					;   Inputs:
 5793	51FD					;     - A  = hitbox pixel coordinate (left or top, unsigned 0..255)
 5794	51FD					;     - HL = pointer to signed collision offset byte (-128..127)
 5795	51FD					;            (same pointer passed to wall_add_signed_offset_clamped when building)
 5796	51FD					;   Outputs:
 5797	51FD					;     - A  = clamp(hitbox - offset, 0, 255)
 5798	51FD					;            i.e. the entity origin coordinate that produces the snapped hitbox edge
 5799	51FD					;   Clobbers: AF, B, C
 5800	51FD					;   Preserved: DE, HL
 5801	51FD					;   Notes:
 5802	51FD					;     - If offset is negative: hitbox - offset = hitbox + abs(offset).
 5803	51FD					;       Overflow (carry clear after add) ? A clamped to 255.
 5804	51FD					;     - If offset is positive: hitbox - offset computed directly.
 5805	51FD					;       Underflow (carry clear after sub) ? A clamped to 0.
 5806	51FD					;     - B holds the raw offset byte; C holds the original hitbox coordinate.
 5807	51FD					; ------------------------------------------------------------------
 5808	51FD					wall_sub_signed_offset_clamped:
 5809	51FD	4F				    ld c, a
 5810	51FE	46				    ld b, (hl)                    ; B = signed offset
 5811	51FF	CB	78			    bit 7, b
 5812	5201	28	09			    jr z, .wssc_positive
 5813	5203					    ; offset < 0 -> hitbox - offset = hitbox + abs(offset)
 5814	5203	78				    ld a, b
 5815	5204	ED	44			    neg
 5816	5206	81				    add a, c
 5817	5207	30	08			    jr nc, .wssc_done
 5818	5209	3E	FF			    ld a, 255
 5819	520B	C9				    ret
 5820	520C					.wssc_positive:
 5821	520C	79				    ld a, c
 5822	520D	90				    sub b
 5823	520E	30	01			    jr nc, .wssc_done
 5824	5210	AF				    xor a
 5825	5211					.wssc_done:
 5826	5211	C9				    ret
