 6471	5545					; ------------------------------------------------------------------
 6472	5545					; apply_collected_tiles
 6473	5545					; Re-clears tiles that were previously collected on the current world/screen.
 6474	5545					; Called after every screen load so collected tiles do not respawn.
 6475	5545					; Input:  current_world_id and current_screen_id must already be set.
 6476	5545					; Output: None
 6477	5545					; Destroys: AF, BC, DE, HL
 6478	5545					; ------------------------------------------------------------------
 6479	5545					apply_collected_tiles:
 6480	5545	3A	D0	CB		    ld a, (collected_count)
 6481	5548	B7				    or a
 6482	5549	C8				    ret z                          ; Nothing collected yet - return early
 6483	554A					
 6484	554A	47				    ld b, a                        ; B = djnz counter (total collected entries)
 6485	554B	0E	00			    ld c, 0                        ; C = loop index
 6486	554D					.apply_ct_loop:
 6487	554D					    ; DE = (0, index) used for all three table lookups.
 6488	554D					    ; add hl, de does NOT modify DE, so we can reuse it for all 3 tables.
 6489	554D	16	00			    ld d, 0
 6490	554F	59				    ld e, c                        ; DE = (0, current index)
 6491	5550					
 6492	5550					    ; Check if this entry belongs to current world
 6493	5550	21	D1	CB		    ld hl, collected_world
 6494	5553	19				    add hl, de                     ; HL = &collected_world[index]
 6495	5554	3A	C5	CB		    ld a, (current_world_id)       ; A = world currently loaded
 6496	5557	BE				    cp (hl)                        ; Compare with stored world ID
 6497	5558	20	2A			    jr nz, .apply_ct_skip          ; Different world - skip
 6498	555A					
 6499	555A					    ; Check if this entry belongs to current screen
 6500	555A	21	11	CC		    ld hl, collected_screen
 6501	555D	19				    add hl, de                     ; HL = &collected_screen[index]
 6502	555E	3A	C2	CB		    ld a, (current_screen_id)      ; A = screen currently loaded
 6503	5561	BE				    cp (hl)                        ; Compare with stored screen ID
 6504	5562	20	20			    jr nz, .apply_ct_skip          ; Different screen - skip
 6505	5564					
 6506	5564					    ; Entry matches current screen: re-clear this tile
 6507	5564	C5				    push bc                        ; Save B=count, C=index across FAST_WRTVRM
 6508	5565					
 6509	5565					    ; Build tile index: D = idx_h, E = idx_l
 6510	5565					    ; (DE is still (0, index) because add hl, de never modifies DE)
 6511	5565	21	51	CC		    ld hl, collected_idx_l
 6512	5568	19				    add hl, de                     ; HL = &collected_idx_l[index]
 6513	5569	7E				    ld a, (hl)
 6514	556A	F5				    push af                        ; Save idx_l on stack
 6515	556B					
 6516	556B	21	91	CC		    ld hl, collected_idx_h
 6517	556E	19				    add hl, de                     ; HL = &collected_idx_h[index], DE still (0, index)
 6518	556F	7E				    ld a, (hl)
 6519	5570	57				    ld d, a                        ; D = idx_h
 6520	5571					
 6521	5571	F1				    pop af                         ; A = idx_l
 6522	5572	5F				    ld e, a                        ; E = idx_l
 6523	5573					    ; DE = tile index (D=high, E=low)
 6524	5573					
 6525	5573					    ; Re-clear runtime_behavior_map[idx]
 6526	5573	D5				    push de                        ; Save idx
 6527	5574	21	29	C3		    ld hl, runtime_behavior_map
 6528	5577	19				    add hl, de
 6529	5578	36	00			    ld (hl), 0
