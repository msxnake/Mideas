 4824	4E37	77				        ld (hl), a                    ; Store decremented value
 4825	4E38					
 4826	4E38					        ; Check if lifetime reached 0
 4827	4E38	B7				        or a
 4828	4E39	20	20			        jr nz, auto_destroy_done      ; Still alive
 4829	4E3B					
 4830	4E3B					        ; Lifetime expired - destroy entity
 4831	4E3B					        ; Clear component masks (deactivates entity)
 4832	4E3B	21	20	C7		        ld hl, entity_comp_masks
 4833	4E3E	59				        ld e, c
 4834	4E3F	16	00			        ld d, 0
 4835	4E41	19				        add hl, de
 4836	4E42	36	00			        ld (hl), 0                    ; Clear low byte
