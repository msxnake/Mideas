 5524	5106					.wall_down_blocked:
 5525	5106					    ; ---------------------------------------------------------------
 5526	5106					    ; Snap formula (DOWN / floor):
 5527	5106					    ;   B = tile row that blocked us (from (bottom+1)/8 probe)
 5528	5106					    ;   floor_top_pixel  = B * 8          ? top pixel of the floor tile
 5529	5106					    ;   new_hitbox_top   = B*8 - hitbox_h ? push entity up so bottom edge
 5530	5106					    ;                                       just sits on the floor surface
 5531	5106					    ;   If underflow (hitbox_h > B*8): clamp new_hitbox_top to 0.
 5532	5106					    ;   entity_y = new_hitbox_top - collision_offset_y
 5533	5106					    ; After snap: vel_y = 0, gravity_vel = 0, entity_on_ground bit 0 set,
 5534	5106					    ;             entity_wall_collision_flags bit 1 (DOWN) set.
 5535	5106					    ; Note: jp .wall_next skips .check_wall_y_gravity intentionally —
 5536	5106					    ;       floor already detected; no redundant gravity probe needed.
 5537	5106					    ; ---------------------------------------------------------------
 5538	5106	78				    ld a, b
 5539	5107	87				    add a, a
 5540	5108	87				    add a, a
 5541	5109	87				    add a, a                      ; A = B*8 = top pixel of floor tile
 5542	510A	47				    ld b, a                       ; B = floor_top_pixel
 5543	510B	3A	E2	D0		    ld a, (wall_hit_h)
 5544	510E	4F				    ld c, a                       ; C = hitbox height
 5545	510F	78				    ld a, b
 5546	5110	91				    sub c                         ; A = B*8 - hitbox_h = new hitbox top
 5547	5111	30	01			    jr nc, .wall_down_top_ok
 5548	5113	AF				    xor a                         ; underflow: clamp to 0
 5549	5114					.wall_down_top_ok:
 5550	5114	F5				    push af                       ; save new hitbox top
