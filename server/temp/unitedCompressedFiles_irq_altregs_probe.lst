 5590	514D					.check_wall_y_gravity:
 5591	514D					    ; ---------------------------------------------------------------
 5592	514D					    ; vel_y == 0, but gravity entities still need a floor probe every
 5593	514D					    ; frame to keep entity_on_ground accurate (e.g. entity walks off
 5594	514D					    ; a platform edge — vel_y is 0 at that instant but the flag must
 5595	514D					    ; be cleared promptly so the gravity system can accelerate it).
 5596	514D					    ; Only enter .wall_check_down if entity has COMP_MASK_GRAVITY
 5597	514D					    ; (stored in entity_comp_masks_hi bit 1).
 5598	514D					    ; Non-gravity entities: skip vertical check entirely.
