 12093	72FE					; ------------------------------------------------------------------
 12094	72FE					; music_execute_command
 12095	72FE					; Dispatch a music command from Game Flow nodes.
 12096	72FE					; Input:  DE -> [command, trackIndex, loopFlag]
 12097	72FE					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 12098	72FE					; Destroys: AF, BC (play path), DE (play path), HL
 12099	72FE					; ------------------------------------------------------------------
 12100	72FE					music_execute_command:
 12101	72FE	1A				    ld a, (de)
 12102	72FF	FE	FF			    cp #FF
 12103	7301	C8				    ret z
 12104	7302	B7				    or a
 12105	7303	CA	D9	72		    jp z, music_stop
 12106	7306	FE	01			    cp 1
 12107	7308	CA	16	73		    jp z, .pt3_exec_play
 12108	730B	FE	02			    cp 2
 12109	730D	CA	E6	72		    jp z, music_mute
 12110	7310	FE	03			    cp 3
 12111	7312	CA	F4	72		    jp z, music_resume
 12112	7315	C9				    ret
 12113	7316					.pt3_exec_play:
 12114	7316	13				    inc de
 12115	7317	1A				    ld a, (de)
 12116	7318	4F				    ld c, a
 12117	7319	13				    inc de
 12118	731A	1A				    ld a, (de)
 12119	731B	47				    ld b, a
 12120	731C	79				    ld a, c
 12121	731D	CD	21	73		    call music_play_track
 12122	7320	C9				    ret
