 302	40B3					LDIRMV  EQU #0059        ; Block transfer from VRAM to CPU
 303	40B3					WRTVDP  EQU #0047        ; Write to VDP register
 304	40B3					WRTVRM  EQU #004D        ; Write data to VRAM (A=data, HL=address)
