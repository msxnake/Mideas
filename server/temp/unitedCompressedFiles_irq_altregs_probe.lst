 1424	4145					; MAPPER RUNTIME API
 1425	4145					; File: mapper.asm
 1426	4145					; Description: Minimal compatibility stubs for simple32k builds
 1427	4145					; Target mapper: konami
 1428	4145					; ROM mode: simple32k (autoMegaROM=false)
 1429	4145					; ==================================================================
 1430	4145					;
 1431	4145					; This build runs in simple32k mode, so bank switching is not active.
 1432	4145					; Keep mapper API labels as no-op stubs so generated gameplay code can
 1433	4145					; call the same routines without conditional assembly branches.
 1434	4145					
 1435	4145					; ------------------------------------------------------------------
 1436	4145					; mapper_runtime_init
 1437	4145					; Initializes runtime mirrors only (no hardware mapper writes).
 1438	4145					; ------------------------------------------------------------------
 1439	4145					mapper_runtime_init:
 1440	4145	AF				    xor a
 1441	4146	32	14	C0		    ld (mapper_bank_p1_current), a
 1442	4149	3E	01			    ld a, 1
 1443	414B	32	15	C0		    ld (mapper_bank_p2_current), a
 1444	414E	3E	02			    ld a, 2
 1445	4150	32	16	C0		    ld (mapper_bank_p3_current), a
 1446	4153	3E	03			    ld a, 3
 1447	4155	32	17	C0		    ld (mapper_bank_p4_current), a
 1448	4158	C9				    ret
 1449	4159					
 1450	4159					; ------------------------------------------------------------------
 1451	4159					; API: mapper_set_bank_pX
 1452	4159					; Input: A = bank number (stored only for compatibility)
 1453	4159					; ------------------------------------------------------------------
 1454	4159					mapper_set_bank_p1:
 1455	4159	32	14	C0		    ld (mapper_bank_p1_current), a
 1456	415C	C9				    ret
 1457	415D					
 1458	415D					mapper_set_bank_p2:
 1459	415D	32	15	C0		    ld (mapper_bank_p2_current), a
 1460	4160	C9				    ret
 1461	4161					
 1462	4161					mapper_set_bank_p3:
 1463	4161	32	16	C0		    ld (mapper_bank_p3_current), a
 1464	4164	C9				    ret
 1465	4165					
 1466	4165					mapper_set_bank_p4:
 1467	4165	32	17	C0		    ld (mapper_bank_p4_current), a
 1468	4168	C9				    ret
 1469	4169					
 1470	4169					; ------------------------------------------------------------------
 1471	4169					; Save/restore helpers (compatibility only).
 1472	4169					; ------------------------------------------------------------------
 1473	4169					mapper_push_p1:
 1474	4169	3A	14	C0		    ld a, (mapper_bank_p1_current)
 1475	416C	32	19	C0		    ld (mapper_saved_bank_p1), a
 1476	416F	C9				    ret
 1477	4170					
 1478	4170					mapper_pop_p1:
 1479	4170	3A	19	C0		    ld a, (mapper_saved_bank_p1)
 1480	4173	C3	59	41		    jp mapper_set_bank_p1
 1481	4176					
 1482	4176					mapper_push_p2:
 1483	4176	3A	15	C0		    ld a, (mapper_bank_p2_current)
 1484	4179	32	18	C0		    ld (mapper_saved_bank), a
 1485	417C	C9				    ret
 1486	417D					
 1487	417D					mapper_pop_p2:
 1488	417D	3A	18	C0		    ld a, (mapper_saved_bank)
 1489	4180	C3	5D	41		    jp mapper_set_bank_p2
 1490	4183					
