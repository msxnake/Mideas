  83	4010					; ==================================================================
  84	4010					init_rom:
  85	4010	F3				    di
  86	4011	ED	56			    im 1
  87	4013					    
  88	4013					    ; Initialize stack
  89	4013	31	80	F3		    ld sp, #F380
  90	4016					
  91	4016					    ; Cold boot path: ensure cartridge pages are mapped.
  92	4016	CD	82	40		    call SETPAGES32K
  93	4019	C3	22	40		    jp restart_rom_continue
  94	401C					
  95	401C					; Restart entry point for GameFlow Restart node.
  96	401C					; Reinitializes runtime safely without remapping cartridge pages.
  97	401C					restart_rom:
  98	401C	F3				    di
  99	401D	ED	56			    im 1
