 11248	7036					; ------------------------------------------------------------------
 11249	7036					; hud_ascii_to_tile
 11250	7036					; Convert ASCII character to tile index for font rendering
 11251	7036					; Input: A = ASCII character
 11252	7036					; Output: A = Tile index (ASCII code for direct mapping)
 11253	7036					; ------------------------------------------------------------------
 11254	7036					hud_ascii_to_tile:
 11255	7036					    ; SIMPLIFIED: Just return the ASCII code directly
 11256	7036					    ; Font patterns are loaded at their ASCII positions
 11257	7036					    
 11258	7036					    ; Validate range (printable ASCII 32-126)
 11259	7036	FE	20			    cp 32
 11260	7038	D0				    ret nc              ; If >= 32, it's valid - return as-is
 11261	7039					    
 11262	7039					    ; Below 32 (control characters) - default to space
 11263	7039	3E	20			    ld a, 32            ; Space character
 11264	703B	C9				    ret
 11265	703C					
 11266	703C					; ------------------------------------------------------------------
 11267	703C					; hud_draw_frame
 11268	703C					; Draw a rectangular frame using font characters
 11269	703C					; Input: D = Tile X, E = Tile Y, B = Width (tiles), C = Height (tiles)
 11270	703C					; Uses characters: 43 (+), 45 (-), 124 (|)
 11271	703C					; ------------------------------------------------------------------
 11272	703C					hud_draw_frame:
 11273	703C	F5				    push af
 11274	703D	C5				    push bc
 11275	703E	D5				    push de
 11276	703F	E5				    push hl
 11277	7040					    
 11278	7040					    ; Calculate VRAM Start Address
 11279	7040					    ; Addr = #1800 + (E * 32) + D
 11280	7040	6B				    ld l, e
 11281	7041	26	00			    ld h, 0
 11282	7043	29				    add hl, hl          ; * 2
 11283	7044	29				    add hl, hl          ; * 4
 11284	7045	29				    add hl, hl          ; * 8
 11285	7046	29				    add hl, hl          ; * 16
 11286	7047	29				    add hl, hl          ; * 32
 11287	7048					    
 11288	7048	5A				    ld e, d
 11289	7049	16	00			    ld d, 0
 11290	704B	19				    add hl, de
 11291	704C	11	00	18		    ld de, #1800
 11292	704F	19				    add hl, de          ; HL = Top-Left Corner VRAM Address
 11293	7050					    
 11294	7050					    ; Draw Top Row
 11295	7050	E5				    push hl             ; Save Start Address
 11296	7051	C5				    push bc             ; Save Dimensions
 11297	7052					    
 11298	7052					    ; Top-Left Corner
 11299	7052	3E	2B			    ld a, 43            ; '+'
 11300	7054	CD	CE	40		    call FAST_WRTVRM
 11301	7057	23				    inc hl
 11302	7058					    
 11303	7058					    ; Top Edge
 11304	7058	78				    ld a, b
 11305	7059	D6	02			    sub 2               ; Width - 2 corners
 11306	705B	28	0B			    jr z, .skip_top_edge ; Skip if exactly 2 wide (no edge)
 11307	705D	38	09			    jr c, .skip_top_edge ; Skip if < 2 wide
 11308	705F	47				    ld b, a
 11309	7060					.top_edge_loop:
 11310	7060	3E	2D			    ld a, 45            ; '-'
 11311	7062	CD	CE	40		    call FAST_WRTVRM
 11312	7065	23				    inc hl
 11313	7066	10	F8			    djnz .top_edge_loop
 11314	7068					.skip_top_edge:
 11315	7068					    
 11316	7068					    ; Top-Right Corner
 11317	7068	3E	2B			    ld a, 43            ; '+'
 11318	706A	CD	CE	40		    call FAST_WRTVRM
 11319	706D					    
 11320	706D	C1				    pop bc              ; Restore Dimensions
 11321	706E	E1				    pop hl              ; Restore Start Address
 11322	706F					    
 11323	706F					    ; Move to next row
 11324	706F	11	20	00		    ld de, 32
 11325	7072	19				    add hl, de
 11326	7073					    
 11327	7073					    ; Draw Middle Rows (Vertical Edges)
 11328	7073	79				    ld a, c
 11329	7074	D6	02			    sub 2               ; Height - 2 rows
 11330	7076	28	1E			    jr z, .bottom_row   ; Skip if height is small
 11331	7078	38	1C			    jr c, .bottom_row   ; Skip if height is < 2
 11332	707A	4F				    ld c, a             ; C = Middle Rows count
 11333	707B					    
 11334	707B					.middle_row_loop:
 11335	707B	E5				    push hl             ; Save Row Start
 11336	707C	C5				    push bc             ; Save Counters
 11337	707D					    
 11338	707D					    ; Left Edge
 11339	707D	3E	7C			    ld a, 124           ; '|'
 11340	707F	CD	CE	40		    call FAST_WRTVRM
 11341	7082					    
 11342	7082					    ; Skip Middle (Content Area)
 11343	7082	78				    ld a, b
 11344	7083	3D				    dec a               ; Width - 1
 11345	7084					    ; Ensure we don't add negative offset if width is 0 (unlikely here but safe)
 11346	7084					    ; Actually Width must be at least 2 to have corners, so Width-1 >= 1.
 11347	7084	5F				    ld e, a
 11348	7085	16	00			    ld d, 0
 11349	7087	19				    add hl, de
 11350	7088					    
 11351	7088					    ; Right Edge
 11352	7088	3E	7C			    ld a, 124           ; '|'
 11353	708A	CD	CE	40		    call FAST_WRTVRM
 11354	708D					    
 11355	708D	C1				    pop bc              ; Restore Counters
 11356	708E	E1				    pop hl              ; Restore Row Start
 11357	708F					    
 11358	708F	11	20	00		    ld de, 32
 11359	7092	19				    add hl, de          ; Next Row
 11360	7093	0D				    dec c
 11361	7094	20	E5			    jr nz, .middle_row_loop
 11362	7096					    
 11363	7096					.bottom_row:
 11364	7096					    ; Draw Bottom Row
 11365	7096					    ; Bottom-Left Corner
 11366	7096	3E	2B			    ld a, 43            ; '+'
 11367	7098	CD	CE	40		    call FAST_WRTVRM
 11368	709B	23				    inc hl
 11369	709C					    
 11370	709C					    ; Bottom Edge
 11371	709C	78				    ld a, b
 11372	709D	D6	02			    sub 2               ; Width - 2 corners
 11373	709F	28	0B			    jr z, .skip_bottom_edge
 11374	70A1	38	09			    jr c, .skip_bottom_edge
 11375	70A3	47				    ld b, a
 11376	70A4					.bottom_edge_loop:
 11377	70A4	3E	2D			    ld a, 45            ; '-'
 11378	70A6	CD	CE	40		    call FAST_WRTVRM
 11379	70A9	23				    inc hl
 11380	70AA	10	F8			    djnz .bottom_edge_loop
 11381	70AC					.skip_bottom_edge:
 11382	70AC					    
 11383	70AC					    ; Bottom-Right Corner
 11384	70AC	3E	2B			    ld a, 43            ; '+'
 11385	70AE	CD	CE	40		    call FAST_WRTVRM
 11386	70B1					    
 11387	70B1	E1				    pop hl
 11388	70B2	D1				    pop de
 11389	70B3	C1				    pop bc
 11390	70B4	F1				    pop af
 11391	70B5	C9				    ret
 11392	70B6					
 11393	70B6					; ------------------------------------------------------------------
 11394	70B6					; update_hud_score
 11395	70B6					; Update score HUD element with current score value
 11396	70B6					; Input: HL = Score value (16-bit binary, 0-65535)
 11397	70B6					; Writes score digits directly into the HUD numeric field in VRAM
 11398	70B6					; Output:
 11399	70B6					;   None
 11400	70B6					; Clobbers:
 11401	70B6					;   None visible to caller
 11402	70B6					; Preserves:
 11403	70B6					;   AF, BC, DE, HL
 11404	70B6					; Notes:
 11405	70B6					;   - Uses BC internally for decimal divisors
 11406	70B6					;   - Uses DE internally as VRAM cursor for the numeric field
 11407	70B6					;   - Writes only the numeric digits; the static "SCORE: " label is not touched
 11408	70B6					; ------------------------------------------------------------------
 11409	70B6					update_hud_score:
 11410	70B6	F5				    push af
 11411	70B7	C5				    push bc
 11412	70B8	D5				    push de
 11413	70B9	E5				    push hl
 11414	70BA					
 11415	70BA					    ; Direct VRAM update of the numeric HUD field.
 11416	70BA					    ; Static label ("SCORE: ") stays in ROM; only digits are rewritten.
 11417	70BA	11	28	18		    ld de, #1828
 11418	70BD					
 11419	70BD					    ; Leading digit 0: forced zero (Score is 16-bit max 65535)
 11420	70BD	3E	30			    ld a, '0'
 11421	70BF	E5				    push hl
 11422	70C0	62				    ld h, d
 11423	70C1	6B				    ld l, e
 11424	70C2	CD	CE	40		    call FAST_WRTVRM
 11425	70C5	E1				    pop hl
 11426	70C6	13				    inc de
 11427	70C7					    ; Runtime digit 0: / 10000
 11428	70C7	01	10	27		    ld bc, 10000
 11429	70CA	CD	16	71		    call .div16
 11430	70CD	C6	30			    add a, '0'
 11431	70CF	E5				    push hl
 11432	70D0	62				    ld h, d
 11433	70D1	6B				    ld l, e
 11434	70D2	CD	CE	40		    call FAST_WRTVRM
 11435	70D5	E1				    pop hl
 11436	70D6	13				    inc de
 11437	70D7					    ; Runtime digit 1: / 1000
 11438	70D7	01	E8	03		    ld bc, 1000
 11439	70DA	CD	16	71		    call .div16
 11440	70DD	C6	30			    add a, '0'
 11441	70DF	E5				    push hl
 11442	70E0	62				    ld h, d
 11443	70E1	6B				    ld l, e
 11444	70E2	CD	CE	40		    call FAST_WRTVRM
 11445	70E5	E1				    pop hl
 11446	70E6	13				    inc de
 11447	70E7					    ; Runtime digit 2: / 100
 11448	70E7	01	64	00		    ld bc, 100
 11449	70EA	CD	16	71		    call .div16
 11450	70ED	C6	30			    add a, '0'
 11451	70EF	E5				    push hl
 11452	70F0	62				    ld h, d
 11453	70F1	6B				    ld l, e
 11454	70F2	CD	CE	40		    call FAST_WRTVRM
 11455	70F5	E1				    pop hl
 11456	70F6	13				    inc de
 11457	70F7					    ; Runtime digit 3: / 10
 11458	70F7	01	0A	00		    ld bc, 10
 11459	70FA	CD	16	71		    call .div16
 11460	70FD	C6	30			    add a, '0'
 11461	70FF	E5				    push hl
 11462	7100	62				    ld h, d
 11463	7101	6B				    ld l, e
 11464	7102	CD	CE	40		    call FAST_WRTVRM
 11465	7105	E1				    pop hl
 11466	7106	13				    inc de
 11467	7107					    ; Final digit: ones (remainder)
 11468	7107	7D				    ld a, l
 11469	7108	C6	30			    add a, '0'
 11470	710A	E5				    push hl
 11471	710B	62				    ld h, d
 11472	710C	6B				    ld l, e
 11473	710D	CD	CE	40		    call FAST_WRTVRM
 11474	7110	E1				    pop hl
 11475	7111					
 11476	7111	E1				    pop hl
 11477	7112	D1				    pop de
 11478	7113	C1				    pop bc
 11479	7114	F1				    pop af
 11480	7115	C9				    ret
 11481	7116					
 11482	7116					; Helper: HL = HL / BC, A = quotient, HL = remainder
 11483	7116					.div16:
 11484	7116	AF				    xor a                       ; Quotient = 0
 11485	7117					.div16_loop:
 11486	7117	B7				    or a                        ; Clear carry
 11487	7118	ED	42			    sbc hl, bc                  ; HL -= BC
 11488	711A	38	03			    jr c, .div16_done           ; If underflow, done
 11489	711C	3C				    inc a                       ; Quotient++
 11490	711D	18	F8			    jr .div16_loop
 11491	711F					.div16_done:
 11492	711F	09				    add hl, bc                  ; Restore remainder
 11493	7120	C9				    ret
 11494	7121					
 11495	7121					; ------------------------------------------------------------------
 11496	7121					; update_hud_lives
 11497	7121					; Update lives HUD element
 11498	7121					; Input: A = Number of lives (0-9)
 11499	7121					; Output:
 11500	7121					;   None
 11501	7121					; Clobbers:
 11502	7121					;   None visible to caller
 11503	7121					; Preserves:
 11504	7121					;   AF, HL
 11505	7121					; Notes:
 11506	7121					;   - Writes only the numeric digit in VRAM; the static label is not touched
 11507	7121					; ------------------------------------------------------------------
 11508	7121					update_hud_lives:
 11509	7121	F5				    push af
 11510	7122	E5				    push hl
 11511	7123					
 11512	7123					    ; Direct VRAM update of the Lives numeric field.
 11513	7123	C6	30			    add a, '0'                  ; Convert to ASCII
 11514	7125	21	36	18		    ld hl, #1836
 11515	7128	CD	CE	40		    call FAST_WRTVRM
 11516	712B					
 11517	712B	E1				    pop hl
 11518	712C	F1				    pop af
 11519	712D	C9				    ret
 11520	712E					
 11521	712E					
 11522	712E					
 11523	712E					; ==================================================================
 11524	712E					; PSG SOUND SYSTEM
 11525	712E					; File: sound.asm
 11526	712E					; Description: AY-3-8910 PSG control and sound effects
 11527	712E					; ==================================================================
 11528	712E					
 11529	712E					; ==================================================================
 11530	712E					; PSG REGISTER ADDRESSES
 11531	712E					; ==================================================================
 11532	712E					
 11533	712E					; Tone Generators (Channels A, B, C)
 11534	712E					PSG_TONE_A_LO       EQU 0        ; Channel A period low byte
 11535	712E					PSG_TONE_A_HI       EQU 1        ; Channel A period high byte (4 bits)
 11536	712E					PSG_TONE_B_LO       EQU 2        ; Channel B period low byte
 11537	712E					PSG_TONE_B_HI       EQU 3        ; Channel B period high byte (4 bits)
 11538	712E					PSG_TONE_C_LO       EQU 4        ; Channel C period low byte
 11539	712E					PSG_TONE_C_HI       EQU 5        ; Channel C period high byte (4 bits)
 11540	712E					
 11541	712E					; Noise Generator
 11542	712E					PSG_NOISE_PERIOD    EQU 6        ; Noise period (5 bits)
 11543	712E					
 11544	712E					; Mixer Control
 11545	712E					PSG_MIXER           EQU 7        ; Mixer/Enable register
 11546	712E					; Bit 0: Channel A tone enable (0=on, 1=off)
 11547	712E					; Bit 1: Channel B tone enable
 11548	712E					; Bit 2: Channel C tone enable
 11549	712E					; Bit 3: Channel A noise enable (0=on, 1=off)
 11550	712E					; Bit 4: Channel B noise enable
 11551	712E					; Bit 5: Channel C noise enable
 11552	712E					
 11553	712E					; Volume Control
 11554	712E					PSG_VOL_A           EQU 8        ; Channel A volume (4 bits) + envelope flag (bit 4)
 11555	712E					PSG_VOL_B           EQU 9        ; Channel B volume
 11556	712E					PSG_VOL_C           EQU 10       ; Channel C volume
 11557	712E					
 11558	712E					; Envelope Generator
 11559	712E					PSG_ENV_LO          EQU 11       ; Envelope period low byte
 11560	712E					PSG_ENV_HI          EQU 12       ; Envelope period high byte
 11561	712E					PSG_ENV_SHAPE       EQU 13       ; Envelope shape (4 bits)
 11562	712E					
 11563	712E					; ==================================================================
 11564	712E					; PSG TONE PERIODS (Musical notes, octave 4, 3.579545 MHz clock)
 11565	712E					; ==================================================================
 11566	712E					
 11567	712E					; Note frequencies for octave 4 (middle C = C4)
 11568	712E					NOTE_C4         EQU 477      ; C  - 261.63 Hz
 11569	712E					NOTE_CS4        EQU 450      ; C# - 277.18 Hz
 11570	712E					NOTE_D4         EQU 425      ; D  - 293.66 Hz
 11571	712E					NOTE_DS4        EQU 401      ; D# - 311.13 Hz
 11572	712E					NOTE_E4         EQU 379      ; E  - 329.63 Hz
 11573	712E					NOTE_F4         EQU 357      ; F  - 349.23 Hz
 11574	712E					NOTE_FS4        EQU 337      ; F# - 369.99 Hz
 11575	712E					NOTE_G4         EQU 318      ; G  - 392.00 Hz
 11576	712E					NOTE_GS4        EQU 300      ; G# - 415.30 Hz
 11577	712E					NOTE_A4         EQU 284      ; A  - 440.00 Hz
 11578	712E					NOTE_AS4        EQU 268      ; A# - 466.16 Hz
 11579	712E					NOTE_B4         EQU 253      ; B  - 493.88 Hz
 11580	712E					NOTE_C5         EQU 238      ; C5 - 523.25 Hz
 11581	712E					
 11582	712E					; Octave multipliers: Divide period by 2 for +1 octave, multiply by 2 for -1 octave
 11583	712E					
 11584	712E					; ==================================================================
 11585	712E					; SOUND EFFECT DURATIONS (in frames, 60Hz)
 11586	712E					; ==================================================================
 11587	712E					
 11588	712E					SFX_SHORT           EQU 5        ; ~83ms
 11589	712E					SFX_MEDIUM          EQU 15       ; ~250ms
 11590	712E					SFX_LONG            EQU 30       ; ~500ms
 11591	712E					
 11592	712E					; ==================================================================
 11593	712E					; SOUND SYSTEM INITIALIZATION
 11594	712E					; ==================================================================
 11595	712E					
 11596	712E					init_sound_system:
 11597	712E					    ; Initialize PSG via BIOS
 11598	712E	CD	90	00		    call GICINI
 11599	7131					
 11600	7131					    ; Clear runtime sound state so power-on RAM garbage cannot make
 11601	7131					    ; sfx_update / SM_UpdateSound drive the PSG for a few random frames.
 11602	7131	AF				    xor a
 11603	7132	32	B8	CD		    ld (sfx_active), a
 11604	7135	32	B9	CD		    ld (sfx_timer), a
 11605	7138	32	BA	CD		    ld (sfx_fadeout), a
 11606	713B	32	49	D1		    ld (sm_sound_active), a
 11607	713E	32	4A	D1		    ld (sm_sound_frames_left), a
 11608	7141	32	4B	D1		    ld (sm_sound_ptr_l), a
 11609	7144	32	4C	D1		    ld (sm_sound_ptr_h), a
 11610	7147	CD	AD	72		    call music_init_system
 11611	714A					
 11612	714A					    ; Silence all channels
 11613	714A	CD	91	71		    call sfx_silence_all
 11614	714D					
 11615	714D	C9				    ret
 11616	714E					
 11617	714E					; ==================================================================
 11618	714E					; PSG LOW-LEVEL CONTROL FUNCTIONS
 11619	714E					; ==================================================================
 11620	714E					
 11621	714E					; ------------------------------------------------------------------
 11622	714E					; psg_write
 11623	714E					; Write to PSG register via BIOS
 11624	714E					; Input:  A = Register number (0-13)
 11625	714E					;         E = Value to write
 11626	714E					; Destroys: AF, E
 11627	714E					; ------------------------------------------------------------------
 11628	714E					psg_write:
 11629	714E	CD	93	00		    call WRTPSG
 11630	7151	C9				    ret
 11631	7152					
 11632	7152					; ------------------------------------------------------------------
 11633	7152					; psg_set_tone
 11634	7152					; Set tone period for a channel
 11635	7152					; Input:  A = Channel (0=A, 1=B, 2=C)
 11636	7152					;         HL = Tone period (12-bit value)
 11637	7152					; Destroys: AF, BC, DE, HL
 11638	7152					; ------------------------------------------------------------------
 11639	7152					psg_set_tone:
 11640	7152					    ; Calculate register numbers (A*2 for low, A*2+1 for high)
 11641	7152	87				    add a, a                     ; A = channel * 2
 11642	7153	4F				    ld c, a                      ; C = low register number
 11643	7154	3C				    inc a
 11644	7155	47				    ld b, a                      ; B = high register number
 11645	7156					
 11646	7156					    ; Write low byte
 11647	7156	79				    ld a, c
 11648	7157	5D				    ld e, l
 11649	7158	CD	93	00		    call WRTPSG
 11650	715B					
 11651	715B					    ; Write high byte (only lower 4 bits)
 11652	715B	78				    ld a, b
 11653	715C	5C				    ld e, h
 11654	715D	7B				    ld a, e
 11655	715E	E6	0F			    and #0F
 11656	7160	5F				    ld e, a
 11657	7161	78				    ld a, b
 11658	7162	CD	93	00		    call WRTPSG
 11659	7165					
 11660	7165	C9				    ret
 11661	7166					
 11662	7166					; ------------------------------------------------------------------
 11663	7166					; psg_set_volume
 11664	7166					; Set volume for a channel
 11665	7166					; Input:  A = Channel (0=A, 1=B, 2=C)
 11666	7166					;         B = Volume (0-15) or #10 to enable PSG hardware envelope
 11667	7166					; Destroys: AF, E
 11668	7166					; ------------------------------------------------------------------
 11669	7166					psg_set_volume:
 11670	7166	C6	08			    add a, PSG_VOL_A             ; A = PSG_VOL_x register
 11671	7168	58				    ld e, b                      ; E = volume value
 11672	7169	CD	93	00		    call WRTPSG
 11673	716C	C9				    ret
 11674	716D					
 11675	716D					; ------------------------------------------------------------------
 11676	716D					; psg_set_noise
 11677	716D					; Set noise generator period
 11678	716D					; Input:  A = Noise period (0-31)
 11679	716D					; Destroys: AF, E
 11680	716D					; ------------------------------------------------------------------
 11681	716D					psg_set_noise:
 11682	716D	5F				    ld e, a
 11683	716E	3E	06			    ld a, PSG_NOISE_PERIOD
 11684	7170	CD	93	00		    call WRTPSG
 11685	7173	C9				    ret
 11686	7174					
 11687	7174					; ------------------------------------------------------------------
 11688	7174					; psg_set_mixer
 11689	7174					; Set mixer control (enable/disable tone and noise)
 11690	7174					; Input:  A = Mixer value
 11691	7174					;         Bits 0-2: Tone off (0=on, 1=off) for channels A,B,C
 11692	7174					;         Bits 3-5: Noise off (0=on, 1=off) for channels A,B,C
 11693	7174					; Destroys: AF, E
 11694	7174					; ------------------------------------------------------------------
 11695	7174					psg_set_mixer:
 11696	7174	5F				    ld e, a
 11697	7175	3E	07			    ld a, PSG_MIXER
 11698	7177	CD	93	00		    call WRTPSG
 11699	717A	C9				    ret
 11700	717B					
 11701	717B					; ------------------------------------------------------------------
 11702	717B					; psg_set_envelope
 11703	717B					; Program the global PSG hardware envelope generator
 11704	717B					; Input:  HL = Envelope period
 11705	717B					;         B = Envelope shape (0-15)
 11706	717B					; Destroys: AF, E
 11707	717B					; ------------------------------------------------------------------
 11708	717B					psg_set_envelope:
 11709	717B	3E	0B			    ld a, PSG_ENV_LO
 11710	717D	5D				    ld e, l
 11711	717E	CD	93	00		    call WRTPSG
 11712	7181	3E	0C			    ld a, PSG_ENV_HI
 11713	7183	5C				    ld e, h
 11714	7184	CD	93	00		    call WRTPSG
 11715	7187	78				    ld a, b
 11716	7188	E6	0F			    and #0F
 11717	718A	5F				    ld e, a
 11718	718B	3E	0D			    ld a, PSG_ENV_SHAPE
 11719	718D	CD	93	00		    call WRTPSG
 11720	7190	C9				    ret
 11721	7191					
 11722	7191					; ==================================================================
 11723	7191					; HIGH-LEVEL SOUND EFFECTS
 11724	7191					; ==================================================================
 11725	7191					
 11726	7191					; ------------------------------------------------------------------
 11727	7191					; sfx_silence_all
 11728	7191					; Silence all PSG channels
 11729	7191					; ------------------------------------------------------------------
 11730	7191					sfx_silence_all:
 11731	7191					    ; Set all volumes to 0
 11732	7191	AF				    xor a                        ; A = channel A
 11733	7192	06	00			    ld b, 0                      ; B = volume 0
 11734	7194	CD	66	71		    call psg_set_volume
 11735	7197					
 11736	7197	3E	01			    ld a, 1                      ; A = channel B
 11737	7199	06	00			    ld b, 0
 11738	719B	CD	66	71		    call psg_set_volume
 11739	719E					
 11740	719E	3E	02			    ld a, 2                      ; A = channel C
 11741	71A0	06	00			    ld b, 0
 11742	71A2	CD	66	71		    call psg_set_volume
 11743	71A5					
 11744	71A5					    ; Disable all tone and noise
 11745	71A5	3E	3F			    ld a, #3F                    ; All tone and noise off
 11746	71A7	CD	74	71		    call psg_set_mixer
 11747	71AA					
 11748	71AA	C9				    ret
 11749	71AB					
 11750	71AB					; ------------------------------------------------------------------
 11751	71AB					; sfx_beep
 11752	71AB					; Simple beep sound
 11753	71AB					; ------------------------------------------------------------------
 11754	71AB					sfx_beep:
 11755	71AB					    ; Channel A: 440Hz (A4)
 11756	71AB	AF				    xor a                        ; A = channel A
 11757	71AC	21	1C	01		    ld hl, NOTE_A4
 11758	71AF	CD	52	71		    call psg_set_tone
 11759	71B2					
 11760	71B2					    ; Volume 12
 11761	71B2	AF				    xor a
 11762	71B3	06	0C			    ld b, 12
 11763	71B5	CD	66	71		    call psg_set_volume
 11764	71B8					
 11765	71B8					    ; Enable tone A only
 11766	71B8	3E	3E			    ld a, #3E                    ; Tone A on, others off
 11767	71BA	CD	74	71		    call psg_set_mixer
 11768	71BD					
 11769	71BD	C9				    ret
 11770	71BE					
 11771	71BE					; ------------------------------------------------------------------
 11772	71BE					; sfx_jump
 11773	71BE					; Jump sound effect (rising pitch)
 11774	71BE					; ------------------------------------------------------------------
 11775	71BE					sfx_jump:
 11776	71BE					    ; Channel A: Start at C4, quick rise
 11777	71BE	AF				    xor a
 11778	71BF	21	DD	01		    ld hl, NOTE_C4
 11779	71C2	CD	52	71		    call psg_set_tone
 11780	71C5					
 11781	71C5					    ; Volume 10
 11782	71C5	AF				    xor a
 11783	71C6	06	0A			    ld b, 10
 11784	71C8	CD	66	71		    call psg_set_volume
 11785	71CB					
 11786	71CB					    ; Enable tone A
 11787	71CB	3E	3E			    ld a, #3E
 11788	71CD	CD	74	71		    call psg_set_mixer
 11789	71D0					
 11790	71D0					    ; TODO: Add pitch sweep for realistic jump sound
 11791	71D0	C9				    ret
 11792	71D1					
 11793	71D1					; ------------------------------------------------------------------
 11794	71D1					; sfx_shoot
 11795	71D1					; Shooting sound (noise + low tone)
 11796	71D1					; ------------------------------------------------------------------
 11797	71D1					sfx_shoot:
 11798	71D1					    ; Channel A: Low tone
 11799	71D1	AF				    xor a
 11800	71D2	21	64	00		    ld hl, 100                   ; Low period = high pitch
 11801	71D5	CD	52	71		    call psg_set_tone
 11802	71D8					
 11803	71D8					    ; Volume 8
 11804	71D8	AF				    xor a
 11805	71D9	06	08			    ld b, 8
 11806	71DB	CD	66	71		    call psg_set_volume
 11807	71DE					
 11808	71DE					    ; Noise generator at period 5
 11809	71DE	3E	05			    ld a, 5
 11810	71E0	CD	6D	71		    call psg_set_noise
 11811	71E3					
 11812	71E3					    ; Enable tone A + noise A
 11813	71E3	3E	36			    ld a, #36                    ; Tone A + Noise A on
 11814	71E5	CD	74	71		    call psg_set_mixer
 11815	71E8					
 11816	71E8	C9				    ret
 11817	71E9					
 11818	71E9					; ------------------------------------------------------------------
 11819	71E9					; sfx_explosion
 11820	71E9					; Explosion sound (noise-heavy)
 11821	71E9					; ------------------------------------------------------------------
 11822	71E9					sfx_explosion:
 11823	71E9					    ; Noise generator at period 10
 11824	71E9	3E	0A			    ld a, 10
 11825	71EB	CD	6D	71		    call psg_set_noise
 11826	71EE					
 11827	71EE					    ; Channel A: Volume 15 (max) with noise
 11828	71EE	AF				    xor a
 11829	71EF	06	0F			    ld b, 15
 11830	71F1	CD	66	71		    call psg_set_volume
 11831	71F4					
 11832	71F4					    ; Enable noise A only (no tone)
 11833	71F4	3E	39			    ld a, #39                    ; Noise A on, tone off
 11834	71F6	CD	74	71		    call psg_set_mixer
 11835	71F9					
 11836	71F9	C9				    ret
 11837	71FA					
 11838	71FA					; ------------------------------------------------------------------
 11839	71FA					; sfx_coin
 11840	71FA					; Coin/pickup sound (quick ascending notes)
 11841	71FA					; ------------------------------------------------------------------
 11842	71FA					sfx_coin:
 11843	71FA					    ; Channel B: E4 note
 11844	71FA	3E	01			    ld a, 1                      ; Channel B
 11845	71FC	21	7B	01		    ld hl, NOTE_E4
 11846	71FF	CD	52	71		    call psg_set_tone
 11847	7202					
 11848	7202					    ; Volume 10
 11849	7202	3E	01			    ld a, 1
 11850	7204	06	0A			    ld b, 10
 11851	7206	CD	66	71		    call psg_set_volume
 11852	7209					
 11853	7209					    ; Enable tone B
 11854	7209	3E	3D			    ld a, #3D                    ; Tone B on, others off
 11855	720B	CD	74	71		    call psg_set_mixer
 11856	720E					
 11857	720E					    ; TODO: Quick ascend to G4 for classic coin sound
 11858	720E	C9				    ret
 11859	720F					
 11860	720F					; ------------------------------------------------------------------
 11861	720F					; sfx_damage
 11862	720F					; Damage/hit sound (harsh noise)
 11863	720F					; ------------------------------------------------------------------
 11864	720F					sfx_damage:
 11865	720F					    ; Short noise burst
 11866	720F	3E	03			    ld a, 3                      ; Harsh noise period
 11867	7211	CD	6D	71		    call psg_set_noise
 11868	7214					
 11869	7214					    ; Channel C: Volume 12
 11870	7214	3E	02			    ld a, 2                      ; Channel C
 11871	7216	06	0C			    ld b, 12
 11872	7218	CD	66	71		    call psg_set_volume
 11873	721B					
 11874	721B					    ; Enable noise C only
 11875	721B	3E	1F			    ld a, #1F                    ; Noise C on
 11876	721D	CD	74	71		    call psg_set_mixer
 11877	7220					
 11878	7220	C9				    ret
 11879	7221					
 11880	7221					; ==================================================================
 11881	7221					; SOUND EFFECT PLAYBACK SYSTEM
 11882	7221					; ==================================================================
 11883	7221					; This section provides a simple sound effect manager that can
 11884	7221					; play effects with automatic duration and fadeout
 11885	7221					
 11886	7221					; Runtime state lives in variables.asm:
 11887	7221					;   sfx_active, sfx_timer, sfx_fadeout
 11888	7221					
 11889	7221					; ------------------------------------------------------------------
 11890	7221					; play_sound_effect
 11891	7221					; Play one of the built-in sound effects by ID
 11892	7221					; Input:  A = sound ID
 11893	7221					;         0=beep, 1=jump, 2=shoot, 3=explosion, 4=coin, 5=damage
 11894	7221					; Destroys: AF, BC, DE, HL
 11895	7221					; ------------------------------------------------------------------
 11896	7221					play_sound_effect:
 11897	7221	3A	4D	D1		    ld a, (music_active)
 11898	7224	B7				    or a
 11899	7225	C0				    ret nz
 11900	7226	FE	01			    cp 1
 11901	7228	CA	48	72		    jp z, play_sound_effect_jump
 11902	722B	FE	02			    cp 2
 11903	722D	CA	51	72		    jp z, play_sound_effect_shoot
 11904	7230	FE	03			    cp 3
 11905	7232	CA	5A	72		    jp z, play_sound_effect_explosion
 11906	7235	FE	04			    cp 4
 11907	7237	CA	63	72		    jp z, play_sound_effect_coin
 11908	723A	FE	05			    cp 5
 11909	723C	CA	6C	72		    jp z, play_sound_effect_damage
 11910	723F					
 11911	723F					play_sound_effect_beep:
 11912	723F	21	AB	71		    ld hl, sfx_beep
 11913	7242	06	05			    ld b, SFX_SHORT
 11914	7244	CD	75	72		    call sfx_play
 11915	7247	C9				    ret
 11916	7248					
 11917	7248					play_sound_effect_jump:
 11918	7248	21	BE	71		    ld hl, sfx_jump
 11919	724B	06	05			    ld b, SFX_SHORT
 11920	724D	CD	75	72		    call sfx_play
 11921	7250	C9				    ret
 11922	7251					
 11923	7251					play_sound_effect_shoot:
 11924	7251	21	D1	71		    ld hl, sfx_shoot
 11925	7254	06	05			    ld b, SFX_SHORT
 11926	7256	CD	75	72		    call sfx_play
 11927	7259	C9				    ret
 11928	725A					
 11929	725A					play_sound_effect_explosion:
 11930	725A	21	E9	71		    ld hl, sfx_explosion
 11931	725D	06	0F			    ld b, SFX_MEDIUM
 11932	725F	CD	75	72		    call sfx_play
 11933	7262	C9				    ret
 11934	7263					
 11935	7263					play_sound_effect_coin:
 11936	7263	21	FA	71		    ld hl, sfx_coin
 11937	7266	06	05			    ld b, SFX_SHORT
 11938	7268	CD	75	72		    call sfx_play
 11939	726B	C9				    ret
 11940	726C					
 11941	726C					play_sound_effect_damage:
 11942	726C	21	0F	72		    ld hl, sfx_damage
 11943	726F	06	05			    ld b, SFX_SHORT
 11944	7271	CD	75	72		    call sfx_play
 11945	7274	C9				    ret
 11946	7275					
 11947	7275					; ------------------------------------------------------------------
 11948	7275					; sfx_play
 11949	7275					; Play a sound effect with duration
 11950	7275					; Input:  HL = Sound effect function address
 11951	7275					;         B = Duration in frames
 11952	7275					; ------------------------------------------------------------------
 11953	7275					sfx_play:
 11954	7275	3A	4D	D1		    ld a, (music_active)
 11955	7278	B7				    or a
 11956	7279	C0				    ret nz
 11957	727A					    ; Call the sound effect function
 11958	727A	C5				    push bc
 11959	727B	E5				    push hl
 11960	727C	11	81	72		    ld de, .return_address
 11961	727F	D5				    push de
 11962	7280	E9				    jp (hl)                      ; Indirect call
 11963	7281					.return_address:
 11964	7281	E1				    pop hl
 11965	7282	C1				    pop bc
 11966	7283					
 11967	7283					    ; Set timer
 11968	7283	78				    ld a, b
 11969	7284	32	B9	CD		    ld (sfx_timer), a
 11970	7287					
 11971	7287					    ; Mark as active
 11972	7287	3E	01			    ld a, 1
 11973	7289	32	B8	CD		    ld (sfx_active), a
 11974	728C					
 11975	728C	C9				    ret
 11976	728D					
 11977	728D					; ------------------------------------------------------------------
 11978	728D					; sfx_update
 11979	728D					; Update sound effect system (call every frame)
 11980	728D					; Handles automatic fadeout and silence
 11981	728D					; ------------------------------------------------------------------
 11982	728D					sfx_update:
 11983	728D	3A	4D	D1		    ld a, (music_active)
 11984	7290	B7				    or a
 11985	7291	C0				    ret nz
 11986	7292					    ; Check if sound is active
 11987	7292	3A	B8	CD		    ld a, (sfx_active)
 11988	7295	B7				    or a
 11989	7296	C8				    ret z                        ; No active sound
 11990	7297					
 11991	7297					    ; Decrement timer
 11992	7297	3A	B9	CD		    ld a, (sfx_timer)
 11993	729A	B7				    or a
 11994	729B	28	08			    jr z, .silence_now
 11995	729D					
 11996	729D	3D				    dec a
 11997	729E	32	B9	CD		    ld (sfx_timer), a
 11998	72A1					
 11999	72A1					    ; Check if entering fadeout zone (last 5 frames)
 12000	72A1	FE	05			    cp 5
 12001	72A3	D0				    ret nc                       ; Still in main sound
 12002	72A4					
 12003	72A4					    ; TODO: Implement volume fadeout here
 12004	72A4	C9				    ret
 12005	72A5					
 12006	72A5					.silence_now:
 12007	72A5	CD	91	71		    call sfx_silence_all
 12008	72A8	AF				    xor a
 12009	72A9	32	B8	CD		    ld (sfx_active), a
 12010	72AC	C9				    ret
 12011	72AD					
 12012	72AD					; ==================================================================
 12013	72AD					; PT3 MUSIC BACKEND
 12014	72AD					; Uses the PT3 replayer for AY-3-8910 music playback.
 12015	72AD					; PT3_SETUP, ChanA, AYREGS, etc. are defined in variables.asm.
 12016	72AD					; ==================================================================
 12017	72AD					
 12018	72AD					; ------------------------------------------------------------------
 12019	72AD					; music_init_system
 12020	72AD					; Reset PT3 music state. Call once at startup.
 12021	72AD					; Destroys: AF
 12022	72AD					; ------------------------------------------------------------------
 12023	72AD					music_init_system:
 12024	72AD	AF				    xor a
 12025	72AE	32	4D	D1		    ld (music_active), a
 12026	72B1	32	4E	D1		    ld (music_muted), a
 12027	72B4	32	4F	D1		    ld (music_loop), a
 12028	72B7	32	50	D1		    ld (music_track_index), a
 12029	72BA	32	74	D1		    ld (PT3_SETUP), a
 12030	72BD	C9				    ret
 12031	72BE					
 12032	72BE					; ------------------------------------------------------------------
 12033	72BE					; music_silence_channels
 12034	72BE					; Silence all AY channels via BIOS WRTPSG.
 12035	72BE					; Destroys: AF, E
 12036	72BE					; ------------------------------------------------------------------
 12037	72BE					music_silence_channels:
 12038	72BE	AF				    xor a
 12039	72BF	47				    ld b, a
 12040	72C0	CD	66	71		    call psg_set_volume     ; Channel A vol=0
 12041	72C3	3E	01			    ld a, 1
