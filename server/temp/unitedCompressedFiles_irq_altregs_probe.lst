 13605	9BE6	18	0C			    jr .anim_write_row
 13606	9BE8					.anim_not_rr:
 13607	9BE8	FE	03			    cp 3
 13608	9BEA	20	05			    jr nz, .anim_not_sla
 13609	9BEC	7B				    ld a, e
 13610	9BED	CB	27			    sla a
