 21891	C350					; ==================================================================
 21892	C350					; ZX0 DECOMPRESSOR (AUTO-INJECTED)
 21893	C350					; ==================================================================
 21894	C350					; -----------------------------------------------------------------------------
 21895	C350					; ZX0 decoder by Einar Saukas & Urusergi
 21896	C350					; "Standard" version (68 bytes only)
 21897	C350					; -----------------------------------------------------------------------------
 21898	C350					; Parameters:
 21899	C350					;   HL: source address (compressed data)
 21900	C350					;   DE: destination address (decompressing)
 21901	C350					; -----------------------------------------------------------------------------
 21902	C350					
 21903	C350					dzx0_standard:
 21904	C350	01	FF	FF		        ld      bc, $ffff               ; preserve default offset 1
 21905	C353	C5				        push    bc
 21906	C354	03				        inc     bc
 21907	C355	3E	80			        ld      a, $80
 21908	C357					dzx0s_literals:
 21909	C357	CD	85	C3		        call    dzx0s_elias             ; obtain length
 21910	C35A	ED	B0			        ldir                            ; copy literals
 21911	C35C	87				        add     a, a                    ; copy from last offset or new offset?
 21912	C35D	38	0D			        jr      c, dzx0s_new_offset
 21913	C35F	CD	85	C3		        call    dzx0s_elias             ; obtain length
 21914	C362					dzx0s_copy:
 21915	C362	E3				        ex      (sp), hl                ; preserve source, restore offset
 21916	C363	E5				        push    hl                      ; preserve offset
 21917	C364	19				        add     hl, de                  ; calculate destination - offset
 21918	C365	ED	B0			        ldir                            ; copy from offset
 21919	C367	E1				        pop     hl                      ; restore offset
 21920	C368	E3				        ex      (sp), hl                ; preserve offset, restore source
 21921	C369	87				        add     a, a                    ; copy from literals or new offset?
 21922	C36A	30	EB			        jr      nc, dzx0s_literals
 21923	C36C					dzx0s_new_offset:
 21924	C36C	C1				        pop     bc                      ; discard last offset
 21925	C36D	0E	FE			        ld      c, $fe                  ; prepare negative offset
 21926	C36F	CD	86	C3		        call    dzx0s_elias_loop        ; obtain offset MSB
 21927	C372	0C				        inc     c
 21928	C373	C8				        ret     z                       ; check end marker
 21929	C374	41				        ld      b, c
 21930	C375	4E				        ld      c, (hl)                 ; obtain offset LSB
 21931	C376	23				        inc     hl
 21932	C377	CB	18			        rr      b                       ; last offset bit becomes first length bit
 21933	C379	CB	19			        rr      c
 21934	C37B	C5				        push    bc                      ; preserve new offset
 21935	C37C	01	01	00		        ld      bc, 1                   ; obtain length
 21936	C37F	D4	8D	C3		        call    nc, dzx0s_elias_backtrack
 21937	C382	03				        inc     bc
 21938	C383	18	DD			        jr      dzx0s_copy
 21939	C385					dzx0s_elias:
 21940	C385	0C				        inc     c                       ; interlaced Elias gamma coding
 21941	C386					dzx0s_elias_loop:
 21942	C386	87				        add     a, a
 21943	C387	20	03			        jr      nz, dzx0s_elias_skip
 21944	C389	7E				        ld      a, (hl)                 ; load another group of 8 bits
 21945	C38A	23				        inc     hl
 21946	C38B	17				        rla
 21947	C38C					dzx0s_elias_skip:
 21948	C38C	D8				        ret     c
 21949	C38D					dzx0s_elias_backtrack:
 21950	C38D	87				        add     a, a
 21951	C38E	CB	11			        rl      c
 21952	C390	CB	10			        rl      b
 21953	C392	18	F2			        jr      dzx0s_elias_loop
 21954	C394					; -----------------------------------------------------------------------------
