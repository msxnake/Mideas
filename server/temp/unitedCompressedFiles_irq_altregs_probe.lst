 13111	9A37					init_animated_tiles:
 13112	9A37					    ; Initialize animation variables
 13113	9A37	AF				    xor a
 13114	9A38	32	33	C6		    ld (anim_tile_timer), a
 13115	9A3B	32	34	C6		    ld (anim_tile_frame), a
