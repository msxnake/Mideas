 5581	513E					    ; Mark entity as on-ground and flag DOWN wall collision
 5582	513E	21	78	CD		    ld hl, entity_on_ground
 5583	5141	19				    add hl, de
 5584	5142	CB	C6			    set 0, (hl)                       ; bit 0 = standing on solid floor
 5585	5144	21	1B	CF		    ld hl, entity_wall_collision_flags
 5586	5147	19				    add hl, de
