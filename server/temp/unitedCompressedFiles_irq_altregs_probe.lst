 2393	4387					entity_shoot_sprite_id  EQU temp_byte_12 ; Projectile sprite ID (32 bytes)
 2394	4387					entity_shoot_speed      EQU temp_byte_13 ; Projectile velocity (32 bytes)
 2395	4387					
 2396	4387					    ; Collision Layer Data (for projectile and advanced collision)
 2397	4387					entity_collision_layer  EQU temp_byte_14 ; Which layer this entity is on (32 bytes)
 2398	4387					entity_collides_with    EQU temp_byte_15 ; Bitmask of layers this entity collides with (32 bytes)
 2399	4387					
 2400	4387					    ; Platform Riding Data
 2401	4387					entity_platform_id      EQU temp_byte_16 ; ID of platform underneath (255 = none) (32 bytes)
 2402	4387					entity_platform_grace   EQU temp_byte_17 ; Grace frames for platform (32 bytes)
 2403	4387					entity_wall_collision_flags EQU temp_byte_18 ; Directional wall collision bits (32 bytes)
 2404	4387					entity_collision_hitbox_w EQU temp_byte_19 ; Entity collision hitbox width (32 bytes)
 2405	4387					entity_collision_hitbox_h EQU temp_byte_20 ; Entity collision hitbox height (32 bytes)
 2406	4387					entity_collision_offset_x EQU temp_byte_21 ; Entity collision hitbox X offset (32 bytes)
 2407	4387					entity_collision_offset_y EQU temp_byte_22 ; Entity collision hitbox Y offset (32 bytes)
 2408	4387					entity_entity_collision_flags EQU temp_byte_23 ; bit0 entity(any), bit1 enemy, bit2 item (32 bytes)
 2409	4387					entity_last_collision_entity EQU temp_byte_24 ; Last collided entity index (255=none) (32 bytes)
 2410	4387					
 2411	4387					    ; Input Disable Flag
 2412	4387					entity_input_disabled EQU temp_byte_26 ; 0=enabled, 1=disabled (32 bytes)
