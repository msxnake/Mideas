 8410	5CFA					; Copy sprite attributes from RAM to VRAM
 8411	5CFA					update_sprites_to_vram:
 8412	5CFA	3A	E1	CA		    ld a, (sprites_dirty)
 8413	5CFD	B7				    or a
 8414	5CFE	C8				    ret z
 8415	5CFF	AF				    xor a
 8416	5D00	32	E1	CA		    ld (sprites_dirty), a
 8417	5D03	21	42	CB		    ld hl, sprite_attributes
 8418	5D06	11	00	1B		    ld de, SPRATR
 8419	5D09	01	20	00		    ld bc, 32  ; Upload active sprite range + SAT end marker
 8420	5D0C	CD	B3	40		    call FAST_LDIRVM
 8421	5D0F	C9				    ret
