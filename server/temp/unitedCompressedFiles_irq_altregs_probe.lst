 7060	5743					; ------------------------------------------------------------------
 7061	5743					; get_tile_behavior
 7062	5743					; Get behavior/collision type of a tile
 7063	5743					; Input:  A = Tile ID (character code from screen map)
 7064	5743					; Output: A = Behavior flags (TILE_SOLID, TILE_PLATFORM, etc.)
 7065	5743					; Destroys: HL
