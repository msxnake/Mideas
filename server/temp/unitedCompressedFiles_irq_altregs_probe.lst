 11097	6FBC	04				    inc b                       ; Width += 2
 11098	6FBD					    
 11099	6FBD	0C				    inc c
 11100	6FBE	0C				    inc c                       ; Height += 2
 11101	6FBF					    
 11102	6FBF	CD	3C	70		    call hud_draw_frame
 11103	6FC2					    
 11104	6FC2					    ; Restore original X, Y, Width, Height for text rendering
 11105	6FC2	D1				    pop de                      ; DE = X, Y (pixels)
 11106	6FC3	C1				    pop bc                      ; BC = Width, Height (tiles)
 11107	6FC4					    ; Re-push in same order as original (BC bottom, DE top)
 11108	6FC4	C5				    push bc                     ; Save Width, Height (bottom)
 11109	6FC5	D5				    push de                     ; Save X, Y (top)
 11110	6FC6					
 11111	6FC6					.no_border:
 11112	6FC6					    ; ---------------------------------------------------------
 11113	6FC6					    ; 2. Draw Text
 11114	6FC6					    ; ---------------------------------------------------------
 11115	6FC6	D1				    pop de                      ; DE = X, Y (pixels)
 11116	6FC7	C1				    pop bc                      ; BC = Width, Height (discard, not needed)
 11117	6FC8					
 11118	6FC8					    ; Calculate VRAM address from X,Y pixel coordinates
 11119	6FC8					    ; Screen 2 Name Table = #1800 + (Y/8)*32 + (X/8)
 11120	6FC8					    
 11121	6FC8					    ; Y/8 = row
 11122	6FC8	7B				    ld a, e                     ; A = Y
 11123	6FC9	CB	3F			    srl a
 11124	6FCB	CB	3F			    srl a
 11125	6FCD	CB	3F			    srl a                       ; A = Y/8 (row)
 11126	6FCF					
 11127	6FCF					    ; row * 32
 11128	6FCF	6F				    ld l, a
 11129	6FD0	26	00			    ld h, 0
 11130	6FD2	29				    add hl, hl                  ; * 2
 11131	6FD3	29				    add hl, hl                  ; * 4
 11132	6FD4	29				    add hl, hl                  ; * 8
 11133	6FD5	29				    add hl, hl                  ; * 16
 11134	6FD6	29				    add hl, hl                  ; * 32
 11135	6FD7					
 11136	6FD7					    ; Add X/8
 11137	6FD7	7A				    ld a, d                     ; A = X
 11138	6FD8	CB	3F			    srl a
 11139	6FDA	CB	3F			    srl a
 11140	6FDC	CB	3F			    srl a                       ; A = X/8 (column)
 11141	6FDE	5F				    ld e, a
 11142	6FDF	16	00			    ld d, 0
 11143	6FE1	19				    add hl, de
 11144	6FE2					
 11145	6FE2					    ; Add Name Table base
 11146	6FE2	11	00	18		    ld de, #1800
 11147	6FE5	19				    add hl, de                  ; HL = VRAM address
 11148	6FE6					
 11149	6FE6					    ; Get Text Pointer
 11150	6FE6	DD	5E	06		    ld e, (ix+6)                ; TextPtr Low
 11151	6FE9	DD	56	07		    ld d, (ix+7)                ; TextPtr High
 11152	6FEC					    ; DE = Text Pointer
 11153	6FEC					
 11154	6FEC					    ; Render text string at HL (VRAM) from DE (string)
 11155	6FEC	CD	1A	70		    call hud_print_string
 11156	6FEF					
 11157	6FEF					.skip_element:
 11158	6FEF					    ; Move to next element
 11159	6FEF	01	09	00		    ld bc, 9                    ; Size of each element entry
 11160	6FF2	DD	09			    add ix, bc                  ; IX points to next element
 11161	6FF4					
 11162	6FF4	C1				    pop bc                      ; Restore counter
 11163	6FF5	10	96			    djnz .render_loop
 11164	6FF7					
 11165	6FF7					    ; Re-apply dynamic Score digits after redrawing static HUD text.
 11166	6FF7	3A	10	C0		    ld a, (global_var_score)
 11167	6FFA	6F				    ld l, a
 11168	6FFB	3A	11	C0		    ld a, (global_var_score+1)
 11169	6FFE	67				    ld h, a
 11170	6FFF	CD	B6	70		    call update_hud_score
 11171	7002					
 11172	7002					    ; Re-apply dynamic Lives digit after redrawing static HUD text.
 11173	7002	3A	12	C0		    ld a, (global_var_lives)
 11174	7005	CD	21	71		    call update_hud_lives
