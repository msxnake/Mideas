 6992	5705					; ==================================================================
 6993	5705					; TILE COLLISION SYSTEM
 6994	5705					; ==================================================================
 6995	5705					; Provides functions for checking collision with background tiles
 6996	5705					; Uses behavior maps generated from screen collision layers
 6997	5705					; ==================================================================
 6998	5705					
 6999	5705					; ------------------------------------------------------------------
 7000	5705					; get_tile_at_position
 7001	5705					; Convert pixel coordinates to tile coordinates and get tile ID
 7002	5705					; Input:  D = X position (pixels), E = Y position (pixels)
 7003	5705					; Output: A = Tile ID at that position, Z flag set if out of bounds
 7004	5705					; Destroys: BC, HL
 7005	5705					; ------------------------------------------------------------------
 7006	5705					get_tile_at_position:
 7007	5705					    ; Convert X pixel to tile column (divide by 8 - MSX Screen 2 character cell)
 7008	5705					    ; Screen layout is ALWAYS 32x24 grid of 8x8 cells regardless of project tile size
 7009	5705	7A				    ld a, d
 7010	5706	CB	3F			    srl a
 7011	5708	CB	3F			    srl a
 7012	570A	CB	3F			    srl a                         ; A = X / 8 = tile column
 7013	570C	47				    ld b, a                       ; B = tile column
 7014	570D					
 7015	570D					    ; Convert Y pixel to tile row (divide by 8 - MSX Screen 2 character cell)
 7016	570D	7B				    ld a, e
 7017	570E	CB	3F			    srl a
 7018	5710	CB	3F			    srl a
 7019	5712	CB	3F			    srl a                         ; A = Y / 8 = tile row
 7020	5714	4F				    ld c, a                       ; C = tile row
 7021	5715					
 7022	5715					    ; Check bounds (assume 32x24 tile screen for now)
 7023	5715	78				    ld a, b
 7024	5716	FE	20			    cp 32
 7025	5718	30	27			    jr nc, .out_of_bounds
 7026	571A	79				    ld a, c
 7027	571B	FE	18			    cp 24
 7028	571D	30	22			    jr nc, .out_of_bounds
 7029	571F					
 7030	571F					    ; Calculate tile index: index = row * 32 + column (16-bit to avoid overflow)
 7031	571F	69				    ld l, c
 7032	5720	26	00			    ld h, 0                       ; HL = row (16-bit)
 7033	5722	29				    add hl, hl                    ; HL = row * 2
 7034	5723	29				    add hl, hl                    ; HL = row * 4
 7035	5724	29				    add hl, hl                    ; HL = row * 8
 7036	5725	29				    add hl, hl                    ; HL = row * 16
 7037	5726	29				    add hl, hl                    ; HL = row * 32
 7038	5727	58				    ld e, b
 7039	5728	16	00			    ld d, 0
 7040	572A	19				    add hl, de                    ; HL = row * 32 + column
 7041	572B					
 7042	572B					    ; Read actual tile from current screen layout
 7043	572B	ED	5B	1E	C0	    ld de, (current_screen_layout) ; DE = pointer to screen layout data
 7044	572F	19				    add hl, de                    ; HL = pointer to tile at position
 7045	5730	CD	76	41		    call mapper_push_p2
 7046	5733	3A	20	C0		    ld a, (current_screen_layout_bank)
 7047	5736	CD	5D	41		    call mapper_set_bank_p2
 7048	5739	7E				    ld a, (hl)                    ; A = tile ID from screen map
 7049	573A	F5				    push af
 7050	573B	CD	7D	41		    call mapper_pop_p2
 7051	573E	F1				    pop af
 7052	573F					
 7053	573F	B7				    or a                          ; Set flags based on tile ID
 7054	5740	C9				    ret                           ; Z flag set if tile == 0 (empty)
 7055	5741					
 7056	5741					.out_of_bounds:
 7057	5741	AF				    xor a                         ; A = 0
 7058	5742	C9				    ret                           ; Z flag set (out of bounds)
