 10859	6EC1					
 10860	6EC1					    ; Write character to VRAM Name Table
 10861	6EC1					    ; FAST_WRTVRM signature: A = data, HL = VRAM address
 10862	6EC1					    ; A already has character, HL already has VRAM address
 10863	6EC1	E5				    push hl                        ; Save string pointer
 10864	6EC2	D5				    push de                        ; Save VRAM position
