 8332	5CAE					; SPRITE MANAGEMENT FUNCTIONS
 8333	5CAE					; ==================================================================
 8334	5CAE					
 8335	5CAE					; A = hardware sprite index, B = X, C = Y, D = pattern, E = color
 8336	5CAE					show_sprite:
 8337	5CAE					    ; Safety check: Ensure sprite index < 32
 8338	5CAE	FE	20			    cp 32
 8339	5CB0	D0				    ret nc
 8340	5CB1					
 8341	5CB1					    ; Safety check: Never write Y >= 208 (208 is SAT end marker on MSX)
 8342	5CB1	F5				    push af
 8343	5CB2	79				    ld a, c
 8344	5CB3	FE	D0			    cp 208
 8345	5CB5	38	02			    jr c, .y_ok
 8346	5CB7	0E	E0			    ld c, SPRITE_INVISIBLE
 8347	5CB9					.y_ok:
 8348	5CB9	F1				    pop af
 8349	5CBA					
 8350	5CBA					    ; Save pattern (D) and color (E) before calculating address
 8351	5CBA	D5				    push de
 8352	5CBB					
 8353	5CBB					    ; Calculate base address for sprite: index * 4
 8354	5CBB	6F				    ld l, a
 8355	5CBC	26	00			    ld h, 0
 8356	5CBE	29				    add hl, hl      ; index * 2
 8357	5CBF	29				    add hl, hl      ; index * 4
 8358	5CC0					    ; Add base of the attribute table
 8359	5CC0	11	42	CB		    ld de, sprite_attributes
 8360	5CC3	19				    add hl, de      ; HL = &sprite_attributes[index * 4]
 8361	5CC4					
 8362	5CC4					    ; Restore pattern and color
 8363	5CC4	D1				    pop de
 8364	5CC5					
 8365	5CC5					    ; Write attributes
 8366	5CC5	71				    ld (hl), c      ; Y
 8367	5CC6	23				    inc hl
 8368	5CC7	70				    ld (hl), b      ; X
 8369	5CC8	23				    inc hl
 8370	5CC9	72				    ld (hl), d      ; Pattern
 8371	5CCA	23				    inc hl
 8372	5CCB	73				    ld (hl), e      ; Color
 8373	5CCC					
 8374	5CCC	3E	01			    ld a, 1
 8375	5CCE	32	E1	CA		    ld (sprites_dirty), a
 8376	5CD1	C9				    ret
 8377	5CD2					
 8378	5CD2					; Clear all sprites (set Y = SPRITE_INVISIBLE)
 8379	5CD2					; OPTIMIZED: Uses faster increment method instead of ADD HL,DE
 8380	5CD2					clear_all_sprites:
 8381	5CD2	21	42	CB		    ld hl, sprite_attributes
 8382	5CD5	06	20			    ld b, 32
 8383	5CD7	3E	E0			    ld a, SPRITE_INVISIBLE
 8384	5CD9					.sprite_clear_loop:
 8385	5CD9	77				    ld (hl), a      ; Set Y = SPRITE_INVISIBLE
 8386	5CDA	23				    inc hl          ; Skip to X
 8387	5CDB	23				    inc hl          ; Skip to Pattern
 8388	5CDC	23				    inc hl          ; Skip to Color
 8389	5CDD	23				    inc hl          ; Next sprite (4× INC HL = 24 cycles vs ADD HL,DE = 35 cycles)
 8390	5CDE	10	F9			    djnz .sprite_clear_loop
 8391	5CE0	3E	01			    ld a, 1
 8392	5CE2	32	E1	CA		    ld (sprites_dirty), a
 8393	5CE5	C9				    ret
 8394	5CE6					
 8395	5CE6					; Hide specific sprite (A = hardware sprite index)
 8396	5CE6					hide_sprite:
 8397	5CE6	FE	20			    cp 32
 8398	5CE8	D0				    ret nc
 8399	5CE9	6F				    ld l, a
 8400	5CEA	26	00			    ld h, 0
 8401	5CEC	29				    add hl, hl
 8402	5CED	29				    add hl, hl
 8403	5CEE	11	42	CB		    ld de, sprite_attributes
 8404	5CF1	19				    add hl, de
 8405	5CF2	36	E0			    ld (hl), SPRITE_INVISIBLE
 8406	5CF4	3E	01			    ld a, 1
 8407	5CF6	32	E1	CA		    ld (sprites_dirty), a
 8408	5CF9	C9				    ret
