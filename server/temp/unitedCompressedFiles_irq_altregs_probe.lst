 14993	A132					; Table: SM Facing Direction to Sprite Lookup Table Pointer
 14994	A132					; Maps entity_facing_dir (1=left,2=right,3=up,4=down) to directional sprite tables.
 14995	A132					; Usage: dec facing (? 0-3), index into this table to get the DW sprite_dir_*_table ptr.
 14996	A132					SM_FacingDirTablePtrs:
 14997	A132	5D	5B			    DW sprite_dir_left_table    ; facing 1 (LEFT)  ? dec ? 0
 14998	A134	6F	5B			    DW sprite_dir_right_table   ; facing 2 (RIGHT) ? dec ? 1
 14999	A136	81	5B			    DW sprite_dir_up_table      ; facing 3 (UP)    ? dec ? 2
 15000	A138	93	5B			    DW sprite_dir_down_table    ; facing 4 (DOWN)  ? dec ? 3
 15001	A13A					
 15002	A13A					; ==================================================================
 15003	A13A					; Action_ChangeSprite
 15004	A13A					; ------------------------------------------------------------------
 15005	A13A					; Cambia el sprite activo de una entidad. Realiza 5 operaciones:
 15006	A13A					;   1. Redirect direccional: si entity_facing_dir != 0, sustituye el
 15007	A13A					;      sprite pedido por su variante direccional (left/right/up/down)
 15008	A13A					;      usando SM_FacingDirTablePtrs.
 15009	A13A					;   2. Commit: escribe el sprite final en entity_sprite_asset_index.
 15010	A13A					;   3. Reset de animación: pone entity_anim_frame y entity_anim_tick a 0.
 15011	A13A					;   4. Flags de animación: activa PLAYING, aplica el flag de LOOP del
 15012	A13A					;      sprite, y para sprites one-shot borra ONLY_WHEN_MOVING para que
 15013	A13A					;      la animación avance aunque la entidad esté quieta.
 15014	A13A					;   5. Upload inmediato: copia el frame 0 del nuevo sprite a VRAM en
 15015	A13A					;      el mismo frame para que el cambio sea visible sin esperar al
 15016	A13A					;      siguiente ciclo de update_animation_component.
 15017	A13A					;   6. Colores de capas: actualiza sprite_layer_colors (tabla RAM) con
 15018	A13A					;      los colores del nuevo sprite desde SM_SpriteLayerColorTable.
 15019	A13A					;
 15020	A13A					; Input:
 15021	A13A					;   HL  = puntero al parámetro (sprite asset ID, 1 byte)
 15022	A13A					;   B   = entity index (convención SM_ExecuteActions)
 15023	A13A					;
 15024	A13A					; Output:
 15025	A13A					;   HL  = puntero al byte siguiente a los parámetros (para el caller)
 15026	A13A					;
 15027	A13A					; Destruye: AF, BC, DE, HL (todos restaurados al salir salvo HL=next param)
 15028	A13A					;
 15029	A13A					; Stack al entrar (top ? bottom):
 15030	A13A					;   [llamada desde SM_ExecuteActions]
 15031	A13A					; Stack al salir: igual que al entrar.
 15032	A13A					;
 15033	A13A					; Tablas ROM usadas:
 15034	A13A					;   SM_FacingDirTablePtrs      — punteros a las 4 tablas de redirect
 15035	A13A					;   sprite_loop_flags          — 1 byte/sprite: 0x02=loop, 0x00=one-shot
 15036	A13A					;   SM_SpritePatternPtrTable   — puntero al frame 0 de cada sprite
 15037	A13A					;   SM_SpriteLayerColorTable   — colores por sprite (SPRITE_MAX_ENTITY_LAYERS bytes/sprite)
 15038	A13A					;
 15039	A13A					; Variables RAM usadas:
 15040	A13A					;   entity_facing_dir          — dirección actual de la entidad (0-4)
 15041	A13A					;   entity_sprite_asset_index  — índice del sprite activo de la entidad
 15042	A13A					;   entity_anim_frame          — frame actual de la animación
 15043	A13A					;   entity_anim_tick           — contador de ticks entre frames
 15044	A13A					;   entity_anim_flags          — flags de animación (ver bits más abajo)
 15045	A13A					;   entity_sprite_config       — base HW sprite + layer count (2 bytes/entidad)
 15046	A13A					;   sprite_layer_colors        — colores actuales por slot HW sprite (RAM)
 15047	A13A					;
 15048	A13A					; Bits de entity_anim_flags:
 15049	A13A					;   bit 0 = ANIM_FLAG_PLAYING       (1 = animando)
 15050	A13A					;   bit 1 = ANIM_FLAG_LOOP          (1 = bucle infinito, 0 = one-shot)
 15051	A13A					;   bit 2 = ANIM_FLAG_ONLY_WHEN_MOVING (1 = solo anima si vel != 0)
 15052	A13A					;   bit 3 = ANIM_FLAG_COMPLETED     (1 = one-shot llegó al último frame)
 15053	A13A					;
 15054	A13A					; NOTA: el bloque de redirect direccional usa B como registro temporal
 15055	A13A					; para guardar el sprite ID. Al salir del bloque, B queda corrupto.
 15056	A13A					; Se restaura explícitamente con "ld b, 0" antes de los add hl, bc.
 15057	A13A					; ==================================================================
 15058	A13A					Action_ChangeSprite:
 15059	A13A	7E				    ld a, (hl)              ; A = Sprite Asset ID pedido por la SM
 15060	A13B	23				    inc hl                  ; HL apunta al byte siguiente al parámetro
 15061	A13C	E5				    push hl                 ; [stack] guarda puntero de parámetros para el ret final
 15062	A13D					
 15063	A13D	F5				    push af                 ; [stack] guarda Sprite Asset ID (se necesita tras setup)
 15064	A13E					
 15065	A13E					    ; ------------------------------------------------------------------
 15066	A13E					    ; Setup: convertir B (entity index) a BC = (0, entity_index)
 15067	A13E					    ; Convención de SM_ExecuteActions: B = entity index al entrar.
 15068	A13E					    ; ------------------------------------------------------------------
 15069	A13E	48				    ld c, b                 ; C = entity index
 15070	A13F	06	00			    ld b, 0                 ; B = 0  ?  BC = (0, entity_index)
 15071	A141					
 15072	A141					    ; Pre-calcular HL = &entity_sprite_asset_index[entity]
 15073	A141					    ; Se usará tras el bloque de redirect para escribir el sprite final.
 15074	A141	21	C0	CA		    ld hl, entity_sprite_asset_index
 15075	A144	09				    add hl, bc              ; HL = &entity_sprite_asset_index[entity]
 15076	A145					
 15077	A145	F1				    pop af                  ; A = Sprite Asset ID (recuperado del stack)
 15078	A146					
 15079	A146					    ; ------------------------------------------------------------------
 15080	A146					    ; BLOQUE 1: Redirect direccional
 15081	A146					    ; Si entity_facing_dir[entity] != 0, reemplaza el sprite pedido por
 15082	A146					    ; su variante para la dirección actual.
 15083	A146					    ;   facing 0 = sin dirección ? usar sprite tal cual
 15084	A146					    ;   facing 1 = izquierda  ? SM_FacingDirTablePtrs[0] ? sprite_dir_left_table
 15085	A146					    ;   facing 2 = derecha     ? SM_FacingDirTablePtrs[1] ? sprite_dir_right_table
 15086	A146					    ;   facing 3 = arriba      ? SM_FacingDirTablePtrs[2] ? sprite_dir_up_table
 15087	A146					    ;   facing 4 = abajo       ? SM_FacingDirTablePtrs[3] ? sprite_dir_down_table
 15088	A146					    ;
 15089	A146					    ; Las tablas de dirección son arrays de 1 byte por sprite asset:
 15090	A146					    ;   dir_table[originalSprite] = spriteVariante
 15091	A146					    ; Si no existe variante, la tabla devuelve el mismo ID original.
 15092	A146					    ;
 15093	A146					    ; IMPORTANTE: este bloque usa B como temporal para guardar el sprite ID.
 15094	A146					    ; Al salir, B queda con el sprite ID (no con 0). Se corrige después.
 15095	A146					    ; ------------------------------------------------------------------
 15096	A146	E5				    push hl                 ; [stack] guarda &entity_sprite_asset_index[entity]
 15097	A147					
 15098	A147	26	00			    ld h, 0
 15099	A149	69				    ld l, c                 ; HL = entity index
 15100	A14A	11	A0	C9		    ld de, entity_facing_dir
 15101	A14D	19				    add hl, de              ; HL = &entity_facing_dir[entity]
 15102	A14E	5E				    ld e, (hl)              ; E = facing dir (0=none, 1=left, 2=right, 3=up, 4=down)
 15103	A14F					
 15104	A14F	47				    ld b, a                 ; B = sprite ID original  [B QUEDA CORRUPTO hasta ld b,0 abajo]
 15105	A150	7B				    ld a, e                 ; A = facing dir
 15106	A151	B7				    or a
 15107	A152	28	11			    jr z, .acs_dir_done     ; facing = 0 ? no hay redirect, usar sprite original
 15108	A154					
 15109	A154					    ; Convertir facing (1-4) a índice de tabla (0-3): dec a
 15110	A154	3D				    dec a                   ; A = índice en SM_FacingDirTablePtrs (0=left, 1=right, 2=up, 3=down)
 15111	A155	21	32	A1		    ld hl, SM_FacingDirTablePtrs
 15112	A158	16	00			    ld d, 0
 15113	A15A	5F				    ld e, a
 15114	A15B	19				    add hl, de
 15115	A15C	19				    add hl, de              ; HL = &SM_FacingDirTablePtrs[facing_index * 2]  (tabla de punteros, DW)
 15116	A15D	5E				    ld e, (hl)
 15117	A15E	23				    inc hl
 15118	A15F	56				    ld d, (hl)              ; DE = puntero a la tabla de sprites para esta dirección
 15119	A160					
 15120	A160					    ; Leer el sprite redirigido: dir_table[originalSprite]
 15121	A160	68				    ld l, b                 ; L = sprite ID original
 15122	A161	26	00			    ld h, 0
 15123	A163	19				    add hl, de              ; HL = &dir_table[originalSprite]
 15124	A164	46				    ld b, (hl)              ; B = sprite ID redirigido (puede ser el mismo si no hay variante)
 15125	A165					
 15126	A165					.acs_dir_done:
 15127	A165					    ; A = sprite ID final (original o redirigido)
 15128	A165	78				    ld a, b                 ; A = sprite ID (posiblemente redirigido)
 15129	A166	E1				    pop hl                  ; HL = &entity_sprite_asset_index[entity]  [recuperado del stack]
 15130	A167					
 15131	A167					    ; ------------------------------------------------------------------
 15132	A167					    ; BLOQUE 2: Commit del sprite y reset de estado de animación
 15133	A167					    ; ------------------------------------------------------------------
 15134	A167					
 15135	A167					    ; D guardará el sprite ID para uso posterior (VRAM upload, loop flags).
 15136	A167					    ; No usar A directamente porque las instrucciones siguientes lo machan.
 15137	A167	57				    ld d, a                 ; D = Sprite Asset ID final (preservado para los bloques 3-5)
 15138	A168	77				    ld (hl), a              ; entity_sprite_asset_index[entity] = sprite ID final
 15139	A169					
 15140	A169					    ; RESTAURAR B=0: el bloque de redirect dejó B=sprite_ID.
 15141	A169					    ; Todos los "add hl, bc" siguientes necesitan BC = (0, entity_index).
 15142	A169	06	00			    ld b, 0                 ; B = 0  ?  BC = (0, entity_index)  [BUG FIX: corrupto por redirect]
 15143	A16B					
 15144	A16B					    ; Reiniciar frame al principio del nuevo sprite
 15145	A16B	21	20	C8		    ld hl, entity_anim_frame
 15146	A16E	09				    add hl, bc              ; HL = &entity_anim_frame[entity]
 15147	A16F	36	00			    ld (hl), 0              ; entity_anim_frame[entity] = 0  (empieza desde frame 0)
 15148	A171					
 15149	A171					    ; Reiniciar contador de ticks para que el primer avance de frame
 15150	A171					    ; ocurra tras entity_anim_speed ticks completos, no de inmediato.
 15151	A171	21	40	C8		    ld hl, entity_anim_tick
 15152	A174	09				    add hl, bc              ; HL = &entity_anim_tick[entity]
 15153	A175	36	00			    ld (hl), 0              ; entity_anim_tick[entity] = 0
 15154	A177					
 15155	A177					    ; ------------------------------------------------------------------
 15156	A177					    ; BLOQUE 3: Leer el flag de loop del nuevo sprite
 15157	A177					    ; sprite_loop_flags[spriteId] = 0x02 si loop, 0x00 si one-shot
 15158	A177					    ; El valor se guarda en E para aplicarlo a entity_anim_flags.
 15159	A177					    ; D se restaura al sprite ID tras poner D=0 para el add hl,de.
 15160	A177					    ; ------------------------------------------------------------------
 15161	A177	21	E5	5A		    ld hl, sprite_loop_flags
 15162	A17A	7A				    ld a, d                 ; A = Sprite Asset ID (salvar antes de poner D=0)
 15163	A17B	5F				    ld e, a                 ; E = Sprite Asset ID
 15164	A17C	16	00			    ld d, 0
 15165	A17E	19				    add hl, de              ; HL = &sprite_loop_flags[spriteId]
 15166	A17F	5E				    ld e, (hl)              ; E = loop flag (0x02=loop, 0x00=one-shot)
 15167	A180	57				    ld d, a                 ; D = Sprite Asset ID  (restaurado para el upload)
 15168	A181					
 15169	A181					    ; ------------------------------------------------------------------
 15170	A181					    ; BLOQUE 4: Actualizar entity_anim_flags
 15171	A181					    ;
 15172	A181					    ; Cambios aplicados:
 15173	A181					    ;   - bit 3 (COMPLETED)       ? 0  (el one-shot anterior ya no importa)
 15174	A181					    ;   - bit 0 (PLAYING)         ? 1  (arrancar animación)
 15175	A181					    ;   - bit 1 (LOOP)            ? según sprite_loop_flags del nuevo sprite
 15176	A181					    ;   - bit 2 (ONLY_WHEN_MOVING)? 0  SIEMPRE, para cualquier sprite
 15177	A181					    ;
 15178	A181					    ; Razón de limpiar ONLY_WHEN_MOVING siempre:
 15179	A181					    ;   Cuando el SM llama ChangeSprite, lo hace porque quiere mostrar ese
 15180	A181					    ;   sprite ahora. La animación debe avanzar siempre que PLAYING=1,
 15181	A181					    ;   sin importar la velocidad. La lógica de "anima solo si se mueve"
 15182	A181					    ;   es solo relevante para el sprite inicial de la entidad (config del
 15183	A181					    ;   editor). Una vez en la SM, el estado controla qué sprite se muestra.
 15184	A181					    ;   Si se dejara ONLY_WHEN_MOVING=1 para sprites loop, la animación walk
 15185	A181					    ;   no avanzaría: la fricción del movement component puede dejar vel_x=0
 15186	A181					    ;   antes de que llegue el turno de animation (step 11 > step 5).
 15187	A181					    ; ------------------------------------------------------------------
 15188	A181	21	80	C8		    ld hl, entity_anim_flags
 15189	A184	09				    add hl, bc              ; HL = &entity_anim_flags[entity]
 15190	A185	7E				    ld a, (hl)              ; A = flags actuales
 15191	A186					
 15192	A186	CB	9F			    res 3, a                ; bit 3 = 0: borrar ANIM_FLAG_COMPLETED
 15193	A188	F6	01			    or ANIM_FLAG_PLAYING    ; bit 0 = 1: activar ANIM_FLAG_PLAYING
 15194	A18A	E6	FD			    and #FD                 ; bit 1 = 0: limpiar ANIM_FLAG_LOOP antes de aplicar el nuevo
 15195	A18C	B3				    or e                    ; bit 1 = nuevo loop flag (E=0x02 o 0x00 según el sprite)
 15196	A18D	E6	FB			    and #FB                 ; bit 2 = 0: borrar ANIM_FLAG_ONLY_WHEN_MOVING (siempre)
 15197	A18F	77				    ld (hl), a              ; entity_anim_flags[entity] = flags actualizados
 15198	A190					
 15199	A190					    ; ------------------------------------------------------------------
 15200	A190					    ; BLOQUE 5: Upload inmediato del frame 0 a VRAM
 15201	A190					    ;
 15202	A190					    ; update_animation_component no se ejecuta hasta el próximo frame.
 15203	A190					    ; Para que el sprite nuevo se vea en el frame actual, copiamos el
 15204	A190					    ; frame 0 directamente a VRAM ahora.
 15205	A190					    ;
 15206	A190					    ; Stack a la entrada de este bloque (top ? bottom):
 15207	A190					    ;   HL = &entity_anim_flags[entity]  ? push hl
 15208	A190					    ;   BC = (0, entity_index)           ? push bc
 15209	A190					    ;   DE = (spriteId, loopFlag)        ? push de
 15210	A190					    ;
 15211	A190					    ; Al salir (.acs_upload_done) se recuperan los tres en orden inverso.
 15212	A190					    ; ------------------------------------------------------------------
 15213	A190	E5				    push hl                 ; [stack] guarda ptr entity_anim_flags (descartado al salir)
 15214	A191	C5				    push bc                 ; [stack] BC = (0, entity_index)
 15215	A192	D5				    push de                 ; [stack] DE = (D=spriteId, E=loopFlag)
 15216	A193					
 15217	A193					    ; Validar que el sprite ID esté dentro del rango conocido
 15218	A193	7A				    ld a, d                 ; A = sprite asset ID
 15219	A194	FE	12			    cp SM_SpriteAssetCount  ; ¿fuera de rango?
 15220	A196	30	60			    jr nc, .acs_upload_done ; sí ? saltar el upload (evitar acceso fuera de tabla)
 15221	A198					
 15222	A198					    ; Obtener puntero al frame 0: SM_SpritePatternPtrTable[spriteId * 2]
 15223	A198					    ; El banco ROM se deriva del propio puntero, no de una tabla separada.
 15224	A198					    ; Esto evita desincronizaciones cuando el export comprimido remapea
 15225	A198					    ; labels de sprite a blobs ZX0 en un postproceso posterior.
 15226	A198	5F				    ld e, a
 15227	A199	16	00			    ld d, 0                 ; DE = sprite asset index
