 4795	4E19	4E				        ld c, (hl)                    ; C = entity index
 4796	4E1A	23				        inc hl                        ; Advance list pointer
 4797	4E1B	E5				        push hl                       ; Save list pointer
 4798	4E1C	59				        ld e, c
 4799	4E1D	16	00			        ld d, 0
 4800	4E1F	21	40	C7		        ld hl, entity_comp_masks_hi
 4801	4E22	19				        add hl, de
 4802	4E23	7E				        ld a, (hl)
 4803	4E24	E1				        pop hl                        ; Restore list pointer
 4804	4E25	E6	04			        and #04                       ; AUTO_DESTROY bit (COMP_MASK_AUTO_DESTROY=#0400 -> high byte bit2)
 4805	4E27	28	34			        jr z, auto_destroy_next
 4806	4E29					
 4807	4E29					        ; Entity has auto-destroy component
 4808	4E29	C5				        push bc
 4809	4E2A	E5				        push hl
 4810	4E2B					
 4811	4E2B					        ; Get lifetime for this entity
 4812	4E2B	59				        ld e, c                       ; Entity index
 4813	4E2C	16	00			        ld d, 0
 4814	4E2E	21	40	C9		        ld hl, entity_lifetime
 4815	4E31	19				        add hl, de
 4816	4E32	7E				        ld a, (hl)                    ; A = lifetime
 4817	4E33					
 4818	4E33					        ; Check if lifetime is 0 (infinite) or > 0
 4819	4E33	B7				        or a
