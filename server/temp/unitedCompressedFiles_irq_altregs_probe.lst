 10866	6EC4	CD	CE	40		    call FAST_WRTVRM               ; Write character to VRAM (fast)
 10867	6EC7	D1				    pop de                         ; Restore VRAM position
 10868	6EC8	E1				    pop hl                         ; Restore string pointer
