 12124	7321					; ------------------------------------------------------------------
 12125	7321					; music_play_track
 12126	7321					; Start playing a PT3 track.
 12127	7321					; Input:  A = track index (0-based)
 12128	7321					;         B = loop flag (0=no loop, 1=loop)
 12129	7321					; Destroys: AF, BC, DE, HL, IX, IY
 12130	7321					; ------------------------------------------------------------------
