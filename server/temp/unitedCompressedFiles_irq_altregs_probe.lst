 17787	AC5D					
 17788	AC5D	C1				    pop bc
 17789	AC5E	0D				    dec c
 17790	AC5F	18	EB			    jr .xor_loop
 17791	AC61					
 17792	AC61					.xor_done:
 17793	AC61	7A				    ld a, d
 17794	AC62	C9				    ret
 17795	AC63					
 17796	AC63					Condition_Not:
 17797	AC63					    ; NOT compound condition
 17798	AC63					    ; Data format: DB 1 (always 1 subcondition), then 1 subcondition inline
 17799	AC63					    ; Evaluates the single subcondition and inverts the result
 17800	AC63					    ; Input: B = Entity Index, HL = Params (points to count byte)
 17801	AC63					    ; Output: A = inverted result, HL = past subcondition data
 17802	AC63	23				    inc hl                  ; Skip count byte (always 1)
 17803	AC64					
 17804	AC64	78				    ld a, b                 ; A = Entity Index
 17805	AC65	CD	6C	A0		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 17806	AC68					
 17807	AC68					    ; Invert: 0 -> 1, non-zero -> 0
 17808	AC68	B7				    or a
 17809	AC69	28	02			    jr z, .not_was_false
 17810	AC6B	AF				    xor a                   ; Was true -> return false
 17811	AC6C	C9				    ret
 17812	AC6D					.not_was_false:
 17813	AC6D	3E	01			    ld a, 1                 ; Was false -> return true
 17814	AC6F	C9				    ret
