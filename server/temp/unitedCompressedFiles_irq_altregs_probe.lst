 2372	4387					entity_jump_count   EQU temp_byte_4; Current jump count(0 = grounded, 1 = first jump, etc.)(32 bytes)
 2373	4387					entity_jump_max     EQU temp_byte_25; Configured max jumps for this entity (32 bytes)
 2374	4387					entity_jump_bonus   EQU temp_byte_27; Temporary extra jumps granted by bonus tiles (32 bytes)
 2375	4387					entity_on_ground    EQU temp_byte_5; Ground contact flag(bit 0 = on ground)(32 bytes)
 2376	4387					
 2377	4387					    ; Gravity Component Data
 2378	4387					entity_gravity_vel  EQU temp_word_4; Accumulated gravity velocity(signed word, 64 bytes)
 2379	4387					
 2380	4387					    ; Health Component Data
 2381	4387					entity_health_current EQU temp_byte_6 ; Current health/lives (32 bytes)
 2382	4387					entity_health_max     EQU temp_byte_7 ; Maximum health/lives (32 bytes)
 2383	4387					
 2384	4387					    ; Deadly Tile Collision Data
 2385	4387					entity_deadly_collision EQU temp_byte_8 ; Flag: bit 0 = touching deadly tile (32 bytes)
 2386	4387					
 2387	4387					    ; Damage Component Data
 2388	4387					entity_invincibility_frames EQU temp_byte_9  ; Countdown timer for invulnerability (32 bytes)
 2389	4387					entity_damage_amount        EQU temp_byte_10 ; Damage dealt by this entity (32 bytes)
 2390	4387					
 2391	4387					    ; Shoot Component Data
