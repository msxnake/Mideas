 1492	4183	3A	16	C0		    ld a, (mapper_bank_p3_current)
 1493	4186	32	1A	C0		    ld (mapper_saved_bank_p3), a
 1494	4189	C9				    ret
 1495	418A					
 1496	418A					mapper_pop_p3:
 1497	418A	3A	1A	C0		    ld a, (mapper_saved_bank_p3)
 1498	418D	C3	61	41		    jp mapper_set_bank_p3
