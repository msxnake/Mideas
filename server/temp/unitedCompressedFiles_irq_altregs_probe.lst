 7517	595F	3A	00	00		    ld a, PATTERN_DATA_BANK
 7518	5962	CD	5D	41		    call mapper_set_bank_p2
 7519	5965					    ; Decompress ZX0 tile pattern data into RAM buffer
 7520	5965	F3				    di
 7521	5966	21	97	58		    ld hl, tile_pattern_bank0
 7522	5969	11	00	DA		    ld de, ZX0_TILE_PATTERN_BUFFER
 7523	596C	CD	50	C3		    call dzx0_standard
