 251	40B3					; MAIN BIOS FUNCTIONS
 252	40B3					; ==================================================================
 253	40B3					
 254	40B3					; Screen and Display
 255	40B3					CHGMOD  EQU #005F        ; Change screen mode (A=mode)
 256	40B3					CHGCLR  EQU #0062        ; Change colors
 257	40B3					CLS     EQU #00C3        ; Clear screen
 258	40B3					POSIT   EQU #00C6        ; Position cursor (H=X, L=Y)
 259	40B3					ERAFNK  EQU #00CC        ; Erase function keys
 260	40B3					DSPFNK  EQU #00CF        ; Display function keys
 261	40B3					DISSCR  EQU #0041        ; Disable screen (prevent flicker)
 262	40B3					ENASCR  EQU #0044        ; Enable screen
 263	40B3					INITXT  EQU #006C        ; Initialize text mode
 264	40B3					INIT32  EQU #006F        ; Initialize screen mode
 265	40B3					INIGRP  EQU #0072        ; Initialize graphics routines
 266	40B3					
 267	40B3					; Character I/O
 268	40B3					CHPUT   EQU #00A2        ; Character output (A=char)
 269	40B3					CHGET   EQU #009F        ; Character input
 270	40B3					CHSNS   EQU #009C        ; Character sense (check key)
 271	40B3					BREAKX  EQU #00B7        ; Check CTRL+STOP
 272	40B3					ISCNTC  EQU #00BA        ; Check CTRL+C
 273	40B3					
 274	40B3					; String I/O
 275	40B3					OUTDO   EQU #005A        ; String output (HL=string)
 276	40B3					
 277	40B3					; Input Devices
 278	40B3					GTSTCK  EQU #00D5        ; Get joystick status (A=port)
 279	40B3					GTTRIG  EQU #00D8        ; Get trigger status (A=port)
 280	40B3					GTPAD   EQU #00DB        ; Get paddle (A=port)
 281	40B3					GTPDL   EQU #00DE        ; Get paddle value
 282	40B3					SNSMAT  EQU #0141        ; Sense matrix (A=row)
 283	40B3					KILBUF  EQU #0156        ; Kill keyboard buffer
 284	40B3					
 285	40B3					; Slot Management
 286	40B3					RSLREG  EQU #0138        ; Read slot register
 287	40B3					WSLREG  EQU #013B        ; Write slot register
 288	40B3					ENASLT  EQU #0024        ; Enable slot (H=page, A=slot)
 289	40B3					CALSLT  EQU #001C        ; Call routine in another slot
 290	40B3					
 291	40B3					; Sound
 292	40B3					GICINI  EQU #0090        ; Initialize PSG
 293	40B3					WRTPSG  EQU #0093        ; Write PSG register (A=reg, E=value)
