 12742	9922					; ==================================================================
 12743	9922					
 12744	9922					; ==================================================================
 12745	9922					; SCROLL SYSTEM CONSTANTS
 12746	9922					; ==================================================================
 12747	9922					
 12748	9922					SCREEN_WIDTH_TILES      EQU 32      ; MSX Screen 2 width in tiles
 12749	9922					SCREEN_HEIGHT_TILES     EQU 24      ; MSX Screen 2 height in tiles
 12750	9922					SCREEN_WIDTH_PIXELS     EQU 256     ; MSX Screen 2 width in pixels
 12751	9922					SCREEN_HEIGHT_PIXELS    EQU 192     ; MSX Screen 2 height in pixels
 12752	9922					
 12753	9922					; Note: NAMETBL (#1800) is already defined in constants.asm
 12754	9922					
