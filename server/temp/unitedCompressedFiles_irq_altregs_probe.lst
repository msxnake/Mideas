 20193	B6A1	0E	00			    ld c, 0                       ; C = current column (step 8)
 20194	B6A3					.tws_loop:
 20195	B6A3	79				    ld a, c
 20196	B6A4	CD	22	B7		    call trans_clear_column
 20197	B6A7	79				    ld a, c
 20198	B6A8	3C				    inc a
 20199	B6A9	CD	22	B7		    call trans_clear_column
 20200	B6AC	79				    ld a, c
 20201	B6AD	C6	02			    add a, 2
 20202	B6AF	CD	22	B7		    call trans_clear_column
 20203	B6B2	79				    ld a, c
 20204	B6B3	C6	03			    add a, 3
 20205	B6B5	CD	22	B7		    call trans_clear_column
 20206	B6B8	79				    ld a, c
 20207	B6B9	C6	04			    add a, 4
 20208	B6BB	CD	22	B7		    call trans_clear_column
 20209	B6BE	79				    ld a, c
 20210	B6BF	C6	05			    add a, 5
 20211	B6C1	CD	22	B7		    call trans_clear_column
 20212	B6C4	79				    ld a, c
 20213	B6C5	C6	06			    add a, 6
 20214	B6C7	CD	22	B7		    call trans_clear_column
 20215	B6CA	79				    ld a, c
 20216	B6CB	C6	07			    add a, 7
 20217	B6CD	CD	22	B7		    call trans_clear_column
 20218	B6D0	79				    ld a, c
 20219	B6D1	C6	08			    add a, 8
 20220	B6D3	4F				    ld c, a
 20221	B6D4	CD	15	B7		    call trans_wait_frames
 20222	B6D7	79				    ld a, c
 20223	B6D8	FE	20			    cp 32
 20224	B6DA	38	C7			    jr c, .tws_loop
