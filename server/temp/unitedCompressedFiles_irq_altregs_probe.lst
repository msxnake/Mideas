 4771	4E02					    ; AUTO-DESTROY COMPONENT SYSTEM
 4772	4E02					    ; ==================================================================
 4773	4E02					    ; Entities with AUTO_DESTROY component have a lifetime counter
 4774	4E02					    ; When lifetime reaches 0, entity is automatically destroyed
 4775	4E02					    ; Useful for: projectiles, particles, temporary effects, etc.
 4776	4E02					
 4777	4E02					init_auto_destroy_system:
 4778	4E02					    ; Initialize all lifetimes to 0 (infinite by default)
 4779	4E02	21	40	C9		    ld hl, entity_lifetime
 4780	4E05	11	41	C9		    ld de, entity_lifetime+1
 4781	4E08	01	1F	00		    ld bc, 31
 4782	4E0B	36	00			    ld (hl), 0
 4783	4E0D	ED	B0			    ldir
 4784	4E0F	C9				    ret
 4785	4E10					
 4786	4E10					update_auto_destroy_component:
 4787	4E10					    ; Update lifetime counters and destroy entities when expired
 4788	4E10	3A	07	D1		    ld a, (active_entity_count)
 4789	4E13	B7				    or a
 4790	4E14	C8				    ret z
 4791	4E15	47				    ld b, a                       ; Loop used entities only
 4792	4E16	21	E7	D0		    ld hl, active_entity_list
 4793	4E19					
