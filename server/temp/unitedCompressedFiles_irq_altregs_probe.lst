 15313	A1FB					    ; BLOQUE 6: Actualizar tabla de colores de capas en RAM
 15314	A1FB					    ;
 15315	A1FB					    ; sprite_layer_colors es una tabla RAM indexada por slot HW sprite.
 15316	A1FB					    ; SM_SpriteLayerColorTable es una tabla ROM de SPRITE_MAX_ENTITY_LAYERS
 15317	A1FB					    ; bytes por sprite, con el color de cada capa del sprite.
 15318	A1FB					    ;
 15319	A1FB					    ; Se copian los colores del nuevo sprite a los slots HW de la entidad
 15320	A1FB					    ; para que render_sprites use los colores correctos en el próximo frame.
 15321	A1FB					    ;
 15322	A1FB					    ; Registros a la entrada:
 15323	A1FB					    ;   D = sprite asset ID
 15324	A1FB					    ;   C = entity index
 15325	A1FB					    ;   B = 0
