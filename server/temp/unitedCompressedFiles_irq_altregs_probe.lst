 18530	AF7E					.do_compare:
 18531	AF7E					    ; E = Variable Value
 18532	AF7E					    ; Stack: Compare Value (D), Operator (C in saved BC), Entity Index
 18533	AF7E	E1				    pop hl                  ; HL = Compare Value (D in H)
 18534	AF7F	54				    ld d, h                 ; D = Compare Value
 18535	AF80	C1				    pop bc                  ; C = Operator ID, B = Entity Index (restore)
 18536	AF81	E1				    pop hl                  ; HL = Updated Params Ptr
 18537	AF82					    
