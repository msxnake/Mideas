 18861	B178					; ==================================================================
 18862	B178					; GAMEFLOW EXECUTION ENGINE
 18863	B178					; File: gameflow.asm
 18864	B178					; Description: GameFlow-based game orchestration system
 18865	B178					; ==================================================================
 18866	B178					;
 18867	B178					; GameFlow: Main
 18868	B178					; Total Nodes: 10
 18869	B178					; Total Connections: 11
 18870	B178					; Start Node: gf_start_1770754183471
 18871	B178					;
 18872	B178					; ARCHITECTURE:
 18873	B178					; - GameFlow is the SOLE execution orchestrator
 18874	B178					; - Each node generates its own execution code
 18875	B178					; - Connections between nodes define the complete flow
 18876	B178					; - No hardcoded main_loop outside GameFlow
 18877	B178					; ==================================================================
 18878	B178					
 18879	B178					; ==================================================================
 18880	B178					; GAMEFLOW INITIALIZATION
 18881	B178					; ==================================================================
 18882	B178					
 18883	B178					gameflow_init:
 18884	B178					    ; Initialize GameFlow system
 18885	B178					    ; Reset state
 18886	B178	AF				    xor a
 18887	B179	32	07	C0		    ld (gameflow_exit_requested), a
 18888	B17C	32	05	C0		    ld (current_flow_state), a
 18889	B17F	C9				    ret
 18890	B180					
 18891	B180					; Main entry point - called from init_rom
 18892	B180					; This is where the game STARTS
 18893	B180					gameflow_start:
 18894	B180					    ; Load the Start node
 18895	B180	21	E3	B7		    ld hl, gameflow_node_gf_start_1770754183471
 18896	B183	C3	86	B1		    jp gameflow_execute_node
 18897	B186					
 18898	B186					; ==================================================================
 18899	B186					; CORE EXECUTION ENGINE
 18900	B186					; ==================================================================
 18901	B186					
 18902	B186					; Execute a GameFlow node
 18903	B186					; Input: HL = address of node structure
 18904	B186					; 
 18905	B186					; Node Structure:
 18906	B186					;   +0: Node type (byte)
 18907	B186					;   +1-2: Data pointer (word) - node-specific data
 18908	B186					;   +3-4: Connection table pointer (word)
 18909	B186					;
 18910	B186					gameflow_execute_node:
 18911	B186					    ; Read node type
 18912	B186	7E				    ld a, (hl)
 18913	B187	23				    inc hl
 18914	B188					    
 18915	B188					    ; Save data pointer and connection table pointer for handlers
 18916	B188	5E				    ld e, (hl)
 18917	B189	23				    inc hl
 18918	B18A	56				    ld d, (hl)      ; DE = data pointer
 18919	B18B	23				    inc hl
 18920	B18C	4E				    ld c, (hl)
 18921	B18D	23				    inc hl
 18922	B18E	46				    ld b, (hl)      ; BC = connection table pointer
 18923	B18F					    
 18924	B18F					    ; DE = node data, BC = connection table
 18925	B18F					    ; Dispatch based on node type
 18926	B18F	FE	00			    cp NODE_TYPE_START
 18927	B191	CA	B3	B1		    jp z, gameflow_handle_start
 18928	B194	FE	01			    cp NODE_TYPE_WORLD_LINK
 18929	B196	CA	CE	B1		    jp z, gameflow_handle_worldlink
 18930	B199	FE	07			    cp NODE_TYPE_END
 18931	B19B	CA	07	B2		    jp z, gameflow_handle_end
 18932	B19E	FE	04			    cp NODE_TYPE_TEXT
 18933	B1A0	CA	94	B2		    jp z, gameflow_handle_text
 18934	B1A3	FE	03			    cp NODE_TYPE_SUB_MENU
 18935	B1A5	CA	30	B3		    jp z, gameflow_handle_submenu
 18936	B1A8	FE	05			    cp NODE_TYPE_TRANSITION
 18937	B1AA	CA	D8	B5		    jp z, gameflow_handle_transition
 18938	B1AD	FE	0C			    cp NODE_TYPE_MUSIC
 18939	B1AF	CA	7C	B7		    jp z, gameflow_handle_music
 18940	B1B2					    
 18941	B1B2					    ; Unknown node type - error
 18942	B1B2	C9				    ret
 18943	B1B3					
 18944	B1B3					; ==================================================================
 18945	B1B3					; NODE TYPE HANDLERS
 18946	B1B3					; Each handler receives:
 18947	B1B3					;   DE = node data pointer
 18948	B1B3					;   BC = connection table pointer
 18949	B1B3					; ==================================================================
 18950	B1B3					
 18951	B1B3					gameflow_handle_start:
 18952	B1B3					    ; Start node - Initialize game state and systems
 18953	B1B3					    ; DE = node data pointer:
 18954	B1B3					    ;   [init_routine_ptr DW][init_routine_bank DB]
 18955	B1B3					    ; BC = connection table
 18956	B1B3					
 18957	B1B3	C5				    push bc         ; Save connection table
 18958	B1B4					
 18959	B1B4					    ; Execute initialization routine
 18960	B1B4					    ; DE points to start_init_data structure
 18961	B1B4	EB				    ex de, hl
 18962	B1B5	5E				    ld e, (hl)
 18963	B1B6	23				    inc hl
 18964	B1B7	56				    ld d, (hl)      ; DE = initialization routine address
 18965	B1B8	23				    inc hl
 18966	B1B9	46				    ld b, (hl)      ; B = initialization routine bank
 18967	B1BA	62				    ld h, d
 18968	B1BB	6B				    ld l, e         ; HL = initialization routine address
 18969	B1BC					
 18970	B1BC					    ; Call initialization routine (if not null)
 18971	B1BC	7C				    ld a, h
 18972	B1BD	B5				    or l
 18973	B1BE	28	04			    jr z, .skip_init
 18974	B1C0					
 18975	B1C0					    ; Mapper-safe far call (auto window from HL address)
 18976	B1C0	78				    ld a, b
 18977	B1C1	CD	AC	41		    call mapper_call_hl_auto
 18978	B1C4					
 18979	B1C4					.skip_init:
 18980	B1C4					    ; Continue to next node
 18981	B1C4	C1				    pop bc
 18982	B1C5	CD	8A	B7		    call gameflow_get_default_connection
 18983	B1C8	7C				    ld a, h
 18984	B1C9	B5				    or l
 18985	B1CA	C8				    ret z           ; No connection
 18986	B1CB	C3	86	B1		    jp gameflow_execute_node
 18987	B1CE					
 18988	B1CE					gameflow_handle_worldlink:
 18989	B1CE					    ; WorldLink node - load world and enter game loop
 18990	B1CE					    ; DE = world data pointer:
 18991	B1CE					    ;   [load_world_ptr DW][load_world_bank DB]
 18992	B1CE					    ; BC = connection table (for exit)
 18993	B1CE					
 18994	B1CE	C5				    push bc         ; Save connection table
 18995	B1CF					
 18996	B1CF					    ; Load the world
 18997	B1CF					    ; DE points to: dw load_world_X, db load_world_bank
 18998	B1CF	EB				    ex de, hl
 18999	B1D0	5E				    ld e, (hl)
 19000	B1D1	23				    inc hl
 19001	B1D2	56				    ld d, (hl)
 19002	B1D3	23				    inc hl
 19003	B1D4	46				    ld b, (hl)      ; B = load_world_X bank
 19004	B1D5	62				    ld h, d
 19005	B1D6	6B				    ld l, e         ; HL = load_world_X address
 19006	B1D7					
 19007	B1D7					    ; Mapper-safe far call to world load routine
 19008	B1D7	7C				    ld a, h
 19009	B1D8	B5				    or l
 19010	B1D9	28	04			    jr z, .after_load
 19011	B1DB	78				    ld a, b
 19012	B1DC	CD	AC	41		    call mapper_call_hl_auto
 19013	B1DF					
 19014	B1DF					.after_load:
 19015	B1DF					    ; Set game state
 19016	B1DF	3E	01			    ld a, FLOW_STATE_GAME
 19017	B1E1	32	05	C0		    ld (current_flow_state), a
 19018	B1E4					
 19019	B1E4					    ; Update sprites
 19020	B1E4	CD	FA	5C		    call update_sprites_to_vram
 19021	B1E7					
 19022	B1E7					    ; Bootstrap HUD only on screens that actually use HUD
 19023	B1E7	3A	C2	CB		    ld a, (current_screen_id)
 19024	B1EA	FE	00			    cp 0
 19025	B1EC	CA	F2	B1		    jp z, .gf_worldlink_hud_do
 19026	B1EF	C3	FA	B1		    jp .gf_worldlink_hud_skip
 19027	B1F2					.gf_worldlink_hud_do:
 19028	B1F2	3E	01			    ld a, 1
 19029	B1F4	32	32	C6		    ld (hud_dirty_flag), a
 19030	B1F7	CD	78	6F		    call render_hud
 19031	B1FA					.gf_worldlink_hud_skip:
 19032	B1FA					
 19033	B1FA					    ; Enter game loop
 19034	B1FA	CD	B7	B7		    call gameflow_world_game_loop
 19035	B1FD					
 19036	B1FD					    ; Exited loop - continue to next node
 19037	B1FD	C1				    pop bc          ; Restore connection table
 19038	B1FE	CD	8A	B7		    call gameflow_get_default_connection
 19039	B201	7C				    ld a, h
 19040	B202	B5				    or l
 19041	B203	C8				    ret z
 19042	B204	C3	86	B1		    jp gameflow_execute_node
 19043	B207					
 19044	B207					gameflow_handle_end:
 19045	B207					    ; End node - stop execution and show end screen
 19046	B207					    ; DE = end screen data pointer (screen type, message pointer)
 19047	B207					    ; BC = connection table (unused, end stops execution)
 19048	B207					
 19049	B207	D5				    push de
 19050	B208					
 19051	B208					    ; Get end screen type from data
 19052	B208	1A				    ld a, (de)                    ; A = screen type (0=victory, 1=defeat, 2=credits, etc.)
 19053	B209	F5				    push af                       ; Save screen type
 19054	B20A	13				    inc de
 19055	B20B	1A				    ld a, (de)                    ; Get low byte of message pointer
 19056	B20C	6F				    ld l, a
 19057	B20D	13				    inc de
 19058	B20E	1A				    ld a, (de)                    ; Get high byte of message pointer
 19059	B20F	67				    ld h, a                       ; HL = message pointer (if any)
 19060	B210	F1				    pop af                        ; Restore screen type
 19061	B211					
 19062	B211					    ; Display end screen based on type
 19063	B211	CD	2B	B2		    call display_end_screen
 19064	B214					
 19065	B214	D1				    pop de
 19066	B215					
 19067	B215					    ; End screen loop - wait for input or timeout
 19068	B215					.end_screen_loop:
 19069	B215	76				    halt                          ; Wait V-blank
 19070	B216					
 19071	B216					    ; Avoid BIOS joystick helpers here because they touch the PSG while
 19072	B216					    ; VBlank music is writing it. Use keyboard matrix reads only.
 19073	B216	3E	08			    ld a, 8                       ; SPACE row
 19074	B218	CD	38	41		    call FAST_SNSMAT
 19075	B21B	CB	47			    bit 0, a                      ; SPACE
 19076	B21D	28	0B			    jr z, .end_screen_exit
 19077	B21F					
 19078	B21F					    ; Check for ESC key to exit
 19079	B21F	3E	07			    ld a, 7                       ; ESC key row
 19080	B221	CD	38	41		    call FAST_SNSMAT
 19081	B224	CB	57			    bit 2, a                      ; ESC key
 19082	B226	28	02			    jr z, .end_screen_exit
 19083	B228					
 19084	B228	18	EB			    jr .end_screen_loop
 19085	B22A					
 19086	B22A					.end_screen_exit:
 19087	B22A	C9				    ret
 19088	B22B					
 19089	B22B					; ------------------------------------------------------------------
 19090	B22B					; display_end_screen
 19091	B22B					; Display end screen based on type
 19092	B22B					; Input:  A = screen type (0=victory, 1=defeat, 2=credits, 3=custom)
 19093	B22B					;         HL = message pointer (for custom messages)
 19094	B22B					; ------------------------------------------------------------------
 19095	B22B					display_end_screen:
 19096	B22B	F5				    push af
 19097	B22C	E5				    push hl
 19098	B22D					
 19099	B22D					    ; Clear screen first
 19100	B22D	CD	2D	BA		    call clear_screen_area
 19101	B230					
 19102	B230	E1				    pop hl
 19103	B231	F1				    pop af
 19104	B232					
 19105	B232					    ; Dispatch based on screen type
 19106	B232	B7				    or a
 19107	B233	28	08			    jr z, .show_victory           ; 0 = Victory
 19108	B235	3D				    dec a
 19109	B236	28	0F			    jr z, .show_defeat            ; 1 = Defeat
 19110	B238	3D				    dec a
 19111	B239	28	16			    jr z, .show_credits           ; 2 = Credits
 19112	B23B	18	1E			    jr .show_custom               ; 3+ = Custom message
 19113	B23D					
 19114	B23D					.show_victory:
 19115	B23D					    ; Display "VICTORY!" message
 19116	B23D	21	79	B2		    ld hl, str_victory
