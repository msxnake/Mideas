 3692	48F8					    ; ------------------------------------------------------------------
 3693	48F8					    ; get_behavior_tile
 3694	48F8					    ; ------------------------------------------------------------------
 3695	48F8					; Register Contract:
 3696	48F8					;   Purpose: Read behavior byte for tile at (B=row, C=column) from the runtime behavior map.
 3697	48F8					;   Inputs:
 3698	48F8					;     - B = tile row    (0..23, out-of-range ? A=0, passable)
 3699	48F8					;     - C = tile column (0..31, out-of-range ? A=0, passable)
 3700	48F8					;     - current_behavior_map = 16-bit pointer to active screen behavior map
 3701	48F8					;     - current_behavior_map_bank = memory bank number (mapper context)
 3702	48F8					;   Outputs:
 3703	48F8					;     - A = behavior byte:
 3704	48F8					;     -   bits 7-4 (A & #F0): family / solidity class (0x00 = NoSolid, 0x10+ = Solid)
 3705	48F8					;     -   bits 3-0 (A & #0F): flag bits (e.g. 0x08 = Interactable)
 3706	48F8					;   Clobbers:
 3707	48F8					;     - AF
 3708	48F8					;   Preserved:
 3709	48F8					;     - BC
 3710	48F8					;     - DE
 3711	48F8					;     - HL
 3712	48F8					;   Notes:
 3713	48F8					;     - Maintains a single-row cache (behavior_cache_row / behavior_cache_row_base)
 3714	48F8					;     - so consecutive calls for the same row skip the row*32 multiply.
 3715	48F8					;     - Mapper push/pop protects P2 bank around the map read (no-op in simple32k mode).
 3716	48F8					;     - MUST be called with DE = entity index already set (DE is preserved, not used).
 3717	48F8					
 3718	48F8					get_behavior_tile:
 3719	48F8					    ; Bounds check: row must be 0-23, column must be 0-31
 3720	48F8					    ; NOTE: jp nc (not jr nc) to gbt_oob — gbt_oob is a global label defined after
 3721	48F8					    ; get_behavior_tile_nb. Using jr would create a local-label scoping conflict in
 3722	48F8					    ; glass.jar (get_behavior_tile_nb: starts a new scope, so .bt_out_of_bounds would
 3723	48F8					    ; belong to that scope, not get_behavior_tile's scope).
 3724	48F8	78				    ld a, b
 3725	48F9	FE	18			    cp 24
 3726	48FB	D2	46	49		    jp nc, gbt_oob                ; Row >= 24: treat as passable
 3727	48FE	79				    ld a, c
 3728	48FF	FE	20			    cp 32
 3729	4901	D2	46	49		    jp nc, gbt_oob                ; Column >= 32: treat as passable
 3730	4904					get_behavior_tile_nb:
 3731	4904					    ; Entry point for callers that guarantee B ? 0..23 and C ? 0..31.
 3732	4904					    ; Saves 36 cycles (4+7+7+4+7+7) by skipping bounds validation.
 3733	4904					    ; DO NOT call this unless the probe coordinates are provably in-bounds.
 3734	4904	E5				    push hl
 3735	4905	D5				    push de
 3736	4906					
 3737	4906					    ; Load cached behavior map pointer (fallback to current_behavior_map)
 3738	4906	21	25	C0		    ld hl, behavior_cache_map_l
 3739	4909	5E				    ld e, (hl)
 3740	490A	23				    inc hl
 3741	490B	56				    ld d, (hl)
 3742	490C	7A				    ld a, d
 3743	490D	B3				    or e
 3744	490E	20	11			    jr nz, .map_ptr_ready
 3745	4910					
 3746	4910	ED	5B	21	C0	    ld de, (current_behavior_map)
 3747	4914	7B				    ld a, e
 3748	4915	32	25	C0		    ld (behavior_cache_map_l), a
 3749	4918	7A				    ld a, d
 3750	4919	32	26	C0		    ld (behavior_cache_map_h), a
 3751	491C	3E	FF			    ld a, #FF
 3752	491E	32	24	C0		    ld (behavior_cache_row), a
 3753	4921					
 3754	4921					.map_ptr_ready:
 3755	4921					    ; Reuse previous row base when checking multiple points on same row
 3756	4921	78				    ld a, b
 3757	4922	21	24	C0		    ld hl, behavior_cache_row
 3758	4925	BE				    cp (hl)
 3759	4926	28	13			    jr z, .use_cached_row_base
 3760	4928					
 3761	4928					    ; Cache miss: row base = behavior_map + row*32
 3762	4928	78				    ld a, b
 3763	4929	6F				    ld l, a
 3764	492A	26	00			    ld h, 0
 3765	492C	29				    add hl, hl                    ; HL = row * 2
 3766	492D	29				    add hl, hl                    ; HL = row * 4
 3767	492E	29				    add hl, hl                    ; HL = row * 8
 3768	492F	29				    add hl, hl                    ; HL = row * 16
 3769	4930	29				    add hl, hl                    ; HL = row * 32
 3770	4931	19				    add hl, de                    ; HL = row base address
 3771	4932					
 3772	4932	78				    ld a, b
 3773	4933	32	24	C0		    ld (behavior_cache_row), a
 3774	4936	22	27	C0		    ld (behavior_cache_row_base), hl
 3775	4939	18	03			    jr .row_base_ready
 3776	493B					
 3777	493B					.use_cached_row_base:
 3778	493B	2A	27	C0		    ld hl, (behavior_cache_row_base)
 3779	493E					
 3780	493E					.row_base_ready:
 3781	493E	59				    ld e, c
 3782	493F	16	00			    ld d, 0
 3783	4941	19				    add hl, de                    ; HL = row base + column
 3784	4942					
 3785	4942					    ; simple32k: behavior map is always resident in RAM (no bank switching needed).
 3786	4942					    ; Skip mapper push/pop/set — saves ~169 cycles per call (41% overhead eliminated).
 3787	4942	7E				    ld a, (hl)                    ; A = behavior value (direct RAM read)
 3788	4943	D1				    pop de
 3789	4944	E1				    pop hl
 3790	4945	C9				    ret
 3791	4946					gbt_oob:
 3792	4946	AF				    xor a                         ; A = 0 (passable)
 3793	4947	C9				    ret
