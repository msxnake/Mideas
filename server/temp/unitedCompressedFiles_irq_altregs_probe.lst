 12160	7354					
 12161	7354					; ------------------------------------------------------------------
 12162	7354					; music_update
 12163	7354					; Update PT3 playback. Called every frame from ISR.
 12164	7354					; Checks end-of-song flag, handles loop/stop, runs PT3_ROUT+PT3_PLAY.
 12165	7354					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 12166	7354					; ------------------------------------------------------------------
 12167	7354					music_update:
 12168	7354	3A	4D	D1		    ld a, (music_active)
 12169	7357	B7				    or a
 12170	7358	C8				    ret z
 12171	7359	3A	4E	D1		    ld a, (music_muted)
 12172	735C	B7				    or a
 12173	735D	C0				    ret nz
 12174	735E					    ; Check if song ended (CHECKLP sets bit7 of PT3_SETUP)
 12175	735E	3A	74	D1		    ld a, (PT3_SETUP)
 12176	7361	CB	7F			    bit 7, a
 12177	7363	28	27			    jr z, .pt3_upd_play
 12178	7365					    ; Song ended - loop or stop?
 12179	7365	3A	4F	D1		    ld a, (music_loop)
 12180	7368	B7				    or a
 12181	7369	28	1C			    jr z, .pt3_upd_stop
 12182	736B					    ; Loop: reinitialise from same track
 12183	736B	3A	50	D1		    ld a, (music_track_index)
 12184	736E	87				    add a, a
 12185	736F	5F				    ld e, a
 12186	7370	16	00			    ld d, 0
 12187	7372	21	CA	79		    ld hl, music_pt3_track_table
 12188	7375	19				    add hl, de
 12189	7376	5E				    ld e, (hl)
 12190	7377	23				    inc hl
 12191	7378	56				    ld d, (hl)
 12192	7379	62				    ld h, d
 12193	737A	6B				    ld l, e
 12194	737B	DD	E5			    push ix
 12195	737D	FD	E5			    push iy
 12196	737F	CD	B8	73		    call PT3_INIT
 12197	7382	FD	E1			    pop iy
 12198	7384	DD	E1			    pop ix
 12199	7386	C9				    ret
 12200	7387					.pt3_upd_stop:
 12201	7387	AF				    xor a
 12202	7388	32	4D	D1		    ld (music_active), a
 12203	738B	C9				    ret
 12204	738C					.pt3_upd_play:
 12205	738C	DD	E5			    push ix
 12206	738E	FD	E5			    push iy
 12207	7390	CD	1F	79		    call PT3_ROUT
 12208	7393	CD	1F	78		    call PT3_PLAY
 12209	7396	FD	E1			    pop iy
 12210	7398	DD	E1			    pop ix
 12211	739A	C9				    ret
