 20070	B61F					; ------------------------------------------------------------------
 20071	B61F					; EFFECT 1: DISSOLVE_PIXELS - Column-interleaved dissolve (8 passes)
 20072	B61F					; Each pass clears cols D, D+8, D+16, D+24 with 1 HALT delay
 20073	B61F					; ------------------------------------------------------------------
 20074	B61F					.trans_dissolve_pixels:
 20075	B61F	16	00			    ld d, 0                       ; D = pass counter (0-7)
 20076	B621					.tdp_loop:
 20077	B621	7A				    ld a, d
 20078	B622	CD	22	B7		    call trans_clear_column       ; col D
 20079	B625	7A				    ld a, d
 20080	B626	C6	08			    add a, 8
 20081	B628	CD	22	B7		    call trans_clear_column       ; col D+8
 20082	B62B	7A				    ld a, d
 20083	B62C	C6	10			    add a, 16
 20084	B62E	CD	22	B7		    call trans_clear_column       ; col D+16
 20085	B631	7A				    ld a, d
 20086	B632	C6	18			    add a, 24
 20087	B634	CD	22	B7		    call trans_clear_column       ; col D+24
 20088	B637	CD	15	B7		    call trans_wait_frames        ; timed delay between passes
 20089	B63A	14				    inc d
 20090	B63B	7A				    ld a, d
 20091	B63C	FE	08			    cp 8
 20092	B63E	38	E1			    jr c, .tdp_loop
 20093	B640	C9				    ret
 20094	B641					
 20095	B641					; ------------------------------------------------------------------
 20096	B641					; EFFECT 2: DISSOLVE_CHARS - Pixel-row interleaved dissolve (8 passes)
 20097	B641					; Pass D clears pixel rows D, D+8, D+16, ..., D+184 (24 rows per pass)
 20098	B641					; Uses color table manipulation for 1-pixel-row granularity (8x finer
 20099	B641					; than tile-row approach).
 20100	B641					; ------------------------------------------------------------------
 20101	B641					.trans_dissolve_chars:
 20102	B641	16	00			    ld d, 0                       ; D = pass counter (0-7)
 20103	B643					.tdc_loop:
 20104	B643	42				    ld b, d                       ; B = starting pixel row for this pass
 20105	B644	1E	18			    ld e, 24                      ; E = 24 pixel rows per pass (192/8)
 20106	B646					.tdc_inner:
 20107	B646	78				    ld a, b
 20108	B647	CD	DD	B6		    call trans_clear_pixel_row_colors   ; clear pixel row B (color table)
 20109	B64A					    ; trans_clear_pixel_row_colors preserves BC,DE,HL via push/pop
 20110	B64A	78				    ld a, b
 20111	B64B	C6	08			    add a, 8                      ; next pixel row in this pass (step +8)
 20112	B64D	47				    ld b, a
 20113	B64E	1D				    dec e
 20114	B64F	20	F5			    jr nz, .tdc_inner
 20115	B651	CD	15	B7		    call trans_wait_frames
 20116	B654	14				    inc d
 20117	B655	7A				    ld a, d
 20118	B656	FE	08			    cp 8
 20119	B658	38	E9			    jr c, .tdc_loop
 20120	B65A	C9				    ret
 20121	B65B					
 20122	B65B					; ------------------------------------------------------------------
 20123	B65B					; EFFECT 3: VERTICAL_LINES - Left-to-right column wipe (2 cols/frame)
 20124	B65B					; ------------------------------------------------------------------
 20125	B65B					.trans_vertical_lines:
 20126	B65B	0E	00			    ld c, 0                       ; C = current column
 20127	B65D					.tvl_loop:
 20128	B65D	79				    ld a, c
 20129	B65E	CD	22	B7		    call trans_clear_column       ; clear col C
 20130	B661	0C				    inc c
 20131	B662	79				    ld a, c
 20132	B663	CD	22	B7		    call trans_clear_column       ; clear col C+1
 20133	B666	0C				    inc c
 20134	B667	CD	15	B7		    call trans_wait_frames
 20135	B66A	79				    ld a, c
 20136	B66B	FE	20			    cp 32
 20137	B66D	38	EE			    jr c, .tvl_loop
 20138	B66F	C9				    ret
 20139	B670					
 20140	B670					; ------------------------------------------------------------------
 20141	B670					; EFFECT 4: HORIZONTAL_LINES - Top-to-bottom row wipe (1 row/frame)
 20142	B670					; ------------------------------------------------------------------
 20143	B670					.trans_horizontal_lines:
 20144	B670					    ; Pixel-row resolution: 24 tile-rows x 8 sub-rows = 192 pixel rows
 20145	B670					    ; Each step: clear all 8 pixel sub-rows of one tile-row, then wait
 20146	B670	0E	00			    ld c, 0                       ; C = tile row (0-23)
 20147	B672					.thl_loop:
 20148	B672	79				    ld a, c
 20149	B673	87				    add a, a
 20150	B674	87				    add a, a
 20151	B675	87				    add a, a                      ; A = tile_row * 8 = first pixel row of tile
 20152	B676	5F				    ld e, a                       ; E = first pixel row
 20153	B677	06	08			    ld b, 8                       ; 8 pixel sub-rows per tile row
 20154	B679					.thl_inner:
 20155	B679	7B				    ld a, e
 20156	B67A	CD	DD	B6		    call trans_clear_pixel_row_colors
 20157	B67D	1C				    inc e
 20158	B67E	10	F9			    djnz .thl_inner
 20159	B680	CD	15	B7		    call trans_wait_frames
 20160	B683	0C				    inc c
 20161	B684	79				    ld a, c
 20162	B685	FE	18			    cp 24
 20163	B687	DA	72	B6		    jp c, .thl_loop
 20164	B68A	C9				    ret
 20165	B68B					
 20166	B68B					; ------------------------------------------------------------------
 20167	B68B					; EFFECT 5: SPIRAL - Pixel-row resolution via color table manipulation
 20168	B68B					; Clears pixel rows from outside in (top+bottom simultaneously).
 20169	B68B					; Works by setting color table bytes to 0x11 (black fg + black bg)
 20170	B68B					; for all 256 tile patterns at the given pixel sub-row in each bank.
 20171	B68B					; 96 rings: rows (0,191), (1,190), (2,189), ..., (95,96)
 20172	B68B					; ------------------------------------------------------------------
 20173	B68B					.trans_spiral:
 20174	B68B	06	00			    ld b, 0                       ; B = top pixel row (0..95)
 20175	B68D	0E	BF			    ld c, 191                     ; C = bottom pixel row (191..96)
 20176	B68F					.tsp_loop:
 20177	B68F	78				    ld a, b
 20178	B690	CD	DD	B6		    call trans_clear_pixel_row_colors   ; blacken pixel row B (top)
 20179	B693	79				    ld a, c
 20180	B694	CD	DD	B6		    call trans_clear_pixel_row_colors   ; blacken pixel row C (bottom)
 20181	B697	CD	15	B7		    call trans_wait_frames
 20182	B69A	04				    inc b
 20183	B69B	0D				    dec c
 20184	B69C	78				    ld a, b
 20185	B69D	B9				    cp c
 20186	B69E	38	EF			    jr c, .tsp_loop               ; loop while top < bottom
 20187	B6A0	C9				    ret
 20188	B6A1					
 20189	B6A1					; ------------------------------------------------------------------
 20190	B6A1					; EFFECT 6: FILL_WHITE_SQUARES - 4-column stripe wipe (8 cols/frame)
