 21849	C324					; ==================================================================
 21850	C324					; ZX0 SPRITE COPY HELPER (AUTO-INJECTED)
 21851	C324					; - If HL points to a compressed sprite frame blob, decompress frame
 21852	C324					;   to ZX0_SPRITE_FRAME_BUFFER and then upload to VRAM.
 21853	C324					; - Otherwise copy raw frame data directly to VRAM.
 21854	C324					; Input: HL=source (ROM), DE=VRAM destination, BC=byte count
 21855	C324					; ==================================================================
 21856	C324					COPY_SPRITE_SRC_TO_VRAM:
 21857	C324	D5				    push de
 21858	C325					    ; source < ZX0_SPRITE_FRAME_DATA_START => raw copy
 21859	C325	E5				    push hl
 21860	C326	11	49	BD		    ld de, ZX0_SPRITE_FRAME_DATA_START
 21861	C329	B7				    or a
 21862	C32A	ED	52			    sbc hl, de
 21863	C32C	E1				    pop hl
 21864	C32D	38	1D			    jr c, COPY_SPRITE_SRC_TO_VRAM_RAW
 21865	C32F					
 21866	C32F					    ; source >= ZX0_SPRITE_FRAME_DATA_END_LABEL => raw copy
 21867	C32F	E5				    push hl
 21868	C330	11	23	C3		    ld de, ZX0_SPRITE_FRAME_DATA_END_LABEL
 21869	C333	B7				    or a
 21870	C334	ED	52			    sbc hl, de
 21871	C336	E1				    pop hl
 21872	C337	30	13			    jr nc, COPY_SPRITE_SRC_TO_VRAM_RAW
 21873	C339					
 21874	C339					    ; Compressed frame: decompress to shared RAM buffer, then upload
 21875	C339	D1				    pop de
 21876	C33A	C5				    push bc
 21877	C33B	D5				    push de
 21878	C33C	E5				    push hl
 21879	C33D	11	00	E0		    ld de, ZX0_SPRITE_FRAME_BUFFER
 21880	C340	CD	50	C3		    call dzx0_standard
 21881	C343	E1				    pop hl
 21882	C344	D1				    pop de
 21883	C345	C1				    pop bc
 21884	C346	21	00	E0		    ld hl, ZX0_SPRITE_FRAME_BUFFER
 21885	C349	C3	B3	40		    jp FAST_LDIRVM
 21886	C34C					
 21887	C34C					COPY_SPRITE_SRC_TO_VRAM_RAW:
 21888	C34C	D1				    pop de
 21889	C34D	C3	B3	40		    jp FAST_LDIRVM
