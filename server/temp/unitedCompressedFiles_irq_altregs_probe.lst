 12759	9922					init_scroll_system:
 12760	9922					    ; Initialize camera to (0, 0)
 12761	9922	AF				    xor a
 12762	9923	32	29	C6		    ld (camera_x), a
 12763	9926	32	2A	C6		    ld (camera_x + 1), a
 12764	9929	32	2B	C6		    ld (camera_y), a
 12765	992C	32	2C	C6		    ld (camera_y + 1), a
 12766	992F	32	2D	C6		    ld (camera_tile_x), a
 12767	9932	32	2E	C6		    ld (camera_tile_y), a
 12768	9935					
 12769	9935					    ; Set world dimensions (will be updated by level loader)
 12770	9935	3E	20			    ld a, SCREEN_WIDTH_TILES
 12771	9937	32	2F	C6		    ld (world_width_tiles), a
 12772	993A	3E	18			    ld a, SCREEN_HEIGHT_TILES
 12773	993C	32	30	C6		    ld (world_height_tiles), a
 12774	993F					
 12775	993F					    ; Clear dirty flag
 12776	993F	AF				    xor a
 12777	9940	32	31	C6		    ld (scroll_dirty_flag), a
 12778	9943					
 12779	9943	C9				    ret
