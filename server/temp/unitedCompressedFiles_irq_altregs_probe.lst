 1895	4271					;   Register roles:
 1896	4271					;     - A = slot validation and zero value for clearing
 1897	4271					;     - HL = destination slot pointer
 1898	4271					;     - DE = computed slot offset
 1899	4271					
 1900	4271					; Inputs:
 1901	4271					;   A = task slot (0-7)
 1902	4271					; Outputs: None
 1903	4271					; Modifies: AF, DE, HL
 1904	4271					; ==================================================================
 1905	4271					disable_task:
 1906	4271					    ; Validate slot
 1907	4271	FE	08			    cp 8
 1908	4273	D0				    ret nc
 1909	4274					
 1910	4274					    ; Calculate offset
 1911	4274	87				    add a, a                    ; A = slot * 2
 1912	4275	5F				    ld e, a
 1913	4276	16	00			    ld d, 0
 1914	4278	21	2E	D1		    ld hl, task_table
 1915	427B	19				    add hl, de                  ; HL = task_table + offset
 1916	427C					
 1917	427C					    ; Write 0 (disable)
 1918	427C	AF				    xor a
 1919	427D	77				    ld (hl), a                  ; Low byte = 0
 1920	427E	23				    inc hl
 1921	427F	77				    ld (hl), a                  ; High byte = 0
 1922	4280					
 1923	4280	C9				    ret
