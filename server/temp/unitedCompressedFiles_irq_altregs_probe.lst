 13797	9CDC					
 13798	9CDC					; ==================================================================
 13799	9CDC					; PARTICLE SYSTEM (VRAM Pattern Redefinition)
 13800	9CDC					; File: particles.asm
 13801	9CDC					; Description: Visual effects using dynamic tile pattern updates
 13802	9CDC					; ==================================================================
 13803	9CDC					
 13804	9CDC					; ==================================================================
 13805	9CDC					; PARTICLE SYSTEM CONSTANTS
 13806	9CDC					; ==================================================================
 13807	9CDC					
 13808	9CDC					; Maximum active particles
 13809	9CDC					MAX_PARTICLES           EQU 8       ; Support up to 8 simultaneous particles
 13810	9CDC					
 13811	9CDC					; Reserved tile IDs for particles (248-255)
 13812	9CDC					PARTICLE_TILE_BASE      EQU 248     ; First tile ID for particles
 13813	9CDC					
 13814	9CDC					; Particle types
 13815	9CDC					PARTICLE_NONE           EQU 0       ; Inactive particle slot
 13816	9CDC					PARTICLE_EXPLOSION      EQU 1       ; Explosion (4 frames, expands outward)
 13817	9CDC					PARTICLE_SMOKE          EQU 2       ; Smoke puff (4 frames, rises up)
 13818	9CDC					PARTICLE_SPARK          EQU 3       ; Spark/flash (2 frames, quick)
 13819	9CDC					PARTICLE_DUST           EQU 4       ; Dust cloud (3 frames, fades)
 13820	9CDC					PARTICLE_IMPACT         EQU 5       ; Impact star (3 frames, shrinks)
 13821	9CDC					PARTICLE_DEBRIS         EQU 6       ; Debris chunk (2 frames, falls)
 13822	9CDC					PARTICLE_MUZZLE_FLASH   EQU 7       ; Muzzle flash (2 frames, instant)
 13823	9CDC					PARTICLE_WATER_SPLASH   EQU 8       ; Water splash (4 frames, arcs)
 13824	9CDC					
 13825	9CDC					; Particle lifetimes (in frames)
 13826	9CDC					LIFE_EXPLOSION          EQU 16      ; ~267ms
 13827	9CDC					LIFE_SMOKE              EQU 24      ; ~400ms
 13828	9CDC					LIFE_SPARK              EQU 8       ; ~133ms
 13829	9CDC					LIFE_DUST               EQU 12      ; ~200ms
 13830	9CDC					LIFE_IMPACT             EQU 10      ; ~167ms
 13831	9CDC					LIFE_DEBRIS             EQU 20      ; ~333ms
 13832	9CDC					LIFE_MUZZLE_FLASH       EQU 4       ; ~67ms (very quick)
 13833	9CDC					LIFE_WATER_SPLASH       EQU 18      ; ~300ms
 13834	9CDC					
 13835	9CDC					; Particle pool structure (8 bytes per particle)
 13836	9CDC					; Offset 0: Type (PARTICLE_*)
 13837	9CDC					; Offset 1: Lifetime remaining (frames)
 13838	9CDC					; Offset 2: X position (screen coords, 0-31 tiles)
 13839	9CDC					; Offset 3: Y position (screen coords, 0-23 tiles)
 13840	9CDC					; Offset 4: Animation frame (0-3)
 13841	9CDC					; Offset 5: Tile ID assigned (248-255)
 13842	9CDC					; Offset 6: Velocity X (signed, -128 to 127)
 13843	9CDC					; Offset 7: Velocity Y (signed, -128 to 127)
 13844	9CDC					
 13845	9CDC					PARTICLE_STRUCT_SIZE    EQU 8
 13846	9CDC					
 13847	9CDC					; ==================================================================
 13848	9CDC					; PARTICLE SYSTEM INITIALIZATION
 13849	9CDC					; ==================================================================
 13850	9CDC					
 13851	9CDC					init_particle_system:
 13852	9CDC					    ; Clear particle pool
 13853	9CDC	21	40	C6		    ld hl, particle_pool
 13854	9CDF	11	41	C6		    ld de, particle_pool + 1
 13855	9CE2	01	3F	00		    ld bc, MAX_PARTICLES * PARTICLE_STRUCT_SIZE - 1
 13856	9CE5	36	00			    ld (hl), PARTICLE_NONE
 13857	9CE7	ED	B0			    ldir
 13858	9CE9					
 13859	9CE9					    ; Initialize tile ID assignments
 13860	9CE9	3E	F8			    ld a, PARTICLE_TILE_BASE
 13861	9CEB	06	08			    ld b, MAX_PARTICLES
 13862	9CED	21	45	C6		    ld hl, particle_pool + 5    ; Offset to tile_id field
 13863	9CF0					.part_init_tile_loop:
 13864	9CF0	77				    ld (hl), a
 13865	9CF1	3C				    inc a
 13866	9CF2	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 13867	9CF5	19				    add hl, de
 13868	9CF6	10	F8			    djnz .part_init_tile_loop
 13869	9CF8					
 13870	9CF8	C9				    ret
 13871	9CF9					
 13872	9CF9					; ==================================================================
 13873	9CF9					; PARTICLE SPAWNING FUNCTIONS
 13874	9CF9					; ==================================================================
 13875	9CF9					
 13876	9CF9					; ------------------------------------------------------------------
 13877	9CF9					; spawn_particle
 13878	9CF9					; Create a new particle at given position
 13879	9CF9					; Input:  A = Particle type (PARTICLE_*)
 13880	9CF9					;         B = X position (tile coords, 0-31)
 13881	9CF9					;         C = Y position (tile coords, 0-23)
 13882	9CF9					;         D = Velocity X (optional, signed)
 13883	9CF9					;         E = Velocity Y (optional, signed)
 13884	9CF9					; Output: A = 1 if spawned successfully, 0 if pool full
 13885	9CF9					; Destroys: AF, BC, DE, HL
 13886	9CF9					; ------------------------------------------------------------------
 13887	9CF9					spawn_particle:
 13888	9CF9	F5				    push af                     ; Save particle type
 13889	9CFA	C5				    push bc                     ; Save position
 13890	9CFB	D5				    push de                     ; Save velocity
 13891	9CFC					
 13892	9CFC					    ; Find free particle slot
 13893	9CFC	CD	29	9D		    call find_free_particle
 13894	9CFF	28	23			    jr z, .part_spawn_failed    ; Z flag set = no free slots
 13895	9D01					
 13896	9D01					    ; HL points to free particle structure
 13897	9D01	D1				    pop de                      ; Restore velocity
 13898	9D02	C1				    pop bc                      ; Restore position
 13899	9D03	F1				    pop af                      ; Restore type
 13900	9D04					
 13901	9D04					    ; Fill particle structure
 13902	9D04	77				    ld (hl), a                  ; Offset 0: type
 13903	9D05	23				    inc hl
 13904	9D06					
 13905	9D06					    ; Set lifetime based on type
 13906	9D06	E5				    push hl
 13907	9D07	CD	3C	9D		    call get_particle_lifetime  ; A = type -> A = lifetime
 13908	9D0A	E1				    pop hl
 13909	9D0B	77				    ld (hl), a                  ; Offset 1: lifetime
 13910	9D0C	23				    inc hl
 13911	9D0D					
 13912	9D0D	70				    ld (hl), b                  ; Offset 2: X position
 13913	9D0E	23				    inc hl
 13914	9D0F	71				    ld (hl), c                  ; Offset 3: Y position
 13915	9D10	23				    inc hl
 13916	9D11					
 13917	9D11	AF				    xor a
 13918	9D12	77				    ld (hl), a                  ; Offset 4: frame = 0
 13919	9D13	23				    inc hl
 13920	9D14	23				    inc hl                      ; Skip tile_id (already assigned)
 13921	9D15					
 13922	9D15	72				    ld (hl), d                  ; Offset 6: velocity X
 13923	9D16	23				    inc hl
 13924	9D17	73				    ld (hl), e                  ; Offset 7: velocity Y
 13925	9D18					
 13926	9D18					    ; Place particle tile on screen immediately
 13927	9D18	2B				    dec hl
 13928	9D19	2B				    dec hl
 13929	9D1A	2B				    dec hl
 13930	9D1B	2B				    dec hl
 13931	9D1C	2B				    dec hl
 13932	9D1D	2B				    dec hl                      ; Back to start of structure
 13933	9D1E	CD	B8	9D		    call draw_particle_tile
 13934	9D21					
 13935	9D21	3E	01			    ld a, 1                     ; Success
 13936	9D23	C9				    ret
 13937	9D24					
 13938	9D24					.part_spawn_failed:
 13939	9D24	D1				    pop de
 13940	9D25	C1				    pop bc
 13941	9D26	F1				    pop af
 13942	9D27	AF				    xor a                       ; Failed
 13943	9D28	C9				    ret
 13944	9D29					
 13945	9D29					; ------------------------------------------------------------------
 13946	9D29					; find_free_particle
 13947	9D29					; Find first inactive particle slot
 13948	9D29					; Output: HL = Address of free particle, Z flag clear
 13949	9D29					;         Z flag set if no free slots
 13950	9D29					; ------------------------------------------------------------------
 13951	9D29					find_free_particle:
 13952	9D29	21	40	C6		    ld hl, particle_pool
 13953	9D2C	06	08			    ld b, MAX_PARTICLES
 13954	9D2E					.part_find_loop:
 13955	9D2E	7E				    ld a, (hl)
 13956	9D2F	FE	00			    cp PARTICLE_NONE
 13957	9D31	C8				    ret z                       ; Found free slot
 13958	9D32					
 13959	9D32	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 13960	9D35	19				    add hl, de
 13961	9D36	10	F6			    djnz .part_find_loop
 13962	9D38					
 13963	9D38					    ; No free slot found
 13964	9D38	AF				    xor a
 13965	9D39	F6	01			    or 1                        ; Clear Z flag
 13966	9D3B	C9				    ret
 13967	9D3C					
 13968	9D3C					; ------------------------------------------------------------------
 13969	9D3C					; get_particle_lifetime
 13970	9D3C					; Get default lifetime for particle type
 13971	9D3C					; Input:  A = Particle type
 13972	9D3C					; Output: A = Lifetime in frames
 13973	9D3C					; ------------------------------------------------------------------
 13974	9D3C					get_particle_lifetime:
 13975	9D3C	21	45	9D		    ld hl, particle_lifetime_table
 13976	9D3F	5F				    ld e, a
 13977	9D40	16	00			    ld d, 0
 13978	9D42	19				    add hl, de
 13979	9D43	7E				    ld a, (hl)
 13980	9D44	C9				    ret
 13981	9D45					
 13982	9D45					particle_lifetime_table:
 13983	9D45	00				    db 0                        ; PARTICLE_NONE
 13984	9D46	10				    db LIFE_EXPLOSION           ; PARTICLE_EXPLOSION
 13985	9D47	18				    db LIFE_SMOKE               ; PARTICLE_SMOKE
 13986	9D48	08				    db LIFE_SPARK               ; PARTICLE_SPARK
 13987	9D49	0C				    db LIFE_DUST                ; PARTICLE_DUST
 13988	9D4A	0A				    db LIFE_IMPACT              ; PARTICLE_IMPACT
 13989	9D4B	14				    db LIFE_DEBRIS              ; PARTICLE_DEBRIS
 13990	9D4C	04				    db LIFE_MUZZLE_FLASH        ; PARTICLE_MUZZLE_FLASH
