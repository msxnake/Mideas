 5056	4EE9					    ; ==================================================================
 5057	4EE9					    ; WALL COLLISION COMPONENT SYSTEM
 5058	4EE9					    ; ==================================================================
 5059	4EE9					    ; Prevents entities from moving through walls
 5060	4EE9					    ; Uses per-entity hitbox (offset + width/height)
 5061	4EE9					    ; Snaps entity position to wall edge AND zeros velocity
 5062	4EE9					
 5063	4EE9					init_wallcollision_system:
 5064	4EE9	C9				    ret
 5065	4EEA					
 5066	4EEA					; ------------------------------------------------------------------
 5067	4EEA					; update_wallcollision_component
 5068	4EEA					; ------------------------------------------------------------------
 5069	4EEA					; Check wall collisions and prevent movement through solid tiles.
 5070	4EEA					; Uses behavior map (current_behavior_map) for collision detection.
 5071	4EEA					; Entity position is cached in wall_temp_x/y and converted to hitbox bounds.
 5072	4EEA					; ------------------------------------------------------------------
 5073	4EEA					; Register Contract:
 5074	4EEA					;   Purpose: Iterate all entity slots; for each active entity with
 5075	4EEA					;            WallCollision eligibility, probe solid tiles in movement
 5076	4EEA					;            direction(s) and snap position + zero velocity on hit.
 5077	4EEA					;   Inputs:
 5078	4EEA					;     - entity_active[]         : 1 = entity exists
 5079	4EEA					;     - entity_comp_masks[]     : low byte component bitmask
 5080	4EEA					;     - entity_comp_masks_hi[]  : high byte (COMP_MASK_GRAVITY at bit 1)
 5081	4EEA					;     - entity_collides_with[]  : must include COLLISION_LAYER_PLATFORM (#08)
 5082	4EEA					;     - entity_screen_id[]      : entity must be on current_screen_id
 5083	4EEA					;     - entity_x_pos/y_pos[]    : world position
 5084	4EEA					;     - entity_vel_x/vel_y[]    : signed 8-bit velocity (negative = left/up)
 5085	4EEA					;     - entity_gravity_vel[]    : 16-bit signed gravity accumulator (word)
 5086	4EEA					;     - entity_collision_offset_x/y[]: signed offset from origin to hitbox corner
 5087	4EEA					;     - entity_collision_hitbox_w/h[]: hitbox size (minimum 1 if zero)
 5088	4EEA					;     - current_behavior_map    : pointer to active screen behavior map
 5089	4EEA					;     - current_screen_id       : ID of the visible screen
 5090	4EEA					;   Outputs:
 5091	4EEA					;     - entity_x_pos/y_pos[]    : snapped on collision
 5092	4EEA					;     - entity_vel_x/vel_y[]    : zeroed on collision axis
 5093	4EEA					;     - entity_gravity_vel[]    : zeroed on vertical collision
 5094	4EEA					;     - entity_on_ground[]      : bit 0 set=floor, cleared at loop start
 5095	4EEA					;     - entity_wall_collision_flags[]: bits 0=UP,1=DOWN,2=LEFT,3=RIGHT
 5096	4EEA					;   Clobbers: AF, BC, DE, HL
 5097	4EEA					;   Preserved: (none — uses scratch RAM wall_temp_x/y, wall_hit_*, wall_probe_*)
 5098	4EEA					;   Notes:
 5099	4EEA					;     - Opt-B: loop uses active_entity_list (entities guaranteed active + on screen).
 5100	4EEA					;       Eliminates ~29 wasted iterations vs 0..MAX_ENTITIES scan (3 entities active).
 5101	4EEA					;     - Opt-C: wall_build_hitbox_cache is skipped on DOWN snap when new Y == current Y
 5102	4EEA					;       (entity already on floor). Saves ~200 cycles/entity/frame when standing still.
 5103	4EEA					;     - wall_build_hitbox_cache is called once at entity entry, and after each snap
 5104	4EEA					;       where the position actually changes.
 5105	4EEA					;     - Gravity floor check (.check_wall_y_gravity) runs even when vel_y=0
