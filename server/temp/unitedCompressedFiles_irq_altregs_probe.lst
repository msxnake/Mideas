 7525	5970	21	00	DA		    ld hl, ZX0_TILE_PATTERN_BUFFER
 7526	5973	11	00	14		    ld de, CHRTBL2 + #1000 + (128 * 8) ; VRAM pattern table bank 2 (+#1000 offset + char 128)
 7527	5976	01	90	00		    ld bc, 144    ; Total bytes for all tile characters
