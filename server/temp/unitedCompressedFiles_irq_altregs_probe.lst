 8621	5FE7					; Helper function to initialize character 0 (empty cell) with background color
 8622	5FE7					; Input: A = background color (0-15)
 8623	5FE7					; This ensures empty cells show the correct background color instead of BIOS default (blue)
 8624	5FE7					init_char0_color:
