 19142	B262					; ------------------------------------------------------------------
 19143	B262					; Helper: Print string to VRAM
 19144	B262					; Input: HL = string pointer (null-terminated)
 19145	B262					;        DE = VRAM destination
 19146	B262					; ------------------------------------------------------------------
 19147	B262					print_string_vram:
 19148	B262	C5				    push bc
 19149	B263	D5				    push de
 19150	B264	E5				    push hl
 19151	B265					
 19152	B265					.psv_loop:
 19153	B265	7E				    ld a, (hl)                    ; Get character
 19154	B266	B7				    or a                          ; Check for null terminator
 19155	B267	28	0C			    jr z, .psv_done
 19156	B269					
 19157	B269					    ; Write character to VRAM
 19158	B269	E5				    push hl
 19159	B26A	D5				    push de
 19160	B26B	EB				    ex de, hl                     ; HL = VRAM address (from DE)
