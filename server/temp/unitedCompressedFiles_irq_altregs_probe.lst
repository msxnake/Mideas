 4839	4E47	19				        add hl, de
 4840	4E48	36	00			        ld (hl), 0                    ; Clear high byte
 4841	4E4A	21	08	D1		        ld hl, active_entity_list_dirty
 4842	4E4D	36	01			        ld (hl), 1
