 13556	9BCA					; ------------------------------------------------------------------
 13557	9BCA					; Routine: anim_transform_vram_block
 13558	9BCA					; Purpose:
 13559	9BCA					;   Apply transform to one 8-byte VRAM block (one char rows table).
 13560	9BCA					; Input:
 13561	9BCA					;   HL = VRAM base address for row 0 (8 consecutive bytes)
 13562	9BCA					;   D  = operation code:
 13563	9BCA					;        1 rotate_left  (RLCA)
 13564	9BCA					;        2 rotate_right (RRCA)
 13565	9BCA					;        3 shift_left   (SLA)
 13566	9BCA					;        4 shift_right  (SRL)
 13567	9BCA					;        5 shift_up rows
 13568	9BCA					;        6 shift_down rows
 13569	9BCA					;        7 swap top/bottom row
 13570	9BCA					; Output:
 13571	9BCA					;   None
 13572	9BCA					; Modifies:
 13573	9BCA					;   AF, BC, DE, HL
 13574	9BCA					; Preserves:
 13575	9BCA					;   IX, IY, SP
 13576	9BCA					; Flags:
 13577	9BCA					;   Not preserved
 13578	9BCA					; Stack:
 13579	9BCA					;   Uses stack while reading row bytes
 13580	9BCA					; ------------------------------------------------------------------
 13581	9BCA					anim_transform_vram_block:
