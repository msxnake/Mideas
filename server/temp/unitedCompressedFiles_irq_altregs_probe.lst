 10967	6F3D					
 10968	6F3D					    ; Read element fields
 10969	6F3D	DD	56	01		    ld d, (ix+1)                ; D = X position (pixels)
 10970	6F40	DD	5E	02		    ld e, (ix+2)                ; E = Y position (pixels)
 10971	6F43	DD	46	03		    ld b, (ix+3)                ; B = Width (tiles)
 10972	6F46	DD	4E	04		    ld c, (ix+4)                ; C = Height (tiles)
 10973	6F49	DD	7E	05		    ld a, (ix+5)                ; A = Flags
