 20059	B611					; ------------------------------------------------------------------
 20060	B611					; EFFECT 0: CLS - Instant clear + hold black for configured duration
 20061	B611					; ------------------------------------------------------------------
 20062	B611					.trans_cls:
 20063	B611	21	00	18		    ld hl, #1800
 20064	B614	01	00	03		    ld bc, 768
 20065	B617	AF				    xor a                         ; Tile 0 = blank
 20066	B618	CD	68	B7		    call trans_fast_filvrm
 20067	B61B	CD	15	B7		    call trans_wait_frames        ; Hold black screen for configured time
 20068	B61E	C9				    ret
