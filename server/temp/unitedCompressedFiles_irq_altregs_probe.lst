 13082	9A37					; ==================================================================
 13083	9A37					; ANIMATED TILES SYSTEM
 13084	9A37					; File: animtiles.asm
 13085	9A37					; Description: Background tile animation for water, lava, fire, etc.
 13086	9A37					; ==================================================================
 13087	9A37					
 13088	9A37					; Auto-detected animated groups:
 13089	9A37					;   frame groups: 2
 13090	9A37					;   transform groups: 3
 13091	9A37					
 13092	9A37					; ==================================================================
 13093	9A37					; ANIMATED TILES CONSTANTS
 13094	9A37					; ==================================================================
 13095	9A37					
 13096	9A37					; Animation speeds (in frames)
 13097	9A37					ANIM_SPEED_SLOW         EQU 15      ; ~250ms (water)
 13098	9A37					ANIM_SPEED_MEDIUM       EQU 8       ; ~133ms (lava)
 13099	9A37					ANIM_SPEED_FAST         EQU 4       ; ~66ms (fire)
 13100	9A37					
 13101	9A37					; Maximum animated tiles
 13102	9A37					MAX_ANIM_TILES          EQU 5
 13103	9A37					ANIM_TILE_ENTRY_SIZE    EQU 7       ; char, chars, frames, speed, bytesPerFrame, ptr(2)
 13104	9A37					ANIM_TRANS_ENTRY_SIZE   EQU 4       ; char, chars, opCode, flags
 13105	9A37					ANIM_TILE_DATA_BANK     EQU ((anim_tile_table - #4000) / #2000)
 13106	9A37					
 13107	9A37					; ==================================================================
 13108	9A37					; ANIMATED TILES INITIALIZATION
