 13587	9BCF	06	08			    ld b, 8
 13588	9BD1					.anim_transform_horizontal_loop:
 13589	9BD1	E5				    push hl
 13590	9BD2	CD	E8	40		    call FAST_RDVRM                 ; A = row byte from VRAM[HL]
 13591	9BD5	E1				    pop hl
 13592	9BD6					
 13593	9BD6	5F				    ld e, a
 13594	9BD7	7A				    ld a, d
 13595	9BD8	FE	01			    cp 1
 13596	9BDA	20	04			    jr nz, .anim_not_rl
 13597	9BDC	7B				    ld a, e
 13598	9BDD	07				    rlca
 13599	9BDE	18	14			    jr .anim_write_row
 13600	9BE0					.anim_not_rl:
 13601	9BE0	FE	02			    cp 2
 13602	9BE2	20	04			    jr nz, .anim_not_rr
 13603	9BE4	7B				    ld a, e
