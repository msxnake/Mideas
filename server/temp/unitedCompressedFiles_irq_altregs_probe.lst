 7353	5852					
 7354	5852					; ------------------------------------------------------------------
 7355	5852					; check_collision_at_point
 7356	5852					; Check if there's a solid tile at given pixel coordinates
 7357	5852					; Input:  D = X position, E = Y position
 7358	5852					; Output: Z flag set if passable, cleared if solid
 7359	5852					;         A = Behavior flags of tile at that position
 7360	5852					; Destroys: BC, HL
 7361	5852					; ------------------------------------------------------------------
 7362	5852					check_collision_at_point:
 7363	5852	CD	05	57		    call get_tile_at_position
 7364	5855	C8				    ret z                         ; Out of bounds = passable
 7365	5856	CD	43	57		    call get_tile_behavior
 7366	5859	E6	03			    and TILE_SOLID | TILE_PLATFORM
 7367	585B	C9				    ret                           ; Z if passable, NZ if solid
 7368	585C					
 7369	585C					; ------------------------------------------------------------------
 7370	585C					; check_collision_box
 7371	585C					; Check collision for entity bounding box (16x16)
 7372	585C					; Input:  D = X position (top-left), E = Y position (top-left)
 7373	585C					; Output: Z flag set if no collision, cleared if collision detected
 7374	585C					;         A = Behavior flags of colliding tile
 7375	585C					; Destroys: BC, HL
 7376	585C					; ------------------------------------------------------------------
 7377	585C					check_collision_box:
 7378	585C					    ; Check 4 corners of 16x16 box:
 7379	585C					    ; Top-left (X, Y)
 7380	585C	D5				    push de
 7381	585D	CD	52	58		    call check_collision_at_point
 7382	5860	20	28			    jr nz, .collision_found
 7383	5862					
 7384	5862					    ; Top-right (X+15, Y)
 7385	5862	D1				    pop de
 7386	5863	D5				    push de
 7387	5864	7A				    ld a, d
 7388	5865	C6	0F			    add a, 15
 7389	5867	57				    ld d, a
 7390	5868	CD	52	58		    call check_collision_at_point
 7391	586B	20	1D			    jr nz, .collision_found
 7392	586D					
 7393	586D					    ; Bottom-left (X, Y+15)
 7394	586D	D1				    pop de
 7395	586E	D5				    push de
 7396	586F	7B				    ld a, e
 7397	5870	C6	0F			    add a, 15
 7398	5872	5F				    ld e, a
 7399	5873	CD	52	58		    call check_collision_at_point
 7400	5876	20	12			    jr nz, .collision_found
 7401	5878					
 7402	5878					    ; Bottom-right (X+15, Y+15)
 7403	5878	D1				    pop de
 7404	5879	D5				    push de
 7405	587A	7A				    ld a, d
 7406	587B	C6	0F			    add a, 15
 7407	587D	57				    ld d, a
 7408	587E	7B				    ld a, e
 7409	587F	C6	0F			    add a, 15
 7410	5881	5F				    ld e, a
 7411	5882	CD	52	58		    call check_collision_at_point
 7412	5885	20	03			    jr nz, .collision_found
 7413	5887					
 7414	5887					    ; No collision
 7415	5887	D1				    pop de
 7416	5888	AF				    xor a                         ; Z flag set
 7417	5889	C9				    ret
 7418	588A					
 7419	588A					.collision_found:
 7420	588A	D1				    pop de
 7421	588B	B7				    or a                          ; Clear Z flag
 7422	588C	C9				    ret
 7423	588D					
 7424	588D					; ------------------------------------------------------------------
 7425	588D					; div_a_by_c
 7426	588D					; Divide A by C (unsigned 8-bit division)
 7427	588D					; Input:  A = dividend, C = divisor
 7428	588D					; Output: A = quotient
 7429	588D					; Destroys: B
 7430	588D					; ------------------------------------------------------------------
 7431	588D					div_a_by_c:
 7432	588D	06	00			    ld b, 0                       ; B = quotient
 7433	588F					.tile_div_loop:
 7434	588F	91				    sub c
 7435	5890	38	03			    jr c, .tile_div_done
 7436	5892	04				    inc b
 7437	5893	18	FA			    jr .tile_div_loop
 7438	5895					.tile_div_done:
 7439	5895	78				    ld a, b
 7440	5896	C9				    ret
