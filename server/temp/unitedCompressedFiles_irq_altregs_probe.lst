 15340	A209	19				    add hl, de              ; HL = &entity_sprite_config[entity * 2]
 15341	A20A	4E				    ld c, (hl)              ; C = base HW sprite index (slot de partida en la OAM)
 15342	A20B					
 15343	A20B	D1				    pop de                  ; DE: D=spriteId, E=loopFlag  [recuperado del stack]
 15344	A20C					
 15345	A20C					    ; Calcular HL = SM_SpriteLayerColorTable + spriteId * SPRITE_MAX_ENTITY_LAYERS
 15346	A20C					    ; mediante suma repetida (SPRITE_MAX_ENTITY_LAYERS es pequeño, típicamente 2-4)
 15347	A20C	6A				    ld l, d                 ; L = sprite asset ID
 15348	A20D	26	00			    ld h, 0                 ; HL = sprite asset ID
 15349	A20F	5D				    ld e, l
 15350	A210	54				    ld d, h                 ; DE = sprite asset ID (multiplicando)
 15351	A211	21	00	00		    ld hl, 0
