 4399	6FD6					; update_particles
 4400	6FD6					; Update all active particles (call every frame)
 4401	6FD6					; Decrements lifetime, advances animation, applies velocity
 4402	6FD6					; ------------------------------------------------------------------
 4403	6FD6					update_particles:
 4404	6FD6	21	3E	C6		    ld hl, particle_pool
 4405	6FD9	06	08			    ld b, MAX_PARTICLES
 4406	6FDB					.part_update_loop:
 4407	6FDB	C5				    push bc
 4408	6FDC	E5				    push hl
 4409	6FDD					
 4410	6FDD					    ; Check if particle is active
 4411	6FDD	7E				    ld a, (hl)
 4412	6FDE	FE	00			    cp PARTICLE_NONE
