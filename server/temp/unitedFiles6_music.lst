 3971	6EAA	C9				    ret
 3972	6EAB					
 3973	6EAB					; ------------------------------------------------------------------
 3974	6EAB					; Routine: anim_transform_vram_block
 3975	6EAB					; Purpose:
 3976	6EAB					;   Apply transform to one 8-byte VRAM block (one char rows table).
 3977	6EAB					; Input:
 3978	6EAB					;   HL = VRAM base address for row 0 (8 consecutive bytes)
 3979	6EAB					;   D  = operation code:
 3980	6EAB					;        1 rotate_left  (RLCA)
 3981	6EAB					;        2 rotate_right (RRCA)
 3982	6EAB					;        3 shift_left   (SLA)
 3983	6EAB					;        4 shift_right  (SRL)
 3984	6EAB					;        5 shift_up rows
 3985	6EAB					;        6 shift_down rows
 3986	6EAB					;        7 swap top/bottom row
 3987	6EAB					; Output:
 3988	6EAB					;   None
 3989	6EAB					; Modifies:
 3990	6EAB					;   AF, BC, DE, HL
 3991	6EAB					; Preserves:
 3992	6EAB					;   IX, IY, SP
 3993	6EAB					; Flags:
 3994	6EAB					;   Not preserved
 3995	6EAB					; Stack:
 3996	6EAB					;   Uses stack while reading row bytes
 3997	6EAB					; ------------------------------------------------------------------
 3998	6EAB					anim_transform_vram_block:
 3999	6EAB	7A				    ld a, d
 4000	6EAC	FE	05			    cp 5
 4001	6EAE	30	2C			    jr nc, .anim_transform_vertical
 4002	6EB0					
 4003	6EB0					    ; Horizontal bit transforms (operate row by row)
 4004	6EB0	06	08			    ld b, 8
 4005	6EB2					.anim_transform_horizontal_loop:
 4006	6EB2	E5				    push hl
 4007	6EB3	CD	E8	40		    call FAST_RDVRM                 ; A = row byte from VRAM[HL]
 4008	6EB6	E1				    pop hl
 4009	6EB7					
 4010	6EB7	5F				    ld e, a
 4011	6EB8	7A				    ld a, d
 4012	6EB9	FE	01			    cp 1
 4013	6EBB	20	04			    jr nz, .anim_not_rl
 4014	6EBD	7B				    ld a, e
 4015	6EBE	07				    rlca
 4016	6EBF	18	14			    jr .anim_write_row
 4017	6EC1					.anim_not_rl:
 4018	6EC1	FE	02			    cp 2
 4019	6EC3	20	04			    jr nz, .anim_not_rr
 4020	6EC5	7B				    ld a, e
 4021	6EC6	0F				    rrca
 4022	6EC7	18	0C			    jr .anim_write_row
 4023	6EC9					.anim_not_rr:
 4024	6EC9	FE	03			    cp 3
 4025	6ECB	20	05			    jr nz, .anim_not_sla
 4026	6ECD	7B				    ld a, e
 4027	6ECE	CB	27			    sla a
 4028	6ED0	18	03			    jr .anim_write_row
 4029	6ED2					.anim_not_sla:
 4030	6ED2	7B				    ld a, e
 4031	6ED3	CB	3F			    srl a
 4032	6ED5					
 4033	6ED5					.anim_write_row:
 4034	6ED5	CD	CE	40		    call FAST_WRTVRM
 4035	6ED8	23				    inc hl
 4036	6ED9	10	D7			    djnz .anim_transform_horizontal_loop
 4037	6EDB	C9				    ret
 4038	6EDC					
 4039	6EDC					.anim_transform_vertical:
 4040	6EDC	D5				    push de                        ; Preserve D=operation code (DE reused as pointers)
 4041	6EDD					    ; Read current 8 row bytes into temporary RAM buffer
 4042	6EDD	11	36	C6		    ld de, anim_tile_row_buffer
 4043	6EE0	06	08			    ld b, 8
 4044	6EE2					.anim_read_rows_loop:
 4045	6EE2	E5				    push hl
 4046	6EE3	CD	E8	40		    call FAST_RDVRM                 ; A = row byte
 4047	6EE6	E1				    pop hl
 4048	6EE7	12				    ld (de), a
 4049	6EE8	13				    inc de
 4050	6EE9	23				    inc hl
 4051	6EEA	10	F6			    djnz .anim_read_rows_loop
 4052	6EEC					
 4053	6EEC					    ; Restore HL to start of block (HL -= 8)
 4054	6EEC	11	F8	FF		    ld de, #FFF8
 4055	6EEF	19				    add hl, de
 4056	6EF0	D1				    pop de                         ; Restore original operation code in D
 4057	6EF1					
 4058	6EF1	7A				    ld a, d
 4059	6EF2	FE	05			    cp 5
 4060	6EF4	20	14			    jr nz, .anim_not_shift_up
 4061	6EF6					
 4062	6EF6					    ; shift_up: row0<-row1 ... row6<-row7 row7<-row0
 4063	6EF6	11	37	C6		    ld de, anim_tile_row_buffer + 1
 4064	6EF9	06	07			    ld b, 7
 4065	6EFB					.anim_write_up_loop:
 4066	6EFB	1A				    ld a, (de)
 4067	6EFC	CD	CE	40		    call FAST_WRTVRM
 4068	6EFF	13				    inc de
 4069	6F00	23				    inc hl
 4070	6F01	10	F8			    djnz .anim_write_up_loop
 4071	6F03	3A	36	C6		    ld a, (anim_tile_row_buffer)
 4072	6F06	CD	CE	40		    call FAST_WRTVRM
 4073	6F09	C9				    ret
 4074	6F0A					
 4075	6F0A					.anim_not_shift_up:
 4076	6F0A	FE	06			    cp 6
 4077	6F0C	20	15			    jr nz, .anim_not_shift_down
 4078	6F0E					
 4079	6F0E					    ; shift_down: row0<-row7 row1<-row0 ... row7<-row6
 4080	6F0E	3A	3D	C6		    ld a, (anim_tile_row_buffer + 7)
 4081	6F11	CD	CE	40		    call FAST_WRTVRM
 4082	6F14	23				    inc hl
 4083	6F15	11	36	C6		    ld de, anim_tile_row_buffer
 4084	6F18	06	07			    ld b, 7
 4085	6F1A					.anim_write_down_loop:
 4086	6F1A	1A				    ld a, (de)
 4087	6F1B	CD	CE	40		    call FAST_WRTVRM
 4088	6F1E	13				    inc de
 4089	6F1F	23				    inc hl
 4090	6F20	10	F8			    djnz .anim_write_down_loop
 4091	6F22	C9				    ret
 4092	6F23					
 4093	6F23					.anim_not_shift_down:
 4094	6F23					    ; swap_top_bottom: row0<->row7, middle rows unchanged
 4095	6F23	3A	3D	C6		    ld a, (anim_tile_row_buffer + 7)
 4096	6F26	CD	CE	40		    call FAST_WRTVRM
 4097	6F29	23				    inc hl
 4098	6F2A	11	37	C6		    ld de, anim_tile_row_buffer + 1
 4099	6F2D	06	06			    ld b, 6
 4100	6F2F					.anim_write_middle_loop:
 4101	6F2F	1A				    ld a, (de)
 4102	6F30	CD	CE	40		    call FAST_WRTVRM
 4103	6F33	13				    inc de
 4104	6F34	23				    inc hl
 4105	6F35	10	F8			    djnz .anim_write_middle_loop
 4106	6F37	3A	36	C6		    ld a, (anim_tile_row_buffer)
 4107	6F3A	CD	CE	40		    call FAST_WRTVRM
 4108	6F3D	C9				    ret
