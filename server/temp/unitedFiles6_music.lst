 1247	4145					task_4_ptr              EQU #D12F   ; Slot 4 pointer (2 bytes)
 1248	4145					task_5_ptr              EQU #D131   ; Slot 5 pointer (2 bytes)
 1249	4145					task_6_ptr              EQU #D133   ; Slot 6 pointer (2 bytes)
 1250	4145					task_7_ptr              EQU #D135   ; Slot 7 pointer (2 bytes)
 1251	4145					interrupt_system_enabled EQU #D137   ; 0=disabled, 1=enabled (1 byte)
 1252	4145					old_htimi_hook          EQU #D138   ; Original H.TIMI hook (5 bytes)
 1253	4145					interrupt_counter       EQU #D13D   ; Frame counter (16-bit)
 1254	4145					task_exec_time          EQU #D13F   ; Cycles used by tasks (16-bit, debug)
 1255	4145					vblank_flag             EQU #D141   ; Set to 1 on each VBlank (1 byte)
 1256	4145					RAM_INTERRUPT_END       EQU #D142   ; End of interrupt system
 1257	4145					
 1258	4145					; ==================================================================
 1259	4145					; STATE MACHINE SOUND RUNTIME (one active sound asset)
 1260	4145					; ==================================================================
 1261	4145					sm_sound_active       EQU #D142   ; 0=idle, 1=playing state-machine sound asset
 1262	4145					sm_sound_frames_left  EQU #D143   ; Frames left for current state-machine sound asset
 1263	4145					sm_sound_ptr_l        EQU #D144   ; Next sound frame pointer low byte
 1264	4145					sm_sound_ptr_h        EQU #D145   ; Next sound frame pointer high byte
