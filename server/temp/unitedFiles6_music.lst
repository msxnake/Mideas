 3325	6CAF	3E	20			    ld a, SCREEN_WIDTH_TILES
 3326	6CB1	32	2D	C6		    ld (world_width_tiles), a
 3327	6CB4	3E	18			    ld a, SCREEN_HEIGHT_TILES
 3328	6CB6	32	2E	C6		    ld (world_height_tiles), a
 3329	6CB9					
 3330	6CB9					    ; Clear dirty flag
 3331	6CB9	AF				    xor a
