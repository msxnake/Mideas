 2986	45D7	CD	ED	45		    call sfx_play
 2987	45DA	C9				    ret
 2988	45DB					
 2989	45DB					play_sound_effect_coin:
 2990	45DB	21	72	45		    ld hl, sfx_coin
 2991	45DE	06	05			    ld b, SFX_SHORT
 2992	45E0	CD	ED	45		    call sfx_play
 2993	45E3	C9				    ret
 2994	45E4					
 2995	45E4					play_sound_effect_damage:
 2996	45E4	21	87	45		    ld hl, sfx_damage
