 967	4145					NODE_TYPE_WORLDLINK     EQU 1    ; World link node (loads world map)
 968	4145					NODE_TYPE_WORLD_LINK    EQU 1    ; Alias with underscore (for compatibility)
 969	4145					NODE_TYPE_SCREEN        EQU 2    ; Screen node (loads specific screen)
 970	4145					NODE_TYPE_MENU          EQU 3    ; Menu node (shows menu interface)
 971	4145					NODE_TYPE_SUBMENU       EQU 3    ; Alias for menu node
 972	4145					NODE_TYPE_SUB_MENU      EQU 3    ; Alias with underscore (for compatibility)
 973	4145					NODE_TYPE_TEXT          EQU 4    ; Text node (displays text)
 974	4145					NODE_TYPE_TRANSITION    EQU 5    ; Transition node
 975	4145					NODE_TYPE_RESTART       EQU 6    ; Restart node (restart game/level)
 976	4145					NODE_TYPE_END           EQU 7    ; End node (game over, victory, credits)
 977	4145					NODE_TYPE_IF_THEN_ELSE  EQU 8    ; IfThenElse node (conditional branch)
 978	4145					NODE_TYPE_GLOBALS       EQU 9    ; Globals node (global variable ops)
 979	4145					NODE_TYPE_WAYPOINT      EQU 10   ; Waypoint node (routing marker)
 980	4145					NODE_TYPE_GROUP         EQU 11   ; Group node (nested flow)
 981	4145					NODE_TYPE_MUSIC         EQU 12   ; Music node (audio command)
 982	4145					NODE_TYPE_UNKNOWN       EQU 255  ; Unknown/unsupported node type
