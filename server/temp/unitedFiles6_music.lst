 5460	73D9					.csa_loop:
 5461	73D9	C5				    push bc
 5462	73DA	79				    ld a, c
 5463	73DB	CD	E3	73		    call clear_screen_row
 5464	73DE	C1				    pop bc
 5465	73DF	0C				    inc c
 5466	73E0	10	F7			    djnz .csa_loop
 5467	73E2	C9				    ret
 5468	73E3					
 5469	73E3					; ------------------------------------------------------------------
 5470	73E3					; Helper: Clear a screen row (fill with empty tile)
 5471	73E3					; Input: A = Row number (0-23)
 5472	73E3					; ------------------------------------------------------------------
 5473	73E3					clear_screen_row:
 5474	73E3	F5				    push af
 5475	73E4	C5				    push bc
 5476	73E5	D5				    push de
 5477	73E6	E5				    push hl
 5478	73E7					
 5479	73E7					    ; Calculate row start in name table
 5480	73E7					    ; Row address = #1800 + (row * 32)
 5481	73E7	6F				    ld l, a
 5482	73E8	26	00			    ld h, 0
 5483	73EA	29				    add hl, hl                    ; * 2
 5484	73EB	29				    add hl, hl                    ; * 4
 5485	73EC	29				    add hl, hl                    ; * 8
 5486	73ED	29				    add hl, hl                    ; * 16
 5487	73EE	29				    add hl, hl                    ; * 32
 5488	73EF					
 5489	73EF					    ; Add base address (name table)
 5490	73EF	11	00	18		    ld de, #1800                  ; Name table base (Screen 2)
 5491	73F2	19				    add hl, de                    ; HL = VRAM address
 5492	73F3					
 5493	73F3					    ; Clear 32 tiles (one row)
 5494	73F3	EB				    ex de, hl                     ; DE = VRAM destination
 5495	73F4	21	02	74		    ld hl, empty_row_data         ; HL = source (32 zeros)
 5496	73F7	01	20	00		    ld bc, 32                     ; Copy 32 bytes
 5497	73FA	CD	5C	00		    call LDIRVM
 5498	73FD					
 5499	73FD	E1				    pop hl
 5500	73FE	D1				    pop de
 5501	73FF	C1				    pop bc
 5502	7400	F1				    pop af
 5503	7401	C9				    ret
