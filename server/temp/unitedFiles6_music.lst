 3168	468E	13				    inc de
 3169	468F	1A				    ld a, (de)
 3170	4690	4F				    ld c, a
 3171	4691	13				    inc de
 3172	4692	1A				    ld a, (de)
 3173	4693	47				    ld b, a
 3174	4694	79				    ld a, c
 3175	4695	CD	99	46		    call music_play_track
 3176	4698	C9				    ret
