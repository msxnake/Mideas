 885	4145					; INPUT CONSTANTS
 886	4145					; ==================================================================
 887	4145					
 888	4145					; Joystick Directions
 889	4145					STICK_UP    EQU 1
 890	4145					STICK_UPRIGHT EQU 2
 891	4145					STICK_RIGHT EQU 3
 892	4145					STICK_DOWNRIGHT EQU 4
 893	4145					STICK_DOWN  EQU 5
 894	4145					STICK_DOWNLEFT EQU 6
 895	4145					STICK_LEFT  EQU 7
 896	4145					STICK_UPLEFT EQU 8
 897	4145					STICK_CENTER EQU 0
 898	4145					
 899	4145					; Trigger Constants
 900	4145					TRIG_A      EQU #10      ; Trigger A (Fire)
 901	4145					TRIG_B      EQU #20      ; Trigger B (MSX2+)
 902	4145					
 903	4145					; Input Button Bitmask
 904	4145					INPUT_BTN_FIRE EQU #01   ; Fire/Space button bit in input_btn_curr/input_btn_prev
 905	4145					
 906	4145					; Direction flags shared by input/state machine helpers
 907	4145					DIR_ALLOW_UP     EQU #01 ; Bit 0: Allow UP movement
 908	4145					DIR_ALLOW_DOWN   EQU #02 ; Bit 1: Allow DOWN movement
 909	4145					DIR_ALLOW_LEFT   EQU #04 ; Bit 2: Allow LEFT movement
 910	4145					DIR_ALLOW_RIGHT  EQU #08 ; Bit 3: Allow RIGHT movement
 911	4145					
 912	4145					; ==================================================================
 913	4145					; TILE BEHAVIOR CONSTANTS (for collision detection)
 914	4145					; ==================================================================
 915	4145					
 916	4145					; Tile Behavior Types (bitmask)
 917	4145					TILE_PASSABLE       EQU #00    ; No collision (air, background)
 918	4145					TILE_SOLID          EQU #01    ; Solid wall/floor (blocks all movement)
 919	4145					TILE_PLATFORM       EQU #02    ; One-way platform (solid from above only)
 920	4145					TILE_LADDER         EQU #04    ; Climbable (allows vertical movement)
 921	4145					TILE_DEADLY         EQU #08    ; Damages/kills on contact (spikes, lava)
 922	4145					TILE_WATER          EQU #10    ; Water (slows movement, swim logic)
 923	4145					TILE_ICE            EQU #20    ; Slippery surface (reduced friction)
