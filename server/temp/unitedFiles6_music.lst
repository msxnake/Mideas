 3215	46CC					; ------------------------------------------------------------------
 3216	46CC					; music_update
 3217	46CC					; Update PT3 playback. Called every frame from ISR.
 3218	46CC					; Checks end-of-song flag, handles loop/stop, runs PT3_ROUT+PT3_PLAY.
 3219	46CC					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 3220	46CC					; ------------------------------------------------------------------
 3221	46CC					music_update:
 3222	46CC	3A	46	D1		    ld a, (music_active)
 3223	46CF	B7				    or a
 3224	46D0	C8				    ret z
 3225	46D1	3A	47	D1		    ld a, (music_muted)
 3226	46D4	B7				    or a
 3227	46D5	C0				    ret nz
 3228	46D6					    ; Check if song ended (CHECKLP sets bit7 of PT3_SETUP)
 3229	46D6	3A	6D	D1		    ld a, (PT3_SETUP)
 3230	46D9	CB	7F			    bit 7, a
 3231	46DB	28	27			    jr z, .pt3_upd_play
 3232	46DD					    ; Song ended - loop or stop?
 3233	46DD	3A	48	D1		    ld a, (music_loop)
 3234	46E0	B7				    or a
 3235	46E1	28	1C			    jr z, .pt3_upd_stop
 3236	46E3					    ; Loop: reinitialise from same track
 3237	46E3	3A	49	D1		    ld a, (music_track_index)
 3238	46E6	87				    add a, a
 3239	46E7	5F				    ld e, a
 3240	46E8	16	00			    ld d, 0
 3241	46EA	21	44	4D		    ld hl, music_pt3_track_table
 3242	46ED	19				    add hl, de
 3243	46EE	5E				    ld e, (hl)
 3244	46EF	23				    inc hl
 3245	46F0	56				    ld d, (hl)
 3246	46F1	62				    ld h, d
 3247	46F2	6B				    ld l, e
 3248	46F3	DD	E5			    push ix
 3249	46F5	FD	E5			    push iy
 3250	46F7	CD	32	47		    call PT3_INIT
 3251	46FA	FD	E1			    pop iy
 3252	46FC	DD	E1			    pop ix
 3253	46FE	C9				    ret
 3254	46FF					.pt3_upd_stop:
 3255	46FF	AF				    xor a
 3256	4700	32	46	D1		    ld (music_active), a
 3257	4703	C9				    ret
 3258	4704					.pt3_upd_play:
 3259	4704	DD	E5			    push ix
 3260	4706	FD	E5			    push iy
 3261	4708	F3				    di
 3262	4709	CD	99	4B		    call PT3_PLAY
 3263	470C	CD	99	4C		    call PT3_ROUT
 3264	470F	FB				    ei
 3265	4710	FD	E1			    pop iy
 3266	4712	DD	E1			    pop ix
 3267	4714	C9				    ret
