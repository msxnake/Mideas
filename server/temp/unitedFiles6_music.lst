 1336	4145					PT3_Delay       EQU #D189   ; Song speed/delay
 1337	4145					PT3_AddToEn     EQU #D18A   ; Add to envelope
 1338	4145					PT3_Env_Del     EQU #D18B   ; Envelope delay
 1339	4145					PT3_ESldAdd     EQU #D18C   ; Envelope slide add (2 bytes)
 1340	4145					PT3_NTL3        EQU #D18E   ; Note table link 3
