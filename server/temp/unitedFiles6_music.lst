 4423	6FE8	23				    inc hl
 4424	6FE9	23				    inc hl
 4425	6FEA	23				    inc hl                      ; Offset 4: frame
 4426	6FEB	7E				    ld a, (hl)
 4427	6FEC	3C				    inc a
