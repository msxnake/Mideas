 1290	4145					music_ch_b_instrument EQU #D159   ; Channel B
 1291	4145					music_ch_c_instrument EQU #D15A   ; Channel C
 1292	4145					music_ch_ornament_base EQU #D15B   ; Current ornament id (0=none) (3 bytes)
 1293	4145					music_ch_a_ornament EQU #D15B   ; Channel A
 1294	4145					music_ch_b_ornament EQU #D15C   ; Channel B
 1295	4145					music_ch_c_ornament EQU #D15D   ; Channel C
 1296	4145					music_ch_volume_base EQU #D15E   ; Current base volume (0-15) (3 bytes)
 1297	4145					music_ch_a_volume EQU #D15E   ; Channel A
 1298	4145					music_ch_b_volume EQU #D15F   ; Channel B
 1299	4145					music_ch_c_volume EQU #D160   ; Channel C
 1300	4145					music_ch_vol_step_base EQU #D161   ; Reserved software volume envelope step (3 bytes)
 1301	4145					music_ch_a_vol_step EQU #D161   ; Channel A
 1302	4145					music_ch_b_vol_step EQU #D162   ; Channel B
 1303	4145					music_ch_c_vol_step EQU #D163   ; Channel C
