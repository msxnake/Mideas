 3684	6DBB					; Call this every frame from main loop
 3685	6DBB					; ------------------------------------------------------------------
 3686	6DBB					update_animated_tiles:
 3687	6DBB					    ; Increment timer
 3688	6DBB	3A	31	C6		    ld a, (anim_tile_timer)
 3689	6DBE	3C				    inc a
 3690	6DBF	32	31	C6		    ld (anim_tile_timer), a
 3691	6DC2					
 3692	6DC2					    ; Check if it's time to advance frame
 3693	6DC2	47				    ld b, a
 3694	6DC3	3A	33	C6		    ld a, (anim_tile_speed)
 3695	6DC6	B7				    or a
 3696	6DC7	20	05			    jr nz, .anim_speed_ok
 3697	6DC9	3E	01			    ld a, 1
 3698	6DCB	32	33	C6		    ld (anim_tile_speed), a
 3699	6DCE					.anim_speed_ok:
 3700	6DCE	B8				    cp b
 3701	6DCF	D0				    ret nc                          ; Not yet time to update (timer < speed)
 3702	6DD0					
 3703	6DD0					    ; Reset timer
 3704	6DD0	AF				    xor a
 3705	6DD1	32	31	C6		    ld (anim_tile_timer), a
 3706	6DD4					
