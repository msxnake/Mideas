 1819	425C	12				    ld (de), a                  ; Write low byte
 1820	425D	13				    inc de
 1821	425E	7C				    ld a, h
 1822	425F	12				    ld (de), a                  ; Write high byte
 1823	4260					
 1824	4260	C9				    ret
