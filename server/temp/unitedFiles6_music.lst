 3946	6E8F	D1				    pop de
 3947	6E90	C1				    pop bc
 3948	6E91					
 3949	6E91					    ; Color bank 1
 3950	6E91	C5				    push bc
 3951	6E92	D5				    push de
 3952	6E93	21	00	28		    ld hl, CLRTBL2 + #800
 3953	6E96	09				    add hl, bc
 3954	6E97	CD	AB	6E		    call anim_transform_vram_block
 3955	6E9A	D1				    pop de
 3956	6E9B	C1				    pop bc
 3957	6E9C					
 3958	6E9C					    ; Color bank 2
 3959	6E9C	C5				    push bc
 3960	6E9D	D5				    push de
 3961	6E9E	21	00	30		    ld hl, CLRTBL2 + #1000
 3962	6EA1	09				    add hl, bc
 3963	6EA2	CD	AB	6E		    call anim_transform_vram_block
 3964	6EA5	D1				    pop de
 3965	6EA6	C1				    pop bc
 3966	6EA7					
 3967	6EA7					.anim_transform_char_done:
 3968	6EA7	E1				    pop hl
 3969	6EA8	D1				    pop de
