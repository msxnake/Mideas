 3066	4625					; ==================================================================
 3067	4625					; PT3 MUSIC BACKEND
 3068	4625					; Uses the PT3 replayer for AY-3-8910 music playback.
 3069	4625					; PT3_SETUP, ChanA, AYREGS, etc. are defined in variables.asm.
 3070	4625					; ==================================================================
 3071	4625					
 3072	4625					; ------------------------------------------------------------------
 3073	4625					; music_init_system
 3074	4625					; Reset PT3 music state. Call once at startup.
 3075	4625					; Destroys: AF
 3076	4625					; ------------------------------------------------------------------
 3077	4625					music_init_system:
 3078	4625	AF				    xor a
 3079	4626	32	46	D1		    ld (music_active), a
 3080	4629	32	47	D1		    ld (music_muted), a
 3081	462C	32	48	D1		    ld (music_loop), a
 3082	462F	32	49	D1		    ld (music_track_index), a
 3083	4632	32	6D	D1		    ld (PT3_SETUP), a
 3084	4635	C9				    ret
 3085	4636					
 3086	4636					; ------------------------------------------------------------------
 3087	4636					; music_silence_channels
 3088	4636					; Silence all AY channels via BIOS WRTPSG.
 3089	4636					; Destroys: AF, E
 3090	4636					; ------------------------------------------------------------------
 3091	4636					music_silence_channels:
 3092	4636	AF				    xor a
 3093	4637	47				    ld b, a
 3094	4638	CD	DE	44		    call psg_set_volume     ; Channel A vol=0
 3095	463B	3E	01			    ld a, 1
 3096	463D	06	00			    ld b, 0
 3097	463F	CD	DE	44		    call psg_set_volume     ; Channel B vol=0
 3098	4642	3E	02			    ld a, 2
 3099	4644	06	00			    ld b, 0
 3100	4646	CD	DE	44		    call psg_set_volume     ; Channel C vol=0
 3101	4649	3E	07			    ld a, PSG_MIXER
 3102	464B	1E	3F			    ld e, #3F
 3103	464D	CD	93	00		    call WRTPSG             ; All tones+noise off
 3104	4650	C9				    ret
