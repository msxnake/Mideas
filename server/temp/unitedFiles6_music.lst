 4414	6FE2					
 4415	6FE2					    ; Decrement lifetime
 4416	6FE2	23				    inc hl                      ; Offset 1: lifetime
 4417	6FE3	7E				    ld a, (hl)
 4418	6FE4	3D				    dec a
 4419	6FE5	77				    ld (hl), a
 4420	6FE6	28	46			    jr z, .part_update_kill     ; Lifetime expired
 4421	6FE8					
