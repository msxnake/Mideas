 2476	4451					    ; Calculate base address for sprite: index * 4
 2477	4451	6F				    ld l, a
 2478	4452	26	00			    ld h, 0
 2479	4454	29				    add hl, hl      ; index * 2
 2480	4455	29				    add hl, hl      ; index * 4
