 4587	7069					
 4588	7069					    ; Calculate name table address
 4589	7069	79				    ld a, c
 4590	706A	87				    add a, a
 4591	706B	87				    add a, a
 4592	706C	87				    add a, a
 4593	706D	87				    add a, a
 4594	706E	87				    add a, a                    ; Y * 32
 4595	706F	80				    add a, b
 4596	7070	5F				    ld e, a
 4597	7071	16	00			    ld d, 0
 4598	7073	21	00	18		    ld hl, NAMETBL
 4599	7076	19				    add hl, de
 4600	7077					
 4601	7077					    ; Write 0 (blank tile)
 4602	7077	AF				    xor a
 4603	7078	CD	4D	00		    call WRTVRM
 4604	707B					
 4605	707B	E1				    pop hl
 4606	707C	C9				    ret
 4607	707D					
 4608	707D					; ------------------------------------------------------------------
 4609	707D					; update_particle_pattern
 4610	707D					; Redefine particle's pattern in VRAM based on type and frame
 4611	707D					; Input:  HL = Address of particle structure
 4612	707D					; Destroys: AF, BC, DE, HL
 4613	707D					; ------------------------------------------------------------------
 4614	707D					update_particle_pattern:
 4615	707D					    ; Get type and frame
 4616	707D	7E				    ld a, (hl)                  ; Offset 0: type
 4617	707E	47				    ld b, a                     ; B = type
 4618	707F	23				    inc hl
 4619	7080	23				    inc hl
 4620	7081	23				    inc hl
 4621	7082	23				    inc hl
 4622	7083	7E				    ld a, (hl)                  ; Offset 4: frame
 4623	7084	4F				    ld c, a                     ; C = frame
 4624	7085	2B				    dec hl
 4625	7086	2B				    dec hl
 4626	7087	23				    inc hl
 4627	7088	7E				    ld a, (hl)                  ; Offset 5: tile ID
 4628	7089	57				    ld d, a                     ; D = tile ID
 4629	708A					
 4630	708A					    ; Calculate pattern source address
 4631	708A					    ; particle_patterns + (type * 32) + (frame * 8)
 4632	708A	78				    ld a, b                     ; A = type
 4633	708B	87				    add a, a
 4634	708C	87				    add a, a
 4635	708D	87				    add a, a
 4636	708E	87				    add a, a
 4637	708F	87				    add a, a                    ; * 32 (4 frames * 8 bytes)
 4638	7090	6F				    ld l, a
 4639	7091	26	00			    ld h, 0
 4640	7093					
 4641	7093	79				    ld a, c                     ; A = frame
 4642	7094	87				    add a, a
 4643	7095	87				    add a, a
 4644	7096	87				    add a, a                    ; * 8
 4645	7097	5F				    ld e, a
 4646	7098	16	00			    ld d, 0
 4647	709A	19				    add hl, de
 4648	709B					
 4649	709B	11	B3	70		    ld de, particle_patterns
 4650	709E	19				    add hl, de                  ; HL = source pattern address
 4651	709F					
 4652	709F					    ; Calculate VRAM destination
 4653	709F					    ; CHRTBL + (tile_id * 8)
 4654	709F	7A				    ld a, d                     ; A = tile ID
 4655	70A0	5F				    ld e, a
 4656	70A1	16	00			    ld d, 0
 4657	70A3	EB				    ex de, hl                   ; DE = source, HL = tile_id
 4658	70A4	29				    add hl, hl
 4659	70A5	29				    add hl, hl
 4660	70A6	29				    add hl, hl                  ; * 8
 4661	70A7	01	00	00		    ld bc, CHRTBL
 4662	70AA	09				    add hl, bc                  ; HL = VRAM address
 4663	70AB					
 4664	70AB	EB				    ex de, hl                   ; DE = VRAM, HL = source
 4665	70AC					
 4666	70AC					    ; Copy 8 bytes to VRAM
 4667	70AC	01	08	00		    ld bc, 8
 4668	70AF	CD	5C	00		    call LDIRVM
 4669	70B2					
 4670	70B2	C9				    ret
