 3459	6D32					; ------------------------------------------------------------------
 3460	6D32					; move_camera
 3461	6D32					; Move camera by delta (relative movement)
 3462	6D32					; Input:  B = delta X (signed), C = delta Y (signed)
 3463	6D32					; Destroys: AF, BC, DE, HL
 3464	6D32					; ------------------------------------------------------------------
 3465	6D32					move_camera:
 3466	6D32					    ; Get current camera position
 3467	6D32	3A	27	C6		    ld a, (camera_x)
 3468	6D35	6F				    ld l, a
 3469	6D36	3A	28	C6		    ld a, (camera_x + 1)
 3470	6D39	67				    ld h, a                     ; HL = camera X
 3471	6D3A					
 3472	6D3A	3A	29	C6		    ld a, (camera_y)
 3473	6D3D	5F				    ld e, a
 3474	6D3E	3A	2A	C6		    ld a, (camera_y + 1)
 3475	6D41	57				    ld d, a                     ; DE = camera Y
 3476	6D42					
