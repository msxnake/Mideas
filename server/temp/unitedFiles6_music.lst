 2933	4599					
 2934	4599					; ==================================================================
 2935	4599					; SOUND EFFECT PLAYBACK SYSTEM
 2936	4599					; ==================================================================
 2937	4599					; This section provides a simple sound effect manager that can
 2938	4599					; play effects with automatic duration and fadeout
 2939	4599					
 2940	4599					; Runtime state lives in variables.asm:
 2941	4599					;   sfx_active, sfx_timer, sfx_fadeout
 2942	4599					
 2943	4599					; ------------------------------------------------------------------
 2944	4599					; play_sound_effect
 2945	4599					; Play one of the built-in sound effects by ID
 2946	4599					; Input:  A = sound ID
 2947	4599					;         0=beep, 1=jump, 2=shoot, 3=explosion, 4=coin, 5=damage
 2948	4599					; Destroys: AF, BC, DE, HL
 2949	4599					; ------------------------------------------------------------------
 2950	4599					play_sound_effect:
 2951	4599	3A	46	D1		    ld a, (music_active)
 2952	459C	B7				    or a
 2953	459D	C0				    ret nz
 2954	459E	FE	01			    cp 1
 2955	45A0	CA	C0	45		    jp z, play_sound_effect_jump
 2956	45A3	FE	02			    cp 2
 2957	45A5	CA	C9	45		    jp z, play_sound_effect_shoot
 2958	45A8	FE	03			    cp 3
 2959	45AA	CA	D2	45		    jp z, play_sound_effect_explosion
 2960	45AD	FE	04			    cp 4
 2961	45AF	CA	DB	45		    jp z, play_sound_effect_coin
 2962	45B2	FE	05			    cp 5
 2963	45B4	CA	E4	45		    jp z, play_sound_effect_damage
 2964	45B7					
 2965	45B7					play_sound_effect_beep:
 2966	45B7	21	23	45		    ld hl, sfx_beep
 2967	45BA	06	05			    ld b, SFX_SHORT
 2968	45BC	CD	ED	45		    call sfx_play
 2969	45BF	C9				    ret
 2970	45C0					
 2971	45C0					play_sound_effect_jump:
 2972	45C0	21	36	45		    ld hl, sfx_jump
 2973	45C3	06	05			    ld b, SFX_SHORT
 2974	45C5	CD	ED	45		    call sfx_play
 2975	45C8	C9				    ret
 2976	45C9					
 2977	45C9					play_sound_effect_shoot:
 2978	45C9	21	49	45		    ld hl, sfx_shoot
 2979	45CC	06	05			    ld b, SFX_SHORT
 2980	45CE	CD	ED	45		    call sfx_play
 2981	45D1	C9				    ret
 2982	45D2					
 2983	45D2					play_sound_effect_explosion:
 2984	45D2	21	61	45		    ld hl, sfx_explosion
