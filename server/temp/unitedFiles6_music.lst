 185	4082					; From: http://www.z80st.es/downloads/code/
 186	4082					; SETPAGES32K:  BIOS-ROM-YY-ZZ   -> BIOS-ROM-ROM-ZZ (SITUA PAGINA 2)
 187	4082					SETPAGES32K:    ; --- Posiciona las paginas de un megarom o un 32K ---
 188	4082	3E	C9			    ld  a, #C9              ; Codigo de RET
 189	4084	32	87	40		    ld  (SETPAGES32K_NOPRET), a   ; Modificamos la siguiente instruccion si estamos en RAM
 190	4087					SETPAGES32K_NOPRET:
 191	4087	00				    nop                     ; No hacemos nada si no estamos en RAM
 192	4088					    ; --- Si llegamos aqui no estamos en RAM, hay que posicionar la pagina ---
 193	4088	CD	38	01		    call RSLREG             ; Leemos el contenido del registro de seleccion de slots
 194	408B	0F				    rrca                    ; Rotamos a la derecha...
 195	408C	0F				    rrca                    ; ...dos veces
 196	408D	CD	69	40		    call GETSLOT            ; Obtenemos el slot de la pagina 1 ($4000-$BFFF)
 197	4090	32	11	C0		    ld (ROM_slot), a        ; Save slot for later use
 198	4093	26	80			    ld  h, #80              ; Seleccionamos pagina 2 ($8000-$BFFF)
 199	4095	C3	24	00		    jp  ENASLT              ; Posicionamos la pagina 2 y volvemos
