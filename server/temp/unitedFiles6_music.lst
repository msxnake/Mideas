 2482	4456	11	40	CB		    ld de, sprite_attributes
 2483	4459	19				    add hl, de      ; HL = &sprite_attributes[index * 4]
 2484	445A					
 2485	445A					    ; Restore pattern and color
 2486	445A	D1				    pop de
 2487	445B					
 2488	445B					    ; Write attributes
 2489	445B	71				    ld (hl), c      ; Y
 2490	445C	23				    inc hl
 2491	445D	70				    ld (hl), b      ; X
 2492	445E	23				    inc hl
 2493	445F	72				    ld (hl), d      ; Pattern
 2494	4460	23				    inc hl
 2495	4461	73				    ld (hl), e      ; Color
