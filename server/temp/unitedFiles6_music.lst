 2460	4444					    ; Safety check: Ensure sprite index < 32
 2461	4444	FE	20			    cp 32
 2462	4446	D0				    ret nc
 2463	4447					
 2464	4447					    ; Safety check: Never write Y >= 208 (208 is SAT end marker on MSX)
 2465	4447	F5				    push af
 2466	4448	79				    ld a, c
 2467	4449	FE	D0			    cp 208
 2468	444B	38	02			    jr c, .y_ok
 2469	444D	0E	E0			    ld c, SPRITE_INVISIBLE
 2470	444F					.y_ok:
 2471	444F	F1				    pop af
 2472	4450					
 2473	4450					    ; Save pattern (D) and color (E) before calculating address
 2474	4450	D5				    push de
