 3341	6CBE					; set_camera_position
 3342	6CBE					; Set camera position in pixels (with bounds checking)
 3343	6CBE					; Input:  HL = X position (pixels), DE = Y position (pixels)
 3344	6CBE					; Destroys: AF, BC
 3345	6CBE					; ------------------------------------------------------------------
 3346	6CBE					set_camera_position:
 3347	6CBE					    ; Bounds check X
 3348	6CBE	E5				    push hl
 3349	6CBF	D5				    push de
 3350	6CC0					
 3351	6CC0					    ; Calculate max X = (world_width_tiles - SCREEN_WIDTH_TILES) * TILE_WIDTH
 3352	6CC0	3A	2D	C6		    ld a, (world_width_tiles)
 3353	6CC3	D6	20			    sub SCREEN_WIDTH_TILES
 3354	6CC5	38	1A			    jr c, .scroll_x_in_bounds   ; World smaller than screen
 3355	6CC7					
 3356	6CC7					    ; A = tiles to scroll, multiply by tile width
 3357	6CC7	47				    ld b, a
 3358	6CC8	3E	08			    ld a, 8
 3359	6CCA	CD	A0	6D		    call multiply_a_by_b        ; HL = max X
 3360	6CCD					
 3361	6CCD					    ; Compare camera X with max X
 3362	6CCD	D1				    pop de
 3363	6CCE	C1				    pop bc                      ; BC = requested X
 3364	6CCF	C5				    push bc
 3365	6CD0	D5				    push de
 3366	6CD1					
 3367	6CD1					    ; If requested X > max X, clamp to max X
 3368	6CD1	78				    ld a, b
 3369	6CD2	BC				    cp h
 3370	6CD3	38	08			    jr c, .scroll_x_clamped
 3371	6CD5	20	0A			    jr nz, .scroll_x_in_bounds
 3372	6CD7	79				    ld a, c
 3373	6CD8	BD				    cp l
 3374	6CD9	38	02			    jr c, .scroll_x_clamped
 3375	6CDB	18	04			    jr .scroll_x_in_bounds
 3376	6CDD					
 3377	6CDD					.scroll_x_clamped:
 3378	6CDD	44				    ld b, h
 3379	6CDE	4D				    ld c, l
 3380	6CDF	18	04			    jr .scroll_x_done
 3381	6CE1					
 3382	6CE1					.scroll_x_in_bounds:
 3383	6CE1	D1				    pop de
 3384	6CE2	C1				    pop bc
 3385	6CE3	C5				    push bc
 3386	6CE4	D5				    push de
 3387	6CE5					
 3388	6CE5					.scroll_x_done:
 3389	6CE5					    ; Store camera X
 3390	6CE5	79				    ld a, c
 3391	6CE6	32	27	C6		    ld (camera_x), a
 3392	6CE9	78				    ld a, b
 3393	6CEA	32	28	C6		    ld (camera_x + 1), a
 3394	6CED					
 3395	6CED					    ; Calculate camera_tile_x = camera_x / TILE_WIDTH
 3396	6CED					    
 3397	6CED					    ; Tile width is 8, shift right 3 times
 3398	6CED	79				    ld a, c
 3399	6CEE	CB	38			    srl b
 3400	6CF0	1F				    rra
 3401	6CF1	CB	38			    srl b
 3402	6CF3	1F				    rra
 3403	6CF4	CB	38			    srl b
 3404	6CF6	1F				    rra
 3405	6CF7	32	2B	C6		    ld (camera_tile_x), a
 3406	6CFA					
 3407	6CFA					    ; Bounds check Y
 3408	6CFA	D1				    pop de                      ; DE = requested Y
 3409	6CFB	C1				    pop bc
 3410	6CFC					
 3411	6CFC					    ; Calculate max Y = (world_height_tiles - SCREEN_HEIGHT_TILES) * TILE_HEIGHT
 3412	6CFC	3A	2E	C6		    ld a, (world_height_tiles)
 3413	6CFF	D6	18			    sub SCREEN_HEIGHT_TILES
 3414	6D01	38	14			    jr c, .scroll_y_in_bounds   ; World smaller than screen
 3415	6D03					
 3416	6D03	47				    ld b, a
 3417	6D04	3E	08			    ld a, 8
 3418	6D06	CD	A0	6D		    call multiply_a_by_b        ; HL = max Y
 3419	6D09					
 3420	6D09					    ; If requested Y > max Y, clamp to max Y
 3421	6D09	7A				    ld a, d
 3422	6D0A	BC				    cp h
 3423	6D0B	38	08			    jr c, .scroll_y_clamped
 3424	6D0D	20	08			    jr nz, .scroll_y_in_bounds
 3425	6D0F	7B				    ld a, e
 3426	6D10	BD				    cp l
 3427	6D11	38	02			    jr c, .scroll_y_clamped
 3428	6D13	18	02			    jr .scroll_y_in_bounds
 3429	6D15					
 3430	6D15					.scroll_y_clamped:
 3431	6D15	54				    ld d, h
 3432	6D16	5D				    ld e, l
 3433	6D17					
 3434	6D17					.scroll_y_in_bounds:
 3435	6D17					    ; Store camera Y
 3436	6D17	7B				    ld a, e
 3437	6D18	32	29	C6		    ld (camera_y), a
 3438	6D1B	7A				    ld a, d
 3439	6D1C	32	2A	C6		    ld (camera_y + 1), a
 3440	6D1F					
 3441	6D1F					    ; Calculate camera_tile_y = camera_y / TILE_HEIGHT
 3442	6D1F					    
 3443	6D1F					    ; Tile height is 8, shift right 3 times
 3444	6D1F	7B				    ld a, e
 3445	6D20	CB	3A			    srl d
 3446	6D22	1F				    rra
 3447	6D23	CB	3A			    srl d
 3448	6D25	1F				    rra
 3449	6D26	CB	3A			    srl d
 3450	6D28	1F				    rra
 3451	6D29	32	2C	C6		    ld (camera_tile_y), a
 3452	6D2C					
 3453	6D2C					    ; Mark viewport as dirty (needs redraw)
 3454	6D2C	3E	01			    ld a, 1
 3455	6D2E	32	2F	C6		    ld (scroll_dirty_flag), a
