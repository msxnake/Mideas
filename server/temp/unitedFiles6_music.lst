 4198	6F64					
 4199	6F64					; ==================================================================
 4200	6F64					; PARTICLE SYSTEM (VRAM Pattern Redefinition)
 4201	6F64					; File: particles.asm
 4202	6F64					; Description: Visual effects using dynamic tile pattern updates
 4203	6F64					; ==================================================================
 4204	6F64					
 4205	6F64					; ==================================================================
 4206	6F64					; PARTICLE SYSTEM CONSTANTS
 4207	6F64					; ==================================================================
 4208	6F64					
 4209	6F64					; Maximum active particles
 4210	6F64					MAX_PARTICLES           EQU 8       ; Support up to 8 simultaneous particles
 4211	6F64					
 4212	6F64					; Reserved tile IDs for particles (248-255)
 4213	6F64					PARTICLE_TILE_BASE      EQU 248     ; First tile ID for particles
 4214	6F64					
 4215	6F64					; Particle types
 4216	6F64					PARTICLE_NONE           EQU 0       ; Inactive particle slot
 4217	6F64					PARTICLE_EXPLOSION      EQU 1       ; Explosion (4 frames, expands outward)
 4218	6F64					PARTICLE_SMOKE          EQU 2       ; Smoke puff (4 frames, rises up)
 4219	6F64					PARTICLE_SPARK          EQU 3       ; Spark/flash (2 frames, quick)
 4220	6F64					PARTICLE_DUST           EQU 4       ; Dust cloud (3 frames, fades)
 4221	6F64					PARTICLE_IMPACT         EQU 5       ; Impact star (3 frames, shrinks)
 4222	6F64					PARTICLE_DEBRIS         EQU 6       ; Debris chunk (2 frames, falls)
 4223	6F64					PARTICLE_MUZZLE_FLASH   EQU 7       ; Muzzle flash (2 frames, instant)
 4224	6F64					PARTICLE_WATER_SPLASH   EQU 8       ; Water splash (4 frames, arcs)
 4225	6F64					
 4226	6F64					; Particle lifetimes (in frames)
 4227	6F64					LIFE_EXPLOSION          EQU 16      ; ~267ms
 4228	6F64					LIFE_SMOKE              EQU 24      ; ~400ms
 4229	6F64					LIFE_SPARK              EQU 8       ; ~133ms
 4230	6F64					LIFE_DUST               EQU 12      ; ~200ms
 4231	6F64					LIFE_IMPACT             EQU 10      ; ~167ms
 4232	6F64					LIFE_DEBRIS             EQU 20      ; ~333ms
 4233	6F64					LIFE_MUZZLE_FLASH       EQU 4       ; ~67ms (very quick)
 4234	6F64					LIFE_WATER_SPLASH       EQU 18      ; ~300ms
 4235	6F64					
 4236	6F64					; Particle pool structure (8 bytes per particle)
 4237	6F64					; Offset 0: Type (PARTICLE_*)
 4238	6F64					; Offset 1: Lifetime remaining (frames)
 4239	6F64					; Offset 2: X position (screen coords, 0-31 tiles)
 4240	6F64					; Offset 3: Y position (screen coords, 0-23 tiles)
 4241	6F64					; Offset 4: Animation frame (0-3)
 4242	6F64					; Offset 5: Tile ID assigned (248-255)
 4243	6F64					; Offset 6: Velocity X (signed, -128 to 127)
 4244	6F64					; Offset 7: Velocity Y (signed, -128 to 127)
 4245	6F64					
 4246	6F64					PARTICLE_STRUCT_SIZE    EQU 8
 4247	6F64					
 4248	6F64					; ==================================================================
 4249	6F64					; PARTICLE SYSTEM INITIALIZATION
 4250	6F64					; ==================================================================
 4251	6F64					
 4252	6F64					init_particle_system:
 4253	6F64					    ; Clear particle pool
 4254	6F64	21	3E	C6		    ld hl, particle_pool
 4255	6F67	11	3F	C6		    ld de, particle_pool + 1
 4256	6F6A	01	3F	00		    ld bc, MAX_PARTICLES * PARTICLE_STRUCT_SIZE - 1
 4257	6F6D	36	00			    ld (hl), PARTICLE_NONE
 4258	6F6F	ED	B0			    ldir
 4259	6F71					
 4260	6F71					    ; Initialize tile ID assignments
 4261	6F71	3E	F8			    ld a, PARTICLE_TILE_BASE
 4262	6F73	06	08			    ld b, MAX_PARTICLES
 4263	6F75	21	43	C6		    ld hl, particle_pool + 5    ; Offset to tile_id field
 4264	6F78					.part_init_tile_loop:
 4265	6F78	77				    ld (hl), a
 4266	6F79	3C				    inc a
 4267	6F7A	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 4268	6F7D	19				    add hl, de
 4269	6F7E	10	F8			    djnz .part_init_tile_loop
 4270	6F80					
 4271	6F80	C9				    ret
 4272	6F81					
 4273	6F81					; ==================================================================
 4274	6F81					; PARTICLE SPAWNING FUNCTIONS
 4275	6F81					; ==================================================================
 4276	6F81					
 4277	6F81					; ------------------------------------------------------------------
 4278	6F81					; spawn_particle
 4279	6F81					; Create a new particle at given position
 4280	6F81					; Input:  A = Particle type (PARTICLE_*)
 4281	6F81					;         B = X position (tile coords, 0-31)
 4282	6F81					;         C = Y position (tile coords, 0-23)
 4283	6F81					;         D = Velocity X (optional, signed)
 4284	6F81					;         E = Velocity Y (optional, signed)
 4285	6F81					; Output: A = 1 if spawned successfully, 0 if pool full
 4286	6F81					; Destroys: AF, BC, DE, HL
 4287	6F81					; ------------------------------------------------------------------
 4288	6F81					spawn_particle:
 4289	6F81	F5				    push af                     ; Save particle type
 4290	6F82	C5				    push bc                     ; Save position
 4291	6F83	D5				    push de                     ; Save velocity
 4292	6F84					
 4293	6F84					    ; Find free particle slot
 4294	6F84	CD	B1	6F		    call find_free_particle
 4295	6F87	28	23			    jr z, .part_spawn_failed    ; Z flag set = no free slots
 4296	6F89					
 4297	6F89					    ; HL points to free particle structure
 4298	6F89	D1				    pop de                      ; Restore velocity
 4299	6F8A	C1				    pop bc                      ; Restore position
 4300	6F8B	F1				    pop af                      ; Restore type
 4301	6F8C					
 4302	6F8C					    ; Fill particle structure
 4303	6F8C	77				    ld (hl), a                  ; Offset 0: type
 4304	6F8D	23				    inc hl
 4305	6F8E					
 4306	6F8E					    ; Set lifetime based on type
 4307	6F8E	E5				    push hl
 4308	6F8F	CD	C4	6F		    call get_particle_lifetime  ; A = type -> A = lifetime
 4309	6F92	E1				    pop hl
 4310	6F93	77				    ld (hl), a                  ; Offset 1: lifetime
 4311	6F94	23				    inc hl
 4312	6F95					
 4313	6F95	70				    ld (hl), b                  ; Offset 2: X position
 4314	6F96	23				    inc hl
 4315	6F97	71				    ld (hl), c                  ; Offset 3: Y position
 4316	6F98	23				    inc hl
 4317	6F99					
 4318	6F99	AF				    xor a
 4319	6F9A	77				    ld (hl), a                  ; Offset 4: frame = 0
 4320	6F9B	23				    inc hl
 4321	6F9C	23				    inc hl                      ; Skip tile_id (already assigned)
 4322	6F9D					
 4323	6F9D	72				    ld (hl), d                  ; Offset 6: velocity X
 4324	6F9E	23				    inc hl
 4325	6F9F	73				    ld (hl), e                  ; Offset 7: velocity Y
 4326	6FA0					
 4327	6FA0					    ; Place particle tile on screen immediately
 4328	6FA0	2B				    dec hl
 4329	6FA1	2B				    dec hl
 4330	6FA2	2B				    dec hl
 4331	6FA3	2B				    dec hl
 4332	6FA4	2B				    dec hl
 4333	6FA5	2B				    dec hl                      ; Back to start of structure
 4334	6FA6	CD	40	70		    call draw_particle_tile
 4335	6FA9					
 4336	6FA9	3E	01			    ld a, 1                     ; Success
 4337	6FAB	C9				    ret
 4338	6FAC					
 4339	6FAC					.part_spawn_failed:
 4340	6FAC	D1				    pop de
 4341	6FAD	C1				    pop bc
 4342	6FAE	F1				    pop af
 4343	6FAF	AF				    xor a                       ; Failed
 4344	6FB0	C9				    ret
 4345	6FB1					
 4346	6FB1					; ------------------------------------------------------------------
 4347	6FB1					; find_free_particle
 4348	6FB1					; Find first inactive particle slot
 4349	6FB1					; Output: HL = Address of free particle, Z flag clear
 4350	6FB1					;         Z flag set if no free slots
 4351	6FB1					; ------------------------------------------------------------------
 4352	6FB1					find_free_particle:
 4353	6FB1	21	3E	C6		    ld hl, particle_pool
 4354	6FB4	06	08			    ld b, MAX_PARTICLES
 4355	6FB6					.part_find_loop:
 4356	6FB6	7E				    ld a, (hl)
 4357	6FB7	FE	00			    cp PARTICLE_NONE
 4358	6FB9	C8				    ret z                       ; Found free slot
 4359	6FBA					
 4360	6FBA	11	08	00		    ld de, PARTICLE_STRUCT_SIZE
 4361	6FBD	19				    add hl, de
 4362	6FBE	10	F6			    djnz .part_find_loop
 4363	6FC0					
 4364	6FC0					    ; No free slot found
 4365	6FC0	AF				    xor a
 4366	6FC1	F6	01			    or 1                        ; Clear Z flag
 4367	6FC3	C9				    ret
 4368	6FC4					
 4369	6FC4					; ------------------------------------------------------------------
 4370	6FC4					; get_particle_lifetime
 4371	6FC4					; Get default lifetime for particle type
 4372	6FC4					; Input:  A = Particle type
 4373	6FC4					; Output: A = Lifetime in frames
 4374	6FC4					; ------------------------------------------------------------------
 4375	6FC4					get_particle_lifetime:
 4376	6FC4	21	CD	6F		    ld hl, particle_lifetime_table
 4377	6FC7	5F				    ld e, a
 4378	6FC8	16	00			    ld d, 0
 4379	6FCA	19				    add hl, de
 4380	6FCB	7E				    ld a, (hl)
 4381	6FCC	C9				    ret
 4382	6FCD					
 4383	6FCD					particle_lifetime_table:
 4384	6FCD	00				    db 0                        ; PARTICLE_NONE
 4385	6FCE	10				    db LIFE_EXPLOSION           ; PARTICLE_EXPLOSION
 4386	6FCF	18				    db LIFE_SMOKE               ; PARTICLE_SMOKE
 4387	6FD0	08				    db LIFE_SPARK               ; PARTICLE_SPARK
 4388	6FD1	0C				    db LIFE_DUST                ; PARTICLE_DUST
 4389	6FD2	0A				    db LIFE_IMPACT              ; PARTICLE_IMPACT
