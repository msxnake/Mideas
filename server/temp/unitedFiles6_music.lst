 3187	469C	78				    ld a, b
 3188	469D	E6	01			    and 1
 3189	469F	32	48	D1		    ld (music_loop), a
 3190	46A2	3A	49	D1		    ld a, (music_track_index)
 3191	46A5	87				    add a, a               ; *2 (DW entries)
 3192	46A6	5F				    ld e, a
 3193	46A7	16	00			    ld d, 0
 3194	46A9	21	44	4D		    ld hl, music_pt3_track_table
 3195	46AC	19				    add hl, de
 3196	46AD	5E				    ld e, (hl)
 3197	46AE	23				    inc hl
 3198	46AF	56				    ld d, (hl)
 3199	46B0	62				    ld h, d
 3200	46B1	6B				    ld l, e                ; HL = adjusted module address
 3201	46B2	AF				    xor a
 3202	46B3	32	47	D1		    ld (music_muted), a
 3203	46B6	32	6D	D1		    ld (PT3_SETUP), a      ; Clear end-of-song flag
 3204	46B9	F3				    di                     ; Disable interrupts while initialising PT3
 3205	46BA	DD	E5			    push ix
 3206	46BC	FD	E5			    push iy
 3207	46BE	CD	32	47		    call PT3_INIT
 3208	46C1	FD	E1			    pop iy
 3209	46C3	DD	E1			    pop ix
 3210	46C5	3E	01			    ld a, 1
 3211	46C7	32	46	D1		    ld (music_active), a   ; Enable playback AFTER PT3 is fully initialised
 3212	46CA	FB				    ei
 3213	46CB	C9				    ret
