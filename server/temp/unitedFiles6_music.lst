 3315	6C9C					    ; Initialize camera to (0, 0)
 3316	6C9C	AF				    xor a
 3317	6C9D	32	27	C6		    ld (camera_x), a
 3318	6CA0	32	28	C6		    ld (camera_x + 1), a
