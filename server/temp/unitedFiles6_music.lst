 853	4145					
 854	4145					; No tiles detected - using MSX default character size
 855	4145					TILE_WIDTH      EQU 8    ; Default: 8x8 pixels per MSX character
 856	4145					TILE_HEIGHT     EQU 8    ; Default: 8x8 pixels per MSX character
 857	4145					SCREEN_TILES_X  EQU 32   ; Horizontal tiles (Screen 1/2)
 858	4145					SCREEN_TILES_Y  EQU 24   ; Vertical tiles
 859	4145					MSX_CHARS_PER_TILE_X EQU 1   ; 1 MSX character per tile
 860	4145					MSX_CHARS_PER_TILE_Y EQU 1   ; 1 MSX character per tile
