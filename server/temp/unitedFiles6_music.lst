 4526	7040					; draw_particle_tile
 4527	7040					; Draw particle at its position using its tile ID
 4528	7040					; Input:  HL = Address of particle structure
 4529	7040					; Destroys: AF, BC, DE, HL
 4530	7040					; ------------------------------------------------------------------
 4531	7040					draw_particle_tile:
 4532	7040	E5				    push hl
 4533	7041					
 4534	7041					    ; Get position (offsets 2, 3)
 4535	7041	23				    inc hl
 4536	7042	23				    inc hl
 4537	7043	46				    ld b, (hl)                  ; B = X tile
 4538	7044	23				    inc hl
 4539	7045	4E				    ld c, (hl)                  ; C = Y tile
 4540	7046					
 4541	7046					    ; Get tile ID (offset 5)
 4542	7046	23				    inc hl
 4543	7047	23				    inc hl
 4544	7048	7E				    ld a, (hl)                  ; A = tile ID
 4545	7049					
 4546	7049					    ; Calculate name table address
 4547	7049					    ; NAMETBL + (Y * 32) + X
 4548	7049	F5				    push af                     ; Save tile ID
 4549	704A	79				    ld a, c
 4550	704B	87				    add a, a
 4551	704C	87				    add a, a
 4552	704D	87				    add a, a
 4553	704E	87				    add a, a
 4554	704F	87				    add a, a                    ; Y * 32
 4555	7050	80				    add a, b                    ; + X
 4556	7051	5F				    ld e, a
 4557	7052	16	00			    ld d, 0
 4558	7054	21	00	18		    ld hl, NAMETBL
 4559	7057	19				    add hl, de                  ; HL = VRAM address
 4560	7058					
 4561	7058					    ; Write tile ID to name table
 4562	7058	F1				    pop af                      ; Restore tile ID
 4563	7059	CD	4D	00		    call WRTVRM
 4564	705C					
 4565	705C					    ; Now update pattern in VRAM
 4566	705C	E1				    pop hl
 4567	705D	E5				    push hl
 4568	705E	CD	7D	70		    call update_particle_pattern
 4569	7061					
 4570	7061	E1				    pop hl
 4571	7062	C9				    ret
