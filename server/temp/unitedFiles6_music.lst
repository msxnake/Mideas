 4699	70FB					    ; Frame 1: Expanding
 4700	70FB	00	7E	FF	C3	C3	FF	7E	00	    db #00, #7E, #FF, #C3, #C3, #FF, #7E, #00
 4701	7103					    ; Frame 2: Large cloud
