 1305	4145					music_ch_a_tone_step EQU #D164   ; Channel A
 1306	4145					music_ch_b_tone_step EQU #D165   ; Channel B
 1307	4145					music_ch_c_tone_step EQU #D166   ; Channel C
 1308	4145					music_ch_noise_step_base EQU #D167   ; Reserved software noise envelope step (3 bytes)
 1309	4145					music_ch_a_noise_step EQU #D167   ; Channel A
 1310	4145					music_ch_b_noise_step EQU #D168   ; Channel B
 1311	4145					music_ch_c_noise_step EQU #D169   ; Channel C
