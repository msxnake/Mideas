 1386	4145					; MAPPER RUNTIME API
 1387	4145					; File: mapper.asm
 1388	4145					; Description: Minimal compatibility stubs for simple32k builds
 1389	4145					; Target mapper: konami
 1390	4145					; ROM mode: simple32k (autoMegaROM=false)
 1391	4145					; ==================================================================
 1392	4145					;
 1393	4145					; This build runs in simple32k mode, so bank switching is not active.
 1394	4145					; Keep mapper API labels as no-op stubs so generated gameplay code can
 1395	4145					; call the same routines without conditional assembly branches.
 1396	4145					
 1397	4145					; ------------------------------------------------------------------
 1398	4145					; mapper_runtime_init
 1399	4145					; Initializes runtime mirrors only (no hardware mapper writes).
 1400	4145					; ------------------------------------------------------------------
 1401	4145					mapper_runtime_init:
 1402	4145	AF				    xor a
 1403	4146	32	12	C0		    ld (mapper_bank_p1_current), a
 1404	4149	3E	01			    ld a, 1
 1405	414B	32	13	C0		    ld (mapper_bank_p2_current), a
 1406	414E	3E	02			    ld a, 2
 1407	4150	32	14	C0		    ld (mapper_bank_p3_current), a
 1408	4153	3E	03			    ld a, 3
 1409	4155	32	15	C0		    ld (mapper_bank_p4_current), a
 1410	4158	C9				    ret
 1411	4159					
 1412	4159					; ------------------------------------------------------------------
 1413	4159					; API: mapper_set_bank_pX
 1414	4159					; Input: A = bank number (stored only for compatibility)
 1415	4159					; ------------------------------------------------------------------
 1416	4159					mapper_set_bank_p1:
 1417	4159	32	12	C0		    ld (mapper_bank_p1_current), a
 1418	415C	C9				    ret
 1419	415D					
 1420	415D					mapper_set_bank_p2:
 1421	415D	32	13	C0		    ld (mapper_bank_p2_current), a
 1422	4160	C9				    ret
 1423	4161					
 1424	4161					mapper_set_bank_p3:
 1425	4161	32	14	C0		    ld (mapper_bank_p3_current), a
 1426	4164	C9				    ret
 1427	4165					
 1428	4165					mapper_set_bank_p4:
 1429	4165	32	15	C0		    ld (mapper_bank_p4_current), a
 1430	4168	C9				    ret
 1431	4169					
 1432	4169					; ------------------------------------------------------------------
 1433	4169					; Save/restore helpers (compatibility only).
 1434	4169					; ------------------------------------------------------------------
 1435	4169					mapper_push_p1:
 1436	4169	3A	12	C0		    ld a, (mapper_bank_p1_current)
 1437	416C	32	17	C0		    ld (mapper_saved_bank_p1), a
 1438	416F	C9				    ret
 1439	4170					
 1440	4170					mapper_pop_p1:
 1441	4170	3A	17	C0		    ld a, (mapper_saved_bank_p1)
 1442	4173	C3	59	41		    jp mapper_set_bank_p1
 1443	4176					
 1444	4176					mapper_push_p2:
 1445	4176	3A	13	C0		    ld a, (mapper_bank_p2_current)
 1446	4179	32	16	C0		    ld (mapper_saved_bank), a
 1447	417C	C9				    ret
 1448	417D					
 1449	417D					mapper_pop_p2:
 1450	417D	3A	16	C0		    ld a, (mapper_saved_bank)
 1451	4180	C3	5D	41		    jp mapper_set_bank_p2
 1452	4183					
 1453	4183					mapper_push_p3:
 1454	4183	3A	14	C0		    ld a, (mapper_bank_p3_current)
 1455	4186	32	18	C0		    ld (mapper_saved_bank_p3), a
 1456	4189	C9				    ret
 1457	418A					
 1458	418A					mapper_pop_p3:
 1459	418A	3A	18	C0		    ld a, (mapper_saved_bank_p3)
 1460	418D	C3	61	41		    jp mapper_set_bank_p3
 1461	4190					
 1462	4190					mapper_push_p4:
 1463	4190	3A	15	C0		    ld a, (mapper_bank_p4_current)
 1464	4193	32	19	C0		    ld (mapper_saved_bank_p4), a
 1465	4196	C9				    ret
 1466	4197					
 1467	4197					mapper_pop_p4:
 1468	4197	3A	19	C0		    ld a, (mapper_saved_bank_p4)
 1469	419A	C3	65	41		    jp mapper_set_bank_p4
