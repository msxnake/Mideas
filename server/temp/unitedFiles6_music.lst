 3646	6DAB					
 3647	6DAB					; Animation speeds (in frames)
 3648	6DAB					ANIM_SPEED_SLOW         EQU 15      ; ~250ms (water)
 3649	6DAB					ANIM_SPEED_MEDIUM       EQU 8       ; ~133ms (lava)
 3650	6DAB					ANIM_SPEED_FAST         EQU 4       ; ~66ms (fire)
 3651	6DAB					
 3652	6DAB					; Maximum animated tiles
 3653	6DAB					MAX_ANIM_TILES          EQU 1
 3654	6DAB					ANIM_TILE_ENTRY_SIZE    EQU 7       ; char, chars, frames, speed, bytesPerFrame, ptr(2)
 3655	6DAB					ANIM_TRANS_ENTRY_SIZE   EQU 4       ; char, chars, opCode, flags
 3656	6DAB					ANIM_TILE_DATA_BANK     EQU ((anim_tile_table - #4000) / #2000)
