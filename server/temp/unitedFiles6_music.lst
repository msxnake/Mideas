 1271	4145					music_loop           EQU #D148   ; 0=no loop, 1=loop enabled
 1272	4145					music_track_index    EQU #D149   ; Current ROM track index
 1273	4145					music_row_frames     EQU #D14A   ; Frames per tracker row
