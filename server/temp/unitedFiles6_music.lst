 337	40B3					; ==================================================================
 338	40B3					; DIRECT HARDWARE ACCESS ROUTINES
 339	40B3					; ==================================================================
 340	40B3					; Mode: HYBRID
 341	40B3					; Optimize Level: safe
 342	40B3					; Debug: DISABLED
 343	40B3					;
 344	40B3					; These routines provide direct hardware access for maximum performance.
 345	40B3					; They replace BIOS calls in performance-critical sections.
 346	40B3					;
 347	40B3					; Performance Gains vs BIOS:
 348	40B3					;   FAST_LDIRVM:  ~40% faster (12,288 vs 20,480 cycles for 256 bytes)
 349	40B3					;   FAST_WRTVRM:  ~43% faster (40 vs 70 cycles)
 350	40B3					;   FAST_WRTVDP:  ~55% faster (25 vs 55 cycles)
 351	40B3					;   FAST_GTSTCK:  ~58% faster (50 vs 120 cycles)
 352	40B3					;   FAST_GTTRIG:  direct trigger read (joystick button)
 353	40B3					;   FAST_SNSMAT:  direct keyboard matrix row read
 354	40B3					;
 355	40B3					; Compatibility: MSX1, MSX2, MSX2+
 356	40B3					; ==================================================================
 357	40B3					
 358	40B3					
 359	40B3					; ==================================================================
 360	40B3					; FAST_LDIRVM - Fast Block Transfer to VRAM
 361	40B3					; ==================================================================
 362	40B3					; Register Contract:
 363	40B3					;   Purpose: Block copy from RAM to VRAM using VDP data port auto-increment.
 364	40B3					;   Inputs:
 365	40B3					;     - HL = source address (RAM)
 366	40B3					;     - DE = destination address (VRAM)
 367	40B3					;     - BC = byte count
 368	40B3					;   Outputs:
 369	40B3					;     - None
 370	40B3					;   Clobbers:
 371	40B3					;     - AF
 372	40B3					;     - BC
 373	40B3					;     - HL
 374	40B3					;   Preserved:
 375	40B3					;     - DE
 376	40B3					;   Register roles:
 377	40B3					;     - A = VDP address bytes and data byte being transferred
 378	40B3					;     - HL = RAM read pointer (increments each byte)
 379	40B3					;     - DE = only used to program initial VRAM address
 380	40B3					;     - BC = countdown loop counter
 381	40B3					;   Notes:
 382	40B3					;     - Caller must preserve AF/BC/HL if needed after call.
 383	40B3					
 384	40B3					; Replaces BIOS LDIRVM with direct hardware access
 385	40B3					;
 386	40B3					; Input:
 387	40B3					;   HL = Source address (RAM)
 388	40B3					;   DE = Destination address (VRAM)
 389	40B3					;   BC = Byte count
 390	40B3					;
 391	40B3					; Output:
 392	40B3					;   None
 393	40B3					;
 394	40B3					; Destroys:
 395	40B3					;   AF, BC, HL
 396	40B3					;
 397	40B3					; Performance:
 398	40B3					;   ~48 cycles/byte vs BIOS ~80+ cycles/byte
 399	40B3					;   For 256 bytes: 12,288 cycles vs 20,480+ (40% faster)
 400	40B3					;
 401	40B3					; Notes:
 402	40B3					;   - Auto-increments VRAM address (VDP feature)
 403	40B3					;   - Keeps IRQs masked for the whole transfer to avoid VDP port races
 404	40B3					;   - Restores previous IRQ enable state on return
 405	40B3					;   - Works on all MSX models (TMS9918, V9938, V9958)
 406	40B3					; ==================================================================
 407	40B3					FAST_LDIRVM:
 408	40B3					    ; Preserve previous IRQ state (LD A,I copies IFF2 into P/V)
 409	40B3	ED	57			    ld a, i
 410	40B5	F5				    push af
 411	40B6	F3				    di
 412	40B7					
 413	40B7					    ; Set VRAM write address
 414	40B7	7B				    ld a, e
 415	40B8	D3	99			    out (#99), a           ; Write address low byte to VDP
 416	40BA	00				    nop                    ; Real VDPs need a short settle time between control writes
 417	40BB	7A				    ld a, d
 418	40BC	F6	40			    or #40                 ; Set bit 6 for write mode
 419	40BE	D3	99			    out (#99), a           ; Write address high byte + write command
 420	40C0	00				    nop                    ; Let the VDP latch the address before the first data write
 421	40C1					
 422	40C1					    ; Copy loop
 423	40C1					.ldirvm_loop:
 424	40C1	7E				    ld a, (hl)             ; Read byte from RAM (7 cycles)
 425	40C2	D3	98			    out (#98), a           ; Write to VRAM data port (11 cycles)
 426	40C4	23				    inc hl                 ; Next source address (6 cycles)
 427	40C5	0B				    dec bc                 ; Decrement counter (6 cycles)
 428	40C6	78				    ld a, b                ; Check if BC = 0 (4 cycles)
 429	40C7	B1				    or c                   ; (4 cycles)
 430	40C8	20	F7			    jr nz, .ldirvm_loop    ; Loop if not zero (12/7 cycles)
 431	40CA					
 432	40CA					    ; Restore previous IRQ state
 433	40CA	F1				    pop af
 434	40CB	E0				    ret po                 ; P/V=0 => IRQs were disabled on entry
 435	40CC	FB				    ei
 436	40CD	C9				    ret
 437	40CE					
 438	40CE					
 439	40CE					; ==================================================================
 440	40CE					; FAST_WRTVRM - Write Single Byte to VRAM
 441	40CE					; ==================================================================
 442	40CE					; Register Contract:
 443	40CE					;   Purpose: Write one byte into VRAM while preserving caller-visible state.
 444	40CE					;   Inputs:
 445	40CE					;     - A = byte to write
 446	40CE					;     - HL = VRAM destination address
 447	40CE					;   Outputs:
 448	40CE					;     - None
 449	40CE					;   Clobbers:
 450	40CE					;     - None (all registers preserved)
 451	40CE					;   Preserved:
 452	40CE					;     - AF
 453	40CE					;     - BC
 454	40CE					;     - DE
 455	40CE					;     - HL
 456	40CE					;   Register roles:
 457	40CE					;     - A = temporarily saved/restored around VDP address programming
 458	40CE					;     - HL = VRAM address source (not modified)
 459	40CE					;   Notes:
 460	40CE					;     - Safe helper when the caller cannot tolerate register changes.
 461	40CE					
 462	40CE					; Replaces BIOS WRTVRM
 463	40CE					;
 464	40CE					; Input:
 465	40CE					;   A = Data byte to write
 466	40CE					;   HL = VRAM destination address
 467	40CE					;
 468	40CE					; Output:
 469	40CE					;   None
 470	40CE					;
 471	40CE					; Destroys:
 472	40CE					;   None (all registers preserved)
 473	40CE					;
 474	40CE					; Performance:
 475	40CE					;   ~40 cycles vs BIOS ~70 cycles (43% faster)
 476	40CE					;
 477	40CE					; Notes:
 478	40CE					;   - Preserves all registers including AF
 479	40CE					;   - VDP write sequence is atomic against ISR VRAM writes
 480	40CE					; ==================================================================
 481	40CE					FAST_WRTVRM:
 482	40CE					    ; Preserve caller-visible state and previous IRQ status.
 483	40CE	C5				    push bc
 484	40CF	4F				    ld c, a                ; C = input data byte
 485	40D0	F5				    push af                ; Save caller AF
 486	40D1	ED	57			    ld a, i
 487	40D3	F5				    push af                ; Save previous IFF2 in P/V
 488	40D4	F3				    di
 489	40D5	7D				    ld a, l
 490	40D6	D3	99			    out (#99), a           ; Address low (11 cycles)
 491	40D8	7C				    ld a, h
 492	40D9	F6	40			    or #40                 ; Write mode (7 cycles)
 493	40DB	D3	99			    out (#99), a           ; Address high + command (11 cycles)
 494	40DD	79				    ld a, c
 495	40DE	D3	98			    out (#98), a           ; Write to VRAM (11 cycles)
 496	40E0					
 497	40E0					    ; Restore previous IRQ state.
 498	40E0	F1				    pop af
 499	40E1	E2	E5	40		    jp po, .fwv_no_ei      ; P/V=0 => IRQs were disabled on entry
 500	40E4	FB				    ei
 501	40E5					.fwv_no_ei:
 502	40E5	F1				    pop af                 ; Restore caller AF
 503	40E6	C1				    pop bc
 504	40E7	C9				    ret
 505	40E8					
 506	40E8					
 507	40E8					; ==================================================================
 508	40E8					; FAST_RDVRM - Read Single Byte from VRAM
 509	40E8					; ==================================================================
 510	40E8					; Register Contract:
 511	40E8					;   Purpose: Read one byte from VRAM data port.
 512	40E8					;   Inputs:
 513	40E8					;     - HL = VRAM source address
 514	40E8					;   Outputs:
 515	40E8					;     - A = byte read from VRAM
 516	40E8					;   Clobbers:
 517	40E8					;     - AF
 518	40E8					;   Preserved:
 519	40E8					;     - BC
 520	40E8					;     - DE
 521	40E8					;     - HL
 522	40E8					;   Register roles:
 523	40E8					;     - A = VDP addressing command then read result
 524	40E8					;     - HL = address source only (unchanged)
 525	40E8					;   Notes:
 526	40E8					;     - Callers relying on flags must account for AF clobber.
 527	40E8					
 528	40E8					; Replaces BIOS RDVRM
 529	40E8					;
 530	40E8					; Input:
 531	40E8					;   HL = VRAM source address
 532	40E8					;
 533	40E8					; Output:
 534	40E8					;   A = Byte read from VRAM
 535	40E8					;
 536	40E8					; Destroys:
 537	40E8					;   AF
 538	40E8					;
 539	40E8					; Performance:
 540	40E8					;   ~35 cycles vs BIOS ~65 cycles (46% faster)
 541	40E8					;
 542	40E8					; Notes:
 543	40E8					;   - Useful for collision detection, tile reading
 544	40E8					;   - VDP requires small delay after address set before read
 545	40E8					; ==================================================================
 546	40E8					FAST_RDVRM:
 547	40E8	7D				    ld a, l
 548	40E9	D3	99			    out (#99), a           ; Address low
 549	40EB	7C				    ld a, h
 550	40EC	E6	3F			    and #3F                ; Clear bit 6 for read mode (bit 7 must be 0)
 551	40EE	D3	99			    out (#99), a           ; Address high + read command
 552	40F0	00				    nop                    ; VDP needs time to process address before read
 553	40F1	DB	98			    in a, (#98)            ; Read from VRAM data port
 554	40F3	C9				    ret
 555	40F4					
 556	40F4					
 557	40F4					; ==================================================================
 558	40F4					; FAST_WRTVDP - Write VDP Register
 559	40F4					; ==================================================================
 560	40F4					; Register Contract:
 561	40F4					;   Purpose: Write one VDP register value (value first, then register index).
 562	40F4					;   Inputs:
 563	40F4					;     - B = register value
 564	40F4					;     - C = register number
 565	40F4					;   Outputs:
 566	40F4					;     - None
 567	40F4					;   Clobbers:
 568	40F4					;     - AF
 569	40F4					;   Preserved:
 570	40F4					;     - BC
 571	40F4					;     - DE
 572	40F4					;     - HL
 573	40F4					;   Register roles:
 574	40F4					;     - A = output staging register for both OUT operations
 575	40F4					;     - B/C = preserved input pair for value and register id
 576	40F4					;   Notes:
 577	40F4					;     - Order of writes is mandatory for VDP register writes.
 578	40F4					
 579	40F4					; Replaces BIOS WRTVDP
 580	40F4					;
 581	40F4					; Input:
 582	40F4					;   B = Register value
 583	40F4					;   C = Register number (0-7 for MSX1, 0-23 for MSX2, 0-46 for MSX2+)
 584	40F4					;
 585	40F4					; Output:
 586	40F4					;   None
 587	40F4					;
 588	40F4					; Destroys:
 589	40F4					;   AF
 590	40F4					;
 591	40F4					; Performance:
 592	40F4					;   ~25 cycles vs BIOS ~55 cycles (55% faster)
 593	40F4					;
 594	40F4					; Notes:
 595	40F4					;   - Used for mode changes, colors, scroll, etc.
 596	40F4					;   - Register write order matters: value first, then register number
 597	40F4					; ==================================================================
 598	40F4					FAST_WRTVDP:
 599	40F4	78				    ld a, b                ; Get register value (4 cycles)
 600	40F5	D3	99			    out (#99), a           ; Write value first (11 cycles)
 601	40F7	79				    ld a, c                ; Get register number (4 cycles)
 602	40F8	F6	80			    or #80                 ; Set bit 7 for register write (7 cycles)
 603	40FA	D3	99			    out (#99), a           ; Write register select (11 cycles)
 604	40FC	C9				    ret                    ; (10 cycles)
 605	40FD					                           ; Total: ~25 cycles
 606	40FD					
 607	40FD					
 608	40FD					; ==================================================================
 609	40FD					; FAST_GTSTCK - Read Joystick Direction
 610	40FD					; ==================================================================
 611	40FD					; Register Contract:
 612	40FD					;   Purpose: Read joystick direction and map PSG bits to MSX GTSTCK direction code.
 613	40FD					;   Inputs:
 614	40FD					;     - A = joystick port (0 or 1)
 615	40FD					;   Outputs:
 616	40FD					;     - A = direction code (0-8)
 617	40FD					;   Clobbers:
 618	40FD					;     - AF
 619	40FD					;     - HL
 620	40FD					;   Preserved:
 621	40FD					;     - BC
 622	40FD					;     - DE
 623	40FD					;   Register roles:
 624	40FD					;     - A = PSG register selection, raw read, and final direction code
 625	40FD					;     - HL = lookup table pointer into joystick_direction_table
 626	40FD					;   Notes:
 627	40FD					;     - Bits are active-low; routine inverts and masks input nibble.
 628	40FD					
 629	40FD					; Replaces BIOS GTSTCK (which is notoriously slow)
 630	40FD					;
 631	40FD					; Input:
 632	40FD					;   A = Joystick port (0 = port 1, 1 = port 2)
 633	40FD					;
 634	40FD					; Output:
 635	40FD					;   A = Direction code (0-8)
 636	40FD					;       0 = Center (no direction)
 637	40FD					;       1 = Up
 638	40FD					;       2 = Up + Right
 639	40FD					;       3 = Right
 640	40FD					;       4 = Down + Right
 641	40FD					;       5 = Down
 642	40FD					;       6 = Down + Left
 643	40FD					;       7 = Left
 644	40FD					;       8 = Up + Left
 645	40FD					;
 646	40FD					; Destroys:
 647	40FD					;   AF, HL
 648	40FD					;
 649	40FD					; Performance:
 650	40FD					;   ~50 cycles vs BIOS ~120+ cycles (58% faster)
 651	40FD					;
 652	40FD					; Notes:
 653	40FD					;   - Reads from PSG register 14 (port 1) or 15 (port 2)
 654	40FD					;   - Joystick bits are active-low (inverted)
 655	40FD					;   - Uses lookup table for direction decoding
 656	40FD					; ==================================================================
 657	40FD					FAST_GTSTCK:
 658	40FD					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 659	40FD	0F				    rrca                   ; A = A / 2 (joystick port becomes 0 or 8)
 660	40FE	E6	0F			    and #0F                ; Mask to valid range
 661	4100	F6	0E			    or #0E                 ; Add 14 (base register for joystick)
 662	4102					
 663	4102					    ; Make PSG select+read atomic so VBlank music writes cannot
 664	4102					    ; corrupt the selected register mid-access.
 665	4102	F3				    di
 666	4103	D3	A0			    out (#A0), a           ; Write register number to PSG address port
 667	4105	DB	A2			    in a, (#A2)            ; Read value from PSG data port
 668	4107	FB				    ei
 669	4108					
 670	4108					    ; Process joystick data
 671	4108	2F				    cpl                    ; Invert bits (joystick is active-low)
 672	4109	E6	0F			    and #0F                ; Mask to 4 direction bits (Up, Down, Left, Right)
 673	410B					
 674	410B					    ; Lookup direction code from table
 675	410B	21	15	41		    ld hl, joystick_direction_table
 676	410E	85				    add a, l               ; Add offset to table base
 677	410F	6F				    ld l, a
 678	4110	8C				    adc a, h               ; Handle carry if table crosses page boundary
 679	4111	95				    sub l
 680	4112	67				    ld h, a
 681	4113	7E				    ld a, (hl)             ; Get direction code (0-8)
 682	4114	C9				    ret
 683	4115					
 684	4115					; Direction lookup table (16 entries for all 4-bit combinations)
 685	4115					; MSX PSG register 14 joystick bit order:
 686	4115					;   Bit 0 = Up    (0001)
 687	4115					;   Bit 1 = Down  (0010)
 688	4115					;   Bit 2 = Left  (0100)
 689	4115					;   Bit 3 = Right (1000)
 690	4115					; Value: GTSTCK-compatible direction code (0-8)
 691	4115					joystick_direction_table:
 692	4115	00				    db 0  ; 0000 = Center
 693	4116	01				    db 1  ; 0001 = Up
 694	4117	05				    db 5  ; 0010 = Down
 695	4118	00				    db 0  ; 0011 = Up+Down (invalid)
 696	4119	07				    db 7  ; 0100 = Left
 697	411A	08				    db 8  ; 0101 = Up+Left
 698	411B	06				    db 6  ; 0110 = Down+Left
 699	411C	00				    db 0  ; 0111 = Invalid
 700	411D	03				    db 3  ; 1000 = Right
 701	411E	02				    db 2  ; 1001 = Up+Right
 702	411F	04				    db 4  ; 1010 = Down+Right
 703	4120	00				    db 0  ; 1011 = Invalid
 704	4121	00				    db 0  ; 1100 = Left+Right (invalid)
 705	4122	00				    db 0  ; 1101 = Invalid
 706	4123	00				    db 0  ; 1110 = Invalid
 707	4124	00				    db 0  ; 1111 = All directions (invalid)
 708	4125					
 709	4125					
 710	4125					; ==================================================================
 711	4125					; FAST_GTTRIG - Read Joystick Trigger
 712	4125					; ==================================================================
 713	4125					; Register Contract:
 714	4125					;   Purpose: Read joystick trigger bit directly from PSG register.
 715	4125					;   Inputs:
 716	4125					;     - A = joystick port (0 or 1)
 717	4125					;   Outputs:
 718	4125					;     - A = #FF if pressed, #00 if released
 719	4125					;   Clobbers:
 720	4125					;     - AF
 721	4125					;   Preserved:
 722	4125					;     - BC
 723	4125					;     - DE
 724	4125					;     - HL
 725	4125					;   Register roles:
 726	4125					;     - A = register select, raw PSG read, and normalized return value
 727	4125					;   Notes:
 728	4125					;     - Trigger is active-low in PSG bit 4.
 729	4125					
 730	4125					; Direct hardware replacement for BIOS GTTRIG
 731	4125					;
 732	4125					; Input:
 733	4125					;   A = Joystick port (0 = port 1, 1 = port 2)
 734	4125					;
 735	4125					; Output:
 736	4125					;   A = #FF if pressed, 0 if released
 737	4125					;
 738	4125					; Destroys:
 739	4125					;   AF
 740	4125					;
 741	4125					; Notes:
 742	4125					;   - Reads PSG register 14/15 directly
 743	4125					;   - Trigger bit is active-low
 744	4125					; ==================================================================
 745	4125					FAST_GTTRIG:
 746	4125					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 747	4125	0F				    rrca
 748	4126	E6	0F			    and #0F
 749	4128	F6	0E			    or #0E
 750	412A					
 751	412A					    ; Make PSG select+read atomic so VBlank music writes cannot
 752	412A					    ; corrupt the selected register mid-access.
 753	412A	F3				    di
 754	412B	D3	A0			    out (#A0), a
 755	412D	DB	A2			    in a, (#A2)
 756	412F	FB				    ei
 757	4130					
 758	4130					    ; Trigger bit (bit 4): 0 when pressed, 1 when released
 759	4130	E6	10			    and #10
 760	4132	3E	00			    ld a, #00
 761	4134	C0				    ret nz
 762	4135	3E	FF			    ld a, #FF
 763	4137	C9				    ret
 764	4138					
 765	4138					
 766	4138					; ==================================================================
 767	4138					; FAST_SNSMAT - Sense Keyboard Matrix Row
 768	4138					; ==================================================================
 769	4138					; Register Contract:
 770	4138					;   Purpose: Select keyboard matrix row via PPI and return row state.
 771	4138					;   Inputs:
 772	4138					;     - A = matrix row (0-11)
 773	4138					;   Outputs:
 774	4138					;     - A = row bits (active-low)
 775	4138					;   Clobbers:
 776	4138					;     - AF
 777	4138					;     - C
 778	4138					;   Preserved:
 779	4138					;     - B
 780	4138					;     - DE
 781	4138					;     - HL
 782	4138					;   Register roles:
 783	4138					;     - A = row selector composition and final row read
 784	4138					;     - C = cached low nibble used to build PPI port C output
 785	4138					;   Notes:
 786	4138					;     - Upper nibble of current PPI port C is preserved.
 787	4138					
 788	4138					; Direct hardware replacement for BIOS SNSMAT
 789	4138					;
 790	4138					; Input:
 791	4138					;   A = row (0-11)
 792	4138					;
 793	4138					; Output:
 794	4138					;   A = row bits (active-low, 0=pressed)
 795	4138					;
 796	4138					; Destroys:
 797	4138					;   AF, C
 798	4138					; ==================================================================
 799	4138					FAST_SNSMAT:
 800	4138	E6	0F			    and #0F                 ; Keep valid row bits
 801	413A	4F				    ld c, a
 802	413B	DB	AA			    in a, (#AA)             ; Read current PPI port C
 803	413D	E6	F0			    and #F0                 ; Preserve upper nibble
 804	413F	B1				    or c                    ; Set keyboard row in lower nibble
 805	4140	D3	AA			    out (#AA), a            ; Select row
 806	4142	DB	A9			    in a, (#A9)             ; Read keyboard matrix row
 807	4144	C9				    ret
 808	4145					
 809	4145					
 810	4145					; ==================================================================
 811	4145					; END OF DIRECT HARDWARE ROUTINES
