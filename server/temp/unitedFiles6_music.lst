 3147	4676					; ------------------------------------------------------------------
 3148	4676					; music_execute_command
 3149	4676					; Dispatch a music command from Game Flow nodes.
 3150	4676					; Input:  DE -> [command, trackIndex, loopFlag]
 3151	4676					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 3152	4676					; Destroys: AF, BC (play path), DE (play path), HL
 3153	4676					; ------------------------------------------------------------------
 3154	4676					music_execute_command:
 3155	4676	1A				    ld a, (de)
 3156	4677	FE	FF			    cp #FF
 3157	4679	C8				    ret z
 3158	467A	B7				    or a
 3159	467B	CA	51	46		    jp z, music_stop
 3160	467E	FE	01			    cp 1
 3161	4680	CA	8E	46		    jp z, .pt3_exec_play
 3162	4683	FE	02			    cp 2
 3163	4685	CA	5E	46		    jp z, music_mute
 3164	4688	FE	03			    cp 3
 3165	468A	CA	6C	46		    jp z, music_resume
 3166	468D	C9				    ret
