 4110	6F3E					; ==================================================================
 4111	6F3E					; ANIMATED TILE DEFINITIONS (AUTO-GENERATED)
 4112	6F3E					; ==================================================================
 4113	6F3E					
 4114	6F3E					; ------------------------------------------------------------------
 4115	6F3E					; Animated tile mapping table
 4116	6F3E					; Format:
 4117	6F3E					;   db targetCharCode, charsPerTile, numFrames, speed, bytesPerFrame
 4118	6F3E					;   dw frameDataPointer
 4119	6F3E					; ------------------------------------------------------------------
 4120	6F3E					anim_tile_table:
 4121	6F3E					    ; No animated tile groups detected in project data
 4122	6F3E	FF				    db 255                          ; End marker
 4123	6F3F					
 4124	6F3F					; ------------------------------------------------------------------
 4125	6F3F					; Transform tile mapping table
 4126	6F3F					; Format:
 4127	6F3F					;   db targetCharCode, charsPerTile, opCode, flags
 4128	6F3F					; flags:
 4129	6F3F					;   bit0 = apply vertical transform on color rows
 4130	6F3F					; ------------------------------------------------------------------
 4131	6F3F					anim_transform_table:
 4132	6F3F					    ; No transform tile groups detected in project data
 4133	6F3F	FF				    db 255                          ; End marker
 4134	6F40					
 4135	6F40					; ==================================================================
 4136	6F40					; ANIMATION FRAME DATA
 4137	6F40					; ==================================================================
 4138	6F40					anim_group_empty_data:
 4139	6F40	00				    db #00
 4140	6F41					
 4141	6F41					
 4142	6F41					; ------------------------------------------------------------------
 4143	6F41					; register_animated_tile
 4144	6F41					; Runtime registration is not supported in this generator version.
 4145	6F41					; Input:  A = Tile ID to animate
 4146	6F41					;         B = Number of frames (2-4)
 4147	6F41					;         C = Animation speed
 4148	6F41					; Output: A = 0 if failed (table full), 1 if success
 4149	6F41					; Destroys: AF, DE, HL
 4150	6F41					; ------------------------------------------------------------------
 4151	6F41					register_animated_tile:
 4152	6F41	AF				    xor a                           ; Not supported (static generated table)
 4153	6F42	C9				    ret
 4154	6F43					
 4155	6F43					; ------------------------------------------------------------------
 4156	6F43					; get_tile_animation_frame
 4157	6F43					; Get current animation frame for a tile
 4158	6F43					; Input:  A = target char code
 4159	6F43					; Output: A = Current frame index (mod numFrames), or 0 if not animated
 4160	6F43					; Destroys: BC, DE, HL
 4161	6F43					; ------------------------------------------------------------------
 4162	6F43					get_tile_animation_frame:
 4163	6F43	4F				    ld c, a                         ; C = char code to search
 4164	6F44	21	3E	6F		    ld hl, anim_tile_table
 4165	6F47					
 4166	6F47					.anim_search_loop:
 4167	6F47	7E				    ld a, (hl)
 4168	6F48	FE	FF			    cp 255
 4169	6F4A	28	16			    jr z, .anim_not_found
 4170	6F4C	B9				    cp c
 4171	6F4D	28	06			    jr z, .anim_found_tile
 4172	6F4F					
 4173	6F4F	11	07	00		    ld de, ANIM_TILE_ENTRY_SIZE
 4174	6F52	19				    add hl, de
 4175	6F53	18	F2			    jr .anim_search_loop
 4176	6F55					
 4177	6F55					.anim_found_tile:
 4178	6F55	23				    inc hl
 4179	6F56	23				    inc hl
 4180	6F57	46				    ld b, (hl)                      ; B = numFrames
 4181	6F58	3A	32	C6		    ld a, (anim_tile_frame)
 4182	6F5B					.anim_found_mod:
 4183	6F5B	B8				    cp b
 4184	6F5C	38	03			    jr c, .anim_found_done
 4185	6F5E	90				    sub b
 4186	6F5F	18	FA			    jr .anim_found_mod
 4187	6F61					.anim_found_done:
 4188	6F61	C9				    ret
 4189	6F62					
 4190	6F62					.anim_not_found:
 4191	6F62	AF				    xor a
 4192	6F63	C9				    ret
