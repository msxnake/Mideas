 815	4145					; ==================================================================
 816	4145					; MSX SYSTEM CONSTANTS
 817	4145					; File: constants.asm
 818	4145					; Description: MSX hardware constants and project-specific definitions
 819	4145					; ==================================================================
 820	4145					
 821	4145					; ==================================================================
 822	4145					; VRAM LAYOUT - SCREEN 2 MODE
 823	4145					; ==================================================================
 824	4145					
 825	4145					; Pattern Generator Table (PGT) - 3 Banks
 826	4145					CHRTBL  EQU #0000        ; Pattern table base address (alias)
 827	4145					CHRTBL2 EQU #0000        ; Pattern table base address (Bank 0)
 828	4145					; Bank 1: CHRTBL2 + #800   (#0800)
 829	4145					; Bank 2: CHRTBL2 + #1000  (#1000)
 830	4145					
 831	4145					; Color Attribute Table (CAT) - 3 Banks
 832	4145					CLRTBL  EQU #2000        ; Color table base address (alias)
 833	4145					CLRTBL2 EQU #2000        ; Color table base address (Bank 0)
 834	4145					; Bank 1: CLRTBL2 + #800   (#2800)
 835	4145					; Bank 2: CLRTBL2 + #1000  (#3000)
 836	4145					
 837	4145					; Other VRAM Areas
 838	4145					NAMETBL EQU #1800        ; Name table base address
 839	4145					SPRATR  EQU #1B00        ; Sprite attribute table
 840	4145					SPRPAT  EQU #3800        ; Sprite pattern table
 841	4145					
 842	4145					; ==================================================================
 843	4145					; SCREEN MODES
 844	4145					; ==================================================================
 845	4145					SCREEN0     EQU 0        ; 40x24 text
 846	4145					SCREEN1     EQU 1        ; 32x24 text/graphics
 847	4145					SCREEN2     EQU 2        ; 256x192 graphics
 848	4145					SCREEN3     EQU 3        ; 64x48 multicolor
 849	4145					
 850	4145					; ==================================================================
 851	4145					; SCREEN DIMENSIONS (DYNAMIC BASED ON PROJECT TILES)
