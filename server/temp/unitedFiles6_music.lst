 3000	45ED					
 3001	45ED					; ------------------------------------------------------------------
 3002	45ED					; sfx_play
 3003	45ED					; Play a sound effect with duration
 3004	45ED					; Input:  HL = Sound effect function address
 3005	45ED					;         B = Duration in frames
 3006	45ED					; ------------------------------------------------------------------
 3007	45ED					sfx_play:
 3008	45ED	3A	46	D1		    ld a, (music_active)
 3009	45F0	B7				    or a
 3010	45F1	C0				    ret nz
 3011	45F2					    ; Call the sound effect function
 3012	45F2	C5				    push bc
 3013	45F3	E5				    push hl
 3014	45F4	11	F9	45		    ld de, .return_address
 3015	45F7	D5				    push de
 3016	45F8	E9				    jp (hl)                      ; Indirect call
 3017	45F9					.return_address:
 3018	45F9	E1				    pop hl
 3019	45FA	C1				    pop bc
 3020	45FB					
 3021	45FB					    ; Set timer
 3022	45FB	78				    ld a, b
 3023	45FC	32	B2	CD		    ld (sfx_timer), a
 3024	45FF					
 3025	45FF					    ; Mark as active
 3026	45FF	3E	01			    ld a, 1
 3027	4601	32	B1	CD		    ld (sfx_active), a
 3028	4604					
 3029	4604	C9				    ret
 3030	4605					
 3031	4605					; ------------------------------------------------------------------
 3032	4605					; sfx_update
 3033	4605					; Update sound effect system (call every frame)
 3034	4605					; Handles automatic fadeout and silence
 3035	4605					; ------------------------------------------------------------------
 3036	4605					sfx_update:
 3037	4605	3A	46	D1		    ld a, (music_active)
 3038	4608	B7				    or a
 3039	4609	C0				    ret nz
 3040	460A					    ; Check if sound is active
 3041	460A	3A	B1	CD		    ld a, (sfx_active)
 3042	460D	B7				    or a
 3043	460E	C8				    ret z                        ; No active sound
 3044	460F					
 3045	460F					    ; Decrement timer
 3046	460F	3A	B2	CD		    ld a, (sfx_timer)
 3047	4612	B7				    or a
 3048	4613	28	08			    jr z, .silence_now
 3049	4615					
 3050	4615	3D				    dec a
 3051	4616	32	B2	CD		    ld (sfx_timer), a
 3052	4619					
