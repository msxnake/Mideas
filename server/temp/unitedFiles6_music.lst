 1347	4145					CurEDel         EQU #D1EA   ; Current envelope delay
 1348	4145					Ns_Base_AddToNs EQU #D1EB   ; Noise base + add to noise (combined)
 1349	4145					Ns_Base         EQU #D1EB   ; Noise base
 1350	4145					AddToNs         EQU #D1EC   ; Add to noise
 1351	4145					NT_             EQU #D1ED   ; Note table (192 bytes)
