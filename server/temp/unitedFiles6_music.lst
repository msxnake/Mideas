 870	4145					LIGHT_GREEN EQU 3
 871	4145					DARK_BLUE   EQU 4
 872	4145					LIGHT_BLUE  EQU 5
 873	4145					DARK_RED    EQU 6
 874	4145					CYAN        EQU 7
 875	4145					MEDIUM_RED  EQU 8
 876	4145					LIGHT_RED   EQU 9
 877	4145					DARK_YELLOW EQU 10
 878	4145					LIGHT_YELLOW EQU 11
 879	4145					DARK_GREEN  EQU 12
 880	4145					MAGENTA     EQU 13
 881	4145					GRAY        EQU 14
 882	4145					WHITE       EQU 15
