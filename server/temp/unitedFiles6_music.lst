 3303	6C9C					SCREEN_WIDTH_TILES      EQU 32      ; MSX Screen 2 width in tiles
 3304	6C9C					SCREEN_HEIGHT_TILES     EQU 24      ; MSX Screen 2 height in tiles
 3305	6C9C					SCREEN_WIDTH_PIXELS     EQU 256     ; MSX Screen 2 width in pixels
 3306	6C9C					SCREEN_HEIGHT_PIXELS    EQU 192     ; MSX Screen 2 height in pixels
