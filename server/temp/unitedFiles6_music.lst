 5313	7364					init_psg_silence:
 5314	7364	F5				    push af
 5315	7365	C5				    push bc
 5316	7366					
 5317	7366					    ; Silence channel A
 5318	7366	3E	08			    ld a, #08    ; Volume register channel A
 5319	7368	D3	A0			    out (#A0), a
 5320	736A	3E	00			    ld a, 0      ; Volume = 0
 5321	736C	D3	A1			    out (#A1), a
 5322	736E					
 5323	736E					    ; Silence channel B
 5324	736E	3E	09			    ld a, #09    ; Volume register channel B
 5325	7370	D3	A0			    out (#A0), a
 5326	7372	3E	00			    ld a, 0
 5327	7374	D3	A1			    out (#A1), a
 5328	7376					
 5329	7376					    ; Silence channel C
 5330	7376	3E	0A			    ld a, #0A    ; Volume register channel C
 5331	7378	D3	A0			    out (#A0), a
 5332	737A	3E	00			    ld a, 0
 5333	737C	D3	A1			    out (#A1), a
 5334	737E					
