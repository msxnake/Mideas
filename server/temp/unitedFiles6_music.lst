 1492	41AF					
 1493	41AF					
 1494	41AF					; ==================================================================
 1495	41AF					; INTERRUPT TASK SYSTEM - File: interrupt.asm
 1496	41AF					; Konami-style technique: Hook H.TIMI for 50/60Hz task execution
 1497	41AF					; ==================================================================
 1498	41AF					
 1499	41AF					; ==================================================================
 1500	41AF					; INTERRUPT SYSTEM MEMORY LAYOUT
 1501	41AF					; Variables are defined in variables.asm (dynamically allocated)
 1502	41AF					; This avoids RAM overlap with entity system arrays
 1503	41AF					; ==================================================================
 1504	41AF					; Slots: task_table (8 slots x 2 bytes), task_0_ptr..task_7_ptr
 1505	41AF					; State: interrupt_system_enabled, old_htimi_hook, interrupt_counter,
 1506	41AF					;        task_exec_time, vblank_flag
 1507	41AF					; ==================================================================
 1508	41AF					
 1509	41AF					; ==================================================================
 1510	41AF					; INIT_INTERRUPT_SYSTEM - Install H.TIMI hook
 1511	41AF					; ==================================================================
 1512	41AF					; Register Contract:
 1513	41AF					;   Purpose: Install JP hook on H.TIMI and initialize interrupt task state.
 1514	41AF					;   Inputs:
 1515	41AF					;     - None
 1516	41AF					;   Outputs:
 1517	41AF					;     - None
 1518	41AF					;   Clobbers:
 1519	41AF					;     - AF
 1520	41AF					;     - BC
 1521	41AF					;     - DE
 1522	41AF					;     - HL
 1523	41AF					;   Preserved:
 1524	41AF					;     - None
 1525	41AF					;   Register roles:
 1526	41AF					;     - HL/DE/BC = block copy parameters for hook backup and task table clear
 1527	41AF					;     - A = enable flag and zeroing value
 1528	41AF					;   Notes:
 1529	41AF					;     - Runs with DI/EI, so caller must not assume interrupt state is unchanged.
 1530	41AF					
 1531	41AF					; Inputs: None
 1532	41AF					; Outputs: None
 1533	41AF					; Modifies: AF, BC, DE, HL
 1534	41AF					; ==================================================================
 1535	41AF					init_interrupt_system:
 1536	41AF	F3				    di                          ; Disable interrupts during hook install
 1537	41B0					
 1538	41B0					    ; --- STEP 1: Save original hook ---
 1539	41B0	21	9F	FD		    ld hl, #FD9F                ; H.TIMI address
 1540	41B3	11	38	D1		    ld de, old_htimi_hook       ; Our backup location
 1541	41B6	01	05	00		    ld bc, 5                    ; Save 5 bytes (JP nnnn + padding)
 1542	41B9	ED	B0			    ldir                        ; Copy original hook to RAM
 1543	41BB					
 1544	41BB					    ; --- STEP 2: Install our hook ---
 1545	41BB					    ; Write "JP interrupt_dispatcher" at FD9F
 1546	41BB	3E	C3			    ld a, #C3                   ; Opcode for JP
 1547	41BD	32	9F	FD		    ld (#FD9F), a               ; Write JP opcode
 1548	41C0	21	F6	41		    ld hl, interrupt_dispatcher ; Address of our ISR
 1549	41C3	22	A0	FD		    ld (#FDA0), hl              ; Write address (little-endian)
 1550	41C6					
 1551	41C6					    ; --- STEP 3: Initialize task table to 0 (all disabled) ---
 1552	41C6	21	27	D1		    ld hl, task_table
 1553	41C9	11	28	D1		    ld de, task_table+1
 1554	41CC	01	0F	00		    ld bc, 15                   ; 8 slots ??- 2 bytes = 16 bytes - 1
 1555	41CF	36	00			    ld (hl), 0
 1556	41D1	ED	B0			    ldir                        ; Clear all task pointers
 1557	41D3					
 1558	41D3					    ; --- STEP 4: Initialize counters ---
 1559	41D3	AF				    xor a
 1560	41D4	32	3D	D1		    ld (interrupt_counter), a
 1561	41D7	32	3E	D1		    ld (interrupt_counter+1), a
 1562	41DA	32	41	D1		    ld (vblank_flag), a
 1563	41DD					
 1564	41DD					    ; --- STEP 5: Mark system as enabled ---
 1565	41DD	3E	01			    ld a, 1
 1566	41DF	32	37	D1		    ld (interrupt_system_enabled), a
 1567	41E2					
 1568	41E2	FB				    ei                          ; Re-enable interrupts
 1569	41E3	C9				    ret
 1570	41E4					
 1571	41E4					; ==================================================================
 1572	41E4					; STOP_INTERRUPT_SYSTEM - Restore original H.TIMI hook
 1573	41E4					; ==================================================================
 1574	41E4					; Register Contract:
 1575	41E4					;   Purpose: Restore original H.TIMI bytes and mark system disabled.
 1576	41E4					;   Inputs:
 1577	41E4					;     - None
 1578	41E4					;   Outputs:
 1579	41E4					;     - None
 1580	41E4					;   Clobbers:
 1581	41E4					;     - AF
 1582	41E4					;     - BC
 1583	41E4					;     - DE
 1584	41E4					;     - HL
 1585	41E4					;   Preserved:
 1586	41E4					;     - None
 1587	41E4					;   Register roles:
 1588	41E4					;     - HL/DE/BC = LDIR source/destination/count for hook restore
 1589	41E4					;     - A = zero flag write to interrupt_system_enabled
 1590	41E4					;   Notes:
 1591	41E4					;     - Runs with DI/EI for atomic hook restoration.
 1592	41E4					
 1593	41E4					; Inputs: None
 1594	41E4					; Outputs: None
 1595	41E4					; Modifies: AF, BC, DE, HL
 1596	41E4					; ==================================================================
 1597	41E4					stop_interrupt_system:
 1598	41E4	F3				    di                          ; Disable interrupts
 1599	41E5					
 1600	41E5					    ; Restore original hook
 1601	41E5	21	38	D1		    ld hl, old_htimi_hook       ; Our backup
 1602	41E8	11	9F	FD		    ld de, #FD9F                ; H.TIMI location
 1603	41EB	01	05	00		    ld bc, 5                    ; Restore 5 bytes
 1604	41EE	ED	B0			    ldir
 1605	41F0					
 1606	41F0					    ; Mark system as disabled
 1607	41F0	AF				    xor a
 1608	41F1	32	37	D1		    ld (interrupt_system_enabled), a
 1609	41F4					
 1610	41F4	FB				    ei                          ; Re-enable interrupts
 1611	41F5	C9				    ret
 1612	41F6					
 1613	41F6					; ==================================================================
 1614	41F6					; INTERRUPT_DISPATCHER - Main ISR (60Hz/50Hz)
 1615	41F6					; ==================================================================
 1616	41F6					; Register Contract:
 1617	41F6					;   Purpose: Dispatch enabled interrupt tasks each VBlank and chain BIOS hook.
 1618	41F6					;   Inputs:
 1619	41F6					;     - Triggered by H.TIMI hook
 1620	41F6					;   Outputs:
 1621	41F6					;     - interrupt_counter incremented
 1622	41F6					;     - vblank_flag refreshed
 1623	41F6					;   Clobbers:
 1624	41F6					;     - AF
 1625	41F6					;     - BC
 1626	41F6					;     - DE
 1627	41F6					;     - HL
 1628	41F6					;     - IX
 1629	41F6					;     - IY (all restored before exit)
 1630	41F6					;   Preserved:
 1631	41F6					;     - DE
 1632	41F6					;     - IX
 1633	41F6					;     - IY
 1634	41F6					;   Register roles:
 1635	41F6					;     - HL = walks task_table and holds task pointer
 1636	41F6					;     - B = task slot loop counter
 1637	41F6					;     - C = temporary low byte for pointer reconstruction
 1638	41F6					;     - A = enabled checks and pointer validation
 1639	41F6					;   Notes:
 1640	41F6					;     - Dispatcher saves/restores DE/IX/IY defensively, reducing coupling with task internals.
 1641	41F6					
 1642	41F6					; This routine executes on each V-Blank
 1643	41F6					; CRITICAL: Minimal CPU cycles, maximum efficiency
 1644	41F6					; Overhead: ~80 cycles base + ~40 cycles per active task
 1645	41F6					; ==================================================================
 1646	41F6					interrupt_dispatcher:
 1647	41F6					    ; --- STEP 1: Save caller-visible registers used by BIOS/user code ---
 1648	41F6	F5				    push af                     ; 11 cycles
 1649	41F7	E5				    push hl                     ; 11 cycles
 1650	41F8	C5				    push bc                     ; 11 cycles
 1651	41F9	D5				    push de                     ; 11 cycles
 1652	41FA	DD	E5			    push ix                     ; 15 cycles
 1653	41FC	FD	E5			    push iy                     ; 15 cycles
 1654	41FE					    ; Total: 74 cycles fixed prologue overhead
 1655	41FE					
 1656	41FE					    ; --- STEP 2: Check if system is enabled ---
 1657	41FE	3A	37	D1		    ld a, (interrupt_system_enabled)
 1658	4201	B7				    or a
 1659	4202	28	2A			    jr z, .exit                 ; If disabled, exit quickly
 1660	4204					
 1661	4204					    ; --- STEP 3: Increment frame counter ---
 1662	4204	2A	3D	D1		    ld hl, (interrupt_counter)
 1663	4207	23				    inc hl
 1664	4208	22	3D	D1		    ld (interrupt_counter), hl
 1665	420B					
 1666	420B					    ; --- STEP 3.5: Update VBlank flag (reads VDP status) ---
 1667	420B	CD	3A	42		    call update_vblank_flag
 1668	420E					
 1669	420E					    ; --- STEP 4: Walk through task table ---
 1670	420E	21	27	D1		    ld hl, task_table           ; HL = pointer to task table
 1671	4211	06	08			    ld b, 8                     ; 8 slots
 1672	4213					
 1673	4213					.task_loop:
 1674	4213					    ; Read task pointer (16-bit address)
 1675	4213	7E				    ld a, (hl)                  ; Low byte
 1676	4214	23				    inc hl
 1677	4215	4F				    ld c, a
 1678	4216	7E				    ld a, (hl)                  ; High byte
 1679	4217	23				    inc hl
 1680	4218	B1				    or c                        ; Check if pointer == 0
 1681	4219	28	11			    jr z, .next_task            ; Skip if disabled (pointer == 0)
 1682	421B					
 1683	421B					    ; Valid pointer: execute task
 1684	421B	2B				    dec hl
 1685	421C	2B				    dec hl                      ; Back to low byte
 1686	421D	C5				    push bc                     ; Save loop counter
 1687	421E	E5				    push hl                     ; Save table position
 1688	421F					
 1689	421F					    ; Load task address into HL
 1690	421F	4E				    ld c, (hl)                  ; Low byte
 1691	4220	23				    inc hl
 1692	4221	66				    ld h, (hl)                  ; High byte
 1693	4222	69				    ld l, c                     ; HL = task address
 1694	4223					
 1695	4223					    ; Call task using JP (HL) pattern (faster than indirect CALL)
 1696	4223	CD	39	42		    call .call_task             ; Call the task
 1697	4226					
 1698	4226	E1				    pop hl                      ; Restore table position
 1699	4227	C1				    pop bc                      ; Restore loop counter
 1700	4228	23				    inc hl
 1701	4229	23				    inc hl                      ; Advance to next slot
 1702	422A	18	00			    jr .continue_loop
 1703	422C					
 1704	422C					.next_task:
 1705	422C					    ; Nothing to do, HL already points to next slot
 1706	422C					
 1707	422C					.continue_loop:
 1708	422C	10	E5			    djnz .task_loop             ; Loop 8 times
 1709	422E					
 1710	422E					.exit:
 1711	422E					    ; --- STEP 5: Restore registers ---
 1712	422E	FD	E1			    pop iy                      ; 14 cycles
 1713	4230	DD	E1			    pop ix                      ; 14 cycles
 1714	4232	D1				    pop de                      ; 10 cycles
 1715	4233	C1				    pop bc                      ; 10 cycles
 1716	4234	E1				    pop hl                      ; 10 cycles
 1717	4235	F1				    pop af                      ; 10 cycles
 1718	4236					
 1719	4236					    ; --- STEP 6: Return from interrupt ---
 1720	4236					    ; For H.TIMI we should chain to the original hook (best compatibility)
 1721	4236					    ; and let the BIOS interrupt handler manage EI/RETI.
 1722	4236	C3	38	D1		    jp old_htimi_hook
