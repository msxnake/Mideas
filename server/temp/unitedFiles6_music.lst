 1784	424E					;   Clobbers:
 1785	424E					;     - AF
 1786	424E					;     - BC
 1787	424E					;     - DE
 1788	424E					;     - HL
 1789	424E					;   Preserved:
 1790	424E					;     - None
 1791	424E					;   Register roles:
 1792	424E					;     - A = slot validation and offset math
 1793	424E					;     - DE = holds routine address while HL is repurposed as slot pointer
 1794	424E					;     - BC = task_table base address
 1795	424E					;     - HL = slot address calculation / pointer write
 1796	424E					
 1797	424E					; Inputs:
 1798	424E					;   A = task slot (0-7)
 1799	424E					;   HL = address of task routine
