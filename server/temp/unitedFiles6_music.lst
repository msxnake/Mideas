 1275	4145					music_order_pos      EQU #D14C   ; Current order position
 1276	4145					music_pattern_index  EQU #D14D   ; Current pattern index
 1277	4145					music_pattern_row    EQU #D14E   ; Current row inside pattern
 1278	4145					music_pattern_rows   EQU #D14F   ; Cached rows in current pattern
 1279	4145					music_track_ptr_l    EQU #D150   ; Current track pointer low byte
 1280	4145					music_track_ptr_h    EQU #D151   ; Current track pointer high byte
 1281	4145					music_pattern_ptr_l  EQU #D152   ; Current pattern rows pointer low byte
 1282	4145					music_pattern_ptr_h  EQU #D153   ; Current pattern rows pointer high byte
