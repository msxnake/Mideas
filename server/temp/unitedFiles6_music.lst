 160	4069					; Helper: Get expanded slot value for ENASLT/CALSLT usage
 161	4069					; Input:  A = slot number (0-3) in lower bits
 162	4069					; Output: A = expanded slot value if needed
 163	4069					GETSLOT:
 164	4069	E6	03			    and #03             ; Proteccion, nos aseguramos de que el valor esta en 0-3
 165	406B	4F				    ld  c,a             ; c = slot de la pagina
 166	406C	06	00			    ld  b,0             ; bc = slot de la pagina
 167	406E	21	C1	FC		    ld  hl,#fcc1        ; Tabla de slots expandidos
 168	4071	09				    add hl,bc           ; hl -> variable que indica si este slot esta expandido
 169	4072	7E				    ld  a,(hl)          ; Tomamos el valor
 170	4073	E6	80			    and #80             ; Si el bit mas alto es cero...
 171	4075	28	09			    jr  z,GETSLOT_EXIT  ; ...nos vamos a @@EXIT
 172	4077					    ; --- El slot esta expandido ---
 173	4077	B1				    or  c               ; Slot basico en el lugar adecuado
 174	4078	4F				    ld  c,a             ; Guardamos el valor en c
 175	4079	23				    inc hl              ; Incrementamos hl una...
 176	407A	23				    inc hl              ; ...dos...
 177	407B	23				    inc hl              ; ...tres...
 178	407C	23				    inc hl              ; ...cuatro veces
 179	407D	7E				    ld  a,(hl)          ; a = valor del registro de subslot del slot donde estamos
 180	407E	E6	0C			    and #0C             ; Nos quedamos con el valor donde esta nuestro cartucho
 181	4080					GETSLOT_EXIT:
 182	4080	B1				    or  c
 183	4081	C9				    ret
