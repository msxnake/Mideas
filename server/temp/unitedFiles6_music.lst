 2587	44A6					; Tone Generators (Channels A, B, C)
 2588	44A6					PSG_TONE_A_LO       EQU 0        ; Channel A period low byte
 2589	44A6					PSG_TONE_A_HI       EQU 1        ; Channel A period high byte (4 bits)
 2590	44A6					PSG_TONE_B_LO       EQU 2        ; Channel B period low byte
 2591	44A6					PSG_TONE_B_HI       EQU 3        ; Channel B period high byte (4 bits)
 2592	44A6					PSG_TONE_C_LO       EQU 4        ; Channel C period low byte
 2593	44A6					PSG_TONE_C_HI       EQU 5        ; Channel C period high byte (4 bits)
 2594	44A6					
 2595	44A6					; Noise Generator
 2596	44A6					PSG_NOISE_PERIOD    EQU 6        ; Noise period (5 bits)
 2597	44A6					
 2598	44A6					; Mixer Control
 2599	44A6					PSG_MIXER           EQU 7        ; Mixer/Enable register
 2600	44A6					; Bit 0: Channel A tone enable (0=on, 1=off)
 2601	44A6					; Bit 1: Channel B tone enable
 2602	44A6					; Bit 2: Channel C tone enable
 2603	44A6					; Bit 3: Channel A noise enable (0=on, 1=off)
 2604	44A6					; Bit 4: Channel B noise enable
 2605	44A6					; Bit 5: Channel C noise enable
 2606	44A6					
 2607	44A6					; Volume Control
 2608	44A6					PSG_VOL_A           EQU 8        ; Channel A volume (4 bits) + envelope flag (bit 4)
 2609	44A6					PSG_VOL_B           EQU 9        ; Channel B volume
 2610	44A6					PSG_VOL_C           EQU 10       ; Channel C volume
 2611	44A6					
 2612	44A6					; Envelope Generator
 2613	44A6					PSG_ENV_LO          EQU 11       ; Envelope period low byte
 2614	44A6					PSG_ENV_HI          EQU 12       ; Envelope period high byte
 2615	44A6					PSG_ENV_SHAPE       EQU 13       ; Envelope shape (4 bits)
 2616	44A6					
 2617	44A6					; ==================================================================
 2618	44A6					; PSG TONE PERIODS (Musical notes, octave 4, 3.579545 MHz clock)
 2619	44A6					; ==================================================================
 2620	44A6					
 2621	44A6					; Note frequencies for octave 4 (middle C = C4)
 2622	44A6					NOTE_C4         EQU 477      ; C  - 261.63 Hz
 2623	44A6					NOTE_CS4        EQU 450      ; C# - 277.18 Hz
 2624	44A6					NOTE_D4         EQU 425      ; D  - 293.66 Hz
 2625	44A6					NOTE_DS4        EQU 401      ; D# - 311.13 Hz
 2626	44A6					NOTE_E4         EQU 379      ; E  - 329.63 Hz
 2627	44A6					NOTE_F4         EQU 357      ; F  - 349.23 Hz
 2628	44A6					NOTE_FS4        EQU 337      ; F# - 369.99 Hz
 2629	44A6					NOTE_G4         EQU 318      ; G  - 392.00 Hz
 2630	44A6					NOTE_GS4        EQU 300      ; G# - 415.30 Hz
 2631	44A6					NOTE_A4         EQU 284      ; A  - 440.00 Hz
 2632	44A6					NOTE_AS4        EQU 268      ; A# - 466.16 Hz
 2633	44A6					NOTE_B4         EQU 253      ; B  - 493.88 Hz
 2634	44A6					NOTE_C5         EQU 238      ; C5 - 523.25 Hz
 2635	44A6					
 2636	44A6					; Octave multipliers: Divide period by 2 for +1 octave, multiply by 2 for -1 octave
 2637	44A6					
 2638	44A6					; ==================================================================
 2639	44A6					; SOUND EFFECT DURATIONS (in frames, 60Hz)
 2640	44A6					; ==================================================================
 2641	44A6					
 2642	44A6					SFX_SHORT           EQU 5        ; ~83ms
 2643	44A6					SFX_MEDIUM          EQU 15       ; ~250ms
 2644	44A6					SFX_LONG            EQU 30       ; ~500ms
 2645	44A6					
 2646	44A6					; ==================================================================
 2647	44A6					; SOUND SYSTEM INITIALIZATION
 2648	44A6					; ==================================================================
 2649	44A6					
 2650	44A6					init_sound_system:
 2651	44A6					    ; Initialize PSG via BIOS
 2652	44A6	CD	90	00		    call GICINI
 2653	44A9					
 2654	44A9					    ; Clear runtime sound state so power-on RAM garbage cannot make
 2655	44A9					    ; sfx_update / SM_UpdateSound drive the PSG for a few random frames.
 2656	44A9	AF				    xor a
 2657	44AA	32	B1	CD		    ld (sfx_active), a
 2658	44AD	32	B2	CD		    ld (sfx_timer), a
 2659	44B0	32	B3	CD		    ld (sfx_fadeout), a
 2660	44B3	32	42	D1		    ld (sm_sound_active), a
 2661	44B6	32	43	D1		    ld (sm_sound_frames_left), a
 2662	44B9	32	44	D1		    ld (sm_sound_ptr_l), a
 2663	44BC	32	45	D1		    ld (sm_sound_ptr_h), a
 2664	44BF	CD	25	46		    call music_init_system
 2665	44C2					
 2666	44C2					    ; Silence all channels
 2667	44C2	CD	09	45		    call sfx_silence_all
 2668	44C5					
 2669	44C5	C9				    ret
 2670	44C6					
 2671	44C6					; ==================================================================
 2672	44C6					; PSG LOW-LEVEL CONTROL FUNCTIONS
 2673	44C6					; ==================================================================
 2674	44C6					
 2675	44C6					; ------------------------------------------------------------------
 2676	44C6					; psg_write
 2677	44C6					; Write to PSG register via BIOS
 2678	44C6					; Input:  A = Register number (0-13)
 2679	44C6					;         E = Value to write
 2680	44C6					; Destroys: AF, E
 2681	44C6					; ------------------------------------------------------------------
 2682	44C6					psg_write:
 2683	44C6	CD	93	00		    call WRTPSG
 2684	44C9	C9				    ret
 2685	44CA					
 2686	44CA					; ------------------------------------------------------------------
 2687	44CA					; psg_set_tone
 2688	44CA					; Set tone period for a channel
 2689	44CA					; Input:  A = Channel (0=A, 1=B, 2=C)
 2690	44CA					;         HL = Tone period (12-bit value)
 2691	44CA					; Destroys: AF, BC, DE, HL
 2692	44CA					; ------------------------------------------------------------------
 2693	44CA					psg_set_tone:
 2694	44CA					    ; Calculate register numbers (A*2 for low, A*2+1 for high)
 2695	44CA	87				    add a, a                     ; A = channel * 2
 2696	44CB	4F				    ld c, a                      ; C = low register number
 2697	44CC	3C				    inc a
 2698	44CD	47				    ld b, a                      ; B = high register number
 2699	44CE					
 2700	44CE					    ; Write low byte
 2701	44CE	79				    ld a, c
 2702	44CF	5D				    ld e, l
 2703	44D0	CD	93	00		    call WRTPSG
 2704	44D3					
 2705	44D3					    ; Write high byte (only lower 4 bits)
 2706	44D3	78				    ld a, b
 2707	44D4	5C				    ld e, h
 2708	44D5	7B				    ld a, e
 2709	44D6	E6	0F			    and #0F
 2710	44D8	5F				    ld e, a
 2711	44D9	78				    ld a, b
 2712	44DA	CD	93	00		    call WRTPSG
 2713	44DD					
 2714	44DD	C9				    ret
 2715	44DE					
 2716	44DE					; ------------------------------------------------------------------
 2717	44DE					; psg_set_volume
 2718	44DE					; Set volume for a channel
 2719	44DE					; Input:  A = Channel (0=A, 1=B, 2=C)
 2720	44DE					;         B = Volume (0-15) or #10 to enable PSG hardware envelope
 2721	44DE					; Destroys: AF, E
 2722	44DE					; ------------------------------------------------------------------
 2723	44DE					psg_set_volume:
 2724	44DE	C6	08			    add a, PSG_VOL_A             ; A = PSG_VOL_x register
 2725	44E0	58				    ld e, b                      ; E = volume value
 2726	44E1	CD	93	00		    call WRTPSG
 2727	44E4	C9				    ret
 2728	44E5					
 2729	44E5					; ------------------------------------------------------------------
 2730	44E5					; psg_set_noise
 2731	44E5					; Set noise generator period
 2732	44E5					; Input:  A = Noise period (0-31)
 2733	44E5					; Destroys: AF, E
 2734	44E5					; ------------------------------------------------------------------
 2735	44E5					psg_set_noise:
 2736	44E5	5F				    ld e, a
 2737	44E6	3E	06			    ld a, PSG_NOISE_PERIOD
 2738	44E8	CD	93	00		    call WRTPSG
 2739	44EB	C9				    ret
 2740	44EC					
 2741	44EC					; ------------------------------------------------------------------
 2742	44EC					; psg_set_mixer
 2743	44EC					; Set mixer control (enable/disable tone and noise)
 2744	44EC					; Input:  A = Mixer value
 2745	44EC					;         Bits 0-2: Tone off (0=on, 1=off) for channels A,B,C
 2746	44EC					;         Bits 3-5: Noise off (0=on, 1=off) for channels A,B,C
 2747	44EC					; Destroys: AF, E
 2748	44EC					; ------------------------------------------------------------------
 2749	44EC					psg_set_mixer:
 2750	44EC	5F				    ld e, a
 2751	44ED	3E	07			    ld a, PSG_MIXER
 2752	44EF	CD	93	00		    call WRTPSG
 2753	44F2	C9				    ret
 2754	44F3					
 2755	44F3					; ------------------------------------------------------------------
 2756	44F3					; psg_set_envelope
 2757	44F3					; Program the global PSG hardware envelope generator
 2758	44F3					; Input:  HL = Envelope period
 2759	44F3					;         B = Envelope shape (0-15)
 2760	44F3					; Destroys: AF, E
 2761	44F3					; ------------------------------------------------------------------
 2762	44F3					psg_set_envelope:
 2763	44F3	3E	0B			    ld a, PSG_ENV_LO
 2764	44F5	5D				    ld e, l
 2765	44F6	CD	93	00		    call WRTPSG
 2766	44F9	3E	0C			    ld a, PSG_ENV_HI
 2767	44FB	5C				    ld e, h
 2768	44FC	CD	93	00		    call WRTPSG
 2769	44FF	78				    ld a, b
 2770	4500	E6	0F			    and #0F
 2771	4502	5F				    ld e, a
 2772	4503	3E	0D			    ld a, PSG_ENV_SHAPE
 2773	4505	CD	93	00		    call WRTPSG
 2774	4508	C9				    ret
