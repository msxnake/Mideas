 3059	4155					; ==================================================================
 3060	4155					; ZX0 TEMPORARY RAM BUFFERS
 3061	4155					; ==================================================================
 3062	4155					; Compact scratch layout placed strictly after RAM_USAGE_END.
 3063	4155					; Screen/behavior/tile buffers share the same large work area because they
 3064	4155					; are decompressed and consumed sequentially, never concurrently.
 3065	4155					; Font and sprite frame buffers are injected later by the ZX0 post-processor
 3066	4155					; only when compression selects those blocks; they share scratch there too.
 3067	4155					ZX0_SCREEN_BUFFER       EQU #ED00   ; Screen/layout scratch (768 bytes, shared area)
 3068	4155					ZX0_BEHAVIOR_BUFFER     EQU #ED00   ; Behavior map scratch (768 bytes, shared area)
 3069	4155					ZX0_TILE_PATTERN_BUFFER EQU #ED00   ; Tile pattern scratch (1488 bytes, shared area)
 3070	4155					ZX0_TILE_COLOR_BUFFER   EQU #ED00   ; Tile color scratch (1488 bytes, shared area)
 3071	4155					
 3072	4155					; ==================================================================
 3073	4155					; END OF VARIABLES
 3074	4155					; ==================================================================
 3075	4155					RAM_USAGE_END       EQU #EC20   ; End of project variables (11296 bytes used)
