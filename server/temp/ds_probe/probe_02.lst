 25059	A131					; ------------------------------------------------------------------
 25060	A131					; Routine: anim_transform_char_frame
 25061	A131					; Purpose:
 25062	A131					;   Transform one character pattern in all SCREEN 2 banks.
 25063	A131					; Input:
 25064	A131					;   A = character code
 25065	A131					;   D = transform operation code
 25066	A131					;   (anim_tile_transform_flags).bit0 = transform color rows too
 25067	A131					; Output:
 25068	A131					;   None
 25069	A131					; Modifies:
 25070	A131					;   AF, BC, DE, HL
 25071	A131					; Preserves:
 25072	A131					;   IX, IY, SP
 25073	A131					; Flags:
 25074	A131					;   Not preserved
 25075	A131					; Stack:
 25076	A131					;   Pushes/pops BC, DE and HL
 25077	A131					; ------------------------------------------------------------------
 25078	A131					anim_transform_char_frame:
 25079	A131	C5				    push bc
 25080	A132	D5				    push de
 25081	A133	E5				    push hl
 25082	A134					
 25083	A134					    ; BC = charCode * 8 (row offset in pattern/color tables)
 25084	A134	6F				    ld l, a
 25085	A135	26	00			    ld h, 0
 25086	A137	29				    add hl, hl
 25087	A138	29				    add hl, hl
 25088	A139	29				    add hl, hl
 25089	A13A	44				    ld b, h
