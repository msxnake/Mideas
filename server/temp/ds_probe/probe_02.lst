 24412	81C7					; music_mute
 24413	81C7					; Mute music (keep track position).
 24414	81C7					; Destroys: AF
 24415	81C7					; ------------------------------------------------------------------
 24416	81C7					music_mute:
 24417	81C7	3A	B9	E9		    ld a, (music_active)
 24418	81CA	B7				    or a
