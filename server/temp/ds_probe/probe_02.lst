 10572	755B					; ------------------------------------------------------------------
 10573	755B					; check_tile_interaction
 10574	755B					; Purpose:
 10575	755B					;   Scan active input-driven entities against the interactable tile map,
 10576	755B					;   dispatch the configured per-tile interaction, and update persistence/runtime state.
 10577	755B					; Input:
 10578	755B					;   None (reads active_entity_list / input_entity_count and runtime maps)
 10579	755B					; Output:
 10580	755B					;   None
 10581	755B					; Clobbers:
 10582	755B					;   AF, BC, DE, HL
 10583	755B					; Preserves:
 10584	755B					;   IX, IY, SP
 10585	755B					; ------------------------------------------------------------------
 10586	755B					check_tile_interaction:
