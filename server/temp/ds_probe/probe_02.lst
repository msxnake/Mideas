 5975	60DE	80				    add a, b                   ; A = X + VelX
 5976	60DF	77				    ld (hl), a                 ; Store new X
 5977	60E0					
 5978	60E0					    ; Update Y Position
 5979	60E0					    ; Y = Y + VelY (defensive clamp to avoid byte-wrap teleports)
 5980	60E0	21	3D	DE		    ld hl, entity_vel_y
 5981	60E3	19				    add hl, de
 5982	60E4	7E				    ld a, (hl)                 ; A = VelY (signed)
 5983	60E5					    ; Clamp vertical delta to [-16..+16] to avoid single-frame wrap jumps
 5984	60E5	CB	7F			    bit 7, a
 5985	60E7	28	08			    jr z, .pos_vy_positive
 5986	60E9	FE	F0			    cp #F0                     ; -16
