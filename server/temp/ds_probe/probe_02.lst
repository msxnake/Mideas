 15174	86E1					Condition_VariableCompare:
 15175	86E1					    ; Params: VarID (1 byte), Operator (1 byte), CompareSource (1 byte), ValueOrVarID (1 byte)
 15176	86E1					    ; CompareSource: 0 = constant byte, 1 = variable ID
 15177	86E1					    ; Input: B = Entity Index, HL = Params Ptr
 15178	86E1					    ; Output: A = 1 (true) or 0 (false), HL = Updated Ptr
 15179	86E1					    ; Supports entity variables (ID 0-5) and global variables (ID 6+)
 15180	86E1					
 15181	86E1	7E				    ld a, (hl)              ; A = Variable ID
 15182	86E2	23				    inc hl
 15183	86E3	4E				    ld c, (hl)              ; C = Operator ID
 15184	86E4	23				    inc hl
 15185	86E5	56				    ld d, (hl)              ; D = CompareSource
 15186	86E6	23				    inc hl
 15187	86E7	5E				    ld e, (hl)              ; E = Compare Value or Variable ID
 15188	86E8	23				    inc hl
 15189	86E9					
 15190	86E9	E5				    push hl                 ; Save updated params ptr
 15191	86EA	C5				    push bc                 ; Save Operator and Entity Index
 15192	86EB	D5				    push de                 ; Save CompareSource/ValueOrVarID
 15193	86EC					
 15194	86EC	CD	42	87		    call .load_variable_value
 15195	86EF	53				    ld d, e                 ; D = left value
 15196	86F0					
 15197	86F0	E1				    pop hl                  ; H = CompareSource, L = Compare Value / VarID
 15198	86F1	7C				    ld a, h
 15199	86F2	B7				    or a
 15200	86F3	28	06			    jr z, .compare_constant
 15201	86F5					
 15202	86F5	7D				    ld a, l                 ; Resolve right-side variable
 15203	86F6	CD	42	87		    call .load_variable_value
 15204	86F9	18	01			    jr .do_compare
 15205	86FB					
 15206	86FB					.compare_constant:
 15207	86FB	5D				    ld e, l                 ; E = right constant value
 15208	86FC					
 15209	86FC					.do_compare:
 15210	86FC	C1				    pop bc                  ; C = Operator ID, B = Entity Index (restore)
 15211	86FD	E1				    pop hl                  ; HL = Updated Params Ptr
 15212	86FE					    
 15213	86FE					    ; Now: D = Left Value, E = Right Value, C = Operator
 15214	86FE					    ; Perform comparison based on operator
 15215	86FE	79				    ld a, c                 ; A = Operator ID
 15216	86FF					    
 15217	86FF	FE	00			    cp 0                    ; == operator
 15218	8701	28	17			    jr z, .op_equals
 15219	8703	FE	01			    cp 1                    ; != operator
 15220	8705	28	19			    jr z, .op_not_equals
 15221	8707	FE	02			    cp 2                    ; > operator
 15222	8709	28	1B			    jr z, .op_greater
 15223	870B	FE	03			    cp 3                    ; < operator
 15224	870D	28	1F			    jr z, .op_less
 15225	870F	FE	04			    cp 4                    ; >= operator
 15226	8711	28	21			    jr z, .op_greater_equal
 15227	8713	FE	05			    cp 5                    ; <= operator
 15228	8715	28	23			    jr z, .op_less_equal
 15229	8717					    
 15230	8717					    ; Invalid operator, return false
 15231	8717	3E	00			    ld a, 0
 15232	8719	C9				    ret
 15233	871A					
 15234	871A					.op_equals:
 15235	871A	7A				    ld a, d
 15236	871B	BB				    cp e
 15237	871C	28	7E			    jr z, .return_true
 15238	871E	18	7F			    jr .return_false
 15239	8720					
 15240	8720					.op_not_equals:
 15241	8720	7A				    ld a, d
 15242	8721	BB				    cp e
 15243	8722	20	78			    jr nz, .return_true
 15244	8724	18	79			    jr .return_false
