 15136	86BF					Condition_DeadlyTile:
 15137	86BF					    ; Check if entity is touching deadly tile
 15138	86BF					    ; Input: B = Entity Index, HL = Params Ptr (no params)
 15139	86BF					    ; Output: A = 1 (touching deadly tile) or 0 (safe)
 15140	86BF					    ; Destroys: DE, HL
 15141	86BF	E5				    push hl
 15142	86C0	21	7C	E5		    ld hl, entity_flag_deadly_tile
 15143	86C3	58				    ld e, b
 15144	86C4	16	00			    ld d, 0
 15145	86C6	19				    add hl, de
 15146	86C7	7E				    ld a, (hl)
 15147	86C8	E6	01			    and #01                       ; Check bit 0
 15148	86CA	E1				    pop hl
 15149	86CB	C9				    ret                           ; A = 1 if deadly, 0 if safe
 15150	86CC					
 15151	86CC					Condition_AnimComplete:
 15152	86CC					    ; One-shot event latched by update_animation_component when
 15153	86CC					    ; a non-loop animation reaches its final frame.
 15154	86CC					    ; Consume-on-read semantics prevents repeated transitions.
 15155	86CC	E5				    push hl
 15156	86CD	21	BE	DF		    ld hl, entity_anim_flags
 15157	86D0	58				    ld e, b
 15158	86D1	16	00			    ld d, 0
 15159	86D3	19				    add hl, de
 15160	86D4	CB	5E			    bit 3, (hl)                    ; ANIM_FLAG_COMPLETED
 15161	86D6	28	06			    jr z, .anim_complete_false
 15162	86D8	CB	9E			    res 3, (hl)                    ; consume event
 15163	86DA	3E	01			    ld a, 1
 15164	86DC	E1				    pop hl
 15165	86DD	C9				    ret
 15166	86DE					
 15167	86DE					.anim_complete_false:
 15168	86DE	AF				    xor a
 15169	86DF	E1				    pop hl
 15170	86E0	C9				    ret
