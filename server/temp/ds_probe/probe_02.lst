 8539	6C07	E1				        pop hl                        ; Restore list pointer
 8540	6C08	E6	04			        and #04                       ; AUTO_DESTROY bit (COMP_MASK_AUTO_DESTROY=#0400 -> high byte bit2)
 8541	6C0A	28	34			        jr z, auto_destroy_next
