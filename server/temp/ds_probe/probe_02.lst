 24686	A000					    org #A000
 24687	A000					
 24688	A000					; ==================================================================
 24689	A000					; ANIMATED TILES SYSTEM
 24690	A000					; File: animtiles.asm
 24691	A000					; Description: Background tile animation for water, lava, fire, etc.
 24692	A000					; ==================================================================
 24693	A000					
 24694	A000					; Auto-detected animated groups:
 24695	A000					;   frame groups: 4
 24696	A000					;   transform groups: 2
 24697	A000					
 24698	A000					; ==================================================================
 24699	A000					; ANIMATED TILES CONSTANTS
 24700	A000					; ==================================================================
 24701	A000					
 24702	A000					; Animation speeds (in frames)
 24703	A000					ANIM_SPEED_SLOW         EQU 15      ; ~250ms (water)
 24704	A000					ANIM_SPEED_MEDIUM       EQU 8       ; ~133ms (lava)
 24705	A000					ANIM_SPEED_FAST         EQU 4       ; ~66ms (fire)
 24706	A000					
 24707	A000					; Maximum animated tiles
 24708	A000					MAX_ANIM_TILES          EQU 6
 24709	A000					ANIM_TILE_ENTRY_SIZE    EQU 7       ; char, chars, frames, speed, bytesPerFrame, ptr(2)
 24710	A000					ANIM_TRANS_ENTRY_SIZE   EQU 4       ; char, chars, opCode, flags
 24711	A000					ANIM_TILE_DATA_BANK     EQU ((anim_tile_table - #4000) / #2000)
 24712	A000					
 24713	A000					; ==================================================================
 24714	A000					; ANIMATED TILES INITIALIZATION
 24715	A000					; ==================================================================
 24716	A000					
 24717	A000					init_animated_tiles:
 24718	A000					    ; Initialize animation variables
 24719	A000	AF				    xor a
 24720	A001	32	70	DC		    ld (anim_tile_timer), a
 24721	A004	32	71	DC		    ld (anim_tile_frame), a
 24722	A007					
 24723	A007					    ; Set default global animation speed
 24724	A007	3E	08			    ld a, 8
 24725	A009	32	72	DC		    ld (anim_tile_speed), a
 24726	A00C					
 24727	A00C					    ; Upload initial animation frame state immediately
 24728	A00C	CD	A2	4C		    call call_update_animated_tiles_vram_resident
 24729	A00F					
 24730	A00F	C9				    ret
 24731	A010					
 24732	A010					; ==================================================================
 24733	A010					; ANIMATED TILES UPDATE FUNCTIONS
 24734	A010					; ==================================================================
 24735	A010					
 24736	A010					; ------------------------------------------------------------------
 24737	A010					; update_animated_tiles
 24738	A010					; Update animation frame and redraw animated tiles if needed
 24739	A010					; Call this every frame from main loop
 24740	A010					; ------------------------------------------------------------------
 24741	A010					update_animated_tiles:
 24742	A010					    ; Skip animation work on screens with no animated tile groups
 24743	A010	3A	59	E3		    ld a, (current_screen_anim_group_count)
 24744	A013	B7				    or a
 24745	A014	C8				    ret z
 24746	A015					
 24747	A015					    ; Increment timer
 24748	A015	3A	70	DC		    ld a, (anim_tile_timer)
 24749	A018	3C				    inc a
 24750	A019	32	70	DC		    ld (anim_tile_timer), a
 24751	A01C					
 24752	A01C					    ; Check if it's time to advance frame
 24753	A01C	47				    ld b, a
 24754	A01D	3A	72	DC		    ld a, (anim_tile_speed)
 24755	A020	B7				    or a
 24756	A021	20	05			    jr nz, .anim_speed_ok
 24757	A023	3E	01			    ld a, 1
 24758	A025	32	72	DC		    ld (anim_tile_speed), a
 24759	A028					.anim_speed_ok:
 24760	A028	B8				    cp b
 24761	A029	D0				    ret nc                          ; Not yet time to update (timer < speed)
 24762	A02A					
 24763	A02A					    ; Reset timer
 24764	A02A	AF				    xor a
 24765	A02B	32	70	DC		    ld (anim_tile_timer), a
 24766	A02E					
 24767	A02E					    ; Advance global animation counter
 24768	A02E	3A	71	DC		    ld a, (anim_tile_frame)
 24769	A031	3C				    inc a
 24770	A032	32	71	DC		    ld (anim_tile_frame), a
 24771	A035					
 24772	A035					    ; Update all animated tiles in VRAM
 24773	A035	CD	A2	4C		    call call_update_animated_tiles_vram_resident
 24774	A038					
 24775	A038	C9				    ret
 24776	A039					
 24777	A039					; ------------------------------------------------------------------
 24778	A039					; update_animated_tiles_vram
 24779	A039					; Update pattern data in VRAM for all animated tiles
 24780	A039					; This updates the actual tile patterns based on current frame
 24781	A039					; Destroys: AF, BC, DE, HL
 24782	A039					; ------------------------------------------------------------------
 24783	A039					update_animated_tiles_vram:
 24784	A039					    ; Protect VDP port sequence from ISR VRAM writes.
 24785	A039					    ; Always re-enables on exit (see FAST_LDIRVM note on LD A,I bug).
 24786	A039	F3				    di
 24787	A03A	CD	92	41		    call mapper_push_p2
 24788	A03D	3A	03	00		    ld a, ANIM_TILE_DATA_BANK
 24789	A040	CD	70	41		    call mapper_set_bank_p2
 24790	A043					
 24791	A043	21	E8	82		    ld hl, (anim_tile_table & #1FFF) | #8000
 24792	A046					
 24793	A046					.anim_vram_loop:
 24794	A046	7E				    ld a, (hl)                      ; A = target char code
 24795	A047	FE	FF			    cp 255
 24796	A049	28	57			    jr z, .anim_vram_done
 24797	A04B					
 24798	A04B	F5				    push af                         ; Save target char code
 24799	A04C	23				    inc hl
 24800	A04D	7E				    ld a, (hl)                      ; A = chars per tile
 24801	A04E	F5				    push af
 24802	A04F	23				    inc hl
 24803	A050	46				    ld b, (hl)                      ; B = frame count
 24804	A051	23				    inc hl
 24805	A052	23				    inc hl                          ; Skip speed byte (reserved)
 24806	A053	4E				    ld c, (hl)                      ; C = bytes per frame
 24807	A054	23				    inc hl
 24808	A055	5E				    ld e, (hl)                      ; DE = data pointer
 24809	A056	23				    inc hl
 24810	A057	56				    ld d, (hl)
 24811	A058	23				    inc hl                          ; HL = next table entry
 24812	A059	E5				    push hl
 24813	A05A	EB				    ex de, hl                       ; HL = data pointer
 24814	A05B					
 24815	A05B					    ; frame = global_frame % frame_count
 24816	A05B					    ; Fast path for power-of-two frame counts: frame & (count-1)
 24817	A05B	78				    ld a, b
 24818	A05C	3D				    dec a
 24819	A05D	57				    ld d, a
 24820	A05E	A0				    and b
 24821	A05F	20	06			    jr nz, .anim_mod_slow
 24822	A061	3A	71	DC		    ld a, (anim_tile_frame)
 24823	A064	A2				    and d
 24824	A065	18	09			    jr .anim_mod_done
 24825	A067					.anim_mod_slow:
 24826	A067	3A	71	DC		    ld a, (anim_tile_frame)
 24827	A06A					.anim_mod_loop:
 24828	A06A	B8				    cp b
 24829	A06B	38	03			    jr c, .anim_mod_done
 24830	A06D	90				    sub b
 24831	A06E	18	FA			    jr .anim_mod_loop
 24832	A070					.anim_mod_done:
 24833	A070					
 24834	A070					    ; DE = frame offset (frame * bytes_per_frame)
 24835	A070	47				    ld b, a
 24836	A071	16	00			    ld d, 0
 24837	A073	1E	00			    ld e, 0
 24838	A075					.anim_mul_loop:
 24839	A075	78				    ld a, b
 24840	A076	B7				    or a
 24841	A077	28	0A			    jr z, .anim_mul_done
 24842	A079	7B				    ld a, e
 24843	A07A	81				    add a, c
 24844	A07B	5F				    ld e, a
 24845	A07C	7A				    ld a, d
 24846	A07D	CE	00			    adc a, 0
 24847	A07F	57				    ld d, a
 24848	A080	05				    dec b
 24849	A081	18	F2			    jr .anim_mul_loop
 24850	A083					.anim_mul_done:
 24851	A083	19				    add hl, de                      ; HL = frame data pointer
 24852	A084					
 24853	A084	D1				    pop de                          ; DE = next table entry pointer
 24854	A085	F1				    pop af
 24855	A086	47				    ld b, a                         ; B = chars per tile
 24856	A087	F1				    pop af
 24857	A088	4F				    ld c, a                         ; C = target char code
 24858	A089	D5				    push de
 24859	A08A					
 24860	A08A					.anim_char_loop:
 24861	A08A	78				    ld a, b
 24862	A08B	B7				    or a
 24863	A08C	28	10			    jr z, .anim_char_done
 24864	A08E					
 24865	A08E	C5				    push bc
 24866	A08F	E5				    push hl
 24867	A090	79				    ld a, c
 24868	A091	CD	BB	A0		    call anim_upload_char_frame
 24869	A094	E1				    pop hl
 24870	A095	C1				    pop bc
 24871	A096					
 24872	A096	11	10	00		    ld de, 16
 24873	A099	19				    add hl, de                      ; Next char frame chunk
 24874	A09A	0C				    inc c                           ; Next target char code
 24875	A09B	05				    dec b
 24876	A09C	18	EC			    jr .anim_char_loop
 24877	A09E					
 24878	A09E					.anim_char_done:
 24879	A09E	D1				    pop de
 24880	A09F	EB				    ex de, hl                       ; HL = next table entry
 24881	A0A0	18	A4			    jr .anim_vram_loop
 24882	A0A2					
 24883	A0A2					.anim_vram_done:
 24884	A0A2	CD	99	41		    call mapper_pop_p2
 24885	A0A5	FB				    ei
 24886	A0A6	C9				    ret
 24887	A0A7					
 24888	A0A7					; ------------------------------------------------------------------
 24889	A0A7					; set_animation_speed
 24890	A0A7					; Set global animation speed for all animated tiles
 24891	A0A7					; Input:  A = Speed (frames between updates)
 24892	A0A7					; ------------------------------------------------------------------
 24893	A0A7					set_animation_speed:
 24894	A0A7	B7				    or a
 24895	A0A8	20	02			    jr nz, .anim_speed_store
 24896	A0AA	3E	01			    ld a, 1
 24897	A0AC					.anim_speed_store:
 24898	A0AC	32	72	DC		    ld (anim_tile_speed), a
 24899	A0AF	C9				    ret
 24900	A0B0					
 24901	A0B0					; ------------------------------------------------------------------
 24902	A0B0					; anim_copy_8_bytes
 24903	A0B0					; Copy 8 bytes from CPU memory to VRAM
 24904	A0B0					; Input: DE = source pointer, HL = VRAM destination
 24905	A0B0					; Destroys: AF, BC, DE, HL
 24906	A0B0					; ------------------------------------------------------------------
 24907	A0B0					anim_copy_8_bytes:
 24908	A0B0	06	08			    ld b, 8
 24909	A0B2					.anim_copy_loop:
 24910	A0B2	1A				    ld a, (de)
 24911	A0B3	CD	E3	40		    call FAST_WRTVRM
 24912	A0B6	13				    inc de
 24913	A0B7	23				    inc hl
 24914	A0B8	10	F8			    djnz .anim_copy_loop
 24915	A0BA					
 24916	A0BA	C9				    ret
 24917	A0BB					
 24918	A0BB					; ==================================================================
 24919	A0BB					; anim_upload_char_frame
 24920	A0BB					; Upload one animated char (pattern + color) to all 3 Screen 2 banks
 24921	A0BB					; Input: A = target char code, HL = source frame chunk (16 bytes)
 24922	A0BB					; Source layout: 8 pattern bytes + 8 color bytes
 24923	A0BB					; Destroys: AF, BC, DE, HL
 24924	A0BB					; ==================================================================
 24925	A0BB					anim_upload_char_frame:
 24926	A0BB	F5				    push af
