 22677	A571					; SPRITE MANAGEMENT FUNCTIONS
 22678	A571					; ==================================================================
 22679	A571					
 22680	A571					; A = hardware sprite index, B = X, C = Y, D = pattern, E = color
 22681	A571					show_sprite:
 22682	A571					    ; Safety check: Ensure sprite index < 32
 22683	A571	FE	20			    cp 32
 22684	A573	D0				    ret nc
 22685	A574					
 22686	A574					    ; Safety check: Never write Y >= 208 (208 is SAT end marker on MSX)
 22687	A574	F5				    push af
 22688	A575	79				    ld a, c
 22689	A576	FE	D0			    cp 208
 22690	A578	38	02			    jr c, .y_ok
 22691	A57A	0E	E0			    ld c, SPRITE_INVISIBLE
 22692	A57C					.y_ok:
 22693	A57C	F1				    pop af
 22694	A57D					
 22695	A57D					    ; Save pattern (D) and color (E) before calculating address
 22696	A57D	D5				    push de
 22697	A57E					
 22698	A57E					    ; Calculate base address for sprite: index * 4
 22699	A57E	6F				    ld l, a
 22700	A57F	26	00			    ld h, 0
 22701	A581	29				    add hl, hl      ; index * 2
 22702	A582	29				    add hl, hl      ; index * 4
 22703	A583					    ; Add base of the attribute table
 22704	A583	11	D4	E2		    ld de, sprite_attributes
 22705	A586	19				    add hl, de      ; HL = &sprite_attributes[index * 4]
 22706	A587					
 22707	A587					    ; Restore pattern and color
 22708	A587	D1				    pop de
 22709	A588					
 22710	A588					    ; Write attributes
 22711	A588	71				    ld (hl), c      ; Y
 22712	A589	23				    inc hl
 22713	A58A	70				    ld (hl), b      ; X
 22714	A58B	23				    inc hl
 22715	A58C	72				    ld (hl), d      ; Pattern
 22716	A58D	23				    inc hl
 22717	A58E	73				    ld (hl), e      ; Color
 22718	A58F					
 22719	A58F	3E	01			    ld a, 1
 22720	A591	32	5F	E2		    ld (sprites_dirty), a
 22721	A594	C9				    ret
