 7132	6595					    ; ------------------------------------------------------------------
 7133	6595					    ; get_behavior_tile
 7134	6595					    ; ------------------------------------------------------------------
 7135	6595					; Register Contract:
 7136	6595					;   Purpose: Read behavior byte for tile at (B=row, C=column) from the runtime behavior map.
 7137	6595					;   Inputs:
 7138	6595					;     - B = tile row    (0..23, out-of-range ? A=0, passable)
 7139	6595					;     - C = tile column (0..31, out-of-range ? A=0, passable)
 7140	6595					;     - current_behavior_map = 16-bit pointer to active screen behavior map
 7141	6595					;     - current_behavior_map_bank = memory bank number (mapper context)
 7142	6595					;   Outputs:
 7143	6595					;     - A = behavior byte:
 7144	6595					;     -   bits 7-4 (A & #F0): family / solidity class (0x00 = NoSolid, 0x10+ = Solid)
 7145	6595					;     -   bits 3-0 (A & #0F): flag bits (e.g. 0x08 = Interactable)
 7146	6595					;   Clobbers:
 7147	6595					;     - AF
 7148	6595					;   Preserved:
 7149	6595					;     - BC
 7150	6595					;     - DE
 7151	6595					;     - HL
 7152	6595					;   Notes:
 7153	6595					;     - Maintains a single-row cache (behavior_cache_row / behavior_cache_row_base)
 7154	6595					;     - so consecutive calls for the same row skip the row*32 multiply.
 7155	6595					;     - Mapper push/pop protects P2 bank around the map read (no-op in simple32k mode).
 7156	6595					;     - MUST be called with DE = entity index already set (DE is preserved, not used).
 7157	6595					
 7158	6595					get_behavior_tile:
 7159	6595					    ; Bounds check: row must be 0-23, column must be 0-31
 7160	6595					    ; NOTE: jp nc (not jr nc) to gbt_oob — gbt_oob is a global label defined after
 7161	6595					    ; get_behavior_tile_nb. Using jr would create a local-label scoping conflict in
 7162	6595					    ; glass.jar (get_behavior_tile_nb: starts a new scope, so .bt_out_of_bounds would
 7163	6595					    ; belong to that scope, not get_behavior_tile's scope).
 7164	6595	78				    ld a, b
 7165	6596	FE	18			    cp 24
 7166	6598	D2	F1	65		    jp nc, gbt_oob                ; Row >= 24: treat as passable
 7167	659B	79				    ld a, c
 7168	659C	FE	20			    cp 32
 7169	659E	D2	F1	65		    jp nc, gbt_oob                ; Column >= 32: treat as passable
 7170	65A1					get_behavior_tile_nb:
 7171	65A1					    ; Entry point for callers that guarantee B ? 0..23 and C ? 0..31.
 7172	65A1					    ; Saves 36 cycles (4+7+7+4+7+7) by skipping bounds validation.
 7173	65A1					    ; DO NOT call this unless the probe coordinates are provably in-bounds.
 7174	65A1	E5				    push hl
 7175	65A2	D5				    push de
 7176	65A3					
 7177	65A3					    ; Load cached behavior map pointer (fallback to current_behavior_map)
 7178	65A3	21	55	C1		    ld hl, behavior_cache_map_l
 7179	65A6	5E				    ld e, (hl)
 7180	65A7	23				    inc hl
 7181	65A8	56				    ld d, (hl)
 7182	65A9	7A				    ld a, d
 7183	65AA	B3				    or e
 7184	65AB	20	11			    jr nz, .map_ptr_ready
 7185	65AD					
 7186	65AD	ED	5B	51	C1	    ld de, (current_behavior_map)
 7187	65B1	7B				    ld a, e
 7188	65B2	32	55	C1		    ld (behavior_cache_map_l), a
 7189	65B5	7A				    ld a, d
 7190	65B6	32	56	C1		    ld (behavior_cache_map_h), a
 7191	65B9	3E	FF			    ld a, #FF
 7192	65BB	32	54	C1		    ld (behavior_cache_row), a
 7193	65BE					
 7194	65BE					.map_ptr_ready:
 7195	65BE					    ; Reuse previous row base when checking multiple points on same row
 7196	65BE	78				    ld a, b
 7197	65BF	21	54	C1		    ld hl, behavior_cache_row
 7198	65C2	BE				    cp (hl)
 7199	65C3	28	13			    jr z, .use_cached_row_base
 7200	65C5					
 7201	65C5					    ; Cache miss: row base = behavior_map + row*32
 7202	65C5	78				    ld a, b
 7203	65C6	6F				    ld l, a
 7204	65C7	26	00			    ld h, 0
 7205	65C9	29				    add hl, hl                    ; HL = row * 2
 7206	65CA	29				    add hl, hl                    ; HL = row * 4
 7207	65CB	29				    add hl, hl                    ; HL = row * 8
 7208	65CC	29				    add hl, hl                    ; HL = row * 16
 7209	65CD	29				    add hl, hl                    ; HL = row * 32
 7210	65CE	19				    add hl, de                    ; HL = row base address
 7211	65CF					
 7212	65CF	78				    ld a, b
 7213	65D0	32	54	C1		    ld (behavior_cache_row), a
 7214	65D3	22	57	C1		    ld (behavior_cache_row_base), hl
 7215	65D6	18	03			    jr .row_base_ready
 7216	65D8					
 7217	65D8					.use_cached_row_base:
 7218	65D8	2A	57	C1		    ld hl, (behavior_cache_row_base)
 7219	65DB					
 7220	65DB					.row_base_ready:
 7221	65DB	59				    ld e, c
 7222	65DC	16	00			    ld d, 0
 7223	65DE	19				    add hl, de                    ; HL = row base + column
 7224	65DF					
 7225	65DF					    ; Banked ROM build: protect P2 bank around the read in case behavior map is in ROM bank.
 7226	65DF	CD	92	41		    call mapper_push_p2
 7227	65E2	3A	53	C1		    ld a, (current_behavior_map_bank)
 7228	65E5	CD	70	41		    call mapper_set_bank_p2
 7229	65E8	7E				    ld a, (hl)                    ; A = behavior value
 7230	65E9	F5				    push af
 7231	65EA	CD	99	41		    call mapper_pop_p2
 7232	65ED	F1				    pop af
 7233	65EE	D1				    pop de
 7234	65EF	E1				    pop hl
 7235	65F0	C9				    ret
 7236	65F1					gbt_oob:
 7237	65F1	AF				    xor a                         ; A = 0 (passable)
 7238	65F2	C9				    ret
