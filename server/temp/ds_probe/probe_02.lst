 11061	77F0					; apply_collected_tiles
 11062	77F0					; Re-clears tiles that were previously collected on the current world/screen.
 11063	77F0					; Called after every screen load so collected tiles do not respawn.
 11064	77F0					; Input:  current_world_id and current_screen_id must already be set.
 11065	77F0					; Output: None
