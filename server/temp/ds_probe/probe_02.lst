 18701	6112					    ; Bank 2: CHRTBL2 + #1000 + (0 * 8)
 18702	6112	21	00	10		    ld hl, CHRTBL2 + #1000
 18703	6115	0E	08			    ld c, 8
 18704	6117	AF				    xor a
 18705	6118					init_char0_pattern_bank2_loop:
 18706	6118	CD	E3	40		    call FAST_WRTVRM
 18707	611B	23				    inc hl
