 5644	4CA9					; ==================================================================
 5645	4CA9					; INIT_GAME_SYSTEMS — in bank 0 so it is reachable from any bank
 5646	4CA9					; Calls routines in statically-mapped primary banks (1-3) via CALL.
 5647	4CA9					; Routines in far banks (4+) are called via _far trampolines above.
 5648	4CA9					; ==================================================================
 5649	4CA9					init_game_systems:
 5650	4CA9	CD	41	00		    call DISSCR               ; Disable screen while loading VRAM assets
 5651	4CAC					    ; Cold boot / restart must not trust cached VRAM state from RAM contents.
 5652	4CAC	AF				    xor a
 5653	4CAD	32	2E	C0		    ld (vram_cache_tile_patterns_ready), a
 5654	4CB0	32	2F	C0		    ld (vram_cache_tile_colors_ready), a
 5655	4CB3	32	30	C0		    ld (vram_cache_font_ready), a
 5656	4CB6	3E	FF			    ld a, #FF
 5657	4CB8	32	35	C0		    ld (current_screen2_tilebank_id), a
 5658	4CBB					    ; Initialize component systems (entities detected)
 5659	4CBB	CD	00	60		    call init_components
 5660	4CBE					
 5661	4CBE					    ; Load shared gameplay pattern/color data once unless VRAM was invalidated.
 5662	4CBE	CD	26	4C		    call load_patterns_to_vram_far
 5663	4CC1	CD	6A	4C		    call load_colors_to_vram_far
 5664	4CC4					
 5665	4CC4					    ; Initialize animated tile runtime (safe no-op if no animated groups)
 5666	4CC4	CD	7C	4B		    call init_animated_tiles_far
 5667	4CC7					
 5668	4CC7					    ; Initialize game entities with real positions from JSON
 5669	4CC7	CD	39	4A		    call init_entities_far
 5670	4CCA					
 5671	4CCA					    ; Load the first game screen
 5672	4CCA	CD	DC	4C		    call load_game_screen
 5673	4CCD	CD	9A	79		    call rebuild_used_entity_list
 5674	4CD0					
 5675	4CD0					    ; Initialize font system
 5676	4CD0	CD	E2	4B		    call init_font_system_far
 5677	4CD3					    ; HUD dirty flag - will be rendered after screen loading (by GameFlow WorldLink)
 5678	4CD3	3E	01			    ld a, 1
 5679	4CD5	32	6C	DC		    ld (hud_dirty_flag), a
 5680	4CD8	CD	44	00		    call ENASCR               ; Re-enable screen after VRAM updates
 5681	4CDB	C9				    ret
 5682	4CDC					
 5683	4CDC					load_game_screen:
 5684	4CDC	C9				    ret
