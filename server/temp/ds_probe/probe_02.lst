 1004	0000					; ; ------------------------------------------------------------------
 1005	0000					; ; resource_invalidate_gameplay_vram_cache
 1006	0000					; ; Outputs:
 1007	0000					; ;   none
 1008	0000					; ; Clobbers:
 1009	0000					; ;   AF
 1010	0000					; ; Notes:
 1011	0000					; ;   Use this when a fullscreen effect or presentation screen overwrites
 1012	0000					; ;   shared gameplay/font VRAM tables outside the normal loaders.
 1013	0000					; ; ------------------------------------------------------------------
 1014	0000					; resource_invalidate_gameplay_vram_cache:
 1015	0000					;     call resource_invalidate_pattern_vram_cache
 1016	0000					;     call resource_invalidate_color_vram_cache
 1017	0000					;     call resource_invalidate_font_vram_cache
 1018	0000					;     ld a, #FF
 1019	0000					;     ld (current_screen2_tilebank_id), a
 1020	0000					;     ret
 1021	0000					;
 1022	0000					; ; ------------------------------------------------------------------
 1023	0000					; ; resource_invalidate_screen_ram_cache
 1024	0000					; ; Outputs:
 1025	0000					; ;   none
 1026	0000					; ; Clobbers:
 1027	0000					; ;   AF
 1028	0000					; ; Notes:
 1029	0000					; ;   Invalidates the clean RAM copies used to rebuild runtime screen data
 1030	0000					; ;   without re-reading the same banked resource on repeated screen loads.
 1031	0000					; ; ------------------------------------------------------------------
 1032	0000					; resource_invalidate_screen_ram_cache:
 1033	0000					;     ld a, #FF
 1034	0000					;     ld (resource_ram_cache_screen_layout_id), a
 1035	0000					;     ld (resource_ram_cache_effects_layout_id), a
 1036	0000					;     ld (resource_ram_cache_behavior_map_id), a
 1037	0000					;     ld (resource_ram_cache_effect_zone_table_id), a
 1038	0000					;     ret
 1039	0000					;
 1040	0000					; ; ------------------------------------------------------------------
 1041	0000					; ; resource_find_by_id
 1042	0000					; ; Inputs:
 1043	0000					; ;   A = resource id
 1044	0000					; ; Outputs on success (carry clear):
 1045	0000					; ;   HL = pointer to descriptor entry
 1046	0000					; ;   A  = bank number
 1047	0000					; ;   DE = visible window address
 1048	0000					; ;   BC = size in bytes
 1049	0000					; ; Outputs on failure (carry set):
 1050	0000					; ;   HL = resource_table
 1051	0000					; ; Clobbers:
 1052	0000					; ;   AF, BC, DE, HL
 1053	0000					; ; Notes:
 1054	0000					; ;   Mirrors the descriptor into RAM so callers can inspect fields later
 1055	0000					; ;   without re-scanning the table.
 1056	0000					; ; ------------------------------------------------------------------
 1057	0000					; resource_find_by_id:
 1058	0000					;     ld c, a
 1059	0000					;     ld a, (resource_descriptor_id)
 1060	0000					;     cp c
 1061	0000					;     jr nz, .resource_find_scan
 1062	0000					;     ld hl, (resource_descriptor_ptr)
 1063	0000					;     ld a, h
 1064	0000					;     or l
 1065	0000					;     jr z, .resource_find_scan
 1066	0000					;     ld a, (resource_descriptor_bank)
 1067	0000					;     ld de, (resource_descriptor_addr)
 1068	0000					;     ld bc, (resource_descriptor_size)
 1069	0000					;     or a
 1070	0000					;     ret
 1071	0000					; .resource_find_scan:
 1072	0000					;     ld hl, resource_table
 1073	0000					;     ld b, RESOURCE_TABLE_COUNT
 1074	0000					; .resource_find_loop:
 1075	0000					;     ld a, b
 1076	0000					;     or a
 1077	0000					;     jp z, .resource_find_not_found
 1078	0000					;     ld a, (hl)
 1079	0000					;     cp c
 1080	0000					;     jp z, .resource_find_found
 1081	0000					;     ld de, RESOURCE_TABLE_ENTRY_SIZE
 1082	0000					;     add hl, de
 1083	0000					;     dec b
 1084	0000					;     jp .resource_find_loop
 1085	0000					;
 1086	0000					; .resource_find_found:
 1087	0000					;     ld (resource_descriptor_ptr), hl
 1088	0000					;     push hl
 1089	0000					;     ld a, (hl)
 1090	0000					;     ld (resource_descriptor_id), a
 1091	0000					;     inc hl
 1092	0000					;     ld a, (hl)
 1093	0000					;     ld (resource_descriptor_type), a
 1094	0000					;     inc hl
 1095	0000					;     ld a, (hl)
 1096	0000					;     ld (resource_descriptor_group), a
 1097	0000					;     inc hl
 1098	0000					;     ld a, (hl)
 1099	0000					;     ld (resource_descriptor_bank), a
 1100	0000					;     inc hl
 1101	0000					;     ld e, (hl)
 1102	0000					;     inc hl
 1103	0000					;     ld d, (hl)
 1104	0000					;     ld (resource_descriptor_addr), de
 1105	0000					;     inc hl
 1106	0000					;     ld c, (hl)
 1107	0000					;     inc hl
 1108	0000					;     ld b, (hl)
 1109	0000					;     ld (resource_descriptor_size), bc
 1110	0000					;     pop hl
 1111	0000					;     ld a, (resource_descriptor_bank)
 1112	0000					;     or a
 1113	0000					;     ret
 1114	0000					;
 1115	0000					; .resource_find_not_found:
 1116	0000					;     xor a
 1117	0000					;     ld (resource_descriptor_ptr), a
 1118	0000					;     ld (resource_descriptor_ptr + 1), a
 1119	0000					;     ld (resource_descriptor_type), a
 1120	0000					;     ld (resource_descriptor_group), a
 1121	0000					;     ld (resource_descriptor_bank), a
 1122	0000					;     ld (resource_descriptor_addr), a
 1123	0000					;     ld (resource_descriptor_addr + 1), a
 1124	0000					;     ld (resource_descriptor_size), a
 1125	0000					;     ld (resource_descriptor_size + 1), a
 1126	0000					;     ld a, #FF
 1127	0000					;     ld (resource_descriptor_id), a
 1128	0000					;     scf
 1129	0000					;     ret
 1130	0000					;
 1131	0000					; ; ------------------------------------------------------------------
 1132	0000					; ; resource_copy_from_bank_to_ram
 1133	0000					; ; Inputs:
 1134	0000					; ;   A  = bank number
 1135	0000					; ;   HL = source visible in mapper data window
 1136	0000					; ;   DE = destination in RAM
 1137	0000					; ;   BC = size in bytes
 1138	0000					; ; Outputs:
 1139	0000					; ;   carry clear
 1140	0000					; ; Clobbers:
 1141	0000					; ;   AF, BC, DE, HL
 1142	0000					; ; ------------------------------------------------------------------
 1143	0000					; resource_copy_from_bank_to_ram:
 1144	0000					;     ld a, b
 1145	0000					;     or c
 1146	0000					;     ret z
 1147	0000					;     push af
 1148	0000					;     call mapper_push_p2
 1149	0000					;     pop af
 1150	0000					;     call mapper_set_bank_p2
 1151	0000					;     ldir
 1152	0000					;     call mapper_pop_p2
 1153	0000					;     or a
 1154	0000					;     ret
 1155	0000					;
