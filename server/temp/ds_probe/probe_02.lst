 7716	6839					; ==================================================================
 7717	6839					; HEALTH HELPER FUNCTIONS (called by State Machine actions)
 7718	6839					; ==================================================================
 7719	6839					
 7720	6839					decrease_entity_lives:
 7721	6839					    ; Decrease lives for entity in register C by amount in register A
 7722	6839					    ; Input: C = entity index, A = amount to decrease
 7723	6839					    ; Output: Updated entity_health_current
 7724	6839					    ; Destroys: AF, DE, HL
 7725	6839	C5				    push bc
 7726	683A	47				    ld b, a                       ; Save amount in B
 7727	683B	21	39	E5		    ld hl, entity_health_current
 7728	683E	59				    ld e, c
 7729	683F	16	00			    ld d, 0
 7730	6841	19				    add hl, de
 7731	6842	7E				    ld a, (hl)                    ; A = current health
 7732	6843	90				    sub b                         ; Subtract amount
 7733	6844	30	01			    jr nc, .store_health          ; If no carry (result >= 0), store
 7734	6846	AF				    xor a                         ; Clamp to 0 if negative
 7735	6847					.store_health:
 7736	6847	77				    ld (hl), a                    ; Store new health
 7737	6848	C1				    pop bc
 7738	6849	C9				    ret
 7739	684A					
 7740	684A					increase_entity_lives:
 7741	684A					    ; Increase lives for entity in register C by amount in register A
 7742	684A					    ; Input: C = entity index, A = amount to increase
 7743	684A					    ; Output: Updated entity_health_current (clamped to max)
 7744	684A					    ; Destroys: AF, DE, HL
 7745	684A	C5				    push bc
 7746	684B	47				    ld b, a                       ; Save amount in B
 7747	684C					
 7748	684C					    ; Get current health
 7749	684C	21	39	E5		    ld hl, entity_health_current
 7750	684F	59				    ld e, c
 7751	6850	16	00			    ld d, 0
 7752	6852	19				    add hl, de
 7753	6853	7E				    ld a, (hl)                    ; A = current health
 7754	6854					
 7755	6854					    ; Add amount
 7756	6854	80				    add a, b
 7757	6855	47				    ld b, a                       ; Save result in B
 7758	6856					
 7759	6856					    ; Get max health
 7760	6856	21	5C	E5		    ld hl, entity_health_max
 7761	6859	19				    add hl, de
 7762	685A	7E				    ld a, (hl)                    ; A = max health
 7763	685B					
 7764	685B					    ; Clamp to max
 7765	685B	B8				    cp b                          ; Compare max with result
 7766	685C	30	01			    jr nc, .store_result          ; If max >= result, use result
 7767	685E	47				    ld b, a                       ; Otherwise clamp to max
 7768	685F					
 7769	685F					.store_result:
 7770	685F	21	39	E5		    ld hl, entity_health_current
 7771	6862	19				    add hl, de
 7772	6863	70				    ld (hl), b                    ; Store clamped health
 7773	6864	C1				    pop bc
 7774	6865	C9				    ret
