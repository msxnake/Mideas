 11090	7808	19				    add hl, de                     ; HL = &collected_screen[index]
 11091	7809	3A	54	E3		    ld a, (current_screen_id)      ; A = screen currently loaded
 11092	780C	BE				    cp (hl)                        ; Compare with stored screen ID
