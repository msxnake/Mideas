 22723	A595					; Clear all sprites (set Y = SPRITE_INVISIBLE)
 22724	A595					; OPTIMIZED: Uses faster increment method instead of ADD HL,DE
 22725	A595					clear_all_sprites:
 22726	A595	21	D4	E2		    ld hl, sprite_attributes
 22727	A598	06	20			    ld b, 32
 22728	A59A	3E	E0			    ld a, SPRITE_INVISIBLE
 22729	A59C					.sprite_clear_loop:
 22730	A59C	77				    ld (hl), a      ; Set Y = SPRITE_INVISIBLE
 22731	A59D	23				    inc hl          ; Skip to X
 22732	A59E	23				    inc hl          ; Skip to Pattern
 22733	A59F	23				    inc hl          ; Skip to Color
 22734	A5A0	23				    inc hl          ; Next sprite (4× INC HL = 24 cycles vs ADD HL,DE = 35 cycles)
 22735	A5A1	10	F9			    djnz .sprite_clear_loop
 22736	A5A3	3E	01			    ld a, 1
 22737	A5A5	32	5F	E2		    ld (sprites_dirty), a
