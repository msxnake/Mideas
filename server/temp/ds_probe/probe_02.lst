 25091	A13C					
 25092	A13C					    ; Save opcode D to scratch RAM so anim_transform_vram_block can reload it
 25093	A13C					    ; after DE is reused internally as a pointer.
 25094	A13C	7A				    ld a, d
 25095	A13D	32	74	DC		    ld (anim_tile_transform_flags + 1), a
 25096	A140					
 25097	A140					    ; Pattern banks: read bank 0 once and mirror the transformed result to all 3
 25098	A140					    ; SCREEN 2 banks to keep animation phase identical across thirds.
