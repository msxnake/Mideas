 18583	6097					; SCREEN LOADING FUNCTIONS
 18584	6097					; ==================================================================
 18585	6097					
 18586	6097					; Color shift lookup table (0-15 shifted to high nibble)
 18587	6097					; OPTIMIZED: Table lookup is faster than 4× RLCA (11 cycles vs 16 cycles)
 18588	6097					color_shift_table:
 18589	6097	00	10	20	30	40	50	60	70	    db #00, #10, #20, #30, #40, #50, #60, #70
 18590	609F	80	90	A0	B0	C0	D0	E0	F0	    db #80, #90, #A0, #B0, #C0, #D0, #E0, #F0
 18591	60A7					
 18592	60A7					; Helper function to set VDP background and border colors
 18593	60A7					; Input: A = background color (0-15), B = border color (0-15)
 18594	60A7					set_screen_colors:
 18595	60A7	F5				    push af
 18596	60A8	C5				    push bc
 18597	60A9	E5				    push hl
 18598	60AA					
 18599	60AA					    ; Set VDP Register 7: [Background Color (4-7) | Border Color (0-3)]
 18600	60AA					
 18601	60AA					    ; OPTIMIZED: Use lookup table instead of 4× RLCA
 18602	60AA					    ; Process Background Color (in A) -> High Nibble
 18603	60AA	E6	0F			    and #0F                    ; Ensure 0-15 range
 18604	60AC	21	97	60		    ld hl, color_shift_table
 18605	60AF	85				    add a, l                   ; Add offset to table base
 18606	60B0	6F				    ld l, a
 18607	60B1	8C				    adc a, h                   ; Handle carry
 18608	60B2	95				    sub l
 18609	60B3	67				    ld h, a
 18610	60B4	7E				    ld a, (hl)                 ; A = background color << 4
 18611	60B5	4F				    ld c, a                    ; Save shifted background in C
 18612	60B6					
 18613	60B6					    ; Process Border Color (in B) -> Low Nibble
 18614	60B6	78				    ld a, b                    ; Get border color
 18615	60B7	E6	0F			    and #0F                    ; Ensure 0-15 range
 18616	60B9					
 18617	60B9					    ; Combine
 18618	60B9	B1				    or c                       ; Combine: background << 4 | border
 18619	60BA					
 18620	60BA	47				    ld b, a                    ; Value for VDP R#7
 18621	60BB	0E	07			    ld c, 7                    ; VDP Register 7
 18622	60BD	CD	04	41		    call FAST_WRTVDP           ; BIOS call to write VDP register
 18623	60C0					
 18624	60C0	E1				    pop hl
 18625	60C1	C1				    pop bc
 18626	60C2	F1				    pop af
 18627	60C3	C9				    ret
 18628	60C4					
 18629	60C4					; Helper function to initialize character 0 (empty cell) with background color
 18630	60C4					; Input: A = background color (0-15)
 18631	60C4					; This ensures empty cells show the correct background color instead of BIOS default (blue)
 18632	60C4					init_char0_color:
 18633	60C4	F5				    push af
 18634	60C5	C5				    push bc
 18635	60C6	D5				    push de
 18636	60C7	E5				    push hl
 18637	60C8					    
 18638	60C8					    ; Calculate color byte: (bg_color << 4) | bg_color
 18639	60C8					    ; This makes both foreground and background the same color
 18640	60C8	E6	0F			    and #0F                    ; Ensure 0-15 range
 18641	60CA	47				    ld b, a                    ; Save in B
 18642	60CB	07				    rlca                       ; Shift to high nibble
 18643	60CC	07				    rlca
 18644	60CD	07				    rlca
 18645	60CE	07				    rlca
 18646	60CF	B0				    or b                       ; Combine: bg_color in both nibbles
 18647	60D0	47				    ld b, a                    ; B = color byte to write
 18648	60D1					    
 18649	60D1					    ; Write color to character 0 in all 3 banks (8 bytes each)
 18650	60D1					    ; Bank 0: CLRTBL2 + (0 * 8)
 18651	60D1	21	00	20		    ld hl, CLRTBL2
 18652	60D4	0E	08			    ld c, 8                    ; 8 bytes per character
 18653	60D6					init_char0_bank0_loop:
 18654	60D6	78				    ld a, b                    ; Get color byte
 18655	60D7	CD	E3	40		    call FAST_WRTVRM                ; Write to VRAM
 18656	60DA	23				    inc hl
 18657	60DB	0D				    dec c
 18658	60DC	20	F8			    jr nz, init_char0_bank0_loop
 18659	60DE					    
 18660	60DE					    ; Bank 1: CLRTBL2 + #800 + (0 * 8)
 18661	60DE	21	00	28		    ld hl, CLRTBL2 + #800
 18662	60E1	0E	08			    ld c, 8
 18663	60E3					init_char0_bank1_loop:
 18664	60E3	78				    ld a, b
 18665	60E4	CD	E3	40		    call FAST_WRTVRM
 18666	60E7	23				    inc hl
 18667	60E8	0D				    dec c
 18668	60E9	20	F8			    jr nz, init_char0_bank1_loop
 18669	60EB					    
 18670	60EB					    ; Bank 2: CLRTBL2 + #1000 + (0 * 8)
 18671	60EB	21	00	30		    ld hl, CLRTBL2 + #1000
 18672	60EE	0E	08			    ld c, 8
 18673	60F0					init_char0_bank2_loop:
 18674	60F0	78				    ld a, b
 18675	60F1	CD	E3	40		    call FAST_WRTVRM
 18676	60F4	23				    inc hl
