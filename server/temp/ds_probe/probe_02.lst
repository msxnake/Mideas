 18471	602A					; Register Contract:
 18472	602A					;   Purpose: Wait for SPACE press and release after showing the presentation screen.
 18473	602A					;   Inputs:
 18474	602A					;     - None
 18475	602A					;   Outputs:
 18476	602A					;     - None
 18477	602A					;   Clobbers:
 18478	602A					;     - AF
 18479	602A					;   Preserved:
 18480	602A					;     - BC
 18481	602A					;     - DE
 18482	602A					;     - HL
 18483	602A					;     - IX
 18484	602A					;     - IY
 18485	602A					presentation_wait_for_fire:
 18486	602A					.pwff_wait_press:
 18487	602A	76				    halt
 18488	602B	CD	39	60		    call presentation_read_fire_direct
 18489	602E	B7				    or a
 18490	602F	28	F9			    jr z, .pwff_wait_press
 18491	6031					.pwff_wait_release:
 18492	6031	76				    halt
 18493	6032	CD	39	60		    call presentation_read_fire_direct
 18494	6035	B7				    or a
 18495	6036	20	F9			    jr nz, .pwff_wait_release
 18496	6038	C9				    ret
 18497	6039					
 18498	6039					; Register Contract:
 18499	6039					;   Purpose: Read SPACE directly for presentation-screen waits without depending on runtime input tasks.
 18500	6039					;   Inputs:
 18501	6039					;     - None
 18502	6039					;   Outputs:
 18503	6039					;     - A = 1 if SPACE pressed, A = 0 otherwise
 18504	6039					;   Clobbers:
 18505	6039					;     - AF
 18506	6039					;   Preserved:
 18507	6039					;     - BC
 18508	6039					;     - DE
 18509	6039					;     - HL
 18510	6039					;     - IX
 18511	6039					;     - IY
 18512	6039					;   Notes:
 18513	6039					;     - Uses keyboard matrix row 8 bit 0 (SPACE, active low).
 18514	6039					presentation_read_fire_direct:
 18515	6039	3E	08			    ld a, 8
 18516	603B	CD	48	41		    call FAST_SNSMAT
 18517	603E	CB	47			    bit 0, a
 18518	6040	28	02			    jr z, .prfd_pressed
 18519	6042	AF				    xor a
 18520	6043	C9				    ret
 18521	6044					.prfd_pressed:
 18522	6044	3E	01			    ld a, 1
 18523	6046	C9				    ret
