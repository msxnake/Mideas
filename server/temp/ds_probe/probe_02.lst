 17171	A4E1					gameflow_handle_worldlink:
 17172	A4E1					    ; WorldLink node - load world and enter game loop
 17173	A4E1					    ; DE = world data pointer:
 17174	A4E1					    ;   [load_world_ptr DW][load_world_bank DB][init_ptr DW][init_bank DB]
 17175	A4E1					    ; BC = connection table (for exit)
 17176	A4E1					
 17177	A4E1	C5				    push bc         ; Save connection table
 17178	A4E2					
 17179	A4E2					    ; Load the world
 17180	A4E2					    ; DE points to: dw load_world_X, db load_world_bank, dw init_routine, db init_bank
 17181	A4E2	EB				    ex de, hl
 17182	A4E3	5E				    ld e, (hl)
 17183	A4E4	23				    inc hl
 17184	A4E5	56				    ld d, (hl)
 17185	A4E6	23				    inc hl
 17186	A4E7	46				    ld b, (hl)      ; B = load_world_X bank
 17187	A4E8	23				    inc hl
 17188	A4E9	E5				    push hl         ; Save pointer to optional WorldLink init routine
 17189	A4EA	62				    ld h, d
 17190	A4EB	6B				    ld l, e         ; HL = load_world_X address
 17191	A4EC					
 17192	A4EC					    ; Mapper-safe far call to world load routine
 17193	A4EC	7C				    ld a, h
 17194	A4ED	B5				    or l
 17195	A4EE	28	04			    jr z, .after_load
 17196	A4F0	78				    ld a, b
 17197	A4F1	CD	0B	42		    call mapper_call_hl_auto
 17198	A4F4					
 17199	A4F4					.after_load:
