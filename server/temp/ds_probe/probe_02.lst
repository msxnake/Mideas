 13838	817B					; ==================================================================
 13839	817B					; Action_ChangeSprite
 13840	817B					; ------------------------------------------------------------------
 13841	817B					; Cambia el sprite activo de una entidad. Realiza 5 operaciones:
 13842	817B					;   1. Redirect direccional: si entity_facing_dir != 0, sustituye el
 13843	817B					;      sprite pedido por su variante direccional (left/right/up/down)
 13844	817B					;      usando SM_FacingDirTablePtrs.
 13845	817B					;   2. Commit: escribe el sprite final en entity_sprite_asset_index.
 13846	817B					;   3. Reset de animación: pone entity_anim_frame y entity_anim_tick a 0.
 13847	817B					;   4. Flags de animación: activa PLAYING, aplica el flag de LOOP del
 13848	817B					;      sprite, borra ONLY_WHEN_MOVING y marca FORCE_UPLOAD para que el
 13849	817B					;      próximo update_animation_component sincronice el frame actual
 13850	817B					;      fuera del path de cambio de sprite.
 13851	817B					;   5. Colores de capas: actualiza sprite_layer_colors (tabla RAM) con
 13852	817B					;      los colores del nuevo sprite desde SM_SpriteLayerColorTable.
 13853	817B					;
 13854	817B					; Input:
 13855	817B					;   HL  = puntero al parámetro (sprite asset ID, 1 byte)
 13856	817B					;   B   = entity index (convención SM_ExecuteActions)
 13857	817B					;
 13858	817B					; Output:
 13859	817B					;   HL  = puntero al byte siguiente a los parámetros (para el caller)
 13860	817B					;
 13861	817B					; Destruye: AF, BC, DE, HL (todos restaurados al salir salvo HL=next param)
 13862	817B					;
 13863	817B					; Stack al entrar (top ? bottom):
 13864	817B					;   [llamada desde SM_ExecuteActions]
 13865	817B					; Stack al salir: igual que al entrar.
 13866	817B					;
 13867	817B					; Tablas ROM usadas:
 13868	817B					;   SM_FacingDirTablePtrs      — punteros a las 4 tablas de redirect
 13869	817B					;   sprite_loop_flags          — 1 byte/sprite: 0x02=loop, 0x00=one-shot
 13870	817B					;   SM_SpritePatternPtrTable   — puntero al frame 0 de cada sprite
 13871	817B					;   SM_SpriteLayerColorTable   — colores por sprite (SPRITE_MAX_ENTITY_LAYERS bytes/sprite)
 13872	817B					;
 13873	817B					; Variables RAM usadas:
 13874	817B					;   entity_facing_dir          — dirección actual de la entidad (0-4)
 13875	817B					;   entity_sprite_asset_index  — índice del sprite activo de la entidad
 13876	817B					;   entity_anim_frame          — frame actual de la animación
 13877	817B					;   entity_anim_tick           — contador de ticks entre frames
 13878	817B					;   entity_anim_flags          — flags de animación (ver bits más abajo)
 13879	817B					;   entity_sprite_config       — base HW sprite + layer count (2 bytes/entidad)
 13880	817B					;   sprite_layer_colors        — colores actuales por slot HW sprite (RAM)
 13881	817B					;
 13882	817B					; Bits de entity_anim_flags:
 13883	817B					;   bit 0 = ANIM_FLAG_PLAYING       (1 = animando)
 13884	817B					;   bit 1 = ANIM_FLAG_LOOP          (1 = bucle infinito, 0 = one-shot)
 13885	817B					;   bit 2 = ANIM_FLAG_ONLY_WHEN_MOVING (1 = solo anima si vel != 0)
 13886	817B					;   bit 3 = ANIM_FLAG_COMPLETED     (1 = one-shot llegó al último frame)
 13887	817B					;   bit 4 = ANIM_FLAG_FORCE_UPLOAD  (1 = sincronizar frame actual en el próximo update_animation_component)
 13888	817B					;
 13889	817B					; NOTA: el bloque de redirect direccional usa B como registro temporal
 13890	817B					; para guardar el sprite ID. Al salir del bloque, B queda corrupto.
 13891	817B					; Se restaura explícitamente con "ld b, 0" antes de los add hl, bc.
 13892	817B					; ==================================================================
 13893	817B					Action_ChangeSprite:
 13894	817B	7E				    ld a, (hl)              ; A = Sprite Asset ID pedido por la SM
 13895	817C	23				    inc hl                  ; HL apunta al byte siguiente al parámetro
 13896	817D	E5				    push hl                 ; [stack] guarda puntero de parámetros para el ret final
 13897	817E					
 13898	817E	F5				    push af                 ; [stack] guarda Sprite Asset ID (se necesita tras setup)
 13899	817F					
 13900	817F					    ; ------------------------------------------------------------------
 13901	817F					    ; Setup: convertir B (entity index) a BC = (0, entity_index)
 13902	817F					    ; Convención de SM_ExecuteActions: B = entity index al entrar.
 13903	817F					    ; ------------------------------------------------------------------
 13904	817F	48				    ld c, b                 ; C = entity index
 13905	8180	06	00			    ld b, 0                 ; B = 0  ?  BC = (0, entity_index)
 13906	8182					
 13907	8182					    ; Pre-calcular HL = &entity_sprite_asset_index[entity]
 13908	8182					    ; Se usará tras el bloque de redirect para escribir el sprite final.
 13909	8182	21	3E	E2		    ld hl, entity_sprite_asset_index
 13910	8185	09				    add hl, bc              ; HL = &entity_sprite_asset_index[entity]
 13911	8186					
 13912	8186	F1				    pop af                  ; A = Sprite Asset ID (recuperado del stack)
 13913	8187					
 13914	8187					    ; ------------------------------------------------------------------
 13915	8187					    ; BLOQUE 1: Redirect direccional
 13916	8187					    ; Si entity_facing_dir[entity] != 0, reemplaza el sprite pedido por
 13917	8187					    ; su variante para la dirección actual.
 13918	8187					    ;   facing 0 = sin dirección ? usar sprite tal cual
 13919	8187					    ;   facing 1 = izquierda  ? SM_FacingDirTablePtrs[0] ? sprite_dir_left_table
 13920	8187					    ;   facing 2 = derecha     ? SM_FacingDirTablePtrs[1] ? sprite_dir_right_table
 13921	8187					    ;   facing 3 = arriba      ? SM_FacingDirTablePtrs[2] ? sprite_dir_up_table
 13922	8187					    ;   facing 4 = abajo       ? SM_FacingDirTablePtrs[3] ? sprite_dir_down_table
 13923	8187					    ;
 13924	8187					    ; Las tablas de dirección son arrays de 1 byte por sprite asset:
 13925	8187					    ;   dir_table[originalSprite] = spriteVariante
 13926	8187					    ; Si no existe variante, la tabla devuelve el mismo ID original.
 13927	8187					    ;
 13928	8187					    ; IMPORTANTE: este bloque usa B como temporal para guardar el sprite ID.
 13929	8187					    ; Al salir, B queda con el sprite ID (no con 0). Se corrige después.
 13930	8187					    ; ------------------------------------------------------------------
 13931	8187	E5				    push hl                 ; [stack] guarda &entity_sprite_asset_index[entity]
 13932	8188					
 13933	8188	26	00			    ld h, 0
 13934	818A	69				    ld l, c                 ; HL = entity index
 13935	818B	11	1E	E1		    ld de, entity_facing_dir
 13936	818E	19				    add hl, de              ; HL = &entity_facing_dir[entity]
 13937	818F	5E				    ld e, (hl)              ; E = facing dir (0=none, 1=left, 2=right, 3=up, 4=down)
 13938	8190					
 13939	8190	47				    ld b, a                 ; B = sprite ID original  [B QUEDA CORRUPTO hasta ld b,0 abajo]
 13940	8191	7B				    ld a, e                 ; A = facing dir
 13941	8192	B7				    or a
 13942	8193	28	15			    jr z, .acs_dir_done     ; facing = 0 ? no hay redirect, usar sprite original
 13943	8195	FE	05			    cp 5
 13944	8197	30	11			    jr nc, .acs_dir_done    ; facing inválido ? ignorar redirect y usar sprite original
 13945	8199					
 13946	8199					    ; Convertir facing (1-4) a índice de tabla (0-3): dec a
 13947	8199	3D				    dec a                   ; A = índice en SM_FacingDirTablePtrs (0=left, 1=right, 2=up, 3=down)
 13948	819A	21	73	81		    ld hl, SM_FacingDirTablePtrs
 13949	819D	16	00			    ld d, 0
 13950	819F	5F				    ld e, a
 13951	81A0	19				    add hl, de
 13952	81A1	19				    add hl, de              ; HL = &SM_FacingDirTablePtrs[facing_index * 2]  (tabla de punteros, DW)
 13953	81A2	5E				    ld e, (hl)
 13954	81A3	23				    inc hl
 13955	81A4	56				    ld d, (hl)              ; DE = puntero a la tabla de sprites para esta dirección
 13956	81A5					
 13957	81A5					    ; Leer el sprite redirigido: dir_table[originalSprite]
 13958	81A5	68				    ld l, b                 ; L = sprite ID original
 13959	81A6	26	00			    ld h, 0
 13960	81A8	19				    add hl, de              ; HL = &dir_table[originalSprite]
 13961	81A9	46				    ld b, (hl)              ; B = sprite ID redirigido (puede ser el mismo si no hay variante)
 13962	81AA					
 13963	81AA					.acs_dir_done:
 13964	81AA					    ; A = sprite ID final (original o redirigido)
 13965	81AA	78				    ld a, b                 ; A = sprite ID (posiblemente redirigido)
 13966	81AB	E1				    pop hl                  ; HL = &entity_sprite_asset_index[entity]  [recuperado del stack]
 13967	81AC					
 13968	81AC					    ; ------------------------------------------------------------------
 13969	81AC					    ; BLOQUE 2: Commit del sprite y reset de estado de animación
 13970	81AC					    ; ------------------------------------------------------------------
 13971	81AC					
 13972	81AC					    ; D guardará el sprite ID para uso posterior (color update, loop flags).
 13973	81AC					    ; No usar A directamente porque las instrucciones siguientes lo machan.
 13974	81AC	57				    ld d, a                 ; D = Sprite Asset ID final (preservado para los bloques 3-5)
 13975	81AD	77				    ld (hl), a              ; entity_sprite_asset_index[entity] = sprite ID final
 13976	81AE					
 13977	81AE					    ; RESTAURAR B=0: el bloque de redirect dejó B=sprite_ID.
 13978	81AE					    ; Todos los "add hl, bc" siguientes necesitan BC = (0, entity_index).
 13979	81AE	06	00			    ld b, 0                 ; B = 0  ?  BC = (0, entity_index)  [BUG FIX: corrupto por redirect]
 13980	81B0					
 13981	81B0					    ; Reiniciar frame al principio del nuevo sprite
 13982	81B0	21	5E	DF		    ld hl, entity_anim_frame
 13983	81B3	09				    add hl, bc              ; HL = &entity_anim_frame[entity]
 13984	81B4	36	00			    ld (hl), 0              ; entity_anim_frame[entity] = 0  (empieza desde frame 0)
 13985	81B6					
 13986	81B6					    ; Reiniciar contador de ticks para que el primer avance de frame
 13987	81B6					    ; ocurra tras entity_anim_speed ticks completos, no de inmediato.
 13988	81B6	21	7E	DF		    ld hl, entity_anim_tick
 13989	81B9	09				    add hl, bc              ; HL = &entity_anim_tick[entity]
 13990	81BA	36	00			    ld (hl), 0              ; entity_anim_tick[entity] = 0
 13991	81BC					
 13992	81BC					    ; ------------------------------------------------------------------
 13993	81BC					    ; BLOQUE 3: Leer el flag de loop del nuevo sprite
 13994	81BC					    ; sprite_loop_flags[spriteId] = 0x02 si loop, 0x00 si one-shot
 13995	81BC					    ; El valor se guarda en E para aplicarlo a entity_anim_flags.
 13996	81BC					    ; D se restaura al sprite ID tras poner D=0 para el add hl,de.
 13997	81BC					    ; ------------------------------------------------------------------
 13998	81BC	21	12	A0		    ld hl, sprite_loop_flags
 13999	81BF	7A				    ld a, d                 ; A = Sprite Asset ID (salvar antes de poner D=0)
 14000	81C0	5F				    ld e, a                 ; E = Sprite Asset ID
 14001	81C1	16	00			    ld d, 0
 14002	81C3	19				    add hl, de              ; HL = &sprite_loop_flags[spriteId]
 14003	81C4	5E				    ld e, (hl)              ; E = loop flag (0x02=loop, 0x00=one-shot)
 14004	81C5	57				    ld d, a                 ; D = Sprite Asset ID  (restaurado para el upload)
 14005	81C6					
 14006	81C6					    ; ------------------------------------------------------------------
 14007	81C6					    ; BLOQUE 4: Actualizar entity_anim_flags
 14008	81C6					    ;
 14009	81C6					    ; Cambios aplicados:
 14010	81C6					    ;   - bit 3 (COMPLETED)       ? 0  (el one-shot anterior ya no importa)
 14011	81C6					    ;   - bit 0 (PLAYING)         ? 1  (arrancar animación)
 14012	81C6					    ;   - bit 1 (LOOP)            ? según sprite_loop_flags del nuevo sprite
 14013	81C6					    ;   - bit 2 (ONLY_WHEN_MOVING)? 0  SIEMPRE, para cualquier sprite
 14014	81C6					    ;   - bit 4 (FORCE_UPLOAD)    ? 1  pedir sincronización del frame actual
 14015	81C6					    ;                                 en el próximo update_animation_component
 14016	81C6					    ;
 14017	81C6					    ; Razón de limpiar ONLY_WHEN_MOVING siempre:
 14018	81C6					    ;   Cuando el SM llama ChangeSprite, lo hace porque quiere mostrar ese
 14019	81C6					    ;   sprite ahora. La animación debe avanzar siempre que PLAYING=1,
 14020	81C6					    ;   sin importar la velocidad. La lógica de "anima solo si se mueve"
 14021	81C6					    ;   es solo relevante para el sprite inicial de la entidad (config del
 14022	81C6					    ;   editor). Una vez en la SM, el estado controla qué sprite se muestra.
 14023	81C6					    ;   Si se dejara ONLY_WHEN_MOVING=1 para sprites loop, la animación walk
 14024	81C6					    ;   no avanzaría: la fricción del movement component puede dejar vel_x=0
 14025	81C6					    ;   antes de que llegue el turno de animation (step 11 > step 5).
 14026	81C6					    ; ------------------------------------------------------------------
 14027	81C6	21	BE	DF		    ld hl, entity_anim_flags
 14028	81C9	09				    add hl, bc              ; HL = &entity_anim_flags[entity]
 14029	81CA	7E				    ld a, (hl)              ; A = flags actuales
 14030	81CB					
 14031	81CB	CB	9F			    res 3, a                ; bit 3 = 0: borrar ANIM_FLAG_COMPLETED
 14032	81CD	F6	01			    or ANIM_FLAG_PLAYING    ; bit 0 = 1: activar ANIM_FLAG_PLAYING
 14033	81CF	E6	FD			    and #FD                 ; bit 1 = 0: limpiar ANIM_FLAG_LOOP antes de aplicar el nuevo
 14034	81D1	B3				    or e                    ; bit 1 = nuevo loop flag (E=0x02 o 0x00 según el sprite)
 14035	81D2	E6	FB			    and #FB                 ; bit 2 = 0: borrar ANIM_FLAG_ONLY_WHEN_MOVING (siempre)
 14036	81D4	E6	EF			    and #EF                 ; bit 4 = 0: limpiar FORCE_UPLOAD previo
 14037	81D6	F6	10			    or ANIM_FLAG_FORCE_UPLOAD
 14038	81D8	77				    ld (hl), a              ; entity_anim_flags[entity] = flags actualizados
 14039	81D9					
 14040	81D9					    ; ------------------------------------------------------------------
 14041	81D9					    ; BLOQUE 5: Actualizar tabla de colores de capas en RAM
 14042	81D9					    ;
 14043	81D9					    ; sprite_layer_colors es una tabla RAM indexada por slot HW sprite.
 14044	81D9					    ; SM_SpriteLayerColorTable es una tabla ROM de SPRITE_MAX_ENTITY_LAYERS
 14045	81D9					    ; bytes por sprite, con el color de cada capa del sprite.
 14046	81D9					    ;
 14047	81D9					    ; Se copian los colores del nuevo sprite a los slots HW de la entidad
 14048	81D9					    ; para que render_sprites use los colores correctos en el próximo frame.
 14049	81D9					    ;
 14050	81D9					    ; Registros a la entrada:
 14051	81D9					    ;   D = sprite asset ID
 14052	81D9					    ;   C = entity index
 14053	81D9					    ;   B = 0
 14054	81D9					    ; ------------------------------------------------------------------
 14055	81D9					
 14056	81D9					    ; Validar rango (mismo guard que en el upload)
 14057	81D9	7A				    ld a, d
 14058	81DA	FE	12			    cp SM_SpriteAssetCount
 14059	81DC	D2	0E	82		    jp nc, .acs_skip_color_update  ; fuera de rango ? saltar
 14060	81DF					
 14061	81DF	D5				    push de                 ; [stack] guarda D=spriteId, E=loopFlag
 14062	81E0					
 14063	81E0					    ; Obtener el base HW sprite de la entidad: entity_sprite_config[entity * 2]
 14064	81E0	26	00			    ld h, 0
 14065	81E2	69				    ld l, c                 ; HL = entity index
 14066	81E3	29				    add hl, hl              ; HL = entity index * 2
 14067	81E4	11	D2	A0		    ld de, entity_sprite_config
 14068	81E7	19				    add hl, de              ; HL = &entity_sprite_config[entity * 2]
 14069	81E8	4E				    ld c, (hl)              ; C = base HW sprite index (slot de partida en la OAM)
 14070	81E9					
 14071	81E9	D1				    pop de                  ; DE: D=spriteId, E=loopFlag  [recuperado del stack]
 14072	81EA					
 14073	81EA					    ; Calcular HL = SM_SpriteLayerColorTable + spriteId * SPRITE_MAX_ENTITY_LAYERS
 14074	81EA					    ; mediante suma repetida (SPRITE_MAX_ENTITY_LAYERS es pequeño, típicamente 2-4)
 14075	81EA	6A				    ld l, d                 ; L = sprite asset ID
 14076	81EB	26	00			    ld h, 0                 ; HL = sprite asset ID
 14077	81ED	5D				    ld e, l
 14078	81EE	54				    ld d, h                 ; DE = sprite asset ID (multiplicando)
 14079	81EF	21	00	00		    ld hl, 0
