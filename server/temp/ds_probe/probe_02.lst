 3091	4155					; ==================================================================
 3092	4155					; MAPPER RUNTIME API
 3093	4155					; File: mapper.asm
 3094	4155					; Description: Centralized mapper register writes (no scattered inline writes)
 3095	4155					; Target mapper: konami
 3096	4155					; ROM mode: megarom (autoMegaROM=true)
 3097	4155					; ==================================================================
 3098	4155					
 3099	4155					; Konami (without SCC) write window references:
 3100	4155					;   6000h-7FFFh, 8000h-9FFFh, A000h-BFFFh are switch registers.
 3101	4155					; Note: in original Konami cartridges 4000h-5FFFh is typically fixed.
 3102	4155					; Mapper register writes are enabled for this build configuration.
 3103	4155					
 3104	4155					; Mapper registers for active target format
 3105	4155					MAPPER_REG_P1       EQU #6000
 3106	4155					MAPPER_REG_P2       EQU #8000
 3107	4155					MAPPER_REG_P3       EQU #A000
 3108	4155					MAPPER_REG_P4       EQU #A000
 3109	4155					
 3110	4155					; ------------------------------------------------------------------
 3111	4155					; mapper_runtime_init
 3112	4155					; Initializes mapper state variables with deterministic defaults.
 3113	4155					; ------------------------------------------------------------------
 3114	4155					mapper_runtime_init:
 3115	4155	AF				    xor a
 3116	4156	32	1C	C0		    ld (mapper_bank_p1_current), a
 3117	4159	3E	01			    ld a, 1
 3118	415B	32	1D	C0		    ld (mapper_bank_p2_current), a
 3119	415E	3E	02			    ld a, 2
 3120	4160	32	1E	C0		    ld (mapper_bank_p3_current), a
 3121	4163	3E	03			    ld a, 3
 3122	4165	32	1F	C0		    ld (mapper_bank_p4_current), a
 3123	4168	C9				    ret
 3124	4169					
 3125	4169					; ------------------------------------------------------------------
