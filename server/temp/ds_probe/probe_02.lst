 17299	A563					; CONNECTION UTILITIES
 17300	A563					; ==================================================================
 17301	A563					
 17302	A563					; Get next node from connection table (for simple single-connection nodes)
 17303	A563					; Input: BC = connection table pointer
 17304	A563					; Output: HL = next node address (or 0 if none)
 17305	A563					gameflow_get_default_connection:
 17306	A563					    ; Connection table format:
 17307	A563					    ;   db CONNECTION_TYPE
 17308	A563					    ;   dw NODE_ADDRESS
 17309	A563					    ;   db CONNECTION_END
 17310	A563					    
 17311	A563	60				    ld h, b
 17312	A564	69				    ld l, c
 17313	A565	7E				    ld a, (hl)
 17314	A566	FE	FF			    cp CONNECTION_END
 17315	A568	28	06			    jr z, .no_connection
 17316	A56A					    
 17317	A56A	23				    inc hl
 17318	A56B	7E				    ld a, (hl)
 17319	A56C	23				    inc hl
 17320	A56D	66				    ld h, (hl)
 17321	A56E	6F				    ld l, a         ; HL = next node address
 17322	A56F	C9				    ret
 17323	A570					
 17324	A570					.no_connection:
 17325	A570	21	00	00		    ld hl, 0
 17326	A573	C9				    ret
 17327	A574					
 17328	A574					; Get connection by type
 17329	A574					; Input: BC = connection table pointer, A = connection type to find
 17330	A574					; Output: HL = next node address (or 0 if not found)
 17331	A574					gameflow_get_connection_by_type:
 17332	A574	57				    ld d, a         ; Save connection type
 17333	A575	60				    ld h, b
 17334	A576	69				    ld l, c
 17335	A577					
 17336	A577					.search_loop:
 17337	A577	7E				    ld a, (hl)
 17338	A578	FE	FF			    cp CONNECTION_END
 17339	A57A	28	0F			    jr z, .not_found
 17340	A57C					
 17341	A57C	BA				    cp d
 17342	A57D	28	06			    jr z, .found
 17343	A57F					
 17344	A57F					    ; OPTIMIZED: Skip this entry using ADD (11 cycles vs 3× INC = 18 cycles)
 17345	A57F	01	03	00		    ld bc, 3        ; Entry size: 1 byte type + 2 bytes address
 17346	A582	09				    add hl, bc
 17347	A583	18	F2			    jr .search_loop
 17348	A585					
 17349	A585					.found:
 17350	A585	23				    inc hl
 17351	A586	7E				    ld a, (hl)
 17352	A587	23				    inc hl
 17353	A588	66				    ld h, (hl)
 17354	A589	6F				    ld l, a
 17355	A58A	C9				    ret
 17356	A58B					
 17357	A58B					.not_found:
 17358	A58B	21	00	00		    ld hl, 0
 17359	A58E	C9				    ret
