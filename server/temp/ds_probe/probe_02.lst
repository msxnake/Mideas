 5708	6000					
 5709	6000					; ==================================================================
 5710	6000					; COMPONENT TYPE CONSTANTS(Based on ComponentDefinition analysis)
 5711	6000					    ; ==================================================================
 5712	6000					
 5713	6000					; Core Components(always present)
 5714	6000					COMP_POSITION   EQU 0; Position component(x, y coordinates)
 5715	6000					COMP_SPRITE     EQU 1; Sprite rendering component
 5716	6000					COMP_MOVEMENT   EQU 2; Movement / velocity component
 5717	6000					COMP_COLLISION  EQU 3; Collision detection component
 5718	6000					COMP_INPUT      EQU 4; Input handling component
 5719	6000					COMP_BEHAVIOR   EQU 5; AI / Logic behavior component
 5720	6000					COMP_HEALTH     EQU 6; Health / damage component
 5721	6000					COMP_ANIMATION  EQU 7; Animation state component
 5722	6000					COMP_JUMP       EQU 8; Jump behavior component(platformer physics)
 5723	6000					COMP_GRAVITY    EQU 9; Gravity physics component
 5724	6000					COMP_DEADLY_TILES EQU 13; Deadly behavior-map tile detection marker
 5725	6000					COMP_AIR_CONTROL EQU 15; Air control restrictions while airborne
 5726	6000					
 5727	6000					    ; Component flags for entity filtering(16 - bit masks for 10 + components)
 5728	6000					COMP_MASK_POSITION   EQU #0001; Binary: 0000000000000001
 5729	6000					COMP_MASK_SPRITE     EQU #0002; Binary: 0000000000000010
 5730	6000					COMP_MASK_MOVEMENT   EQU #0004; Binary: 0000000000000100
 5731	6000					COMP_MASK_COLLISION  EQU #0008; Binary: 0000000000001000
 5732	6000					COMP_MASK_INPUT      EQU #0010; Binary: 0000000000010000
 5733	6000					COMP_MASK_BEHAVIOR   EQU #0020; Binary: 0000000000100000
 5734	6000					COMP_MASK_HEALTH     EQU #0040; Binary: 0000000001000000
 5735	6000					COMP_MASK_ANIMATION  EQU #0080; Binary: 0000000010000000
 5736	6000					COMP_MASK_JUMP       EQU #0100; Binary: 0000000100000000
 5737	6000					COMP_MASK_GRAVITY    EQU #0200; Binary: 0000001000000000
 5738	6000					COMP_MASK_AUTO_DESTROY EQU #0400; Binary: 0000010000000000
 5739	6000					COMP_MASK_DEADLY_TILES EQU #2000; Binary: 0010000000000000
 5740	6000					COMP_MASK_WALL_JUMP EQU #4000; Binary: 0100000000000000
 5741	6000					COMP_MASK_AIR_CONTROL EQU #8000; Binary: 1000000000000000
 5742	6000					
 5743	6000					; ==================================================================
 5744	6000					; ANIMATION FLAGS (entity_anim_flags)
 5745	6000					; ==================================================================
 5746	6000					ANIM_FLAG_PLAYING            EQU #01
 5747	6000					ANIM_FLAG_LOOP               EQU #02
 5748	6000					ANIM_FLAG_ONLY_WHEN_MOVING   EQU #04
 5749	6000					ANIM_FLAG_COMPLETED          EQU #08
 5750	6000					ANIM_FLAG_FORCE_UPLOAD       EQU #10
 5751	6000					ANIM_DEFAULT_SPEED           EQU 8
 5752	6000					
 5753	6000					    ; ==================================================================
 5754	6000					; COMPONENT DATA STRUCTURES(Entity - Component arrays)
 5755	6000					    ; ==================================================================
 5756	6000					
 5757	6000					; NOTE: Core entity variables are now defined in variables.asm
 5758	6000					    ; (entity_x_pos, entity_y_pos, entity_vel_x, entity_vel_y, entity_comp_masks, etc.)
 5759	6000					
 5760	6000					    ; Jump Component Data(Fixed - Point 8.8 for smooth physics)
 5761	6000					    ; Using temporary storage for optional components to save RAM
 5762	6000					entity_jump_vel_y   EQU temp_word_3; Y velocity for jumping(signed word, 32 words = 64 bytes)
 5763	6000					entity_slash_vel_x  EQU temp_byte_3; Additive horizontal slash velocity from bonus tiles (32 bytes)
 5764	6000					entity_slash_vel_y  EQU temp_byte_28; Additive vertical slash velocity from bonus tiles (32 bytes)
 5765	6000					entity_jump_count   EQU temp_byte_4; Current jump count(0 = grounded, 1 = first jump, etc.)(32 bytes)
 5766	6000					entity_jump_max     EQU temp_byte_25; Configured max jumps for this entity (32 bytes)
 5767	6000					entity_jump_bonus   EQU temp_byte_27; Temporary extra jumps granted by bonus tiles (32 bytes)
 5768	6000					entity_on_ground    EQU temp_byte_5; Ground contact flag(bit 0 = on ground)(32 bytes)
 5769	6000					
 5770	6000					    ; Gravity Component Data
 5771	6000					entity_gravity_vel  EQU temp_word_4; Accumulated gravity velocity(signed word, 64 bytes)
 5772	6000					
 5773	6000					    ; Health Component Data
 5774	6000					entity_health_current EQU temp_byte_6 ; Current health/lives (32 bytes)
 5775	6000					entity_health_max     EQU temp_byte_7 ; Maximum health/lives (32 bytes)
 5776	6000					
 5777	6000					; Deadly Tile Collision Data
 5778	6000					entity_flag_deadly_tile EQU temp_byte_8 ; Flag: bit 0 = touching deadly tile (32 bytes)
 5779	6000					entity_deadly_collision EQU temp_byte_8 ; Backward-compatible alias
 5780	6000					tileDead EQU tileDead_dbg ; Debug byte: mirrors hero deadly contact (entity 0)
 5781	6000					tileDeadLatched EQU tileDead_latched_dbg ; Debug byte: latched hero deadly detection
 5782	6000					tileDeadX EQU tileDead_x_dbg ; Debug byte: last sampled tile X
 5783	6000					tileDeadY EQU tileDead_y_dbg ; Debug byte: last sampled tile Y
 5784	6000					tileDeadValue EQU tileDead_value_dbg ; Debug byte: raw behavior byte read
 5785	6000					
 5786	6000					    ; Damage Component Data
 5787	6000					entity_invincibility_frames EQU temp_byte_9  ; Countdown timer for invulnerability (32 bytes)
 5788	6000					entity_damage_amount        EQU temp_byte_10 ; Damage dealt by this entity (32 bytes)
 5789	6000					
 5790	6000					    ; Shoot Component Data
 5791	6000					entity_shoot_cooldown   EQU temp_byte_11 ; Cooldown frames until can shoot (32 bytes)
 5792	6000					entity_shoot_sprite_id  EQU temp_byte_12 ; Projectile sprite ID (32 bytes)
 5793	6000					entity_shoot_speed      EQU temp_byte_13 ; Projectile velocity (32 bytes)
 5794	6000					
 5795	6000					    ; Collision Layer Data (for projectile and advanced collision)
 5796	6000					entity_collision_layer  EQU temp_byte_14 ; Which layer this entity is on (32 bytes)
 5797	6000					entity_collides_with    EQU temp_byte_15 ; Bitmask of layers this entity collides with (32 bytes)
 5798	6000					
 5799	6000					    ; Platform Riding Data
 5800	6000					entity_platform_id      EQU temp_byte_16 ; ID of platform underneath (255 = none) (32 bytes)
 5801	6000					entity_platform_grace   EQU temp_byte_17 ; Grace frames for platform (32 bytes)
 5802	6000					entity_wall_collision_flags EQU temp_byte_18 ; Directional wall collision bits (32 bytes)
 5803	6000					entity_collision_hitbox_w EQU temp_byte_19 ; Entity collision hitbox width (32 bytes)
 5804	6000					entity_collision_hitbox_h EQU temp_byte_20 ; Entity collision hitbox height (32 bytes)
 5805	6000					entity_collision_offset_x EQU temp_byte_21 ; Entity collision hitbox X offset (32 bytes)
 5806	6000					entity_collision_offset_y EQU temp_byte_22 ; Entity collision hitbox Y offset (32 bytes)
 5807	6000					entity_entity_collision_flags EQU temp_byte_23 ; bit0 entity(any), bit1 enemy, bit2 item (32 bytes)
 5808	6000					entity_last_collision_entity EQU temp_byte_24 ; Last collided entity index (255=none) (32 bytes)
 5809	6000					
 5810	6000					    ; Input Disable Flag
 5811	6000					entity_input_disabled EQU temp_byte_26 ; 0=enabled, 1=disabled (32 bytes)
