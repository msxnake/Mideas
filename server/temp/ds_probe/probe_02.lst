 7632	67E8					    ; ==================================================================
 7633	67E8					
 7634	67E8					init_health_system:
 7635	67E8					    ; Initialize health for all entities with Health component
 7636	67E8					    ; Default: current = 3, max = 3 (configurable per entity)
 7637	67E8	06	20			    ld b, 32                      ; Loop all entities
 7638	67EA	21	5D	DE		    ld hl, entity_comp_masks      ; Check low byte for Health bit
 7639	67ED	0E	00			    ld c, 0                       ; Entity index
 7640	67EF					
 7641	67EF					.init_loop:
 7642	67EF	7E				    ld a, (hl)
 7643	67F0	E6	40			    and COMP_MASK_HEALTH          ; COMP_MASK_HEALTH (#0040, low byte bit 6)
 7644	67F2	28	13			    jr z, .init_next_entity       ; Skip if no health component
 7645	67F4					
 7646	67F4					    ; Initialize current health (default: 3)
 7647	67F4	C5				    push bc
 7648	67F5	E5				    push hl
 7649	67F6	21	39	E5		    ld hl, entity_health_current
 7650	67F9	59				    ld e, c
 7651	67FA	16	00			    ld d, 0
