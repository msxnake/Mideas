 9446	6F8F					; ------------------------------------------------------------------
 9447	6F8F					; wall_build_hitbox_cache
 9448	6F8F					; ------------------------------------------------------------------
 9449	6F8F					; Register Contract:
 9450	6F8F					;   Purpose: Compute and cache hitbox AABB and adaptive probe coordinates
 9451	6F8F					;            from entity position (wall_temp_x/y) plus collision offsets/sizes.
 9452	6F8F					;   Inputs:
 9453	6F8F					;     - DE                        = entity index (used to index per-entity arrays)
 9454	6F8F					;     - wall_temp_x               = cached entity X origin (set before calling)
 9455	6F8F					;     - wall_temp_y               = cached entity Y origin (set before calling)
 9456	6F8F					;     - entity_collision_hitbox_w[DE]: hitbox width  (0 treated as 1)
 9457	6F8F					;     - entity_collision_hitbox_h[DE]: hitbox height (0 treated as 1)
 9458	6F8F					;     - entity_collision_offset_x[DE]: signed X offset from entity origin to hitbox left
 9459	6F8F					;     - entity_collision_offset_y[DE]: signed Y offset from entity origin to hitbox top
 9460	6F8F					;   Outputs:
 9461	6F8F					;     - wall_hit_left   = hitbox left  pixel (entity_x + offset_x, clamped 0..255)
 9462	6F8F					;     - wall_hit_top    = hitbox top   pixel (entity_y + offset_y, clamped 0..255)
 9463	6F8F					;     - wall_hit_right  = left + (w-1), clamped 0..255
 9464	6F8F					;     - wall_hit_bottom = top  + (h-1), clamped 0..255
 9465	6F8F					;     - wall_hit_w      = effective width  (>= 1)
 9466	6F8F					;     - wall_hit_h      = effective height (>= 1)
 9467	6F8F					;     - wall_probe_left / wall_probe_right : X probes (inset up to 2px from sides)
 9468	6F8F					;     - wall_probe_top  / wall_probe_bottom: Y probes (inset up to 2px from top/bottom)
 9469	6F8F					;   Clobbers: AF, BC, HL
 9470	6F8F					;   Preserved: DE (entity index is never modified)
 9471	6F8F					;   Notes:
 9472	6F8F					;     - Adaptive inset: min(2, floor((right-left)/2)) and min(2, floor((bottom-top)/2)).
 9473	6F8F					;       Prevents corner-only probes for entities smaller than 4 pixels on an axis.
 9474	6F8F					;     - Call wall_add_signed_offset_clamped for offset application.
 9475	6F8F					;     - Called once at entity loop entry; called again after every position snap.
 9476	6F8F					; ------------------------------------------------------------------
 9477	6F8F					wall_build_hitbox_cache:
 9478	6F8F					    ; Width (minimum 1)
