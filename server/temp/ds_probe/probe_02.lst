 25627	6049					; ------------------------------------------------------------------
 25628	6049					; imprimir_marco
 25629	6049					; Draw HUD frame borders (called once per screen load)
 25630	6049					; ------------------------------------------------------------------
 25631	6049					imprimir_marco:
 25632	6049	F5				    push af
 25633	604A	C5				    push bc
 25634	604B	D5				    push de
 25635	604C	E5				    push hl
 25636	604D	DD	E5			    push ix
 25637	604F					
 25638	604F	06	05			    ld b, HUD_ELEMENT_COUNT
 25639	6051	DD	21	00	60	    ld ix, hud_element_data
 25640	6055					
 25641	6055					.marco_loop:
 25642	6055	C5				    push bc                     ; Save counter
 25643	6056					
 25644	6056					    ; Check visible flag first (offset 8)
 25645	6056	DD	7E	08		    ld a, (ix+8)                ; A = Visible
 25646	6059	B7				    or a
 25647	605A	28	2C			    jr z, .skip_marco           ; Skip if not visible
 25648	605C					
 25649	605C					    ; Read element fields
 25650	605C	DD	56	01		    ld d, (ix+1)                ; D = X position (pixels)
 25651	605F	DD	5E	02		    ld e, (ix+2)                ; E = Y position (pixels)
 25652	6062	DD	46	03		    ld b, (ix+3)                ; B = Width (tiles)
 25653	6065	DD	4E	04		    ld c, (ix+4)                ; C = Height (tiles)
 25654	6068	DD	7E	05		    ld a, (ix+5)                ; A = Flags
 25655	606B					
 25656	606B					    ; Check if border flag is set (bit 0)
 25657	606B	CB	47			    bit 0, a
 25658	606D	28	19			    jr z, .skip_marco           ; Skip if no border
 25659	606F					
 25660	606F					    ; Convert X,Y pixels to Tile coordinates
 25661	606F					    ; TileX = X/8, TileY = Y/8
 25662	606F	7A				    ld a, d
 25663	6070	CB	3F			    srl a
 25664	6072	CB	3F			    srl a
 25665	6074	CB	3F			    srl a
 25666	6076	57				    ld d, a                     ; D = Tile X
 25667	6077					
 25668	6077	7B				    ld a, e
 25669	6078	CB	3F			    srl a
 25670	607A	CB	3F			    srl a
 25671	607C	CB	3F			    srl a
 25672	607E	5F				    ld e, a                     ; E = Tile Y
 25673	607F					
 25674	607F					    ; Adjust for padding: Frame is 1 tile larger on all sides
 25675	607F	15				    dec d                       ; Frame X = Content X - 1
 25676	6080	1D				    dec e                       ; Frame Y = Content Y - 1
 25677	6081					
 25678	6081					    ; Frame Width = Content Width + 2
 25679	6081	04				    inc b
 25680	6082	04				    inc b                       ; Width += 2
 25681	6083					
 25682	6083	0C				    inc c
 25683	6084	0C				    inc c                       ; Height += 2
 25684	6085					
 25685	6085	CD	6F	61		    call hud_draw_frame
 25686	6088					
 25687	6088					.skip_marco:
 25688	6088					    ; Move to next element
 25689	6088	01	09	00		    ld bc, 9                    ; Size of each element entry
 25690	608B	DD	09			    add ix, bc                  ; IX points to next element
 25691	608D					
 25692	608D	C1				    pop bc                      ; Restore counter
 25693	608E	10	C5			    djnz .marco_loop
 25694	6090					
 25695	6090	DD	E1			    pop ix
 25696	6092	E1				    pop hl
 25697	6093	D1				    pop de
 25698	6094	C1				    pop bc
 25699	6095	F1				    pop af
 25700	6096	C9				    ret
 25701	6097					
 25702	6097					; ------------------------------------------------------------------
 25703	6097					; render_hud
 25704	6097					; Main HUD rendering function
 25705	6097					; Only redraws when hud_dirty_flag is set
 25706	6097					; Input:
 25707	6097					;   None
 25708	6097					; Output:
 25709	6097					;   None
 25710	6097					; Clobbers:
 25711	6097					;   None visible to caller
 25712	6097					; Preserves:
 25713	6097					;   AF, BC, DE, HL, IX
 25714	6097					; Notes:
 25715	6097					;   - Returns immediately if hud_dirty_flag = 0
 25716	6097					;   - Re-applies dynamic numeric fields (Score/Lives/custom bindings) after redrawing static text
 25717	6097					; ------------------------------------------------------------------
 25718	6097					render_hud:
 25719	6097	3A	6C	DC		    ld a, (hud_dirty_flag)
 25720	609A	B7				    or a
 25721	609B	C8				    ret z                       ; Skip if HUD hasn't changed
 25722	609C	AF				    xor a
 25723	609D	32	6C	DC		    ld (hud_dirty_flag), a      ; Clear flag after rendering
 25724	60A0	F5				    push af
 25725	60A1	C5				    push bc
 25726	60A2	D5				    push de
 25727	60A3	E5				    push hl
 25728	60A4	DD	E5			    push ix
 25729	60A6					
 25730	60A6	06	05			    ld b, HUD_ELEMENT_COUNT
 25731	60A8	DD	21	00	60	    ld ix, hud_element_data
 25732	60AC					
 25733	60AC					.render_loop:
 25734	60AC	C5				    push bc                     ; Save counter
 25735	60AD					
 25736	60AD					    ; Check visible flag first (offset 8)
 25737	60AD	DD	7E	08		    ld a, (ix+8)                ; A = Visible
 25738	60B0	B7				    or a
 25739	60B1	28	5B			    jr z, .skip_element         ; Skip if not visible
 25740	60B3					
 25741	60B3					    ; Read element fields
 25742	60B3	DD	56	01		    ld d, (ix+1)                ; D = X position (pixels)
 25743	60B6	DD	5E	02		    ld e, (ix+2)                ; E = Y position (pixels)
 25744	60B9	DD	46	03		    ld b, (ix+3)                ; B = Width (tiles)
 25745	60BC	DD	4E	04		    ld c, (ix+4)                ; C = Height (tiles)
 25746	60BF	DD	7E	05		    ld a, (ix+5)                ; A = Flags
 25747	60C2					
 25748	60C2					    ; Save values we'll need later
 25749	60C2	C5				    push bc                     ; Save Width, Height
 25750	60C3	D5				    push de                     ; Save X, Y
 25751	60C4					
 25752	60C4					    ; ---------------------------------------------------------
 25753	60C4					    ; 1. Draw Frame (if enabled)
 25754	60C4					    ; ---------------------------------------------------------
 25755	60C4	CB	47			    bit 0, a                    ; Check Bit 0 (Border)
 25756	60C6	28	1D			    jr z, .no_border
 25757	60C8					
 25758	60C8					    ; Convert X,Y pixels to Tile coordinates
 25759	60C8					    ; TileX = X/8, TileY = Y/8
 25760	60C8	7A				    ld a, d
 25761	60C9	CB	3F			    srl a
 25762	60CB	CB	3F			    srl a
 25763	60CD	CB	3F			    srl a
 25764	60CF	57				    ld d, a                     ; D = Tile X
 25765	60D0					    
 25766	60D0	7B				    ld a, e
 25767	60D1	CB	3F			    srl a
 25768	60D3	CB	3F			    srl a
 25769	60D5	CB	3F			    srl a
 25770	60D7	5F				    ld e, a                     ; E = Tile Y
 25771	60D8					    
 25772	60D8					    ; Adjust for padding: Frame is 1 tile larger on all sides
 25773	60D8	15				    dec d                       ; Frame X = Content X - 1
 25774	60D9	1D				    dec e                       ; Frame Y = Content Y - 1
 25775	60DA					    
 25776	60DA					    ; Frame Width = Content Width + 2
 25777	60DA	04				    inc b
 25778	60DB	04				    inc b                       ; Width += 2
 25779	60DC					    
 25780	60DC	0C				    inc c
 25781	60DD	0C				    inc c                       ; Height += 2
 25782	60DE					    
 25783	60DE	CD	6F	61		    call hud_draw_frame
 25784	60E1					    
 25785	60E1					    ; Restore original X, Y, Width, Height for text rendering
 25786	60E1	D1				    pop de                      ; DE = X, Y (pixels)
 25787	60E2	C1				    pop bc                      ; BC = Width, Height (tiles)
 25788	60E3					    ; Re-push in same order as original (BC bottom, DE top)
 25789	60E3	C5				    push bc                     ; Save Width, Height (bottom)
 25790	60E4	D5				    push de                     ; Save X, Y (top)
 25791	60E5					
 25792	60E5					.no_border:
 25793	60E5					    ; ---------------------------------------------------------
 25794	60E5					    ; 2. Draw Text
 25795	60E5					    ; ---------------------------------------------------------
 25796	60E5	D1				    pop de                      ; DE = X, Y (pixels)
 25797	60E6	C1				    pop bc                      ; BC = Width, Height (discard, not needed)
 25798	60E7					
 25799	60E7					    ; Calculate VRAM address from X,Y pixel coordinates
 25800	60E7					    ; Screen 2 Name Table = #1800 + (Y/8)*32 + (X/8)
 25801	60E7					    
 25802	60E7					    ; Y/8 = row
 25803	60E7	7B				    ld a, e                     ; A = Y
 25804	60E8	CB	3F			    srl a
 25805	60EA	CB	3F			    srl a
 25806	60EC	CB	3F			    srl a                       ; A = Y/8 (row)
 25807	60EE					
 25808	60EE					    ; row * 32
 25809	60EE	6F				    ld l, a
 25810	60EF	26	00			    ld h, 0
 25811	60F1	29				    add hl, hl                  ; * 2
 25812	60F2	29				    add hl, hl                  ; * 4
 25813	60F3	29				    add hl, hl                  ; * 8
 25814	60F4	29				    add hl, hl                  ; * 16
 25815	60F5	29				    add hl, hl                  ; * 32
 25816	60F6					
 25817	60F6					    ; Add X/8
