 26624	A02D					
 26625	A02D					; ==================================================================
 26626	A02D					; FONT LOADING FUNCTIONS
 26627	A02D					; ==================================================================
 26628	A02D					
 26629	A02D					load_custom_font:
 26630	A02D					    ; Load custom font patterns to VRAM Pattern Generator Table
 26631	A02D					    ; Uses FONT_CHAR_INDEX to map specific characters to their correct VRAM addresses
 26632	A02D	11	00	00		    ld de, CHRTBL2                ; Bank 0 Base
 26633	A030	CD	53	A0		    call load_font_patterns_to_bank
 26634	A033	C9				    ret
 26635	A034					
 26636	A034					load_font_bank0:
 26637	A034	11	00	00		    ld de, CHRTBL2                ; Bank 0 Base
 26638	A037	CD	53	A0		    call load_font_patterns_to_bank
 26639	A03A	C9				    ret
 26640	A03B					
 26641	A03B					load_font_bank1:
 26642	A03B	11	00	08		    ld de, CHRTBL2 + #800         ; Bank 1 Base
 26643	A03E	CD	53	A0		    call load_font_patterns_to_bank
 26644	A041	C9				    ret
 26645	A042					
 26646	A042					load_font_bank2:
 26647	A042	11	00	10		    ld de, CHRTBL2 + #1000        ; Bank 2 Base
 26648	A045	CD	53	A0		    call load_font_patterns_to_bank
 26649	A048	C9				    ret
 26650	A049					
 26651	A049					load_all_font_banks:
 26652	A049	CD	34	A0		    call load_font_bank0
 26653	A04C	CD	3B	A0		    call load_font_bank1
 26654	A04F	CD	42	A0		    call load_font_bank2
 26655	A052	C9				    ret
 26656	A053					
 26657	A053					; Helper: Load font patterns to a specific bank
 26658	A053					; Input: DE = Bank Base Address
 26659	A053					load_font_patterns_to_bank:
 26660	A053	3E	78			    ld a, RESOURCE_ID_FONT_PATTERN_DATA
 26661	A055	CD	98	46		    call resource_find_by_id
 26662	A058	D8				    ret c
 26663	A059	DD	21	00	A0	    ld ix, FONT_CHAR_INDEX        ; Pointer to ASCII codes
 26664	A05D	2A	2A	C0		    ld hl, (resource_descriptor_addr)
 26665	A060	E5				    push hl
 26666	A061	FD	E1			    pop iy
 26667	A063	06	2D			    ld b, FONT_CHAR_COUNT         ; Number of characters to load
 26668	A065					
 26669	A065					
 26670	A065					.load_loop:
 26671	A065	C5				    push bc                       ; Save loop counter
 26672	A066	D5				    push de                       ; Save bank base address
 26673	A067					
 26674	A067					    ; Get ASCII code
 26675	A067	DD	7E	00		    ld a, (ix)                    ; A = ASCII code
 26676	A06A	DD	23			    inc ix                        ; Next index
 26677	A06C					
 26678	A06C					    ; Calculate VRAM offset: Base + (ASCII * 8)
 26679	A06C	6F				    ld l, a
 26680	A06D	26	00			    ld h, 0
 26681	A06F	29				    add hl, hl                    ; * 2
 26682	A070	29				    add hl, hl                    ; * 4
 26683	A071	29				    add hl, hl                    ; * 8
 26684	A072	19				    add hl, de                    ; Add Base Address
 26685	A073	EB				    ex de, hl                     ; DE = VRAM Destination
 26686	A074					
 26687	A074					    ; Prepare source pointer (IY is in RAM, so use HL)
 26688	A074	FD	E5			    push iy
 26689	A076	E1				    pop hl                        ; HL = Source Pattern (IY)
 26690	A077					
 26691	A077					    ; Copy 8 bytes
 26692	A077	01	08	00		    ld bc, 8
 26693	A07A	3A	29	C0		    ld a, (resource_descriptor_bank)
 26694	A07D	CD	2C	47		    call resource_copy_from_bank_to_vram
 26695	A080					
 26696	A080					    ; Advance source pointer
 26697	A080	01	08	00		    ld bc, 8
 26698	A083	FD	09			    add iy, bc                    ; IY += 8
 26699	A085					
 26700	A085	D1				    pop de                        ; Restore bank base
 26701	A086	C1				    pop bc                        ; Restore loop counter
 26702	A087	10	DC			    djnz .load_loop
 26703	A089	C9				    ret
 26704	A08A					
 26705	A08A					; [FONT_COLOR_DATA blob emitted in bank4 section (org #C000)]
 26706	A08A					
 26707	A08A					load_font_colors:
 26708	A08A	11	00	20		    ld de, CLRTBL2                ; Bank 0 Base
 26709	A08D	CD	A4	A0		    call load_font_colors_to_bank
 26710	A090	C9				    ret
 26711	A091					
 26712	A091					load_font_colors_all_banks:
 26713	A091	11	00	20		    ld de, CLRTBL2                ; Bank 0 Base
 26714	A094	CD	A4	A0		    call load_font_colors_to_bank
 26715	A097					
 26716	A097	11	00	28		    ld de, CLRTBL2 + #800         ; Bank 1 Base
 26717	A09A	CD	A4	A0		    call load_font_colors_to_bank
 26718	A09D					
 26719	A09D	11	00	30		    ld de, CLRTBL2 + #1000        ; Bank 2 Base
 26720	A0A0	CD	A4	A0		    call load_font_colors_to_bank
 26721	A0A3	C9				    ret
 26722	A0A4					
 26723	A0A4					; Helper: Load font colors to a specific bank
 26724	A0A4					; Input: DE = Bank Base Address
 26725	A0A4					load_font_colors_to_bank:
 26726	A0A4	3E	79			    ld a, RESOURCE_ID_FONT_COLOR_DATA
 26727	A0A6	CD	98	46		    call resource_find_by_id
 26728	A0A9	D8				    ret c
 26729	A0AA	DD	21	00	A0	    ld ix, FONT_CHAR_INDEX        ; Pointer to ASCII codes
 26730	A0AE	2A	2A	C0		    ld hl, (resource_descriptor_addr)
 26731	A0B1	E5				    push hl
 26732	A0B2	FD	E1			    pop iy
 26733	A0B4	06	2D			    ld b, FONT_CHAR_COUNT         ; Number of characters to load
 26734	A0B6					
 26735	A0B6					
 26736	A0B6					.load_colors_loop:
 26737	A0B6	C5				    push bc                       ; Save loop counter
 26738	A0B7	D5				    push de                       ; Save bank base address
 26739	A0B8					
 26740	A0B8					    ; Get ASCII code
 26741	A0B8	DD	7E	00		    ld a, (ix)                    ; A = ASCII code
 26742	A0BB	DD	23			    inc ix                        ; Next index
 26743	A0BD					
 26744	A0BD					    ; Calculate VRAM offset: Base + (ASCII * 8)
 26745	A0BD	6F				    ld l, a
 26746	A0BE	26	00			    ld h, 0
 26747	A0C0	29				    add hl, hl                    ; * 2
 26748	A0C1	29				    add hl, hl                    ; * 4
 26749	A0C2	29				    add hl, hl                    ; * 8
 26750	A0C3	19				    add hl, de                    ; Add Base Address
 26751	A0C4	EB				    ex de, hl                     ; DE = VRAM Destination
 26752	A0C5					
 26753	A0C5					    ; Prepare source pointer
 26754	A0C5	FD	E5			    push iy
 26755	A0C7	E1				    pop hl                        ; HL = Source Color (IY)
 26756	A0C8					
 26757	A0C8					    ; Copy 8 bytes
 26758	A0C8	01	08	00		    ld bc, 8
 26759	A0CB	3A	29	C0		    ld a, (resource_descriptor_bank)
 26760	A0CE	CD	2C	47		    call resource_copy_from_bank_to_vram
 26761	A0D1					
 26762	A0D1					    ; Advance source pointer
 26763	A0D1	01	08	00		    ld bc, 8
 26764	A0D4	FD	09			    add iy, bc                    ; IY += 8
 26765	A0D6					
 26766	A0D6	D1				    pop de                        ; Restore bank base
 26767	A0D7	C1				    pop bc                        ; Restore loop counter
 26768	A0D8	10	DC			    djnz .load_colors_loop
 26769	A0DA	C9				    ret
 26770	A0DB					
 26771	A0DB					; ==================================================================
 26772	A0DB					; TEXT RENDERING FUNCTIONS (Based on Mideas renderMSX1TextToDataURL)
 26773	A0DB					; ==================================================================
 26774	A0DB					
 26775	A0DB					; Print string to Screen 2 name table (text mode compatible)
 26776	A0DB					; HL = string pointer (null-terminated), DE = VRAM position
 26777	A0DB					print_string_screen2:
 26778	A0DB	C5				    push bc
 26779	A0DC	06	00			    ld b, 0                        ; Character counter
 26780	A0DE					
 26781	A0DE					print_string_loop:
 26782	A0DE	7E				    ld a, (hl)                     ; Get character
 26783	A0DF	B7				    or a                           ; Check for null terminator
 26784	A0E0	28	10			    jr z, print_string_end         ; End if null
 26785	A0E2					
 26786	A0E2					    ; Write character to VRAM Name Table
 26787	A0E2					    ; FAST_WRTVRM signature: A = data, HL = VRAM address
 26788	A0E2					    ; A already has character, HL already has VRAM address
 26789	A0E2	E5				    push hl                        ; Save string pointer
 26790	A0E3	D5				    push de                        ; Save VRAM position
 26791	A0E4	EB				    ex de, hl                      ; Swap: DE = string ptr, HL = VRAM address for FAST_WRTVRM
 26792	A0E5	CD	E3	40		    call FAST_WRTVRM               ; Write character to VRAM (fast)
 26793	A0E8	D1				    pop de                         ; Restore VRAM position
 26794	A0E9	E1				    pop hl                         ; Restore string pointer
 26795	A0EA					
 26796	A0EA					    ; Move to next character
 26797	A0EA	23				    inc hl                         ; Next character in string
 26798	A0EB	13				    inc de                         ; Next position in VRAM
 26799	A0EC	04				    inc b                          ; Count characters
 26800	A0ED	78				    ld a, b
 26801	A0EE	FE	20			    cp 32                          ; Limit to screen width
 26802	A0F0	20	EC			    jr nz, print_string_loop       ; Continue if not at edge
 26803	A0F2					
 26804	A0F2					print_string_end:
 26805	A0F2	C1				    pop bc
 26806	A0F3	C9				    ret
 26807	A0F4					
 26808	A0F4					; Initialize font system for Screen 2 text rendering
 26809	A0F4					init_font_system:
 26810	A0F4	3A	30	C0		    ld a, (vram_cache_font_ready)
 26811	A0F7	B7				    or a
 26812	A0F8	C0				    ret nz
 26813	A0F9					    ; Load custom font patterns and colors
 26814	A0F9	CD	49	A0		    call load_all_font_banks       ; Load patterns to all banks
 26815	A0FC	CD	91	A0		    call load_font_colors_all_banks ; Load colors to all banks
 26816	A0FF	3E	01			    ld a, 1
 26817	A101	32	30	C0		    ld (vram_cache_font_ready), a
 26818	A104	C9				    ret
