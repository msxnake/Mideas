 7626	67E8					    ; ==================================================================
 7627	67E8					    ; HEALTH COMPONENT SYSTEM
 7628	67E8					    ; ==================================================================
 7629	67E8					    ; Manages entity health/lives (current, max)
 7630	67E8					    ; Detects death when current <= 0
