 12953	804E					; ------------------------------------------------------------------
 12954	804E					; check_collision_at_point
 12955	804E					; Check if there's a solid tile at given pixel coordinates
 12956	804E					; Input:  D = X position, E = Y position
 12957	804E					; Output: Z flag set if passable, cleared if solid
 12958	804E					;         A = Behavior flags of tile at that position
 12959	804E					; Destroys: BC, HL
 12960	804E					; ------------------------------------------------------------------
 12961	804E					check_collision_at_point:
 12962	804E	CD	01	7F		    call get_tile_at_position
 12963	8051	C8				    ret z                         ; Out of bounds = passable
 12964	8052	CD	3F	7F		    call get_tile_behavior
 12965	8055	E6	30			    and TILE_SOLID | TILE_PLATFORM
 12966	8057	C9				    ret                           ; Z if passable, NZ if solid
 12967	8058					
 12968	8058					; ------------------------------------------------------------------
 12969	8058					; check_collision_box
 12970	8058					; Check collision for entity bounding box (16x16)
 12971	8058					; Input:  D = X position (top-left), E = Y position (top-left)
 12972	8058					; Output: Z flag set if no collision, cleared if collision detected
 12973	8058					;         A = Behavior flags of colliding tile
 12974	8058					; Destroys: BC, HL
 12975	8058					; ------------------------------------------------------------------
 12976	8058					check_collision_box:
 12977	8058					    ; Check 4 corners of 16x16 box:
 12978	8058					    ; Top-left (X, Y)
 12979	8058	D5				    push de
 12980	8059	CD	4E	80		    call check_collision_at_point
 12981	805C	20	28			    jr nz, .collision_found
 12982	805E					
 12983	805E					    ; Top-right (X+15, Y)
 12984	805E	D1				    pop de
 12985	805F	D5				    push de
 12986	8060	7A				    ld a, d
 12987	8061	C6	0F			    add a, 15
 12988	8063	57				    ld d, a
 12989	8064	CD	4E	80		    call check_collision_at_point
 12990	8067	20	1D			    jr nz, .collision_found
 12991	8069					
 12992	8069					    ; Bottom-left (X, Y+15)
 12993	8069	D1				    pop de
 12994	806A	D5				    push de
 12995	806B	7B				    ld a, e
 12996	806C	C6	0F			    add a, 15
 12997	806E	5F				    ld e, a
 12998	806F	CD	4E	80		    call check_collision_at_point
 12999	8072	20	12			    jr nz, .collision_found
 13000	8074					
 13001	8074					    ; Bottom-right (X+15, Y+15)
 13002	8074	D1				    pop de
 13003	8075	D5				    push de
 13004	8076	7A				    ld a, d
 13005	8077	C6	0F			    add a, 15
 13006	8079	57				    ld d, a
 13007	807A	7B				    ld a, e
 13008	807B	C6	0F			    add a, 15
 13009	807D	5F				    ld e, a
 13010	807E	CD	4E	80		    call check_collision_at_point
 13011	8081	20	03			    jr nz, .collision_found
