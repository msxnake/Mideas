 8507	6BE5					    ; AUTO-DESTROY COMPONENT SYSTEM
 8508	6BE5					    ; ==================================================================
 8509	6BE5					    ; Entities with AUTO_DESTROY component have a lifetime counter
 8510	6BE5					    ; When lifetime reaches 0, entity is automatically destroyed
 8511	6BE5					    ; Useful for: projectiles and other temporary effects.
 8512	6BE5					
 8513	6BE5					init_auto_destroy_system:
 8514	6BE5					    ; Initialize all lifetimes to 0 (infinite by default)
 8515	6BE5	21	9E	E0		    ld hl, entity_lifetime
 8516	6BE8	11	9F	E0		    ld de, entity_lifetime+1
