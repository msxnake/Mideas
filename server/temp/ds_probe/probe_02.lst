 2366	4155					; MSX SYSTEM CONSTANTS
 2367	4155					; File: constants.asm
 2368	4155					; Description: MSX hardware constants and project-specific definitions
 2369	4155					; ==================================================================
 2370	4155					
 2371	4155					; ==================================================================
 2372	4155					; VRAM LAYOUT - SCREEN 2 MODE
 2373	4155					; ==================================================================
 2374	4155					
 2375	4155					; Pattern Generator Table (PGT) - 3 Banks
 2376	4155					CHRTBL  EQU #0000        ; Pattern table base address (alias)
 2377	4155					CHRTBL2 EQU #0000        ; Pattern table base address (Bank 0)
 2378	4155					; Bank 1: CHRTBL2 + #800   (#0800)
 2379	4155					; Bank 2: CHRTBL2 + #1000  (#1000)
 2380	4155					
 2381	4155					; Color Attribute Table (CAT) - 3 Banks
 2382	4155					CLRTBL  EQU #2000        ; Color table base address (alias)
 2383	4155					CLRTBL2 EQU #2000        ; Color table base address (Bank 0)
 2384	4155					; Bank 1: CLRTBL2 + #800   (#2800)
 2385	4155					; Bank 2: CLRTBL2 + #1000  (#3000)
 2386	4155					
 2387	4155					; Other VRAM Areas
 2388	4155					NAMETBL EQU #1800        ; Name table base address
 2389	4155					SPRATR  EQU #1B00        ; Sprite attribute table
 2390	4155					SPRPAT  EQU #3800        ; Sprite pattern table
 2391	4155					
 2392	4155					; ==================================================================
 2393	4155					; SCREEN MODES
 2394	4155					; ==================================================================
 2395	4155					SCREEN0     EQU 0        ; 40x24 text
 2396	4155					SCREEN1     EQU 1        ; 32x24 text/graphics
 2397	4155					SCREEN2     EQU 2        ; 256x192 graphics
 2398	4155					SCREEN3     EQU 3        ; 64x48 multicolor
