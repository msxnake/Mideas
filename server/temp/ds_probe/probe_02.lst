 3149	4185					; ------------------------------------------------------------------
 3150	4185					; Helpers for deterministic save/restore around far calls.
 3151	4185					; ------------------------------------------------------------------
 3152	4185					mapper_push_p1:
 3153	4185	3A	1C	C0		    ld a, (mapper_bank_p1_current)
 3154	4188	32	21	C0		    ld (mapper_saved_bank_p1), a
 3155	418B	C9				    ret
 3156	418C					
 3157	418C					mapper_pop_p1:
