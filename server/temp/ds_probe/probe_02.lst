 9116	6DFF					.wall_right_blocked:
 9117	6DFF					    ; ---------------------------------------------------------------
 9118	6DFF					    ; Snap formula (RIGHT wall):
 9119	6DFF					    ;   C = tile column that blocked us (from (right+1)/8 probe)
 9120	6DFF					    ;   wall_left_of_tile = C * 8           ? left pixel of blocking tile
