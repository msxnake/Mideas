 4145	46D9	32	28	C0		    ld (resource_descriptor_group), a
 4146	46DC	23				    inc hl
 4147	46DD	7E				    ld a, (hl)
 4148	46DE	32	29	C0		    ld (resource_descriptor_bank), a
 4149	46E1	23				    inc hl
