 4454	47E7					; ==================================================================
 4455	47E7					; INTERRUPT TASK SYSTEM - File: interrupt.asm
 4456	47E7					; Konami-style technique: Hook H.TIMI for 50/60Hz task execution
 4457	47E7					; ==================================================================
 4458	47E7					
 4459	47E7					; ==================================================================
 4460	47E7					; INTERRUPT SYSTEM MEMORY LAYOUT
 4461	47E7					; Variables are defined in variables.asm (dynamically allocated)
 4462	47E7					; This avoids RAM overlap with entity system arrays
 4463	47E7					; ==================================================================
 4464	47E7					; Slots: task_table (8 slots x 2 bytes), task_0_ptr..task_7_ptr
 4465	47E7					; State: interrupt_system_enabled, old_htimi_hook, interrupt_counter,
 4466	47E7					;        task_exec_time, vblank_flag
 4467	47E7					; ==================================================================
 4468	47E7					
 4469	47E7					; ==================================================================
 4470	47E7					; INIT_INTERRUPT_SYSTEM - Install H.TIMI hook
 4471	47E7					; ==================================================================
 4472	47E7					; Register Contract:
 4473	47E7					;   Purpose: Install JP hook on H.TIMI and initialize interrupt task state.
 4474	47E7					;   Inputs:
 4475	47E7					;     - None
 4476	47E7					;   Outputs:
 4477	47E7					;     - None
 4478	47E7					;   Clobbers:
 4479	47E7					;     - AF
 4480	47E7					;     - BC
 4481	47E7					;     - DE
 4482	47E7					;     - HL
 4483	47E7					;   Preserved:
 4484	47E7					;     - None
 4485	47E7					;   Register roles:
 4486	47E7					;     - HL/DE/BC = block copy parameters for hook backup and task table clear
 4487	47E7					;     - A = enable flag and zeroing value
 4488	47E7					;   Notes:
 4489	47E7					;     - Runs with DI/EI, so caller must not assume interrupt state is unchanged.
 4490	47E7					
 4491	47E7					; Inputs: None
 4492	47E7					; Outputs: None
 4493	47E7					; Modifies: AF, BC, DE, HL
 4494	47E7					; ==================================================================
 4495	47E7					init_interrupt_system:
 4496	47E7	F3				    di                          ; Disable interrupts during hook install
 4497	47E8					
 4498	47E8					    ; --- STEP 1: Save original hook ---
 4499	47E8	21	9F	FD		    ld hl, #FD9F                ; H.TIMI address
 4500	47EB	11	AB	E9		    ld de, old_htimi_hook       ; Our backup location
 4501	47EE	01	05	00		    ld bc, 5                    ; Save 5 bytes (JP nnnn + padding)
 4502	47F1	ED	B0			    ldir                        ; Copy original hook to RAM
 4503	47F3					
 4504	47F3					    ; --- STEP 2: Install our hook ---
 4505	47F3					    ; Write "JP interrupt_dispatcher" at FD9F
 4506	47F3	3E	C3			    ld a, #C3                   ; Opcode for JP
 4507	47F5	32	9F	FD		    ld (#FD9F), a               ; Write JP opcode
 4508	47F8	21	2E	48		    ld hl, interrupt_dispatcher ; Address of our ISR
 4509	47FB	22	A0	FD		    ld (#FDA0), hl              ; Write address (little-endian)
 4510	47FE					
 4511	47FE					    ; --- STEP 3: Initialize task table to 0 (all disabled) ---
 4512	47FE	21	9A	E9		    ld hl, task_table
 4513	4801	11	9B	E9		    ld de, task_table+1
 4514	4804	01	0F	00		    ld bc, 15                   ; 8 slots Ç- 2 bytes = 16 bytes - 1
 4515	4807	36	00			    ld (hl), 0
 4516	4809	ED	B0			    ldir                        ; Clear all task pointers
 4517	480B					
 4518	480B					    ; --- STEP 4: Initialize counters ---
 4519	480B	AF				    xor a
 4520	480C	32	B0	E9		    ld (interrupt_counter), a
 4521	480F	32	B1	E9		    ld (interrupt_counter+1), a
 4522	4812	32	B4	E9		    ld (vblank_flag), a
 4523	4815					
 4524	4815					    ; --- STEP 5: Mark system as enabled ---
 4525	4815	3E	01			    ld a, 1
 4526	4817	32	AA	E9		    ld (interrupt_system_enabled), a
 4527	481A					
 4528	481A	FB				    ei                          ; Re-enable interrupts
 4529	481B	C9				    ret
 4530	481C					
 4531	481C					; ==================================================================
 4532	481C					; STOP_INTERRUPT_SYSTEM - Restore original H.TIMI hook
 4533	481C					; ==================================================================
 4534	481C					; Register Contract:
 4535	481C					;   Purpose: Restore original H.TIMI bytes and mark system disabled.
 4536	481C					;   Inputs:
 4537	481C					;     - None
 4538	481C					;   Outputs:
 4539	481C					;     - None
 4540	481C					;   Clobbers:
 4541	481C					;     - AF
 4542	481C					;     - BC
 4543	481C					;     - DE
 4544	481C					;     - HL
 4545	481C					;   Preserved:
 4546	481C					;     - None
 4547	481C					;   Register roles:
 4548	481C					;     - HL/DE/BC = LDIR source/destination/count for hook restore
 4549	481C					;     - A = zero flag write to interrupt_system_enabled
 4550	481C					;   Notes:
 4551	481C					;     - Runs with DI/EI for atomic hook restoration.
 4552	481C					
 4553	481C					; Inputs: None
 4554	481C					; Outputs: None
 4555	481C					; Modifies: AF, BC, DE, HL
 4556	481C					; ==================================================================
 4557	481C					stop_interrupt_system:
 4558	481C	F3				    di                          ; Disable interrupts
 4559	481D					
 4560	481D					    ; Restore original hook
 4561	481D	21	AB	E9		    ld hl, old_htimi_hook       ; Our backup
 4562	4820	11	9F	FD		    ld de, #FD9F                ; H.TIMI location
 4563	4823	01	05	00		    ld bc, 5                    ; Restore 5 bytes
 4564	4826	ED	B0			    ldir
 4565	4828					
 4566	4828					    ; Mark system as disabled
 4567	4828	AF				    xor a
 4568	4829	32	AA	E9		    ld (interrupt_system_enabled), a
 4569	482C					
 4570	482C	FB				    ei                          ; Re-enable interrupts
 4571	482D	C9				    ret
 4572	482E					
 4573	482E					; ==================================================================
 4574	482E					; INTERRUPT_DISPATCHER - Main ISR (60Hz/50Hz)
 4575	482E					; ==================================================================
 4576	482E					; Register Contract:
 4577	482E					;   Purpose: Dispatch enabled interrupt tasks each VBlank and chain BIOS hook.
 4578	482E					;   Inputs:
 4579	482E					;     - Triggered by H.TIMI hook
 4580	482E					;   Outputs:
 4581	482E					;     - interrupt_counter incremented
 4582	482E					;     - vblank_flag refreshed
 4583	482E					;   Clobbers:
 4584	482E					;     - AF
 4585	482E					;     - BC
 4586	482E					;     - DE
 4587	482E					;     - HL
 4588	482E					;     - IX
 4589	482E					;     - IY (all restored before exit)
 4590	482E					;   Preserved:
 4591	482E					;     - DE
 4592	482E					;     - IX
 4593	482E					;     - IY
 4594	482E					;   Register roles:
 4595	482E					;     - HL = walks task_table and holds task pointer
 4596	482E					;     - B = task slot loop counter
 4597	482E					;     - C = temporary low byte for pointer reconstruction
 4598	482E					;     - A = enabled checks and pointer validation
 4599	482E					;   Notes:
 4600	482E					;     - Dispatcher saves/restores DE/IX/IY defensively, reducing coupling with task internals.
 4601	482E					
 4602	482E					; This routine executes on each V-Blank
 4603	482E					; CRITICAL: Minimal CPU cycles, maximum efficiency
 4604	482E					; Overhead: ~80 cycles base + ~40 cycles per active task
 4605	482E					; ==================================================================
 4606	482E					interrupt_dispatcher:
 4607	482E					    ; --- STEP 1: Save caller-visible registers used by BIOS/user code ---
 4608	482E	F5				    push af                     ; 11 cycles
 4609	482F	E5				    push hl                     ; 11 cycles
 4610	4830	C5				    push bc                     ; 11 cycles
 4611	4831	D5				    push de                     ; 11 cycles
 4612	4832	DD	E5			    push ix                     ; 15 cycles
 4613	4834	FD	E5			    push iy                     ; 15 cycles
 4614	4836					    ; Total: 74 cycles fixed prologue overhead
 4615	4836					
 4616	4836					    ; --- STEP 2: Check if system is enabled ---
 4617	4836	3A	AA	E9		    ld a, (interrupt_system_enabled)
 4618	4839	B7				    or a
 4619	483A	28	2B			    jr z, .exit                 ; If disabled, exit quickly
 4620	483C					
 4621	483C					    ; --- STEP 3: Increment frame counter ---
 4622	483C	2A	B0	E9		    ld hl, (interrupt_counter)
 4623	483F	23				    inc hl
 4624	4840	22	B0	E9		    ld (interrupt_counter), hl
 4625	4843					
 4626	4843					    ; --- STEP 3.5: Update VBlank flag (reads VDP status) ---
 4627	4843	CD	73	48		    call update_vblank_flag
 4628	4846					
 4629	4846					    ; --- STEP 4: Walk through task table (DI ensures no nested interrupts) ---
 4630	4846	F3				    di                          ; Disable interrupts for task execution
 4631	4847	21	9A	E9		    ld hl, task_table           ; HL = pointer to task table
 4632	484A	06	08			    ld b, 8                     ; 8 slots
 4633	484C					
 4634	484C					.task_loop:
 4635	484C					    ; Read task pointer (16-bit address)
 4636	484C	7E				    ld a, (hl)                  ; Low byte
 4637	484D	23				    inc hl
 4638	484E	4F				    ld c, a
 4639	484F	7E				    ld a, (hl)                  ; High byte
 4640	4850	23				    inc hl
 4641	4851	B1				    or c                        ; Check if pointer == 0
 4642	4852	28	11			    jr z, .next_task            ; Skip if disabled (pointer == 0)
 4643	4854					
 4644	4854					    ; Valid pointer: execute task
 4645	4854	2B				    dec hl
 4646	4855	2B				    dec hl                      ; Back to low byte
 4647	4856	C5				    push bc                     ; Save loop counter
 4648	4857	E5				    push hl                     ; Save table position
 4649	4858					
 4650	4858					    ; Load task address into HL
 4651	4858	4E				    ld c, (hl)                  ; Low byte
 4652	4859	23				    inc hl
 4653	485A	66				    ld h, (hl)                  ; High byte
 4654	485B	69				    ld l, c                     ; HL = task address
 4655	485C					
 4656	485C					    ; Call task using JP (HL) pattern (faster than indirect CALL)
 4657	485C	CD	72	48		    call .call_task             ; Call the task
 4658	485F					
 4659	485F	E1				    pop hl                      ; Restore table position
 4660	4860	C1				    pop bc                      ; Restore loop counter
 4661	4861	23				    inc hl
 4662	4862	23				    inc hl                      ; Advance to next slot
 4663	4863	18	00			    jr .continue_loop
 4664	4865					
 4665	4865					.next_task:
 4666	4865					    ; Nothing to do, HL already points to next slot
 4667	4865					
 4668	4865					.continue_loop:
 4669	4865	10	E5			    djnz .task_loop             ; Loop 8 times
 4670	4867					
 4671	4867					.exit:
 4672	4867					    ; --- STEP 5: Restore registers ---
 4673	4867	FD	E1			    pop iy                      ; 14 cycles
 4674	4869	DD	E1			    pop ix                      ; 14 cycles
 4675	486B	D1				    pop de                      ; 10 cycles
 4676	486C	C1				    pop bc                      ; 10 cycles
 4677	486D	E1				    pop hl                      ; 10 cycles
 4678	486E	F1				    pop af                      ; 10 cycles
 4679	486F					
 4680	486F					    ; --- STEP 6: Return from interrupt ---
 4681	486F					    ; For H.TIMI we should chain to the original hook (best compatibility)
 4682	486F					    ; and let the BIOS interrupt handler manage EI/RETI.
 4683	486F	C3	AB	E9		    jp old_htimi_hook
 4684	4872					
 4685	4872					; Helper for indirect call
 4686	4872					.call_task:
 4687	4872	E9				    jp (hl)                     ; Jump to task (task will RET back here)
 4688	4873					
 4689	4873					; ==================================================================
 4690	4873					; TASK MANAGEMENT FUNCTIONS
 4691	4873					; ==================================================================
 4692	4873					
 4693	4873					; ==================================================================
 4694	4873					; NOTE: wait_vblank function removed - use HALT directly in game loop
 4695	4873					; HALT is more efficient (no call/ret overhead)
 4696	4873					; ==================================================================
 4697	4873					
 4698	4873					; ==================================================================
 4699	4873					; UPDATE_VBLANK_FLAG - For interrupt dispatcher use only
 4700	4873					; ==================================================================
 4701	4873					; Register Contract:
 4702	4873					;   Purpose: Read VDP status register and latch VBlank state in RAM flag.
 4703	4873					;   Inputs:
 4704	4873					;     - None
 4705	4873					;   Outputs:
 4706	4873					;     - vblank_flag = 0/1
 4707	4873					;   Clobbers:
 4708	4873					;     - AF (internally saved/restored)
 4709	4873					;   Preserved:
 4710	4873					;     - AF, BC, DE, HL
 4711	4873					;   Register roles:
 4712	4873					;     - A = VDP status read and boolean conversion
 4713	4873					
 4714	4873					; Updates vblank_flag only if we're actually in VBlank
 4715	4873					; Called from interrupt_dispatcher
 4716	4873					; Inputs: None
 4717	4873					; Outputs: None
 4718	4873					; Modifies: AF
 4719	4873					; ==================================================================
 4720	4873					update_vblank_flag:
 4721	4873	F5				    push af
 4722	4874	DB	99			    in a, (#99)                 ; Read VDP status register
 4723	4876	CB	7F			    bit 7, a                    ; Are we in VBlank?
 4724	4878	28	07			    jr z, .not_in_vblank
 4725	487A	3E	01			    ld a, 1
 4726	487C	32	B4	E9		    ld (vblank_flag), a
 4727	487F	18	04			    jr .uvf_done
 4728	4881					.not_in_vblank:
 4729	4881	AF				    xor a
 4730	4882	32	B4	E9		    ld (vblank_flag), a
 4731	4885					.uvf_done:
 4732	4885	F1				    pop af
 4733	4886	C9				    ret
 4734	4887					
 4735	4887					; ==================================================================
 4736	4887					; ENABLE_TASK - Activate a task in the system
 4737	4887					; ==================================================================
 4738	4887					; Register Contract:
 4739	4887					;   Purpose: Store routine pointer into task_table slot.
 4740	4887					;   Inputs:
 4741	4887					;     - A = task slot (0-7)
 4742	4887					;     - HL = task routine address
 4743	4887					;   Outputs:
 4744	4887					;     - task_table[slot] = HL
 4745	4887					;   Clobbers:
 4746	4887					;     - AF
 4747	4887					;     - BC
 4748	4887					;     - DE
 4749	4887					;     - HL
 4750	4887					;   Preserved:
 4751	4887					;     - None
 4752	4887					;   Register roles:
 4753	4887					;     - A = slot validation and offset math
 4754	4887					;     - DE = holds routine address while HL is repurposed as slot pointer
 4755	4887					;     - BC = task_table base address
 4756	4887					;     - HL = slot address calculation / pointer write
 4757	4887					
 4758	4887					; Inputs:
 4759	4887					;   A = task slot (0-7)
 4760	4887					;   HL = address of task routine
 4761	4887					; Outputs: None
 4762	4887					; Modifies: AF, BC, DE, HL
 4763	4887					; ==================================================================
 4764	4887					enable_task:
 4765	4887					    ; Validate slot (0-7)
 4766	4887	FE	08			    cp 8
 4767	4889	D0				    ret nc                      ; Return if slot >= 8
 4768	488A					
 4769	488A					    ; Calculate offset in table: slot * 2
 4770	488A	87				    add a, a                    ; A = slot * 2
 4771	488B	5F				    ld e, a
 4772	488C	16	00			    ld d, 0
 4773	488E	01	9A	E9		    ld bc, task_table
 4774	4891	EB				    ex de, hl                   ; HL = offset, DE = task address
 4775	4892	09				    add hl, bc                  ; HL = task_table + offset
 4776	4893					
 4777	4893					    ; Write task address
 4778	4893	EB				    ex de, hl                   ; HL = task address, DE = slot location
 4779	4894	7D				    ld a, l
 4780	4895	12				    ld (de), a                  ; Write low byte
 4781	4896	13				    inc de
 4782	4897	7C				    ld a, h
 4783	4898	12				    ld (de), a                  ; Write high byte
 4784	4899					
 4785	4899	C9				    ret
 4786	489A					
 4787	489A					; ==================================================================
 4788	489A					; DISABLE_TASK - Deactivate a task
 4789	489A					; ==================================================================
 4790	489A					; Register Contract:
 4791	489A					;   Purpose: Clear routine pointer in selected task slot.
 4792	489A					;   Inputs:
 4793	489A					;     - A = task slot (0-7)
 4794	489A					;   Outputs:
 4795	489A					;     - task_table[slot] = 0
 4796	489A					;   Clobbers:
 4797	489A					;     - AF
 4798	489A					;     - DE
 4799	489A					;     - HL
 4800	489A					;   Preserved:
 4801	489A					;     - BC
 4802	489A					;   Register roles:
 4803	489A					;     - A = slot validation and zero value for clearing
 4804	489A					;     - HL = destination slot pointer
 4805	489A					;     - DE = computed slot offset
 4806	489A					
 4807	489A					; Inputs:
 4808	489A					;   A = task slot (0-7)
 4809	489A					; Outputs: None
 4810	489A					; Modifies: AF, DE, HL
 4811	489A					; ==================================================================
 4812	489A					disable_task:
 4813	489A					    ; Validate slot
 4814	489A	FE	08			    cp 8
 4815	489C	D0				    ret nc
 4816	489D					
 4817	489D					    ; Calculate offset
 4818	489D	87				    add a, a                    ; A = slot * 2
 4819	489E	5F				    ld e, a
 4820	489F	16	00			    ld d, 0
 4821	48A1	21	9A	E9		    ld hl, task_table
 4822	48A4	19				    add hl, de                  ; HL = task_table + offset
 4823	48A5					
 4824	48A5					    ; Write 0 (disable)
 4825	48A5	AF				    xor a
 4826	48A6	77				    ld (hl), a                  ; Low byte = 0
 4827	48A7	23				    inc hl
 4828	48A8	77				    ld (hl), a                  ; High byte = 0
 4829	48A9					
 4830	48A9	C9				    ret
 4831	48AA					
 4832	48AA					; ==================================================================
 4833	48AA					; GET_FRAME_COUNT - Get frame counter value
 4834	48AA					; ==================================================================
 4835	48AA					; Register Contract:
 4836	48AA					;   Purpose: Expose current 16-bit interrupt frame counter.
 4837	48AA					;   Inputs:
 4838	48AA					;     - None
 4839	48AA					;   Outputs:
 4840	48AA					;     - HL = interrupt_counter
 4841	48AA					;   Clobbers:
 4842	48AA					;     - HL
 4843	48AA					;   Preserved:
 4844	48AA					;     - AF
 4845	48AA					;     - BC
 4846	48AA					;     - DE
 4847	48AA					;   Register roles:
 4848	48AA					;     - HL = loaded return value
 4849	48AA					
 4850	48AA					; Inputs: None
 4851	48AA					; Outputs: HL = frame count (16-bit)
 4852	48AA					; Modifies: HL
 4853	48AA					; ==================================================================
 4854	48AA					get_frame_count:
 4855	48AA	2A	B0	E9		    ld hl, (interrupt_counter)
 4856	48AD	C9				    ret
 4857	48AE					
 4858	48AE					; ==================================================================
 4859	48AE					; INIT_DEFAULT_TASKS_FROM_PLAN - Register engine-selected IRQ tasks
 4860	48AE					; ==================================================================
 4861	48AE					; Register Contract:
 4862	48AE					;   Purpose: Enable the IRQ task set selected by the engine execution plan.
 4863	48AE					;   Inputs:
 4864	48AE					;     - None
 4865	48AE					;   Outputs:
 4866	48AE					;     - task_table updated for all enabled-at-boot tasks
 4867	48AE					;   Clobbers:
 4868	48AE					;     - AF
 4869	48AE					;     - HL
 4870	48AE					;   Preserved:
 4871	48AE					;     - BC
 4872	48AE					;     - DE
 4873	48AE					;   Register roles:
 4874	48AE					;     - A = task slot
 4875	48AE					;     - HL = task routine address
 4876	48AE					;   Notes:
