 15248	8727	BB				    cp e
 15249	8728	28	75			    jr z, .return_false
 15250	872A	30	70			    jr nc, .return_true
 15251	872C	18	71			    jr .return_false
 15252	872E					
 15253	872E					.op_less:
 15254	872E	7A				    ld a, d
 15255	872F	BB				    cp e
 15256	8730	38	6A			    jr c, .return_true
 15257	8732	18	6B			    jr .return_false
