 9534	6FE3					    ; ---- Adaptive X probes: inset = min(2, floor((right-left)/2)) ----
 9535	6FE3					    ; Purpose: avoid probing the exact corner pixels for small sprites.
 9536	6FE3					    ; For a 16px-wide entity: inset = min(2, 8) = 2.
 9537	6FE3					    ;   probe_left  = left  + 2  (2px inside left edge)
 9538	6FE3					    ;   probe_right = right - 2  (2px inside right edge)
 9539	6FE3					    ; For a 4px-wide entity: inset = min(2, 2) = 2 (probes overlap at center).
 9540	6FE3					    ; For a 2px-wide entity: inset = min(2, 1) = 1.
