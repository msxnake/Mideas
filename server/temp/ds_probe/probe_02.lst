 3200	41BE	F1				    pop af
 3201	41BF	CD	69	41		    call mapper_set_bank_p1
 3202	41C2	E1				    pop hl
 3203	41C3	11	C8	41		    ld de, .return_p1
 3204	41C6	D5				    push de
 3205	41C7	E9				    jp (hl)
 3206	41C8					.return_p1:
 3207	41C8	CD	8C	41		    call mapper_pop_p1
 3208	41CB	C9				    ret
