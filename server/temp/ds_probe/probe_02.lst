 21660	88C9	C2	24	89		    jp nz, .patrol_facing_done
 21661	88CC	7B				    ld a, e
 21662	88CD	FE	20			    cp MAX_ENTITIES
 21663	88CF	D2	24	89		    jp nc, .patrol_facing_done
