 9580	701E					; ------------------------------------------------------------------
 9581	701E					; wall_add_signed_offset_clamped
 9582	701E					; ------------------------------------------------------------------
 9583	701E					; Register Contract:
 9584	701E					;   Purpose: Add a signed 8-bit offset to a pixel coordinate, clamping result to 0..255.
 9585	701E					;            Used to apply entity_collision_offset_x/y to entity origin (entity?hitbox).
 9586	701E					;   Inputs:
 9587	701E					;     - A  = base pixel coordinate (unsigned, 0..255)
 9588	701E					;     - HL = pointer to signed offset byte (-128..127)
 9589	701E					;   Outputs:
 9590	701E					;     - A  = clamp(base + offset, 0, 255)
 9591	701E					;   Clobbers: AF, B
 9592	701E					;   Preserved: C, DE, HL
 9593	701E					;   Notes:
 9594	701E					;     - Negative offset: carry=0 after add ? underflow ? A clamped to 0.
 9595	701E					;     - Positive offset: carry=1 after add ? overflow ? A clamped to 255.
 9596	701E					;     - B is used to hold the offset byte; caller must save B if needed.
 9597	701E					; ------------------------------------------------------------------
 9598	701E					wall_add_signed_offset_clamped:
 9599	701E	46				    ld b, (hl)                    ; B = signed offset
 9600	701F	80				    add a, b
 9601	7020	CB	78			    bit 7, b
 9602	7022	28	04			    jr z, .wasc_positive
 9603	7024					    ; Negative offset: carry=0 means underflow
 9604	7024	38	06			    jr c, .wasc_done
 9605	7026	AF				    xor a
 9606	7027	C9				    ret
 9607	7028					.wasc_positive:
 9608	7028					    ; Positive offset: carry=1 means overflow
 9609	7028	30	02			    jr nc, .wasc_done
 9610	702A	3E	FF			    ld a, 255
 9611	702C					.wasc_done:
 9612	702C	C9				    ret
 9613	702D					
 9614	702D					; ------------------------------------------------------------------
 9615	702D					; wall_sub_signed_offset_clamped
 9616	702D					; ------------------------------------------------------------------
 9617	702D					; Register Contract:
 9618	702D					;   Purpose: Subtract a signed 8-bit offset from a hitbox coordinate, clamping to 0..255.
 9619	702D					;            Used to convert hitbox left/top back to entity origin after a snap.
 9620	702D					;            Inverse of wall_add_signed_offset_clamped.
 9621	702D					;   Inputs:
 9622	702D					;     - A  = hitbox pixel coordinate (left or top, unsigned 0..255)
 9623	702D					;     - HL = pointer to signed collision offset byte (-128..127)
 9624	702D					;            (same pointer passed to wall_add_signed_offset_clamped when building)
 9625	702D					;   Outputs:
 9626	702D					;     - A  = clamp(hitbox - offset, 0, 255)
 9627	702D					;            i.e. the entity origin coordinate that produces the snapped hitbox edge
 9628	702D					;   Clobbers: AF, B, C
 9629	702D					;   Preserved: DE, HL
 9630	702D					;   Notes:
 9631	702D					;     - If offset is negative: hitbox - offset = hitbox + abs(offset).
 9632	702D					;       Overflow (carry clear after add) ? A clamped to 255.
 9633	702D					;     - If offset is positive: hitbox - offset computed directly.
 9634	702D					;       Underflow (carry clear after sub) ? A clamped to 0.
 9635	702D					;     - B holds the raw offset byte; C holds the original hitbox coordinate.
 9636	702D					; ------------------------------------------------------------------
 9637	702D					wall_sub_signed_offset_clamped:
 9638	702D	4F				    ld c, a
 9639	702E	46				    ld b, (hl)                    ; B = signed offset
 9640	702F	CB	78			    bit 7, b
 9641	7031	28	09			    jr z, .wssc_positive
 9642	7033					    ; offset < 0 -> hitbox - offset = hitbox + abs(offset)
 9643	7033	78				    ld a, b
 9644	7034	ED	44			    neg
 9645	7036	81				    add a, c
 9646	7037	30	08			    jr nc, .wssc_done
 9647	7039	3E	FF			    ld a, 255
 9648	703B	C9				    ret
 9649	703C					.wssc_positive:
 9650	703C	79				    ld a, c
 9651	703D	90				    sub b
 9652	703E	30	01			    jr nc, .wssc_done
 9653	7040	AF				    xor a
 9654	7041					.wssc_done:
 9655	7041	C9				    ret
