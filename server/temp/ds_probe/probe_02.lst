 4090	4698					; resource_find_by_id
 4091	4698					; Inputs:
 4092	4698					;   A = resource id
 4093	4698					; Outputs on success (carry clear):
 4094	4698					;   HL = pointer to descriptor entry
 4095	4698					;   A  = bank number
 4096	4698					;   DE = visible window address
 4097	4698					;   BC = size in bytes
 4098	4698					; Outputs on failure (carry set):
 4099	4698					;   HL = resource_table
 4100	4698					; Clobbers:
 4101	4698					;   AF, BC, DE, HL
 4102	4698					; Notes:
 4103	4698					;   Mirrors the descriptor into RAM so callers can inspect fields later
 4104	4698					;   without re-scanning the table.
 4105	4698					; ------------------------------------------------------------------
 4106	4698					resource_find_by_id:
 4107	4698	4F				    ld c, a
 4108	4699	3A	26	C0		    ld a, (resource_descriptor_id)
 4109	469C	B9				    cp c
 4110	469D	20	14			    jr nz, .resource_find_scan
 4111	469F	2A	24	C0		    ld hl, (resource_descriptor_ptr)
 4112	46A2	7C				    ld a, h
 4113	46A3	B5				    or l
 4114	46A4	28	0D			    jr z, .resource_find_scan
 4115	46A6	3A	29	C0		    ld a, (resource_descriptor_bank)
 4116	46A9	ED	5B	2A	C0	    ld de, (resource_descriptor_addr)
 4117	46AD	ED	4B	2C	C0	    ld bc, (resource_descriptor_size)
 4118	46B1	B7				    or a
 4119	46B2	C9				    ret
 4120	46B3					.resource_find_scan:
 4121	46B3	21	29	42		    ld hl, resource_table
 4122	46B6	06	81			    ld b, RESOURCE_TABLE_COUNT
 4123	46B8					.resource_find_loop:
 4124	46B8	78				    ld a, b
 4125	46B9	B7				    or a
 4126	46BA	CA	F7	46		    jp z, .resource_find_not_found
 4127	46BD	7E				    ld a, (hl)
 4128	46BE	B9				    cp c
 4129	46BF	CA	CA	46		    jp z, .resource_find_found
 4130	46C2	11	08	00		    ld de, RESOURCE_TABLE_ENTRY_SIZE
 4131	46C5	19				    add hl, de
 4132	46C6	05				    dec b
 4133	46C7	C3	B8	46		    jp .resource_find_loop
 4134	46CA					
