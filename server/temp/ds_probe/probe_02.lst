 4887	48BF					; ==================================================================
 4888	48BF					; SHARED MAINLINE TASK WRAPPERS
 4889	48BF					; ==================================================================
 4890	48BF					; These wrappers stay available in interruptTaskManager mode because
 4891	48BF					; the HALT-driven GameFlow loops still call them directly.
 4892	48BF					; ==================================================================
 4893	48BF					
 4894	48BF					; ==================================================================
 4895	48BF					; TASK_UPDATE_INPUT - Joystick/Cursor polling wrapper
 4896	48BF					; ==================================================================
 4897	48BF					; Register Contract:
 4898	48BF					;   Purpose: Poll joystick + keyboard fallback and update input state buffers.
 4899	48BF					;   Inputs:
 4900	48BF					;     - Reads hardware via FAST_GTSTCK / FAST_GTTRIG / FAST_SNSMAT
 4901	48BF					;   Outputs:
 4902	48BF					;     - input_state, prev_input_state, input_btn_curr, input_btn_prev, input_fire
 4903	48BF					;   Clobbers:
 4904	48BF					;     - AF
 4905	48BF					;     - BC
 4906	48BF					;     - DE
 4907	48BF					;   Preserved:
 4908	48BF					;     - AF
 4909	48BF					;     - BC
 4910	48BF					;     - DE (by push/pop wrapper)
 4911	48BF					;     - HL
 4912	48BF					;   Register roles:
 4913	48BF					;     - A = hardware reads and final scalar writes
 4914	48BF					;     - B = direction accumulator
 4915	48BF					;     - D = button bitmask and keyboard direction flags
 4916	48BF					;     - E = temporary keyboard row bits
 4917	48BF					;   Notes:
 4918	48BF					;     - Wrapper preserves caller-visible regs despite internal mutation.
 4919	48BF					task_update_input:
 4920	48BF	F5				    push af
 4921	48C0	C5				    push bc
 4922	48C1	D5				    push de
 4923	48C2					
 4924	48C2					    ; Save previous state
 4925	48C2	3A	00	C0		    ld a, (input_state)
 4926	48C5	32	01	C0		    ld (prev_input_state), a
 4927	48C8	3A	02	C0		    ld a, (input_btn_curr)
 4928	48CB	32	03	C0		    ld (input_btn_prev), a
 4929	48CE					
 4930	48CE					    ; Read joystick direction first (priority source, direct hardware)
 4931	48CE	AF				    xor a                       ; Joystick 0
 4932	48CF	CD	0D	41		    call FAST_GTSTCK            ; Direct hardware read
 4933	48D2	47				    ld b, a                     ; B = joystick direction
 4934	48D3	B7				    or a
 4935	48D4	20	60			    jr nz, .dir_ready
 4936	48D6					
 4937	48D6					    ; Fallback to keyboard cursor keys (row 8, direct matrix read)
 4938	48D6	3E	08			    ld a, 8
 4939	48D8	CD	48	41		    call FAST_SNSMAT            ; Active low bits
 4940	48DB	5F				    ld e, a
 4941	48DC	AF				    xor a
 4942	48DD	57				    ld d, a                     ; D = direction flags: 0=none
 4943	48DE	CB	6B			    bit 5, e                    ; Up
 4944	48E0	20	02			    jr nz, .kbd_no_up
 4945	48E2	CB	C2			    set 0, d
 4946	48E4					.kbd_no_up:
 4947	48E4	CB	73			    bit 6, e                    ; Down
 4948	48E6	20	02			    jr nz, .kbd_no_down
 4949	48E8	CB	CA			    set 1, d
 4950	48EA					.kbd_no_down:
 4951	48EA	CB	63			    bit 4, e                    ; Left
 4952	48EC	20	02			    jr nz, .kbd_no_left
 4953	48EE	CB	D2			    set 2, d
 4954	48F0					.kbd_no_left:
 4955	48F0	CB	7B			    bit 7, e                    ; Right
 4956	48F2	20	02			    jr nz, .kbd_no_right
 4957	48F4	CB	DA			    set 3, d
 4958	48F6					.kbd_no_right:
 4959	48F6	AF				    xor a
 4960	48F7	CB	42			    bit 0, d
 4961	48F9	28	14			    jr z, .kbd_check_down
 4962	48FB	CB	5A			    bit 3, d
 4963	48FD	20	08			    jr nz, .kbd_upright
 4964	48FF	CB	52			    bit 2, d
 4965	4901	20	08			    jr nz, .kbd_upleft
 4966	4903	3E	01			    ld a, STICK_UP
 4967	4905	18	2E			    jr .kbd_done
 4968	4907					.kbd_upright:
 4969	4907	3E	02			    ld a, STICK_UPRIGHT
 4970	4909	18	2A			    jr .kbd_done
 4971	490B					.kbd_upleft:
 4972	490B	3E	08			    ld a, STICK_UPLEFT
 4973	490D	18	26			    jr .kbd_done
 4974	490F					.kbd_check_down:
 4975	490F	CB	4A			    bit 1, d
 4976	4911	28	14			    jr z, .kbd_check_lr
 4977	4913	CB	5A			    bit 3, d
 4978	4915	20	08			    jr nz, .kbd_downright
 4979	4917	CB	52			    bit 2, d
 4980	4919	20	08			    jr nz, .kbd_downleft
 4981	491B	3E	05			    ld a, STICK_DOWN
 4982	491D	18	16			    jr .kbd_done
 4983	491F					.kbd_downright:
 4984	491F	3E	04			    ld a, STICK_DOWNRIGHT
 4985	4921	18	12			    jr .kbd_done
 4986	4923					.kbd_downleft:
 4987	4923	3E	06			    ld a, STICK_DOWNLEFT
 4988	4925	18	0E			    jr .kbd_done
 4989	4927					.kbd_check_lr:
 4990	4927	CB	52			    bit 2, d
 4991	4929	28	04			    jr z, .kbd_check_right
 4992	492B	3E	07			    ld a, STICK_LEFT
 4993	492D	18	06			    jr .kbd_done
 4994	492F					.kbd_check_right:
 4995	492F	CB	5A			    bit 3, d
 4996	4931	28	02			    jr z, .kbd_done
 4997	4933	3E	03			    ld a, STICK_RIGHT
 4998	4935					.kbd_done:
 4999	4935	47				    ld b, a
 5000	4936					.dir_ready:
 5001	4936					    ; Normalize diagonals to cardinal directions for runtime stability
 5002	4936					    ; UP+RIGHT/DOWN+RIGHT -> RIGHT, UP+LEFT/DOWN+LEFT -> LEFT
 5003	4936	78				    ld a, b
 5004	4937	FE	02			    cp STICK_UPRIGHT
 5005	4939	28	0E			    jr z, .dir_norm_right
 5006	493B	FE	04			    cp STICK_DOWNRIGHT
 5007	493D	28	0A			    jr z, .dir_norm_right
 5008	493F	FE	08			    cp STICK_UPLEFT
 5009	4941	28	0A			    jr z, .dir_norm_left
 5010	4943	FE	06			    cp STICK_DOWNLEFT
 5011	4945	28	06			    jr z, .dir_norm_left
 5012	4947	18	07			    jr .dir_norm_done
 5013	4949					.dir_norm_right:
 5014	4949	3E	03			    ld a, STICK_RIGHT
 5015	494B	18	02			    jr .dir_norm_store
 5016	494D					.dir_norm_left:
 5017	494D	3E	07			    ld a, STICK_LEFT
 5018	494F					.dir_norm_store:
 5019	494F	47				    ld b, a
 5020	4950					.dir_norm_done:
 5021	4950	AF				    xor a                       ; Joystick 0
 5022	4951	CD	35	41		    call FAST_GTTRIG            ; A = #FF if pressed, 0 if not
 5023	4954	16	00			    ld d, 0                     ; D = button bitmask
 5024	4956	B7				    or a
 5025	4957	28	09			    jr z, .no_fire              ; Jump if NOT pressed (A=0)
 5026	4959	16	01			    ld d, INPUT_BTN_FIRE
 5027	495B	3E	01			    ld a, 1                     ; Fire pressed
 5028	495D	32	04	C0		    ld (input_fire), a
 5029	4960	18	16			    jr .fire_done
 5030	4962					.no_fire:
 5031	4962					    ; Keyboard fallback for fire (SPACE, row 8 bit 0, active low)
 5032	4962	3E	08			    ld a, 8
 5033	4964	CD	48	41		    call FAST_SNSMAT
 5034	4967	CB	47			    bit 0, a
 5035	4969	20	09			    jr nz, .fire_released
 5036	496B	16	01			    ld d, INPUT_BTN_FIRE
 5037	496D	3E	01			    ld a, 1
 5038	496F	32	04	C0		    ld (input_fire), a
 5039	4972	18	04			    jr .fire_done
 5040	4974					.fire_released:
 5041	4974	AF				    xor a                       ; Fire not pressed
 5042	4975	32	04	C0		    ld (input_fire), a
 5043	4978					.fire_done:
 5044	4978					    ; Second action button: joystick button B or keyboard N
 5045	4978	C5				    push bc
 5046	4979	E5				    push hl
 5047	497A	3E	03			    ld a, 3                    ; GTTRIG(3) = joystick 1 button B
 5048	497C	CD	D8	00		    call GTTRIG
 5049	497F	5F				    ld e, a
 5050	4980	E1				    pop hl
 5051	4981	C1				    pop bc
 5052	4982	7B				    ld a, e
 5053	4983	B7				    or a
 5054	4984	20	09			    jr nz, .grab_pressed
 5055	4986	3E	04			    ld a, 4                    ; Keyboard row containing N
 5056	4988	CD	48	41		    call FAST_SNSMAT
 5057	498B	CB	5F			    bit 3, a                   ; N key (active low)
 5058	498D	20	04			    jr nz, .grab_done
 5059	498F					.grab_pressed:
 5060	498F	7A				    ld a, d
 5061	4990	F6	02			    or INPUT_BTN_GRAB
 5062	4992	57				    ld d, a
 5063	4993					.grab_done:
 5064	4993	78				    ld a, b
 5065	4994	32	00	C0		    ld (input_state), a
 5066	4997	7A				    ld a, d
 5067	4998	32	02	C0		    ld (input_btn_curr), a
 5068	499B					
 5069	499B	D1				    pop de
 5070	499C	C1				    pop bc
 5071	499D	F1				    pop af
 5072	499E	C9				    ret
