 25002	A10B					
 25003	A10B					; ------------------------------------------------------------------
 25004	A10B					; Routine: update_animated_transform_tiles_vram
 25005	A10B					; Purpose:
 25006	A10B					;   Applies Z80 transform operations directly on tile bytes in VRAM.
 25007	A10B					; Input:
 25008	A10B					;   None
 25009	A10B					; Output:
 25010	A10B					;   None
 25011	A10B					; Modifies:
 25012	A10B					;   AF, BC, DE, HL
 25013	A10B					; Preserves:
 25014	A10B					;   IX, IY, SP
 25015	A10B					; Flags:
 25016	A10B					;   Not preserved
 25017	A10B					; Stack:
 25018	A10B					;   Uses PUSH/POP HL, BC and DE internally
 25019	A10B					; ------------------------------------------------------------------
 25020	A10B					update_animated_transform_tiles_vram:
 25021	A10B	21	05	A3		    ld hl, anim_transform_table
 25022	A10E					
 25023	A10E					.anim_transform_loop:
 25024	A10E	7E				    ld a, (hl)                      ; A = target char code
 25025	A10F	FE	FF			    cp 255
 25026	A111	C8				    ret z
 25027	A112					
 25028	A112	4F				    ld c, a                         ; C = first char code
 25029	A113	23				    inc hl
 25030	A114	46				    ld b, (hl)                      ; B = chars per tile
 25031	A115	23				    inc hl
 25032	A116	56				    ld d, (hl)                      ; D = operation code
 25033	A117	23				    inc hl
 25034	A118	7E				    ld a, (hl)                      ; A = flags
 25035	A119	32	73	DC		    ld (anim_tile_transform_flags), a
 25036	A11C	23				    inc hl                          ; HL = next table entry
 25037	A11D	E5				    push hl
