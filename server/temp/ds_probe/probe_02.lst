 8830	6CE7					; ------------------------------------------------------------------
 8831	6CE7					; wall_behavior_is_full_blocker
 8832	6CE7					; Input:  A = behavior byte or family bits
 8833	6CE7					; Output: Z = passable / top-solid platform, NZ = full blocker
 8834	6CE7					; Clobbers: AF
 8835	6CE7					; Notes:
 8836	6CE7					;   - familyId 2 (#20) is treated as one-way/top-solid, so it must not
 8837	6CE7					;     block horizontal motion or upward motion.
 8838	6CE7					; ------------------------------------------------------------------
 8839	6CE7					wall_behavior_is_full_blocker:
 8840	6CE7	E6	F0			    and #F0
 8841	6CE9	C8				    ret z
 8842	6CEA	FE	20			    cp #20
 8843	6CEC	C8				    ret z
 8844	6CED	B7				    or a
 8845	6CEE	C9				    ret
 8846	6CEF					
 8847	6CEF					; ------------------------------------------------------------------
 8848	6CEF					; wall_down_behavior_blocks
 8849	6CEF					; Input:
 8850	6CEF					;   - A  = behavior byte or family bits from get_behavior_tile
 8851	6CEF					;   - B  = tile row of the floor probe
 8852	6CEF					;   - DE = entity index
 8853	6CEF					; Output:
 8854	6CEF					;   - Z  = passable
 8855	6CEF					;   - NZ = blocks downward movement / supports standing
 8856	6CEF					; Clobbers: AF, C, HL
 8857	6CEF					; Preserved: B, DE
 8858	6CEF					; Notes:
 8859	6CEF					;   - familyId 2 (#20) is top-solid: it only blocks when the entity was
 8860	6CEF					;     already above the tile before this frame's vertical movement.
 8861	6CEF					;   - update_position_component already applied vel_y before WallCollision,
 8862	6CEF					;     so previous_bottom = wall_hit_bottom - entity_vel_y.
 8863	6CEF					; ------------------------------------------------------------------
