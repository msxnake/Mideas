 18681	60F8					    ; Bank 0: CHRTBL2 + (0 * 8)
 18682	60F8	21	00	00		    ld hl, CHRTBL2
 18683	60FB	0E	08			    ld c, 8
 18684	60FD	AF				    xor a                      ; A = 0 (blank pattern)
 18685	60FE					init_char0_pattern_bank0_loop:
 18686	60FE	CD	E3	40		    call FAST_WRTVRM
 18687	6101	23				    inc hl
 18688	6102	0D				    dec c
 18689	6103	20	F9			    jr nz, init_char0_pattern_bank0_loop
 18690	6105					    
 18691	6105					    ; Bank 1: CHRTBL2 + #800 + (0 * 8)
 18692	6105	21	00	08		    ld hl, CHRTBL2 + #800
 18693	6108	0E	08			    ld c, 8
 18694	610A	AF				    xor a
 18695	610B					init_char0_pattern_bank1_loop:
 18696	610B	CD	E3	40		    call FAST_WRTVRM
 18697	610E	23				    inc hl
