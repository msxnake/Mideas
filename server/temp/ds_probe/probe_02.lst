 3266	420B					; ------------------------------------------------------------------
 3267	420B					; mapper_call_hl_auto
 3268	420B					; Auto-select mapper window from HL target address range:
 3269	420B					;   4000-5FFF -> fixed
 3270	420B					;   6000-7FFF -> p1
 3271	420B					;   8000-9FFF -> p2
 3272	420B					;   A000-BFFF -> p3
 3273	420B					; Input:
