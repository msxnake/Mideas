 23840	8000					; calls routine, then restores P2.
 23841	8000					; NOTE: routines in this bank MUST only call code in bank 0 or
 23842	8000					;       primary banks (1-3). No far-to-far calls allowed.
 23843	8000					; ##################################################################
 23844	8000					    org #8000
 23845	8000					
 23846	8000					; ==================================================================
 23847	8000					; PSG SOUND SYSTEM
 23848	8000					; File: sound.asm
 23849	8000					; Description: AY-3-8910 PSG control and sound effects
 23850	8000					; Engine Audio Tick: IRQ task_manager
 23851	8000					; ==================================================================
 23852	8000					
 23853	8000					; ==================================================================
 23854	8000					; PSG REGISTER ADDRESSES
 23855	8000					; ==================================================================
 23856	8000					
 23857	8000					; Tone Generators (Channels A, B, C)
 23858	8000					PSG_TONE_A_LO       EQU 0        ; Channel A period low byte
 23859	8000					PSG_TONE_A_HI       EQU 1        ; Channel A period high byte (4 bits)
 23860	8000					PSG_TONE_B_LO       EQU 2        ; Channel B period low byte
 23861	8000					PSG_TONE_B_HI       EQU 3        ; Channel B period high byte (4 bits)
 23862	8000					PSG_TONE_C_LO       EQU 4        ; Channel C period low byte
 23863	8000					PSG_TONE_C_HI       EQU 5        ; Channel C period high byte (4 bits)
 23864	8000					
 23865	8000					; Noise Generator
 23866	8000					PSG_NOISE_PERIOD    EQU 6        ; Noise period (5 bits)
 23867	8000					
 23868	8000					; Mixer Control
 23869	8000					PSG_MIXER           EQU 7        ; Mixer/Enable register
 23870	8000					; Bit 0: Channel A tone enable (0=on, 1=off)
 23871	8000					; Bit 1: Channel B tone enable
 23872	8000					; Bit 2: Channel C tone enable
 23873	8000					; Bit 3: Channel A noise enable (0=on, 1=off)
 23874	8000					; Bit 4: Channel B noise enable
 23875	8000					; Bit 5: Channel C noise enable
 23876	8000					
 23877	8000					; Volume Control
 23878	8000					PSG_VOL_A           EQU 8        ; Channel A volume (4 bits) + envelope flag (bit 4)
 23879	8000					PSG_VOL_B           EQU 9        ; Channel B volume
 23880	8000					PSG_VOL_C           EQU 10       ; Channel C volume
 23881	8000					
 23882	8000					; Envelope Generator
 23883	8000					PSG_ENV_LO          EQU 11       ; Envelope period low byte
 23884	8000					PSG_ENV_HI          EQU 12       ; Envelope period high byte
 23885	8000					PSG_ENV_SHAPE       EQU 13       ; Envelope shape (4 bits)
 23886	8000					
 23887	8000					; ==================================================================
 23888	8000					; PSG TONE PERIODS (Musical notes, octave 4, 3.579545 MHz clock)
 23889	8000					; ==================================================================
 23890	8000					
 23891	8000					; Note frequencies for octave 4 (middle C = C4)
 23892	8000					NOTE_C4         EQU 477      ; C  - 261.63 Hz
 23893	8000					NOTE_CS4        EQU 450      ; C# - 277.18 Hz
 23894	8000					NOTE_D4         EQU 425      ; D  - 293.66 Hz
 23895	8000					NOTE_DS4        EQU 401      ; D# - 311.13 Hz
 23896	8000					NOTE_E4         EQU 379      ; E  - 329.63 Hz
 23897	8000					NOTE_F4         EQU 357      ; F  - 349.23 Hz
 23898	8000					NOTE_FS4        EQU 337      ; F# - 369.99 Hz
 23899	8000					NOTE_G4         EQU 318      ; G  - 392.00 Hz
 23900	8000					NOTE_GS4        EQU 300      ; G# - 415.30 Hz
 23901	8000					NOTE_A4         EQU 284      ; A  - 440.00 Hz
 23902	8000					NOTE_AS4        EQU 268      ; A# - 466.16 Hz
 23903	8000					NOTE_B4         EQU 253      ; B  - 493.88 Hz
 23904	8000					NOTE_C5         EQU 238      ; C5 - 523.25 Hz
 23905	8000					
 23906	8000					; Octave multipliers: Divide period by 2 for +1 octave, multiply by 2 for -1 octave
 23907	8000					
 23908	8000					; ==================================================================
 23909	8000					; SOUND EFFECT DURATIONS (in frames, 60Hz)
 23910	8000					; ==================================================================
 23911	8000					
 23912	8000					SFX_SHORT           EQU 5        ; ~83ms
 23913	8000					SFX_MEDIUM          EQU 15       ; ~250ms
 23914	8000					SFX_LONG            EQU 30       ; ~500ms
 23915	8000					
 23916	8000					; ==================================================================
 23917	8000					; SOUND SYSTEM INITIALIZATION
 23918	8000					; ==================================================================
 23919	8000					
 23920	8000					init_sound_system:
 23921	8000					    ; Initialize PSG via BIOS
 23922	8000	CD	90	00		    call GICINI
 23923	8003					
 23924	8003					    ; Clear runtime sound state so power-on RAM garbage cannot make
 23925	8003					    ; sfx_update / SM_UpdateSound drive the PSG for a few random frames.
 23926	8003	AF				    xor a
 23927	8004	32	59	E5		    ld (sfx_active), a
 23928	8007	32	5A	E5		    ld (sfx_timer), a
 23929	800A	32	5B	E5		    ld (sfx_fadeout), a
 23930	800D	32	B5	E9		    ld (sm_sound_active), a
 23931	8010	32	B6	E9		    ld (sm_sound_frames_left), a
 23932	8013	32	B7	E9		    ld (sm_sound_ptr_l), a
 23933	8016	32	B8	E9		    ld (sm_sound_ptr_h), a
 23934	8019	CD	8E	81		    call music_init_system
 23935	801C					
 23936	801C					    ; Silence all channels
 23937	801C	CD	72	80		    call sfx_silence_all
 23938	801F					
 23939	801F	C9				    ret
 23940	8020					
 23941	8020					; ------------------------------------------------------------------
 23942	8020					; task_audio_tick
 23943	8020					; Shared audio tick wrapper for IRQ task_manager or HALT game loops.
 23944	8020					; Preserves caller-visible registers on every exit path.
 23945	8020					; ------------------------------------------------------------------
 23946	8020					task_audio_tick:
 23947	8020	F5				    push af
 23948	8021	C5				    push bc
 23949	8022	D5				    push de
 23950	8023	E5				    push hl
 23951	8024					
 23952	8024	CD	8D	4C		    call call_music_update_resident
 23953	8027	CD	7F	84		    call SM_UpdateSound
 23954	802A					
 23955	802A					
 23956	802A	E1				    pop hl
 23957	802B	D1				    pop de
 23958	802C	C1				    pop bc
 23959	802D	F1				    pop af
 23960	802E	C9				    ret
 23961	802F					
 23962	802F					; ==================================================================
 23963	802F					; PSG LOW-LEVEL CONTROL FUNCTIONS
 23964	802F					; ==================================================================
 23965	802F					
 23966	802F					; ------------------------------------------------------------------
 23967	802F					; psg_write
 23968	802F					; Write to PSG register via BIOS
 23969	802F					; Input:  A = Register number (0-13)
 23970	802F					;         E = Value to write
 23971	802F					; Destroys: AF, E
 23972	802F					; ------------------------------------------------------------------
 23973	802F					psg_write:
 23974	802F	CD	93	00		    call WRTPSG
 23975	8032	C9				    ret
 23976	8033					
 23977	8033					; ------------------------------------------------------------------
 23978	8033					; psg_set_tone
 23979	8033					; Set tone period for a channel
 23980	8033					; Input:  A = Channel (0=A, 1=B, 2=C)
 23981	8033					;         HL = Tone period (12-bit value)
 23982	8033					; Destroys: AF, BC, DE, HL
 23983	8033					; ------------------------------------------------------------------
 23984	8033					psg_set_tone:
 23985	8033					    ; Calculate register numbers (A*2 for low, A*2+1 for high)
 23986	8033	87				    add a, a                     ; A = channel * 2
 23987	8034	4F				    ld c, a                      ; C = low register number
 23988	8035	3C				    inc a
 23989	8036	47				    ld b, a                      ; B = high register number
 23990	8037					
 23991	8037					    ; Write low byte
 23992	8037	79				    ld a, c
 23993	8038	5D				    ld e, l
 23994	8039	CD	93	00		    call WRTPSG
 23995	803C					
 23996	803C					    ; Write high byte (only lower 4 bits)
 23997	803C	78				    ld a, b
 23998	803D	5C				    ld e, h
 23999	803E	7B				    ld a, e
 24000	803F	E6	0F			    and #0F
 24001	8041	5F				    ld e, a
 24002	8042	78				    ld a, b
 24003	8043	CD	93	00		    call WRTPSG
 24004	8046					
 24005	8046	C9				    ret
 24006	8047					
 24007	8047					; ------------------------------------------------------------------
 24008	8047					; psg_set_volume
 24009	8047					; Set volume for a channel
 24010	8047					; Input:  A = Channel (0=A, 1=B, 2=C)
 24011	8047					;         B = Volume (0-15) or #10 to enable PSG hardware envelope
 24012	8047					; Destroys: AF, E
 24013	8047					; ------------------------------------------------------------------
 24014	8047					psg_set_volume:
 24015	8047	C6	08			    add a, PSG_VOL_A             ; A = PSG_VOL_x register
 24016	8049	58				    ld e, b                      ; E = volume value
 24017	804A	CD	93	00		    call WRTPSG
 24018	804D	C9				    ret
 24019	804E					
 24020	804E					; ------------------------------------------------------------------
 24021	804E					; psg_set_noise
 24022	804E					; Set noise generator period
 24023	804E					; Input:  A = Noise period (0-31)
 24024	804E					; Destroys: AF, E
 24025	804E					; ------------------------------------------------------------------
 24026	804E					psg_set_noise:
 24027	804E	5F				    ld e, a
 24028	804F	3E	06			    ld a, PSG_NOISE_PERIOD
 24029	8051	CD	93	00		    call WRTPSG
 24030	8054	C9				    ret
 24031	8055					
 24032	8055					; ------------------------------------------------------------------
 24033	8055					; psg_set_mixer
 24034	8055					; Set mixer control (enable/disable tone and noise)
 24035	8055					; Input:  A = Mixer value
 24036	8055					;         Bits 0-2: Tone off (0=on, 1=off) for channels A,B,C
 24037	8055					;         Bits 3-5: Noise off (0=on, 1=off) for channels A,B,C
 24038	8055					; Destroys: AF, E
 24039	8055					; ------------------------------------------------------------------
 24040	8055					psg_set_mixer:
 24041	8055	5F				    ld e, a
 24042	8056	3E	07			    ld a, PSG_MIXER
 24043	8058	CD	93	00		    call WRTPSG
 24044	805B	C9				    ret
 24045	805C					
 24046	805C					; ------------------------------------------------------------------
 24047	805C					; psg_set_envelope
 24048	805C					; Program the global PSG hardware envelope generator
 24049	805C					; Input:  HL = Envelope period
 24050	805C					;         B = Envelope shape (0-15)
 24051	805C					; Destroys: AF, E
 24052	805C					; ------------------------------------------------------------------
 24053	805C					psg_set_envelope:
 24054	805C	3E	0B			    ld a, PSG_ENV_LO
 24055	805E	5D				    ld e, l
 24056	805F	CD	93	00		    call WRTPSG
 24057	8062	3E	0C			    ld a, PSG_ENV_HI
 24058	8064	5C				    ld e, h
 24059	8065	CD	93	00		    call WRTPSG
 24060	8068	78				    ld a, b
 24061	8069	E6	0F			    and #0F
 24062	806B	5F				    ld e, a
 24063	806C	3E	0D			    ld a, PSG_ENV_SHAPE
 24064	806E	CD	93	00		    call WRTPSG
 24065	8071	C9				    ret
 24066	8072					
 24067	8072					; ==================================================================
 24068	8072					; HIGH-LEVEL SOUND EFFECTS
 24069	8072					; ==================================================================
 24070	8072					
 24071	8072					; ------------------------------------------------------------------
 24072	8072					; sfx_silence_all
 24073	8072					; Silence all PSG channels
 24074	8072					; ------------------------------------------------------------------
 24075	8072					sfx_silence_all:
 24076	8072					    ; Set all volumes to 0
 24077	8072	AF				    xor a                        ; A = channel A
 24078	8073	06	00			    ld b, 0                      ; B = volume 0
 24079	8075	CD	47	80		    call psg_set_volume
 24080	8078					
 24081	8078	3E	01			    ld a, 1                      ; A = channel B
 24082	807A	06	00			    ld b, 0
 24083	807C	CD	47	80		    call psg_set_volume
 24084	807F					
 24085	807F	3E	02			    ld a, 2                      ; A = channel C
 24086	8081	06	00			    ld b, 0
 24087	8083	CD	47	80		    call psg_set_volume
 24088	8086					
 24089	8086					    ; Disable all tone and noise
 24090	8086	3E	3F			    ld a, #3F                    ; All tone and noise off
 24091	8088	CD	55	80		    call psg_set_mixer
 24092	808B					
 24093	808B	C9				    ret
 24094	808C					
 24095	808C					; ------------------------------------------------------------------
 24096	808C					; sfx_beep
 24097	808C					; Simple beep sound
 24098	808C					; ------------------------------------------------------------------
 24099	808C					sfx_beep:
 24100	808C					    ; Channel A: 440Hz (A4)
 24101	808C	AF				    xor a                        ; A = channel A
 24102	808D	21	1C	01		    ld hl, NOTE_A4
 24103	8090	CD	33	80		    call psg_set_tone
 24104	8093					
 24105	8093					    ; Volume 12
 24106	8093	AF				    xor a
 24107	8094	06	0C			    ld b, 12
 24108	8096	CD	47	80		    call psg_set_volume
 24109	8099					
 24110	8099					    ; Enable tone A only
 24111	8099	3E	3E			    ld a, #3E                    ; Tone A on, others off
 24112	809B	CD	55	80		    call psg_set_mixer
 24113	809E					
 24114	809E	C9				    ret
 24115	809F					
 24116	809F					; ------------------------------------------------------------------
 24117	809F					; sfx_jump
 24118	809F					; Jump sound effect (rising pitch)
 24119	809F					; ------------------------------------------------------------------
 24120	809F					sfx_jump:
 24121	809F					    ; Channel A: Start at C4, quick rise
 24122	809F	AF				    xor a
 24123	80A0	21	DD	01		    ld hl, NOTE_C4
 24124	80A3	CD	33	80		    call psg_set_tone
 24125	80A6					
 24126	80A6					    ; Volume 10
 24127	80A6	AF				    xor a
 24128	80A7	06	0A			    ld b, 10
 24129	80A9	CD	47	80		    call psg_set_volume
 24130	80AC					
 24131	80AC					    ; Enable tone A
 24132	80AC	3E	3E			    ld a, #3E
 24133	80AE	CD	55	80		    call psg_set_mixer
 24134	80B1					
 24135	80B1					    ; TODO: Add pitch sweep for realistic jump sound
 24136	80B1	C9				    ret
 24137	80B2					
 24138	80B2					; ------------------------------------------------------------------
 24139	80B2					; sfx_shoot
 24140	80B2					; Shooting sound (noise + low tone)
 24141	80B2					; ------------------------------------------------------------------
 24142	80B2					sfx_shoot:
 24143	80B2					    ; Channel A: Low tone
 24144	80B2	AF				    xor a
 24145	80B3	21	64	00		    ld hl, 100                   ; Low period = high pitch
 24146	80B6	CD	33	80		    call psg_set_tone
 24147	80B9					
 24148	80B9					    ; Volume 8
 24149	80B9	AF				    xor a
 24150	80BA	06	08			    ld b, 8
 24151	80BC	CD	47	80		    call psg_set_volume
 24152	80BF					
 24153	80BF					    ; Noise generator at period 5
 24154	80BF	3E	05			    ld a, 5
 24155	80C1	CD	4E	80		    call psg_set_noise
 24156	80C4					
 24157	80C4					    ; Enable tone A + noise A
 24158	80C4	3E	36			    ld a, #36                    ; Tone A + Noise A on
 24159	80C6	CD	55	80		    call psg_set_mixer
 24160	80C9					
 24161	80C9	C9				    ret
 24162	80CA					
 24163	80CA					; ------------------------------------------------------------------
 24164	80CA					; sfx_explosion
 24165	80CA					; Explosion sound (noise-heavy)
 24166	80CA					; ------------------------------------------------------------------
 24167	80CA					sfx_explosion:
 24168	80CA					    ; Noise generator at period 10
 24169	80CA	3E	0A			    ld a, 10
 24170	80CC	CD	4E	80		    call psg_set_noise
 24171	80CF					
 24172	80CF					    ; Channel A: Volume 15 (max) with noise
 24173	80CF	AF				    xor a
 24174	80D0	06	0F			    ld b, 15
 24175	80D2	CD	47	80		    call psg_set_volume
 24176	80D5					
 24177	80D5					    ; Enable noise A only (no tone)
 24178	80D5	3E	39			    ld a, #39                    ; Noise A on, tone off
 24179	80D7	CD	55	80		    call psg_set_mixer
 24180	80DA					
 24181	80DA	C9				    ret
 24182	80DB					
 24183	80DB					; ------------------------------------------------------------------
 24184	80DB					; sfx_coin
 24185	80DB					; Coin/pickup sound (quick ascending notes)
 24186	80DB					; ------------------------------------------------------------------
 24187	80DB					sfx_coin:
 24188	80DB					    ; Channel B: E4 note
 24189	80DB	3E	01			    ld a, 1                      ; Channel B
 24190	80DD	21	7B	01		    ld hl, NOTE_E4
 24191	80E0	CD	33	80		    call psg_set_tone
 24192	80E3					
 24193	80E3					    ; Volume 10
 24194	80E3	3E	01			    ld a, 1
 24195	80E5	06	0A			    ld b, 10
 24196	80E7	CD	47	80		    call psg_set_volume
 24197	80EA					
 24198	80EA					    ; Enable tone B
 24199	80EA	3E	3D			    ld a, #3D                    ; Tone B on, others off
 24200	80EC	CD	55	80		    call psg_set_mixer
 24201	80EF					
 24202	80EF					    ; TODO: Quick ascend to G4 for classic coin sound
 24203	80EF	C9				    ret
 24204	80F0					
 24205	80F0					; ------------------------------------------------------------------
 24206	80F0					; sfx_damage
 24207	80F0					; Damage/hit sound (harsh noise)
 24208	80F0					; ------------------------------------------------------------------
 24209	80F0					sfx_damage:
 24210	80F0					    ; Short noise burst
 24211	80F0	3E	03			    ld a, 3                      ; Harsh noise period
 24212	80F2	CD	4E	80		    call psg_set_noise
 24213	80F5					
 24214	80F5					    ; Channel C: Volume 12
 24215	80F5	3E	02			    ld a, 2                      ; Channel C
 24216	80F7	06	0C			    ld b, 12
 24217	80F9	CD	47	80		    call psg_set_volume
 24218	80FC					
 24219	80FC					    ; Enable noise C only
