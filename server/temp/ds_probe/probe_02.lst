 7062	6556					    handle_entity_collision:
 7063	6556					    ; Handle collision between entities
 7064	6556					    ; At entry:
 7065	6556					    ;   C = current entity index
 7066	6556					    ;   Stack top: DE (E = other entity index), HL, AF, BC
 7067	6556					    ; Check for platform riding: if current entity is above other entity and
 7068	6556					    ; other entity is a platform (collision_layer & 8), set platform reference
