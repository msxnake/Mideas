 1788	40CD					; MSX BIOS FUNCTIONS AND ADDRESSES
 1789	40CD					; File: bios.asm
 1790	40CD					; Description: Standard MSX BIOS function definitions
 1791	40CD					; ==================================================================
 1792	40CD					
 1793	40CD					; ==================================================================
 1794	40CD					; MAIN BIOS FUNCTIONS
 1795	40CD					; ==================================================================
 1796	40CD					
 1797	40CD					; Screen and Display
 1798	40CD					CHGMOD  EQU #005F        ; Change screen mode (A=mode)
 1799	40CD					CHGCLR  EQU #0062        ; Change colors
 1800	40CD					CLS     EQU #00C3        ; Clear screen
 1801	40CD					POSIT   EQU #00C6        ; Position cursor (H=X, L=Y)
 1802	40CD					ERAFNK  EQU #00CC        ; Erase function keys
 1803	40CD					DSPFNK  EQU #00CF        ; Display function keys
 1804	40CD					DISSCR  EQU #0041        ; Disable screen (prevent flicker)
 1805	40CD					ENASCR  EQU #0044        ; Enable screen
 1806	40CD					INITXT  EQU #006C        ; Initialize text mode
 1807	40CD					INIT32  EQU #006F        ; Initialize screen mode
 1808	40CD					INIGRP  EQU #0072        ; Initialize graphics routines
 1809	40CD					
 1810	40CD					; Character I/O
 1811	40CD					CHPUT   EQU #00A2        ; Character output (A=char)
 1812	40CD					CHGET   EQU #009F        ; Character input
 1813	40CD					CHSNS   EQU #009C        ; Character sense (check key)
 1814	40CD					BREAKX  EQU #00B7        ; Check CTRL+STOP
 1815	40CD					ISCNTC  EQU #00BA        ; Check CTRL+C
 1816	40CD					
 1817	40CD					; String I/O
 1818	40CD					OUTDO   EQU #005A        ; String output (HL=string)
 1819	40CD					
 1820	40CD					; Input Devices
 1821	40CD					GTSTCK  EQU #00D5        ; Get joystick status (A=port)
 1822	40CD					GTTRIG  EQU #00D8        ; Get trigger status (A=port)
 1823	40CD					GTPAD   EQU #00DB        ; Get paddle (A=port)
 1824	40CD					GTPDL   EQU #00DE        ; Get paddle value
 1825	40CD					SNSMAT  EQU #0141        ; Sense matrix (A=row)
 1826	40CD					KILBUF  EQU #0156        ; Kill keyboard buffer
 1827	40CD					
 1828	40CD					; Slot Management
 1829	40CD					RSLREG  EQU #0138        ; Read slot register
 1830	40CD					WSLREG  EQU #013B        ; Write slot register
 1831	40CD					ENASLT  EQU #0024        ; Enable slot (H=page, A=slot)
 1832	40CD					CALSLT  EQU #001C        ; Call routine in another slot
 1833	40CD					
 1834	40CD					; Sound
 1835	40CD					GICINI  EQU #0090        ; Initialize PSG
 1836	40CD					WRTPSG  EQU #0093        ; Write PSG register (A=reg, E=value)
 1837	40CD					RDPSG   EQU #0096        ; Read PSG register (A=reg)
 1838	40CD					
 1839	40CD					; Graphics VDP
 1840	40CD					GRPPRT  EQU #0089        ; Print in graphic mode
 1841	40CD					SETGRP  EQU #007E        ; Set graphic mode
 1842	40CD					
 1843	40CD					; Memory Transfer
 1844	40CD					LDIRVM  EQU #005C        ; Block transfer from CPU to VRAM
 1845	40CD					LDIRMV  EQU #0059        ; Block transfer from VRAM to CPU
 1846	40CD					WRTVDP  EQU #0047        ; Write to VDP register
 1847	40CD					WRTVRM  EQU #004D        ; Write data to VRAM (A=data, HL=address)
 1848	40CD					
 1849	40CD					; File I/O (Disk BIOS) - Not used in cartridge ROMs
 1850	40CD					; DSKIO   EQU #004A      ; Disk I/O (conflicts with WRTVRM, not available in cartridge)
 1851	40CD					; DSKCHF  EQU #004D      ; Disk change flag (same address as WRTVRM, not used)
 1852	40CD					
 1853	40CD					; Math
 1854	40CD					GETYPR  EQU #0053        ; Get type of variable
 1855	40CD					
 1856	40CD					; ==================================================================
 1857	40CD					; VDP PORTS AND REGISTERS
 1858	40CD					; ==================================================================
 1859	40CD					
 1860	40CD					; VDP Data/Status Ports
 1861	40CD					VDPDR   EQU #0098        ; VDP Data Register (Port 0)
 1862	40CD					VDPSR   EQU #0099        ; VDP Status Register (Port 1)
 1863	40CD					
 1864	40CD					; VDP Registers (use with VDPSR)
 1865	40CD					VDP_R0  EQU 0            ; Mode register 0
 1866	40CD					VDP_R1  EQU 1            ; Mode register 1
 1867	40CD					VDP_R2  EQU 2            ; Name table base address
 1868	40CD					VDP_R3  EQU 3            ; Color table base address
 1869	40CD					VDP_R4  EQU 4            ; Pattern table base address
 1870	40CD					VDP_R5  EQU 5            ; Sprite attribute table
 1871	40CD					VDP_R6  EQU 6            ; Sprite pattern table
 1872	40CD					VDP_R7  EQU 7            ; Text/border color
 1873	40CD					
 1874	40CD					; System Variables
 1875	40CD					HKEY    EQU #F3DB        ; Hook function key (system variable)
 1876	40CD					CLIKSW  EQU #F3DC        ; Key click switch
 1877	40CD					FORCLR  EQU #F3E8        ; Foreground color
 1878	40CD					BAKCLR  EQU #F3E9        ; Background color
 1879	40CD					BDRCLR  EQU #F3EA        ; Border color
 1880	40CD					isComputer50HzOr60Hz EQU #F3EB  ; System frequency flag
 1881	40CD					
 1882	40CD					; ==================================================================
 1883	40CD					; NOTE: Fast hardware access routines (FAST_LDIRVM, FAST_WRTVRM, etc.)
 1884	40CD					;       are provided by directHardwareGenerator.ts when hybrid/direct mode
 1885	40CD					;       is enabled. See directHardwareGenerator.ts for implementations.
 1886	40CD					; ==================================================================
 1887	40CD					
 1888	40CD					; ==================================================================
 1889	40CD					; END OF BIOS DEFINITIONS
 1890	40CD					; ==================================================================
 1891	40CD					
 1892	40CD					; ==================================================================
 1893	40CD					; DIRECT HARDWARE ACCESS ROUTINES
 1894	40CD					; ==================================================================
 1895	40CD					; Mode: HYBRID
 1896	40CD					; Optimize Level: safe
 1897	40CD					; Debug: DISABLED
 1898	40CD					;
 1899	40CD					; These routines provide direct hardware access for maximum performance.
 1900	40CD					; They replace BIOS calls in performance-critical sections.
 1901	40CD					;
 1902	40CD					; Performance Gains vs BIOS:
 1903	40CD					;   FAST_LDIRVM:  ~40% faster (12,288 vs 20,480 cycles for 256 bytes)
 1904	40CD					;   FAST_WRTVRM:  ~43% faster (40 vs 70 cycles)
 1905	40CD					;   FAST_WRTVDP:  ~55% faster (25 vs 55 cycles)
 1906	40CD					;   FAST_GTSTCK:  ~58% faster (50 vs 120 cycles)
 1907	40CD					;   FAST_GTTRIG:  direct trigger read (joystick button)
 1908	40CD					;   FAST_SNSMAT:  direct keyboard matrix row read
 1909	40CD					;
 1910	40CD					; Compatibility: MSX1, MSX2, MSX2+
 1911	40CD					; ==================================================================
 1912	40CD					
 1913	40CD					
 1914	40CD					; ==================================================================
 1915	40CD					; FAST_LDIRVM - Fast Block Transfer to VRAM
 1916	40CD					; ==================================================================
 1917	40CD					; Register Contract:
 1918	40CD					;   Purpose: Block copy from RAM to VRAM using VDP data port auto-increment.
 1919	40CD					;   Inputs:
 1920	40CD					;     - HL = source address (RAM)
 1921	40CD					;     - DE = destination address (VRAM)
 1922	40CD					;     - BC = byte count
 1923	40CD					;   Outputs:
 1924	40CD					;     - None
 1925	40CD					;   Clobbers:
 1926	40CD					;     - AF
 1927	40CD					;     - BC
 1928	40CD					;     - HL
 1929	40CD					;   Preserved:
 1930	40CD					;     - DE
 1931	40CD					;   Register roles:
 1932	40CD					;     - A = VDP address bytes and data byte being transferred
 1933	40CD					;     - HL = RAM read pointer (increments each byte)
 1934	40CD					;     - DE = only used to program initial VRAM address
 1935	40CD					;     - BC = countdown loop counter
 1936	40CD					;   Notes:
 1937	40CD					;     - Caller must preserve AF/BC/HL if needed after call.
 1938	40CD					
 1939	40CD					; Replaces BIOS LDIRVM with direct hardware access
 1940	40CD					;
 1941	40CD					; Input:
 1942	40CD					;   HL = Source address (RAM)
 1943	40CD					;   DE = Destination address (VRAM)
 1944	40CD					;   BC = Byte count
 1945	40CD					;
 1946	40CD					; Output:
 1947	40CD					;   None
 1948	40CD					;
 1949	40CD					; Destroys:
 1950	40CD					;   AF, BC, HL
 1951	40CD					;
 1952	40CD					; Performance:
 1953	40CD					;   ~48 cycles/byte vs BIOS ~80+ cycles/byte
 1954	40CD					;   For 256 bytes: 12,288 cycles vs 20,480+ (40% faster)
 1955	40CD					;
 1956	40CD					; Notes:
 1957	40CD					;   - Auto-increments VRAM address (VDP feature)
 1958	40CD					;   - Keeps IRQs masked for the whole transfer to avoid VDP port races
 1959	40CD					;   - Restores previous IRQ enable state on return
 1960	40CD					;   - Works on all MSX models (TMS9918, V9938, V9958)
 1961	40CD					; ==================================================================
 1962	40CD					FAST_LDIRVM:
 1963	40CD					    ; Disable interrupts during VDP port sequence to prevent ISR races.
 1964	40CD					    ; Always re-enables on exit (called from main loop where EI is guaranteed).
 1965	40CD					    ; NOTE: The old LD A,I / PUSH AF / RET PO pattern is unreliable on Z80 —
 1966	40CD					    ; an interrupt between LD A,I and PUSH AF clears P/V, skipping EI and
 1967	40CD					    ; leaving interrupts permanently disabled (next HALT locks the system).
 1968	40CD	F3				    di
 1969	40CE					
 1970	40CE					    ; Set VRAM write address
 1971	40CE	7B				    ld a, e
 1972	40CF	D3	99			    out (#99), a           ; Write address low byte to VDP
 1973	40D1	00				    nop                    ; Real VDPs need a short settle time between control writes
 1974	40D2	7A				    ld a, d
 1975	40D3	F6	40			    or #40                 ; Set bit 6 for write mode
 1976	40D5	D3	99			    out (#99), a           ; Write address high byte + write command
 1977	40D7	00				    nop                    ; Let the VDP latch the address before the first data write
 1978	40D8					
 1979	40D8					    ; Copy loop
 1980	40D8					.ldirvm_loop:
 1981	40D8	7E				    ld a, (hl)             ; Read byte from RAM (7 cycles)
 1982	40D9	D3	98			    out (#98), a           ; Write to VRAM data port (11 cycles)
 1983	40DB	23				    inc hl                 ; Next source address (6 cycles)
 1984	40DC	0B				    dec bc                 ; Decrement counter (6 cycles)
 1985	40DD	78				    ld a, b                ; Check if BC = 0 (4 cycles)
 1986	40DE	B1				    or c                   ; (4 cycles)
 1987	40DF	20	F7			    jr nz, .ldirvm_loop    ; Loop if not zero (12/7 cycles)
 1988	40E1					
 1989	40E1	FB				    ei
 1990	40E2	C9				    ret
 1991	40E3					
 1992	40E3					
 1993	40E3					; ==================================================================
 1994	40E3					; FAST_WRTVRM - Write Single Byte to VRAM
 1995	40E3					; ==================================================================
 1996	40E3					; Register Contract:
 1997	40E3					;   Purpose: Write one byte into VRAM while preserving caller-visible state.
 1998	40E3					;   Inputs:
 1999	40E3					;     - A = byte to write
 2000	40E3					;     - HL = VRAM destination address
 2001	40E3					;   Outputs:
 2002	40E3					;     - None
 2003	40E3					;   Clobbers:
 2004	40E3					;     - None (all registers preserved)
 2005	40E3					;   Preserved:
 2006	40E3					;     - AF
 2007	40E3					;     - BC
 2008	40E3					;     - DE
 2009	40E3					;     - HL
 2010	40E3					;   Register roles:
 2011	40E3					;     - A = temporarily saved/restored around VDP address programming
 2012	40E3					;     - HL = VRAM address source (not modified)
 2013	40E3					;   Notes:
 2014	40E3					;     - Safe helper when the caller cannot tolerate register changes.
 2015	40E3					
 2016	40E3					; Replaces BIOS WRTVRM
 2017	40E3					;
 2018	40E3					; Input:
 2019	40E3					;   A = Data byte to write
 2020	40E3					;   HL = VRAM destination address
 2021	40E3					;
 2022	40E3					; Output:
 2023	40E3					;   None
 2024	40E3					;
 2025	40E3					; Destroys:
 2026	40E3					;   None (all registers preserved)
 2027	40E3					;
 2028	40E3					; Performance:
 2029	40E3					;   ~40 cycles vs BIOS ~70 cycles (43% faster)
 2030	40E3					;
 2031	40E3					; Notes:
 2032	40E3					;   - Preserves all registers including AF
 2033	40E3					;   - VDP write sequence is atomic against ISR VRAM writes
 2034	40E3					; ==================================================================
 2035	40E3					FAST_WRTVRM:
 2036	40E3					    ; Preserve caller-visible state. Disable interrupts during VDP write
 2037	40E3					    ; (see FAST_LDIRVM note on why LD A,I / RET PO is unsafe).
 2038	40E3	C5				    push bc
 2039	40E4	4F				    ld c, a                ; C = input data byte
 2040	40E5	F5				    push af                ; Save caller AF
 2041	40E6	F3				    di
 2042	40E7	7D				    ld a, l
 2043	40E8	D3	99			    out (#99), a           ; Address low (11 cycles)
 2044	40EA	7C				    ld a, h
 2045	40EB	F6	40			    or #40                 ; Write mode (7 cycles)
 2046	40ED	D3	99			    out (#99), a           ; Address high + command (11 cycles)
 2047	40EF	79				    ld a, c
 2048	40F0	D3	98			    out (#98), a           ; Write to VRAM (11 cycles)
 2049	40F2	FB				    ei
 2050	40F3	F1				    pop af                 ; Restore caller AF
 2051	40F4	C1				    pop bc
 2052	40F5	C9				    ret
 2053	40F6					
 2054	40F6					
 2055	40F6					; ==================================================================
 2056	40F6					; FAST_RDVRM - Read Single Byte from VRAM
 2057	40F6					; ==================================================================
 2058	40F6					; Register Contract:
 2059	40F6					;   Purpose: Read one byte from VRAM data port.
 2060	40F6					;   Inputs:
 2061	40F6					;     - HL = VRAM source address
 2062	40F6					;   Outputs:
 2063	40F6					;     - A = byte read from VRAM
 2064	40F6					;   Clobbers:
 2065	40F6					;     - AF
 2066	40F6					;   Preserved:
 2067	40F6					;     - BC
 2068	40F6					;     - DE
 2069	40F6					;     - HL
 2070	40F6					;   Register roles:
 2071	40F6					;     - A = VDP addressing command then read result
 2072	40F6					;     - HL = address source only (unchanged)
 2073	40F6					;   Notes:
 2074	40F6					;     - Callers relying on flags must account for AF clobber.
 2075	40F6					
 2076	40F6					; Replaces BIOS RDVRM
 2077	40F6					;
 2078	40F6					; Input:
 2079	40F6					;   HL = VRAM source address
 2080	40F6					;
 2081	40F6					; Output:
 2082	40F6					;   A = Byte read from VRAM
 2083	40F6					;
 2084	40F6					; Destroys:
 2085	40F6					;   AF
 2086	40F6					;
 2087	40F6					; Performance:
 2088	40F6					;   Slower than a naive single IN, but correct on TMS9918/MSX1 because
 2089	40F6					;   VRAM reads require one dummy fetch after setting the address.
 2090	40F6					;
 2091	40F6					; Notes:
 2092	40F6					;   - Useful for collision detection, tile reading
 2093	40F6					;   - First IN primes the VDP read-ahead buffer; second IN returns the byte
 2094	40F6					; ==================================================================
 2095	40F6					FAST_RDVRM:
 2096	40F6	7D				    ld a, l
 2097	40F7	D3	99			    out (#99), a           ; Address low
 2098	40F9	7C				    ld a, h
 2099	40FA	E6	3F			    and #3F                ; Clear bit 6 for read mode (bit 7 must be 0)
 2100	40FC	D3	99			    out (#99), a           ; Address high + read command
 2101	40FE	00				    nop                    ; Let the VDP latch the read address
 2102	40FF	DB	98			    in a, (#98)            ; Dummy read: primes the TMS9918 prefetch buffer
 2103	4101	DB	98			    in a, (#98)            ; Actual byte from VRAM[HL]
 2104	4103	C9				    ret
 2105	4104					
 2106	4104					
 2107	4104					; ==================================================================
 2108	4104					; FAST_WRTVDP - Write VDP Register
 2109	4104					; ==================================================================
 2110	4104					; Register Contract:
 2111	4104					;   Purpose: Write one VDP register value (value first, then register index).
 2112	4104					;   Inputs:
 2113	4104					;     - B = register value
 2114	4104					;     - C = register number
 2115	4104					;   Outputs:
 2116	4104					;     - None
 2117	4104					;   Clobbers:
 2118	4104					;     - AF
 2119	4104					;   Preserved:
 2120	4104					;     - BC
 2121	4104					;     - DE
 2122	4104					;     - HL
 2123	4104					;   Register roles:
 2124	4104					;     - A = output staging register for both OUT operations
 2125	4104					;     - B/C = preserved input pair for value and register id
 2126	4104					;   Notes:
 2127	4104					;     - Order of writes is mandatory for VDP register writes.
 2128	4104					
 2129	4104					; Replaces BIOS WRTVDP
 2130	4104					;
 2131	4104					; Input:
 2132	4104					;   B = Register value
 2133	4104					;   C = Register number (0-7 for MSX1, 0-23 for MSX2, 0-46 for MSX2+)
 2134	4104					;
 2135	4104					; Output:
 2136	4104					;   None
 2137	4104					;
 2138	4104					; Destroys:
 2139	4104					;   AF
 2140	4104					;
 2141	4104					; Performance:
 2142	4104					;   ~25 cycles vs BIOS ~55 cycles (55% faster)
 2143	4104					;
 2144	4104					; Notes:
 2145	4104					;   - Used for mode changes, colors, scroll, etc.
 2146	4104					;   - Register write order matters: value first, then register number
 2147	4104					; ==================================================================
 2148	4104					FAST_WRTVDP:
 2149	4104	78				    ld a, b                ; Get register value (4 cycles)
 2150	4105	D3	99			    out (#99), a           ; Write value first (11 cycles)
 2151	4107	79				    ld a, c                ; Get register number (4 cycles)
 2152	4108	F6	80			    or #80                 ; Set bit 7 for register write (7 cycles)
 2153	410A	D3	99			    out (#99), a           ; Write register select (11 cycles)
 2154	410C	C9				    ret                    ; (10 cycles)
 2155	410D					                           ; Total: ~25 cycles
 2156	410D					
 2157	410D					
 2158	410D					; ==================================================================
 2159	410D					; FAST_GTSTCK - Read Joystick Direction
 2160	410D					; ==================================================================
 2161	410D					; Register Contract:
 2162	410D					;   Purpose: Read joystick direction and map PSG bits to MSX GTSTCK direction code.
 2163	410D					;   Inputs:
 2164	410D					;     - A = joystick port (0 or 1)
 2165	410D					;   Outputs:
 2166	410D					;     - A = direction code (0-8)
 2167	410D					;   Clobbers:
 2168	410D					;     - AF
 2169	410D					;     - HL
 2170	410D					;   Preserved:
 2171	410D					;     - BC
 2172	410D					;     - DE
 2173	410D					;   Register roles:
 2174	410D					;     - A = PSG register selection, raw read, and final direction code
 2175	410D					;     - HL = lookup table pointer into joystick_direction_table
 2176	410D					;   Notes:
 2177	410D					;     - Bits are active-low; routine inverts and masks input nibble.
 2178	410D					
 2179	410D					; Replaces BIOS GTSTCK (which is notoriously slow)
 2180	410D					;
 2181	410D					; Input:
 2182	410D					;   A = Joystick port (0 = port 1, 1 = port 2)
 2183	410D					;
 2184	410D					; Output:
 2185	410D					;   A = Direction code (0-8)
 2186	410D					;       0 = Center (no direction)
 2187	410D					;       1 = Up
 2188	410D					;       2 = Up + Right
 2189	410D					;       3 = Right
 2190	410D					;       4 = Down + Right
 2191	410D					;       5 = Down
 2192	410D					;       6 = Down + Left
 2193	410D					;       7 = Left
 2194	410D					;       8 = Up + Left
 2195	410D					;
 2196	410D					; Destroys:
 2197	410D					;   AF, HL
 2198	410D					;
 2199	410D					; Performance:
 2200	410D					;   ~50 cycles vs BIOS ~120+ cycles (58% faster)
 2201	410D					;
 2202	410D					; Notes:
 2203	410D					;   - Reads from PSG register 14 (port 1) or 15 (port 2)
 2204	410D					;   - Joystick bits are active-low (inverted)
 2205	410D					;   - Uses lookup table for direction decoding
 2206	410D					; ==================================================================
 2207	410D					FAST_GTSTCK:
 2208	410D					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 2209	410D	0F				    rrca                   ; A = A / 2 (joystick port becomes 0 or 8)
 2210	410E	E6	0F			    and #0F                ; Mask to valid range
 2211	4110	F6	0E			    or #0E                 ; Add 14 (base register for joystick)
 2212	4112					
 2213	4112					    ; Make PSG select+read atomic so VBlank music writes cannot
 2214	4112					    ; corrupt the selected register mid-access.
 2215	4112	F3				    di
 2216	4113	D3	A0			    out (#A0), a           ; Write register number to PSG address port
 2217	4115	DB	A2			    in a, (#A2)            ; Read value from PSG data port
 2218	4117	FB				    ei
 2219	4118					
 2220	4118					    ; Process joystick data
 2221	4118	2F				    cpl                    ; Invert bits (joystick is active-low)
 2222	4119	E6	0F			    and #0F                ; Mask to 4 direction bits (Up, Down, Left, Right)
 2223	411B					
 2224	411B					    ; Lookup direction code from table
 2225	411B	21	25	41		    ld hl, joystick_direction_table
 2226	411E	85				    add a, l               ; Add offset to table base
 2227	411F	6F				    ld l, a
 2228	4120	8C				    adc a, h               ; Handle carry if table crosses page boundary
 2229	4121	95				    sub l
 2230	4122	67				    ld h, a
 2231	4123	7E				    ld a, (hl)             ; Get direction code (0-8)
 2232	4124	C9				    ret
 2233	4125					
 2234	4125					; Direction lookup table (16 entries for all 4-bit combinations)
 2235	4125					; MSX PSG register 14 joystick bit order:
 2236	4125					;   Bit 0 = Up    (0001)
 2237	4125					;   Bit 1 = Down  (0010)
 2238	4125					;   Bit 2 = Left  (0100)
 2239	4125					;   Bit 3 = Right (1000)
 2240	4125					; Value: GTSTCK-compatible direction code (0-8)
 2241	4125					joystick_direction_table:
 2242	4125	00				    db 0  ; 0000 = Center
 2243	4126	01				    db 1  ; 0001 = Up
 2244	4127	05				    db 5  ; 0010 = Down
 2245	4128	00				    db 0  ; 0011 = Up+Down (invalid)
 2246	4129	07				    db 7  ; 0100 = Left
 2247	412A	08				    db 8  ; 0101 = Up+Left
 2248	412B	06				    db 6  ; 0110 = Down+Left
 2249	412C	00				    db 0  ; 0111 = Invalid
 2250	412D	03				    db 3  ; 1000 = Right
 2251	412E	02				    db 2  ; 1001 = Up+Right
 2252	412F	04				    db 4  ; 1010 = Down+Right
 2253	4130	00				    db 0  ; 1011 = Invalid
 2254	4131	00				    db 0  ; 1100 = Left+Right (invalid)
 2255	4132	00				    db 0  ; 1101 = Invalid
 2256	4133	00				    db 0  ; 1110 = Invalid
 2257	4134	00				    db 0  ; 1111 = All directions (invalid)
 2258	4135					
 2259	4135					
 2260	4135					; ==================================================================
 2261	4135					; FAST_GTTRIG - Read Joystick Trigger
 2262	4135					; ==================================================================
 2263	4135					; Register Contract:
 2264	4135					;   Purpose: Read joystick trigger bit directly from PSG register.
 2265	4135					;   Inputs:
 2266	4135					;     - A = joystick port (0 or 1)
 2267	4135					;   Outputs:
 2268	4135					;     - A = #FF if pressed, #00 if released
 2269	4135					;   Clobbers:
 2270	4135					;     - AF
 2271	4135					;   Preserved:
 2272	4135					;     - BC
 2273	4135					;     - DE
 2274	4135					;     - HL
 2275	4135					;   Register roles:
 2276	4135					;     - A = register select, raw PSG read, and normalized return value
 2277	4135					;   Notes:
 2278	4135					;     - Trigger is active-low in PSG bit 4.
 2279	4135					
 2280	4135					; Direct hardware replacement for BIOS GTTRIG
 2281	4135					;
 2282	4135					; Input:
 2283	4135					;   A = Joystick port (0 = port 1, 1 = port 2)
 2284	4135					;
 2285	4135					; Output:
 2286	4135					;   A = #FF if pressed, 0 if released
 2287	4135					;
 2288	4135					; Destroys:
 2289	4135					;   AF
 2290	4135					;
 2291	4135					; Notes:
 2292	4135					;   - Reads PSG register 14/15 directly
 2293	4135					;   - Trigger bit is active-low
 2294	4135					; ==================================================================
 2295	4135					FAST_GTTRIG:
 2296	4135					    ; Calculate PSG register: 14 (port 1) or 15 (port 2)
 2297	4135	0F				    rrca
 2298	4136	E6	0F			    and #0F
 2299	4138	F6	0E			    or #0E
 2300	413A					
 2301	413A					    ; Make PSG select+read atomic so VBlank music writes cannot
 2302	413A					    ; corrupt the selected register mid-access.
 2303	413A	F3				    di
 2304	413B	D3	A0			    out (#A0), a
 2305	413D	DB	A2			    in a, (#A2)
 2306	413F	FB				    ei
 2307	4140					
 2308	4140					    ; Trigger bit (bit 4): 0 when pressed, 1 when released
 2309	4140	E6	10			    and #10
 2310	4142	3E	00			    ld a, #00
 2311	4144	C0				    ret nz
 2312	4145	3E	FF			    ld a, #FF
 2313	4147	C9				    ret
 2314	4148					
 2315	4148					
 2316	4148					; ==================================================================
 2317	4148					; FAST_SNSMAT - Sense Keyboard Matrix Row
 2318	4148					; ==================================================================
 2319	4148					; Register Contract:
 2320	4148					;   Purpose: Select keyboard matrix row via PPI and return row state.
 2321	4148					;   Inputs:
 2322	4148					;     - A = matrix row (0-11)
 2323	4148					;   Outputs:
 2324	4148					;     - A = row bits (active-low)
 2325	4148					;   Clobbers:
 2326	4148					;     - AF
 2327	4148					;     - C
 2328	4148					;   Preserved:
 2329	4148					;     - B
 2330	4148					;     - DE
 2331	4148					;     - HL
 2332	4148					;   Register roles:
 2333	4148					;     - A = row selector composition and final row read
 2334	4148					;     - C = cached low nibble used to build PPI port C output
 2335	4148					;   Notes:
 2336	4148					;     - Upper nibble of current PPI port C is preserved.
 2337	4148					
 2338	4148					; Direct hardware replacement for BIOS SNSMAT
 2339	4148					;
 2340	4148					; Input:
 2341	4148					;   A = row (0-11)
 2342	4148					;
 2343	4148					; Output:
 2344	4148					;   A = row bits (active-low, 0=pressed)
 2345	4148					;
 2346	4148					; Destroys:
 2347	4148					;   AF, C
 2348	4148					; ==================================================================
 2349	4148					FAST_SNSMAT:
 2350	4148	E6	0F			    and #0F                 ; Keep valid row bits
 2351	414A	4F				    ld c, a
 2352	414B	DB	AA			    in a, (#AA)             ; Read current PPI port C
 2353	414D	E6	F0			    and #F0                 ; Preserve upper nibble
 2354	414F	B1				    or c                    ; Set keyboard row in lower nibble
 2355	4150	D3	AA			    out (#AA), a            ; Select row
 2356	4152	DB	A9			    in a, (#A9)             ; Read keyboard matrix row
 2357	4154	C9				    ret
 2358	4155					
 2359	4155					
 2360	4155					; ==================================================================
 2361	4155					; END OF DIRECT HARDWARE ROUTINES
 2362	4155					; ==================================================================
