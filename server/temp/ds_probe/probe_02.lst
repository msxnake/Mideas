 24678	A000					; ##################################################################
 24679	A000					; FAR BANK 9 — [#A000h-#C000h] FAR CODE: animtiles
 24680	A000					; Accessed ONLY via trampolines in bank 0 (entrypoint_far labels).
 24681	A000					; At runtime: bank0 saves P3, maps bank9 to P3,
 24682	A000					; calls routine, then restores P3.
