 17265	A54C					; ------------------------------------------------------------------
 17266	A54C					; Shared helper: Print string to VRAM
 17267	A54C					; Input: HL = string pointer (null-terminated)
 17268	A54C					;        DE = VRAM destination
 17269	A54C					; ------------------------------------------------------------------
 17270	A54C					print_string_vram:
 17271	A54C	C5				    push bc
 17272	A54D	D5				    push de
 17273	A54E	E5				    push hl
 17274	A54F					
 17275	A54F					.psv_loop:
 17276	A54F	7E				    ld a, (hl)                    ; Get character
 17277	A550	B7				    or a                          ; Check for null terminator
 17278	A551	28	0C			    jr z, .psv_done
 17279	A553					
 17280	A553					    ; Write character to VRAM
 17281	A553	E5				    push hl
 17282	A554	D5				    push de
 17283	A555	EB				    ex de, hl                     ; HL = VRAM address (from DE)
 17284	A556	CD	E3	40		    call FAST_WRTVRM              ; Write A to VRAM at HL (direct port)
 17285	A559	D1				    pop de
 17286	A55A	E1				    pop hl
 17287	A55B					
 17288	A55B	23				    inc hl                        ; Next character
 17289	A55C	13				    inc de                        ; Next VRAM position
 17290	A55D	18	F0			    jr .psv_loop
 17291	A55F					
 17292	A55F					.psv_done:
 17293	A55F	E1				    pop hl
 17294	A560	D1				    pop de
 17295	A561	C1				    pop bc
 17296	A562	C9				    ret
