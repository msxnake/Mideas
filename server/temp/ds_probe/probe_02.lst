 3021	4155					PT3_PSP         EQU #E9ED   ; PT3 stack pointer save
 3022	4155					PT3_PrNote      EQU #E9EF   ; Previous note
 3023	4155					PT3_PrSlide     EQU #E9F0   ; Previous slide (2 bytes)
 3024	4155					PT3_AdInPtA     EQU #E9F2   ; Channel A inline pointer
 3025	4155					PT3_AdInPtB     EQU #E9F4   ; Channel B inline pointer
 3026	4155					PT3_AdInPtC     EQU #E9F6   ; Channel C inline pointer
 3027	4155					PT3_LPosPtr     EQU #E9F8   ; Loop position pointer
 3028	4155					PT3_PatsPtr     EQU #E9FA   ; Patterns table pointer
 3029	4155					PT3_Delay       EQU #E9FC   ; Song speed/delay
 3030	4155					PT3_AddToEn     EQU #E9FD   ; Add to envelope
 3031	4155					PT3_Env_Del     EQU #E9FE   ; Envelope delay
 3032	4155					PT3_ESldAdd     EQU #E9FF   ; Envelope slide add (2 bytes)
 3033	4155					PT3_NTL3        EQU #EA01   ; Note table link 3
 3034	4155					VARS            EQU #EA03   ; Channel vars base
 3035	4155					ChanA           EQU #EA03   ; Channel A data (29 bytes)
 3036	4155					ChanB           EQU #EA20   ; Channel B data (29 bytes)
 3037	4155					ChanC           EQU #EA3D   ; Channel C data (29 bytes)
 3038	4155					DelyCnt         EQU #EA5A   ; Delay counter
 3039	4155					CurESld         EQU #EA5B   ; Current envelope slide (2 bytes)
 3040	4155					CurEDel         EQU #EA5D   ; Current envelope delay
 3041	4155					Ns_Base_AddToNs EQU #EA5E   ; Noise base + add to noise (combined)
 3042	4155					Ns_Base         EQU #EA5E   ; Noise base
 3043	4155					AddToNs         EQU #EA5F   ; Add to noise
 3044	4155					NT_             EQU #EA60   ; Note table (192 bytes)
 3045	4155					AYREGS          EQU #EB20  ; AY registers mirror (14 bytes)
 3046	4155					VT_             EQU #EB20  ; Volume table base (alias for AYREGS)
 3047	4155					EnvBase         EQU #EB2E  ; Envelope base
 3048	4155					VAR0END         EQU #EB30  ; End of fixed workspace
 3049	4155					T1_             EQU #EB30  ; Tone tables start (unpacked by PT3_INIT)
 3050	4155					T_NEW_1         EQU #EB30  ; Tone table new 1
 3051	4155					T_OLD_1         EQU #EB30  ; Tone table old 1
 3052	4155					T_OLD_2         EQU #EB48  ; Tone table old 2
 3053	4155					T_NEW_3         EQU #EB60  ; Tone table new 3
 3054	4155					T_OLD_3         EQU #EB60  ; Tone table old 3
 3055	4155					T_OLD_0         EQU #EB62  ; Tone table old 0
