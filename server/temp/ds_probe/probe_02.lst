 24357	818E					; ==================================================================
 24358	818E					; PT3 MUSIC BACKEND
 24359	818E					; Uses the PT3 replayer for AY-3-8910 music playback.
 24360	818E					; PT3_SETUP, ChanA, AYREGS, etc. are defined in variables.asm.
 24361	818E					; ==================================================================
 24362	818E					
 24363	818E					; ------------------------------------------------------------------
 24364	818E					; music_init_system
 24365	818E					; Reset PT3 music state. Call once at startup.
 24366	818E					; Destroys: AF
 24367	818E					; ------------------------------------------------------------------
 24368	818E					music_init_system:
 24369	818E	AF				    xor a
 24370	818F	32	B9	E9		    ld (music_active), a
 24371	8192	32	BA	E9		    ld (music_muted), a
 24372	8195	32	BB	E9		    ld (music_loop), a
 24373	8198	32	BC	E9		    ld (music_track_index), a
 24374	819B	32	E0	E9		    ld (PT3_SETUP), a
 24375	819E	C9				    ret
 24376	819F					
 24377	819F					; ------------------------------------------------------------------
 24378	819F					; music_silence_channels
 24379	819F					; Silence all AY channels via BIOS WRTPSG.
 24380	819F					; Destroys: AF, E
 24381	819F					; ------------------------------------------------------------------
 24382	819F					music_silence_channels:
 24383	819F	AF				    xor a
 24384	81A0	47				    ld b, a
 24385	81A1	CD	47	80		    call psg_set_volume     ; Channel A vol=0
 24386	81A4	3E	01			    ld a, 1
 24387	81A6	06	00			    ld b, 0
 24388	81A8	CD	47	80		    call psg_set_volume     ; Channel B vol=0
 24389	81AB	3E	02			    ld a, 2
 24390	81AD	06	00			    ld b, 0
 24391	81AF	CD	47	80		    call psg_set_volume     ; Channel C vol=0
 24392	81B2	3E	07			    ld a, PSG_MIXER
 24393	81B4	1E	3F			    ld e, #3F
 24394	81B6	CD	93	00		    call WRTPSG             ; All tones+noise off
 24395	81B9	C9				    ret
 24396	81BA					
 24397	81BA					; ------------------------------------------------------------------
 24398	81BA					; music_stop
 24399	81BA					; Stop music and silence channels.
 24400	81BA					; Destroys: AF
 24401	81BA					; ------------------------------------------------------------------
 24402	81BA					music_stop:
 24403	81BA	F5				    push af
 24404	81BB	AF				    xor a
 24405	81BC	32	B9	E9		    ld (music_active), a
 24406	81BF	32	E0	E9		    ld (PT3_SETUP), a
 24407	81C2	CD	9F	81		    call music_silence_channels
 24408	81C5	F1				    pop af
 24409	81C6	C9				    ret
