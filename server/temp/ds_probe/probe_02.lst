 17249	A537	3E	01			    ld a, 1
 17250	A539	32	6C	DC		    ld (hud_dirty_flag), a
 17251	A53C	CD	81	4C		    call call_render_hud_resident
 17252	A53F					.gf_worldlink_hud_skip:
