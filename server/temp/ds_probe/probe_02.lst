 12591	7F01					; ==================================================================
 12592	7F01					; TILE COLLISION SYSTEM
 12593	7F01					; ==================================================================
 12594	7F01					; Provides functions for checking collision with background tiles
 12595	7F01					; Uses behavior maps generated from screen collision layers
 12596	7F01					; ==================================================================
 12597	7F01					
 12598	7F01					; ------------------------------------------------------------------
 12599	7F01					; get_tile_at_position
 12600	7F01					; Convert pixel coordinates to tile coordinates and get tile ID
 12601	7F01					; Input:  D = X position (pixels), E = Y position (pixels)
 12602	7F01					; Output: A = Tile ID at that position, Z flag set if out of bounds
 12603	7F01					; Destroys: BC, HL
 12604	7F01					; ------------------------------------------------------------------
 12605	7F01					get_tile_at_position:
 12606	7F01					    ; Convert X pixel to tile column (divide by 8 - MSX Screen 2 character cell)
 12607	7F01					    ; Screen layout is ALWAYS 32x24 grid of 8x8 cells regardless of project tile size
 12608	7F01	7A				    ld a, d
 12609	7F02	CB	3F			    srl a
 12610	7F04	CB	3F			    srl a
 12611	7F06	CB	3F			    srl a                         ; A = X / 8 = tile column
 12612	7F08	47				    ld b, a                       ; B = tile column
 12613	7F09					
 12614	7F09					    ; Convert Y pixel to tile row (divide by 8 - MSX Screen 2 character cell)
 12615	7F09	7B				    ld a, e
 12616	7F0A	CB	3F			    srl a
 12617	7F0C	CB	3F			    srl a
 12618	7F0E	CB	3F			    srl a                         ; A = Y / 8 = tile row
 12619	7F10	4F				    ld c, a                       ; C = tile row
 12620	7F11					
 12621	7F11					    ; Check bounds (assume 32x24 tile screen for now)
 12622	7F11	78				    ld a, b
 12623	7F12	FE	20			    cp 32
 12624	7F14	30	27			    jr nc, .out_of_bounds
 12625	7F16	79				    ld a, c
 12626	7F17	FE	18			    cp 24
 12627	7F19	30	22			    jr nc, .out_of_bounds
 12628	7F1B					
 12629	7F1B					    ; Calculate tile index: index = row * 32 + column (16-bit to avoid overflow)
 12630	7F1B	69				    ld l, c
 12631	7F1C	26	00			    ld h, 0                       ; HL = row (16-bit)
 12632	7F1E	29				    add hl, hl                    ; HL = row * 2
 12633	7F1F	29				    add hl, hl                    ; HL = row * 4
 12634	7F20	29				    add hl, hl                    ; HL = row * 8
 12635	7F21	29				    add hl, hl                    ; HL = row * 16
 12636	7F22	29				    add hl, hl                    ; HL = row * 32
 12637	7F23	58				    ld e, b
 12638	7F24	16	00			    ld d, 0
 12639	7F26	19				    add hl, de                    ; HL = row * 32 + column
