 25565	C000					; ##################################################################
 25566	C000					; FAR BANK 10 — [#6000h-#8000h] FAR CODE: hud
 25567	C000					; Accessed ONLY via trampolines in bank 0 (entrypoint_far labels).
 25568	C000					; At runtime: bank0 saves P1, maps bank10 to P1,
 25569	C000					; calls routine, then restores P1.
 25570	C000					; NOTE: routines in this bank MUST only call code in bank 0 or
 25571	C000					;       primary banks (1-3). No far-to-far calls allowed.
 25572	C000					; ##################################################################
 25573	C000					    org #6000
 25574	6000					
 25575	6000					; ==================================================================
 25576	6000					; HUD SYSTEM - Screen 2 Text Rendering
 25577	6000					; ==================================================================
 25578	6000					; Total HUD Elements: 5
 25579	6000					; Screens with HUD: 1
 25580	6000					;
 25581	6000					; HUD Elements use TileBank fonts to render text in Screen 2 mode
 25582	6000					; Each element can be positioned anywhere on screen (256x192 pixels)
 25583	6000					; ==================================================================
 25584	6000					
 25585	6000					; ------------------------------------------------------------------
 25586	6000					; HUD DATA STRUCTURES
 25587	6000					; ------------------------------------------------------------------
 25588	6000					
 25589	6000					HUD_ELEMENT_COUNT   EQU 5
 25590	6000					
 25591	6000					; HUD Element Data Table
 25592	6000					; Format: [Type:1][X:1][Y:1][Width:1][Height:1][Flags:1][TextPtr:2][Visible:1]
 25593	6000					hud_element_data:
 25594	6000	01	00	08		    DB 1, 0, 8    ; Element 0: Score at (0,8)
 25595	6003	0B	01	00		    DB 11, 1, 0 ; W, H, Flags
 25596	6006	2D	60			    DW hud_text_0             ; Text pointer
 25597	6008	01				    DB 1                ; Visible
 25598	6009	03	68	08		    DB 3, 104, 8    ; Element 1: Lives at (104,8)
 25599	600C	01	01	00		    DB 1, 1, 0 ; W, H, Flags
 25600	600F	39	60			    DW hud_text_1             ; Text pointer
 25601	6011	01				    DB 1                ; Visible
 25602	6012	06	C0	08		    DB 6, 192, 8    ; Element 2: SceneName at (192,8)
 25603	6015	07	01	00		    DB 7, 1, 0 ; W, H, Flags
 25604	6018	3B	60			    DW hud_text_2             ; Text pointer
 25605	601A	01				    DB 1                ; Visible
 25606	601B	0E	80	08		    DB 14, 128, 8    ; Element 3: CustomCounter at (128,8)
 25607	601E	02	01	00		    DB 2, 1, 0 ; W, H, Flags
 25608	6021	43	60			    DW hud_text_3             ; Text pointer
 25609	6023	01				    DB 1                ; Visible
 25610	6024	0E	A0	08		    DB 14, 160, 8    ; Element 4: CustomCounter at (160,8)
 25611	6027	02	01	00		    DB 2, 1, 0 ; W, H, Flags
 25612	602A	46	60			    DW hud_text_4             ; Text pointer
 25613	602C	01				    DB 1                ; Visible
 25614	602D					
 25615	602D					; HUD Text Strings
 25616	602D					hud_text_0:
 25617	602D	53	43	4F	52	45	20	30	30	30	30	30	00	    DB "SCORE 00000", 0
 25618	6039					hud_text_1:
 25619	6039	33	00			    DB "3", 0
 25620	603B					hud_text_2:
 25621	603B	53	54	41	47	45	20	31	00	    DB "STAGE 1", 0
 25622	6043					hud_text_3:
 25623	6043	30	30	00		    DB "00", 0
 25624	6046					hud_text_4:
 25625	6046	30	30	00		    DB "00", 0
