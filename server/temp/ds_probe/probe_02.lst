 24221	80FE	CD	55	80		    call psg_set_mixer
 24222	8101					
 24223	8101	C9				    ret
 24224	8102					
 24225	8102					; ==================================================================
 24226	8102					; SOUND EFFECT PLAYBACK SYSTEM
 24227	8102					; ==================================================================
 24228	8102					; This section provides a simple sound effect manager that can
 24229	8102					; play effects with automatic duration and fadeout
 24230	8102					
 24231	8102					; Runtime state lives in variables.asm:
 24232	8102					;   sfx_active, sfx_timer, sfx_fadeout
 24233	8102					
 24234	8102					; ------------------------------------------------------------------
 24235	8102					; play_sound_effect
 24236	8102					; Play one of the built-in sound effects by ID
 24237	8102					; Input:  A = sound ID
 24238	8102					;         0=beep, 1=jump, 2=shoot, 3=explosion, 4=coin, 5=damage
 24239	8102					; Destroys: AF, BC, DE, HL
 24240	8102					; ------------------------------------------------------------------
 24241	8102					play_sound_effect:
 24242	8102	3A	B9	E9		    ld a, (music_active)
 24243	8105	B7				    or a
 24244	8106	C0				    ret nz
 24245	8107	FE	01			    cp 1
 24246	8109	CA	29	81		    jp z, play_sound_effect_jump
 24247	810C	FE	02			    cp 2
 24248	810E	CA	32	81		    jp z, play_sound_effect_shoot
 24249	8111	FE	03			    cp 3
 24250	8113	CA	3B	81		    jp z, play_sound_effect_explosion
 24251	8116	FE	04			    cp 4
 24252	8118	CA	44	81		    jp z, play_sound_effect_coin
 24253	811B	FE	05			    cp 5
 24254	811D	CA	4D	81		    jp z, play_sound_effect_damage
 24255	8120					
 24256	8120					play_sound_effect_beep:
 24257	8120	21	8C	80		    ld hl, sfx_beep
 24258	8123	06	05			    ld b, SFX_SHORT
 24259	8125	CD	56	81		    call sfx_play
 24260	8128	C9				    ret
 24261	8129					
 24262	8129					play_sound_effect_jump:
 24263	8129	21	9F	80		    ld hl, sfx_jump
 24264	812C	06	05			    ld b, SFX_SHORT
 24265	812E	CD	56	81		    call sfx_play
 24266	8131	C9				    ret
 24267	8132					
 24268	8132					play_sound_effect_shoot:
 24269	8132	21	B2	80		    ld hl, sfx_shoot
 24270	8135	06	05			    ld b, SFX_SHORT
 24271	8137	CD	56	81		    call sfx_play
 24272	813A	C9				    ret
 24273	813B					
 24274	813B					play_sound_effect_explosion:
 24275	813B	21	CA	80		    ld hl, sfx_explosion
 24276	813E	06	0F			    ld b, SFX_MEDIUM
 24277	8140	CD	56	81		    call sfx_play
 24278	8143	C9				    ret
 24279	8144					
 24280	8144					play_sound_effect_coin:
 24281	8144	21	DB	80		    ld hl, sfx_coin
 24282	8147	06	05			    ld b, SFX_SHORT
 24283	8149	CD	56	81		    call sfx_play
 24284	814C	C9				    ret
 24285	814D					
 24286	814D					play_sound_effect_damage:
 24287	814D	21	F0	80		    ld hl, sfx_damage
 24288	8150	06	05			    ld b, SFX_SHORT
 24289	8152	CD	56	81		    call sfx_play
 24290	8155	C9				    ret
 24291	8156					
 24292	8156					; ------------------------------------------------------------------
 24293	8156					; sfx_play
 24294	8156					; Play a sound effect with duration
 24295	8156					; Input:  HL = Sound effect function address
 24296	8156					;         B = Duration in frames
 24297	8156					; ------------------------------------------------------------------
 24298	8156					sfx_play:
 24299	8156	3A	B9	E9		    ld a, (music_active)
 24300	8159	B7				    or a
 24301	815A	C0				    ret nz
 24302	815B					    ; Call the sound effect function
 24303	815B	C5				    push bc
 24304	815C	E5				    push hl
 24305	815D	11	62	81		    ld de, .return_address
 24306	8160	D5				    push de
 24307	8161	E9				    jp (hl)                      ; Indirect call
 24308	8162					.return_address:
 24309	8162	E1				    pop hl
 24310	8163	C1				    pop bc
 24311	8164					
 24312	8164					    ; Set timer
 24313	8164	78				    ld a, b
 24314	8165	32	5A	E5		    ld (sfx_timer), a
 24315	8168					
 24316	8168					    ; Mark as active
 24317	8168	3E	01			    ld a, 1
 24318	816A	32	59	E5		    ld (sfx_active), a
