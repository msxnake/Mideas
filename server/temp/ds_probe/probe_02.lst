 17219	A508	3E	01			    ld a, FLOW_STATE_GAME
 17220	A50A	32	05	C0		    ld (current_flow_state), a
 17221	A50D					
 17222	A50D					    ; Sync SAT patterns using the slot table just filled by load_world.
 17223	A50D					    ; force_update_entity_sprite (called during init_entities) ran before
 17224	A50D					    ; load_sprite_patterns, so sprite_asset_base_pattern_slot_runtime was
 17225	A50D					    ; all zeros then.  Calling update_sprite_component here recomputes the
 17226	A50D					    ; correct slot->pattern mapping for all entities in the render list
 17227	A50D					    ; so the very first update_sprites_to_vram below writes the right data.
 17228	A50D	CD	19	61		    call update_sprite_component
