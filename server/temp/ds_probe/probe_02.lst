 18716	6124					
 18717	6124					; Helper: Copy rectangular area from screen layout (RAM) to Name Table (VRAM)
 18718	6124					; Input: HL = source in RAM
 18719	6124					;        DE = destination in VRAM
 18720	6124					;        A  = number of rows
 18721	6124					;        C  = bytes per row (width)
 18722	6124					copy_layout_rect_to_vram:
 18723	6124	B7				    or a
 18724	6125	C8				    ret z
 18725	6126	47				    ld b, a
 18726	6127	79				    ld a, c
 18727	6128	B7				    or a
 18728	6129	C8				    ret z
 18729	612A	78				    ld a, b
 18730	612B					
 18731	612B					.copy_rect_row_loop:
 18732	612B	F5				    push af
 18733	612C	C5				    push bc
 18734	612D	E5				    push hl
 18735	612E	D5				    push de
 18736	612F	06	00			    ld b, 0
 18737	6131	CD	CD	40		    call FAST_LDIRVM
 18738	6134	D1				    pop de
 18739	6135	E1				    pop hl
 18740	6136	C1				    pop bc
 18741	6137	F1				    pop af
 18742	6138					
 18743	6138	3D				    dec a
 18744	6139	C8				    ret z
 18745	613A					    ; HL/DE were restored by push/pop, so advance a full row (32 bytes)
 18746	613A	C5				    push bc
 18747	613B	01	20	00		    ld bc, 32
 18748	613E	09				    add hl, bc
 18749	613F	EB				    ex de, hl
