 8708	6C7C					    ; PLATFORM RIDING SYSTEM
 8709	6C7C					    ; ==================================================================
 8710	6C7C					    ; Detects when entities are standing on platforms and transfers velocity
 8711	6C7C					    ;
 8712	6C7C					    ; Platform detection: Entity A is on platform B if:
 8713	6C7C					    ; - A's bottom edge is at or near B's top edge
 8714	6C7C					    ; - A has horizontal overlap with B
 8715	6C7C					    ; - B has collision_layer bit 3 set (platform layer = 8)
 8716	6C7C					    ;
 8717	6C7C					    ; Grace frames: 6 frames tolerance when leaving platform
 8718	6C7C					
 8719	6C7C					init_platform_riding_system:
 8720	6C7C					    ; Initialize platform IDs to 255 (no platform)
 8721	6C7C	21	7C	E6		    ld hl, entity_platform_id
 8722	6C7F	11	7D	E6		    ld de, entity_platform_id + 1
 8723	6C82	01	1F	00		    ld bc, 31
 8724	6C85	36	FF			    ld (hl), 255
 8725	6C87	ED	B0			    ldir
 8726	6C89					
 8727	6C89					    ; Initialize grace frames to 0
 8728	6C89	21	9C	E6		    ld hl, entity_platform_grace
 8729	6C8C	11	9D	E6		    ld de, entity_platform_grace + 1
 8730	6C8F	01	1F	00		    ld bc, 31
 8731	6C92	36	00			    ld (hl), 0
 8732	6C94	ED	B0			    ldir
 8733	6C96	C9				    ret
