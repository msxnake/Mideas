 6845	649B					        ; ==================================================================
 6846	649B					; COLLISION HELPER FUNCTIONS(Critical for Gameplay Parity)
 6847	649B					        ; ==================================================================
 6848	649B					
 6849	649B					; ------------------------------------------------------------------
 6850	649B					; coll_add_signed_offset_clamped
 6851	649B					; Input:  A = base coordinate (0..255)
 6852	649B					;         HL = pointer to signed offset byte (-128..127, two's complement)
 6853	649B					; Output: A = clamped (base + offset), saturated to 0..255
 6854	649B					; Clobbers: B
 6855	649B					; ------------------------------------------------------------------
 6856	649B					coll_add_signed_offset_clamped:
 6857	649B	46				    ld b, (hl)                    ; B = signed offset byte
 6858	649C	80				    add a, b                      ; A = base + offset (wrapped)
 6859	649D	CB	78			    bit 7, b
 6860	649F	28	04			    jr z, .casc_positive
 6861	64A1					    ; Negative offset: carry=0 means underflow (wrapped below 0)
 6862	64A1	38	06			    jr c, .casc_done
 6863	64A3	AF				    xor a                         ; Clamp to 0
 6864	64A4	C9				    ret
 6865	64A5					.casc_positive:
 6866	64A5					    ; Positive offset: carry=1 means overflow (wrapped above 255)
 6867	64A5	30	02			    jr nc, .casc_done
 6868	64A7	3E	FF			    ld a, 255                     ; Clamp to 255
 6869	64A9					.casc_done:
 6870	64A9	C9				    ret
 6871	64AA					
 6872	64AA					; ------------------------------------------------------------------
 6873	64AA					; coll_flags_from_layer
 6874	64AA					; Input:  A = collision layer bitmask of the other entity
 6875	64AA					; Output: A = collision event flags (entity/enemy/item)
 6876	64AA					; Clobbers: B, C
 6877	64AA					; ------------------------------------------------------------------
 6878	64AA					coll_flags_from_layer:
 6879	64AA	47				    ld b, a
 6880	64AB	0E	01			    ld c, COLLISION_EVENT_ENTITY
 6881	64AD					
 6882	64AD	78				    ld a, b
 6883	64AE	E6	02			    and COLLISION_LAYER_ENEMY
 6884	64B0	28	04			    jr z, .cffl_no_enemy
 6885	64B2	79				    ld a, c
 6886	64B3	F6	02			    or COLLISION_EVENT_ENEMY
 6887	64B5	4F				    ld c, a
 6888	64B6					.cffl_no_enemy:
 6889	64B6	78				    ld a, b
 6890	64B7	E6	10			    and COLLISION_LAYER_ITEM
 6891	64B9	28	04			    jr z, .cffl_done
 6892	64BB	79				    ld a, c
 6893	64BC	F6	04			    or COLLISION_EVENT_ITEM
 6894	64BE	4F				    ld c, a
