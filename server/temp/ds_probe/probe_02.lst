 24322	816E					; ------------------------------------------------------------------
 24323	816E					; sfx_update
 24324	816E					; Update sound effect system (call every frame)
 24325	816E					; Handles automatic fadeout and silence
 24326	816E					; ------------------------------------------------------------------
 24327	816E					sfx_update:
 24328	816E	3A	B9	E9		    ld a, (music_active)
 24329	8171	B7				    or a
 24330	8172	C0				    ret nz
 24331	8173					    ; Check if sound is active
 24332	8173	3A	59	E5		    ld a, (sfx_active)
 24333	8176	B7				    or a
 24334	8177	C8				    ret z                        ; No active sound
 24335	8178					
 24336	8178					    ; Decrement timer
 24337	8178	3A	5A	E5		    ld a, (sfx_timer)
 24338	817B	B7				    or a
 24339	817C	28	08			    jr z, .silence_now
 24340	817E					
 24341	817E	3D				    dec a
 24342	817F	32	5A	E5		    ld (sfx_timer), a
 24343	8182					
 24344	8182					    ; Check if entering fadeout zone (last 5 frames)
 24345	8182	FE	05			    cp 5
 24346	8184	D0				    ret nc                       ; Still in main sound
 24347	8185					
 24348	8185					    ; TODO: Implement volume fadeout here
 24349	8185	C9				    ret
 24350	8186					
 24351	8186					.silence_now:
 24352	8186	CD	72	80		    call sfx_silence_all
 24353	8189	AF				    xor a
 24354	818A	32	59	E5		    ld (sfx_active), a
 24355	818D	C9				    ret
