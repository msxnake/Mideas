 3016	4155					PT3_CrPsPtr     EQU #E9E3   ; Current position pointer
 3017	4155					PT3_SAMPTRS     EQU #E9E5   ; Sample pointers base
 3018	4155					PT3_OrnPtrs     EQU #E9E7   ; Ornament pointers base
 3019	4155					PT3_PDSP        EQU #E9E9   ; Pattern data start pointer
