 2404	4155					; Project-specific tile dimensions detected:
 2405	4155					; Tile 0: rajol1 = 16x16px (2x2 MSX chars)
 2406	4155					; Tile 1: senefa1 = 8x8px (1x1 MSX chars)
 2407	4155					; Tile 2: corda = 8x8px (1x1 MSX chars)
 2408	4155					; Tile 3: gema = 8x8px (1x1 MSX chars)
 2409	4155					; Tile 4: gema_f0 = 8x8px (1x1 MSX chars)
 2410	4155					; Tile 5: rajola = 8x8px (1x1 MSX chars)
 2411	4155					; Tile 6: rajol_terra5 = 16x16px (2x2 MSX chars)
 2412	4155					; Tile 7: gem_extra_jump = 8x8px (1x1 MSX chars)
 2413	4155					; Tile 8: rajol_vermell = 8x8px (1x1 MSX chars)
 2414	4155					; Tile 9: gem_extra_jump_f0 = 8x8px (1x1 MSX chars)
 2415	4155					; Tile 10: rajola2 = 8x8px (1x1 MSX chars)
 2416	4155					; Tile 11: punxa1 = 8x8px (1x1 MSX chars)
 2417	4155					; Tile 12: cor = 16x16px (2x2 MSX chars)
 2418	4155					; Tile 13: Goal = 24x8px (3x1 MSX chars)
 2419	4155					; Tile 14: finish = 8x8px (1x1 MSX chars)
 2420	4155					; Tile 15: line = 8x8px (1x1 MSX chars)
 2421	4155					; Tile 16: HEART1 = 8x8px (1x1 MSX chars)
 2422	4155					; Tile 17: clock = 8x8px (1x1 MSX chars)
 2423	4155					; Tile 18: tile_hud = 8x8px (1x1 MSX chars)
 2424	4155					; Tile 19: rajol2 = 16x16px (2x2 MSX chars)
 2425	4155					; Tile 20: rajol3 = 16x16px (2x2 MSX chars)
 2426	4155					
 2427	4155					; Using primary tile size: 16x16px
 2428	4155					TILE_WIDTH      EQU 16    ; Primary tile width in pixels
 2429	4155					TILE_HEIGHT     EQU 16   ; Primary tile height in pixels
 2430	4155					SCREEN_TILES_X  EQU 16    ; Horizontal tiles (256px ÷ 16px)
 2431	4155					SCREEN_TILES_Y  EQU 12   ; Vertical tiles (192px ÷ 16px)
 2432	4155					MSX_CHARS_PER_TILE_X EQU 2  ; MSX characters wide per tile
 2433	4155					MSX_CHARS_PER_TILE_Y EQU 2 ; MSX characters high per tile
