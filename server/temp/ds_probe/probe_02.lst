 26239	8000					; ##################################################################
 26240	8000					; FAR BANK 11 — [#8000h-#A000h] FAR CODE: scroll
 26241	8000					; Accessed ONLY via trampolines in bank 0 (entrypoint_far labels).
 26242	8000					; At runtime: bank0 saves P2, maps bank11 to P2,
 26243	8000					; calls routine, then restores P2.
 26244	8000					; NOTE: routines in this bank MUST only call code in bank 0 or
 26245	8000					;       primary banks (1-3). No far-to-far calls allowed.
 26246	8000					; ##################################################################
 26247	8000					    org #8000
 26248	8000					
 26249	8000					; ==================================================================
 26250	8000					; SCROLL SYSTEM
 26251	8000					; File: scroll.asm
 26252	8000					; Description: Viewport management and screen scrolling for large worlds
 26253	8000					; ==================================================================
 26254	8000					
 26255	8000					; ==================================================================
 26256	8000					; SCROLL SYSTEM CONSTANTS
 26257	8000					; ==================================================================
 26258	8000					
 26259	8000					SCREEN_WIDTH_TILES      EQU 32      ; MSX Screen 2 width in tiles
 26260	8000					SCREEN_HEIGHT_TILES     EQU 24      ; MSX Screen 2 height in tiles
 26261	8000					SCREEN_WIDTH_PIXELS     EQU 256     ; MSX Screen 2 width in pixels
 26262	8000					SCREEN_HEIGHT_PIXELS    EQU 192     ; MSX Screen 2 height in pixels
 26263	8000					
 26264	8000					; Note: NAMETBL (#1800) is already defined in constants.asm
 26265	8000					
 26266	8000					; ==================================================================
 26267	8000					; SCROLL SYSTEM INITIALIZATION
 26268	8000					; ==================================================================
 26269	8000					
 26270	8000					init_scroll_system:
 26271	8000					    ; Initialize camera to (0, 0)
 26272	8000	AF				    xor a
 26273	8001	32	63	DC		    ld (camera_x), a
 26274	8004	32	64	DC		    ld (camera_x + 1), a
 26275	8007	32	65	DC		    ld (camera_y), a
 26276	800A	32	66	DC		    ld (camera_y + 1), a
 26277	800D	32	67	DC		    ld (camera_tile_x), a
 26278	8010	32	68	DC		    ld (camera_tile_y), a
 26279	8013					
 26280	8013					    ; Set world dimensions (will be updated by level loader)
 26281	8013	3E	20			    ld a, SCREEN_WIDTH_TILES
 26282	8015	32	69	DC		    ld (world_width_tiles), a
 26283	8018	3E	18			    ld a, SCREEN_HEIGHT_TILES
 26284	801A	32	6A	DC		    ld (world_height_tiles), a
 26285	801D					
 26286	801D					    ; Clear dirty flag
 26287	801D	AF				    xor a
 26288	801E	32	6B	DC		    ld (scroll_dirty_flag), a
 26289	8021					
 26290	8021	C9				    ret
 26291	8022					
 26292	8022					; ==================================================================
 26293	8022					; CAMERA CONTROL FUNCTIONS
 26294	8022					; ==================================================================
 26295	8022					
 26296	8022					; ------------------------------------------------------------------
 26297	8022					; set_camera_position
 26298	8022					; Set camera position in pixels (with bounds checking)
 26299	8022					; Input:  HL = X position (pixels), DE = Y position (pixels)
 26300	8022					; Destroys: AF, BC
 26301	8022					; ------------------------------------------------------------------
 26302	8022					set_camera_position:
 26303	8022					    ; Bounds check X
 26304	8022	E5				    push hl
 26305	8023	D5				    push de
 26306	8024					
 26307	8024					    ; Calculate max X = (world_width_tiles - SCREEN_WIDTH_TILES) * TILE_WIDTH
 26308	8024	3A	69	DC		    ld a, (world_width_tiles)
 26309	8027	D6	20			    sub SCREEN_WIDTH_TILES
 26310	8029	38	1A			    jr c, .scroll_x_in_bounds   ; World smaller than screen
 26311	802B					
 26312	802B					    ; A = tiles to scroll, multiply by tile width
 26313	802B	47				    ld b, a
 26314	802C	3E	10			    ld a, 16
 26315	802E	CD	0A	81		    call multiply_a_by_b        ; HL = max X
 26316	8031					
 26317	8031					    ; Compare camera X with max X
 26318	8031	D1				    pop de
 26319	8032	C1				    pop bc                      ; BC = requested X
 26320	8033	C5				    push bc
 26321	8034	D5				    push de
 26322	8035					
 26323	8035					    ; If requested X > max X, clamp to max X
 26324	8035	78				    ld a, b
 26325	8036	BC				    cp h
 26326	8037	38	08			    jr c, .scroll_x_clamped
 26327	8039	20	0A			    jr nz, .scroll_x_in_bounds
 26328	803B	79				    ld a, c
 26329	803C	BD				    cp l
 26330	803D	38	02			    jr c, .scroll_x_clamped
 26331	803F	18	04			    jr .scroll_x_in_bounds
 26332	8041					
 26333	8041					.scroll_x_clamped:
 26334	8041	44				    ld b, h
 26335	8042	4D				    ld c, l
 26336	8043	18	04			    jr .scroll_x_done
 26337	8045					
 26338	8045					.scroll_x_in_bounds:
 26339	8045	D1				    pop de
 26340	8046	C1				    pop bc
 26341	8047	C5				    push bc
 26342	8048	D5				    push de
 26343	8049					
 26344	8049					.scroll_x_done:
 26345	8049					    ; Store camera X
 26346	8049	79				    ld a, c
 26347	804A	32	63	DC		    ld (camera_x), a
 26348	804D	78				    ld a, b
 26349	804E	32	64	DC		    ld (camera_x + 1), a
 26350	8051					
 26351	8051					    ; Calculate camera_tile_x = camera_x / TILE_WIDTH
 26352	8051					    
 26353	8051					    ; Tile width is 16, shift right 4 times
 26354	8051	79				    ld a, c
 26355	8052	CB	38			    srl b
 26356	8054	1F				    rra
 26357	8055	CB	38			    srl b
 26358	8057	1F				    rra
 26359	8058	CB	38			    srl b
 26360	805A	1F				    rra
 26361	805B	CB	38			    srl b
 26362	805D	1F				    rra
 26363	805E	32	67	DC		    ld (camera_tile_x), a
 26364	8061					
 26365	8061					    ; Bounds check Y
 26366	8061	D1				    pop de                      ; DE = requested Y
 26367	8062	C1				    pop bc
 26368	8063					
 26369	8063					    ; Calculate max Y = (world_height_tiles - SCREEN_HEIGHT_TILES) * TILE_HEIGHT
 26370	8063	3A	6A	DC		    ld a, (world_height_tiles)
 26371	8066	D6	18			    sub SCREEN_HEIGHT_TILES
 26372	8068	38	14			    jr c, .scroll_y_in_bounds   ; World smaller than screen
 26373	806A					
 26374	806A	47				    ld b, a
 26375	806B	3E	10			    ld a, 16
 26376	806D	CD	0A	81		    call multiply_a_by_b        ; HL = max Y
 26377	8070					
 26378	8070					    ; If requested Y > max Y, clamp to max Y
 26379	8070	7A				    ld a, d
 26380	8071	BC				    cp h
 26381	8072	38	08			    jr c, .scroll_y_clamped
 26382	8074	20	08			    jr nz, .scroll_y_in_bounds
 26383	8076	7B				    ld a, e
 26384	8077	BD				    cp l
 26385	8078	38	02			    jr c, .scroll_y_clamped
 26386	807A	18	02			    jr .scroll_y_in_bounds
 26387	807C					
 26388	807C					.scroll_y_clamped:
 26389	807C	54				    ld d, h
 26390	807D	5D				    ld e, l
 26391	807E					
 26392	807E					.scroll_y_in_bounds:
 26393	807E					    ; Store camera Y
 26394	807E	7B				    ld a, e
 26395	807F	32	65	DC		    ld (camera_y), a
 26396	8082	7A				    ld a, d
 26397	8083	32	66	DC		    ld (camera_y + 1), a
 26398	8086					
 26399	8086					    ; Calculate camera_tile_y = camera_y / TILE_HEIGHT
 26400	8086					    
 26401	8086					    ; Tile height is 16, shift right 4 times
 26402	8086	7B				    ld a, e
 26403	8087	CB	3A			    srl d
 26404	8089	1F				    rra
 26405	808A	CB	3A			    srl d
 26406	808C	1F				    rra
 26407	808D	CB	3A			    srl d
 26408	808F	1F				    rra
 26409	8090	CB	3A			    srl d
 26410	8092	1F				    rra
 26411	8093	32	68	DC		    ld (camera_tile_y), a
 26412	8096					
 26413	8096					    ; Mark viewport as dirty (needs redraw)
 26414	8096	3E	01			    ld a, 1
 26415	8098	32	6B	DC		    ld (scroll_dirty_flag), a
 26416	809B					
 26417	809B	C9				    ret
 26418	809C					
 26419	809C					; ------------------------------------------------------------------
 26420	809C					; move_camera
 26421	809C					; Move camera by delta (relative movement)
 26422	809C					; Input:  B = delta X (signed), C = delta Y (signed)
 26423	809C					; Destroys: AF, BC, DE, HL
 26424	809C					; ------------------------------------------------------------------
 26425	809C					move_camera:
 26426	809C					    ; Get current camera position
 26427	809C	3A	63	DC		    ld a, (camera_x)
 26428	809F	6F				    ld l, a
 26429	80A0	3A	64	DC		    ld a, (camera_x + 1)
 26430	80A3	67				    ld h, a                     ; HL = camera X
 26431	80A4					
 26432	80A4	3A	65	DC		    ld a, (camera_y)
 26433	80A7	5F				    ld e, a
 26434	80A8	3A	66	DC		    ld a, (camera_y + 1)
 26435	80AB	57				    ld d, a                     ; DE = camera Y
 26436	80AC					
 26437	80AC					    ; Add delta X (signed 8-bit)
 26438	80AC	78				    ld a, b
 26439	80AD	B7				    or a
 26440	80AE	F2	BD	80		    jp p, .move_positive_x      ; Positive delta
 26441	80B1					
 26442	80B1					    ; Negative delta
 26443	80B1	2F				    cpl
 26444	80B2	3C				    inc a                       ; A = abs(delta)
 26445	80B3	47				    ld b, a
 26446	80B4	7D				    ld a, l
 26447	80B5	90				    sub b
 26448	80B6	6F				    ld l, a
 26449	80B7	7C				    ld a, h
 26450	80B8	DE	00			    sbc a, 0
 26451	80BA	67				    ld h, a
 26452	80BB	18	07			    jr .move_x_done
 26453	80BD					
 26454	80BD					.move_positive_x:
 26455	80BD	7D				    ld a, l
 26456	80BE	80				    add a, b
 26457	80BF	6F				    ld l, a
 26458	80C0	7C				    ld a, h
 26459	80C1	CE	00			    adc a, 0
 26460	80C3	67				    ld h, a
