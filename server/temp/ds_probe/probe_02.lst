 15965	A000					; ==================================================================
 15966	A000					; GAMEFLOW EXECUTION ENGINE
 15967	A000					; File: gameflow.asm
 15968	A000					; Description: GameFlow-based game orchestration system
 15969	A000					; ==================================================================
 15970	A000					;
 15971	A000					; GameFlow: Main
 15972	A000					; Total Nodes: 7
 15973	A000					; Total Connections: 8
 15974	A000					; Start Node: gf_start_1770754183471
 15975	A000					;
 15976	A000					; ARCHITECTURE:
 15977	A000					; - GameFlow is the SOLE execution orchestrator
 15978	A000					; - Each node generates its own execution code
 15979	A000					; - Connections between nodes define the complete flow
 15980	A000					; - No hardcoded main_loop outside GameFlow
 15981	A000					; ==================================================================
 15982	A000					
 15983	A000					; ==================================================================
 15984	A000					; GAMEFLOW INITIALIZATION
 15985	A000					; ==================================================================
 15986	A000					
 15987	A000					gameflow_init:
 15988	A000					    ; Initialize GameFlow system
 15989	A000					    ; Reset state
 15990	A000	AF				    xor a
 15991	A001	32	07	C0		    ld (gameflow_exit_requested), a
 15992	A004	32	05	C0		    ld (current_flow_state), a
 15993	A007	C9				    ret
 15994	A008					
 15995	A008					; Main entry point - called from init_rom
 15996	A008					; This is where the game STARTS
 15997	A008					gameflow_start:
 15998	A008					    ; Load the Start node
 15999	A008	21	9E	A6		    ld hl, gameflow_node_gf_start_1770754183471
 16000	A00B	C3	0E	A0		    jp gameflow_execute_node
 16001	A00E					
 16002	A00E					; ==================================================================
 16003	A00E					; CORE EXECUTION ENGINE
 16004	A00E					; ==================================================================
 16005	A00E					
 16006	A00E					; Execute a GameFlow node
 16007	A00E					; Input: HL = address of node structure
 16008	A00E					; 
 16009	A00E					; Node Structure:
 16010	A00E					;   +0: Node type (byte)
 16011	A00E					;   +1-2: Data pointer (word) - node-specific data
 16012	A00E					;   +3-4: Connection table pointer (word)
 16013	A00E					;
 16014	A00E					gameflow_execute_node:
 16015	A00E					    ; Read node type
 16016	A00E	7E				    ld a, (hl)
 16017	A00F	23				    inc hl
 16018	A010					    
 16019	A010					    ; Save data pointer and connection table pointer for handlers
 16020	A010	5E				    ld e, (hl)
 16021	A011	23				    inc hl
 16022	A012	56				    ld d, (hl)      ; DE = data pointer
 16023	A013	23				    inc hl
 16024	A014	4E				    ld c, (hl)
 16025	A015	23				    inc hl
 16026	A016	46				    ld b, (hl)      ; BC = connection table pointer
 16027	A017					    
 16028	A017					    ; DE = node data, BC = connection table
 16029	A017					    ; Dispatch based on node type
 16030	A017	FE	00			    cp NODE_TYPE_START
 16031	A019	CA	36	A0		    jp z, gameflow_handle_start
 16032	A01C	FE	04			    cp NODE_TYPE_TEXT
 16033	A01E	CA	51	A0		    jp z, gameflow_handle_text
 16034	A021	FE	03			    cp NODE_TYPE_SUB_MENU
 16035	A023	CA	F9	A0		    jp z, gameflow_handle_submenu
 16036	A026	FE	0D			    cp NODE_TYPE_PRESENTATION_SCREEN
 16037	A028	CA	C2	A4		    jp z, gameflow_handle_presentationscreen
 16038	A02B	FE	0C			    cp NODE_TYPE_MUSIC
 16039	A02D	CA	D3	A4		    jp z, gameflow_handle_music
 16040	A030	FE	01			    cp NODE_TYPE_WORLD_LINK
 16041	A032	CA	E1	A4		    jp z, gameflow_handle_worldlink
 16042	A035					    
 16043	A035					    ; Unknown node type - error
 16044	A035	C9				    ret
 16045	A036					
 16046	A036					; ==================================================================
 16047	A036					; NODE TYPE HANDLERS
 16048	A036					; Each handler receives:
 16049	A036					;   DE = node data pointer
 16050	A036					;   BC = connection table pointer
 16051	A036					; ==================================================================
 16052	A036					
 16053	A036					gameflow_handle_start:
 16054	A036					    ; Start node - Initialize game state and systems
 16055	A036					    ; DE = node data pointer:
 16056	A036					    ;   [init_routine_ptr DW][init_routine_bank DB]
 16057	A036					    ; BC = connection table
 16058	A036					
 16059	A036	C5				    push bc         ; Save connection table
 16060	A037					
 16061	A037					    ; Execute initialization routine
 16062	A037					    ; DE points to start_init_data structure
 16063	A037	EB				    ex de, hl
 16064	A038	5E				    ld e, (hl)
 16065	A039	23				    inc hl
 16066	A03A	56				    ld d, (hl)      ; DE = initialization routine address
 16067	A03B	23				    inc hl
 16068	A03C	46				    ld b, (hl)      ; B = initialization routine bank
 16069	A03D	62				    ld h, d
 16070	A03E	6B				    ld l, e         ; HL = initialization routine address
 16071	A03F					
 16072	A03F					    ; Call initialization routine (if not null)
 16073	A03F	7C				    ld a, h
 16074	A040	B5				    or l
 16075	A041	28	04			    jr z, .skip_init
 16076	A043					
 16077	A043					    ; Mapper-safe far call (auto window from HL address)
 16078	A043	78				    ld a, b
 16079	A044	CD	0B	42		    call mapper_call_hl_auto
 16080	A047					
 16081	A047					.skip_init:
 16082	A047					    ; Continue to next node
 16083	A047	C1				    pop bc
 16084	A048	CD	63	A5		    call gameflow_get_default_connection
 16085	A04B	7C				    ld a, h
 16086	A04C	B5				    or l
 16087	A04D	C8				    ret z           ; No connection
 16088	A04E	C3	0E	A0		    jp gameflow_execute_node
 16089	A051					
 16090	A051					gameflow_handle_text:
 16091	A051					    ; Text node - show text screen and wait for fire
 16092	A051					    ; DE = text data pointer (pre-computed lines table)
 16093	A051					    ; BC = connection table
 16094	A051					
 16095	A051	C5				    push bc
 16096	A052					
 16097	A052					    ; Show text screen (full screen with title, message, prompt)
 16098	A052	CD	62	A0		    call show_text_screen
 16099	A055					
 16100	A055					    ; Wait for fire button
 16101	A055	CD	D3	A0		    call wait_for_fire
 16102	A058					
 16103	A058					    ; Continue to next node
 16104	A058	C1				    pop bc
 16105	A059	CD	63	A5		    call gameflow_get_default_connection
 16106	A05C	7C				    ld a, h
 16107	A05D	B5				    or l
 16108	A05E	C8				    ret z
 16109	A05F	C3	0E	A0		    jp gameflow_execute_node
 16110	A062					
 16111	A062					; ------------------------------------------------------------------
 16112	A062					; show_text_screen
 16113	A062					; Display full text screen with optional background screen asset
 16114	A062					; Input: DE = text data pointer
 16115	A062					;   Format: DB bgColor, DW screen_load_ptr (0=none), DB screen_load_bank, DB numLines
 16116	A062					;           Per line: DB row, DB col, DW string_ptr
 16117	A062					; If screen_load_ptr != 0: calls that function to load background screen
 16118	A062					; (the load_screen function sets VDP colors and name table from screen asset)
 16119	A062					; If screen_load_ptr == 0: sets bgColor, clears screen, renders text on solid bg
 16120	A062					; ------------------------------------------------------------------
 16121	A062					show_text_screen:
 16122	A062	C5				    push bc
 16123	A063	D5				    push de
 16124	A064	E5				    push hl
 16125	A065					
