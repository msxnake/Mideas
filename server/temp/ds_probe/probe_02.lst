 8821	6CE6					    ; WALL COLLISION COMPONENT SYSTEM
 8822	6CE6					    ; ==================================================================
 8823	6CE6					    ; Prevents entities from moving through walls
 8824	6CE6					    ; Uses per-entity hitbox (offset + width/height)
