 17203	A4F6	23				    inc hl
 17204	A4F7	56				    ld d, (hl)
 17205	A4F8	23				    inc hl
 17206	A4F9	46				    ld b, (hl)      ; B = init routine bank
 17207	A4FA	62				    ld h, d
 17208	A4FB	6B				    ld l, e         ; HL = init routine address
 17209	A4FC	7C				    ld a, h
 17210	A4FD	B5				    or l
