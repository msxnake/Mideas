 25126	A164					; ------------------------------------------------------------------
 25127	A164					; Routine: anim_transform_vram_block
 25128	A164					; Purpose:
 25129	A164					;   Apply transform to one 8-byte VRAM block (one char rows table).
 25130	A164					; Input:
 25131	A164					;   HL = VRAM base address for row 0 (8 consecutive bytes)
 25132	A164					;   D  = operation code:
 25133	A164					;        1 rotate_left  (RLCA)
 25134	A164					;        2 rotate_right (RRCA)
 25135	A164					;        3 shift_left   (SLA)
 25136	A164					;        4 shift_right  (SRL)
 25137	A164					;        5 shift_up rows
 25138	A164					;        6 shift_down rows
 25139	A164					;        7 swap top/bottom row
 25140	A164					; Output:
 25141	A164					;   None
 25142	A164					; Modifies:
 25143	A164					;   AF, BC, DE, HL
 25144	A164					; Preserves:
 25145	A164					;   IX, IY, SP
 25146	A164					; Flags:
 25147	A164					;   Not preserved
 25148	A164					; Stack:
 25149	A164					;   Uses stack while reading row bytes
 25150	A164					; ------------------------------------------------------------------
 25151	A164					anim_transform_vram_block:
