 21465	856A					
 21466	856A					    ; Fire OnEnter of initial state immediately.
 21467	856A					    ; Normally OnEnter fires via SM_ChangeState, but the first state is set
 21468	856A					    ; directly (no transition). Without this call, ChangeSprite / other
 21469	856A					    ; OnEnter actions never run and entity_sprite_asset_index stays at 0.
 21470	856A					    ; State data layout: [ID:1][OnEnter ptr:2][OnExit ptr:2][Transitions ptr:2]
 21471	856A	21	B4	88		    ld hl, SM_New_Statemachine_state_1771533526010 + 1      ; HL = &OnEnter Actions Ptr field
 21472	856D	5E				    ld e, (hl)
 21473	856E	23				    inc hl
 21474	856F	56				    ld d, (hl)                    ; DE = OnEnter Actions Ptr (0 if none)
 21475	8570	3E	04			    ld a, 4                ; A = entity index
 21476	8572	CD	CD	80		    call SM_ExecuteActions        ; safe: SM_ExecuteActions returns immediately if DE=0
