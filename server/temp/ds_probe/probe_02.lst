 17422	A5B4	CD	DB	69		    call refresh_player_animation_fastpath
 17423	A5B7					
 17424	A5B7					    ; Refresh player sprite once with the final state of this frame.
 17425	A5B7	CD	A0	61		    call refresh_player_sprite_fastpath
