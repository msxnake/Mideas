 17143	A4C2					gameflow_handle_presentationscreen:
 17144	A4C2					    ; PresentationScreen node - show full-screen presentation image
 17145	A4C2					    ; BC = connection table
 17146	A4C2	C5				    push bc
 17147	A4C3	CD	28	4A		    call show_presentation_screen_far
 17148	A4C6					    ; show_presentation_screen overwrites ALL of CHRTBL2 (chars 0-255 x 3 banks).
 17149	A4C6					    ; Game tile patterns live at char 128+ and are now corrupted.
 17150	A4C6					    ; Reload game VRAM (patterns + colors) before entering gameplay.
 17151	A4C6	CD	A9	4C		    call init_game_systems
 17152	A4C9	C1				    pop bc
 17153	A4CA	CD	63	A5		    call gameflow_get_default_connection
 17154	A4CD	7C				    ld a, h
