 17361	A58F					; Connection type constants
 17362	A58F					CONNECTION_DEFAULT      EQU 0
 17363	A58F					CONNECTION_THEN         EQU 1
 17364	A58F					CONNECTION_ELSE         EQU 2
 17365	A58F					CONNECTION_OPTION_0     EQU 10
 17366	A58F					CONNECTION_OPTION_1     EQU 11
 17367	A58F					CONNECTION_OPTION_2     EQU 12
 17368	A58F					CONNECTION_OPTION_3     EQU 13
 17369	A58F					CONNECTION_OPTION_4     EQU 14
 17370	A58F					CONNECTION_OPTION_5     EQU 15
 17371	A58F					CONNECTION_END          EQU 255
