 21653	88C4	F5				    push af
 21654	88C5	C5				    push bc
 21655	88C6	E5				    push hl
 21656	88C7					
 21657	88C7					    ; Guard invalid DE index coming from callers.
 21658	88C7	7A				    ld a, d
