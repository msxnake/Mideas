 2458	4155					; INPUT CONSTANTS
 2459	4155					; ==================================================================
 2460	4155					
 2461	4155					; Joystick Directions
 2462	4155					STICK_UP    EQU 1
 2463	4155					STICK_UPRIGHT EQU 2
 2464	4155					STICK_RIGHT EQU 3
 2465	4155					STICK_DOWNRIGHT EQU 4
 2466	4155					STICK_DOWN  EQU 5
 2467	4155					STICK_DOWNLEFT EQU 6
 2468	4155					STICK_LEFT  EQU 7
 2469	4155					STICK_UPLEFT EQU 8
 2470	4155					STICK_CENTER EQU 0
 2471	4155					
 2472	4155					; Trigger Constants
 2473	4155					TRIG_A      EQU #10      ; Trigger A (Fire)
 2474	4155					TRIG_B      EQU #20      ; Trigger B (MSX2+)
 2475	4155					
 2476	4155					; Input Button Bitmask
 2477	4155					INPUT_BTN_FIRE EQU #01   ; Fire/Space button bit in input_btn_curr/input_btn_prev
 2478	4155					INPUT_BTN_GRAB EQU #02   ; Grab button bit in input_btn_curr/input_btn_prev
 2479	4155					
 2480	4155					; Direction flags shared by input/state machine helpers
 2481	4155					DIR_ALLOW_UP     EQU #01 ; Bit 0: Allow UP movement
 2482	4155					DIR_ALLOW_DOWN   EQU #02 ; Bit 1: Allow DOWN movement
 2483	4155					DIR_ALLOW_LEFT   EQU #04 ; Bit 2: Allow LEFT movement
 2484	4155					DIR_ALLOW_RIGHT  EQU #08 ; Bit 3: Allow RIGHT movement
 2485	4155					
 2486	4155					; ==================================================================
 2487	4155					; TILE BEHAVIOR CONSTANTS (for collision detection)
 2488	4155					; ==================================================================
 2489	4155					
 2490	4155					; Tile Behavior encoding matches TileEditor logicalProperties.mapId:
 2491	4155					;   bits 7-4 = solidity family
 2492	4155					;   bits 3-0 = property flags
 2493	4155					TILE_PASSABLE       EQU #00    ; Family 0: passable / no-solid
 2494	4155					TILE_SOLID          EQU #10    ; Family 1: solid wall/floor
 2495	4155					TILE_PLATFORM       EQU #20    ; Family 2: top-solid platform
 2496	4155					TILE_SLOPE          EQU #30    ; Family 3: slope / custom solid family
 2497	4155					TILE_BREAKABLE      EQU #01    ; Flag bit 0
 2498	4155					TILE_MOVABLE        EQU #02    ; Flag bit 1
 2499	4155					TILE_DEADLY         EQU #04    ; Flag bit 2: causesDamage
 2500	4155					TILE_INTERACTABLE   EQU #08    ; Flag bit 3: isInteractiveSwitch
 2501	4155					
 2502	4155					; Collision Directions (for platform logic)
 2503	4155					COLL_FROM_ABOVE     EQU #01    ; Entity approaching from above
 2504	4155					COLL_FROM_BELOW     EQU #02    ; Entity approaching from below
 2505	4155					COLL_FROM_LEFT      EQU #04    ; Entity approaching from left
 2506	4155					COLL_FROM_RIGHT     EQU #08    ; Entity approaching from right
 2507	4155					
 2508	4155					; Entity Collision Layer Presets (entity_collision_layer / entity_collides_with)
 2509	4155					COLLISION_LAYER_PLAYER      EQU #01
 2510	4155					COLLISION_LAYER_ENEMY       EQU #02
 2511	4155					COLLISION_LAYER_PROJECTILE  EQU #04
 2512	4155					COLLISION_LAYER_PLATFORM    EQU #08
 2513	4155					COLLISION_LAYER_ITEM        EQU #10
 2514	4155					
 2515	4155					; Entity-Entity Collision Event Flags (entity_entity_collision_flags)
 2516	4155					COLLISION_EVENT_ENTITY      EQU #01
 2517	4155					COLLISION_EVENT_ENEMY       EQU #02
 2518	4155					COLLISION_EVENT_ITEM        EQU #04
