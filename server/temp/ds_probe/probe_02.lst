 2554	4155					NODE_TYPE_SUBMENU       EQU 3    ; Alias for menu node
 2555	4155					NODE_TYPE_SUB_MENU      EQU 3    ; Alias with underscore (for compatibility)
 2556	4155					NODE_TYPE_TEXT          EQU 4    ; Text node (displays text)
 2557	4155					NODE_TYPE_TRANSITION    EQU 5    ; Transition node
 2558	4155					NODE_TYPE_RESTART       EQU 6    ; Restart node (restart game/level)
 2559	4155					NODE_TYPE_END           EQU 7    ; End node (game over, victory, credits)
 2560	4155					NODE_TYPE_IF_THEN_ELSE  EQU 8    ; IfThenElse node (conditional branch)
 2561	4155					NODE_TYPE_GLOBALS       EQU 9    ; Globals node (global variable ops)
 2562	4155					NODE_TYPE_WAYPOINT      EQU 10   ; Waypoint node (routing marker)
 2563	4155					NODE_TYPE_GROUP         EQU 11   ; Group node (nested flow)
 2564	4155					NODE_TYPE_MUSIC         EQU 12   ; Music node (audio command)
 2565	4155					NODE_TYPE_PRESENTATION_SCREEN EQU 13 ; Presentation Screen node (static tile screen)
 2566	4155					NODE_TYPE_UNKNOWN       EQU 255  ; Unknown/unsupported node type
