 18444	6020					; Register Contract:
 18445	6020					;   Purpose: Wait a configurable number of frames after showing the presentation screen.
 18446	6020					;   Inputs:
 18447	6020					;     - B = frame count
 18448	6020					;   Outputs:
 18449	6020					;     - None
 18450	6020					;   Clobbers:
 18451	6020					;     - AF
 18452	6020					;     - B
 18453	6020					;   Preserved:
 18454	6020					;     - BC
 18455	6020					;     - DE
 18456	6020					;     - HL
 18457	6020					;     - IX
 18458	6020					;     - IY
 18459	6020					presentation_wait_frames:
 18460	6020	C5				    push bc
 18461	6021	78				    ld a, b
 18462	6022	B7				    or a
 18463	6023	28	03			    jr z, .pwf_done
 18464	6025					.pwf_loop:
 18465	6025	76				    halt
 18466	6026	10	FD			    djnz .pwf_loop
 18467	6028					.pwf_done:
 18468	6028	C1				    pop bc
 18469	6029	C9				    ret
