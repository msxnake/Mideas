 24424	81D5					
 24425	81D5					; ------------------------------------------------------------------
 24426	81D5					; music_resume
 24427	81D5					; Resume muted music.
 24428	81D5					; Destroys: AF
 24429	81D5					; ------------------------------------------------------------------
 24430	81D5					music_resume:
 24431	81D5	3A	B9	E9		    ld a, (music_active)
 24432	81D8	B7				    or a
 24433	81D9	C8				    ret z
 24434	81DA	AF				    xor a
 24435	81DB	32	BA	E9		    ld (music_muted), a
 24436	81DE	C9				    ret
 24437	81DF					
 24438	81DF					; ------------------------------------------------------------------
 24439	81DF					; music_execute_command
 24440	81DF					; Dispatch a music command from Game Flow nodes.
 24441	81DF					; Input:  DE -> [command, trackIndex, loopFlag]
 24442	81DF					;         0=stop, 1=play, 2=mute, 3=resume, #FF=no-op
 24443	81DF					; Destroys: AF, BC (play path), DE (play path), HL
 24444	81DF					; ------------------------------------------------------------------
 24445	81DF					music_execute_command:
 24446	81DF	1A				    ld a, (de)
 24447	81E0	FE	FF			    cp #FF
 24448	81E2	C8				    ret z
 24449	81E3	B7				    or a
 24450	81E4	CA	BA	81		    jp z, music_stop
 24451	81E7	FE	01			    cp 1
 24452	81E9	CA	F7	81		    jp z, .pt3_exec_play
 24453	81EC	FE	02			    cp 2
 24454	81EE	CA	C7	81		    jp z, music_mute
 24455	81F1	FE	03			    cp 3
 24456	81F3	CA	D5	81		    jp z, music_resume
 24457	81F6	C9				    ret
 24458	81F7					.pt3_exec_play:
 24459	81F7	13				    inc de
 24460	81F8	1A				    ld a, (de)
 24461	81F9	4F				    ld c, a
 24462	81FA	13				    inc de
 24463	81FB	1A				    ld a, (de)
 24464	81FC	47				    ld b, a
 24465	81FD	79				    ld a, c
 24466	81FE	CD	93	4C		    call call_music_play_track_resident
 24467	8201	C9				    ret
