 7111	6581					    ; Other entity IS a platform - set platform reference
 7112	6581	7B				    ld a, e                 ; A = other entity index
 7113	6582	21	7C	E6		    ld hl, entity_platform_id
 7114	6585	16	00			    ld d, 0
 7115	6587	59				    ld e, c                 ; E = current entity index
 7116	6588	19				    add hl, de              ; HL = &entity_platform_id[current]
