 11077	77F8					    ; add hl, de does NOT modify DE, so we can reuse it for all 3 tables.
 11078	77F8	16	00			    ld d, 0
 11079	77FA	59				    ld e, c                        ; DE = (0, current index)
 11080	77FB					
