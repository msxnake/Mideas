 21667	88D2					    ; and avoids getting stuck in an unrelated 1-layer sprite asset.
 21668	88D2	21	12	A1		    ld hl, entity_sprite_asset_index_init
 21669	88D5	19				    add hl, de
 21670	88D6	7E				    ld a, (hl)
