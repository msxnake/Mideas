 8897	6D15					; ------------------------------------------------------------------
 8898	6D15					; update_wallcollision_component
 8899	6D15					; ------------------------------------------------------------------
 8900	6D15					; Check wall collisions and prevent movement through solid tiles.
 8901	6D15					; Uses behavior map (current_behavior_map) for collision detection.
 8902	6D15					; Entity position is cached in wall_temp_x/y and converted to hitbox bounds.
 8903	6D15					; ------------------------------------------------------------------
 8904	6D15					; Register Contract:
 8905	6D15					;   Purpose: Iterate all entity slots; for each active entity with
 8906	6D15					;            WallCollision eligibility, probe solid tiles in movement
 8907	6D15					;            direction(s) and snap position + zero velocity on hit.
 8908	6D15					;   Inputs:
 8909	6D15					;     - entity_active[]         : 1 = entity exists
 8910	6D15					;     - active_entity_list[] / active_entity_count : compact active list already current
 8911	6D15					;     - entity_comp_masks[]     : low byte component bitmask
 8912	6D15					;     - entity_comp_masks_hi[]  : high byte (COMP_MASK_GRAVITY at bit 1)
 8913	6D15					;     - entity_collides_with[]  : must include COLLISION_LAYER_PLATFORM (#08)
 8914	6D15					;     - entity_x_pos/y_pos[]    : world position
 8915	6D15					;     - entity_vel_x/vel_y[]    : signed 8-bit velocity (negative = left/up)
 8916	6D15					;     - entity_gravity_vel[]    : 16-bit signed gravity accumulator (word)
 8917	6D15					;     - entity_collision_offset_x/y[]: signed offset from origin to hitbox corner
 8918	6D15					;     - entity_collision_hitbox_w/h[]: hitbox size (minimum 1 if zero)
 8919	6D15					;     - current_behavior_map    : pointer to active screen behavior map
 8920	6D15					;   Outputs:
 8921	6D15					;     - entity_x_pos/y_pos[]    : snapped on collision
 8922	6D15					;     - entity_vel_x/vel_y[]    : zeroed on collision axis
 8923	6D15					;     - entity_gravity_vel[]    : zeroed on vertical collision
 8924	6D15					;     - entity_on_ground[]      : bit 0 set=floor, cleared at loop start
 8925	6D15					;     - entity_wall_collision_flags[]: bits 0=UP,1=DOWN,2=LEFT,3=RIGHT
 8926	6D15					;   Clobbers: AF, BC, DE, HL
 8927	6D15					;   Preserved: (none — uses scratch RAM wall_temp_x/y, wall_hit_*, wall_probe_*)
 8928	6D15					;   Notes:
 8929	6D15					;     - Opt-B: loop uses active_entity_list (entities guaranteed active + on screen).
 8930	6D15					;       Eliminates ~29 wasted iterations vs 0..MAX_ENTITIES scan (3 entities active).
 8931	6D15					;     - Caller must refresh active_entity_list earlier in the frame.
 8932	6D15					;     - Opt-C: wall_build_hitbox_cache is skipped on DOWN snap when new Y == current Y
 8933	6D15					;       (entity already on floor). Saves ~200 cycles/entity/frame when standing still.
 8934	6D15					;     - wall_build_hitbox_cache is called once at entity entry, and after each snap
 8935	6D15					;       where the position actually changes.
 8936	6D15					;     - Gravity floor check (.check_wall_y_gravity) runs even when vel_y=0
 8937	6D15					;       so entity_on_ground stays accurate when entity is standing still.
 8938	6D15					; ------------------------------------------------------------------
 8939	6D15					update_wallcollision_component:
 8940	6D15					    ; update_all_entities refreshed active_entity_list before entering the
 8941	6D15					    ; component chain, so we can consume it directly here.
 8942	6D15	3A	32	E9		    ld a, (collision_entity_count)
 8943	6D18	B7				    or a
 8944	6D19	C8				    ret z                         ; no active entities ? done
 8945	6D1A	47				    ld b, a                       ; B = entity count (loop counter for djnz)
 8946	6D1B	21	12	E9		    ld hl, collision_entity_list
 8947	6D1E					
 8948	6D1E					.wall_loop:
 8949	6D1E					    ; ---- Load next entity index from compact list ----
 8950	6D1E	5E				    ld e, (hl)                    ; E = entity index
 8951	6D1F	16	00			    ld d, 0                       ; DE = entity index (word)
 8952	6D21	E5				    push hl                       ; save list pointer (clobbered by hl arithmetic below)
 8953	6D22	C5				    push bc                       ; save loop counter
 8954	6D23					
 8955	6D23					    ; --- Filter A: entity must have Collision component ---
 8956	6D23					    ; (entity_active and entity_screen_id are implicit via active_entity_list)
 8957	6D23					    ; Hitbox data lives in Collision arrays; no Collision = no valid hitbox.
 8958	6D23					    ; Opt-D: read comp_masks into B (B is free — loop counter saved on stack above).
 8959	6D23					    ; B holds comp_masks for Filter C reuse, eliminating a second memory read.
 8960	6D23	21	5D	DE		    ld hl, entity_comp_masks
 8961	6D26	19				    add hl, de
 8962	6D27	46				    ld b, (hl)                    ; B = comp_masks[E] (safe: loop ctr on stack)
 8963	6D28	78				    ld a, b
 8964	6D29	E6	08			    and COMP_MASK_COLLISION       ; low byte, bit 3
 8965	6D2B	CA	87	6F		    jp z, .wall_next
 8966	6D2E					
 8967	6D2E					    ; --- Filter B: entity must collide with the Platform layer ---
 8968	6D2E					    ; entity_collides_with is a bitmask; COLLISION_LAYER_PLATFORM (#08) = map tiles.
 8969	6D2E	21	5C	E6		    ld hl, entity_collides_with
 8970	6D31	19				    add hl, de
 8971	6D32	7E				    ld a, (hl)
 8972	6D33	E6	08			    and COLLISION_LAYER_PLATFORM
 8973	6D35	CA	87	6F		    jp z, .wall_next
 8974	6D38					
 8975	6D38					    ; --- Filter C: entity must be moveable (Input or Movement component) ---
 8976	6D38					    ; Static entities (platforms, decorations) have no velocity to correct.
 8977	6D38					    ; Opt-D: reuse comp_masks from B — no extra ld hl/add hl,de/ld a,(hl) needed (saves 28 cycles/entity).
 8978	6D38	78				    ld a, b
 8979	6D39	E6	14			    and COMP_MASK_MOVEMENT | COMP_MASK_INPUT
 8980	6D3B	CA	87	6F		    jp z, .wall_next
