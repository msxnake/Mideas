 939	0000					; ; RESOURCE MANAGER
 940	0000					; ; File: resource_manager.asm
 941	0000					; ; Description: Centralized banked resource lookup and copy helpers
 942	0000					; ; Descriptor format: db id, type, group, bank / dw address / dw size
 943	0000					; ; ==================================================================
 944	0000					;
 945	0000					; resource_manager_init:
 946	0000					;     xor a
 947	0000					;     ld (resource_descriptor_ptr), a
 948	0000					;     ld (resource_descriptor_ptr + 1), a
 949	0000					;     ld (resource_descriptor_type), a
 950	0000					;     ld (resource_descriptor_group), a
 951	0000					;     ld (resource_descriptor_bank), a
 952	0000					;     ld (resource_descriptor_addr), a
 953	0000					;     ld (resource_descriptor_addr + 1), a
 954	0000					;     ld (resource_descriptor_size), a
 955	0000					;     ld (resource_descriptor_size + 1), a
 956	0000					;     ld (vram_cache_tile_patterns_ready), a
 957	0000					;     ld (vram_cache_tile_colors_ready), a
 958	0000					;     ld (vram_cache_font_ready), a
 959	0000					;     ld a, #FF
 960	0000					;     ld (resource_descriptor_id), a
 961	0000					;     ld (resource_ram_cache_screen_layout_id), a
 962	0000					;     ld (resource_ram_cache_effects_layout_id), a
 963	0000					;     ld (resource_ram_cache_behavior_map_id), a
 964	0000					;     ld (resource_ram_cache_effect_zone_table_id), a
 965	0000					;     ld (current_screen2_tilebank_id), a
 966	0000					;     ret
