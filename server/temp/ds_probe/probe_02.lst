 3011	4155					; PT3 REPLAYER WORKSPACE (~448 bytes)
 3012	4155					; Layout matches PT3-ROM-alltables-glass.asm expected labels
 3013	4155					; ==================================================================
 3014	4155					PT3_SETUP       EQU #E9E0   ; PT3 state flags (bit0=loop, bit7=song_ended)
