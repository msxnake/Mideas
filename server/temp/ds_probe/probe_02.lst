 11084	77FF	3A	57	E3		    ld a, (current_world_id)       ; A = world currently loaded
 11085	7802	BE				    cp (hl)                        ; Compare with stored world ID
 11086	7803	20	2A			    jr nz, .apply_ct_skip          ; Different world - skip
 11087	7805					
