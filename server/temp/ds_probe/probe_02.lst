 13077	80B5					; update_secret_zone_component
 13078	80B5					; Hero-only secret zone runtime.
 13079	80B5					; Uses hero_entity_id resolved from templates flagged with isPlayer.
 13080	80B5					; ------------------------------------------------------------------
 13081	80B5					; Register Contract:
 13082	80B5					;   Purpose: Detect player entry/exit on secret zones and swap visible tiles.
 13083	80B5					;   Inputs:
 13084	80B5					;     - hero_entity_id + entity_is_player/current-screen filtering
 13085	80B5					;     - entity_x_pos[hero], entity_y_pos[hero] as hero top-left position
 13086	80B5					;     - runtime_effect_zone_table/current_effect_zone_count
 13087	80B5					;     - runtime_background_layout, runtime_effects_layout, runtime_screen_layout
 13088	80B5					;   Outputs:
 13089	80B5					;     - runtime_screen_layout updated when entering/leaving a secret zone
 13090	80B5					;     - VRAM Name Table updated for affected rectangle
 13091	80B5					;     - secret_zone_active + secret_zone_rect_* state refreshed
 13092	80B5					;   Clobbers:
 13093	80B5					;     - AF
 13094	80B5					;     - BC
 13095	80B5					;     - DE
 13096	80B5					;     - HL
 13097	80B5					;     - IX
 13098	80B5					;   Preserved:
 13099	80B5					;     - None
 13100	80B5					;   Notes:
 13101	80B5					;     - Only secret zones are handled in this v1 runtime.
 13102	80B5					;     - First matching zone wins when zones overlap.
