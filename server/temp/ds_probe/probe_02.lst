 1566	0000					; ##################################################################
 1567	0000					; BANK 0 — Bootstrap (#4000h-#5FFFh, FIXED window in Konami mapper)
 1568	0000					; Contains: header, bios, constants, variables, mapper, interrupt,
 1569	0000					;           page-0 stubs, far-call trampolines, init_game_systems.
 1570	0000					; All mapper_set_bank calls are here so they execute from this fixed bank.
 1571	0000					; ##################################################################
 1572	0000					
 1573	0000					; CRITICAL: header.asm with ORG #4000 and "AB" signature MUST be first
 1574	0000					; ==================================================================
 1575	0000					; MSX CARTRIDGE ROM HEADER
 1576	0000					; File: header.asm
 1577	0000					; Description: Standard MSX cartridge initialization
 1578	0000					; GameFlow Integration: Using "Main" as execution orchestrator
 1579	0000					; Flow: Start ? PresentationScreen (gfn_1773690160008)
 1580	0000					; ==================================================================
 1581	0000					
 1582	0000					    org #4000           ; MSX cartridge start address
 1583	4000					
 1584	4000					; ==================================================================
 1585	4000					; CARTRIDGE HEADER
 1586	4000					; ==================================================================
 1587	4000	41	42			    db "AB"             ; MSX cartridge signature
 1588	4002	10	40			    dw init_rom         ; Initialization address
 1589	4004	00	00			    dw 0                ; Statement handler (not used)
 1590	4006	00	00			    dw 0                ; Device handler (not used)
 1591	4008	00	00			    dw 0                ; Text handler (not used)
 1592	400A	00	00			    dw 0                ; Reserved
 1593	400C	00	00			    dw 0                ; Reserved
 1594	400E	00	00			    dw 0                ; Reserved
 1595	4010					
 1596	4010					; ==================================================================
 1597	4010					; ROM INITIALIZATION ENTRY POINT
 1598	4010					; ==================================================================
 1599	4010					init_rom:
 1600	4010	F3				    di
 1601	4011	ED	56			    im 1
 1602	4013					    
 1603	4013					    ; Initialize stack
 1604	4013	31	80	F3		    ld sp, #F380
 1605	4016					
 1606	4016					    ; Cold boot path: ensure cartridge page 2 (8000h-BFFFh) is mapped to the cartridge slot.
 1607	4016					    ; Required for both simple32k and plain48k: the BIOS only maps page 1 when it finds "AB",
 1608	4016					    ; page 2 must be explicitly mapped via SETPAGES32K (reads page-1 slot, applies it to page 2).
 1609	4016	CD	9C	40		    call SETPAGES32K
 1610	4019	C3	22	40		    jp restart_rom_continue
 1611	401C					
 1612	401C					; Restart entry point for GameFlow Restart node.
 1613	401C					; Reinitializes runtime safely without remapping cartridge pages.
 1614	401C					restart_rom:
 1615	401C	F3				    di
 1616	401D	ED	56			    im 1
 1617	401F	31	80	F3		    ld sp, #F380
 1618	4022					
 1619	4022					restart_rom_continue:
 1620	4022					    ; Capture the normal slot state for optional linear 48K page-0 helpers.
 1621	4022	CD	E0	47		    call init_page0_runtime_state
 1622	4025					
 1623	4025					    ; Initialize mapper runtime state (safe no-op in simple32k mode)
 1624	4025	CD	55	41		    call mapper_runtime_init
 1625	4028					
 1626	4028					    ; Initialize cached resource descriptor mirrors used by banked resources.
 1627	4028	CD	31	46		    call resource_manager_init
 1628	402B					    ; MEGAROM: Static bank setup — map physical banks 1-3 to their pages.
 1629	402B					    ; Konami4 register layout: write to 6000h?6000-7FFFh, 8000h?8000-9FFFh, A000h?A000-BFFFh
 1630	402B					    ; p1 writes to reg #6000, p2 to #8000, p3 to #A000.
 1631	402B					    ; Bank 0 (4000h-5FFFh): fixed (Konami4 cannot change this page)
 1632	402B					    ; Bank 1 (6000h-7FFFh): set via p1 (reg #6000)
 1633	402B					    ; Bank 2 (8000h-9FFFh): set via p2 (reg #8000)
 1634	402B					    ; Bank 3 (A000h-BFFFh): set via p3 (reg #A000)
 1635	402B	3E	01			    ld a, 1
 1636	402D	CD	69	41		    call mapper_set_bank_p1
 1637	4030	3E	02			    ld a, 2
 1638	4032	CD	70	41		    call mapper_set_bank_p2
 1639	4035	3E	03			    ld a, 3
 1640	4037	CD	77	41		    call mapper_set_bank_p3
 1641	403A					
 1642	403A					    ; Reset some interrupts to ensure compatibility
 1643	403A					    ; with MSX computers with disk controllers
 1644	403A	3E	C9			    ld a, #C9
 1645	403C	32	DB	F3		    ld (HKEY), a
 1646	403F					    ; NOTE: TIMI (H.TIMI) is now managed by init_interrupt_system
 1647	403F					
 1648	403F					    ; Silence click, init keyboard, clear config
 1649	403F	AF				    xor a
 1650	4040	32	DC	F3		    ld (CLIKSW), a
 1651	4043	32	D2	E4		    ld (deterministic), a
 1652	4046					    
 1653	4046					    ; Change background colors
 1654	4046	32	E9	F3		    ld (BAKCLR), a
 1655	4049	32	EA	F3		    ld (BDRCLR), a
 1656	404C	CD	62	00		    call CHGCLR
 1657	404F					
 1658	404F					    ; Disable screen while switching modes / initializing VDP
 1659	404F	CD	41	00		    call DISSCR
 1660	4052					
 1661	4052					    ; Change screen mode to SCREEN 2
 1662	4052	3E	02			    ld a, 2
 1663	4054	CD	5F	00		    call CHGMOD
 1664	4057					
 1665	4057					    ; Configure 16x16 sprites
 1666	4057					    ; VDP Register #01: activate sprites, generate interrupts, 16x16 sprites
 1667	4057	01	01	E2		    ld bc, #E201
 1668	405A	CD	04	41		    call FAST_WRTVDP
 1669	405D					    ; CRITICAL: Update BIOS system variable RG1SAV to match
 1670	405D					    ; Without this, DISSCR/ENASCR will overwrite VDP R1 losing 16x16 sprite config
 1671	405D	3E	E2			    ld a, #E2
 1672	405F	32	E0	F3		    ld (#F3E0), a       ; RG1SAV = #E2 (preserves 16x16 sprite bit)
 1673	4062					
 1674	4062					    ; Detect 50Hz/60Hz
 1675	4062	CD	B2	40		    call CheckIf60Hz
 1676	4065	32	EB	F3		    ld (isComputer50HzOr60Hz), a ; 0: 50Hz, 1: 60Hz
 1677	4068					
 1678	4068					    ; ====================================================
 1679	4068					    ; INTERRUPT SYSTEM INITIALIZATION (Konami-style)
 1680	4068					    ; ====================================================
 1681	4068					    ; Initialize interrupt task system (hooks H.TIMI)
 1682	4068	CD	E7	47		    call init_interrupt_system
 1683	406B	F3				    di
 1684	406C					
 1685	406C					    ; Register default tasks based on project needs
 1686	406C					        ; Initialize PSG/audio once at boot. WorldLink must not reset music after a Music node.
 1687	406C	CD	87	4C		    call call_init_sound_system_resident
 1688	406F					
 1689	406F					    ; Register boot-time IRQ tasks defined by the engine execution plan.
 1690	406F	CD	AE	48		    call init_default_tasks_from_plan
 1691	4072					
 1692	4072					
 1693	4072	FB				    ei
 1694	4073					
 1695	4073					    ; ====================================================
 1696	4073					    ; GAMEFLOW INITIALIZATION
 1697	4073					    ; ====================================================
 1698	4073					    ; Initialize GameFlow system
 1699	4073	CD	00	A0		    call gameflow_init
 1700	4076					
 1701	4076					    ; Start execution from GameFlow Start node
 1702	4076					    ; GameFlow is now the sole orchestrator
 1703	4076	CD	44	00		    call ENASCR
 1704	4079	C3	08	A0		    jp gameflow_start
 1705	407C					
 1706	407C					main_loop:
 1707	407C	76				    halt
 1708	407D	CD	0C	79		    call update_all_entities
 1709	4080	C3	7C	40		    jp main_loop
 1710	4083					
 1711	4083					; ==================================================================
 1712	4083					; AUXILIARY FUNCTIONS
 1713	4083					; ==================================================================
 1714	4083					
 1715	4083					; Helper: Get expanded slot value for ENASLT/CALSLT usage
 1716	4083					; Input:  A = slot number (0-3) in lower bits
 1717	4083					; Output: A = expanded slot value if needed
 1718	4083					GETSLOT:
 1719	4083	E6	03			    and #03             ; Proteccion, nos aseguramos de que el valor esta en 0-3
 1720	4085	4F				    ld  c,a             ; c = slot de la pagina
 1721	4086	06	00			    ld  b,0             ; bc = slot de la pagina
 1722	4088	21	C1	FC		    ld  hl,#fcc1        ; Tabla de slots expandidos
 1723	408B	09				    add hl,bc           ; hl -> variable que indica si este slot esta expandido
 1724	408C	7E				    ld  a,(hl)          ; Tomamos el valor
 1725	408D	E6	80			    and #80             ; Si el bit mas alto es cero...
 1726	408F	28	09			    jr  z,GETSLOT_EXIT  ; ...nos vamos a @@EXIT
 1727	4091					    ; --- El slot esta expandido ---
 1728	4091	B1				    or  c               ; Slot basico en el lugar adecuado
 1729	4092	4F				    ld  c,a             ; Guardamos el valor en c
 1730	4093	23				    inc hl              ; Incrementamos hl una...
 1731	4094	23				    inc hl              ; ...dos...
 1732	4095	23				    inc hl              ; ...tres...
 1733	4096	23				    inc hl              ; ...cuatro veces
 1734	4097	7E				    ld  a,(hl)          ; a = valor del registro de subslot del slot donde estamos
 1735	4098	E6	0C			    and #0C             ; Nos quedamos con el valor donde esta nuestro cartucho
 1736	409A					GETSLOT_EXIT:
 1737	409A	B1				    or  c
 1738	409B	C9				    ret
 1739	409C					
 1740	409C					; From: http://www.z80st.es/downloads/code/
 1741	409C					; SETPAGES32K:  BIOS-ROM-YY-ZZ   -> BIOS-ROM-ROM-ZZ (SITUA PAGINA 2)
 1742	409C					SETPAGES32K:    ; --- Posiciona las paginas de un megarom o un 32K ---
 1743	409C	3E	C9			    ld  a, #C9              ; Codigo de RET
 1744	409E	32	A1	40		    ld  (SETPAGES32K_NOPRET), a   ; Modificamos la siguiente instruccion si estamos en RAM
 1745	40A1					SETPAGES32K_NOPRET:
 1746	40A1	00				    nop                     ; No hacemos nada si no estamos en RAM
 1747	40A2					    ; --- Si llegamos aqui no estamos en RAM, hay que posicionar la pagina ---
 1748	40A2	CD	38	01		    call RSLREG             ; Leemos el contenido del registro de seleccion de slots
 1749	40A5	0F				    rrca                    ; Rotamos a la derecha...
 1750	40A6	0F				    rrca                    ; ...dos veces
 1751	40A7	CD	83	40		    call GETSLOT            ; Obtenemos el slot de la pagina 1 ($4000-$BFFF)
 1752	40AA	32	17	C0		    ld (ROM_slot), a        ; Save slot for later use
 1753	40AD	26	80			    ld  h, #80              ; Seleccionamos pagina 2 ($8000-$BFFF)
 1754	40AF	C3	24	00		    jp  ENASLT              ; Posicionamos la pagina 2 y volvemos
 1755	40B2					
 1756	40B2					; Source: https://www.msx.org/forum/development/msx-development/how-0?page=0
 1757	40B2					; Returns 1 in a and clears z flag if vdp is 60Hz
 1758	40B2					CheckIf60Hz:
 1759	40B2	F3				    di
 1760	40B3	DB	99			    in      a, (#99)
 1761	40B5	00				    nop
 1762	40B6	00				    nop
 1763	40B7	00				    nop
 1764	40B8					vdpSync:
 1765	40B8	DB	99			    in      a, (#99)
 1766	40BA	E6	80			    and     #80
 1767	40BC	28	FA			    jr      z, vdpSync
 1768	40BE					
 1769	40BE	21	00	09		    ld      hl, #900
 1770	40C1					vdpLoop:
 1771	40C1	2B				    dec     hl
 1772	40C2	7C				    ld      a, h
 1773	40C3	B5				    or      l
 1774	40C4	20	FB			    jr      nz, vdpLoop
 1775	40C6					
 1776	40C6	DB	99			    in      a, (#99)
 1777	40C8	07				    rlca
 1778	40C9	E6	01			    and     1
 1779	40CB	FB				    ei
 1780	40CC	C9				    ret
