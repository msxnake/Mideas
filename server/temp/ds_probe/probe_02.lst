 15001	8656					
 15002	8656					Condition_Nop:
 15003	8656	3E	01			    ld a, 1                 ; Always true
 15004	8658	C9				    ret
 15005	8659					
 15006	8659					Condition_And:
 15007	8659					    ; AND compound condition
 15008	8659					    ; Data format: DB subcondition_count, then N subconditions inline
 15009	8659					    ; Evaluates all subconditions; returns true only if ALL are true
 15010	8659					    ; Input: B = Entity Index, HL = Params (points to count byte)
 15011	8659					    ; Output: A = 1 (all true) or 0 (any false), HL = past all subcondition data
 15012	8659	4E				    ld c, (hl)              ; C = subcondition count
 15013	865A	23				    inc hl
 15014	865B	16	01			    ld d, 1                 ; D = result accumulator (1 = all true so far)
 15015	865D					
 15016	865D					.and_loop:
 15017	865D	79				    ld a, c
 15018	865E	B7				    or a
 15019	865F	28	0D			    jr z, .and_done         ; No more subconditions
 15020	8661					
 15021	8661	C5				    push bc                 ; Save count (C) and entity index (implicitly)
 15022	8662	D5				    push de                 ; Save result accumulator (D)
 15023	8663					
 15024	8663	78				    ld a, b                 ; A = Entity Index
 15025	8664	CD	E5	80		    call SM_EvaluateCondition ; A = subcondition result, HL advanced
 15026	8667					
 15027	8667	D1				    pop de                  ; Restore result accumulator
 15028	8668	A2				    and d                   ; Combine: D = D AND result
 15029	8669	57				    ld d, a
 15030	866A					
 15031	866A	C1				    pop bc                  ; Restore count and entity index
 15032	866B	0D				    dec c
 15033	866C	18	EF			    jr .and_loop
 15034	866E					
 15035	866E					.and_done:
 15036	866E	7A				    ld a, d                 ; A = AND result
 15037	866F	C9				    ret
