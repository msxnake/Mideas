 7089	656A	16	00			    ld d, 0
 7090	656C	19				    add hl, de              ; HL = &entity_y_pos[other]
 7091	656D	56				    ld d, (hl)              ; D = other Y
 7092	656E					
 7093	656E					    ; Check if current entity is above other entity
 7094	656E					    ; Current is above if: current_Y + 16 is near other_Y (within 4 pixels)
 7095	656E	78				    ld a, b                 ; A = current Y
 7096	656F	C6	10			    add a, 16               ; A = current Y + height
 7097	6571	92				    sub d                   ; A = (current Y + 16) - other Y
