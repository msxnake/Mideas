 3278	420B	F5				    push af
 3279	420C	7C				    ld a, h
 3280	420D	FE	60			    cp #60
 3281	420F	38	0C			    jr c, .use_fixed
 3282	4211	FE	80			    cp #80
 3283	4213	38	0C			    jr c, .use_p1
 3284	4215	FE	A0			    cp #A0
 3285	4217	38	0C			    jr c, .use_p2
 3286	4219	F1				    pop af
 3287	421A	C3	DF	41		    jp mapper_call_hl_p3
