 24471	8202					; Start playing a PT3 track.
 24472	8202					; Input:  A = track index (0-based)
 24473	8202					;         B = loop flag (0=no loop, 1=loop)
 24474	8202					; Destroys: AF, BC, DE, HL, IX, IY
 24475	8202					; ------------------------------------------------------------------
 24476	8202					music_play_track:
 24477	8202	32	BC	E9		    ld (music_track_index), a
 24478	8205	78				    ld a, b
 24479	8206	E6	01			    and 1
 24480	8208	32	BB	E9		    ld (music_loop), a
 24481	820B	3A	BC	E9		    ld a, (music_track_index)
 24482	820E	87				    add a, a               ; *2 (DW entries)
 24483	820F	5F				    ld e, a
 24484	8210	16	00			    ld d, 0
 24485	8212	21	AB	88		    ld hl, music_pt3_track_table
 24486	8215	19				    add hl, de
 24487	8216	5E				    ld e, (hl)
 24488	8217	23				    inc hl
 24489	8218	56				    ld d, (hl)
 24490	8219	62				    ld h, d
 24491	821A	6B				    ld l, e                ; HL = adjusted module address
 24492	821B	AF				    xor a
 24493	821C	32	BA	E9		    ld (music_muted), a
 24494	821F	32	E0	E9		    ld (PT3_SETUP), a      ; Clear end-of-song flag
 24495	8222	F3				    di                     ; Disable interrupts while initialising PT3
 24496	8223	DD	E5			    push ix
 24497	8225	FD	E5			    push iy
 24498	8227	CD	99	82		    call PT3_INIT
 24499	822A	FD	E1			    pop iy
 24500	822C	DD	E1			    pop ix
 24501	822E	3E	01			    ld a, 1
 24502	8230	32	B9	E9		    ld (music_active), a   ; Enable playback AFTER PT3 is fully initialised
 24503	8233	FB				    ei
 24504	8234	C9				    ret
 24505	8235					
 24506	8235					; ------------------------------------------------------------------
 24507	8235					; music_update
 24508	8235					; Update PT3 playback. Called every frame from the main loop or ISR.
 24509	8235					; Checks end-of-song flag, handles loop/stop, runs PT3_PLAY+PT3_ROUT.
 24510	8235					; Destroys: AF, HL, DE (saves/restores IX/IY around PT3 calls)
 24511	8235					; ------------------------------------------------------------------
 24512	8235					music_update:
 24513	8235	3A	B9	E9		    ld a, (music_active)
 24514	8238	B7				    or a
 24515	8239	C8				    ret z
 24516	823A	3A	BA	E9		    ld a, (music_muted)
 24517	823D	B7				    or a
 24518	823E	C0				    ret nz
 24519	823F					    ; Check if song ended (CHECKLP sets bit7 of PT3_SETUP)
 24520	823F	3A	E0	E9		    ld a, (PT3_SETUP)
 24521	8242	CB	7F			    bit 7, a
 24522	8244	28	27			    jr z, .pt3_upd_play
 24523	8246					    ; Song ended - loop or stop?
 24524	8246	3A	BB	E9		    ld a, (music_loop)
 24525	8249	B7				    or a
 24526	824A	28	1C			    jr z, .pt3_upd_stop
 24527	824C					    ; Loop: reinitialise from same track
 24528	824C	3A	BC	E9		    ld a, (music_track_index)
 24529	824F	87				    add a, a
 24530	8250	5F				    ld e, a
 24531	8251	16	00			    ld d, 0
 24532	8253	21	AB	88		    ld hl, music_pt3_track_table
 24533	8256	19				    add hl, de
 24534	8257	5E				    ld e, (hl)
 24535	8258	23				    inc hl
 24536	8259	56				    ld d, (hl)
 24537	825A	62				    ld h, d
 24538	825B	6B				    ld l, e
 24539	825C	DD	E5			    push ix
 24540	825E	FD	E5			    push iy
 24541	8260	CD	99	82		    call PT3_INIT
 24542	8263	FD	E1			    pop iy
 24543	8265	DD	E1			    pop ix
 24544	8267	C9				    ret
 24545	8268					.pt3_upd_stop:
 24546	8268	AF				    xor a
 24547	8269	32	B9	E9		    ld (music_active), a
 24548	826C	C9				    ret
 24549	826D					.pt3_upd_play:
 24550	826D	DD	E5			    push ix
 24551	826F	FD	E5			    push iy
 24552	8271	CD	00	87		    call PT3_PLAY
 24553	8274	CD	00	88		    call PT3_ROUT
 24554	8277	FD	E1			    pop iy
 24555	8279	DD	E1			    pop ix
 24556	827B	C9				    ret
