{
  "id": "ice_slide",
  "label": "Ice slide",
  "required": false,
  "cycles": 60,
  "controlIcon": ["left", "right"],
  "controlOperator": "or",
  "addsStates": ["sliding"],
  "transitions": [
    { "from": ["grounded", "running"], "to": "sliding", "condition": "on_ice AND horizontal_speed != 0" },
    { "from": ["sliding"], "to": "grounded", "condition": "NOT on_ice OR horizontal_speed = 0" }
  ],
  "supportedBackends": ["screen5"],
  "parameters": [
    { "key": "surfaceCode", "label": "Ice behavior code", "type": "number", "default": 3, "min": 1, "max": 255, "step": 1 },
    { "key": "maxSlideSpeed", "label": "Max slide speed (px/frame)", "type": "number", "default": 4, "min": 1, "max": 8, "step": 1 },
    { "key": "accelerationFrames", "label": "Acceleration frames", "type": "number", "default": 2, "min": 1, "max": 8, "step": 1 },
    { "key": "frictionFrames", "label": "Friction frames", "type": "number", "default": 8, "min": 1, "max": 32, "step": 1 }
  ]
}
