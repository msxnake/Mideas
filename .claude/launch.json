{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mideas-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mideas-dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100",
        "--no-open"
      ],
      "port": 3100
    },
    {
      "name": "mideas-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/server.js"
      ],
      "port": 3001
    }
  ]
}
