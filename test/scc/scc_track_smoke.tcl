# SCC Fase 1 music runtime smoke: fixture song generated by
# test/scc/build_scc_test_rom.mjs through sccSoundGenerator.ts.
# Run (from repo root — openMSX TCL CWD is the launch CWD):
#   "C:/Program Files/openMSX/openmsx.exe" -machine C-BIOS_MSX2+ \
#     -cart test/scc/scc_track_test.rom -romtype KonamiSCC -script test/scc/scc_track_smoke.tcl
# RAM addresses are resolved from the .sym file at runtime: the player RAM
# layout grows with each driver phase, so hardcoded addresses rot silently
# (Fase 1 addrs read garbage after the Fase 3/4 arp/vib/noise/morph growth).
set result_path "test/scc/scc_track_result.txt"
set sym_path "test/scc/scc_track_test.sym"

array set ::syms {}
set sf [open $sym_path r]
while {[gets $sf line] >= 0} {
    if {[regexp {^(\S+):\s+equ\s+([0-9A-Fa-f]+)H} $line -> name hexval]} {
        set ::syms($name) [expr {"0x$hexval"}]
    }
}
close $sf
proc sym {name} { return $::syms($name) }
proc rd {name {off 0}} { return [debug read memory [expr {[sym $name] + $off}]] }

set fh_lines [list]
proc log_line {line} { global fh_lines; lappend fh_lines $line }
proc flush_report {} {
    global result_path fh_lines
    set fh [open $result_path w]
    foreach l $fh_lines { puts $fh $l }
    close $fh
    after time 1 { exit }
}
catch { set renderer none }
catch { set throttle off }

after time 8 {
    log_line "boot=[rd marker_boot] (expect 1)"
    log_line "slot=[rd marker_slot] (expect 2)"
    log_line "ready=[rd marker_ready] (expect 5)"
    log_line "active=[rd scc_music_active] (expect 1)"
    log_line "mixer_shadow=[rd scc_music_mixer_shadow] (expect 15: channels 1-4 playing, ch4 = noise hi-hat)"
    set ::row_a [rd scc_music_pattern_row]
    log_line "pattern_row_a=$::row_a (16 rows/pattern)"
    log_line "pattern_rows=[rd scc_music_pattern_rows] (expect 16)"
    set ::vol_a [rd scc_ch_volout]
    log_line "volout_ch1_a=$::vol_a (envelope-driven)"
    set ::saved_p2 [rd mapper_bank_p2_current]
    log_line "mapper_p2_before_probe=$::saved_p2 (expect 2: restored after SCC tick)"
    debug write memory 0x9000 0x3F
    set w {}
    foreach off {0 1 2 3} {
        lappend w [format %02X [debug read memory [expr {0x9800 + $off}]]]
    }
    log_line "wave_ch1_first4=$w (expect triangle instrument samples)"
    debug write memory 0x9000 $::saved_p2
    log_line "ch_note_4=[rd scc_ch_note 3] ch_note_5=[rd scc_ch_note 4] (expect ch4=60 noise C-5, ch5=255 unused)"
}
after time 8.45 {
    log_line "pattern_row_b=[rd scc_music_pattern_row] (expect != pattern_row_a: rows advance)"
    log_line "volout_ch1_b=[rd scc_ch_volout] (27 frames later: different envelope phase)"
}
after time 14 {
    log_line "loop_count=[rd scc_music_loop_count] (expect >=1: ~3.2s song wrapped)"
    log_line "order_pos=[rd scc_music_order_pos] (expect 0 or 1)"
    log_line "active_end=[rd scc_music_active] (expect 1)"
}
after time 15 { debug write memory [sym req_stop] 1 }
after time 16 {
    log_line "stopped=[rd marker_stopped] (expect 1)"
    log_line "active_after_stop=[rd scc_music_active] (expect 0)"
    flush_report
}
