# Generate a unique local value with at least 16 characters.
MIDEAS_MCP_TOKEN=replace-with-a-long-random-local-token
MIDEAS_MCP_HOST=127.0.0.1
MIDEAS_MCP_PORT=3333
MIDEAS_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional: Streamable HTTP transport for REMOTE MCP clients ---
# (ChatGPT connectors, OpenAI Agents SDK, etc.). Leave MIDEAS_MCP_HTTP_PORT
# empty to keep the server stdio-only. When set, the server exposes a
# Streamable HTTP MCP endpoint at http://<host>:<port><path> guarded by a
# Bearer token. To reach it from ChatGPT's cloud you must expose it publicly
# (e.g. an HTTPS tunnel) — never expose the loopback bridge itself.
# MIDEAS_MCP_HTTP_PORT=3334
MIDEAS_MCP_HTTP_HOST=127.0.0.1
MIDEAS_MCP_HTTP_PATH=/mcp
# Defaults to MIDEAS_MCP_TOKEN; set a distinct >=16 char token to differ.
# MIDEAS_MCP_HTTP_TOKEN=replace-with-a-long-random-remote-token
